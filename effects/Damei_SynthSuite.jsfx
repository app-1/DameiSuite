desc:Damei Synth Bus Nebula (Stellar Architect & SynBass Alchemist)
// =============================================================================
// DAMEI SYNTH BUS NEBULA // AFRO-RETRO-FUTURISTIC MASTER ARCHITECT (v3.2 PRO)
// Complete Synth & SynBass Bus Sculptor with ORA-AI, Tight-Arse Sub Engine & Devastator Link
// Royal Gold (#ffb703), Cosmic Violet (#8b5cf6), Electric Cyan (#00f5d4), Obsidian Titanium
// Built by Damei Audio & Antigravity IDE
// =============================================================================

slider1:0<0,7,1{Nebula Overview & Scope,Dynamic Pockets & Devastator Link,Asase SynBass & Tight-Arse Sub,3D Horizon & Matemasie Spatial,MultibandEQ Frequency Sculptor,Analog Sheen & Britson Console,Producer Matrix & Bridge Codex,Ear-Candy Director}>-Active Module
slider2:-12.0<-24.0,-6.0,0.5>-Target Level (dBFS Peak)
slider3:0<0,2,1{Synth Parent Bus (Track 44/41),Dedicated SynBass (Track 47),Unified Hybrid Master}>-Processing Mode
slider4:1<0,2,1{Off (Full Stereo Sub),Strict Mono Lock <90Hz (Asase Weight),Strict Mono Lock <130Hz}>-Sub Foundation Mono Anchor
slider5:3.5<0.0,8.0,0.5>-Drum Kick Sub-Duck Depth (dB) [gmem 820 Handshake]
slider6:2.5<0.0,6.0,0.2>-Lead Vocal Mid-Carve Depth (dB) [gmem 880 Handshake]
slider7:3.0<0.0,6.0,0.5>-Guitar Wall Chorus Carve (dB) [gmem 840 Handshake]
slider8:1.45<0.80,2.00,0.05>-Stereo Horizon Width Ratio (1.0 = Normal)
slider9:40<0,100,5>-Ambient Reverb Bloom Ducking (%) [SynthVerb & Shimmer Protection]
slider10:2.8<0.0,6.0,0.2>-12kHz Glassy Air Sheen (dB)
slider11:28<0,100,1>-Britson Analogue Console Desk Saturation (%)
slider12:0<0,2,1{Linear Transparent Passthrough,Smooth Musical Hermite Soft-Clip,Commercial Hard Brickwall Clamp}>-Mix Bus Clipper Topology
slider13:-0.1<-12.0,-0.1,0.1>-Target Headroom Ceiling (dBTP)
slider14:0.0<-12.0,12.0,0.5>-Output Master Makeup Trim (dB)
slider15:0<0,20,1{Jordan Fish (BMTH / Architects),Dan Braunstein (Spiritbox / Dayseeker),Buster Odeholm (thrown / Vildhjarta),George Lever (Sleep Token / Loathe),Zakk Cervini (Blink-182 / MGK),Joey Sturgis (Asking Alexandria / Attack Attack),Mick Gordon (DOOM / Wolfenstein),Lance Prenc (Alpha Wolf / Polaris),Scott Seigel (DIESECT / Graphic Nature),Jonathan Dolese (Mirrorcell / Cane Hill),Kel Pinchin (Currents / Invent Animate),Sam Guaiana (Silverstein / TDWP),Forrester Savell (Karnivool / Dead Letter Circus),Jens Bogren (Fascination Street),Adam Nolly Getgood (Periphery / GGD),Will Putney (Fit For An Autopsy / Knocked Loose),Sam Bassal (Thornhill / Ocean Grove),Henrik Udd (Architects / BMTH - That's The Spirit),Acle Kahney (TesseracT - King),Adam Cichocki (heaving. - carsick / Timber Studios),Manuel Renner (SENNA - Out Of The Blue / Überlärm Studios)}>-Producer Synth Blueprint
slider16:1<0,1,1{Manual Parameter Mode,ORA-AI Active Formula Calibration}>-AI Assist Intelligent Engine
slider17:25<0,100,1>-SynBass 2nd/3rd Harmonic Tip Drive (%)
slider18:1<0,1,1{Off,Dynamic Pre-Drop Silence Choke (BMTH / thrown)}> -Pre-Drop Silence Choke
slider19:1<0,1,1{Bypassed,Active Devastator Suite Neural Interlock (gmem 900)}>-Devastator Neural Link
slider20:4.0<0.0,8.0,0.5>-Devastator Sub Divebomb Carve Depth (dB)

// Tight-Arse Low-End Sculptor Engine
slider21:30<20,45,1>-Tight-Arse Subsonic Highpass (Hz)
slider22:35<0,100,1>-Tight-Arse Transient Tightener (%)
slider23:25<0,100,1>-Tight-Arse 80-160Hz Harmonic Punch (%)

// Sankofa Chaos Matrix & Dystopian Fright Engine
slider24:25<0,100,1>-Dystopian Chaos Resonator Depth (%) [Sankofa Matrix]
slider25:35<0,100,1>-Tritone Fright Comb Resonance (%)
slider26:1<0,1,1{Off,SWDrums Groove Interlock (Snare Pocket Carve)}>-SWDrums Dynamic Anchor

slider27:1<0,1,1{Off,On}>-Matrix Trim (applies Assessment Matrix auto-correct lane)
slider28:1<0,1,1{Classic (Off),Ear-Candy Director (Region + Energy Aware)}>-Ear-Candy Director
slider29:40<0,100,1>-Ear-Candy Amount (%)
slider30:8806<0,65535,1>-Ear-Candy Trick Palette (bitmask)
slider31:1<0,1,1{Manual Palette,Follow Producer Preset}>-Ear-Candy Palette Follows Producer
// MultibandEQ Frequency Sculptor (4-Band Dynamic Crossover)
slider32:1<0,1,1{Bypassed,Active}>-MultibandEQ Engine Toggle
slider33:0.0<-12.0,12.0,0.5>-MultibandEQ Band 1: Sub Bass (<110Hz) (dB)
slider34:-1.5<-12.0,12.0,0.5>-MultibandEQ Band 2: Low-Mid (110-650Hz) (dB)
slider35:1.2<-12.0,12.0,0.5>-MultibandEQ Band 3: High-Mid (650Hz-4.5kHz) (dB)
slider36:2.5<-12.0,12.0,0.5>-MultibandEQ Band 4: Glassy Air (>4.5kHz) (dB)
slider37:1.40<0.80,2.20,0.05>-MultibandEQ High Band Width Ratio
slider50:0<0,1,1{Normal Passthrough,Audition Delta Solo (Kick Duck & Sidechain)}>-Audition Delta Solo
slider51:0<0,1,1{State A,State B}>-A/B Snapshot Selector
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=2097152
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@serialize
file_var(0, slider1);
file_var(0, slider2);
file_var(0, slider3);
file_var(0, slider4);
file_var(0, slider5);
file_var(0, slider6);
file_var(0, slider7);
file_var(0, slider8);
file_var(0, slider9);
file_var(0, slider10);
file_var(0, slider11);
file_var(0, slider12);
file_var(0, slider13);
file_var(0, slider14);
file_var(0, slider15);
file_var(0, slider16);
file_var(0, slider17);
file_var(0, slider18);
file_var(0, slider19);
file_var(0, slider20);
file_var(0, slider21);
file_var(0, slider22);
file_var(0, slider23);
file_var(0, slider24);
file_var(0, slider25);
file_var(0, slider26);
file_var(0, slider28); file_var(0, slider29); file_var(0, slider30); file_var(0, slider31);
file_var(0, slider32); file_var(0, slider33); file_var(0, slider34); file_var(0, slider35); file_var(0, slider36); file_var(0, slider37);

@init

ext_noinit = 1.0;

// MultibandEQ 4-Band Crossover Filters (110Hz, 650Hz, 4500Hz)
mbeq_x1_l = 0; mbeq_x2_l = 0; mbeq_y1_l = 0; mbeq_y2_l = 0;
mbeq_x1_r = 0; mbeq_x2_r = 0; mbeq_y1_r = 0; mbeq_y2_r = 0;
mbeq_m1_l = 0; mbeq_m2_l = 0; mbeq_my1_l = 0; mbeq_my2_l = 0;
mbeq_m1_r = 0; mbeq_m2_r = 0; mbeq_my1_r = 0; mbeq_my2_r = 0;
mbeq_h1_l = 0; mbeq_h2_l = 0; mbeq_hy1_l = 0; mbeq_hy2_l = 0;
mbeq_h1_r = 0; mbeq_h2_r = 0; mbeq_hy1_r = 0; mbeq_hy2_r = 0;

cur_rms = -90.0;
cur_true_peak = -90.0;
cur_crest = 0.0;
cur_out_true_peak = -90.0;
cur_vu_rms = -90.0;
vu_ballistics = 0.0;
vu_attack_c = exp(-1.0 / (0.300 * srate));

smooth_kick_duck = 1.0;
smooth_vox_carve = 1.0;
smooth_gtr_carve = 1.0;
smooth_dev_carve = 1.0;
live_kick_duck_db = 0.0;
live_vox_carve_db = 0.0;
live_gtr_carve_db = 0.0;
live_dev_carve_db = 0.0;
live_stereo_width = slider8;
live_tip_drive = slider17;

// Sub mono highpass states for Side channel
sub_hp_x1 = 0; sub_hp_x2 = 0; sub_hp_y1 = 0; sub_hp_y2 = 0;

// Vocal mid de-masking bell filter states (Mid channel ~2.2kHz)
vox_bell_x1 = 0; vox_bell_x2 = 0; vox_bell_y1 = 0; vox_bell_y2 = 0;

// 12kHz Air High-Shelf states
air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;

// Devastator Pre-Drop Tension Highpass
dev_hp_x1 = 0; dev_hp_x2 = 0; dev_hp_y1 = 0; dev_hp_y2 = 0;

// Tight-Arse Subsonic Highpass (18dB/oct steep Butterworth/elliptic)
ta_hp_x1_l = 0; ta_hp_x2_l = 0; ta_hp_y1_l = 0; ta_hp_y2_l = 0;
ta_hp_x1_r = 0; ta_hp_x2_r = 0; ta_hp_y1_r = 0; ta_hp_y2_r = 0;
ta_hp1_x1_l = 0; ta_hp1_y1_l = 0;
ta_hp1_x1_r = 0; ta_hp1_y1_r = 0;

// Tight-Arse 80-160Hz Harmonic Punch Bandpass
ta_bp_x1_l = 0; ta_bp_x2_l = 0; ta_bp_y1_l = 0; ta_bp_y2_l = 0;
ta_bp_x1_r = 0; ta_bp_x2_r = 0; ta_bp_y1_r = 0; ta_bp_y2_r = 0;

// Tight-Arse Envelope Follower for Low-End Clamping
ta_env = 0.0;
ta_att_c = exp(-1.0 / (0.005 * srate)); // 5ms attack
ta_rel_c = exp(-1.0 / (0.060 * srate)); // 60ms release

// Scope & Goniometer buffer (Phase Vector & Waveform)
sc_buf_sz = 160;
sc_buf_l = 35000;
sc_buf_r = 35200;
sc_idx = 0;
sample_cnt = 0;

// Sankofa Chaos Matrix & Dystopian Fright Comb Buffer
comb_buf_sz = 2048;
comb_buf_l = 50000;
comb_buf_r = 52500;
comb_w_idx = 0;
chaos_x = 0.514;
chaos_target = 0.0;
chaos_val = 0.0;
chaos_timer = 0;

ora_line1 = "ORA-AI ONLINE // Monitoring 7-Pillar Telemetry";
ora_line2 = "Devastator link armed. Vocal mid-carve standby.";
ora_line3 = "Sub mono foundation active <90Hz.";

// Live metering state: peak-hold, clipper GR, transient-clamp envelopes
pk_env = 0.0; pk_rel = exp(-1.0 / (0.35 * srate));
pre_env = 0.0; pre_clip_peak_db = -90.0; live_clip_gr_db = 0.0;
tension_frac = 0.0; live_tight_gr_db = 0.0; tg_hold = 1.0;
tl_lo_l = 0.0; tl_lo_r = 0.0; tl_fast = 0.0; tl_slow = 0.0;
tl_a = 1.0 - exp(-2.0 * $pi * 120.0 / srate);
tl_frel = exp(-1.0 / (0.008 * srate));
tl_sa = exp(-1.0 / (0.060 * srate));

function update_synth_filters() (

  // MultibandEQ Crossovers: 110Hz, 650Hz, 4500Hz
  mbq_w1 = 2.0 * $pi * 110.0 / srate;
  mbq_al1 = sin(mbq_w1) * 0.7071;
  mbq_lp1_a0 = 1.0 + mbq_al1;
  mbq_lp1_b0 = ((1.0 - cos(mbq_w1)) * 0.5) / mbq_lp1_a0;
  mbq_lp1_b1 = (1.0 - cos(mbq_w1)) / mbq_lp1_a0;
  mbq_lp1_b2 = ((1.0 - cos(mbq_w1)) * 0.5) / mbq_lp1_a0;
  mbq_lp1_a1 = (-2.0 * cos(mbq_w1)) / mbq_lp1_a0;
  mbq_lp1_a2 = (1.0 - mbq_al1) / mbq_lp1_a0;

  mbq_w2 = 2.0 * $pi * 650.0 / srate;
  mbq_al2 = sin(mbq_w2) * 0.7071;
  mbq_lp2_a0 = 1.0 + mbq_al2;
  mbq_lp2_b0 = ((1.0 - cos(mbq_w2)) * 0.5) / mbq_lp2_a0;
  mbq_lp2_b1 = (1.0 - cos(mbq_w2)) / mbq_lp2_a0;
  mbq_lp2_b2 = ((1.0 - cos(mbq_w2)) * 0.5) / mbq_lp2_a0;
  mbq_lp2_a1 = (-2.0 * cos(mbq_w2)) / mbq_lp2_a0;
  mbq_lp2_a2 = (1.0 - mbq_al2) / mbq_lp2_a0;

  mbq_w3 = 2.0 * $pi * 4500.0 / srate;
  mbq_al3 = sin(mbq_w3) * 0.7071;
  mbq_hp3_a0 = 1.0 + mbq_al3;
  mbq_hp3_b0 = ((1.0 + cos(mbq_w3)) * 0.5) / mbq_hp3_a0;
  mbq_hp3_b1 = (-(1.0 + cos(mbq_w3))) / mbq_hp3_a0;
  mbq_hp3_b2 = ((1.0 + cos(mbq_w3)) * 0.5) / mbq_hp3_a0;
  mbq_hp3_a1 = (-2.0 * cos(mbq_w3)) / mbq_hp3_a0;
  mbq_hp3_a2 = (1.0 - mbq_al3) / mbq_hp3_a0;

  // 1. Sub Mono Highpass on Side channel
  sub_fc = slider4 == 1 ? 90.0 : slider4 == 2 ? 130.0 : 20.0;
  sub_w0 = 2.0 * $pi * sub_fc / srate;
  sub_cos = cos(sub_w0); sub_sin = sin(sub_w0);
  sub_alpha = sub_sin / (2.0 * 0.7071);
  sub_b0 = (1.0 + sub_cos) * 0.5; sub_b1 = -(1.0 + sub_cos); sub_b2 = (1.0 + sub_cos) * 0.5;
  sub_a0 = 1.0 + sub_alpha; sub_a1 = -2.0 * sub_cos; sub_a2 = 1.0 - sub_alpha;
  sub_b0 /= sub_a0; sub_b1 /= sub_a0; sub_b2 /= sub_a0; sub_a1 /= sub_a0; sub_a2 /= sub_a0;

  // 2. Vocal Pocket Bell (Center 2200Hz, Q=1.4)
  vb_w0 = 2.0 * $pi * 2200.0 / srate;
  vb_gain_db = -slider6;
  vb_A = exp(vb_gain_db * (log(10.0) / 40.0));
  vb_alpha = sin(vb_w0) / (2.0 * 1.4);
  vb_b0 = 1.0 + vb_alpha * vb_A; vb_b1 = -2.0 * cos(vb_w0); vb_b2 = 1.0 - vb_alpha * vb_A;
  vb_a0 = 1.0 + vb_alpha / vb_A; vb_a1 = -2.0 * cos(vb_w0); vb_a2 = 1.0 - vb_alpha / vb_A;
  vb_b0 /= vb_a0; vb_b1 /= vb_a0; vb_b2 /= vb_a0; vb_a1 /= vb_a0; vb_a2 /= vb_a0;

  // 3. 12kHz Glassy Air Shelf
  air_w0 = 2.0 * $pi * 12000.0 / srate;
  air_A = exp(slider10 * (log(10.0) / 40.0));
  air_sin = sin(air_w0); air_cos = cos(air_w0);
  air_alpha = air_sin * 0.5 * sqrt((air_A + 1.0/air_A)*(1.0/0.7071 - 1.0) + 2.0);
  air_2sqrt = 2.0 * sqrt(air_A) * air_alpha;
  air_b0 = air_A * ((air_A + 1.0) + (air_A - 1.0)*air_cos + air_2sqrt);
  air_b1 = -2.0 * air_A * ((air_A - 1.0) + (air_A + 1.0)*air_cos);
  air_b2 = air_A * ((air_A + 1.0) + (air_A - 1.0)*air_cos - air_2sqrt);
  air_a0 = (air_A + 1.0) - (air_A - 1.0)*air_cos + air_2sqrt;
  air_a1 = 2.0 * ((air_A - 1.0) - (air_A + 1.0)*air_cos);
  air_a2 = (air_A + 1.0) - (air_A - 1.0)*air_cos - air_2sqrt;
  air_b0 /= air_a0; air_b1 /= air_a0; air_b2 /= air_a0; air_a1 /= air_a0; air_a2 /= air_a0;

  // 4. Devastator Suckback Tension Filter (Highpass 320Hz during suckback)
  dhp_w0 = 2.0 * $pi * 320.0 / srate;
  dhp_cos = cos(dhp_w0); dhp_sin = sin(dhp_w0);
  dhp_alpha = dhp_sin / (2.0 * 0.7071);
  dhp_b0 = (1.0 + dhp_cos) * 0.5; dhp_b1 = -(1.0 + dhp_cos); dhp_b2 = (1.0 + dhp_cos) * 0.5;
  dhp_a0 = 1.0 + dhp_alpha; dhp_a1 = -2.0 * dhp_cos; dhp_a2 = 1.0 - dhp_alpha;
  dhp_b0 /= dhp_a0; dhp_b1 /= dhp_a0; dhp_b2 /= dhp_a0; dhp_a1 /= dhp_a0; dhp_a2 /= dhp_a0;

  // 5. Tight-Arse Subsonic Highpass (2nd order stage @ slider21 Hz)
  ta_fc = slider21;
  ta_w0 = 2.0 * $pi * ta_fc / srate;
  ta_cos = cos(ta_w0); ta_sin = sin(ta_w0);
  ta_alpha = ta_sin / (2.0 * 0.85); // slightly resonant knee for low-end punch
  ta_b0 = (1.0 + ta_cos) * 0.5; ta_b1 = -(1.0 + ta_cos); ta_b2 = (1.0 + ta_cos) * 0.5;
  ta_a0 = 1.0 + ta_alpha; ta_a1 = -2.0 * ta_cos; ta_a2 = 1.0 - ta_alpha;
  ta_b0 /= ta_a0; ta_b1 /= ta_a0; ta_b2 /= ta_a0; ta_a1 /= ta_a0; ta_a2 /= ta_a0;

  // 1st order stage for 18dB/oct steep slope
  ta1_a = exp(-2.0 * $pi * (ta_fc * 0.85) / srate);

  // 6. Tight-Arse 80-160Hz Harmonic Bandpass (Center 120Hz, Q=1.2)
  bp_w0 = 2.0 * $pi * 120.0 / srate;
  bp_alpha = sin(bp_w0) / (2.0 * 1.2);
  bp_b0 = bp_alpha; bp_b1 = 0.0; bp_b2 = -bp_alpha;
  bp_a0 = 1.0 + bp_alpha; bp_a1 = -2.0 * cos(bp_w0); bp_a2 = 1.0 - bp_alpha;
  bp_b0 /= bp_a0; bp_b1 /= bp_a0; bp_b2 /= bp_a0; bp_a1 /= bp_a0; bp_a2 /= bp_a0;
);

update_synth_filters();


// ===== EAR-CANDY DIRECTOR BEGIN (shared region + energy aware producer tricks) =====
// Reads REAPER regions (gmem 100-109) AND the measured energy of this bus. Per region it picks a small,
// producer-specific set of tricks, then fires them only inside the right musical window. Every wet
// signal is derived from the performance itself and capped, so it stays barely audible.
dk_bm = 780000;
dk_rv = dk_bm;            dk_rv_sz = 400000;      // reverse-bloom capture
dk_dA = dk_bm + 400000;   dk_dB = dk_bm + 600000; dk_dA_sz = 200000;   // ping-pong throw
dk_ec = dk_bm + 800000;   dk_ec_sz = 200000;      // ducked echo
dk_hl = dk_bm + 1000000;                          // hall (4 combs x 8000 + 2 allpass x 3000)
dk_sh = dk_bm + 1060000;  dk_sh_sz = 16384;       // shifter / tap ring
dk_sl = dk_bm + 1080000;  dk_sl_sz = 30000;       // slap
memset(dk_bm, 0, 1110000);

dk_tip = 1900000; dk_pn = 1900080; dk_pm = 1900100; dk_ps = 1900120; dk_pd = 1900140; dk_pg = 1900160;
dk_nm = 1900180; dk_hint = 1900200; dk_tn = 1900220;
dk_tbl = 1900240; dk_env = dk_tbl; dk_hold = dk_tbl + 16; dk_tg = dk_tbl + 32; dk_ga = dk_tbl + 48; dk_tgp = dk_tbl + 64;
dk_hp = 1900330; dk_hd = 1900340; dk_sp = 1900350; dk_bs = 1900360;
dk_i = 0; loop(80, dk_tbl[dk_i] = 0; dk_i += 1; );
dk_i = 0; loop(8, dk_hp[dk_i] = 0; dk_hd[dk_i] = 0; dk_i += 1; );
dk_sp[0] = 0.0; dk_sp[1] = 0.33; dk_sp[2] = 0.66;
dk_vis = 65535;
dk_susm = 63232;   // sustained tricks: BREATH GHOSTUP GHOSTDN GRIT WIDE TREM SWEEP
dk_boot = 1;

dk_bs[0] = 0.22; dk_bs[1] = 0.30; dk_bs[2] = 0.30; dk_bs[3] = 0.20; dk_bs[4] = 0.45; dk_bs[5] = 0.55;
dk_bs[6] = 0.60; dk_bs[7] = 0.50; dk_bs[8] = 0.50; dk_bs[9] = 0.12; dk_bs[10] = 0.15; dk_bs[11] = 0.22;
dk_bs[12] = 0.30; dk_bs[13] = 0.10; dk_bs[14] = 0.18; dk_bs[15] = 0.20;

dk_nm[0] = "Arp Throw";
dk_hint[0] = "last arp phrase thrown ping-pong into the drop";
dk_nm[1] = "Reverse Swell";
dk_hint[1] = "reversed synth swell into the drop";
dk_nm[2] = "Dotted Echo";
dk_hint[2] = "dotted echo blooms in gaps after phrases";
dk_nm[3] = "Slapback";
dk_hint[3] = "short slap on sparse synth lines";
dk_nm[4] = "Plate Tail";
dk_hint[4] = "plate tail on big chord ring-outs";
dk_nm[5] = "Filter Rise";
dk_hint[5] = "high-pass rise across the last bar";
dk_nm[6] = "Gate Chop";
dk_hint[6] = "16th gate chop on the final beat";
dk_nm[7] = "Radio Choke";
dk_hint[7] = "bandpass choke before drops / bridge lo-fi";
dk_nm[8] = "Sparkle Air";
dk_hint[8] = "high-band sparkle in loud choruses";
dk_nm[9] = "Octave Shimmer";
dk_hint[9] = "octave shimmer late in loud choruses";
dk_nm[10] = "Sub-Octave Weight";
dk_hint[10] = "octave-down weight on breakdowns / peaks";
dk_nm[11] = "Pitch Dive";
dk_hint[11] = "pitch dive over the last 0.4 s of a section";
dk_nm[12] = "Grit Layer";
dk_hint[12] = "parallel grit when energy peaks";
dk_nm[13] = "Haas Widener";
dk_hint[13] = "Haas widen in choruses";
dk_nm[14] = "Tremolo Pulse";
dk_hint[14] = "tempo-synced tremolo on sparse pads";
dk_nm[15] = "Filter Sweep";
dk_hint[15] = "slow filter sweep through verses and builds";
dk_tn[0] = "Open (energy only)";
dk_tn[1] = "Intro";
dk_tn[2] = "Verse";
dk_tn[3] = "Pre-Chorus";
dk_tn[4] = "Chorus";
dk_tn[5] = "Bridge";
dk_tn[6] = "Outro";
dk_tn[7] = "Other";
dk_pn[0] = "Jordan Fish"; dk_pm[0] = 8806; dk_ps[0] = 5; dk_pd[0] = 2; dk_pg[0] = 1.05;
dk_tip[0] = "Electronic lift: filter rise across the pre-chorus bar.";
dk_tip[1] = "Octave shimmer on the synth hook, late in loud choruses.";
dk_tip[2] = "Gate chop on the last beat, then a wide open drop.";
dk_tip[3] = "Reverse swell blends under the chorus entry. Barely there.";
