dk_pn[12] = "Sam Bassal"; dk_pm[12] = 8487; dk_ps[12] = 5; dk_pd[12] = 2; dk_pg[12] = 1.0;
dk_tip[48] = "Big modern chorus: lush doubles and bright air.";
dk_tip[49] = "Three-bar bloom, filter rise and a throw on the last word.";
dk_tip[50] = "Ducked echo gives hooks a halo without blurring verses.";
dk_tip[51] = "Centre lead lock keeps the hook glued to the kick.";
dk_pn[13] = "Henrik Udd"; dk_pm[13] = 2018; dk_ps[13] = 7; dk_pd[13] = 2; dk_pg[13] = 1.05;
dk_tip[52] = "Cinematic hybrid: processed lead with electronic-style candy.";
