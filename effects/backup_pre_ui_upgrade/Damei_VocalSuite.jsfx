dk_pn[16] = "Zakk Cervini"; dk_pm[16] = 8676; dk_ps[16] = 7; dk_pd[16] = 2; dk_pg[16] = 1.0;
dk_tip[64] = "Pre-chorus telephone bandpass (500 Hz-3 kHz) on the final bar.";
