dk_pn[15] = "Dan Braunstein"; dk_pm[15] = 8967; dk_ps[15] = 0; dk_pd[15] = 2; dk_pg[15] = 0.9;
dk_tip[60] = "Throw catches the last word 1.5 s before the chorus (ping-pong).";
