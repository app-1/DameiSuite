dk_pn[14] = "Joey Sturgis"; dk_pm[14] = 12744; dk_ps[14] = 6; dk_pd[14] = 2; dk_pg[14] = 1.0;
dk_tip[56] = "Hyper-tight, polished lead with vocal-edit flavour.";
