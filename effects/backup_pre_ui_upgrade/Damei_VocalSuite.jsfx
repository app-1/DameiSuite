// =============================================================================
// TAB 2: DUAL-STAGE DYNAMICS (1176 FET PEAK + LA-2A OPTO BODY)
// =============================================================================
slider1 == 2 ? (
  f_y = disp_y; f_h = disp_h; f_w = disp_w;
  gfx_r = 0.024; gfx_g = 0.026; gfx_b = 0.036; gfx_rect(disp_x, f_y, f_w, f_h);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(disp_x, f_y, f_w, f_h, 0);

  gfx_setfont(1, "Orbitron", 16, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = disp_x + 20; gfx_y = f_y + 14;
  gfx_drawstr("ANALOGOBSESSION DUAL-COMP RACK (FETISH 1176 + LALA LA-2A + LOADES DE-ESSER)");

  gfx_setfont(1, "Consolas", 13.5, 'b'); gfx_r = 0.80; gfx_g = 0.85; gfx_b = 0.90;
  gfx_x = disp_x + 20; gfx_y = f_y + 38;
  gfx_drawstr("Ultrafast FET catches lightning peaks; Opto holds vowel body rock-solid.");

  rw = floor((f_w - 48) / 2); rh = f_h - 75;

  rx1 = disp_x + 16; ry = f_y + 60;
  gfx_r = 0.030; gfx_g = 0.035; gfx_b = 0.048; gfx_rect(rx1, ry, rw, rh);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(rx1, ry, rw, rh, 0);

  gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = rx1 + 16; gfx_y = ry + 16; gfx_drawstr("STAGE 1: FET 1176 PEAK SHAVER");
  gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = rx1 + 16; gfx_y = ry + 38; gfx_drawstr("Ultrafast 200us Consonant Control");

  mx = rx1 + rw * 0.5; my = ry + 110; m_rad = 50;
  gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14; gfx_circle(mx, my, m_rad, 1);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_circle(mx, my, m_rad, 0);

  f_ang = -1.8 + (abs(fet_gr_db) / 6.0) * 2.8;
  gfx_r = 1.00; gfx_g = 0.20; gfx_b = 0.60;
  gfx_line(mx, my, mx + sin(f_ang) * (m_rad - 8), my - cos(f_ang) * (m_rad - 8));
  gfx_line(mx - 1, my, mx + sin(f_ang) * (m_rad - 8) - 1, my - cos(f_ang) * (m_rad - 8));

  gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  fet_txt = sprintf(#, "FET GR: %+.1f dB", fet_gr_db);
  gfx_measurestr(fet_txt, ftw, fth);
  gfx_x = rx1 + (rw - ftw) * 0.5; gfx_y = ry + 170; gfx_drawstr(fet_txt);

  fb_w = rw - 32; fb_h = rh - 210; fb_x = rx1 + 16; fb_y = ry + 195;
  gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.05; gfx_rect(fb_x, fb_y, fb_w, fb_h);
  gfx_r = 0.24; gfx_g = 0.18; gfx_b = 0.32; gfx_rect(fb_x, fb_y, fb_w, fb_h, 0);

  rail_x1 = fb_x + floor(fb_w * 0.5);
  gfx_line(rail_x1, fb_y + 4, rail_x1, fb_y + fb_h - 4);
  f_frac = slider6 / 100.0;
  cap_y1 = fb_y + fb_h - 10 - floor(f_frac * (fb_h - 20));

  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52;
  gfx_rect(rail_x1 - 2, cap_y1, 5, fb_y + fb_h - 10 - cap_y1);

  gfx_r = 0.25; gfx_g = 0.20; gfx_b = 0.30; gfx_rect(fb_x + 6, cap_y1 - 8, fb_w - 12, 16);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(fb_x + 6, cap_y1 - 8, fb_w - 12, 16, 0);

  mouse_down && (mouse_x >= fb_x && mouse_x <= fb_x + fb_w && mouse_y >= fb_y && mouse_y <= fb_y + fb_h) ? (
    slider6 = floor((1.0 - ((mouse_y - fb_y) / fb_h)) * 100.0);
    slider6 = max(0, min(100, slider6)); slider_automate();
  );

  rx2 = rx1 + rw + 16;
  gfx_r = 0.030; gfx_g = 0.035; gfx_b = 0.048; gfx_rect(rx2, ry, rw, rh);
  gfx_r = 0.85; gfx_g = 0.15; gfx_b = 1.00; gfx_rect(rx2, ry, rw, rh, 0);

  gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 0.90; gfx_g = 0.55; gfx_b = 1.00;
  gfx_x = rx2 + 16; gfx_y = ry + 16; gfx_drawstr("STAGE 2: LA-2A OPTICAL LEVELER");
  gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = rx2 + 16; gfx_y = ry + 38; gfx_drawstr("Smooth Program-Dependent Vowel Body");

  mx2 = rx2 + rw * 0.5; my2 = ry + 110;
  gfx_r = 0.10; gfx_g = 0.12; gfx_b = 0.18; gfx_circle(mx2, my2, m_rad, 1);
  gfx_r = 0.85; gfx_g = 0.15; gfx_b = 1.00; gfx_circle(mx2, my2, m_rad, 0);

  o_ang = -1.8 + (abs(opto_gr_db) / 6.0) * 2.8;
  gfx_r = 0.85; gfx_g = 0.15; gfx_b = 1.00;
  gfx_line(mx2, my2, mx2 + sin(o_ang) * (m_rad - 8), my2 - cos(o_ang) * (m_rad - 8));
  gfx_line(mx2 - 1, my2, mx2 + sin(o_ang) * (m_rad - 8) - 1, my2 - cos(o_ang) * (m_rad - 8));

  gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  opto_txt = sprintf(#, "OPTO GR: %+.1f dB", opto_gr_db);
  gfx_measurestr(opto_txt, otw, oth);
  gfx_x = rx2 + (rw - otw) * 0.5; gfx_y = ry + 170; gfx_drawstr(opto_txt);

  fb_w2 = rw - 32; fb_h2 = rh - 210; fb_x2 = rx2 + 16; fb_y2 = ry + 195;
  gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.05; gfx_rect(fb_x2, fb_y2, fb_w2, fb_h2);
  gfx_r = 0.24; gfx_g = 0.18; gfx_b = 0.32; gfx_rect(fb_x2, fb_y2, fb_w2, fb_h2, 0);

  rail_x2 = fb_x2 + floor(fb_w2 * 0.5);
  gfx_line(rail_x2, fb_y2 + 4, rail_x2, fb_y2 + fb_h2 - 4);
  o_frac = slider7 / 100.0;
  cap_y2 = fb_y2 + fb_h2 - 10 - floor(o_frac * (fb_h2 - 20));

  gfx_r = 0.85; gfx_g = 0.15; gfx_b = 1.00;
  gfx_rect(rail_x2 - 2, cap_y2, 5, fb_y2 + fb_h2 - 10 - cap_y2);

  gfx_r = 0.25; gfx_g = 0.20; gfx_b = 0.30; gfx_rect(fb_x2 + 6, cap_y2 - 8, fb_w2 - 12, 16);
  gfx_r = 0.85; gfx_g = 0.15; gfx_b = 1.00; gfx_rect(fb_x2 + 6, cap_y2 - 8, fb_w2 - 12, 16, 0);

  mouse_down && (mouse_x >= fb_x2 && mouse_x <= fb_x2 + fb_w2 && mouse_y >= fb_y2 && mouse_y <= fb_y2 + fb_h2) ? (
    slider7 = floor((1.0 - ((mouse_y - fb_y2) / fb_h2)) * 100.0);
    slider7 = max(0, min(100, slider7)); slider_automate();
  );
);

// =============================================================================
// TAB 3: MID/SIDE & GUITAR POCKET HANDSHAKE
// =============================================================================
slider1 == 3 ? (
  m_y = disp_y; m_h = disp_h; m_w = disp_w;
  gfx_r = 0.024; gfx_g = 0.026; gfx_b = 0.036; gfx_rect(disp_x, m_y, m_w, m_h);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(disp_x, m_y, m_w, m_h, 0);

  m_col_w = floor((m_w - 30) * 0.5);

  gfx_setfont(1, "Orbitron", 16, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = disp_x + 20; gfx_y = m_y + 14;
  gfx_drawstr("MID/SIDE VOCAL IMAGER & GUITAR POCKET");

  gfx_setfont(1, "Consolas", 13.5, 'b'); gfx_r = 0.80; gfx_g = 0.85; gfx_b = 0.90;
  gfx_x = disp_x + 20; gfx_y = m_y + 38;
  gfx_drawstr("Locks lead vocal in dead-center while blooming harmonies into sides.");

  draw_vocal_param_slider(m_y + 70, "1. STEREO BACKING WIDTH", slider8, 0.80, 1.60, "%.2f x", 8);

  c_by = m_y + 140; c_w = m_col_w - 32; c_h = 44;
  c_hov = (mouse_x >= disp_x + 20 && mouse_x <= disp_x + 20 + c_w && mouse_y >= c_by && mouse_y <= c_by + c_h);
  gfx_r = slider9 ? 0.35 : (c_hov ? 0.16 : 0.05);
  gfx_g = slider9 ? 0.08 : (c_hov ? 0.05 : 0.03);
  gfx_b = slider9 ? 0.24 : (c_hov ? 0.14 : 0.06);
  gfx_rect(disp_x + 20, c_by, c_w, c_h);
  gfx_r = slider9 ? 1.00 : 0.35; gfx_g = slider9 ? 0.16 : 0.20; gfx_b = slider9 ? 0.52 : 0.35;
  gfx_rect(disp_x + 20, c_by, c_w, c_h, 0);

  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_r = slider9 ? 1.0 : 0.85; gfx_g = slider9 ? 1.0 : 0.85; gfx_b = slider9 ? 1.0 : 0.85;
  c_txt = slider9 ? "● CENTER LEAD LOCK (100% MONO <200Hz: ON)" : "○ CENTER LEAD LOCK: BYPASS";
  gfx_measurestr(c_txt, clw, clh);
  gfx_x = disp_x + 20 + (c_w - clw) * 0.5; gfx_y = c_by + 14; gfx_drawstr(c_txt);
  mouse_clicked && c_hov ? (slider9 = !slider9; update_vocal_filters(); slider_automate(););

  ex_by = c_by + 60; ex_h = m_h - (ex_by - m_y) - 20;
  gfx_r = 0.015; gfx_g = 0.018; gfx_b = 0.026; gfx_rect(disp_x + 20, ex_by, c_w, ex_h);
  gfx_r = 0.24; gfx_g = 0.18; gfx_b = 0.32; gfx_rect(disp_x + 20, ex_by, c_w, ex_h, 0);

  gfx_setfont(1, "Consolas", 13.5, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = disp_x + 32; gfx_y = ex_by + 16;
  gfx_drawstr("GUITAR BUS ALCHEMIST POCKET STATUS:");

  gfx_setfont(1, "Consolas", 12.5, 'b');
  gmem[840] == 1 ? (
    gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
    gfx_x = disp_x + 32; gfx_y = ex_by + 40;
    gfx_drawstr("● GUITAR POCKET CARVE ACTIVE: -1.6dB center pocket carved at 205Hz.");
    gfx_x = disp_x + 32; gfx_y = ex_by + 60;
    gfx_drawstr("  Lead vocals sit forward without clashing with rhythm guitars.");
  ) : (
    gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
    gfx_x = disp_x + 32; gfx_y = ex_by + 40;
    gfx_drawstr("▲ GUITAR BUS STANDALONE: Center pocket carving unlinked.");
  );

  r_col_x = disp_x + m_col_w + 14; r_col_w = m_w - m_col_w - 28;
  gfx_r = 0.015; gfx_g = 0.018; gfx_b = 0.026; gfx_rect(r_col_x, m_y + 12, r_col_w, m_h - 24);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(r_col_x, m_y + 12, r_col_w, m_h - 24, 0);

  gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = r_col_x + 14; gfx_y = m_y + 24;
  gfx_drawstr("MID/SIDE VOCAL PANORAMA POLAR RADAR");

  sc_cx = r_col_x + r_col_w * 0.5; sc_cy = m_y + 12 + (m_h - 90) * 0.5;
  sc_rad = min(r_col_w * 0.38, (m_h - 110) * 0.42);

  gfx_r = 0.12; gfx_g = 0.08; gfx_b = 0.18;
  gfx_circle(sc_cx, sc_cy, sc_rad, 0);
  gfx_circle(sc_cx, sc_cy, floor(sc_rad * 0.66), 0);
  gfx_circle(sc_cx, sc_cy, floor(sc_rad * 0.33), 0);
  gfx_line(sc_cx - sc_rad, sc_cy, sc_cx + sc_rad, sc_cy);
  gfx_line(sc_cx, sc_cy - sc_rad, sc_cx, sc_cy + sc_rad);

  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_a = 0.25;
  gfx_circle(sc_cx, sc_cy, floor(sc_rad * 0.35), 1);
  gfx_a = 1.00;

  gfx_setfont(1, "Consolas", 11, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = sc_cx - sc_rad + 4; gfx_y = sc_cy - 14; gfx_drawstr("LEFT");
  gfx_x = sc_cx + sc_rad - 35; gfx_y = sc_cy - 14; gfx_drawstr("RIGHT");
  gfx_x = sc_cx - 14; gfx_y = sc_cy - sc_rad + 4; gfx_drawstr("MID");
);

// =============================================================================
// TAB 4: ANALOG DESK, 12AX7 TUBE & MAAG AIR SHEEN
// =============================================================================
slider1 == 4 ? (
  a_y = disp_y; a_h = disp_h; a_w = disp_w;
  gfx_r = 0.024; gfx_g = 0.026; gfx_b = 0.036; gfx_rect(disp_x, a_y, a_w, a_h);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(disp_x, a_y, a_w, a_h, 0);

  gfx_setfont(1, "Orbitron", 16, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = disp_x + 20; gfx_y = a_y + 14;
  gfx_drawstr("ANALOG CONSOLE, TUBE WARMTH & MAAG 16kHz AIR SHEEN");

  gfx_setfont(1, "Consolas", 13.5, 'b'); gfx_r = 0.80; gfx_g = 0.85; gfx_b = 0.90;
  gfx_x = disp_x + 20; gfx_y = a_y + 38;
  gfx_drawstr("Silky 16kHz top-end air lifts vocals above the wall of sound without digital spit.");

  at_w = floor((a_w - 48) / 3); at_h = a_h - 75;
  ai = 0;
  loop(3,
    ax = disp_x + 16 + ai * (at_w + 8); ay = a_y + 60;
    gfx_r = 0.030; gfx_g = 0.035; gfx_b = 0.048; gfx_rect(ax, ay, at_w, at_h);
    gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(ax, ay, at_w, at_h, 0);

    ai == 0 ? (
      gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
      gfx_x = ax + 14; gfx_y = ay + 14; gfx_drawstr("MAAG 16kHz AIR SHEEN");
      gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
      gfx_x = ax + 14; gfx_y = ay + 36; gfx_drawstr("Silky High Air Band Lift");

      gx = ax + at_w * 0.5; gy = ay + 100; g_rad = min(46, floor(at_w * 0.26));
      gfx_r = 0.12; gfx_g = 0.10; gfx_b = 0.18; gfx_circle(gx, gy, g_rad, 1);
      gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_circle(gx, gy, g_rad, 0);

      air_ang = -1.8 + (slider10 / 5.0) * 3.6;
      gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
      gfx_line(gx, gy, gx + sin(air_ang) * (g_rad - 8), gy - cos(air_ang) * (g_rad - 8));

      gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
      air_txt = sprintf(#, "AIR LIFT: %+.1f dB", slider10);
      gfx_measurestr(air_txt, atw, ath);
      gfx_x = ax + (at_w - atw) * 0.5; gfx_y = ay + 155;
      gfx_drawstr(air_txt);

      a_drv = floor((slider10 / 5.0) * 100.0);
    ) : ai == 1 ? (
      gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
      gfx_x = ax + 14; gfx_y = ay + 14; gfx_drawstr("BRITSON NEVE DESK");
      gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
      gfx_x = ax + 14; gfx_y = ay + 36; gfx_drawstr("Harmonic Desk Saturation");

      gx = ax + at_w * 0.5; gy = ay + 100; g_rad = min(46, floor(at_w * 0.26));
      gfx_r = 0.12; gfx_g = 0.10; gfx_b = 0.18; gfx_circle(gx, gy, g_rad, 1);
      gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_circle(gx, gy, g_rad, 0);

      d_ang = -1.8 + (slider12 / 100.0) * 3.6;
      gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;
      gfx_line(gx, gy, gx + sin(d_ang) * (g_rad - 8), gy - cos(d_ang) * (g_rad - 8));

      gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
      thd_txt = sprintf(#, "THD: %.2f%%", slider12 * 0.024);
      gfx_measurestr(thd_txt, tdw, tdh);
      gfx_x = ax + (at_w - tdw) * 0.5; gfx_y = ay + 155;
      gfx_drawstr(thd_txt);

      a_drv = slider12;
    ) : (
      gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
      gfx_x = ax + 14; gfx_y = ay + 14; gfx_drawstr("12AX7 TUBE WARMTH");
      gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
      gfx_x = ax + 14; gfx_y = ay + 36; gfx_drawstr("Glowing Cathode Density");

      gx = ax + at_w * 0.5; gy = ay + 100;
      gfx_r = 0.06; gfx_g = 0.04; gfx_b = 0.10; gfx_rect(gx - 20, gy - 32, 40, 64);
      gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(gx - 20, gy - 32, 40, 64, 0);

      glow_a = 0.40 + (slider13 / 100.0) * 0.60;
      gfx_r = 1.00; gfx_g = 0.55; gfx_b = 0.15; gfx_a = glow_a;
      gfx_circle(gx, gy - 8, 8, 1); gfx_circle(gx, gy + 8, 8, 1);
      gfx_a = 1.00;

      gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
      tb_txt = "WARMTH: 12AX7 GLOW";
      gfx_measurestr(tb_txt, tbw, tbh);
      gfx_x = ax + (at_w - tbw) * 0.5; gfx_y = ay + 155;
      gfx_drawstr(tb_txt);

      a_drv = slider13;
    );

    a_bar_w = at_w - 28; a_bar_h = at_h - 195;
    a_bar_x = ax + 14; a_bar_y = ay + 180;
    gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.05; gfx_rect(a_bar_x, a_bar_y, a_bar_w, a_bar_h);
    gfx_r = 0.24; gfx_g = 0.18; gfx_b = 0.32; gfx_rect(a_bar_x, a_bar_y, a_bar_w, a_bar_h, 0);

    rail_ax = a_bar_x + floor(a_bar_w * 0.5);
    gfx_line(rail_ax, a_bar_y + 4, rail_ax, a_bar_y + a_bar_h - 4);

    a_frac = max(0.0, min(1.0, a_drv / 100.0));
    cap_y_a = a_bar_y + a_bar_h - 10 - floor(a_frac * (a_bar_h - 20));

    gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52;
    gfx_rect(rail_ax - 2, cap_y_a, 5, a_bar_y + a_bar_h - 10 - cap_y_a);

    gfx_r = 0.25; gfx_g = 0.20; gfx_b = 0.30; gfx_rect(a_bar_x + 6, cap_y_a - 8, a_bar_w - 12, 16);
    gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(a_bar_x + 6, cap_y_a - 8, a_bar_w - 12, 16, 0);

    gfx_setfont(1, "Consolas", 18, 'b'); gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    d_txt = sprintf(#, "%d %%", a_drv);
    gfx_measurestr(d_txt, dtw, dth);
    gfx_x = a_bar_x + (a_bar_w - dtw) * 0.5; gfx_y = a_bar_y + a_bar_h - 30;
    gfx_drawstr(d_txt);

    mouse_down && (mouse_x >= a_bar_x && mouse_x <= a_bar_x + a_bar_w && mouse_y >= a_bar_y && mouse_y <= a_bar_y + a_bar_h) ? (
      set_pct = floor((1.0 - ((mouse_y - (a_bar_y + 10)) / (a_bar_h - 20))) * 100.0);
      set_pct = max(0, min(100, set_pct));
      ai == 0 ? (slider10 = (set_pct / 100.0) * 5.0; update_vocal_filters();) :
      ai == 1 ? (slider12 = set_pct;) :
      (slider13 = set_pct;);
      slider_automate();
    );
    ai += 1;
  );
);

// =============================================================================
// TAB 5: PRODUCER VOCAL MATRIX (17 INDUSTRY REFERENCE PROFILES)
// =============================================================================
slider1 == 5 ? (
  p_y = disp_y; p_h = disp_h; p_w = disp_w;
  gfx_r = 0.024; gfx_g = 0.026; gfx_b = 0.036; gfx_rect(disp_x, p_y, p_w, p_h);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52; gfx_rect(disp_x, p_y, p_w, p_h, 0);

  gfx_setfont(1, "Orbitron", 16, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = disp_x + 20; gfx_y = p_y + 14;
  gfx_drawstr("PRODUCER VOCAL SIGNATURE MATRIX (19 INDUSTRY REFERENCE PROFILES)");

  cols = 4;
  tile_pw = floor((p_w - 40) / cols);
  tile_ph = 36;
  pi = 0;
  loop(19,
    row = floor(pi / cols);
    col = pi % cols;
    px = disp_x + 16 + col * (tile_pw + 8);
    py = p_y + 44 + row * (tile_ph + 5);

    is_sel = (slider18 == pi);
    is_hov = (mouse_x >= px && mouse_x <= px + tile_pw && mouse_y >= py && mouse_y <= py + tile_ph);

    gfx_r = is_sel ? 0.28 : (is_hov ? 0.14 : 0.035);
    gfx_g = is_sel ? 0.08 : (is_hov ? 0.05 : 0.025);
    gfx_b = is_sel ? 0.22 : (is_hov ? 0.12 : 0.045);
    gfx_rect(px, py, tile_pw, tile_ph);

    gfx_r = is_sel ? 1.00 : 0.24;
    gfx_g = is_sel ? 0.16 : 0.18;
    gfx_b = is_sel ? 0.52 : 0.32;
    gfx_rect(px, py, tile_pw, tile_ph, 0);

    gfx_setfont(1, "Orbitron", 12, 'b');
    gfx_r = is_sel ? 1.00 : 0.85;
    gfx_g = is_sel ? 0.65 : 0.85;
    gfx_b = is_sel ? 0.85 : 0.90;

    p_lbl = (
      pi == 0  ? "0: Default Neutral Wire" :
      pi == 1  ? "1: Lance Prenc (Alpha Wolf)" :
      pi == 2  ? "2: Scott Seigel (DIESECT)" :
      pi == 3  ? "3: Jonathan Dolese (Cane Hill)" :
      pi == 4  ? "4: Buster Odeholm (thrown)" :
      pi == 5  ? "5: Kel Pinchin (Currents)" :
      pi == 6  ? "6: Sam Guaiana (Silverstein)" :
      pi == 7  ? "7: Forrester Savell (Karnivool)" :
      pi == 8  ? "8: Jens Bogren (Fascination)" :
      pi == 9  ? "9: Adam Nolly (Periphery)" :
      pi == 10 ? "10: Will Putney (FFAA)" :
      pi == 11 ? "11: George Lever (Sleep Token)" :
      pi == 12 ? "12: Sam Bassal (Thornhill)" :
      pi == 13 ? "13: Henrik Udd (Architects)" :
      pi == 14 ? "14: Joey Sturgis (Asking Alex)" :
      pi == 15 ? "15: Dan Braunstein (Spiritbox)" :
      pi == 16 ? "16: Zakk Cervini (Blink-182)" :
      pi == 17 ? "17: Acle Kahney (TesseracT)" :
      "18: heaving. (carsick)"
    );

    gfx_x = px + 10; gfx_y = py + 10;
    gfx_drawstr(p_lbl);

    mouse_clicked && is_hov ? (
      slider18 = pi; apply_vocal_preset(slider18); slider_automate();
    );
    pi += 1;
  );

  bk_y = p_y + 260; bk_h = p_h - 275;
  gfx_r = 0.015; gfx_g = 0.018; gfx_b = 0.026;
  gfx_rect(disp_x + 16, bk_y, p_w - 32, bk_h);
  gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.52;
  gfx_rect(disp_x + 16, bk_y, p_w - 32, bk_h, 0);

  gfx_setfont(1, "Orbitron", 15, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.75;
  gfx_x = disp_x + 28; gfx_y = bk_y + 12;
  gfx_drawstr("VOCAL SOVEREIGN MASTER PRODUCTION BLUEPRINT");

  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  p_idx = slider18;
  p_idx == 15 ? (
    gfx_x = disp_x + 28; gfx_y = bk_y + 36;
    gfx_drawstr("DAN BRAUNSTEIN BLUEPRINT: Upfront lead sitting directly in Guitar Bus center pocket (-1.6dB cut),");
    gfx_x = disp_x + 28; gfx_y = bk_y + 58;
    gfx_drawstr("with +2.5dB Maag 16kHz Air lift, surgical 6.9kHz de-essing, and dual-stage FET/Opto leveling glue.");
  ) : p_idx == 14 ? (
    gfx_x = disp_x + 28; gfx_y = bk_y + 36;
    gfx_drawstr("JOEY STURGIS BLUEPRINT: Aggressive modern metalcore vocal with heavy 1176 FET peak clamping (-4.5dB),");
    gfx_x = disp_x + 28; gfx_y = bk_y + 58;
    gfx_drawstr("pushed 1.8kHz presence bite, and Neve desk saturation ensuring screaming leads punch through dense mixes.");
  ) : p_idx == 16 ? (
    // AnalogObsession & ReEQ Producer Calibrations
    slider43 = 4; slider44 = 1; slider45 = 1; slider46 = 1;
    slider47 = 85; slider48 = -2.0; slider49 = -2.0;
    gfx_x = disp_x + 28; gfx_y = bk_y + 36;
    gfx_drawstr("ZAKK CERVINI BLUEPRINT: Bright, upfront radio pop-rock vocal with wide stereo backing doubles (+0.25x),");
    gfx_x = disp_x + 28; gfx_y = bk_y + 58;
    gfx_drawstr("pristine 16kHz air sheen, and transparent LA-2A optical leveling for dynamic vowel consistency.");
  ) : (
    gfx_x = disp_x + 28; gfx_y = bk_y + 36;
    gfx_drawstr("SOVEREIGN UNIVERSAL BLUEPRINT: Center lead mono lock, dual-stage FET+Opto compression,");
    gfx_x = disp_x + 28; gfx_y = bk_y + 58;
    gfx_drawstr("dynamic sibilance protection, and air sheen for a broadcast-ready vocal that rules the mix.");
  );

  gfx_setfont(1, "Consolas", 13, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = disp_x + 28; gfx_y = bk_y + 88;
  gfx_drawstr("CHAIN: IN -> SPLIT-BAND DE-ESSER -> 1176 FET -> LA-2A OPTO -> M/S POCKET -> 16k AIR -> BRITSON -> CEIL");
);
