desc:Damei Vocal Sovereign (Imperial Crown & Pocket Alchemist)
// =============================================================================
// DAMEI VOCAL SOVEREIGN // IMPERIAL CROWN (v2.0)
// Complete Vocal Bus Processing Engine with Holographic Aura & Producer Ear-Candy
// Imperial Magenta, Cyber Rose Quartz & Luminous Violet Design
// Built by Damei Audio & Antigravity IDE
// =============================================================================

slider1:0<0,5,1{Vocal Aura & Stem Commander,Producer Ear-Candy & Drops,AnalogObsession Dual-Comp & De-Esser,Mid/Side & Pocket Handshake,Analog Desk & Air Sheen,Producer Vocal Matrix}>-Active Module
slider2:-12.0<-24.0,-6.0,0.5>-Target Level (dBFS Peak)
slider3:6800<4000,9000,100>-De-Esser Center Sibilance Frequency (Hz)
slider4:-22.0<-48.0,-10.0,0.5>-De-Esser Dynamic Threshold (dBFS)
slider5:3.5<1.0,8.0,0.5>-De-Esser Max Attenuation Depth (dB)
slider6:25<0,100,1>-Stage 1: 1176 Fast FET Peak Shaver (%)
slider7:20<0,100,1>-Stage 2: LA-2A Optical Body Leveler (%)
slider8:1.15<0.80,1.60,0.02>-Stereo Backing Width Ratio (1.0 = Normal)
slider9:1<0,1,1{Off,Center Lead Lock 100% Mono <200Hz}>-Center Lead Channel Lock
slider10:1.8<0.0,5.0,0.2>-Maag 16kHz Air Band Sheen (dB)
slider11:0.0<-4.0,4.0,0.2>-1.8kHz Vocal Body & Presence (dB)
slider12:0<0,100,1>-Britson Neve Console Desk Saturation (%)
slider13:0<0,100,1>-12AX7 Tube Warmth & Harmonic Density (%)
slider14:0<0,2,1{Linear Transparent Passthrough,Smooth Musical Hermite Soft-Clip,Commercial Hard Brickwall Clamp}>-Mix Bus Clipper Topology
slider15:-0.1<-12.0,-0.1,0.1>-Target Headroom Ceiling (dBTP)
slider16:0<0,1,1{Free Output Gain (No Clipping),Strict Pre-Master Headroom Lock}>-Headroom Ceiling Guardian
slider17:0.0<-12.0,12.0,0.5>-Output Makeup Trim (dB)
slider18:15<0,18,1{Default Neutral Wire,Lance Prenc (Alpha Wolf / Polaris),Scott Seigel (DIESECT),Jonathan Dolese (Cane Hill),Buster Odeholm (thrown / Vildhjarta),Kel Pinchin (Currents),Sam Guaiana (Silverstein),Forrester Savell (Karnivool / Dead Letter Circus),Jens Bogren (Fascination Street),Adam Nolly Getgood (Periphery / GGD),Will Putney (Fit For An Autopsy / Knocked Loose),George Lever (Sleep Token / Loathe),Sam Bassal (Thornhill / Ocean Grove),Henrik Udd (Architects / Bring Me The Horizon),Joey Sturgis (Asking Alexandria / Attack Attack),Dan Braunstein (Spiritbox / Dayseeker),Zakk Cervini (Blink-182 / Machine Gun Kelly),Acle Kahney (TesseracT - King),heaving. (carsick / Grungegaze)}>-Producer Vocal Signature Preset
slider19:0<0,3,1{Active Cover Stems (Lead/FX/Glitch/Doubles),Full Multi-Bus (Lead/Verse/Chorus/Harm/AdLib),Raw Dynamic Tracking,Acoustic / Intimate}>-Vocal Session Layout Mode
slider20:-18.0<-24.0,-12.0,1.0>-Analogue 0 VU Target Reference (dBFS RMS)
slider21:1<0,1,1{Manual Parameter Mode,AI Assist Active Formula Calibration}>-AI Assist Intelligent Engine
slider22:1<0,1,1{Free Dynamic,Guitar Pocket Lock (Auto-Unmask vs Gtr Bus)}>-Guitar Pocket Handshake Link
slider23:0.0<-6.0,6.0,0.1>-Input Gain Calibration (dB)
slider24:0.0<-12.0,6.0,0.5>-Lead Vox Stem Level (dB) [Trk 5 Lead Stem]
slider25:-4.0<-18.0,6.0,0.5>-Ad-Lib Stem Level (dB) [Trk 6-7 VoxEffect / Glitch]
slider26:6<0,100,1>-Ad-Lib FX & Space Amount (%) [Trk 6-10 EchoBoy & Verb Mix]
slider27:-5.0<-18.0,6.0,0.5>-Doubles L/R Level (dB) [Trk 8-10 Doubles]
slider28:0.0<-24.0,6.0,0.5>-Vocal Reverb & Aux Space (dB) [Trk 1-3 VOXVERB]
slider29:1<0,1,1{Bypassed,Active De-Esser & Dual Dynamics}>-Master Vocal Engine Toggle
// Producer Ear-Candy & Drop Automators
slider30:1<0,1,1{Off,Auto Pre-Drop Throw (Final Bar into Chorus Only)}> -Pre-Chorus Vocal Throw Delay
slider31:1<0,1,1{Off,Active Reverse Vocal Swell into Chorus}>-Reverse Swell Generator
slider32:0<0,2,1{Off (Clean Lead),Auto Pre-Drop Choke (Final Bar Only),Contextual Ad-Lib Lo-Fi (Bridge/Drop Slap)}>-Telephone / Megaphone Drop Filter
slider33:35<10,80,5>-Throw Delay Feedback (%)
slider34:2.0<0.5,4.0,0.5>-Reverse Swell Duration (Bars)
slider39:1<0,1,1{Classic Fixed-Timing Automators,Ear-Candy Director (Region + Energy Aware)}>-Ear-Candy Director
slider40:15<0,100,1>-Master Vocal Effect Intensity (%)
slider41:8967<0,65535,1>-Ear-Candy Trick Palette (bitmask)
slider42:1<0,1,1{Manual Palette,Follow Producer Preset}>-Ear-Candy Palette Follows Producer
// AnalogObsession Modeled Dynamics (FETISH, LALA, LOADES) & ReEQ
slider43:0<0,4,1{4:1 Ratio,8:1 Ratio,12:1 Ratio,20:1 Ratio,ALL-BUTTONS (SLAM)}>-FET Comp Ratio (AnalogObsession FETISH)
slider44:0<0,1,1{Compress (Smooth 3:1),Limit (Hard Opto Knee)}>-LA-2A Mode (AnalogObsession LALA)
slider45:1<0,1,1{Off,Sidechain Highpass Emphasis (Protect Chest Warmth)}>-LA-2A Sidechain Emphasis
slider46:1<0,1,1{Wideband,Split-Band (Sibilance Isolation)}>-LOADES De-Esser Mode (AnalogObsession LOADES)
slider47:85<60,160,5>-ReEQ Highpass Cutoff (Hz)
slider48:-2.0<-8.0,2.0,0.5>-ReEQ 380Hz Chest Mud Scoop (dB)
slider49:-2.5<-8.0,2.0,0.5>-ReEQ 5.2kHz Harshness Notch (dB)

slider35:1<0,1,1{Off,On}>-Matrix Trim (applies Assessment Matrix auto-correct lane)
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=2097152
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@serialize
file_var(0, slider1);
file_var(0, slider2);
file_var(0, slider3);
file_var(0, slider4);
file_var(0, slider5);
file_var(0, slider6);
file_var(0, slider7);
file_var(0, slider8);
file_var(0, slider9);
file_var(0, slider10);
file_var(0, slider11);
file_var(0, slider12);
file_var(0, slider13);
file_var(0, slider14);
file_var(0, slider15);
file_var(0, slider16);
file_var(0, slider17);
file_var(0, slider18);
file_var(0, slider19);
file_var(0, slider20);
file_var(0, slider21);
file_var(0, slider22);
file_var(0, slider23);
file_var(0, slider24);
file_var(0, slider25);
file_var(0, slider26);
file_var(0, slider27);
file_var(0, slider28);
file_var(0, slider29);
file_var(0, slider30);
file_var(0, slider31);
file_var(0, slider32);
file_var(0, slider33);
file_var(0, slider34);
file_var(0, slider39); file_var(0, slider40); file_var(0, slider41); file_var(0, slider42);
file_var(0, slider43); file_var(0, slider44); file_var(0, slider45); file_var(0, slider46);
file_var(0, slider47); file_var(0, slider48); file_var(0, slider49);

@init
// Explicitly zero out delay buffers on initialization
memset(40000, 0, 96000);
memset(140000, 0, 96000);
smooth_sat_pct = 0.0;

ext_noinit = 1.0;

// ReEQ Vocal Biquad Filters (HPF, 380Hz Mud Scoop, 5.2kHz De-Harsh)
req_hp_x1_l = 0; req_hp_x2_l = 0; req_hp_y1_l = 0; req_hp_y2_l = 0;
req_hp_x1_r = 0; req_hp_x2_r = 0; req_hp_y1_r = 0; req_hp_y2_r = 0;
req_mud_x1_l = 0; req_mud_x2_l = 0; req_mud_y1_l = 0; req_mud_y2_l = 0;
req_mud_x1_r = 0; req_mud_x2_r = 0; req_mud_y1_r = 0; req_mud_y2_r = 0;
req_hrsh_x1_l = 0; req_hrsh_x2_l = 0; req_hrsh_y1_l = 0; req_hrsh_y2_l = 0;
req_hrsh_x1_r = 0; req_hrsh_x2_r = 0; req_hrsh_y1_r = 0; req_hrsh_y2_r = 0;

cur_rms = -90.0;
cur_true_peak = -90.0;
cur_crest = 0.0;
cur_out_true_peak = -90.0;
cur_vu_rms = -90.0;

deess_gr_db = 0.0;
smooth_deess_gr = 0.0;
sibil_env = 0.0;
sibil_energy_db = -90.0;

fet_env = 0.0;
fet_gr_db = 0.0;
smooth_fet_gr = 0.0;
opto_env = 0.0;
opto_gr_db = 0.0;
smooth_opto_gr = 0.0;
tot_comp_gr = 0.0;

// Producer Delay Throw Buffer
dly_buf_sz = 96000;
dly_buf_l = 40000;
dly_buf_r = 140000;
dly_w_idx = 0;
dly_time_spl = floor(srate * 0.375); // dotted 8th / 1/4 note

// Buffer Arrays for Vocal Rider and Aura Scope
buf_in_idx = 0;
buf_sz = 160;
buf_in_arr = 30000;
buf_sibil_arr = 30200;
buf_rider_arr = 30400; // Word-by-word rider gain history
buf_mid_arr = 30600;
buf_side_arr = 30800;

// Filter states
ds_bp_x1_l = 0; ds_bp_x2_l = 0; ds_bp_y1_l = 0; ds_bp_y2_l = 0;
ds_bp_x1_r = 0; ds_bp_x2_r = 0; ds_bp_y1_r = 0; ds_bp_y2_r = 0;
air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;
prs_x1_l = 0; prs_x2_l = 0; prs_y1_l = 0; prs_y2_l = 0;
prs_x1_r = 0; prs_x2_r = 0; prs_y1_r = 0; prs_y2_r = 0;
sd_hp_x1 = 0; sd_hp_x2 = 0; sd_hp_y1 = 0; sd_hp_y2 = 0;

// Telephone Filter (500Hz - 3kHz bandpass)
tel_hp_x1 = 0; tel_hp_x2 = 0; tel_hp_y1 = 0; tel_hp_y2 = 0;
tel_lp_x1 = 0; tel_lp_x2 = 0; tel_lp_y1 = 0; tel_lp_y2 = 0;

function update_vocal_filters() (

  // ReEQ HPF (slider47: 60-160Hz Butterworth)
  req_hp_w0 = 2.0 * $pi * max(50.0, min(200.0, slider47)) / srate;
  req_hp_al = sin(req_hp_w0) * 0.7071;
  req_hp_a0 = 1.0 + req_hp_al;
  req_hp_b0 = ((1.0 + cos(req_hp_w0)) * 0.5) / req_hp_a0;
  req_hp_b1 = (-(1.0 + cos(req_hp_w0))) / req_hp_a0;
  req_hp_b2 = ((1.0 + cos(req_hp_w0)) * 0.5) / req_hp_a0;
  req_hp_a1 = (-2.0 * cos(req_hp_w0)) / req_hp_a0;
  req_hp_a2 = (1.0 - req_hp_al) / req_hp_a0;

  // ReEQ 380Hz Mud Scoop (slider48: -8 to +2 dB)
  req_mud_w0 = 2.0 * $pi * 380.0 / srate;
  req_mud_a = exp(slider48 * 0.05756462); // 10^(dB/40)
  req_mud_al = sin(req_mud_w0) * 0.5 * (1.0 / 1.2);
  req_mud_a0 = 1.0 + req_mud_al / req_mud_a;
  req_mud_b0 = (1.0 + req_mud_al * req_mud_a) / req_mud_a0;
  req_mud_b1 = (-2.0 * cos(req_mud_w0)) / req_mud_a0;
  req_mud_b2 = (1.0 - req_mud_al * req_mud_a) / req_mud_a0;
  req_mud_a1 = (-2.0 * cos(req_mud_w0)) / req_mud_a0;
  req_mud_a2 = (1.0 - req_mud_al / req_mud_a) / req_mud_a0;

  // ReEQ 5.2kHz Harshness Notch (slider49: -8 to +2 dB)
  req_hrsh_w0 = 2.0 * $pi * 5200.0 / srate;
  req_hrsh_a = exp(slider49 * 0.05756462);
  req_hrsh_al = sin(req_hrsh_w0) * 0.5 * (1.0 / 1.8);
  req_hrsh_a0 = 1.0 + req_hrsh_al / req_hrsh_a;
  req_hrsh_b0 = (1.0 + req_hrsh_al * req_hrsh_a) / req_hrsh_a0;
  req_hrsh_b1 = (-2.0 * cos(req_hrsh_w0)) / req_hrsh_a0;
  req_hrsh_b2 = (1.0 - req_hrsh_al * req_hrsh_a) / req_hrsh_a0;
  req_hrsh_a1 = (-2.0 * cos(req_hrsh_w0)) / req_hrsh_a0;
  req_hrsh_a2 = (1.0 - req_hrsh_al / req_hrsh_a) / req_hrsh_a0;

  // 1. De-Esser Bandpass
  ds_w0 = 2.0 * $pi * slider3 / srate;
  ds_cos = cos(ds_w0); ds_sin = sin(ds_w0);
  ds_alpha = ds_sin / (2.0 * 2.5);
  ds_b0 = ds_alpha; ds_b1 = 0.0; ds_b2 = -ds_alpha;
  ds_a0 = 1.0 + ds_alpha; ds_a1 = -2.0 * ds_cos; ds_a2 = 1.0 - ds_alpha;
  ds_b0 /= ds_a0; ds_b1 /= ds_a0; ds_b2 /= ds_a0; ds_a1 /= ds_a0; ds_a2 /= ds_a0;

  // 2. Maag 16kHz Air High-Shelf
  a_w0 = 2.0 * $pi * 16000.0 / srate;
  a_A = exp(slider10 * (log(10.0) / 40.0));
  a_sin = sin(a_w0); a_cos = cos(a_w0);
  a_alpha = a_sin * 0.5 * sqrt((a_A + 1.0/a_A)*(1.0/0.7071 - 1.0) + 2.0);
  a_2sqrt = 2.0 * sqrt(a_A) * a_alpha;
  air_b0 = a_A * ((a_A + 1.0) + (a_A - 1.0)*a_cos + a_2sqrt);
  air_b1 = -2.0 * a_A * ((a_A - 1.0) + (a_A + 1.0)*a_cos);
  air_b2 = a_A * ((a_A + 1.0) + (a_A - 1.0)*a_cos - a_2sqrt);
  air_a0 = (a_A + 1.0) - (a_A - 1.0)*a_cos + a_2sqrt;
  air_a1 = 2.0 * ((a_A - 1.0) - (a_A + 1.0)*a_cos);
  air_a2 = (a_A + 1.0) - (a_A - 1.0)*a_cos - a_2sqrt;
  air_b0 /= air_a0; air_b1 /= air_a0; air_b2 /= air_a0; air_a1 /= air_a0; air_a2 /= air_a0;

  // 3. 1.8kHz Vocal Presence Peak
  p_w0 = 2.0 * $pi * 1800.0 / srate;
  p_A = exp(slider11 * (log(10.0) / 40.0));
  p_alpha = sin(p_w0) / (2.0 * 1.5);
  prs_b0 = 1.0 + p_alpha * p_A; prs_b1 = -2.0 * cos(p_w0); prs_b2 = 1.0 - p_alpha * p_A;
  prs_a0 = 1.0 + p_alpha / p_A; prs_a1 = -2.0 * cos(p_w0); prs_a2 = 1.0 - p_alpha / p_A;
  prs_b0 /= prs_a0; prs_b1 /= prs_a0; prs_b2 /= prs_a0; prs_a1 /= prs_a0; prs_a2 /= prs_a0;

  // 4. Center Lead Side Highpass (200Hz)
  sd_w0 = 2.0 * $pi * 200.0 / srate;
  sd_cos = cos(sd_w0); sd_sin = sin(sd_w0);
  sd_alpha = sd_sin / (2.0 * 0.7071);
  sd_b0 = (1.0 + sd_cos) * 0.5; sd_b1 = -(1.0 + sd_cos); sd_b2 = (1.0 + sd_cos) * 0.5;
  sd_a0 = 1.0 + sd_alpha; sd_a1 = -2.0 * sd_cos; sd_a2 = 1.0 - sd_alpha;
  sd_b0 /= sd_a0; sd_b1 /= sd_a0; sd_b2 /= sd_a0; sd_a1 /= sd_a0; sd_a2 /= sd_a0;

  // Ballistics
  deess_att_c = exp(-1.0 / (0.0010 * srate));
  deess_rel_c = exp(-1.0 / (0.0400 * srate));
  fet_att_c   = exp(-1.0 / (0.0008 * srate)); // 0.8 ms fast peak shave
  fet_rel_c   = exp(-1.0 / (0.0600 * srate)); // 60 ms smooth release
  opto_att_c  = exp(-1.0 / (0.0150 * srate)); // 15 ms optical leveling
  opto_rel_c  = exp(-1.0 / (0.1800 * srate)); // 180 ms silky musical release

  // Telephone Filter Coefficients (500Hz High-Pass & 3200Hz Low-Pass)
  tel_hp_w0 = 2.0 * $pi * 500.0 / srate;
  tel_hp_cos = cos(tel_hp_w0); tel_hp_sin = sin(tel_hp_w0);
  tel_hp_alpha = tel_hp_sin / (2.0 * 0.7071);
  tel_hp_b0 = (1.0 + tel_hp_cos) * 0.5; tel_hp_b1 = -(1.0 + tel_hp_cos); tel_hp_b2 = (1.0 + tel_hp_cos) * 0.5;
  tel_hp_a0 = 1.0 + tel_hp_alpha; tel_hp_a1 = -2.0 * tel_hp_cos; tel_hp_a2 = 1.0 - tel_hp_alpha;
  tel_hp_b0 /= tel_hp_a0; tel_hp_b1 /= tel_hp_a0; tel_hp_b2 /= tel_hp_a0; tel_hp_a1 /= tel_hp_a0; tel_hp_a2 /= tel_hp_a0;

  tel_lp_w0 = 2.0 * $pi * 3200.0 / srate;
  tel_lp_cos = cos(tel_lp_w0); tel_lp_sin = sin(tel_lp_w0);
  tel_lp_alpha = tel_lp_sin / (2.0 * 0.7071);
  tel_lp_b0 = (1.0 - tel_lp_cos) * 0.5; tel_lp_b1 = 1.0 - tel_lp_cos; tel_lp_b2 = (1.0 - tel_lp_cos) * 0.5;
  tel_lp_a0 = 1.0 + tel_lp_alpha; tel_lp_a1 = -2.0 * tel_lp_cos; tel_lp_a2 = 1.0 - tel_lp_alpha;
  tel_lp_b0 /= tel_lp_a0; tel_lp_b1 /= tel_lp_a0; tel_lp_b2 /= tel_lp_a0; tel_lp_a1 /= tel_lp_a0; tel_lp_a2 /= tel_lp_a0;
);

update_vocal_filters();


// ===== EAR-CANDY DIRECTOR BEGIN (shared region + energy aware producer tricks) =====
// Reads REAPER regions (gmem 100-109) AND the measured energy of this bus. Per region it picks a small,
// producer-specific set of tricks, then fires them only inside the right musical window. Every wet
// signal is derived from the performance itself and capped, so it stays barely audible.
dk_bm = 780000;
dk_rv = dk_bm;            dk_rv_sz = 400000;      // reverse-bloom capture
dk_dA = dk_bm + 400000;   dk_dB = dk_bm + 600000; dk_dA_sz = 200000;   // ping-pong throw
dk_ec = dk_bm + 800000;   dk_ec_sz = 200000;      // ducked echo
dk_hl = dk_bm + 1000000;                          // hall (4 combs x 8000 + 2 allpass x 3000)
dk_sh = dk_bm + 1060000;  dk_sh_sz = 16384;       // shifter / tap ring
dk_sl = dk_bm + 1080000;  dk_sl_sz = 30000;       // slap
memset(dk_bm, 0, 1110000);

dk_tip = 1900000; dk_pn = 1900080; dk_pm = 1900100; dk_ps = 1900120; dk_pd = 1900140; dk_pg = 1900160;
dk_nm = 1900180; dk_hint = 1900200; dk_tn = 1900220;
dk_tbl = 1900240; dk_env = dk_tbl; dk_hold = dk_tbl + 16; dk_tg = dk_tbl + 32; dk_ga = dk_tbl + 48; dk_tgp = dk_tbl + 64;
dk_hp = 1900330; dk_hd = 1900340; dk_sp = 1900350; dk_bs = 1900360;
dk_i = 0; loop(80, dk_tbl[dk_i] = 0; dk_i += 1; );
dk_i = 0; loop(8, dk_hp[dk_i] = 0; dk_hd[dk_i] = 0; dk_i += 1; );
dk_sp[0] = 0.0; dk_sp[1] = 0.33; dk_sp[2] = 0.66;
dk_vis = 16383;
dk_susm = 63232;   // sustained tricks: BREATH GHOSTUP GHOSTDN GRIT WIDE TREM SWEEP
dk_boot = 1;

dk_bs[0] = 0.22; dk_bs[1] = 0.30; dk_bs[2] = 0.30; dk_bs[3] = 0.20; dk_bs[4] = 0.45; dk_bs[5] = 0.55;
dk_bs[6] = 0.60; dk_bs[7] = 0.50; dk_bs[8] = 0.50; dk_bs[9] = 0.12; dk_bs[10] = 0.15; dk_bs[11] = 0.22;
dk_bs[12] = 0.30; dk_bs[13] = 0.085; dk_bs[14] = 0.18; dk_bs[15] = 0.20;

dk_nm[0] = "Phrase Throw";
dk_hint[0] = "last phrase thrown ping-pong into the drop";
dk_nm[1] = "Reverse Bloom";
dk_hint[1] = "reversed phrase swells into the drop";
dk_nm[2] = "Ducked Echo";
dk_hint[2] = "dotted echo blooms in gaps after phrases";
dk_nm[3] = "Tape Slap";
dk_hint[3] = "short slap on phrase ends in sparse parts";
dk_nm[4] = "Hall Tail";
dk_hint[4] = "hall tail on big phrase ring-outs";
dk_nm[5] = "Filter Rise";
dk_hint[5] = "high-pass rise across the last bar";
dk_nm[6] = "Stutter Chop";
dk_hint[6] = "16th gate chop on the final beat";
dk_nm[7] = "Telephone Choke";
dk_hint[7] = "bandpass choke before drops / bridge lo-fi";
dk_nm[8] = "Breath Air";
dk_hint[8] = "high-band shadow in loud choruses";
dk_nm[9] = "Octave Halo";
dk_hint[9] = "octave halo late in loud choruses";
dk_nm[10] = "Sub Shadow";
dk_hint[10] = "octave-down weight on breakdowns / peaks";
dk_nm[11] = "Pitch Dive";
dk_hint[11] = "pitch dive over the last 0.4 s of a section";
dk_nm[12] = "Grit Layer";
dk_hint[12] = "parallel grit when energy peaks";
dk_nm[13] = "Wide Double";
dk_hint[13] = "Haas widen in choruses";
dk_nm[14] = "Tremolo";
dk_hint[14] = "tempo-synced tremolo on sparse parts";
dk_nm[15] = "Sweep";
dk_hint[15] = "slow filter sweep through verses and builds";
dk_tn[0] = "Open (energy only)";
dk_tn[1] = "Intro";
dk_tn[2] = "Verse";
dk_tn[3] = "Pre-Chorus";
dk_tn[4] = "Chorus";
dk_tn[5] = "Bridge";
dk_tn[6] = "Outro";
dk_tn[7] = "Other";
dk_pn[0] = "Default Neutral Wire"; dk_pm[0] = 21; dk_ps[0] = 2; dk_pd[0] = 1; dk_pg[0] = 0.8;
dk_tip[0] = "Clean lead, no colour: let the transition tricks do the work.";
dk_tip[1] = "Throw + ducked echo only; keep reverb tails out of verses.";
dk_tip[2] = "De-ess near 6.8k (3.5 dB max); ride vowels, not consonants.";
dk_tip[3] = "One transition trick per chorus. Never stack all of them.";
dk_pn[1] = "Lance Prenc"; dk_pm[1] = 12489; dk_ps[1] = 7; dk_pd[1] = 2; dk_pg[1] = 1.0;
dk_tip[4] = "Upfront gritty lead: fast peak control, push 3 kHz presence.";
dk_tip[5] = "Lo-fi megaphone slap on bridge ad-libs to split them from lead.";
dk_tip[6] = "Short ducked echo that only opens in the gaps between lines.";
dk_tip[7] = "Reverse bloom into the chorus, then a dead cut on beat 1.";
dk_pn[2] = "Scott Seigel"; dk_pm[2] = 6344; dk_ps[2] = 6; dk_pd[2] = 2; dk_pg[2] = 1.0;
dk_tip[8] = "Dry and aggressive: almost no tail, echo off in the verses.";
dk_tip[9] = "Stutter chop on the last beat gives the drop its impact.";
dk_tip[10] = "Telephone-choke bridge ad-libs, then snap to full range.";
dk_tip[11] = "Control sibilance hard; harsh 6-8k fights the cymbals.";
dk_pn[3] = "Jonathan Dolese"; dk_pm[3] = 4269; dk_ps[3] = 5; dk_pd[3] = 2; dk_pg[3] = 1.0;
dk_tip[12] = "Nu-metal swagger: tight lead, bright air, tape-style warmth.";
dk_tip[13] = "High-pass riser across the last bar, released at the chorus.";
dk_tip[14] = "Megaphone ad-libs in the bridge; double the chorus for width.";
dk_tip[15] = "Throw lands on the last word, vacuum right before the downbeat.";
dk_pn[4] = "Buster Odeholm"; dk_pm[4] = 3272; dk_ps[4] = 11; dk_pd[4] = 1; dk_pg[4] = 1.0;
dk_tip[16] = "Keep raw low-mid body (200-400 Hz) so grunts stay heavy.";
dk_tip[17] = "Silence is the trick: choke, then dead air before the drop.";
dk_tip[18] = "Telephone choke on the final bar, no reverb wash.";
dk_tip[19] = "Stutter chop on the last beat, hard cut, then full impact.";
dk_pn[5] = "Kel Pinchin (Split Chain)"; dk_pm[5] = 12607; dk_ps[5] = 1; dk_pd[5] = 2; dk_pg[5] = 0.95;
dk_tip[20] = "Gojira X BBD swirl on wide doubles; lead stays centred in pocket.";
dk_tip[21] = "Filter rise opens as the clean line enters the chorus.";
dk_tip[22] = "Ducked echo on the clean phrases for ambient trails.";
dk_tip[23] = "Two-bar reverse bloom leads into the clean hook.";
dk_pn[6] = "Sam Guaiana"; dk_pm[6] = 8461; dk_ps[6] = 0; dk_pd[6] = 2; dk_pg[6] = 0.95;
dk_tip[24] = "Melodic post-hardcore: bright, clear lead with a pop-polished top.";
dk_tip[25] = "Ping-pong throw on the last word of the pre-chorus.";
dk_tip[26] = "Ducked echo only at phrase ends; keep verses dry.";
dk_tip[27] = "Wide gang-style backing, lead stays 100% centred.";
dk_pn[7] = "Forrester Savell"; dk_pm[7] = 822; dk_ps[7] = 1; dk_pd[7] = 2; dk_pg[7] = 1.05;
dk_tip[28] = "Cinematic builds: four-bar reverse bloom into the chorus.";
dk_tip[29] = "Slow filter rise and longer ducked echo with dark repeats.";
dk_tip[30] = "Lead stays natural and intimate; the space lives in the tails.";
dk_tip[31] = "Open the air shelf only on the chorus downbeat.";
dk_pn[8] = "Jens Bogren"; dk_pm[8] = 8470; dk_ps[8] = 4; dk_pd[8] = 1; dk_pg[8] = 0.8;
dk_tip[32] = "Natural, dynamic lead: light processing, wide and organic.";
dk_tip[33] = "Bloom and throw only into big sections, at subtle levels.";
dk_tip[34] = "Let clean vocals breathe: gentle FET, longer opto body.";
dk_tip[35] = "Keep echo tails low. Clarity over effect.";
dk_pn[9] = "Nolly Getgood"; dk_pm[9] = 8809; dk_ps[9] = 13; dk_pd[9] = 2; dk_pg[9] = 0.95;
dk_tip[36] = "Polished, precise modern-metal lead: tight and controlled.";
dk_tip[37] = "Short throw on the last word, filter rise for pre-chorus lift.";
dk_tip[38] = "Presence at 3-4 kHz; tame any harshness with the de-esser.";
dk_tip[39] = "Double the chorus lead, keep the doubles slightly narrow.";
dk_pn[10] = "Will Putney"; dk_pm[10] = 6344; dk_ps[10] = 12; dk_pd[10] = 2; dk_pg[10] = 1.0;
dk_tip[40] = "Heavy and in-your-face: very dry with dense mid presence.";
dk_tip[41] = "Stutter chop before breakdowns; megaphone-choke the ad-libs.";
dk_tip[42] = "No reverb wash: impact comes from silence and hard cuts.";
dk_tip[43] = "Crush the ad-libs but keep the lead clear above guitars.";
dk_pn[11] = "George Lever"; dk_pm[11] = 9110; dk_ps[11] = 9; dk_pd[11] = 2; dk_pg[11] = 1.05;
dk_tip[44] = "Dramatic dynamics: whisper verse to a huge chorus.";
