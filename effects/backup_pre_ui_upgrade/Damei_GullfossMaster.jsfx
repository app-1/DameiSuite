gfx_g = slider10 == 1 ? 1.00 : 0.70;
gfx_b = slider10 == 1 ? 1.00 : 0.80;
gfx_x = m1_x + floor((pw3 - 26) * 0.5); gfx_y = m_btn_y + 3; gfx_drawstr("SYNC");

gfx_r = (slider10 == 2 || hov_m2) ? 0.04 : 0.03;
gfx_g = (slider10 == 2 || hov_m2) ? 0.24 : 0.08;
gfx_b = (slider10 == 2 || hov_m2) ? 0.16 : 0.12;
