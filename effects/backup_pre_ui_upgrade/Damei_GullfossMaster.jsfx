gfx_rect(b_og_p_x, og_y, btn_w, 16); gfx_r = 0.30; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(b_og_p_x, og_y, btn_w, 16, 0);
gfx_x = b_og_p_x + 9; gfx_y = og_y + 1; gfx_drawstr("+");

(mouse_cap & 1) && !prev_mouse_cap && hov_og_m ? (slider11 = max(-12.0, slider11 - 0.5); out_gain_lin = exp(slider11 * 0.11512925); slider_automate(1024););
(mouse_cap & 1) && !prev_mouse_cap && hov_og_p ? (slider11 = min(12.0, slider11 + 0.5); out_gain_lin = exp(slider11 * 0.11512925); slider_automate(1024););

prev_mouse_cap = mouse_cap;
