gfx_g = slider10 == 0 ? 0.95 : 0.70;
gfx_b = slider10 == 0 ? 0.80 : 0.80;
gfx_x = m3_x + floor((pw3 - 44) * 0.5); gfx_y = m_btn_y + 3; gfx_drawstr("MANUAL");

(mouse_cap & 1) && !prev_mouse_cap && hov_m1 ? (slider10 = 1; slider_automate(512););
(mouse_cap & 1) && !prev_mouse_cap && hov_m2 ? (slider10 = 2; slider_automate(512););
(mouse_cap & 1) && !prev_mouse_cap && hov_m3 ? (slider10 = 0; slider_automate(512););

