hov_m2 = (mouse_x >= m2_x && mouse_x <= m2_x + pw3 && mouse_y >= m_btn_y && mouse_y <= m_btn_y + m_btn_h);
hov_m3 = (mouse_x >= m3_x && mouse_x <= m3_x + pw3 && mouse_y >= m_btn_y && mouse_y <= m_btn_y + m_btn_h);

gfx_r = (slider10 == 1 || hov_m1) ? 0.06 : 0.03;
gfx_g = (slider10 == 1 || hov_m1) ? 0.22 : 0.08;
gfx_b = (slider10 == 1 || hov_m1) ? 0.26 : 0.12;
