gfx_b = slider10 == 2 ? 0.65 : 0.60;
gfx_rect(m2_x, m_btn_y, pw3, m_btn_h, 0);
gfx_r = slider10 == 2 ? 0.90 : 0.60;
gfx_g = slider10 == 2 ? 1.00 : 0.70;
gfx_b = slider10 == 2 ? 0.95 : 0.80;
gfx_x = m2_x + floor((pw3 - 38) * 0.5); gfx_y = m_btn_y + 3; gfx_drawstr("SPLIT");

