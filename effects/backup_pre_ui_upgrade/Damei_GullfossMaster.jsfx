gfx_rect(btn2_m_x, ctrl_y + 54, btn_w, 16); gfx_r = 0.80; gfx_g = 0.88; gfx_b = 0.98; gfx_rect(btn2_m_x, ctrl_y + 54, btn_w, 16, 0);
gfx_x = btn2_m_x + 10; gfx_y = ctrl_y + 55; gfx_drawstr("-");
gfx_r = b_sp_p ? 0.16 : 0.06; gfx_g = b_sp_p ? 0.24 : 0.10; gfx_b = b_sp_p ? 0.32 : 0.14;
gfx_rect(btn2_p_x, ctrl_y + 54, btn_w, 16); gfx_r = 0.80; gfx_g = 0.88; gfx_b = 0.98; gfx_rect(btn2_p_x, ctrl_y + 54, btn_w, 16, 0);
gfx_x = btn2_p_x + 9; gfx_y = ctrl_y + 55; gfx_drawstr("+");
(mouse_cap & 1) && !prev_mouse_cap && b_sp_m ? (slider9 = max(10, slider9 - 5); slider10 = 0; slider_automate(256 | 512););
(mouse_cap & 1) && !prev_mouse_cap && b_sp_p ? (slider9 = min(100, slider9 + 5); slider10 = 0; slider_automate(256 | 512););

gfx_r = 0.50; gfx_g = 0.65; gfx_b = 0.80;
gfx_x = c2_x + pad_m; gfx_y = ctrl_y + 80; gfx_printf("RANGE   : %.0fHz - %.0fkHz", eff_locut, eff_hicut * 0.001);

// CARD 3: MASTERING SIGNATURE PRESETS
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.044; gfx_rect(c3_x, ctrl_y, col_w, ctrl_h);
gfx_r = 0.12; gfx_g = 0.20; gfx_b = 0.30; gfx_rect(c3_x, ctrl_y, col_w, ctrl_h, 0);
gfx_setfont(1);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_x = c3_x + pad_m; gfx_y = ctrl_y + 8; gfx_drawstr("MASTERING SIGNATURE PRESETS");

// Preset Selector Row (<, Name/Menu, >)
b_sel_y = ctrl_y + 28;
b_sel_h = 22;
b_prev_x = c3_x + pad_m;
b_prev_w = 22;
b_next_x = c3_x + col_w - pad_m - 22;
b_next_w = 22;
b_menu_x = b_prev_x + b_prev_w + 4;
b_menu_w = b_next_x - b_menu_x - 4;

hov_prev = (mouse_x >= b_prev_x && mouse_x <= b_prev_x + b_prev_w && mouse_y >= b_sel_y && mouse_y <= b_sel_y + b_sel_h);
hov_next = (mouse_x >= b_next_x && mouse_x <= b_next_x + b_next_w && mouse_y >= b_sel_y && mouse_y <= b_sel_y + b_sel_h);
hov_menu = (mouse_x >= b_menu_x && mouse_x <= b_menu_x + b_menu_w && mouse_y >= b_sel_y && mouse_y <= b_sel_y + b_sel_h);

gfx_r = hov_prev ? 0.16 : 0.06; gfx_g = hov_prev ? 0.24 : 0.10; gfx_b = hov_prev ? 0.32 : 0.14;
gfx_rect(b_prev_x, b_sel_y, b_prev_w, b_sel_h);
