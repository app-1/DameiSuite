gfx_setfont(3); gfx_x = b_prev_x + 7; gfx_y = b_sel_y + 4; gfx_drawstr("<");

gfx_r = hov_menu ? 0.16 : 0.08; gfx_g = hov_menu ? 0.24 : 0.12; gfx_b = hov_menu ? 0.32 : 0.18;
gfx_rect(b_menu_x, b_sel_y, b_menu_w, b_sel_h);
gfx_r = 0.00; gfx_g = 0.95; gfx_b = 0.65; gfx_rect(b_menu_x, b_sel_y, b_menu_w, b_sel_h, 0);
gfx_setfont(4); gfx_r = 0.95; gfx_g = 1.00; gfx_b = 0.95;
gfx_x = b_menu_x + 6; gfx_y = b_sel_y + 4;
gfx_printf("%02d: %s", slider12, get_engineer_name(slider12));

gfx_r = hov_next ? 0.16 : 0.06; gfx_g = hov_next ? 0.24 : 0.10; gfx_b = hov_next ? 0.32 : 0.14;
gfx_rect(b_next_x, b_sel_y, b_next_w, b_sel_h);
