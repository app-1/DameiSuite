  );
);

// Row 2: Mode Pills (TANDEM SYNC, SPLIT CHAIN LOCK, STANDALONE)
m_btn_y = ctrl_y + 54;
m_btn_h = 20;
pw3 = floor((col_w - pad_m * 2 - 8) / 3);
m1_x = c3_x + pad_m;
