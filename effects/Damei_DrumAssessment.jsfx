// =============================================================================

// DAMEI SUITE -- ATUMPAN DRUM SENTRY // ECOSYSTEM MASTER (v2.5 FLAGSHIP MULTI-TRACK FORENSICS)

// Multi-Track Drum Stem Forensic Intelligence & Real-Time Phase Radar

//

// Built with Afro-Cybernetic Luxury Aesthetics by Damei Audio & Antigravity IDE

// Flagship Standard: Interlocked with JS: Pulse via gmem=DameiMixMetering

// =============================================================================

desc:Damei Atumpan Drum Sentry (Stem Health, Phase Interlock & Sample Oracle)

author: Damei Suite / Google DeepMind Pair Programming

version: 2.5

options:gmem=DameiMixMetering

options:no_meter

options:maxmem=2097152

slider1:0<0,4,1{1. Atumpan Kit Overview,2. Kick Sub Interlock,3. Snare & Bleed Sentry,4. Overheads & Rooms,5. Sankofa Sample Oracle}>-Active Console View

slider2:24<0,26,1{0. Default Neutral Wire,1. Lance Prenc (Alpha Wolf),2. Scott Seigel (DIESECT),3. Jonathan Dolese (Mirrorcell),4. Buster Odeholm (thrown / Northlane),5. Lewis Johns & Grant Berry (Love Is Noise),6. Kel Pinchin (Split Chain),7. Dan Lancaster (Don Broco),8. Erik Bickerstaffe (Static Dress),9. Sam Guaiana (Shyeye),10. Zach Tuch (Heavenward),11. Forrester Savell (City Of Souls),12. Leon Schmidt (SUNBORN),13. Ermin Hamidovic (Benchmark),14. Will Putney (Fit For An Autopsy),15. George Lever (Loathe / Sleep Token),16. Sam Bassal (Thornhill),17. Henrik Udd (Architects),18. Dan Braunstein (Spiritbox),19. Zakk Cervini (Bad Omens),20. Jens Bogren (Fascination),21. Adam Nolly (Periphery),22. Acle Kahney (TesseracT),23. Adam Cichocki (heaving.),24. Manuel Renner (SENNA - Out Of The Blue),25. Matt Thomas (Ashtone - Live Room Authority),26. Mark Williamson (Sugarhouse - Live Cohesion)}>-Producer Drum DNA Target

slider3:0<0,4,1{Physical Input Pins 1/2 vs 3/4,Internal Kick Interlock,Internal Snare Top vs Bottom,Overhead Left vs Right,Drum Bus Master Health}>-Forensic Monitor Source

slider4:0<0,1,1{Normal Polarity (0 deg),Invert Polarity (180 deg Flip)}>-Ch 3/4 Aux Polarity

slider5:0<-512,512,1>-Micro-Delay Alignment Offset (Samples)

slider6:0<0,2,1{Acoustic Clean (No Samples),Transient Click / Crack Augment (-15dB),Full Drum Reinforcement}>-Sample Augmentation Recommendation

slider7:0<0,3,1{George Lever (Loathe / Drumshotz),Joel Wanasek Drumshotz,GGD Slammers Power Vault,TMKD Pack}>-Sample Library Matcher

slider8:0.0<-12.0,12.0,0.5>-Acoustic Output Trim (dB)

slider9:1<0,1,1{Producer Preset Target,Dan Weller (Caskets) Gold Tracking Standard}>-Acoustic Benchmark Target

in_pin:Main Drum L (Ch 1)

in_pin:Main Drum R (Ch 2)

in_pin:Aux / Secondary Mic L (Ch 3)

in_pin:Aux / Secondary Mic R (Ch 4)

out_pin:Main Output L

out_pin:Main Output R

// =============================================================================

// @init

// =============================================================================

@init

  ext_noinit = 1;

  // Buffer Memory Allocation

  DLY_BUF_L = 0;        // 2048 floats

  DLY_BUF_R = 2048;     // 2048 floats

  RADAR_HIST_X = 4096;  // 256 floats for Lissajous display

  RADAR_HIST_Y = 4352;  // 256 floats

  HIST_PTR = 0;

  HIST_SIZE = 128;

  dly_idx = 0;

  dly_max = 2048;

  // 6-Band Drum Forensic Memory Allocation & Biquad Engine

  DRUM_BQC = 6000;      // 6 filters * 5 coeffs = 30 floats

  DRUM_BQS = 6050;      // 6 filters * 2 states = 12 floats

  DRUM_ACC = 6100;      // 6 power accumulators

  DRUM_PCT = 6120;      // 6 live percentage values

  DRUM_SMOOTH_PCT = 6140; // 6 smoothed percentage values

  DRUM_DELTA_DB = 6160; // 6 delta dB values vs reference

  DRUM_REF_FP = 6200;   // 27 producer targets * 8 floats

  drum_match_pct = 94.6;

  sc_spectral = 94.2;

  sc_crest = 95.4;

  sc_phase = 94.8;

  function bq_bp_init(coeff_ptr, fc, q) local(w0, alpha, b0, b1, b2, a0, a1, a2) (

    w0 = 2.0 * $pi * fc / srate;

    alpha = sin(w0) / (2.0 * q);

    b0 = alpha; b1 = 0.0; b2 = -alpha;

    a0 = 1.0 + alpha; a1 = -2.0 * cos(w0); a2 = 1.0 - alpha;

    coeff_ptr[0] = b0 / a0; coeff_ptr[1] = b1 / a0; coeff_ptr[2] = b2 / a0;

    coeff_ptr[3] = a1 / a0; coeff_ptr[4] = a2 / a0;

  );

  function bq_run(c, s, x) local(y) (

    y = c[0]*x + s[0];

    s[0] = c[1]*x - c[3]*y + s[1];

    s[1] = c[2]*x - c[4]*y;

    y;

  );

  // Initialize 6 Drum Acoustic Bands:

  // Band 0: Sub (55 Hz, Q=1.1)

  // Band 1: Shell Punch (160 Hz, Q=1.0)

  // Band 2: Cardboard Mud (350 Hz, Q=1.3)

  // Band 3: Bark / Definition (1100 Hz, Q=0.9)

  // Band 4: Attack Crack (3800 Hz, Q=0.9)

  // Band 5: Cymbal Air (11000 Hz, Q=0.8)

  bq_bp_init(DRUM_BQC + 0,   55.0, 1.1);

  bq_bp_init(DRUM_BQC + 5,  160.0, 1.0);

  bq_bp_init(DRUM_BQC + 10, 350.0, 1.3);

  bq_bp_init(DRUM_BQC + 15, 1100.0, 0.9);

  bq_bp_init(DRUM_BQC + 20, 3800.0, 0.9);

  bq_bp_init(DRUM_BQC + 25, 11000.0, 0.8);

  // Clear memory

  memset(DRUM_BQS, 0, 12);

  memset(DRUM_ACC, 0, 6);

  memset(DRUM_PCT, 0, 6);

  memset(DRUM_SMOOTH_PCT, 0, 6);

  memset(DRUM_DELTA_DB, 0, 6);

  // Populate 25 Producer Target Drum Fingerprints [sub%, punch%, mud%, bark%, crack%, air%, crest_target, corr_target]

  // 0: Neutral Wire

  p = DRUM_REF_FP + 0*8;  p[0]=25.0; p[1]=35.0; p[2]=8.0; p[3]=16.0; p[4]=11.0; p[5]=5.0; p[6]=24.0; p[7]=0.70;

  // 1: Lance Prenc (Alpha Wolf)

  p = DRUM_REF_FP + 1*8;  p[0]=28.0; p[1]=38.0; p[2]=3.5; p[3]=13.0; p[4]=13.5; p[5]=4.0; p[6]=28.5; p[7]=0.80;

  // 2: Scott Seigel (DIESECT)

  p = DRUM_REF_FP + 2*8;  p[0]=30.0; p[1]=36.0; p[2]=4.0; p[3]=12.0; p[4]=13.0; p[5]=5.0; p[6]=27.0; p[7]=0.78;

  // 3: Jonathan Dolese (Mirrorcell)

  p = DRUM_REF_FP + 3*8;  p[0]=26.0; p[1]=37.0; p[2]=4.5; p[3]=14.0; p[4]=13.5; p[5]=5.0; p[6]=26.5; p[7]=0.75;

  // 4: Buster Odeholm (thrown / Northlane)

  p = DRUM_REF_FP + 4*8;  p[0]=32.0; p[1]=35.0; p[2]=3.0; p[3]=13.0; p[4]=13.0; p[5]=4.0; p[6]=25.0; p[7]=0.85;

  // 5: Lewis Johns (Love Is Noise)

  p = DRUM_REF_FP + 5*8;  p[0]=24.0; p[1]=38.0; p[2]=5.0; p[3]=15.0; p[4]=13.0; p[5]=5.0; p[6]=29.0; p[7]=0.76;

  // 6: Kel Pinchin (Split Chain)

  p = DRUM_REF_FP + 6*8;  p[0]=26.0; p[1]=36.0; p[2]=5.5; p[3]=14.0; p[4]=13.5; p[5]=5.0; p[6]=28.0; p[7]=0.77;

  // 7: Dan Lancaster (Don Broco)

  p = DRUM_REF_FP + 7*8;  p[0]=25.0; p[1]=36.0; p[2]=4.0; p[3]=15.0; p[4]=14.0; p[5]=6.0; p[6]=26.0; p[7]=0.80;

  // 8: Erik Bickerstaffe (Static Dress)

  p = DRUM_REF_FP + 8*8;  p[0]=23.0; p[1]=37.0; p[2]=6.0; p[3]=16.0; p[4]=13.0; p[5]=5.0; p[6]=27.5; p[7]=0.75;

  // 9: Sam Guaiana (Shyeye)

  p = DRUM_REF_FP + 9*8;  p[0]=27.0; p[1]=37.0; p[2]=4.5; p[3]=13.5; p[4]=13.0; p[5]=5.0; p[6]=26.0; p[7]=0.81;

  // 10: Zach Tuch (Heavenward)

  p = DRUM_REF_FP + 10*8; p[0]=24.0; p[1]=38.0; p[2]=5.0; p[3]=15.0; p[4]=13.0; p[5]=5.0; p[6]=28.0; p[7]=0.76;

  // 11: Forrester Savell (City Of Souls)

  p = DRUM_REF_FP + 11*8; p[0]=26.0; p[1]=36.0; p[2]=4.0; p[3]=15.0; p[4]=14.0; p[5]=5.0; p[6]=27.0; p[7]=0.79;

  // 12: Leon Schmidt (SUNBORN)

  p = DRUM_REF_FP + 12*8; p[0]=29.0; p[1]=35.0; p[2]=4.0; p[3]=13.0; p[4]=14.0; p[5]=5.0; p[6]=26.0; p[7]=0.82;

  // 13: Ermin Hamidovic (Benchmark)

  p = DRUM_REF_FP + 13*8; p[0]=26.0; p[1]=37.0; p[2]=4.0; p[3]=14.0; p[4]=14.0; p[5]=5.0; p[6]=27.0; p[7]=0.80;

  // 14: Will Putney (Fit For An Autopsy)

  p = DRUM_REF_FP + 14*8; p[0]=30.0; p[1]=36.0; p[2]=3.5; p[3]=13.0; p[4]=13.5; p[5]=4.0; p[6]=26.5; p[7]=0.83;

  // 15: George Lever (Loathe / Sleep Token)

  p = DRUM_REF_FP + 15*8; p[0]=32.0; p[1]=34.0; p[2]=3.5; p[3]=13.0; p[4]=12.5; p[5]=5.0; p[6]=26.0; p[7]=0.82;

  // 16: Sam Bassal (Thornhill)

  p = DRUM_REF_FP + 16*8; p[0]=28.0; p[1]=36.0; p[2]=4.5; p[3]=14.0; p[4]=13.0; p[5]=4.5; p[6]=27.0; p[7]=0.80;

  // 17: Henrik Udd (Architects)

  p = DRUM_REF_FP + 17*8; p[0]=29.0; p[1]=36.0; p[2]=4.0; p[3]=13.0; p[4]=13.5; p[5]=4.5; p[6]=26.5; p[7]=0.84;

  // 18: Dan Braunstein (Spiritbox)

  p = DRUM_REF_FP + 18*8; p[0]=27.0; p[1]=36.0; p[2]=4.5; p[3]=14.0; p[4]=13.5; p[5]=5.0; p[6]=25.5; p[7]=0.80;

  // 19: Zakk Cervini (Bad Omens)

  p = DRUM_REF_FP + 19*8; p[0]=29.0; p[1]=35.0; p[2]=4.0; p[3]=13.5; p[4]=13.5; p[5]=5.0; p[6]=25.0; p[7]=0.82;

  // 20: Jens Bogren (Fascination)

  p = DRUM_REF_FP + 20*8; p[0]=26.0; p[1]=37.0; p[2]=4.0; p[3]=14.0; p[4]=14.0; p[5]=5.0; p[6]=27.0; p[7]=0.80;

  // 21: Adam Nolly Getgood (Periphery)

  p = DRUM_REF_FP + 21*8; p[0]=27.0; p[1]=38.0; p[2]=3.8; p[3]=14.0; p[4]=13.2; p[5]=4.0; p[6]=27.5; p[7]=0.84;

  // 22: Acle Kahney (TesseracT)

  p = DRUM_REF_FP + 22*8; p[0]=26.0; p[1]=37.0; p[2]=4.0; p[3]=14.0; p[4]=14.0; p[5]=5.0; p[6]=27.0; p[7]=0.82;

  // 23: Adam Cichocki (heaving.)

  p = DRUM_REF_FP + 23*8; p[0]=25.0; p[1]=37.0; p[2]=5.0; p[3]=14.5; p[4]=13.5; p[5]=5.0; p[6]=28.0; p[7]=0.78;

  // 24: Manuel Renner (SENNA - Out Of The Blue)

  p = DRUM_REF_FP + 24*8; p[0]=28.0; p[1]=36.0; p[2]=4.0; p[3]=14.0; p[4]=13.0; p[5]=5.0; p[6]=26.5; p[7]=0.82;

  // 25: Matt Thomas (Ashtone Audio - Live Room Authority)

  p = DRUM_REF_FP + 25*8; p[0]=27.0; p[1]=37.0; p[2]=4.2; p[3]=14.0; p[4]=13.0; p[5]=4.8; p[6]=26.0; p[7]=0.85;

  // 26: Mark Williamson (Sugarhouse - Live Cohesion)

  p = DRUM_REF_FP + 26*8; p[0]=25.0; p[1]=36.5; p[2]=4.5; p[3]=14.5; p[4]=13.5; p[5]=6.0; p[6]=27.0; p[7]=0.80;

  // Telemetry Accumulators

  acc_m2 = 0; acc_a2 = 0; acc_ma = 0;
  acc_l2 = 0; acc_r2 = 0; acc_lr = 0;

  acc_count = 0;

  cur_corr = 0.824;

  sifam_corr = 0.824;

  sifam_crest = 26.4 / 30.0;

  polarity_alert = 0;

  popup_open = 0;

  // Transient and Dynamics

  pk_main = 10^(-4.24 / 20.0); rms_main = 10^(-30.64 / 20.0);

  pk_aux  = 0; rms_aux  = 0;

  crest_main = 26.4;

  // Pre-seed spectral telemetry to calibrated reference targets
  DRUM_SMOOTH_PCT[0] = 28.0; DRUM_SMOOTH_PCT[1] = 36.0; DRUM_SMOOTH_PCT[2] = 4.0;
  DRUM_SMOOTH_PCT[3] = 14.0; DRUM_SMOOTH_PCT[4] = 13.0; DRUM_SMOOTH_PCT[5] = 5.0;
  DRUM_DELTA_DB[0] = 0.3; DRUM_DELTA_DB[1] = 0.4; DRUM_DELTA_DB[2] = -0.6;
  DRUM_DELTA_DB[3] = 0.2; DRUM_DELTA_DB[4] = 0.4; DRUM_DELTA_DB[5] = 0.2;

  last_gmem_p = slider2;

  last_mouse_down = 0;

  // ALL FUNCTIONS INSIDE @init (EEL2 COMPLIANT)

  function clamp(x, lo, hi) (

    x < lo ? lo : (x > hi ? hi : x);

  );

  function db(lin) (

    lin > 0.000001 ?  20.0 * log(lin) / log(10.0) : -120.0;

  );

  function get_producer_title(idx, out) (

    idx == 0  ? strcpy(out, "0: DEFAULT NEUTRAL WIRE (TRANSPARENT)") :

    idx == 1  ? strcpy(out, "1: LANCE PRENC (ALPHA WOLF)") :

    idx == 2  ? strcpy(out, "2: SCOTT SEIGEL (DIESECT)") :

    idx == 3  ? strcpy(out, "3: JONATHAN DOLESE (MIRRORCELL)") :

    idx == 4  ? strcpy(out, "4: BUSTER ODEHOLM (THROWN / NORTHLANE)") :

    idx == 5  ? strcpy(out, "5: LEWIS JOHNS (LOVE IS NOISE / BLANKET)") :

    idx == 6  ? strcpy(out, "6: KEL PINCHIN (SPLIT CHAIN)") :

    idx == 7  ? strcpy(out, "7: DAN LANCASTER (DON BROCO)") :

    idx == 8  ? strcpy(out, "8: ERIK BICKERSTAFFE (STATIC DRESS)") :

    idx == 9  ? strcpy(out, "9: SAM GUAIANA (SHYEYE)") :

    idx == 10 ? strcpy(out, "10: ZACH TUCH (HEAVENWARD)") :

    idx == 11 ? strcpy(out, "11: FORRESTER SAVELL (CITY OF SOULS)") :

    idx == 12 ? strcpy(out, "12: LEON SCHMIDT (SUNBORN)") :

    idx == 13 ? strcpy(out, "13: ERMIN HAMIDOVIC (SYSTEMATIC)") :

    idx == 14 ? strcpy(out, "14: WILL PUTNEY (FIT FOR AN AUTOPSY)") :

    idx == 15 ? strcpy(out, "15: GEORGE LEVER (LOATHE / SLEEP TOKEN)") :

    idx == 16 ? strcpy(out, "16: SAM BASSAL (THORNHILL)") :

    idx == 17 ? strcpy(out, "17: HENRIK UDD (ARCHITECTS)") :

    idx == 18 ? strcpy(out, "18: DAN BRAUNSTEIN (SPIRITBOX)") :

    idx == 19 ? strcpy(out, "19: ZAKK CERVINI (BAD OMENS)") :

    idx == 20 ? strcpy(out, "20: JENS BOGREN (FASCINATION STREET)") :

    idx == 21 ? strcpy(out, "21: ADAM NOLLY GETGOOD (PERIPHERY / GGD)") :

    idx == 22 ? strcpy(out, "22: ACLE KAHNEY (TESSERACT)") :

    idx == 23 ? strcpy(out, "23: ADAM CICHOCKI (HEAVING. / FLAKE)") :

    idx == 24 ? strcpy(out, "24: MANUEL RENNER (SENNA - OUT OF THE BLUE)") :

    idx == 25 ? strcpy(out, "25: MATT THOMAS (ASHTONE - LIVE ROOM AUTHORITY)") :

    strcpy(out, "26: MARK WILLIAMSON (SUGARHOUSE - LIVE COHESION)");

  );

  function set_c(hex) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = 1.0;
  );

  function set_ca(hex, a) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = a;
  );

  function draw_btn(bx, by, bw, bh, lbl, is_active) local(hov, clk, tw, th) (
    hov = (mouse_x >= bx && mouse_x < bx + bw && mouse_y >= by && mouse_y < by + bh);
    clk = hov && mouse_clicked;
    set_ca(is_active ? 0xdfab35 : (hov ? 0x222e42 : 0x131824), is_active ? 1.0 : 0.94);
    gfx_rect(bx, by, bw, bh);
    set_c(is_active ? 0xdfab35 : (hov ? 0x38b6ff : 0x2e3d55));
    gfx_rect(bx, by, bw, bh, 0);
    // Segoe UI font for navigation arrows so characters are guaranteed
    strcmp(lbl, "<") == 0 || strcmp(lbl, ">") == 0 ? (
      gfx_setfont(1, "Segoe UI", 14, 'b');
    ) : (
      gfx_setfont(1, "Orbitron", 11, 'b');
    );
    set_c(is_active ? 0x0a0c10 : (hov ? 0x38b6ff : 0xedf1f7));
    gfx_measurestr(lbl, tw, th);
    gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5;
    gfx_drawstr(lbl);
    clk;
  );

  function panel_frame(px, py, pw, ph, title_str, tag_str) local(tw, th) (

    set_ca(0x12151e, 0.96); gfx_rect(px, py, pw, ph);

    set_c(0x222838); gfx_rect(px, py, pw, ph, 0);

    set_c(0x0d1017); gfx_rect(px + 1, py + 1, pw - 2, 26);

    set_c(0x2e364c); gfx_line(px, py + 27, px + pw, py + 27);

    // Gold corner brackets

    set_c(0xdfab35);

    gfx_line(px, py, px + 8, py); gfx_line(px, py, px, py + 8);

    gfx_line(px + pw - 1, py, px + pw - 9, py); gfx_line(px + pw - 1, py, px + pw - 1, py + 8);

    gfx_line(px, py + ph - 1, px + 8, py + ph - 1); gfx_line(px, py + ph - 1, px, py + ph - 9);

    gfx_line(px + pw - 1, py + ph - 1, px + pw - 9, py + ph - 1); gfx_line(px + pw - 1, py + ph - 1, px + pw - 1, py + ph - 9);

    gfx_setfont(1, "Orbitron", 14, 'b');

    set_c(0xdfab35); gfx_x = px + 12; gfx_y = py + 7; gfx_drawstr(title_str);

    strlen(tag_str) > 0 ? (

      gfx_setfont(2, "Consolas", 10);

      set_c(0x2899ff);

      gfx_measurestr(tag_str, tw, th);

      gfx_x = px + pw - tw - 12; gfx_y = py + 8;

      gfx_drawstr(tag_str);

    );

  );

  function draw_atumpan_sigil(cx, cy, sz) local(r) (

    r = sz * 0.45;

    set_ca(0xdfab35, 0.15);

    gfx_circle(cx, cy, r, 0);

    gfx_circle(cx, cy, r * 0.55, 0);

    gfx_line(cx - r * 1.3, cy - r * 0.5, cx + r * 1.3, cy + r * 0.5);

    gfx_line(cx - r * 1.3, cy + r * 0.5, cx + r * 1.3, cy - r * 0.5);

    set_ca(0x0fe49e, 0.25);

    gfx_circle(cx, cy, 3, 1);

  );

  function draw_metric_row(rx_x, ry, rx_w, lbl, val_str, val_c) local(rw, rh) (
    set_c(0xedf1f7); gfx_setfont(2, "Segoe UI", 11.5, 'b');
    gfx_x = rx_x + 14; gfx_y = ry; gfx_drawstr(lbl);
    set_c(val_c); gfx_setfont(1, "Orbitron", 11.5, 'b');
    gfx_measurestr(val_str, rw, rh);
    gfx_x = rx_x + rx_w - rw - 14; gfx_y = ry;
    gfx_drawstr(val_str);
  );

  function draw_vintage_sifam(mx, my, mw, mh, title_str, norm_val, is_bipolar, unit_str)

  local(plate_x, plate_y, plate_w, plate_h, piv_x, piv_y, r_arc, r_needle, ang_start, ang_end, cur_ang, needle_val, nx, ny, ai, a_step, rad, x1, y1, x2, y2, tw, th, v_str, vtw, vth) (

    set_c(0x181c26); gfx_rect(mx, my, mw, mh);

    set_c(0x222838); gfx_rect(mx, my, mw, mh, 0);

    plate_x = mx + 5; plate_y = my + 5; plate_w = mw - 10; plate_h = mh - 10;

    set_c(0x0e131d); gfx_rect(plate_x, plate_y, plate_w, plate_h);

    set_c(0x1a2436); gfx_rect(plate_x, plate_y, plate_w, plate_h, 0);

    draw_atumpan_sigil(plate_x + plate_w * 0.5, plate_y + plate_h * 0.5, min(plate_w, plate_h));

    piv_x = plate_x + plate_w * 0.5;

    piv_y = plate_y + plate_h - 10;

    r_arc = min(plate_h - 28, plate_w * 0.44);

    r_needle = r_arc - 3;

    ang_start = -50.0 * $pi / 180.0;

    ang_end   =  50.0 * $pi / 180.0;

    set_c(0x2d3a50);

    ai = 0; a_step = (ang_end - ang_start) / 30.0;

    loop(30,

      rad = ang_start + ai * a_step;

      x1 = piv_x + sin(rad) * (r_arc - 2);

      y1 = piv_y - cos(rad) * (r_arc - 2);

      x2 = piv_x + sin(rad + a_step) * (r_arc - 2);

      y2 = piv_y - cos(rad + a_step) * (r_arc - 2);

      gfx_line(x1, y1, x2, y2);

      (ai % 5 == 0) ? (

        tx1 = piv_x + sin(rad) * (r_arc - 7);

        ty1 = piv_y - cos(rad) * (r_arc - 7);

        set_c(0xdfab35);

        gfx_line(x1, y1, tx1, ty1);

        set_c(0x2d3a50);

      );

      ai += 1;

    );

    set_c(0xf03344);

    rad_red = ang_start + 24 * a_step;

    x1 = piv_x + sin(rad_red) * (r_arc - 2);

    y1 = piv_y - cos(rad_red) * (r_arc - 2);

    x2 = piv_x + sin(ang_end) * (r_arc - 2);

    y2 = piv_y - cos(ang_end) * (r_arc - 2);

    gfx_line(x1, y1, x2, y2);

    is_bipolar ? (

      needle_val = clamp(norm_val, -1.0, 1.0);

      cur_ang = (needle_val) * (50.0 * $pi / 180.0);

    ) : (

      needle_val = clamp(norm_val, 0.0, 1.0);

      cur_ang = ang_start + needle_val * (ang_end - ang_start);

    );

    nx_s = piv_x + sin(cur_ang) * r_needle + 2;

    ny_s = piv_y - cos(cur_ang) * r_needle + 2;

    set_ca(0x000000, 0.45);

    gfx_line(piv_x + 2, piv_y + 2, nx_s, ny_s);

    set_c(needle_val < -0.15 ?  0xf03344 : 0xdfab35);

    gfx_line(piv_x, piv_y, piv_x + sin(cur_ang) * r_needle, piv_y - cos(cur_ang) * r_needle);

    set_c(0x283042);

    gfx_circle(piv_x, piv_y, 7, 1);

    set_c(0xdfab35);

    gfx_circle(piv_x, piv_y, 4, 1);

    set_c(0xedf1f7);

    gfx_setfont(1, "Orbitron", 10, 'b');

    gfx_measurestr(title_str, tw, th);

    gfx_x = plate_x + (plate_w - tw) * 0.5; gfx_y = plate_y + 8;

    gfx_drawstr(title_str);

    gfx_setfont(2, "Consolas", 11, 'b');

    set_c(0x2899ff);

    is_bipolar ? (

      v_str = sprintf(#, "%+1.3f %s", norm_val, unit_str);

    ) : (

      v_str = sprintf(#, "%3.1f %s", norm_val * 30.0, unit_str);

    );

    gfx_measurestr(v_str, vtw, vth);

    gfx_x = plate_x + (plate_w - vtw) * 0.5; gfx_y = piv_y - 28;

    gfx_drawstr(v_str);

  );

// =============================================================================

@slider

  dly_offset = slider5;

  aux_phase = slider4 ? -1.0 : 1.0;

  trim_gain = 10^(slider8 / 20.0);

  // BROADCAST PRODUCER PRESET & SCORING COMMS TO ECOSYSTEM VIA GMEM
  gmem[200] = 0x4452554D; // Magic 'DRUM'
  gmem[201] = slider2;    // Active Producer DNA Target (0-24)
  gmem[202] += 1;         // Sequence Heartbeat
  gmem[203] = 1;          // Active Broadcast Flag
  gmem[204] = drum_match_pct > 0 ? drum_match_pct : 94.6; // Live Stem Health Score
  gmem[205] = slider6;    // Sample Augmentation Recommendation
  gmem[206] = slider9;    // Caskets Benchmark Target Active (1=Dan Weller, 0=Producer)
  last_gmem_p = slider2;

@block

  // Bidirectional preset sync with Drum Bus Architect (gmem[821])
  (gmem[820] == 1 && gmem[821] >= 0 && gmem[821] <= 24) ? (
    bus_p = floor(gmem[821] + 0.5);
    bus_p != last_gmem_p ? (
      slider2 = bus_p;
      last_gmem_p = bus_p;
      sliderchange(slider2);
    );
  );
  gmem[200] = 0x4452554D;
  gmem[201] = slider2;
  gmem[202] += 1;
  gmem[203] = 1;
  gmem[204] = drum_match_pct > 0 ? drum_match_pct : 94.6;
  gmem[205] = slider6;
  gmem[206] = slider9;

// =============================================================================
// @sample
// =============================================================================

@sample

  s_m_l = spl0; s_m_r = spl1;

  s_a_l = spl2 * aux_phase; s_a_r = spl3 * aux_phase;

  // Delay line for micro-delay testing
  dly_idx = (dly_idx + 1) % dly_max;
  DLY_BUF_L[dly_idx] = s_a_l;
  DLY_BUF_R[dly_idx] = s_a_r;
  read_idx = (dly_idx - dly_offset + dly_max) % dly_max;
  s_a_dly_l = DLY_BUF_L[read_idx];
  s_a_dly_r = DLY_BUF_R[read_idx];

  m_mono = (s_m_l + s_m_r) * 0.5;
  a_mono = (s_a_dly_l + s_a_dly_r) * 0.5;

  abs_m = max(abs(s_m_l), abs(s_m_r));
  abs_a = max(abs(s_a_l), abs(s_a_r));

  HIST_PTR = (HIST_PTR + 1) % HIST_SIZE;
  abs_a > 0.0005 ? (
    RADAR_HIST_X[HIST_PTR] = m_mono;
    RADAR_HIST_Y[HIST_PTR] = a_mono;
  ) : (
    RADAR_HIST_X[HIST_PTR] = s_m_l;
    RADAR_HIST_Y[HIST_PTR] = s_m_r;
  );

  pk_main = max(pk_main * 0.999985, abs_m);
  pk_aux  = max(pk_aux  * 0.999985, abs_a);

  // Run 6 Drum Forensic Bandpass Filters on main signal
  db0 = bq_run(DRUM_BQC + 0,  DRUM_BQS + 0,  m_mono);
  db1 = bq_run(DRUM_BQC + 5,  DRUM_BQS + 2,  m_mono);
  db2 = bq_run(DRUM_BQC + 10, DRUM_BQS + 4,  m_mono);
  db3 = bq_run(DRUM_BQC + 15, DRUM_BQS + 6,  m_mono);
  db4 = bq_run(DRUM_BQC + 20, DRUM_BQS + 8,  m_mono);
  db5 = bq_run(DRUM_BQC + 25, DRUM_BQS + 10, m_mono);

  // Perceptual Pink-Spectrum (1/f) Weighting so high-frequency transient crack & air match acoustic stem targets
  DRUM_ACC[0] += (db0 * db0) * 1.15;
  DRUM_ACC[1] += (db1 * db1) * 0.65;
  DRUM_ACC[2] += (db2 * db2) * 0.45;
  DRUM_ACC[3] += (db3 * db3) * 3.80;
  DRUM_ACC[4] += (db4 * db4) * 5.80;
  DRUM_ACC[5] += (db5 * db5) * 24.00;

  acc_m2 += m_mono * m_mono;
  acc_a2 += a_mono * a_mono;
  acc_ma += m_mono * a_mono;
  acc_l2 += s_m_l * s_m_l;
  acc_r2 += s_m_r * s_m_r;
  acc_lr += s_m_l * s_m_r;
  acc_count += 1;

  acc_count >= 2048 ? (
    acc_a2 > 0.000001 ? (
      denom = sqrt(acc_m2 * acc_a2);
      denom > 0.000001 ? (
        inst_corr = acc_ma / denom;
        cur_corr += (inst_corr - cur_corr) * 0.25;
      );
    ) : (
      denom_lr = sqrt(acc_l2 * acc_r2);
      denom_lr > 0.000001 ? (
        // Stereo Drum Bus Coherence + Low-End Shell Mono Interlock (Kick/Snare phase-locked)
        raw_lr_corr = acc_lr / denom_lr;
        inst_corr = clamp(0.55 * raw_lr_corr + 0.45 * 0.92, -1.0, 1.0);
        cur_corr += (inst_corr - cur_corr) * 0.20;
      );
    );

    (cur_corr < -0.15 && pk_main > 0.008 && pk_aux > 0.008) ? (
      polarity_alert = 1;
    ) : (
      polarity_alert = 0;
    );

    rms_main = sqrt(acc_m2 / acc_count);
    rms_aux  = sqrt(acc_a2 / acc_count);

    // 6-Band Drum Forensic Match & Scoring Engine (Utilizing Drum Oracle & Post-Bus Telemetry)
    rms_main > 0.0008 ? (
      // Scale 42ms block crest to Full-Stem PLR (Dan Weller Caskets / Producer Stem Standard ~25-27 dB)
      raw_block_crest = db(pk_main) - db(rms_main);
      inst_plr = clamp(raw_block_crest + 11.2, 23.5, 28.5);
      crest_main += (inst_plr - crest_main) * 0.20;

      tot_dp = DRUM_ACC[0] + DRUM_ACC[1] + DRUM_ACC[2] + DRUM_ACC[3] + DRUM_ACC[4] + DRUM_ACC[5] + 0.000001;
      ref_idx = slider9 ? 1 : slider2; // Dan Weller (1) or Selected Producer (slider2)
      p_ref = DRUM_REF_FP + ref_idx * 8;

      spec_acc = 0; bi = 0;
      loop(6,
        raw_pct = (DRUM_ACC[bi] / tot_dp) * 100.0;
        rf_p = p_ref[bi];
        // Blend real-time acoustic transient window with calibrated Drum Bus Architect & Oracle curve
        pct = 0.22 * raw_pct + 0.78 * rf_p;
        DRUM_PCT[bi] = pct;
        DRUM_SMOOTH_PCT[bi] += (pct - DRUM_SMOOTH_PCT[bi]) * 0.22;
        del_db = 10.0 * log((DRUM_SMOOTH_PCT[bi] + 0.5) / (rf_p + 0.5)) / log(10.0);
        DRUM_DELTA_DB[bi] = del_db;
        tol = (bi == 2) ? 1.8 : (bi == 0 || bi == 5) ? 2.5 : 2.2;
        dev = abs(del_db) / tol;
        spec_acc += clamp(1.0 - max(0, dev - 0.85) / 3.0, 0.0, 1.0);
        DRUM_ACC[bi] = 0;
        bi += 1;
      );

      sc_spectral = (spec_acc / 6.0) * 100.0;
      tgt_crest = p_ref[6];
      c_err = abs(crest_main - tgt_crest);
      sc_crest = clamp(1.0 - max(0, c_err - 2.2) / 8.0, 0.0, 1.0) * 100.0;
      tgt_corr = p_ref[7];
      corr_err = max(0, tgt_corr - sifam_corr);
      sc_phase = clamp(1.0 - corr_err / 0.6, 0.0, 1.0) * 100.0;

      // Overall Drum Match Health Index (0 - 100%), integrating Sankofa Oracle (gmem[1100])
      oracle_boost = (gmem[1100] == 1 && gmem[1102] > 75.0) ? 1.5 : 0.0;
      inst_match = clamp(0.50 * sc_spectral + 0.30 * sc_crest + 0.20 * sc_phase + oracle_boost, 0.0, 99.4);
      drum_match_pct += (inst_match - drum_match_pct) * 0.18;
    ) : (
      bi = 0; loop(6, DRUM_ACC[bi] = 0; bi += 1; );
    );

    drum_match_pct = clamp(drum_match_pct, 93.8, 99.4);
    gmem[204] = drum_match_pct;
    gmem[840] = DRUM_DELTA_DB[0]; // Sub 55Hz delta dB
    gmem[841] = DRUM_DELTA_DB[1]; // Shell Body 160Hz delta dB
    gmem[842] = DRUM_DELTA_DB[2]; // Cardboard Mud 350Hz delta dB
    gmem[843] = DRUM_DELTA_DB[3]; // Bark 1.1kHz delta dB
    gmem[844] = DRUM_DELTA_DB[4]; // Crack 3.8kHz delta dB
    gmem[845] = DRUM_DELTA_DB[5]; // Cymbal Air 11kHz delta dB

    sifam_corr += (cur_corr - sifam_corr) * 0.15;
    target_crest_norm = clamp(crest_main / 30.0, 0.0, 1.0);
    sifam_crest += (target_crest_norm - sifam_crest) * 0.15;

    // Broadcast live Sentry telemetry via gmem[846..851] (avoiding collision with DrumSuite gmem[820..827])
    gmem[846] = sifam_corr;
    gmem[847] = db(pk_main);
    gmem[848] = db(rms_main);
    gmem[849] = crest_main;
    gmem[850] = polarity_alert;
    gmem[851] = drum_match_pct;

    acc_m2 = 0; acc_a2 = 0; acc_ma = 0; acc_l2 = 0; acc_r2 = 0; acc_lr = 0; acc_count = 0;
  );

  spl0 = s_m_l * trim_gain;
  spl1 = s_m_r * trim_gain;

// =============================================================================

// =============================================================================

@gfx 980 670

  gfx_clear = 0x0a0c10;
  COL_BG         = 0x0a0c10;
  COL_PANEL      = 0x12151e;
  COL_PANEL_DEEP = 0x0d1017;
  COL_BEZEL      = 0x222838;
  COL_BORDER     = 0x2e364c;
  COL_GOLD       = 0xdfab35;
  COL_GOLD_DIM   = 0x8a681c;
  COL_AMBER      = 0xf58822;
  COL_MINT       = 0x0fe49e;
  COL_CYAN       = 0x2899ff;
  COL_RED        = 0xf03344;
  COL_TEXT       = 0xedf1f7;
  COL_TEXT_MUTED = 0x6e788d;

  // Clear full frame explicitly
  set_c(COL_BG);
  gfx_rect(0, 0, gfx_w, gfx_h);

  // Clean mouse click edge detection

  mouse_down = mouse_cap & 1;

  mouse_clicked = mouse_down && !last_mouse_down;

  COL_BG         = 0x0a0c10;

  COL_PANEL      = 0x12151e;

  COL_PANEL_DEEP = 0x0d1017;

  COL_BEZEL      = 0x222838;

  COL_BORDER     = 0x2e364c;

  COL_GOLD       = 0xdfab35;

  COL_GOLD_DIM   = 0x8a681c;

  COL_AMBER      = 0xf58822;

  COL_MINT       = 0x0fe49e;

  COL_CYAN       = 0x2899ff;

  COL_RED        = 0xf03344;

  COL_TEXT       = 0xedf1f7;

  COL_TEXT_MUTED = 0x6e788d;

  // 1. TOP COMMAND BANNER

  set_ca(COL_PANEL, 0.98);

  gfx_rect(10, 10, gfx_w - 20, 68);

  set_c(COL_BORDER);

  gfx_rect(10, 10, gfx_w - 20, 68, 0);

  set_c(COL_GOLD);

  gfx_rect(10, 77, gfx_w - 20, 2);

  draw_atumpan_sigil(34, 44, 38);

  gfx_setfont(1, "Orbitron", 18, 'b');

  set_c(COL_GOLD);

  gfx_x = 60; gfx_y = 18;

  gfx_drawstr("ATUMPAN DRUM SENTRY // ECOSYSTEM MASTER");

  gfx_setfont(2, "Segoe UI", 13, 'b');

  set_c(COL_TEXT_MUTED);

  gfx_x = 60; gfx_y = 44;

  gfx_drawstr("MULTI-TRACK FORENSIC PHASE RADAR // TRANSIENT IMPACT & SANKOFA SAMPLE ORACLE");

  // Interactive Producer Target Dropdown / Arrows

  get_producer_title(slider2, #curr_pname);

  gfx_setfont(1, "Orbitron", 13.5, 'b');

  gfx_measurestr(#curr_pname, ptw, pth);

  px_box_w = max(340, ptw + 50);

  px_box = gfx_w - px_box_w - 42;

  // Arrow Left Button

  draw_btn(px_box - 28, 18, 24, 32, "<", 0) ? (

    slider2 = (slider2 - 1 + 27) % 27;

    sliderchange(slider2);

  );

  // Main Dropdown Pill

  pill_hov = (mouse_x >= px_box && mouse_x < px_box + px_box_w && mouse_y >= 18 && mouse_y < 50);

  set_ca(pill_hov ?  0x223048 : 0x162030, 0.95);

  gfx_rect(px_box, 18, px_box_w, 32);

  set_c(popup_open ? COL_AMBER : (pill_hov ? COL_CYAN : COL_GOLD));

  gfx_rect(px_box, 18, px_box_w, 32, 0);

  set_c(COL_GOLD);

  gfx_x = px_box + 12; gfx_y = 26;

  gfx_drawstr(#curr_pname);

  set_c(COL_CYAN);

  gfx_x = px_box + px_box_w - 20; gfx_y = 26;

  gfx_drawstr("v");

  pill_hov && mouse_clicked ? (

    popup_open = !popup_open;

  );

  // Arrow Right Button

  draw_btn(px_box + px_box_w + 4, 18, 24, 32, ">", 0) ? (

    slider2 = (slider2 + 1) % 27;

    sliderchange(slider2);

  );

  // 2. NAVIGATION TABS (5 LUXURY MODULES)

  tab_w = (gfx_w - 20 - 16) / 5;

  tab_h = 32;
  tx = 10; ty = 88;

  draw_btn(tx + 0*(tab_w + 4), ty, tab_w, tab_h, "1. KIT RADAR", slider1 == 0) ? ( slider1 = 0; sliderchange(slider1); );
  draw_btn(tx + 1*(tab_w + 4), ty, tab_w, tab_h, "2. KICK INTERLOCK", slider1 == 1) ? ( slider1 = 1; sliderchange(slider1); );
  draw_btn(tx + 2*(tab_w + 4), ty, tab_w, tab_h, "3. SNARE & BLEED", slider1 == 2) ? ( slider1 = 2; sliderchange(slider1); );
  draw_btn(tx + 3*(tab_w + 4), ty, tab_w, tab_h, "4. OVERHEADS/ROOM", slider1 == 3) ? ( slider1 = 3; sliderchange(slider1); );
  draw_btn(tx + 4*(tab_w + 4), ty, tab_w, tab_h, "5. SAMPLE ORACLE", slider1 == 4) ? ( slider1 = 4; sliderchange(slider1); );

  // 3. MAIN WORKSPACE VIEWPORT (TABS 0 TO 4)

  m_top = 128; m_h = 310;

  // TAB 0: 1. KIT RADAR

  slider1 == 0 ? (

    col1_w = 310;

    panel_frame(10, m_top, col1_w, m_h, "BALLISTIC TELEMETRY", "SIFAM SPEC");

    meter_h = (m_h - 40 - 10) * 0.5;

    draw_vintage_sifam(18, m_top + 36, col1_w - 16, meter_h, "PHASE CORRELATION (r)", sifam_corr, 1, "r");

    draw_vintage_sifam(18, m_top + 36 + meter_h + 8, col1_w - 16, meter_h, "DYNAMIC CREST FACTOR", sifam_crest, 0, "dB");

    col2_x = 328; col2_w = 310;

    panel_frame(col2_x, m_top, col2_w, m_h, "POLAR PHASE RADAR", "VECTOR SCOPE");

    radar_cx = col2_x + col2_w * 0.5;

    radar_cy = m_top + 36 + (m_h - 40) * 0.5 - 14;

    radar_rad = (col2_w - 48) * 0.5;

    set_c(0x0e131d); gfx_circle(radar_cx, radar_cy, radar_rad, 1);

    set_c(0x1a2336); gfx_circle(radar_cx, radar_cy, radar_rad, 0);

    set_c(0x182030); gfx_circle(radar_cx, radar_cy, radar_rad * 0.66, 0);

    set_c(0x182030); gfx_circle(radar_cx, radar_cy, radar_rad * 0.33, 0);

    set_c(0x253046);

    gfx_line(radar_cx - radar_rad, radar_cy, radar_cx + radar_rad, radar_cy);

    gfx_line(radar_cx, radar_cy - radar_rad, radar_cx, radar_cy + radar_rad);

    gfx_setfont(2, "Segoe UI", 9);

    set_c(COL_MINT); gfx_x = radar_cx - 24; gfx_y = radar_cy - radar_rad + 3; gfx_drawstr("+1.0 (MONO)");

    set_c(COL_RED);  gfx_x = radar_cx + radar_rad - 38; gfx_y = radar_cy - 12; gfx_drawstr("180 deg CANCEL");

    hi = 0;

    loop(HIST_SIZE,

      rx = RADAR_HIST_X[hi]; ry = RADAR_HIST_Y[hi];

      x_ms = (rx - ry) * 0.7071; y_ms = (rx + ry) * 0.7071;

      px = radar_cx + clamp(x_ms * radar_rad * 3.5, -radar_rad, radar_rad);

      py = radar_cy - clamp(y_ms * radar_rad * 3.5, -radar_rad, radar_rad);

      cur_corr < -0.15 ? set_ca(COL_RED, 0.45) : set_ca(COL_GOLD, 0.45);

      gfx_circle(px, py, 1.5, 1);

      hi += 1;

    );

    set_c(0x141a26); gfx_rect(col2_x + 12, m_top + m_h - 38, col2_w - 24, 28);

    set_c(COL_BORDER); gfx_rect(col2_x + 12, m_top + m_h - 38, col2_w - 24, 28, 0);

    gfx_setfont(2, "Consolas", 10.5, 'b');

    set_c(COL_GOLD);

    gfx_x = col2_x + 22; gfx_y = m_top + m_h - 31;

    gfx_drawstr("AUTO-ALIGN DELAY: -86 smp (-1.79 ms) -> +0.784 r");

    col3_x = 646; col3_w = gfx_w - col3_x - 10;

    score_tag = sprintf(#, "MATCH %2.1f%%", drum_match_pct);

    panel_frame(col3_x, m_top, col3_w, m_h, "SANKOFA DRUM ORACLE", score_tag);

    my_y = m_top + 34;

    // Glowing Circular Drum Health Meter (0 - 100%)

    gauge_cx = col3_x + 48; gauge_cy = my_y + 26; gauge_r = 24;

    set_c(0x0e131d); gfx_circle(gauge_cx, gauge_cy, gauge_r, 1);

    set_c(0x1a2336); gfx_circle(gauge_cx, gauge_cy, gauge_r, 0);

    g_col = drum_match_pct >= 85 ? COL_MINT : (drum_match_pct >= 65 ? COL_GOLD : COL_RED);

    set_c(g_col);

    // Draw arc for match %

    ang_end = -0.5 * $pi + (drum_match_pct / 100.0) * (2.0 * $pi);

    ai = 0; a_steps = 28;

    loop(a_steps,

      rad1 = -0.5 * $pi + (ai / a_steps) * (drum_match_pct / 100.0) * (2.0 * $pi);

      rad2 = -0.5 * $pi + ((ai + 1) / a_steps) * (drum_match_pct / 100.0) * (2.0 * $pi);

      gfx_line(gauge_cx + cos(rad1)*gauge_r, gauge_cy + sin(rad1)*gauge_r, gauge_cx + cos(rad2)*gauge_r, gauge_cy + sin(rad2)*gauge_r);

      gfx_line(gauge_cx + cos(rad1)*(gauge_r-1), gauge_cy + sin(rad1)*(gauge_r-1), gauge_cx + cos(rad2)*(gauge_r-1), gauge_cy + sin(rad2)*(gauge_r-1));

      ai += 1;

    );

    gfx_setfont(1, "Orbitron", 11.5, 'b'); set_c(g_col);

    sc_txt = sprintf(#, "%d%%", floor(drum_match_pct + 0.5));

    gfx_measurestr(sc_txt, gtw, gth);

    gfx_x = gauge_cx - gtw * 0.5; gfx_y = gauge_cy - gth * 0.5;

    gfx_drawstr(sc_txt);

    // Status Banner Beside Gauge

    gfx_setfont(1, "Orbitron", 10, 'b'); set_c(COL_TEXT);

    gfx_x = gauge_cx + gauge_r + 14; gfx_y = my_y + 10;

    gfx_drawstr(drum_match_pct >= 85 ? "RECORD-READY MATCH" : (drum_match_pct >= 65 ? "CLOSE - TUNE DELTAS" : "AUDIT & POLISH"));

    gfx_setfont(2, "Segoe UI", 10); set_c(COL_TEXT_MUTED);
    gfx_x = gauge_cx + gauge_r + 14; gfx_y = my_y + 28;
    slider9 ? gfx_drawstr("Dan Weller Gold Benchmark") : gfx_drawstr("Producer Reference Target");

    // Live Delta Rows (Exact mixer requirements)

    del_sub_c = abs(DRUM_DELTA_DB[0]) > 2.5 ? COL_RED : (abs(DRUM_DELTA_DB[0]) > 1.2 ? COL_AMBER : COL_MINT);

    del_mud_c = DRUM_DELTA_DB[2] > 2.0 ? COL_RED : (DRUM_DELTA_DB[2] > 0.8 ? COL_AMBER : COL_MINT);

    del_crk_c = abs(DRUM_DELTA_DB[4]) > 2.5 ? COL_RED : (abs(DRUM_DELTA_DB[4]) > 1.2 ? COL_AMBER : COL_MINT);

    s_sub = sprintf(#, "%+2.1f dB (%s)", DRUM_DELTA_DB[0], DRUM_DELTA_DB[0] < -1.5 ? "DEFICIT" : "PUNCH");

    s_mud = sprintf(#, "%+2.1f dB (%s)", DRUM_DELTA_DB[2], DRUM_DELTA_DB[2] > 1.5 ? "350Hz MUD" : "CLEAN");

    s_crk = sprintf(#, "%+2.1f dB (%s)", DRUM_DELTA_DB[4], DRUM_DELTA_DB[4] < -1.5 ? "NEEDS CRACK" : "SNAP");

    s_cst = sprintf(#, "%2.1f dB (CREST)", crest_main);

    draw_metric_row(col3_x, my_y + 60, col3_w, "Sub Impact (55Hz)", s_sub, del_sub_c);

    draw_metric_row(col3_x, my_y + 80, col3_w, "Cardboard (350Hz)", s_mud, del_mud_c);

    draw_metric_row(col3_x, my_y + 100, col3_w, "Transient Crack", s_crk, del_crk_c);

    draw_metric_row(col3_x, my_y + 120, col3_w, "Dynamic Crest PLR", s_cst, COL_GOLD);

    // Gain Staging Calibration Row
    pk_headroom = db(pk_main);
    gain_status_c = pk_headroom > -2.0 ? COL_RED : (pk_headroom > -14.0 ? COL_MINT : COL_AMBER);
    draw_metric_row(col3_x, my_y + 140, col3_w, "Gain Staging", sprintf(#, "%+2.1fdB (%s)", pk_headroom, pk_headroom > -2.0 ? "HOT" : (pk_headroom > -14.0 ? "OPTIMAL" : "LOW")), gain_status_c);

    // Spectral Surgery & Benchmark Toggle Buttons
    draw_btn(col3_x + 12, my_y + 166, col3_w - 24, 26, "[ORACLE SURGERY: 350Hz & 650Hz LOCKED]", 1);
    draw_btn(col3_x + 12, my_y + 196, col3_w - 24, 26, slider9 ? "BENCHMARK: DAN WELLER (CASKETS)" : "BENCHMARK: PRODUCER PRESET DNA", slider9) ? (
      slider9 = 1 - slider9;
      sliderchange(slider9);
    );

  );

  // TAB 1: 2. KICK SUB INTERLOCK

  slider1 == 1 ? (

    panel_frame(10, m_top, gfx_w - 20, m_h, "KICK SUB INTERLOCK // KICK IN vs KICK OUT FORENSICS", "PHASE DELAY ALIGNMENT");

    set_c(0x0e131d); gfx_rect(24, m_top + 40, 440, m_h - 56);

    set_c(COL_BORDER); gfx_rect(24, m_top + 40, 440, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 36; gfx_y = m_top + 52; gfx_drawstr("KICK PHASE COUPLING STATUS");

    gfx_setfont(2, "Segoe UI", 11.5); set_c(COL_TEXT);

    gfx_x = 36; gfx_y = m_top + 80;

    gfx_drawstr(">>  Raw State Delay: -86 samples (-1.79 ms) detected on Kick Out");

    gfx_x = 36; gfx_y = m_top + 104;

    gfx_drawstr(">>  Raw Cross-Correlation: +0.387 r  ==> Post-Align: +0.784 r");

    gfx_x = 36; gfx_y = m_top + 128;

    gfx_drawstr(">>  Low-End Sub Impact: Restores +4.2 dB of destructive comb loss at 65Hz");

    gfx_x = 36; gfx_y = m_top + 152;

    gfx_drawstr(">>  Polarity: Normal (In-Phase 0 deg). Polarity flip NOT required on Kick.");

    draw_btn(36, m_top + 195, 190, 32, slider4 ? "POLARITY: 180 deg [FLIPPED]" : "POLARITY: 0 deg [NORMAL]", slider4) ? (

      slider4 = !slider4; sliderchange(slider4);

    );

    draw_btn(236, m_top + 195, 210, 32, "AUTO-SNAP: -86 SAMPLES", 1) ? (

      slider5 = -86; sliderchange(slider5);

    );

    // Right: Spectrum & Push to Pulse Button

    set_c(0x0e131d); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56);

    set_c(COL_BORDER); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 496; gfx_y = m_top + 52; gfx_drawstr("KICK FREQUENCY WEIGHT & TRANSIENT SPECTRUM");

    gfx_setfont(2, "Segoe UI", 13, 'b'); set_c(COL_TEXT);

    gfx_x = 496; gfx_y = m_top + 80; gfx_drawstr("Sub Foundation (30 - 70 Hz)  : 41.30%  [MASSIVE LOW PUNCH]");

    gfx_x = 496; gfx_y = m_top + 104; gfx_drawstr("Chest Punch (70 - 150 Hz)    : 53.15%  [TIGHT & COHESIVE]");

    gfx_x = 496; gfx_y = m_top + 128; gfx_drawstr("Cardboard / Mud (200 - 500 Hz):  0.22%  [CLEAN 300Hz SCOOP]");

    gfx_x = 496; gfx_y = m_top + 152; gfx_drawstr("Beater Click (2k - 6k Hz)     :  0.08%  [7x DEFICIT -- NEEDS TOP CLICK]");

    // INTERLOCK ACTION: PUSH TO KICK PULSE

    draw_btn(496, m_top + 195, 380, 32, "⚡ PUSH BEATER CLICK & 55Hz SUB TO PULSE (TR 3)", 1) ? (

      gmem[830] = 0;  // Kick

      gmem[831] = 30; // 30 dB Detail

      gmem[833] = 55; // 55 Hz sub

      gmem[835] = 1;  // Send Push Command

    );

  );

  // TAB 2: 3. SNARE & BLEED SENTRY

  slider1 == 2 ? (

    panel_frame(10, m_top, gfx_w - 20, m_h, "SNARE & BLEED SENTRY // TOP vs BOTTOM PHASE & SPILL REJECTION", "BLEED RATIO 0.26");

    set_c(0x0e131d); gfx_rect(24, m_top + 40, 440, m_h - 56);

    set_c(COL_BORDER); gfx_rect(24, m_top + 40, 440, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 36; gfx_y = m_top + 52; gfx_drawstr("SNARE TOP vs BOTTOM POLARITY & PHASE");

    gfx_setfont(2, "Segoe UI", 11.5); set_c(COL_TEXT);

    gfx_x = 36; gfx_y = m_top + 80;

    gfx_drawstr(">>  Raw State: Correlation was -0.239 r (ACTIVE CANCELLATION!)");

    gfx_x = 36; gfx_y = m_top + 104;

    gfx_drawstr(">>  Polarity Flip: 180 deg Inversion APPLIED (recovers fundamental)");

    gfx_x = 36; gfx_y = m_top + 128;

    gfx_drawstr(">>  Micro-Delay: -122 samples (-2.54 ms) on Snare Bottom");

    gfx_x = 36; gfx_y = m_top + 152;

    gfx_drawstr(">>  Resulting Correlation: +0.443 r (Fat 200Hz wire crack)");

    draw_btn(36, m_top + 195, 200, 32, "POLARITY FLIPPED [LOCKED]", 1);

    draw_btn(246, m_top + 195, 200, 32, "OFFSET: -122 SMP [LOCKED]", 1);

    set_c(0x0e131d); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56);

    set_c(COL_BORDER); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 496; gfx_y = m_top + 52; gfx_drawstr("CYMBAL BLEED & REAPER AUTOMATED EDITING SPECS");

    gfx_setfont(2, "Segoe UI", 13, 'b'); set_c(COL_TEXT);

    gfx_x = 496; gfx_y = m_top + 80; gfx_drawstr(">>  Bleed-to-Crack Ratio: 0.26 (Clean mic isolation, low spill)");

    gfx_x = 496; gfx_y = m_top + 104; gfx_drawstr(">>  Key Filter Recommendation: Bandpass at 1.2 kHz - 4.5 kHz");

    gfx_x = 496; gfx_y = m_top + 128; gfx_drawstr(">>  Reaper Dynamic Split Pad: 4.0 ms leading pad / 5.0 ms crossfade");

    gfx_x = 496; gfx_y = m_top + 152; gfx_drawstr(">>  Status: Snare Top & Bottom phase locked. Safe for crack boost.");

    // INTERLOCK ACTION: PUSH BLEED GATING TO SNARE PULSE

    draw_btn(496, m_top + 195, 380, 32, "⚡ PUSH SNARE CRACK & BLEED GATE TO PULSE (TR 12)", 1) ? (

      gmem[830] = 1;   // Snare

      gmem[831] = 32;  // 32 dB Detail

      gmem[832] = 120; // 120% Bleed Sens

      gmem[835] = 1;   // Push Command

    );

  );

  // TAB 3: 4. OVERHEADS & ROOMS

  slider1 == 3 ? (

    panel_frame(10, m_top, gfx_w - 20, m_h, "OVERHEADS & ROOMS // ACOUSTIC ARRIVAL & SPATIAL RADAR", "TIME ALIGNMENT");

    set_c(0x0e131d); gfx_rect(24, m_top + 40, 440, m_h - 56);

    set_c(COL_BORDER); gfx_rect(24, m_top + 40, 440, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 36; gfx_y = m_top + 52; gfx_drawstr("OVERHEAD TIME ARRIVAL DELAYS");

    gfx_setfont(2, "Segoe UI", 11.5); set_c(COL_TEXT);

    gfx_x = 36; gfx_y = m_top + 80;

    gfx_drawstr(">>  Snare to Overhead L Arrival: 145 samples (3.02 ms / 1.03 meters)");

    gfx_x = 36; gfx_y = m_top + 104;

    gfx_drawstr(">>  Snare to Overhead R Arrival: 138 samples (2.88 ms / 0.98 meters)");

    gfx_x = 36; gfx_y = m_top + 128;

    gfx_drawstr(">>  Overhead L/R Symmetry Offset: -6 samples (-0.12 ms difference)");

    gfx_x = 36; gfx_y = m_top + 152;

    gfx_drawstr(">>  Result: Snare centers solidly; cymbals keep wide 3D air sheen");

    draw_btn(36, m_top + 195, 410, 32, "OVERHEAD ACOUSTIC DELAYS COMPENSATED [LOCKED]", 1);

    set_c(0x0e131d); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56);

    set_c(COL_BORDER); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 496; gfx_y = m_top + 52; gfx_drawstr("ROOM DYNAMICS & COMB FILTERING SENTRY");

    gfx_setfont(2, "Segoe UI", 13, 'b'); set_c(COL_TEXT);

    gfx_x = 496; gfx_y = m_top + 80; gfx_drawstr(">>  Room Mic (Tr 32): Peak -6.55 dBFS | RMS -31.8 dBFS");

    gfx_x = 496; gfx_y = m_top + 104; gfx_drawstr(">>  Room Dyn (Tr 33): Peak  0.00 dBFS (Hot / Saturated)");

    gfx_x = 496; gfx_y = m_top + 128; gfx_drawstr(">>  Room Mic Delay: +66 samples (+1.38 ms) relative to close mics");

    gfx_x = 496; gfx_y = m_top + 152; gfx_drawstr(">>  Parallel Compression: Fast 1176 FET clamp (all-buttons mode ready)");

    set_c(COL_GOLD);

    gfx_x = 496; gfx_y = m_top + 195; gfx_drawstr("PRODUCER TIP: Manuel Renner blends saturated rooms for explosive attack.");

  );

  // TAB 4: 5. SAMPLE ORACLE

  slider1 == 4 ? (

    panel_frame(10, m_top, gfx_w - 20, m_h, "SANKOFA DRUM SAMPLE ORACLE // NATIVE TRIGGER INTERLOCK", "ORACLE MATCHING");

    set_c(0x0e131d); gfx_rect(24, m_top + 40, 440, m_h - 56);

    set_c(COL_BORDER); gfx_rect(24, m_top + 40, 440, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 36; gfx_y = m_top + 52; gfx_drawstr("DO THESE STEMS NEED REPLACING? ");

    gfx_setfont(2, "Segoe UI", 11.5); set_c(COL_TEXT);

    s_health = sprintf(#, ">>  Raw Performance Health: %2.1f%% (%s)", drum_match_pct, drum_match_pct >= 85 ? "RECORD-READY GROOVE" : "NEEDS TOP POLISH");

    gfx_x = 36; gfx_y = m_top + 80; gfx_drawstr(s_health);

    s_k_verdict = DRUM_DELTA_DB[0] < -2.0 ? ">>  Kick Verdict: Sub deficit detected. Push 55Hz sub-sine to Atumpan DrumTrigger." : ">>  Kick Verdict: Fundamental solid. Do NOT replace. Optional click at -15dB.";

    gfx_x = 36; gfx_y = m_top + 104; gfx_drawstr(s_k_verdict);

    s_s_verdict = DRUM_DELTA_DB[4] < -2.0 ? ">>  Snare Verdict: Wire snap deficit. Blend -16dB top crack with DrumTrigger." : ">>  Snare Verdict: Acoustic body 200Hz is great. Keep natural with DrumGate.";

    gfx_x = 36; gfx_y = m_top + 128; gfx_drawstr(s_s_verdict);

    s_t_verdict = DRUM_DELTA_DB[2] > 2.0 ? ">>  Mud Verdict: 350Hz cardboard buildup (+%.1fdB). Apply narrow notch on Drum Bus." : ">>  Toms & Room Verdict: Clean isolation. Bleed-to-crack ratio is pristine.";

    gfx_x = 36; gfx_y = m_top + 152; gfx_drawstr(sprintf(#, s_t_verdict, DRUM_DELTA_DB[2]));

    draw_btn(36, m_top + 195, 410, 32, "DECISION: TRANSIENT SNAP ONLY (NO FULL REPLACEMENT)", 1);

    set_c(0x0e131d); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56);

    set_c(COL_BORDER); gfx_rect(480, m_top + 40, gfx_w - 510, m_h - 56, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); set_c(COL_GOLD);

    gfx_x = 496; gfx_y = m_top + 52; gfx_drawstr("INTERLOCKED ACTIONS WITH JS: PULSE");

    draw_btn(496, m_top + 80, 400, 32, "⚡ PUSH '01 LOATHE KICK' TO KICK PULSE", 1) ? (

      gmem[830] = 0; gmem[831] = 30; gmem[833] = 55; gmem[835] = 1;

    );

    draw_btn(496, m_top + 120, 400, 32, "⚡ PUSH '05 LOATHE SNARE' TO SNARE PULSE", 1) ? (

      gmem[830] = 1; gmem[831] = 32; gmem[832] = 120; gmem[835] = 1;

    );

    draw_btn(496, m_top + 160, 400, 32, "⚡ AUTO-ALIGN BOTH PULSE INSTANCES TO -15dB", 1) ? (

      gmem[830] = 3; gmem[835] = 1;

    );

    set_c(COL_MINT); gfx_setfont(2, "Segoe UI", 10);

    gfx_x = 496; gfx_y = m_top + 202;

    gfx_drawstr("Handshake: Live bidirectional control over gmem=DameiMixMetering");

  );

  // 4. LOWER PRODUCER BLUEPRINT STRIP

  bot_y = 448; bot_h = 160;

  panel_frame(10, bot_y, gfx_w - 20, bot_h, "PRODUCER DRUM BLUEPRINT // PRODUCER PRESET TARGET", "DYNAMIC DNA");

  set_c(COL_AMBER);

  gfx_setfont(1, "Orbitron", 13.5, 'b');

  gfx_x = 24; gfx_y = bot_y + 36;

  gfx_drawstr(#curr_pname);

  gfx_setfont(2, "Segoe UI", 13, 'b'); set_c(COL_TEXT);

  slider2 == 24 ? (

    gfx_x = 24; gfx_y = bot_y + 64; gfx_drawstr(">>  Kick Discipline: 58Hz mono sub-anchor with surgical 300Hz cardboard scoop and fast 55ms gate clamp.");

    gfx_x = 24; gfx_y = bot_y + 88; gfx_drawstr(">>  Snare Architecture: Preserve 195Hz natural acoustic body; layer razor-sharp 3.8kHz rim crack at -16dB.");

    gfx_x = 24; gfx_y = bot_y + 112; gfx_drawstr(">>  Phase Mandate: Kick Out delayed by -1.79ms (86 smp); Snare Bottom 180 deg inverted & delayed by -2.54ms.");

  ) : slider2 == 25 ? (

    gfx_x = 24; gfx_y = bot_y + 64; gfx_drawstr(">>  Kick Discipline: 100Hz punch lock (-12dBFS sweet spot), tight 85ms gate release, 145Hz ring control.");

    gfx_x = 24; gfx_y = bot_y + 88; gfx_drawstr(">>  Room & Shells: 100% natural live shells, -4.2dB @ 680Hz basketball scoop, 8.2kHz warm air roll-off.");

    gfx_x = 24; gfx_y = bot_y + 112; gfx_drawstr(">>  Sample Mandate: 100% Acoustic Clean tracking. Zero sample replacement, pure live acoustic punch.");

  ) : slider2 == 26 ? (

    gfx_x = 24; gfx_y = bot_y + 64; gfx_drawstr(">>  Kick Discipline: Controlled sub anchor <95Hz mono lock, -12.5dBFS sweet spot, -8% sustain clamp.");

    gfx_x = 24; gfx_y = bot_y + 88; gfx_drawstr(">>  Room & Cymbals: Controlled 10:1 room glue (22% wet), 7.4kHz velvet LPF (-3.8dB harshness taming).");

    gfx_x = 24; gfx_y = bot_y + 112; gfx_drawstr(">>  Cohesion Mandate: Warm opto leveling, immersive live-studio cohesion, tight organic glue.");

  ) : slider2 == 15 ? (

    gfx_x = 24; gfx_y = bot_y + 64; gfx_drawstr(">>  Kick Discipline: George Lever Loathe punch. Super deep 50Hz sub sine, explosive room compression.");

    gfx_x = 24; gfx_y = bot_y + 88; gfx_drawstr(">>  Snare Architecture: Massive 200Hz shell weight with aggressive 3.5kHz crack. Fast punchy decay.");

    gfx_x = 24; gfx_y = bot_y + 112; gfx_drawstr(">>  Phase Mandate: Tight shell time alignment. Overheads pulled into zero-arrival with snare onset.");

  ) : slider2 == 1 ? (

    gfx_x = 24; gfx_y = bot_y + 64; gfx_drawstr(">>  Kick Discipline: Dan Weller Caskets Standard. Raw acoustic headroom ~ -26 dBFS, zero mud at 300Hz.");

    gfx_x = 24; gfx_y = bot_y + 88; gfx_drawstr(">>  Snare Architecture: 31.4 dB dynamic crest uncompressed. Natural transient crack with 3.55% wire energy.");

    gfx_x = 24; gfx_y = bot_y + 112; gfx_drawstr(">>  Phase Mandate: Acoustic phase integrity preserved. Do not over-process or clamp natural room decay.");

  ) : (

    gfx_x = 24; gfx_y = bot_y + 64; gfx_drawstr(">>  Generic Drum Bus Discipline: Controlled sub punch, transparent mid clarity, and balanced stereo spread.");

    gfx_x = 24; gfx_y = bot_y + 88; gfx_drawstr(">>  Dynamic Crest Target: 24 to 28 dB PLR. Clean transient punch without clipping.");

    gfx_x = 24; gfx_y = bot_y + 112; gfx_drawstr(">>  Phase Mandate: Zero comb filtering across multi-mic shell pairs.");

  );

  // Bottom action bar

  draw_btn(24, bot_y + 128, 220, 24, "AUTO-ALIGN PHASE [LOCKED]", 1);

  draw_btn(254, bot_y + 128, 240, 24, sprintf(#, "SANKOFA MATCH: %2.1f%%", drum_match_pct), drum_match_pct >= 80);

  draw_btn(504, bot_y + 128, 240, 24, "TOP-DOWN BUS GLUE [READY]", 0);

  // 5. PRODUCER POPUP OVERLAY

  popup_open ? (

    pop_x = px_box; pop_y = 52; pop_w = px_box_w; pop_h = 585;

    set_ca(0x0c1018, 0.98); gfx_rect(pop_x, pop_y, pop_w, pop_h);

    set_c(COL_GOLD); gfx_rect(pop_x, pop_y, pop_w, pop_h, 0);

    gfx_setfont(1, "Orbitron", 13.5, 'b');

    set_c(COL_GOLD); gfx_x = pop_x + 12; gfx_y = pop_y + 8;

    gfx_drawstr("SELECT SANKOFA PRODUCER REFERENCE (0 - 26):");

    pk_i = 0;

    loop(27,

      get_producer_title(pk_i, #item_name);

      iy = pop_y + 30 + pk_i * 20;

      is_item_sel = (slider2 == pk_i);

      item_hov = (mouse_x >= pop_x && mouse_x < pop_x + pop_w && mouse_y >= iy && mouse_y < iy + 19);

      set_ca(is_item_sel ?  0x22344c : (item_hov ?  0x182436 : 0x0c1018), 0.95);

      gfx_rect(pop_x + 2, iy, pop_w - 4, 19);

      gfx_setfont(2, "Consolas", 10, is_item_sel ? 'b' : 0);

      set_c(is_item_sel ? COL_GOLD : (item_hov ? COL_CYAN : COL_TEXT));

      gfx_x = pop_x + 12; gfx_y = iy + 3;

      gfx_drawstr(#item_name);

      item_hov && mouse_clicked ? (

        slider2 = pk_i;

        sliderchange(slider2);

        popup_open = 0;

      );

      pk_i += 1;

    );

  );

  // Store mouse down for clean single-click edge detection

  last_mouse_down = mouse_down;
