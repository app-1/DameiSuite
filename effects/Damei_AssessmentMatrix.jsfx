  p = LIB + 12*32; p[0]=-5.2352; p[1]=5.2714; p[2]=9.1777; p[3]=3.0594; p[4]=0.5114; p[5]=0.5686; p[6]=13.2088; p[7]=38.4912; p[8]=19.8901; p[9]=18.2914; p[10]=7.3716; p[11]=2.0763; p[12]=0.6706; p[13]=0.2044; p[14]=0.5827; p[15]=0.6795; p[16]=0.6072; p[17]=0.6915; p[18]=0.6285; p[19]=0.5762; p[31]=1; LPR[12]=14;
  p = LIB + 13*32; p[0]=-7.5164; p[1]=7.2168; p[2]=10.6268; p[3]=2.1671; p[4]=0.6139; p[5]=0.4892; p[6]=16.2238; p[7]=45.5864; p[8]=13.7087; p[9]=14.7516; p[10]=6.8375; p[11]=2.1105; p[12]=0.7814; p[13]=0.1768; p[14]=0.3982; p[15]=0.6198; p[16]=0.7355; p[17]=0.8029; p[18]=0.7767; p[19]=0.7326; p[31]=1; LPR[13]=15;
  p = LIB + 14*32; p[0]=-6.2118; p[1]=6.0319; p[2]=10.0208; p[3]=8.3573; p[4]=0.5761; p[5]=0.5189; p[6]=17.4613; p[7]=33.6070; p[8]=16.7310; p[9]=21.0352; p[10]=7.9870; p[11]=2.1244; p[12]=1.0541; p[13]=0.1529; p[14]=0.3883; p[15]=0.6475; p[16]=0.7306; p[17]=0.8183; p[18]=0.7469; p[19]=0.7203; p[31]=1; LPR[14]=16;
  p = LIB + 15*32; p[0]=-5.7727; p[1]=5.7475; p[2]=9.7771; p[3]=11.7231; p[4]=0.6898; p[5]=0.4284; p[6]=13.7513; p[7]=37.1638; p[8]=16.7578; p[9]=21.8169; p[10]=8.3183; p[11]=1.6122; p[12]=0.5798; p[13]=0.1842; p[14]=0.3555; p[15]=0.5255; p[16]=0.5239; p[17]=0.6058; p[18]=0.5064; p[19]=0.4121; p[31]=1; LPR[15]=17;
  p = LIB + 16*32; p[0]=-5.3273; p[1]=5.2269; p[2]=9.3666; p[3]=6.2878; p[4]=0.5612; p[5]=0.5302; p[6]=15.6120; p[7]=30.6081; p[8]=17.8643; p[9]=21.9693; p[10]=10.8948; p[11]=2.2083; p[12]=0.8431; p[13]=0.1150; p[14]=0.3103; p[15]=0.7284; p[16]=0.7658; p[17]=0.7531; p[18]=0.6952; p[19]=0.6580; p[31]=1; LPR[16]=18;
  p = LIB + 17*32; p[0]=-7.2241; p[1]=6.9294; p[2]=10.0873; p[3]=8.0302; p[4]=0.6065; p[5]=0.4949; p[6]=17.9343; p[7]=36.2320; p[8]=26.0096; p[9]=13.4652; p[10]=4.6049; p[11]=1.2167; p[12]=0.5373; p[13]=0.1270; p[14]=0.3880; p[15]=0.6798; p[16]=0.7091; p[17]=0.7294; p[18]=0.6401; p[19]=0.5726; p[31]=1; LPR[17]=19;
  p = LIB + 18*32; p[0]=-5.2305; p[1]=6.5533; p[2]=10.9461; p[3]=8.9305; p[4]=0.4602; p[5]=0.6080; p[6]=18.5071; p[7]=34.2077; p[8]=14.6136; p[9]=19.0172; p[10]=8.8100; p[11]=3.2455; p[12]=1.5990; p[13]=0.2762; p[14]=0.5974; p[15]=0.7132; p[16]=0.7435; p[17]=0.8036; p[18]=0.7684; p[19]=0.7187; p[31]=1; LPR[18]=-1;
  p = LIB + 19*32; p[0]=-5.6986; p[1]=5.3686; p[2]=9.6463; p[3]=5.5904; p[4]=0.4217; p[5]=0.6378; p[6]=13.2707; p[7]=32.3402; p[8]=22.2987; p[9]=21.7530; p[10]=7.5388; p[11]=1.9550; p[12]=0.8436; p[13]=0.1352; p[14]=0.4113; p[15]=0.8818; p[16]=0.9030; p[17]=0.9505; p[18]=0.8299; p[19]=0.7852; p[31]=1; LPR[19]=-1;
  p = LIB + 20*32; p[0]=-7.7222; p[1]=7.6938; p[2]=11.4866; p[3]=3.2200; p[4]=0.5054; p[5]=0.5732; p[6]=18.1353; p[7]=35.2806; p[8]=17.4784; p[9]=19.0124; p[10]=7.2881; p[11]=2.0087; p[12]=0.7965; p[13]=0.2406; p[14]=0.6527; p[15]=0.6423; p[16]=0.6274; p[17]=0.6553; p[18]=0.5860; p[19]=0.5481; p[31]=1; LPR[20]=-1;
  p = LIB + 21*32; p[0]=-6.4312; p[1]=5.4225; p[2]=10.2071; p[3]=7.1584; p[4]=0.3376; p[5]=0.7037; p[6]=6.4378; p[7]=41.6045; p[8]=26.9973; p[9]=14.2921; p[10]=7.9141; p[11]=2.1006; p[12]=0.6535; p[13]=0.4000; p[14]=0.6795; p[15]=0.7578; p[16]=0.7796; p[17]=0.7654; p[18]=0.7386; p[19]=0.7790; p[31]=1; LPR[21]=-1;
  function lib_name(i, out) (
    i == 0 ? strcpy(out, "Alpha Wolf - 60cm Of Steel") :
    i == 1 ? strcpy(out, "DIESECT - Too Many Scars") :
    i == 2 ? strcpy(out, "Mirrorcell - U(phoria)") :
    i == 3 ? strcpy(out, "thrown - on the verge") :
    i == 4 ? strcpy(out, "blanket - Blur") :
    i == 5 ? strcpy(out, "Split Chain - I'm Not Dying To Be Here") :
    i == 6 ? strcpy(out, "Don Broco - Endorphins") :
    i == 7 ? strcpy(out, "Static Dress - face.") :
    i == 8 ? strcpy(out, "Shyeye - Knot (Remix)") :
    i == 9 ? strcpy(out, "Heavenward - Tangerine") :
    i == 10 ? strcpy(out, "City Of Souls - Cruelty") :
    i == 11 ? strcpy(out, "SUNBORN - Nebula") :
    i == 12 ? strcpy(out, "Fit For An Autopsy - Walk With Me In Hell") :
    i == 13 ? strcpy(out, "Loathe - Aggressive Evolution") :
    i == 14 ? strcpy(out, "Thornhill - nerv") :
    i == 15 ? strcpy(out, "Architects - Gravity") :
    i == 16 ? strcpy(out, "Spiritbox - Keep Sweet") :
    i == 17 ? strcpy(out, "Bad Omens - Death Of Peace Of Mind") :
    i == 18 ? strcpy(out, "Northlane - Evian") :
    i == 19 ? strcpy(out, "Love Is Noise - Hole In Me") :
    i == 20 ? strcpy(out, "The End Of All We Know") :
    i == 21 ? strcpy(out, "Flake - Grief") :
    strcpy(out, "?");
  );
  // <<LIB_END>>

// ---- DSP helpers ---------------------------------------------------------------
function clampv(x, lo, hi) ( x < lo ? lo : (x > hi ? hi : x); );

function bqrun(c, s, x) local(y) (
  y = c[0]*x + s[0];
  s[0] = c[1]*x - c[3]*y + s[1];
  s[1] = c[2]*x - c[4]*y;
  y;
);

function bq_design(c, hp, fc, q) local(w0, cs, al, a0, b0, b1) (
  w0 = 2*$pi*fc/srate; cs = cos(w0); al = sin(w0)/(2*q); a0 = 1 + al;
  hp ? ( b0 = (1+cs)*0.5; b1 = -(1+cs); ) : ( b0 = (1-cs)*0.5; b1 = 1-cs; );
  c[0] = b0/a0; c[1] = b1/a0; c[2] = b0/a0; c[3] = -2*cs/a0; c[4] = (1-al)/a0;
);

function hist_pct(base, nb, tot, frac) local(i, c, tg) (
  tg = tot*frac; c = 0; i = 0;
  while (i < nb-1 && c + base[i] < tg) ( c += base[i]; i += 1; );
  i;
);

// ---- band + K-weight setup ---------------------------------------------------
EDG[0]=20; EDG[1]=60; EDG[2]=250; EDG[3]=800; EDG[4]=2500; EDG[5]=6000; EDG[6]=10000; EDG[7]=18000;
b = 0;
loop(7,
  bq_design(BQC + (b*2)*5,   1, EDG[b], 0.70710678);
  bq_design(BQC + (b*2+1)*5, 0, min(EDG[b+1], srate*0.45), 0.70710678);
  b += 1;
);

// K-weighting (ITU-R BS.1770, same maths as pyloudnorm)
kA = pow(10, 3.999843853973347/40); kw0 = 2*$pi*1681.9744509555319/srate;
kal = sin(kw0)/(2*0.7071752369554196); kcs = cos(kw0); ksA = sqrt(kA);
ka0 = (kA+1) - (kA-1)*kcs + 2*ksA*kal;
KC[0] = kA*((kA+1) + (kA-1)*kcs + 2*ksA*kal)/ka0;
KC[1] = -2*kA*((kA-1) + (kA+1)*kcs)/ka0;
KC[2] = kA*((kA+1) + (kA-1)*kcs - 2*ksA*kal)/ka0;
KC[3] = 2*((kA-1) - (kA+1)*kcs)/ka0;
KC[4] = ((kA+1) - (kA-1)*kcs - 2*ksA*kal)/ka0;
kK = tan($pi*38.13547087613982/srate); kQ = 0.5003270373253953;
kh0 = 1 + kK/kQ + kK*kK;
KC[5] = 1; KC[6] = -2; KC[7] = 1;
KC[8] = 2*(kK*kK - 1)/kh0; KC[9] = (1 - kK/kQ + kK*kK)/kh0;

blk_len = floor(0.1*srate);

function reset_all() local(i) (
  i = 0; loop(14,  ACC[i] = 0; i += 1; );
  i = 0; loop(400, HSTG[i] = 0;  i += 1; );
  i = 0; loop(120, HS[i] = 0;  i += 1; );
  i = 0; loop(30,  RB[i] = 0;  i += 1; );
  i = 0; loop(56,  BQS[i] = 0; i += 1; );
  i = 0; loop(8,   KS[i] = 0;  i += 1; );
  blk_pow = 0; blk_n = 0; rpos = 0; rcount = 0;
  sum_m2 = 0; sum_s2 = 0; sLR = 0; sLL = 0; sRR = 0; pk = 0; tot_n = 0;
  have_data = 0;
  i = 0; loop(14, BA[i] = 0; EM[i] = 0; i += 1; );
  ema_n = 0;
  // Always clear runaway trims on transport start/reset
  i = 0; loop(42, TT[i] = 0; i += 1; );
  i = 0; loop(6, TW[i] = 0; i += 1; );
  ED = 0;
);
reset_all();
cap_valid = 0;
reset_req = 0; last_ps = 0; hb_t = 0;
overall = 0; sc_tonal = 0; sc_stereo = 0; sc_dyn = 0; pidx_eff = 18;
last_mc = 0; ref_ptr = FP; ui_view = 0;
// ---- suite ownership: how much each suite (0 drums 1 guitar 2 bass 3 vocal 4 synth 5 devastator) shapes each band
i = 0; loop(42, WT[i] = 0; TT[i] = 0; i += 1; );
i = 0; loop(6, TW[i] = 0; i += 1; );
WT[0*7+0]=0.35; WT[2*7+0]=0.60; WT[4*7+0]=0.05;
WT[0*7+1]=0.30; WT[1*7+1]=0.20; WT[2*7+1]=0.40; WT[3*7+1]=0.05; WT[4*7+1]=0.05;
WT[0*7+2]=0.15; WT[1*7+2]=0.35; WT[2*7+2]=0.10; WT[3*7+2]=0.20; WT[4*7+2]=0.20;
WT[0*7+3]=0.05; WT[1*7+3]=0.35; WT[2*7+3]=0.05; WT[3*7+3]=0.35; WT[4*7+3]=0.20;
WT[0*7+4]=0.20; WT[1*7+4]=0.25; WT[3*7+4]=0.40; WT[4*7+4]=0.15;
WT[0*7+5]=0.25; WT[1*7+5]=0.15; WT[3*7+5]=0.30; WT[4*7+5]=0.30;
WT[0*7+6]=0.20; WT[1*7+6]=0.05; WT[3*7+6]=0.40; WT[4*7+6]=0.35;
WGTS[0]=0.15; WGTS[1]=0.35; WGTS[2]=0.0; WGTS[3]=0.10; WGTS[4]=0.40; WGTS[5]=0.0;
// ---- energy lane: instrument suites get a density request when the mix crest exceeds the reference ----
// ESW = per-suite share (0 drums 1 guitar 2 bass 3 vocal 4 synth 5 devastator). Vocal + bass excluded on purpose.
ESW = 3850; ESW[0]=1.0; ESW[1]=1.0; ESW[2]=0.0; ESW[3]=0.0; ESW[4]=1.0; ESW[5]=0.5;
ED = 0;
raw_captured = 0;
raw_sc_overall = 0;
raw_sc_tonal = 0;
raw_sc_stereo = 0;
raw_sc_dyn = 0;
last_slider10 = 0;
ctl_ki = 0.08;      // integrator gain per 0.5 s control step (tuned by simulation, see sim_control_loop.py)
ctl_dead = 0.7;     // dB dead-band on band error
ctl_tau_w = 0.98758; // exp(-0.1 s / 8 s)

// ---- metrics + scoring ---------------------------------------------------------
function compute_metrics() local(i, tot, c, n, pw, g, n2, sum2, gate, mean1, lo, hi, d, tol, sc, stg, e, ref, pdb, cnt, k, bi, bv, s, rf, ts, ws, dd, dw) (
  // integrated loudness (absolute -70 / relative -10 LU gating)
  n = 0; sum1 = 0; i = 0;
  loop(400, c = HSTG[i]; c > 0 ? ( n += c; sum1 += c * pow(10, (((i+0.5)/5 - 70) + 0.691)/10); ); i += 1; );
  n > 0 ? (
    gate = -0.691 + 10*log10(sum1/n) - 10;
    n2 = 0; sum2 = 0; i = 0;
    loop(400, c = HSTG[i]; (c > 0 && ((i+0.5)/5 - 70) > gate) ? ( n2 += c; sum2 += c * pow(10, (((i+0.5)/5 - 70) + 0.691)/10); ); i += 1; );
    int_lufs = n2 > 0 ? -0.691 + 10*log10(sum2/n2) : -70;
  ) : ( int_lufs = -70; );

  // LRA (p95 - p10 of 3 s short-term loudness)
  n = 0; i = 0; loop(120, n += HS[i]; i += 1; );
  lra = n > 8 ? (hist_pct(HS, 120, n, 0.95) - hist_pct(HS, 120, n, 0.10))*0.5 : 0;

  pdb = 20*log10(pk + 0.000000000001);
  rms_db = 10*log10(sum_m2/max(tot_n,1) + 0.000000000000000001);
  LV[0] = int_lufs; LV[1] = pdb - int_lufs; LV[2] = pdb - rms_db; LV[3] = lra;
  LV[4] = sLR/sqrt(sLL*sRR + 0.000000000000000000000000000001);
  LV[5] = sqrt(sum_s2/(sum_m2 + 0.000000000000000001));
  pk_db = pdb;

  tot = 0; i = 0; loop(7, tot += ACC[i*2] + ACC[i*2+1]; i += 1; );
  i = 0;
  loop(7,
    LV[6+i]  = 100*(ACC[i*2] + ACC[i*2+1])/(tot + 0.000000000000000000000000000001);
    LV[13+i] = sqrt(ACC[i*2+1]/(ACC[i*2] + 0.000000000000000000000000000001));
    i += 1;
  );

  // choose reference
  pidx_eff = (slider1 == 0 && gmem[1000] == 1) ? clampv(floor(gmem[1008]+0.5), 0, 21) : slider2;
  ref = (slider3 == 2) ? (LIB + clampv(slider9, 0, 21)*32) : ((slider3 == 1 && cap_valid) ? CAP : (FP + pidx_eff*32));
  ref_ptr = ref;
  stg = slider4;

  // deviations
  tonal_sc = 0; i = 0;
  loop(7,
    DV[i] = 10*log10((LV[6+i] + 0.02)/(ref[6+i] + 0.02));
    tol = (i == 0 || i == 6) ? 2.0 : 1.5;
    DEVF[i] = abs(DV[i])/tol;
    tonal_sc += clampv(1 - max(0, DEVF[i]-1)/3, 0, 1);
    i += 1;
  );
  sc_tonal = tonal_sc/7*100;

  st_sc = 0; i = 0;
  loop(7,
    DV[7+i] = LV[13+i] - ref[13+i];
    DEVF[7+i] = abs(DV[7+i])/0.20;
    st_sc += clampv(1 - max(0, DEVF[7+i]-1)/3, 0, 1);
    i += 1;
  );
  // Stage-aware dynamic targets:
  // In Mix Bus stage (slider4 == 0), normalize for the expected -6 dBTP pre-master operating window:
  expected_mix_plr = ref[1] + 3.8;  // e.g. 5.23 + 3.8 = 9.03 dB PLR
  expected_mix_lufs = ref[0] - 9.5; // e.g. -5.33 - 9.5 = -14.83 LUFS
  DV[14] = slider4 ? (LV[0] - ref[0]) : (LV[0] - expected_mix_lufs);
  DEVF[14] = abs(DV[14])/1.5;
  DV[15] = slider4 ? (LV[1] - ref[1]) : (LV[1] - expected_mix_plr);
  DEVF[15] = abs(DV[15])/1.5;
  DV[16] = LV[2] - ref[2]; DEVF[16] = abs(DV[16])/1.5;
  DV[17] = LV[3] - ref[3]; DEVF[17] = abs(DV[17])/2.0;
  DV[18] = LV[4] - ref[4]; DEVF[18] = abs(DV[18])/0.10;
  st_sc += clampv(1 - max(0, DEVF[18]-1)/3, 0, 1);
  sc_stereo = st_sc/8*100;

  dy_sc = 0; i = 14;
  loop(4, dy_sc += clampv(1 - max(0, DEVF[i]-1)/3, 0, 1); i += 1; );
  sc_dyn = dy_sc/4*100;

  // High-Value Suite Telemetry Metrics:
  // 1. Vocal Anchor Ratio (Lead Vocal vs Master RMS Ratio)
  vox_act = (gmem[880] == 1 && gmem[883] > -80.0);
  vox_rel_mst = vox_act ? gmem[888] : -99.0;
  vox_target = -6.5; // Dan Braunstein blueprint lead vocal pocket target
  vox_dv = vox_act ? (vox_rel_mst - vox_target) : 0;
  sc_vox = vox_act ? clampv(1.0 - max(0, abs(vox_dv) - 0.5)/3.0, 0.0, 1.0)*100 : 100;

  // 2. Kick-to-Sub Phase Interlock
  bass_act = (gmem[860] == 1);
  sub_corr = bass_act ? gmem[866] : 0.50; // kick/bass correlation
  sub_duck = bass_act ? gmem[867] : -2.0; // ducking GR

  // 3. Drum Shell Transient Punch Ratio
  drum_act = (gmem[820] == 1);
  drum_crest = drum_act ? gmem[824] : 9.5;

  overall = stg ? (0.45*sc_tonal + 0.30*sc_stereo + 0.25*sc_dyn) : (0.60*sc_tonal + 0.40*sc_stereo);

  // Capture raw mix baseline metrics and score when in Raw Audit mode
  slider10 ? (
    ci = 0; loop(20, RAW_FP[ci] = LV[ci]; ci += 1; );
    ci = 0; loop(20, RAW_DV[ci] = DV[ci]; ci += 1; );
    raw_sc_tonal = sc_tonal;
    raw_sc_stereo = sc_stereo;
    raw_sc_dyn = sc_dyn;
    raw_sc_overall = overall;
    raw_captured = 1;
  );

  // how closely the live signal matches EVERY library reference (tonal 60% + width 40%)
  k = 0;
  loop(22,
    rf = LIB + k*32; ts = 0; ws = 0; i = 0;
    loop(7,
      dd = abs(10*log10((LV[6+i] + 0.02)/(rf[6+i] + 0.02)))/((i == 0 || i == 6) ? 2.0 : 1.5);
      ts += clampv(1 - max(0, dd - 1)/3, 0, 1);
      dw = abs(LV[13+i] - rf[13+i])/0.20;
      ws += clampv(1 - max(0, dw - 1)/3, 0, 1);
      i += 1;
    );
    LM[k] = 100*(0.6*ts + 0.4*ws)/7;
    k += 1;
  );

  // recommendation severities
  i = 0; loop(40, SEV[i] = 0; i += 1; );
  i = 0;
  loop(7,
    DEVF[i] > 1 ? ( SEV[i*2 + (DV[i] > 0)] = DEVF[i]; );
    DEVF[7+i] > 1 ? ( SEV[14 + i*2 + (DV[7+i] > 0)] = DEVF[7+i]; );
    i += 1;
  );
  stg ? (
    DEVF[15] > 1 ? ( SEV[28 + (DV[15] < 0)] = DEVF[15]; );
    DEVF[14] > 1 ? ( SEV[30 + (DV[14] > 0)] = DEVF[14]; );
  );
  DEVF[18] > 1 ? ( SEV[32] = DEVF[18]; );
  k = 0;
  loop(4,
    bv = 0; bi = -1; i = 0;
    loop(33, SEV[i] > bv ? ( bv = SEV[i]; bi = i; ); i += 1; );
    RC[k] = bi; bi >= 0 ? ( SEV[bi] = 0; );
    k += 1;
  );

  // gmem export for the Mixing Suite / other Damei tools
  gmem[1100] = 1; gmem[1101] = overall; gmem[1102] = sc_tonal; gmem[1103] = sc_stereo;
  gmem[1104] = sc_dyn; gmem[1105] = pidx_eff; gmem[1106] = stg;
  i = 0; loop(7, gmem[1107+i] = DV[i]; gmem[1114+i] = DV[7+i]; i += 1; );
  gmem[1121] = int_lufs; gmem[1122] = LV[1]; gmem[1123] = LV[4];
  gmem[1124] = time_precise();
  gmem[1126] = sc_vox;
  gmem[1127] = vox_rel_mst;
  gmem[1128] = sub_corr;
  gmem[1129] = drum_crest;
);

// ---- closed-loop correction lane --------------------------------------------------------------------
// Slow, capped, dead-banded integrator on an 8 s moving average of the band energies.
// Publishes trims per suite on gmem[1300 + suite*16 ...]: +0 valid, +1..+7 band dB, +8 side-shelf dB, +15 heartbeat.
function ctl_publish() local(s, b, base, allow_trims) (
  allow_trims = (slider7 == 1 && slider10 == 0);
  s = 0;
  loop(6,
    base = 1300 + s*16;
    gmem[base] = allow_trims ? 1 : 0;
    b = 0; loop(7, gmem[base + 1 + b] = allow_trims ? TT[s*7 + b] : 0; b += 1; );
    gmem[base + 8] = allow_trims ? TW[s] : 0;
    gmem[base + 9] = allow_trims ? (ED * ESW[s]) : 0;   // density request 0..1 (energy lane)
    gmem[base + 15] = time_precise();
    s += 1;
  );
  gmem[1098] = slider10 ? 1 : 0;
  gmem[1099] = raw_captured ? raw_sc_overall : 0;
);

function ctl_block() local(i, w, e, s, b, tot, pct, dvb, cap, ew, bwv, bwr, x, b_cap_pos, b_cap_neg) (
  ema_n += 1;
  w = max(1/ema_n, 1 - ctl_tau_w);
  i = 0; loop(14, EM[i] += (BA[i]/blk_len - EM[i])*w; BA[i] = 0; i += 1; );

  (ema_n >= 20 && ema_n % 5 == 0) ? (
    ctl_publish();
    // Only integrate trims if:
    // 1. Auto-Correct is ON (slider7 == 1)
    // 2. Not in Hold (slider5 == 0)
    // 3. Not in Raw Audit (slider10 == 0)
    // 4. Transport is actively playing ((play_state & 1) == 1)
    // 5. Signal is present and substantial (tot > 0.0005 and have_data)
    tot = 0; i = 0; loop(7, tot += EM[i*2] + EM[i*2+1]; i += 1; );

    (slider7 == 1 && slider5 == 0 && slider10 == 0 && (play_state & 1) && tot > 0.0005 && have_data) ? (
      cap = min(slider8, 2.5);
      b = 0;
      loop(7,
        pct = 100*(EM[b*2] + EM[b*2+1])/(tot + 0.000000000000000001);
        dvb = 10*log10((pct + 0.02)/(ref_ptr[6+b] + 0.02));
        e = -dvb;
        e = abs(e) < ctl_dead ? 0 : (e > 0 ? e - ctl_dead : e + ctl_dead);

        // Asymmetric band caps: never boost mud (b==2) or cut highs (b>=5) excessively
        b_cap_pos = (b == 2) ? 0.8 : cap; // Low-mid (250-800Hz mud) max +0.8 dB boost!
        b_cap_neg = (b >= 5) ? 1.5 : cap; // High/Air max -1.5 dB cut!

        s = 0;
        loop(6,
          x = WT[s*7+b];
          (b >= 3 && b <= 5) ? (
            (e < 0) ? ( s == 3 ? ( x *= 0.35; ) : ( (s == 1 || s == 4) ? ( x *= 1.35; ); ); )
                    : ( s == 3 ? ( x *= 1.25; ); );
          ) : ( (b == 2 && e < 0 && (s == 1 || s == 4)) ? ( x *= 1.35; ); );

          // Gentle 0.998 leak factor prevents integrator windup and section hangover
          TT[s*7+b] = clampv(TT[s*7+b] * 0.998 + ctl_ki * x * e, -b_cap_neg, b_cap_pos);
          s += 1;
        );
        b += 1;
      );

      // Side-shelf width integrator:
      ew = 0; b = 4;
      loop(3,
        bwv = sqrt(EM[b*2+1]/(EM[b*2] + 0.000000000000000001));
        bwr = ref_ptr[13+b];
        ew += -20*log10((bwv + 0.02)/(bwr + 0.02));
        b += 1;
      );
      ew = ew/3;
      ew = abs(ew) < 0.8 ? 0 : (ew > 0 ? ew - 0.8 : ew + 0.8);
      s = 0;
      // CRITICAL: Max negative side-shelf cut is strictly limited to -0.8 dB!
      // Never allow auto-correct to muffle the 3kHz+ stereo soundstage!
      loop(6, 
        TW[s] = clampv(TW[s] * 0.998 + ctl_ki * WGTS[s] * ew * 1.0, -0.8, 1.5); 
        s += 1; 
      );

      // Energy lane: subtle crest density shaping (max request 0.35, not 1.0)
      x = (LV[2] - ref_ptr[2] - 0.7) / 4.0;
      ED += (clampv(x, 0, 0.35) - ED) * 0.10;
      gmem[1125] = ED;
      ctl_publish();
    ) : (
      // When transport stopped or signal quiet: smoothly decay trims towards 0 (zero windup)
      s = 0;
      loop(6,
        b = 0;
        loop(7, TT[s*7+b] *= 0.992; b += 1; );
        TW[s] *= 0.992;
        s += 1;
      );
      ED *= 0.99;
      ctl_publish();
    );
  );
);

@block
ps = play_state & 1;
(slider6 == 1 && ps && !last_ps) ? ( reset_req = 1; );
last_ps = ps;
(slider10 != last_slider10) ? (
  reset_req = 1;
  last_slider10 = slider10;
);
ctl_publish();

@sample
reset_req ? ( reset_all(); reset_req = 0; );

l = spl0; r = spl1;
slider5 == 0 ? (
  m = (l + r)*0.5; s = (l - r)*0.5;

  b = 0;
  loop(7,
    ym = bqrun(BQC + (b*2)*5,   BQS + (b*2)*2,       m);
    ym = bqrun(BQC + (b*2+1)*5, BQS + (b*2+1)*2,     ym);
    ys = bqrun(BQC + (b*2)*5,   BQS + (14 + b*2)*2,  s);
    ys = bqrun(BQC + (b*2+1)*5, BQS + (14 + b*2+1)*2, ys);
    ACC[b*2] += ym*ym; ACC[b*2+1] += ys*ys;
    BA[b*2] += ym*ym;  BA[b*2+1] += ys*ys;
    b += 1;
  );

  kl = bqrun(KC, KS + 0, l);  kl = bqrun(KC + 5, KS + 2, kl);
  kr = bqrun(KC, KS + 4, r);  kr = bqrun(KC + 5, KS + 6, kr);
  blk_pow += kl*kl + kr*kr; blk_n += 1;

  sum_m2 += m*m; sum_s2 += s*s; sLR += l*r; sLL += l*l; sRR += r*r;
  pk = max(pk, max(abs(l), abs(r)));
  tot_n += 1;

  blk_n >= blk_len ? (
    pw = blk_pow/blk_n; blk_pow = 0; blk_n = 0;
    RB[rpos] = pw; rpos = (rpos + 1) % 30; rcount += 1;
    rcount >= 4 ? (
      mp = 0; q = 0;
      loop(4, mp += RB[(rpos - 1 - q + 60) % 30]; q += 1; );
      lmv = -0.691 + 10*log10(mp/4 + 0.000000000000000001);
      lmv > -70 ? ( bn = clampv(floor((lmv + 70)*5), 0, 399); HSTG[bn] += 1; );
    );
    (rcount >= 30 && rcount % 10 == 0) ? (
      mp = 0; q = 0; loop(30, mp += RB[q]; q += 1; );
      lst = -0.691 + 10*log10(mp/30 + 0.000000000000000001);
      lst > -60 ? ( bn = clampv(floor((lst + 60)*2), 0, 119); HS[bn] += 1; );
    );
    (rcount % 5 == 0 && rcount >= 10) ? ( have_data = 1; compute_metrics(); );
    ctl_block();
  );
);

@serialize
file_var(0, cap_valid);
ci = 0; loop(42, file_var(0, TT[ci]); ci += 1; );
ci = 0; loop(6, file_var(0, TW[ci]); ci += 1; );
ci = 0; loop(32, file_var(0, CAP[ci]); ci += 1; );

@gfx 1020 800
// ---- helpers ------------------------------------------------------------------
function rct(x, y, w, h) ( gfx_rect(ox + x*gsc, oy + y*gsc, max(1, w*gsc), max(1, h*gsc)); );
function rcto(x, y, w, h) ( gfx_rect(ox + x*gsc, oy + y*gsc, max(1, w*gsc), max(1, h*gsc), 0); );
function lin(x1, y1, x2, y2) ( gfx_line(ox + x1*gsc, oy + y1*gsc, ox + x2*gsc, oy + y2*gsc, 1); );
function cir(x, y, r) ( gfx_circle(ox + x*gsc, oy + y*gsc, max(1, r*gsc), 1); );
function col(r, g, b) ( gfx_r = r; gfx_g = g; gfx_b = b; );
function txt(x, y, s) ( gfx_x = ox + x*gsc; gfx_y = oy + y*gsc; gfx_drawstr(s); );
function txt_r(xr, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = ox + xr*gsc - w; gfx_y = oy + y*gsc; gfx_drawstr(s); );
function status_col(d) ( d <= 1 ? col(0.20, 0.92, 0.62) : (d <= 2 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55)); );

function card(x, y, w, h, ttl, cr, cg, cb) (
  col(0.038, 0.044, 0.068); rct(x, y, w, h);
  col(cr, cg, cb); rcto(x, y, w, h);
  rct(x, y, w, 3);
  gfx_setfont(1); col(cr, cg, cb); txt(x + 14, y + 12, ttl);
);

function dev_bar(x, y, w, h, val, rng, d) local(cx, ww) (
  col(0.07, 0.08, 0.12); rct(x, y, w, h);
  cx = x + w*0.5;
  ww = clampv(val/rng, -1, 1) * w*0.5;
  status_col(d);
  ww >= 0 ? rct(cx, y + 2, ww, h - 4) : rct(cx + ww, y + 2, -ww, h - 4);
  col(0.85, 0.9, 1.0); lin(cx, y - 2, cx, y + h + 2);
);

function fill_bar(x, y, w, h, frac, d) (
  col(0.07, 0.08, 0.12); rct(x, y, w, h);
  status_col(d); rct(x, y + 2, clampv(frac, 0, 1)*w, h - 4);
);

function btn(x, y, w, h, lbl, on) local(hov, clk) (
  hov = (mxs >= x && mxs < x + w && mys >= y && mys < y + h);
  clk = hov && (mouse_cap & 1) && !(last_mc & 1);
  on ? col(0.00, 0.30, 0.28) : (hov ? col(0.12, 0.14, 0.22) : col(0.07, 0.08, 0.13));
  rct(x, y, w, h);
  on ? col(0.00, 0.96, 0.83) : col(0.38, 0.42, 0.55);
  rcto(x, y, w, h);
  gfx_setfont(3); txt(x + 8, y + (h - 12)*0.5, lbl);
  clk;
);

function preset_name(i, out) (
  i == 0  ? strcpy(out, "Default Modern Metal (avg ref)") :
  i == 1  ? strcpy(out, "Lance Prenc - Alpha Wolf") :
  i == 2  ? strcpy(out, "Scott Seigel - DIESECT") :
  i == 3  ? strcpy(out, "Jonathan Dolese - Mirrorcell") :
  i == 4  ? strcpy(out, "Buster Odeholm - thrown") :
  i == 5  ? strcpy(out, "Lewis Johns - blanket") :
  i == 6  ? strcpy(out, "Kel Pinchin - Split Chain") :
  i == 7  ? strcpy(out, "Dan Lancaster - Don Broco") :
  i == 8  ? strcpy(out, "Erik Bickerstaffe - Static Dress") :
  i == 9  ? strcpy(out, "Sam Guaiana - Shyeye") :
  i == 10 ? strcpy(out, "Zach Tuch - Heavenward") :
  i == 11 ? strcpy(out, "Forrester Savell - City Of Souls") :
  i == 12 ? strcpy(out, "Leon Schmidt - SUNBORN") :
  i == 13 ? strcpy(out, "Ermin Hamidovic (avg ref)") :
  i == 14 ? strcpy(out, "Will Putney - FFAA") :
  i == 15 ? strcpy(out, "George Lever - Loathe") :
  i == 16 ? strcpy(out, "Sam Bassal - Thornhill") :
  i == 17 ? strcpy(out, "Henrik Udd - Architects Gravity") :
  i == 18 ? strcpy(out, "Dan Braunstein - Spiritbox Keep Sweet") :
  i == 19 ? strcpy(out, "Cervini & Ron - Bad Omens") :
  i == 20 ? strcpy(out, "Jens Bogren (avg ref)") :
            strcpy(out, "Nolly Getgood (avg ref)");
);

function band_label(b, out) (
  b == 0 ? strcpy(out, "Sub 20-60") :
  b == 1 ? strcpy(out, "Low 60-250") :
  b == 2 ? strcpy(out, "Low-mid 250-800") :
  b == 3 ? strcpy(out, "Mid 0.8-2.5k") :
  b == 4 ? strcpy(out, "Hi-mid 2.5-6k") :
  b == 5 ? strcpy(out, "High 6-10k") :
           strcpy(out, "Air 10-18k");
);

function rec_text(code, out) local(b, over) (
  b = floor(code/2); over = code % 2;
  code < 14 ? (
    code == 0  ? strcpy(out, "Sub too light: lift Bass Suite 30-55 Hz anchor / kick weight") :
    code == 1  ? strcpy(out, "Sub too heavy: ease Bass Suite sub anchor, Mixing low shelf") :
    code == 2  ? strcpy(out, "Low end thin: add Bass/Drum weight 60-250 Hz") :
    code == 3  ? strcpy(out, "MUD 60-250: trim Bass low-mids, Drum 200 Hz shell, Guitar chug") :
    code == 4  ? strcpy(out, "Hollow 250-800: ease Mixing mud scoop, add Guitar body") :
    code == 5  ? strcpy(out, "Boxy 250-800: deepen Mixing mud scoop (340 Hz)") :
    code == 6  ? strcpy(out, "Scooped mids: lift Vocal / Guitar 1-2.5 kHz") :
    code == 7  ? strcpy(out, "Honky 0.8-2.5k: carve Guitar/Vocal mids, Ozone EQ") :
    code == 8  ? strcpy(out, "NO PRESENCE 2.5-6k: Vocal presence, widen Guitar De-Fizz, Drum snap") :
    code == 9  ? strcpy(out, "Harsh 2.5-6k: soften Vocal presence, Guitar fizz, Drum snap") :
    code == 10 ? strcpy(out, "Dull 6-10k: raise Vocal air, Synth / Guitar sheen") :
    code == 11 ? strcpy(out, "Bright 6-10k: tame Vocal de-ess / air, Synth sheen") :
    code == 12 ? strcpy(out, "No air 10k+: add Vocal Maag air band, Synth sheen") :
                 strcpy(out, "Fizzy air 10k+: lower Maag air band, Synth 12 kHz sheen");
  ) : code < 28 ? (
    b = floor((code - 14)/2); over = (code - 14) % 2;
    band_label(b, #bl);
    over ? sprintf(out, "Too WIDE at %s: reduce Guitar quad-wall / Synth width / Ozone imager", #bl)
         : sprintf(out, "Too NARROW at %s: add Synth/Guitar imager, Mixing stereo space", #bl);
  ) : (
    code == 28 ? strcpy(out, "Too dynamic (PLR high): more Ozone drive / ceiling push") :
    code == 29 ? strcpy(out, "OVER-SQUASHED (PLR low): back off Mixing VCA / Ozone maximizer") :
    code == 30 ? strcpy(out, "Quieter than ref: master gain/Ozone maximizer (not mix compression)") :
    code == 31 ? strcpy(out, "Louder than ref: reduce Ozone maximizer drive") :
                 strcpy(out, "Low correlation: check phase + wide highs (Imagers, Ozone width)");
  );
);

// ---- Sankofa (Adinkra): "go back and fetch it" - learn from the masters, then build forward -------
// A heart held by two inward spirals. Fits this plugin: the reference tracks are the past we fetch from.
function draw_sankofa(cx, cy, sz) local(k, t, px, py, nx, ny, sc, a, rad, side) (
  sc = sz/34;
  col(1.00, 0.72, 0.02);
  k = 0; px = 0; py = 0;
  loop(41,
    t = k*2*$pi/40;
    nx = cx + 16*pow(sin(t), 3)*sc;
    ny = cy - (13*cos(t) - 5*cos(2*t) - 2*cos(3*t) - cos(4*t))*sc + 1.5*sc;
    k > 0 ? lin(px, py, nx, ny);
    px = nx; py = ny; k += 1;
  );
  col(0.00, 0.96, 0.83);
  side = -1;
  loop(2,
    k = 0;
    loop(30,
      a = k*0.2;
      rad = max(0.4, 5.6*sc*(1 - a/6.2));
      nx = cx + side*7.2*sc + side*rad*cos(a*side + 1.2);
      ny = cy - 5.4*sc - rad*sin(a*side + 1.2);
      k > 0 ? lin(px, py, nx, ny);
      px = nx; py = ny; k += 1;
    );
    side = 1;
  );
  col(1.00, 0.72, 0.02); cir(cx, cy + 6.5*sc, max(1.5, 1.8*sc));
);

function draw_library() local(k, y, rf, sel, hov, clk, best, bm, x0) (
  card(24, 86, 972, 692, "REFERENCE LIBRARY (22 tracks) - click a row to compare", 1.00, 0.85, 0.30);
  gfx_setfont(3); col(0.5, 0.55, 0.68);
  txt(38, 122, "#");  txt(62, 122, "TRACK");
  txt(306, 122, "LUFS"); txt(352, 122, "PLR"); txt(394, 122, "CREST"); txt(440, 122, "LRA"); txt(480, 122, "CORR"); txt(524, 122, "WIDTH");
  txt(576, 122, "SUB"); txt(620, 122, "LOW"); txt(664, 122, "LMID"); txt(708, 122, "MID"); txt(752, 122, "HMID"); txt(796, 122, "HIGH"); txt(840, 122, "AIR");
  txt(892, 122, "LIVE MATCH");
  best = -1; bm = 0; k = 0;
  have_data ? ( loop(22, LM[k] > bm ? ( bm = LM[k]; best = k; ); k += 1; ); );
  k = 0;
  loop(22,
    y = 144 + k*25;
    rf = LIB + k*32;
    sel = (slider3 == 2 && floor(slider9 + 0.5) == k);
    hov = (mxs >= 30 && mxs < 990 && mys >= y - 2 && mys < y + 23);
    clk = hov && (mouse_cap & 1) && !(last_mc & 1);
    sel ? ( col(0.10, 0.22, 0.22); rct(30, y - 2, 960, 24); ) : ( hov ? ( col(0.09, 0.10, 0.16); rct(30, y - 2, 960, 24); ); );
    gfx_setfont(2);
    sel ? col(0.00, 0.96, 0.83) : col(0.85, 0.9, 1.0);
    sprintf(#v, "%d", k + 1); txt(38, y, #v);
    lib_name(k, #ln); txt(62, y, #ln);
    col(0.7, 0.75, 0.85);
    sprintf(#v, "%.1f", rf[0]);  txt(306, y, #v);
    sprintf(#v, "%.1f", rf[1]);  txt(352, y, #v);
    sprintf(#v, "%.1f", rf[2]);  txt(394, y, #v);
    sprintf(#v, "%.1f", rf[3]);  txt(440, y, #v);
    sprintf(#v, "%.2f", rf[4]);  txt(480, y, #v);
    sprintf(#v, "%.2f", rf[5]);  txt(524, y, #v);
    x0 = 576; i = 0;
    loop(7, sprintf(#v, "%.1f", rf[6 + i]); txt(x0 + i*44, y, #v); i += 1; );
    have_data ? (
      LM[k] >= 85 ? col(0.20, 0.92, 0.62) : (LM[k] >= 65 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55));
      sprintf(#v, "%d%%%s", floor(LM[k] + 0.5), k == best ? "  NEAREST" : ""); txt(892, y, #v);
    ) : ( col(0.4, 0.45, 0.55); txt(892, y, "--"); );
    clk ? ( slider3 = 2; slider9 = k; slider_automate(slider3); slider_automate(slider9); );
    k += 1;
  );
  // detail strip for the selected library track
  k = floor(slider9 + 0.5);
  rf = LIB + k*32;
  gfx_setfont(3); col(0.00, 0.96, 0.83);
  lib_name(k, #ln);
  LPR[k] >= 0 ? ( preset_name(LPR[k], #pp); ) : ( strcpy(#pp, "no producer preset linked"); );
  sprintf(#v, "%s  |  Producer preset: %s  |  LUFS %.1f  PLR %.1f  Crest %.1f  LRA %.1f  Corr %.2f",
          #ln, #pp, rf[0], rf[1], rf[2], rf[3], rf[4]);
  txt(38, 744, #v);
);

// ---- frame setup ----------------------------------------------------------------
// scale the whole 1020x800 layout to fill the window (letterboxed, centred)
gsc = max(0.35, min(gfx_w/1020, gfx_h/800));
ox = floor((gfx_w - 1020*gsc)*0.5); oy = floor((gfx_h - 800*gsc)*0.5);
mxs = (mouse_x - ox)/gsc; mys = (mouse_y - oy)/gsc;
gfx_setfont(1, "Orbitron", max(8, floor(15*gsc + 0.5)), 'b');
gfx_setfont(2, "Arial", max(8, floor(14*gsc + 0.5)));
gfx_setfont(3, "Arial", max(8, floor(13*gsc + 0.5)), 'b');
gfx_setfont(4, "Orbitron", max(12, floor(44*gsc + 0.5)), 'b');
gfx_setfont(5, "Orbitron", max(10, floor(24*gsc + 0.5)), 'b');

// CRT chassis: full-window background + scanlines + bezel (same family as Mixing Suite)
col(0.022, 0.028, 0.038); gfx_rect(0, 0, gfx_w, gfx_h);
col(0.028, 0.035, 0.047);
sl = 0; loop(floor(gfx_h/4) + 1, gfx_rect(0, sl, gfx_w, 1); sl += 4; );
col(0.00, 0.40, 0.36); gfx_rect(0, 0, gfx_w, gfx_h, 0); gfx_rect(1, 1, gfx_w - 2, gfx_h - 2, 0);
col(0.10, 0.12, 0.17); gfx_rect(2, 2, gfx_w - 4, gfx_h - 4, 0); gfx_rect(3, 3, gfx_w - 6, gfx_h - 6, 0);

// header bar: Sankofa sigil far left as part of the name
col(0.050, 0.060, 0.098); rct(10, 8, 1000, 54);
col(0.00, 0.50, 0.46); rcto(10, 8, 1000, 54);
draw_sankofa(44, 35, 38);
gfx_setfont(5); col(0.00, 0.96, 0.83); txt(78, 12, "SANKOFA ORACLE");
gfx_setfont(3); col(1.00, 0.72, 0.02); txt(78, 42, "ASSESSMENT MATRIX  /  REFERENCE MATCH ANALYZER");

pn = preset_name(pidx_eff, #pname);
using_cap = (slider3 == 1 && cap_valid);
using_lib = (slider3 == 2);
lib_name(clampv(floor(slider9 + 0.5), 0, 21), #lname);
sprintf(#hdr, "Reference: %s   |   Source: %s   |   Stage: %s",
  using_cap ? "CAPTURED REFERENCE" : (using_lib ? #lname : #pname),
  using_lib ? "Reference Library" : ((slider1 == 0 && gmem[1000] == 1) ? "Mixing Suite (live)" : "Manual"),
  slider4 ? "MASTER" : "MIX BUS");
gfx_setfont(2); col(0.60, 0.65, 0.75); txt(24, 66, #hdr);

tmx = 0; s_i = 0;
loop(6, tm = 0; b_i = 0; loop(7, tm = max(tm, abs(TT[s_i*7 + b_i])); b_i += 1; ); tm = max(tm, abs(TW[s_i])); TMV[s_i] = tm; s_i += 1; );
sprintf(#trm, "AUTO-CORRECT %s | trim D%.1f G%.1f B%.1f V%.1f gsc%.1f", slider7 ? "ON" : "OFF", TMV[0], TMV[1], TMV[2], TMV[3], TMV[4]);
col(0.03, 0.04, 0.07); rct(480, 20, 296, 30);
slider7 ? col(0.20, 0.92, 0.62) : col(0.38, 0.42, 0.55); rcto(480, 20, 296, 30);
gfx_setfont(3); slider7 ? col(0.20, 0.92, 0.62) : col(0.60, 0.65, 0.75); txt(490, 28, #trm);
btn(794, 20, 206, 30, ui_view ? "< BACK TO MATRIX" : "REFERENCE LIBRARY >", ui_view) ? ( ui_view = !ui_view; );

ui_view == 1 ? ( draw_library(); ) : (
// ---- score card -------------------------------------------------------------------
card(24, 86, 300, 200, slider10 ? "MATCH SCORE [RAW AUDIT]" : "MATCH SCORE", slider10 ? 1.00 : 0.00, slider10 ? 0.40 : 0.96, slider10 ? 0.20 : 0.83);
btn(164, 92, 150, 22, slider10 ? "⚡ RAW AUDIT: ON" : "AUDIT RAW MIX", slider10) ? (
  slider10 = !slider10;
  slider_automate(slider10);
  reset_req = 1;
);
have_data ? (
  slider10 ? (
    col(1.00, 0.75, 0.20);
    gfx_setfont(4); sprintf(#sc, "%d", floor(overall + 0.5)); txt(44, 116, #sc);
    gfx_setfont(3); col(1.00, 0.75, 0.20); txt(150, 126, "⚡ RAW MIX BASELINE");
    col(0.70, 0.75, 0.85); txt(150, 144, "Bypassing Mix & Trims");
    btn(150, 162, 160, 18, "DONE: ENGAGE MIX >", 1) ? (
      slider10 = 0;
      slider_automate(slider10);
      reset_req = 1;
    );
  ) : (
    overall >= 85 ? col(0.20, 0.92, 0.62) : (overall >= 65 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55));
    gfx_setfont(4); sprintf(#sc, "%d", floor(overall + 0.5)); txt(44, 116, #sc);
    gfx_setfont(3); txt(150, 126, overall >= 85 ? "MATCHES REFERENCE" : (overall >= 65 ? "CLOSE - TUNE BELOW" : "OFF REFERENCE"));
    raw_captured ? (
      raw_delta = overall - raw_sc_overall;
      raw_delta >= 0 ? col(0.20, 0.92, 0.62) : col(1.00, 0.35, 0.55);
      sprintf(#raw_disp, "Raw: %d%%  |  Δ %+.1f%%", floor(raw_sc_overall + 0.5), raw_delta);
      txt(150, 146, #raw_disp);
    );
  );
  gfx_setfont(3);
  col(0.7, 0.75, 0.85); txt(40, 172, "Tonal");   fill_bar(110, 172, 180, 10, sc_tonal/100, (100 - sc_tonal)/20);
  txt(40, 192, "Stereo");  fill_bar(110, 192, 180, 10, sc_stereo/100, (100 - sc_stereo)/20);
  stage_txt = slider4 ? "Dynamics" : "Dyn (norm)";
  txt(40, 212, stage_txt); fill_bar(110, 212, 180, 10, sc_dyn/100, (100 - sc_dyn)/20);
  vox_act ? (
    txt(40, 232, "Vocal Pkt"); fill_bar(110, 232, 180, 10, sc_vox/100, (100 - sc_vox)/20);
  );
) : (
  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(44, 130, "WAITING FOR AUDIO...");
  txt(44, 154, "Press play. Needs >1 s of signal.");
);

// ---- tonal card ------------------------------------------------------------------
card(340, 86, 656, 262, "TONAL BALANCE  (energy share %, dev in dB: right = too much)", 1.00, 0.85, 0.30);
gfx_setfont(3); col(0.5, 0.55, 0.68);
txt(356, 122, "BAND"); txt(500, 122, "LIVE"); txt(570, 122, "REF"); txt(640, 122, "DEV dB"); txt(730, 122, "<  too little   |   too much  >");
i = 0;
loop(7,
  y = 144 + i*29;
  band_label(i, #bl);
  gfx_setfont(2); col(0.85, 0.9, 1.0); txt(356, y, #bl);
  have_data ? (
    sprintf(#v, "%.1f%%", LV[6+i]); txt(500, y, #v);
    col(0.6, 0.65, 0.75); sprintf(#v, "%.1f%%", ref_ptr[6+i]); txt(570, y, #v);
    status_col(DEVF[i]); sprintf(#v, "%+.1f", DV[i]); txt(640, y, #v);
    dev_bar(730, y + 1, 250, 16, DV[i], 6, DEVF[i]);
  );
  i += 1;
);

// ---- width card -------------------------------------------------------------------
card(340, 360, 656, 262, "STEREO WIDTH  (side/mid ratio per band)", 0.75, 0.45, 1.00);
gfx_setfont(3); col(0.5, 0.55, 0.68);
txt(356, 396, "BAND"); txt(500, 396, "LIVE"); txt(570, 396, "REF"); txt(640, 396, "DIFF"); txt(730, 396, "<  too narrow   |   too wide  >");
i = 0;
loop(7,
  y = 418 + i*29;
  band_label(i, #bl);
  gfx_setfont(2); col(0.85, 0.9, 1.0); txt(356, y, #bl);
  have_data ? (
    sprintf(#v, "%.2f", LV[13+i]); txt(500, y, #v);
    col(0.6, 0.65, 0.75); sprintf(#v, "%.2f", ref_ptr[13+i]); txt(570, y, #v);
    status_col(DEVF[7+i]); sprintf(#v, "%+.2f", DV[7+i]); txt(640, y, #v);
    dev_bar(730, y + 1, 250, 16, DV[7+i], 0.6, DEVF[7+i]);
  );
  i += 1;
);

// ---- dynamics & suite health card ---------------------------------------------------------
card(24, 298, 300, 186, slider4 ? "LOUDNESS & DYNAMICS (MASTER)" : "LOUDNESS & BUS DYNAMICS (NORM)", 1.00, 0.35, 0.55);
gfx_setfont(3); col(0.5, 0.55, 0.68); txt(38, 326, "METRIC"); txt(126, 326, "LIVE"); txt(186, 326, "REF"); txt(246, 326, "DEV");
have_data ? (
  // Row 0: LUFS-I
  gfx_setfont(2); col(0.85, 0.9, 1.0); txt(38, 344, "LUFS-I");
  sprintf(#v, "%.1f", LV[0]); txt(126, 344, #v);
  ref_lufs = slider4 ? ref_ptr[0] : expected_mix_lufs;
  col(0.6, 0.65, 0.75); sprintf(#v, "%.1f", ref_lufs); txt(186, 344, #v);
  status_col(DEVF[14]); sprintf(#v, "%+.1f", DV[14]); txt(246, 344, #v);

  // Row 1: PLR dB
  col(0.85, 0.9, 1.0); txt(38, 363, "PLR dB");
  sprintf(#v, "%.1f", LV[1]); txt(126, 363, #v);
  ref_plr = slider4 ? ref_ptr[1] : expected_mix_plr;
  col(0.6, 0.65, 0.75); sprintf(#v, "%.1f", ref_plr); txt(186, 363, #v);
  status_col(DEVF[15]); sprintf(#v, "%+.1f", DV[15]); txt(246, 363, #v);

  // Row 2: Crest dB
  col(0.85, 0.9, 1.0); txt(38, 382, "Crest dB");
  sprintf(#v, "%.1f", LV[2]); txt(126, 382, #v);
  col(0.6, 0.65, 0.75); sprintf(#v, "%.1f", ref_ptr[2]); txt(186, 382, #v);
  status_col(DEVF[16]); sprintf(#v, "%+.1f", DV[16]); txt(246, 382, #v);

  // Row 3: Correl.
  col(0.85, 0.9, 1.0); txt(38, 401, "Correl.");
  sprintf(#v, "%.2f", LV[4]); txt(126, 401, #v);
  col(0.6, 0.65, 0.75); sprintf(#v, "%.2f", ref_ptr[4]); txt(186, 401, #v);
  status_col(DEVF[18]); sprintf(#v, "%+.2f", DV[18]); txt(246, 401, #v);

  // Row 4: Vocal Pocket (Lead vs Master RMS)
  col(0.85, 0.9, 1.0); txt(38, 420, "Vox Pkt");
  vox_act ? (
    sprintf(#v, "%+.1f", vox_rel_mst); txt(126, 420, #v);
    col(0.6, 0.65, 0.75); sprintf(#v, "%+.1f", vox_target); txt(186, 420, #v);
    d_v = abs(vox_dv) <= 1.5 ? 1 : (abs(vox_dv) <= 3.0 ? 2 : 3);
    status_col(d_v); sprintf(#v, "%+.1f", vox_dv); txt(246, 420, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(126, 420, "--"); txt(186, 420, "-6.5"); txt(246, 420, "off");
  );

  // Row 5: Kick/Sub Interlock (Phase Correlation)
  col(0.85, 0.9, 1.0); txt(38, 439, "Kick/Sub");
  bass_act ? (
    sprintf(#v, "%.2f", sub_corr); txt(126, 439, #v);
    col(0.6, 0.65, 0.75); txt(186, 439, ">+0.3");
    sub_corr >= 0.30 ? col(0.20, 0.92, 0.62) : (sub_corr >= 0.0 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55));
    txt(246, 439, sub_corr >= 0.30 ? "LOCK" : (sub_corr >= 0 ? "SOFT" : "PHASE"));
  ) : (
    col(0.5, 0.55, 0.68); txt(126, 439, "--"); txt(186, 439, ">+0.3"); txt(246, 439, "off");
  );

  // Row 6: Drum Shell Crest (Transient Impact)
  col(0.85, 0.9, 1.0); txt(38, 458, "Drm Punch");
  drum_act ? (
    sprintf(#v, "%.1fdB", drum_crest); txt(126, 458, #v);
    col(0.6, 0.65, 0.75); txt(186, 458, "9.5dB");
    d_c = abs(drum_crest - 9.5) <= 2.0 ? 1 : 2;
    status_col(d_c); sprintf(#v, "%+.1f", drum_crest - 9.5); txt(246, 458, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(126, 458, "--"); txt(186, 458, "9.5"); txt(246, 458, "off");
  );
);

// ---- action card ------------------------------------------------------------------------------
mir_status = gmem[1090];
card(24, 662, 972, 130, "WHAT TO ADJUST  (MAPPED TO SUITES)", 0.20, 0.92, 0.62);

// Status Badge (Top Right of Card Header)
mir_status == 3 ? (
  col(0.00, 0.25, 0.22); rct(692, 666, 290, 18);
  col(0.00, 0.96, 0.83); rcto(692, 666, 290, 18);
  gfx_setfont(3); col(0.00, 0.96, 0.83); txt(704, 669, "⚡ OLLAMA MIR: STEM DNA SYNCED");
) : (
  col(0.06, 0.08, 0.12); rct(712, 666, 270, 18);
  col(0.35, 0.40, 0.50); rcto(712, 666, 270, 18);
  gfx_setfont(3); col(0.55, 0.60, 0.70); txt(724, 669, "MIR OFFLINE: HEURISTIC MODE");
);

// Dynamic strings for live telemetry
bass_act ? sprintf(#sc_txt, "%+.2f", sub_corr) : strcpy(#sc_txt, "--");
drum_act ? sprintf(#dc_txt, "%.1fdB", drum_crest) : strcpy(#dc_txt, "--");
vox_act ? sprintf(#vx_txt, "%+.1fdB", vox_rel_mst) : strcpy(#vx_txt, "--");

using_cap ? strcpy(#ref_disp, "Captured Ref") :
using_lib ? strcpy(#ref_disp, #lname) :
            strcpy(#ref_disp, #pname);

// Critic LLM Dedicated Callout Container (Dynamically updated live telemetry)
mir_status == 3 ? (
  col(0.015, 0.09, 0.12); rct(36, 688, 948, 22);
  col(0.00, 0.65, 0.58); rcto(36, 688, 948, 22);
  col(0.00, 0.96, 0.83); rct(36, 688, 4, 22);
  gfx_setfont(3); col(0.00, 0.96, 0.83);
  sprintf(#critic_msg, "CRITIC LLM [%s]: Sub Phase %s | Snare Crest %s | Vocal Pocket %s | DNA Match %d%%",
          #ref_disp, #sc_txt, #dc_txt, #vx_txt, floor(overall + 0.5));
  txt(46, 692, #critic_msg);
) : (
  col(0.04, 0.05, 0.08); rct(36, 688, 948, 22);
  col(0.25, 0.30, 0.40); rcto(36, 688, 948, 22);
  col(0.40, 0.45, 0.55); rct(36, 688, 4, 22);
  gfx_setfont(3); col(0.55, 0.60, 0.70);
  sprintf(#critic_msg, "HEURISTIC ENGINE ACTIVE [%s] | Sub Phase %s | Drum Crest %s | Vocal Pocket %s",
          #ref_disp, #sc_txt, #dc_txt, #vx_txt);
  txt(46, 692, #critic_msg);
);

// Recommendations List (Dynamically Spaced & Vertically Centered)
num_recs = 0;
i = 0;
loop(4,
  RC[i] >= 0 && have_data ? ( num_recs += 1; );
  i += 1;
);

gfx_setfont(2);
num_recs == 1 ? (
  y_start = 732; line_h = 22;
) : num_recs == 2 ? (
  y_start = 724; line_h = 24;
) : num_recs == 3 ? (
  y_start = 716; line_h = 20;
) : (
  y_start = 714; line_h = 18;
);

i = 0; shown = 0;
loop(min(num_recs, 4),
  RC[i] >= 0 && have_data ? (
    rec_text(RC[i], #rt);
    i == 0 ? col(1.00, 0.40, 0.55) : (i == 1 ? col(1.00, 0.85, 0.30) : col(0.70, 0.85, 1.00));
    sprintf(#line, "%d.  %s", i + 1, #rt);
    txt(44, y_start + shown*line_h, #line);
    shown += 1;
  );
  i += 1;
);
have_data && shown == 0 ? ( col(0.20, 0.92, 0.62); gfx_setfont(2); txt(44, 734, "All measured bands and dynamics are within tolerance of the reference."); );
!have_data ? ( col(0.60, 0.65, 0.75); gfx_setfont(2); txt(44, 734, "Play the mix or master through this plugin to populate the matrix."); );

// ---- controls ---------------------------------------------------------------------------------------
btn(24, 496, 142, 28, "RESET ANALYSIS", 0) ? ( reset_req = 1; );
btn(182, 496, 142, 28, slider5 ? "HELD (click: run)" : "RUNNING", slider5 == 0) ? ( slider5 = !slider5; slider_automate(slider5); );
btn(24, 532, 142, 28, mir_status == 2 ? "⚡ ANALYZING..." : (mir_status == 3 ? "⚡ STEM DNA LOADED" : "⚡ DECONSTRUCT REF"), mir_status == 3) ? (
  gmem[1090] = 1;
);
btn(182, 532, 142, 28, "CAPTURE REF", 0) && have_data ? (
  ci = 0; loop(20, CAP[ci] = LV[ci]; ci += 1; ); CAP[31] = 1; cap_valid = 1; slider3 = 1; slider_automate(slider3);
);
btn(24, 568, 142, 28, slider4 ? "STAGE: MASTER" : "STAGE: MIX BUS", slider4) ? ( slider4 = !slider4; slider_automate(slider4); );
btn(182, 568, 142, 28, slider1 ? "PRESET: MANUAL" : "PRESET: FOLLOW MIX", slider1 == 0) ? ( slider1 = !slider1; slider_automate(slider1); );
btn(24, 604, 68, 24, "< PREV", 0) ? ( slider1 = 1; slider2 = (slider2 + 21) % 22; slider_automate(slider1); slider_automate(slider2); );
btn(100, 604, 68, 24, "NEXT >", 0) ? ( slider1 = 1; slider2 = (slider2 + 1) % 22; slider_automate(slider1); slider_automate(slider2); );
btn(182, 604, 142, 24, slider6 ? "AUTO-RESET: ON" : "AUTO-RESET: OFF", slider6) ? ( slider6 = !slider6; slider_automate(slider6); );

btn(24, 636, 142, 24, slider7 ? "AUTO-CORRECT: ON" : "AUTO-CORRECT: OFF", slider7) ? ( slider7 = !slider7; slider_automate(slider7); );
btn(182, 636, 142, 24, "CLEAR TRIMS", 0) ? ( ci = 0; loop(42, TT[ci] = 0; ci += 1; ); ci = 0; loop(6, TW[ci] = 0; ci += 1; ); );
);
// corner bolts
bx = 0; loop(4,
  bxx = (bx % 2) ? gfx_w - 14 : 14; byy = bx > 1 ? gfx_h - 14 : 14;
  col(0.16, 0.19, 0.25); gfx_circle(bxx, byy, 6, 1);
  col(0.45, 0.50, 0.60); gfx_circle(bxx, byy, 6, 0);
  col(0.05, 0.06, 0.09); gfx_circle(bxx, byy, 2, 1);
  bx += 1;
);
last_mc = mouse_cap;
