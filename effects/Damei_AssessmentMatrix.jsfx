  col(0.85, 0.90, 1.00);
  txt(350, 142, "HARDWARE: NVIDIA GeForce RTX 3060 (12GB VRAM DirectML/CUDA)");
  col(1.00, 0.75, 0.20);
  txt(750, 142, "DNA SYNC: ACTIVE (gmem[1090]=3)");

  // Left Panel: Registered & Available AI Models
  card(38, 178, 480, 500, "AVAILABLE MODELS (OLLAMA & HUGGINGFACE)", 0.75, 0.45, 1.00);
  
  y_m = 210;
