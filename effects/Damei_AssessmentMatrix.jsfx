// ---- dynamics & suite health card ---------------------------------------------------------
card(24, 298, 300, 186, slider4 ? "LOUDNESS & DYNAMICS (MASTER)" : "LOUDNESS & BUS DYNAMICS (NORM)", 1.00, 0.35, 0.55);
gfx_setfont(3); col(0.5, 0.55, 0.68); txt(36, 326, "METRIC"); txt(114, 326, "LIVE"); txt(178, 326, "REF"); txt(244, 326, "DEV");
have_data ? (
  // Row 0: LUFS-I
  gfx_setfont(2); col(0.85, 0.9, 1.0); txt(36, 344, "LUFS-I");
  sprintf(#v, "%.1f", LV[0]); txt(114, 344, #v);
  ref_lufs = slider4 ? ref_ptr[0] : expected_mix_lufs;
  col(0.6, 0.65, 0.75); sprintf(#v, "%.1f", ref_lufs); txt(178, 344, #v);
  status_col(DEVF[14]); sprintf(#v, "%+.1f", DV[14]); txt(244, 344, #v);

  // Row 1: PLR dB
  col(0.85, 0.9, 1.0); txt(36, 363, "PLR dB");
  sprintf(#v, "%.1f", LV[1]); txt(114, 363, #v);
  ref_plr = slider4 ? ref_ptr[1] : expected_mix_plr;
  col(0.6, 0.65, 0.75); sprintf(#v, "%.1f", ref_plr); txt(178, 363, #v);
  status_col(DEVF[15]); sprintf(#v, "%+.1f", DV[15]); txt(244, 363, #v);

  // Row 2: Crest dB
  col(0.85, 0.9, 1.0); txt(36, 382, "Crest dB");
  sprintf(#v, "%.1f", LV[2]); txt(114, 382, #v);
  col(0.6, 0.65, 0.75); sprintf(#v, "%.1f", ref_ptr[2]); txt(178, 382, #v);
  status_col(DEVF[16]); sprintf(#v, "%+.1f", DV[16]); txt(244, 382, #v);

  // Row 3: Correl.
  col(0.85, 0.9, 1.0); txt(36, 401, "Correl.");
  sprintf(#v, "%.2f", LV[4]); txt(114, 401, #v);
  col(0.6, 0.65, 0.75); sprintf(#v, "%.2f", ref_ptr[4]); txt(178, 401, #v);
  status_col(DEVF[18]); sprintf(#v, "%+.2f", DV[18]); txt(244, 401, #v);

  // Row 4: Vocal Pocket (Lead vs Master RMS)
  col(0.85, 0.9, 1.0); txt(36, 420, "Vox Pkt");
  vox_act ? (
    sprintf(#v, "%+.1f", vox_rel_mst); txt(114, 420, #v);
    col(0.6, 0.65, 0.75); sprintf(#v, "%+.1f", vox_target); txt(178, 420, #v);
    d_v = abs(vox_dv) <= 1.5 ? 1 : (abs(vox_dv) <= 3.0 ? 2 : 3);
    status_col(d_v); sprintf(#v, "%+.1f", vox_dv); txt(244, 420, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(114, 420, "--"); txt(178, 420, "-6.5"); txt(244, 420, "off");
  );

  // Row 5: Kick/Sub Interlock (Phase Correlation)
  col(0.85, 0.9, 1.0); txt(36, 439, "Kick/Sub");
  bass_act ? (
    sprintf(#v, "%.2f", sub_corr); txt(114, 439, #v);
    col(0.6, 0.65, 0.75); txt(178, 439, ">+0.3");
    sub_corr >= 0.30 ? col(0.20, 0.92, 0.62) : (sub_corr >= 0.0 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55));
    txt(244, 439, sub_corr >= 0.30 ? "LOCK" : (sub_corr >= 0 ? "SOFT" : "PHASE"));
  ) : (
    col(0.5, 0.55, 0.68); txt(114, 439, "--"); txt(178, 439, ">+0.3"); txt(244, 439, "off");
  );

  // Row 6: Drum Shell Crest (Transient Impact)
  col(0.85, 0.9, 1.0); txt(36, 458, "Drm Punch");
  drum_act ? (
    sprintf(#v, "%.1fdB", drum_crest); txt(114, 458, #v);
    col(0.6, 0.65, 0.75); txt(178, 458, "9.5dB");
    d_c = abs(drum_crest - 9.5) <= 2.0 ? 1 : 2;
    status_col(d_c); sprintf(#v, "%+.1f", drum_crest - 9.5); txt(244, 458, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(114, 458, "--"); txt(178, 458, "9.5"); txt(244, 458, "off");
  );
);

