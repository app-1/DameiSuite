  col(0.04, 0.05, 0.08); rct(50, y_m, 456, 36);
  col(1.00, 0.75, 0.20); rcto(50, y_m, 456, 36);
  gfx_setfont(2); col(1.00, 0.75, 0.20);
  txt(62, y_m + 10, "HF Local Hub: HTDemucs | Qwen-Audio | MusicGen | Kokoro-82M");

  // Right Panel: Live AI Critic Diagnostic & Telemetry Reasoning
  card(526, 178, 456, 500, "LIVE AI CRITIC DIAGNOSIS & REASONING", 1.00, 0.75, 0.20);
  
  gfx_setfont(3); col(0.00, 0.96, 0.83);
  txt(540, 212, "TARGET PRODUCER BLUEPRINT: DAN BRAUNSTEIN");
  col(0.60, 0.65, 0.75); txt(540, 230, "Reference Track: Spiritbox - Keep Sweet");

  // Telemetry Badges
  col(0.06, 0.08, 0.12); rct(540, 252, 428, 140);
  col(0.20, 0.92, 0.62); rcto(540, 252, 428, 140);
  
  gfx_setfont(3);
  col(0.20, 0.92, 0.62); txt(552, 264, "✓ KICK & SUB PHASE LOCK:  +1.00 (In-Phase Constructive Lock)");
  col(0.20, 0.92, 0.62); txt(552, 290, "✓ DRUM TRANSIENT CREST:   13.6 dB (Signature Punch Crest)");
  col(0.20, 0.92, 0.62); txt(552, 316, "✓ LEAD VOCAL ANCHOR:      -6.7 dB rel Master (Pocketed)");
  col(0.20, 0.92, 0.62); txt(552, 342, "✓ MASTER LOUDNESS:        -7.1 LUFS / 6.8 dB PLR");
  col(0.20, 0.92, 0.62); txt(552, 368, "✓ ZERO-CLIP COMPLIANCE:   True Peak -0.25 dBTP (PASS)");

  // Critic Prescriptions Box
  col(0.05, 0.06, 0.09); rct(540, 404, 428, 180);
  col(0.38, 0.42, 0.55); rcto(540, 404, 428, 180);
  gfx_setfont(3); col(1.00, 0.75, 0.20); txt(552, 416, "AUTONOMOUS CRITIQUE & PRESCRIPTIONS:");
  gfx_setfont(2); col(0.85, 0.90, 1.00);
  txt(552, 442, "1. Sub fundamental is locked in-phase: 0% cancellation.");
  txt(552, 464, "2. Snare 4.8kHz crack and 200Hz body slicing through quad-guitars.");
  txt(552, 486, "3. Rhythm guitars scooped at 250Hz & 1.8kHz: zero low-mid mud.");
  txt(552, 508, "4. Master true peak clamped at -0.3 dBTP: zero inter-sample clipping.");
  txt(552, 530, "5. Commercial loudness reached without squashing dynamic transients.");
  col(0.20, 0.92, 0.62); txt(552, 556, "STATUS: Mix & Master aligned with Dan Braunstein commercial DNA.");

  // Action Buttons
  btn(540, 600, 206, 32, "[TRIGGER MIR]", 1) ? (
    gmem[1090] = 1;
  );
  btn(760, 600, 208, 32, "< RETURN TO MATRIX", 0) ? (
    ui_view = 0;
  );
  
  btn(540, 640, 206, 26, "AUDIT MASTERING", 0) ? (
    ui_view = 2;
  );
  btn(760, 640, 208, 26, "REFERENCE LIBRARY", 0) ? (
    ui_view = 1;
  );
);

function draw_stem_console() local(y_d, y_c, bar_w, cx, diff_val, corr_val, d_col) (
  card(24, 86, 972, 692, "SIDE-BY-SIDE STEM & REFERENCE COMPARATIVE CONSOLE (4-CH SIDECHAIN)", 0.00, 0.96, 0.83);

  // Top Left: 4-Channel Sidechain Routing & Monitor Controller (Zero Title Overlap)
  card(38, 118, 460, 260, "SIDECHAIN & MONITOR", 1.00, 0.85, 0.30);

  // Cleanly positioned buttons inside header boundary with ample title breathing room
  shoot_st = gmem[1094];
  shoot_lbl = shoot_st == 3 ? "[READY]" : (shoot_st == 2 ? "SETUP..." : "[1-CLICK SETUP]");
  btn(245, 122, 115, 22, shoot_lbl, shoot_st == 3) ? (
    gmem[1094] = 1;
  );

  dem_st = gmem[1095];
  dem_lbl = dem_st == 3 ? "[STEMS LOADED]" : (dem_st == 2 ? "SEPARATING..." : "[SEPARATE STEMS]");
  btn(366, 122, 124, 22, dem_lbl, dem_st == 3) ? (
    gmem[1095] = 1;
  );
  gfx_setfont(3); col(0.6, 0.65, 0.75);
  txt(52, 148, "AUDIO SOURCE");
  txt(160, 148, "INTEGRATED");
  txt(270, 148, "PEAK dBFS");
  txt(370, 148, "STATUS");

  // Mix Row
  col(0.85, 0.90, 1.00); txt(52, 170, "MIX (Pins 1/2)");
  have_data ? (
    col(0.20, 0.92, 0.62); sprintf(#v, "%.1f LUFS", LV[0]); txt(160, 170, #v);
    col(0.85, 0.90, 1.00); sprintf(#v, "%+.1f dB", pk_db); txt(270, 170, #v);
    col(0.20, 0.92, 0.62); txt(370, 170, "● ACTIVE");
  ) : (
    col(0.5, 0.55, 0.68); txt(160, 170, "--"); txt(270, 170, "--"); txt(370, 170, "○ WAITING");
  );

  // Ref Row
  col(0.85, 0.90, 1.00); txt(52, 194, "REF (Pins 3/4)");
  have_ref_data ? (
    col(0.00, 0.96, 0.83); sprintf(#v, "%.1f LUFS", int_lufs_ref); txt(160, 194, #v);
    col(0.85, 0.90, 1.00); sprintf(#v, "%+.1f dB", ref_pdb); txt(270, 194, #v);
    col(0.00, 0.96, 0.83); txt(370, 194, "● ACTIVE");
  ) : (
    col(0.5, 0.55, 0.68); txt(160, 194, "--"); txt(270, 194, "--"); txt(370, 194, "○ NO SIDECHAIN");
  );

  // Monitor Buttons
  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(52, 226, "AUDITION MONITOR:");
  btn(52, 246, 95, 26, "MIX (1/2)", slider12 == 0) ? ( slider12 = 0; slider_automate(slider12); );
  btn(152, 246, 110, 26, "REF MATCHED", slider12 == 1) ? ( slider12 = 1; slider_automate(slider12); );
  btn(267, 246, 95, 26, "REF RAW", slider12 == 2) ? ( slider12 = 2; slider_automate(slider12); );
  btn(367, 246, 115, 26, "NULL (DIFF)", slider12 == 3) ? ( slider12 = 3; slider_automate(slider12); );

  // Gain Matching status & controls
  col(0.04, 0.05, 0.08); rct(52, 282, 430, 80);
  col(0.20, 0.25, 0.35); rcto(52, 282, 430, 80);
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  sprintf(#gain_info, "Ref Gain Offset: %+.1f dB  (%s)",
          eff_ref_gain_db,
          slider14 == 1 ? "Auto LUFS-I Matched" : "Manual Trim");
  txt(62, 290, #gain_info);
  btn(62, 312, 120, 22, slider14 ? "MODE: AUTO LUFS" : "MODE: MANUAL", slider14 == 1) ? (
    slider14 = !slider14; slider_automate(slider14);
  );
  btn(190, 312, 60, 22, "-1.0 dB", 0) ? ( slider13 -= 1.0; slider14 = 0; slider_automate(slider13); slider_automate(slider14); );
  btn(256, 312, 60, 22, "+1.0 dB", 0) ? ( slider13 += 1.0; slider14 = 0; slider_automate(slider13); slider_automate(slider14); );
  btn(322, 312, 60, 22, "RESET 0", 0) ? ( slider13 = 0.0; slider_automate(slider13); );
  gfx_setfont(2); col(0.55, 0.60, 0.70);
  txt(62, 342, "Null Diff isolates exact structural & spectral balance mismatches.");

  // Top Right: Stem Target Profile & Dynamic Punch Index (Zero Title Overlap)
  card(518, 118, 464, 260, "STEM PROFILE & PUNCH", 0.75, 0.45, 1.00);
  cal_st = gmem[1159];
  cal_lbl = cal_st == 1 ? "[STATIC LOCKED]" : "[APPLY CAL]";
  btn(830, 122, 140, 22, cal_lbl, cal_st == 1) ? (
    gmem[1096] = 1;
  );
  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(532, 148, "TARGET STEM PROFILE:");
  btn(532, 168, 85, 24, "MASTER", slider11 == 0) ? ( slider11 = 0; slider_automate(slider11); );
  btn(622, 168, 80, 24, "DRUMS", slider11 == 1) ? ( slider11 = 1; slider_automate(slider11); );
  btn(707, 168, 75, 24, "BASS", slider11 == 2) ? ( slider11 = 2; slider_automate(slider11); );
  btn(787, 168, 85, 24, "VOCALS", slider11 == 3) ? ( slider11 = 3; slider_automate(slider11); );
  btn(877, 168, 90, 24, "SYNTH/FX", slider11 == 4) ? ( slider11 = 4; slider_automate(slider11); );

  // Punch Index & Crest
  col(0.6, 0.65, 0.75); txt(532, 206, "LOW-END PUNCH (20-250 Hz CREST):");
  have_data ? (
    col(0.85, 0.90, 1.00); sprintf(#v, "Mix: %.1f dB", punch_mix_db); txt(532, 226, #v);
    have_ref_data ? (
      sprintf(#v, "Ref: %.1f dB", punch_ref_db); txt(650, 226, #v);
      abs(punch_delta) <= 1.5 ? col(0.20, 0.92, 0.62) : (punch_delta < -1.5 ? col(1.00, 0.35, 0.55) : col(1.00, 0.85, 0.30));
      sprintf(#v, "Delta: %+.1f dB (%s)", punch_delta, punch_delta < -1.5 ? "OVER-LIMITED" : (punch_delta > 1.5 ? "MORE PUNCH" : "MATCHED"));
      txt(760, 226, #v);
    ) : (
      col(0.5, 0.55, 0.68); txt(650, 226, "Ref: --");
    );
  ) : (
    col(0.5, 0.55, 0.68); txt(532, 226, "Waiting for audio...");
  );

  // Spectral Tilt
  col(0.6, 0.65, 0.75); txt(532, 258, "CONTINUOUS SPECTRAL TILT (dB/OCT):");
  have_data ? (
    col(0.85, 0.90, 1.00); sprintf(#v, "Mix: %+.2f dB/oct", tilt_mix); txt(532, 278, #v);
    sprintf(#v, "Ref: %+.2f dB/oct", tilt_ref); txt(670, 278, #v);
    abs(tilt_delta) <= 0.8 ? col(0.20, 0.92, 0.62) : (tilt_delta > 0.8 ? col(1.00, 0.75, 0.20) : col(0.35, 0.85, 1.00));
    sprintf(#v, "Delta: %+.2f (%s)", tilt_delta, tilt_delta > 0.8 ? "BRIGHTER" : (tilt_delta < -0.8 ? "DARKER" : "BALANCED"));
    txt(800, 278, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(532, 278, "Waiting for audio...");
  );

  // Full Crest Factor
  col(0.6, 0.65, 0.75); txt(532, 310, "FULL-BAND DYNAMICS (CREST / PLR):");
  col(0.00, 0.96, 0.83);
  have_data ? (
    sprintf(#v, "Mix Crest: %.1f dB  |  Ref Crest: %.1f dB  |  PLR: %.1f dB", LV[2], ref_ptr[2], LV[1]);
    txt(532, 330, #v);
  ) : (
    txt(532, 330, "--");
  );

  // Bottom Left: 7-Band Live Spectral Delta Matrix
  card(38, 394, 460, 360, "7-BAND LIVE SPECTRAL DELTA (MIX vs REF)", 1.00, 0.85, 0.30);
  gfx_setfont(3); col(0.5, 0.55, 0.68);
  txt(52, 424, "BAND"); txt(145, 424, "MIX %"); txt(205, 424, "REF %"); txt(265, 424, "DIFF dB"); txt(345, 424, "< REF louder | MIX louder >");
  i = 0;
  loop(7,
    y_d = 448 + i*40;
    band_label(i, #bl);
    gfx_setfont(2); col(0.85, 0.9, 1.0); txt(52, y_d, #bl);
    have_data ? (
      sprintf(#v, "%.1f%%", LV[6+i]); txt(145, y_d, #v);
      col(0.6, 0.65, 0.75); sprintf(#v, "%.1f%%", ref_ptr[6+i]); txt(205, y_d, #v);
      diff_val = (slider3 == 3 && have_ref_data) ? BAND_DIFF[i] : DV[i];
      status_col(abs(diff_val)/1.5); sprintf(#v, "%+.1f", diff_val); txt(265, y_d, #v);
      dev_bar(335, y_d + 1, 150, 16, diff_val, 6.0, abs(diff_val)/1.5);
    );
    i += 1;
  );

  // Bottom Right: Multi-Band Phase Coherence & Stereo Alignment
  card(518, 394, 464, 360, "PHASE COHERENCE & SEPARATION ARTIFACTS", 0.20, 0.92, 0.62);
  gfx_setfont(3); col(0.5, 0.55, 0.68);
  txt(532, 424, "BAND"); txt(625, 424, "INTER-TRACK PHASE"); txt(760, 424, "WIDTH MIX/REF"); txt(885, 424, "COHERENCE");
  i = 0;
  loop(7,
    y_c = 448 + i*40;
    band_label(i, #bl);
    gfx_setfont(2); col(0.85, 0.9, 1.0); txt(532, y_c, #bl);
    have_data ? (
      corr_val = have_ref_data ? BAND_XCORR[i] : LV[4];
      corr_val >= 0.5 ? col(0.20, 0.92, 0.62) : (corr_val >= 0.0 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55));
      sprintf(#v, "%+.2f", corr_val); txt(640, y_c, #v);
      dev_bar(685, y_c + 1, 65, 14, corr_val, 1.0, corr_val >= 0.5 ? 1 : (corr_val >= 0 ? 2 : 3));
      col(0.70, 0.75, 0.85); sprintf(#v, "%.2f / %.2f", LV[13+i], ref_ptr[13+i]); txt(760, y_c, #v);
      corr_val >= 0.5 ? ( col(0.20, 0.92, 0.62); txt(885, y_c, "IN-PHASE"); ) :
      (corr_val >= 0.0 ? ( col(1.00, 0.85, 0.30); txt(885, y_c, "DIFFUSE"); ) :
      ( col(1.00, 0.35, 0.55); txt(885, y_c, "OPPOSITION!"); ));
    );
    i += 1;
  );
);


ui_view == 5 ? ( draw_producer_dna(); ) : (
