// ---- DSP helpers ---------------------------------------------------------------
function clampv(x, lo, hi) ( x < lo ? lo : (x > hi ? hi : x); );

function bqrun(c, s, x) local(y) (
  y = c[0]*x + s[0];
  s[0] = c[1]*x - c[3]*y + s[1];
  s[1] = c[2]*x - c[4]*y;
  y;
);

function bq_design(c, hp, fc, q) local(w0, cs, al, a0, b0, b1) (
  w0 = 2*$pi*fc/srate; cs = cos(w0); al = sin(w0)/(2*q); a0 = 1 + al;
  hp ? ( b0 = (1+cs)*0.5; b1 = -(1+cs); ) : ( b0 = (1-cs)*0.5; b1 = 1-cs; );
  c[0] = b0/a0; c[1] = b1/a0; c[2] = b0/a0; c[3] = -2*cs/a0; c[4] = (1-al)/a0;
);

function hist_pct(base, nb, tot, frac) local(i, c, tg) (
  tg = tot*frac; c = 0; i = 0;
  while (i < nb-1 && c + base[i] < tg) ( c += base[i]; i += 1; );
  i;
);

// ---- band + K-weight setup ---------------------------------------------------
EDG[0]=20; EDG[1]=60; EDG[2]=250; EDG[3]=800; EDG[4]=2500; EDG[5]=6000; EDG[6]=10000; EDG[7]=18000;
b = 0;
loop(7,
  bq_design(BQC + (b*2)*5,   1, EDG[b], 0.70710678);
  bq_design(BQC + (b*2+1)*5, 0, min(EDG[b+1], srate*0.45), 0.70710678);
  b += 1;
);

// K-weighting (ITU-R BS.1770, same maths as pyloudnorm)
kA = pow(10, 3.999843853973347/40); kw0 = 2*$pi*1681.9744509555319/srate;
kal = sin(kw0)/(2*0.7071752369554196); kcs = cos(kw0); ksA = sqrt(kA);
ka0 = (kA+1) - (kA-1)*kcs + 2*ksA*kal;
KC[0] = kA*((kA+1) + (kA-1)*kcs + 2*ksA*kal)/ka0;
KC[1] = -2*kA*((kA-1) + (kA+1)*kcs)/ka0;
KC[2] = kA*((kA+1) + (kA-1)*kcs - 2*ksA*kal)/ka0;
KC[3] = 2*((kA-1) - (kA+1)*kcs)/ka0;
KC[4] = ((kA+1) - (kA-1)*kcs - 2*ksA*kal)/ka0;
kK = tan($pi*38.13547087613982/srate); kQ = 0.5003270373253953;
kh0 = 1 + kK/kQ + kK*kK;
KC[5] = 1; KC[6] = -2; KC[7] = 1;
KC[8] = 2*(kK*kK - 1)/kh0; KC[9] = (1 - kK/kQ + kK*kK)/kh0;

blk_len = floor(0.1*srate);

// ---- Stem target profile fingerprints (5 profiles x 32 slots) -----------------
// layout per slot block: 0 lufs 1 plr 2 crest 3 lra 4 corr 5 width | 6..12 band % | 13..19 band S/M width | 31 has-reference
// 0: Full Master
p = STEM_FP + 0*32; p[0]=-6.0; p[1]=6.0; p[2]=9.8; p[3]=6.5; p[4]=0.55; p[5]=0.52; p[6]=15.5; p[7]=35.0; p[8]=19.0; p[9]=19.5; p[10]=8.0; p[11]=2.1; p[12]=0.9; p[13]=0.16; p[14]=0.39; p[15]=0.66; p[16]=0.70; p[17]=0.74; p[18]=0.70; p[19]=0.67; p[31]=1;
// 1: Drums (Kick/Snare/Toms/Cymbals - strong sub/low transient attack)
p = STEM_FP + 1*32; p[0]=-8.5; p[1]=9.5; p[2]=13.2; p[3]=7.5; p[4]=0.65; p[5]=0.45; p[6]=18.0; p[7]=40.0; p[8]=16.0; p[9]=14.0; p[10]=7.5; p[11]=3.5; p[12]=1.0; p[13]=0.10; p[14]=0.25; p[15]=0.55; p[16]=0.65; p[17]=0.75; p[18]=0.80; p[19]=0.78; p[31]=1;
// 2: Bass (Sub & 808 fundamental - dense, mono anchor)
p = STEM_FP + 2*32; p[0]=-9.0; p[1]=6.0; p[2]=7.5; p[3]=4.0; p[4]=0.98; p[5]=0.08; p[6]=38.0; p[7]=46.0; p[8]=12.0; p[9]=3.5; p[10]=0.5; p[11]=0.0; p[12]=0.0; p[13]=0.02; p[14]=0.05; p[15]=0.15; p[16]=0.20; p[17]=0.20; p[18]=0.10; p[19]=0.05; p[31]=1;
// 3: Vocals (Lead & BVs - presence and dynamic crest)
p = STEM_FP + 3*32; p[0]=-10.5; p[1]=7.5; p[2]=11.0; p[3]=8.5; p[4]=0.80; p[5]=0.35; p[6]=0.5; p[7]=6.5; p[8]=25.0; p[9]=38.0; p[10]=21.0; p[11]=6.5; p[12]=2.5; p[13]=0.05; p[14]=0.20; p[15]=0.35; p[16]=0.45; p[17]=0.55; p[18]=0.65; p[19]=0.60; p[31]=1;
// 4: Other / Synth / Guitars (Walls of sound, wide imaging)
p = STEM_FP + 4*32; p[0]=-9.5; p[1]=6.8; p[2]=9.2; p[3]=6.0; p[4]=0.40; p[5]=0.65; p[6]=2.0; p[7]=16.0; p[8]=28.0; p[9]=28.0; p[10]=16.0; p[11]=7.5; p[12]=2.5; p[13]=0.15; p[14]=0.45; p[15]=0.70; p[16]=0.78; p[17]=0.80; p[18]=0.78; p[19]=0.75; p[31]=1;

function reset_all() local(i) (
  i = 0; loop(14,  ACC[i] = 0; i += 1; );
  i = 0; loop(400, HSTG[i] = 0;  i += 1; );
  i = 0; loop(120, HS[i] = 0;  i += 1; );
  i = 0; loop(30,  RB[i] = 0;  i += 1; );
  i = 0; loop(56,  BQS[i] = 0; i += 1; );
  i = 0; loop(8,   KS[i] = 0;  i += 1; );
  blk_pow = 0; blk_n = 0; rpos = 0; rcount = 0;
  sum_m2 = 0; sum_s2 = 0; sLR = 0; sLL = 0; sRR = 0; pk = 0; tot_n = 0;
  true_pk = 0; true_pk_l = 0; true_pk_r = 0;
  lufs_m = -70; lufs_m_max = -70;
  lufs_s = -70; lufs_s_max = -70;
  sum_l = 0; sum_r = 0; sum_mono2 = 0;
  isp_overs = 0;
  isp_l_p1 = 0; isp_l_p2 = 0; isp_r_p1 = 0; isp_r_p2 = 0;
  have_data = 0;
  i = 0; loop(14, BA[i] = 0; EM[i] = 0; i += 1; );
  ema_n = 0;
  // Always clear runaway trims on transport start/reset
  i = 0; loop(42, TT[i] = 0; i += 1; );
  i = 0; loop(6, TW[i] = 0; i += 1; );
  ED = 0;

  // Reference & Sidechain Resets
  i = 0; loop(56, BQS_REF[i] = 0; i += 1; );
  i = 0; loop(8,  KS_REF[i] = 0;  i += 1; );
  i = 0; loop(14, ACC_REF[i] = 0; BA_REF[i] = 0; i += 1; );
  i = 0; loop(30, RB_REF[i] = 0; i += 1; );
  i = 0; loop(400, HSTG_REF[i] = 0; i += 1; );
  i = 0; loop(120, HS_REF[i] = 0; i += 1; );
  i = 0; loop(7, ACC_XCORR[i] = 0; BAND_XCORR[i] = 0; BAND_DIFF[i] = 0; i += 1; );
  ref_blk_pow = 0; ref_blk_n = 0; ref_rpos = 0; ref_rcount = 0;
  ref_sum_m2 = 0; ref_sum_s2 = 0; ref_sLR = 0; ref_sLL = 0; ref_sRR = 0; ref_pk = 0; ref_tot_n = 0;
  ref_lufs_m = -70; ref_lufs_m_max = -70;
  ref_lufs_s = -70; ref_lufs_s_max = -70;
  int_lufs_ref = -70;
  pk_low_mix = 0; sum_low_mix2 = 0;
  pk_low_ref = 0; sum_low_ref2 = 0;
  pk_pres_mix = 0; sum_pres_mix2 = 0;
  sub_side_pct = 0; lr_asym_db = 0; pres_crest_db = 10.0;
  vox_mask_idx = 0; chorus_lift_db = 0; chorus_width_lift = 1.0;
  have_ref_data = 0;
);
reset_all();
cap_valid = 0;
reset_req = 0; last_ps = 0; hb_t = 0;
overall = 0; sc_tonal = 0; sc_stereo = 0; sc_dyn = 0; pidx_eff = 18;
last_mc = 0; ref_ptr = FP; ui_view = 0;
// ---- suite ownership: how much each suite (0 drums 1 guitar 2 bass 3 vocal 4 synth 5 devastator) shapes each band
i = 0; loop(42, WT[i] = 0; TT[i] = 0; i += 1; );
i = 0; loop(6, TW[i] = 0; i += 1; );
WT[0*7+0]=0.35; WT[2*7+0]=0.60; WT[4*7+0]=0.05;
WT[0*7+1]=0.30; WT[1*7+1]=0.20; WT[2*7+1]=0.40; WT[3*7+1]=0.05; WT[4*7+1]=0.05;
WT[0*7+2]=0.15; WT[1*7+2]=0.35; WT[2*7+2]=0.10; WT[3*7+2]=0.20; WT[4*7+2]=0.20;
WT[0*7+3]=0.05; WT[1*7+3]=0.35; WT[2*7+3]=0.05; WT[3*7+3]=0.35; WT[4*7+3]=0.20;
WT[0*7+4]=0.20; WT[1*7+4]=0.25; WT[3*7+4]=0.40; WT[4*7+4]=0.15;
WT[0*7+5]=0.25; WT[1*7+5]=0.15; WT[3*7+5]=0.30; WT[4*7+5]=0.30;
WT[0*7+6]=0.20; WT[1*7+6]=0.05; WT[3*7+6]=0.40; WT[4*7+6]=0.35;
WGTS[0]=0.15; WGTS[1]=0.35; WGTS[2]=0.0; WGTS[3]=0.10; WGTS[4]=0.40; WGTS[5]=0.0;
// ---- energy lane: instrument suites get a density request when the mix crest exceeds the reference ----
// ESW = per-suite share (0 drums 1 guitar 2 bass 3 vocal 4 synth 5 devastator). Vocal + bass excluded on purpose.
ESW = 3850; ESW[0]=1.0; ESW[1]=1.0; ESW[2]=0.0; ESW[3]=0.0; ESW[4]=1.0; ESW[5]=0.5;
ED = 0;
raw_captured = 0;
raw_sc_overall = 0;
raw_sc_tonal = 0;
raw_sc_stereo = 0;
raw_sc_dyn = 0;
last_slider10 = 0;
ctl_ki = 0.08;      // integrator gain per 0.5 s control step (tuned by simulation, see sim_control_loop.py)
ctl_dead = 0.7;     // dB dead-band on band error
ctl_tau_w = 0.98758; // exp(-0.1 s / 8 s)

// ---- metrics + scoring ---------------------------------------------------------
function compute_metrics() local(i, tot, c, n, pw, g, n2, sum2, gate, mean1, lo, hi, d, tol, sc, stg, e, ref, pdb, cnt, k, bi, bv, s, rf, ts, ws, dd, dw) (
  // integrated loudness (absolute -70 / relative -10 LU gating)
  n = 0; sum1 = 0; i = 0;
  loop(400, c = HSTG[i]; c > 0 ? ( n += c; sum1 += c * pow(10, (((i+0.5)/5 - 70) + 0.691)/10); ); i += 1; );
  n > 0 ? (
    gate = -0.691 + 10*log10(sum1/n) - 10;
    n2 = 0; sum2 = 0; i = 0;
    loop(400, c = HSTG[i]; (c > 0 && ((i+0.5)/5 - 70) > gate) ? ( n2 += c; sum2 += c * pow(10, (((i+0.5)/5 - 70) + 0.691)/10); ); i += 1; );
    int_lufs = n2 > 0 ? -0.691 + 10*log10(sum2/n2) : -70;
  ) : ( int_lufs = -70; );

  // LRA (p95 - p10 of 3 s short-term loudness)
  n = 0; i = 0; loop(120, n += HS[i]; i += 1; );
  lra = n > 8 ? (hist_pct(HS, 120, n, 0.95) - hist_pct(HS, 120, n, 0.10))*0.5 : 0;

  pdb = 20*log10(pk + 0.000000000001);
  rms_db = 10*log10(sum_m2/max(tot_n,1) + 0.000000000000000001);
  LV[0] = int_lufs; LV[1] = pdb - int_lufs; LV[2] = pdb - rms_db; LV[3] = lra;
  LV[4] = sLR/sqrt(sLL*sRR + 0.000000000000000000000000000001);
  LV[5] = sqrt(sum_s2/(sum_m2 + 0.000000000000000001));
  pk_db = pdb;

  tot = 0; i = 0; loop(7, tot += ACC[i*2] + ACC[i*2+1]; i += 1; );
  i = 0;
  loop(7,
    LV[6+i]  = 100*(ACC[i*2] + ACC[i*2+1])/(tot + 0.000000000000000000000000000001);
    LV[13+i] = sqrt(ACC[i*2+1]/(ACC[i*2] + 0.000000000000000000000000000001));
    i += 1;
  );

  // Reference integrated loudness
  ref_n = 0; ref_sum1 = 0; i = 0;
  loop(400, c = HSTG_REF[i]; c > 0 ? ( ref_n += c; ref_sum1 += c * pow(10, (((i+0.5)/5 - 70) + 0.691)/10); ); i += 1; );
  ref_n > 0 ? (
    ref_gate = -0.691 + 10*log10(ref_sum1/ref_n) - 10;
    ref_n2 = 0; ref_sum2 = 0; i = 0;
    loop(400, c = HSTG_REF[i]; (c > 0 && ((i+0.5)/5 - 70) > ref_gate) ? ( ref_n2 += c; ref_sum2 += c * pow(10, (((i+0.5)/5 - 70) + 0.691)/10); ); i += 1; );
    int_lufs_ref = ref_n2 > 0 ? -0.691 + 10*log10(ref_sum2/ref_n2) : -70;
  ) : ( int_lufs_ref = -70; );

  // Reference LRA
  ref_n = 0; i = 0; loop(120, ref_n += HS_REF[i]; i += 1; );
  ref_lra = ref_n > 8 ? (hist_pct(HS_REF, 120, ref_n, 0.95) - hist_pct(HS_REF, 120, ref_n, 0.10))*0.5 : 0;

  ref_pdb = 20*log10(ref_pk + 0.000000000001);
  ref_rms_db = 10*log10(ref_sum_m2/max(ref_tot_n,1) + 0.000000000000000001);
  LIVE_REF[0] = int_lufs_ref;
  LIVE_REF[1] = ref_pdb - int_lufs_ref;
  LIVE_REF[2] = ref_pdb - ref_rms_db;
  LIVE_REF[3] = ref_lra;
  LIVE_REF[4] = ref_sLR/sqrt(ref_sLL*ref_sRR + 0.000000000000000000000000000001);
  LIVE_REF[5] = sqrt(ref_sum_s2/(ref_sum_m2 + 0.000000000000000001));
  LIVE_REF[31] = have_ref_data ? 1 : 0;

  ref_tot = 0; i = 0; loop(7, ref_tot += ACC_REF[i*2] + ACC_REF[i*2+1]; i += 1; );
  i = 0;
  loop(7,
    LIVE_REF[6+i]  = 100*(ACC_REF[i*2] + ACC_REF[i*2+1])/(ref_tot + 0.000000000000000000000000000001);
    LIVE_REF[13+i] = sqrt(ACC_REF[i*2+1]/(ACC_REF[i*2] + 0.000000000000000000000000000001));
    i += 1;
  );

  // Band differentials & Cross Correlation
  i = 0;
  loop(7,
    denom = sqrt((ACC[i*2] + 0.0000000001) * (ACC_REF[i*2] + 0.0000000001));
    BAND_XCORR[i] = clampv(ACC_XCORR[i] / denom, -1.0, 1.0);
    BAND_DIFF[i] = 10*log10((ACC[i*2] + ACC[i*2+1] + 0.000000001) / (ACC_REF[i*2] + ACC_REF[i*2+1] + 0.000000001));
    i += 1;
  );

  // Low-End Punch Index (20-250 Hz Crest Factor)
  rms_low_mix = sqrt(sum_low_mix2 / max(tot_n, 1));
  punch_mix_db = 20*log10(pk_low_mix / (rms_low_mix + 0.000000001));
  rms_low_ref = sqrt(sum_low_ref2 / max(ref_tot_n, 1));
  punch_ref_db = 20*log10(pk_low_ref / (rms_low_ref + 0.000000001));
  punch_delta = punch_mix_db - punch_ref_db;

  // Continuous Spectral Tilt
  tilt_mix = (-4.8343*10*log10(LV[6]+0.01) - 2.8843*10*log10(LV[7]+0.01) - 1.1243*10*log10(LV[8]+0.01) + 0.5257*10*log10(LV[9]+0.01) + 1.8957*10*log10(LV[10]+0.01) + 2.8057*10*log10(LV[11]+0.01) + 3.6157*10*log10(LV[12]+0.01)) / 57.76;

  // choose reference
  pidx_eff = (slider1 == 0 && gmem[1000] == 1) ? clampv(floor(gmem[1008]+0.5), 0, 24) : slider2;
  ref = (slider3 == 3 && have_ref_data) ? LIVE_REF :
        (slider11 > 0 ? (STEM_FP + slider11*32) :
        ((slider3 == 2) ? (LIB + clampv(slider9, 0, 24)*32) :
        ((slider3 == 1 && cap_valid) ? CAP : (FP + pidx_eff*32))));
  ref_ptr = ref;
  stg = slider4;

  tilt_ref = (-4.8343*10*log10(ref_ptr[6]+0.01) - 2.8843*10*log10(ref_ptr[7]+0.01) - 1.1243*10*log10(ref_ptr[8]+0.01) + 0.5257*10*log10(ref_ptr[9]+0.01) + 1.8957*10*log10(ref_ptr[10]+0.01) + 2.8057*10*log10(ref_ptr[11]+0.01) + 3.6157*10*log10(ref_ptr[12]+0.01)) / 57.76;
  tilt_delta = tilt_mix - tilt_ref;

  // Auto loudness match delta
  auto_gain_db = (have_data && have_ref_data) ? clampv(int_lufs - int_lufs_ref, -24, 24) : 0;

  // Advanced Comparison Metrics:
  // 1. Sub Stereo Leakage (<100Hz Side-to-Mid Power %)
  sub_side_pct = 100.0 * (ACC[1] + 0.000000000001) / (ACC[0] + ACC[1] + 0.000000000002);

  // 2. L/R RMS Balance Asymmetry (dB)
  lr_asym_db = 10.0 * log10((sLL + 0.000000000001) / (sRR + 0.000000000001));

  // 3. Presence Crest Factor (1-6 kHz Snare & Vocal Snap)
  rms_pres_mix = sqrt(sum_pres_mix2 / max(tot_n, 1));
  pres_crest_db = 20.0 * log10(pk_pres_mix / (rms_pres_mix + 0.000000001));

  // 4. Vocal-to-Instrumental Masking Severity (0-100%)
  vox_mask_idx = vox_act ? clampv((1.0 - max(0, vox_rel_mst - (-4.0)) / 6.0) * (LV[9] + LV[10]) / 35.0 * 100.0, 0, 100) : 0;

  // 5. Macro Chorus Dynamic Impact Lift & Stereo Bloom
  chorus_lift_db = max(0, lufs_s_max - int_lufs);
  chorus_width_lift = max(1.0, LV[5] / max(ref_ptr[5], 0.20));

  // deviations
  tonal_sc = 0; i = 0;
  loop(7,
    DV[i] = 10*log10((LV[6+i] + 0.02)/(ref[6+i] + 0.02));
    tol = (i == 0 || i == 6) ? 2.0 : 1.5;
    DEVF[i] = abs(DV[i])/tol;
    tonal_sc += clampv(1 - max(0, DEVF[i]-1)/3, 0, 1);
    i += 1;
  );
  sc_tonal = tonal_sc/7*100;

  st_sc = 0; i = 0;
  loop(7,
    DV[7+i] = LV[13+i] - ref[13+i];
    DEVF[7+i] = abs(DV[7+i])/0.20;
    st_sc += clampv(1 - max(0, DEVF[7+i]-1)/3, 0, 1);
    i += 1;
  );
  // Stage-aware dynamic targets:
  // In Mix Bus stage (slider4 == 0), normalize for the expected -6 dBTP pre-master operating window:
  expected_mix_plr = ref[1] + 3.8;  // e.g. 5.23 + 3.8 = 9.03 dB PLR
  expected_mix_lufs = ref[0] - 9.5; // e.g. -5.33 - 9.5 = -14.83 LUFS
  DV[14] = slider4 ? (LV[0] - ref[0]) : (LV[0] - expected_mix_lufs);
  DEVF[14] = abs(DV[14])/1.5;
  DV[15] = slider4 ? (LV[1] - ref[1]) : (LV[1] - expected_mix_plr);
  DEVF[15] = abs(DV[15])/1.5;
  DV[16] = LV[2] - ref[2]; DEVF[16] = abs(DV[16])/1.5;
  DV[17] = LV[3] - ref[3]; DEVF[17] = abs(DV[17])/2.0;
  DV[18] = LV[4] - ref[4]; DEVF[18] = abs(DV[18])/0.10;
  st_sc += clampv(1 - max(0, DEVF[18]-1)/3, 0, 1);
  sc_stereo = st_sc/8*100;

  dy_sc = 0; i = 14;
  loop(4, dy_sc += clampv(1 - max(0, DEVF[i]-1)/3, 0, 1); i += 1; );
  sc_dyn = dy_sc/4*100;

  // High-Value Suite Telemetry Metrics:
  // 1. Vocal Anchor Ratio (Lead Vocal vs Master RMS Ratio)
  vox_act = (gmem[880] == 1 && gmem[883] > -80.0);
  vox_rel_mst = vox_act ? gmem[888] : -99.0;
  vox_target = -6.5; // Dan Braunstein blueprint lead vocal pocket target
  vox_dv = vox_act ? (vox_rel_mst - vox_target) : 0;
  sc_vox = vox_act ? clampv(1.0 - max(0, abs(vox_dv) - 0.5)/3.0, 0.0, 1.0)*100 : 100;

  // 2. Kick-to-Sub Phase Interlock
  bass_act = (gmem[860] == 1);
  sub_corr = bass_act ? gmem[866] : 0.50; // kick/bass correlation
  sub_duck = bass_act ? gmem[867] : -2.0; // ducking GR

  // 3. Drum Shell Transient Punch Ratio
  drum_act = (gmem[820] == 1);
  drum_crest = drum_act ? gmem[824] : 9.5;

  overall = stg ? (0.45*sc_tonal + 0.30*sc_stereo + 0.25*sc_dyn) : (0.60*sc_tonal + 0.40*sc_stereo);

  // Capture raw mix baseline metrics and score when in Raw Audit mode
  slider10 ? (
    ci = 0; loop(20, RAW_FP[ci] = LV[ci]; ci += 1; );
    ci = 0; loop(20, RAW_DV[ci] = DV[ci]; ci += 1; );
    raw_sc_tonal = sc_tonal;
    raw_sc_stereo = sc_stereo;
    raw_sc_dyn = sc_dyn;
    raw_sc_overall = overall;
    raw_captured = 1;
  );

  // how closely the live signal matches EVERY library reference (tonal 60% + width 40%)
  k = 0;
  loop(24,
    rf = LIB + k*32; ts = 0; ws = 0; i = 0;
    loop(7,
      dd = abs(10*log10((LV[6+i] + 0.02)/(rf[6+i] + 0.02)))/((i == 0 || i == 6) ? 2.0 : 1.5);
      ts += clampv(1 - max(0, dd - 1)/3, 0, 1);
      dw = abs(LV[13+i] - rf[13+i])/0.20;
      ws += clampv(1 - max(0, dw - 1)/3, 0, 1);
      i += 1;
    );
    LM[k] = 100*(0.6*ts + 0.4*ws)/7;
    k += 1;
  );

  // recommendation severities
  i = 0; loop(40, SEV[i] = 0; i += 1; );
  i = 0;
  loop(7,
    DEVF[i] > 1 ? ( SEV[i*2 + (DV[i] > 0)] = DEVF[i]; );
    DEVF[7+i] > 1 ? ( SEV[14 + i*2 + (DV[7+i] > 0)] = DEVF[7+i]; );
    i += 1;
  );
  stg ? (
    DEVF[15] > 1 ? ( SEV[28 + (DV[15] < 0)] = DEVF[15]; );
    DEVF[14] > 1 ? ( SEV[30 + (DV[14] > 0)] = DEVF[14]; );
  );
  DEVF[18] > 1 ? ( SEV[32] = DEVF[18]; );
  k = 0;
  loop(4,
    bv = 0; bi = -1; i = 0;
    loop(33, SEV[i] > bv ? ( bv = SEV[i]; bi = i; ); i += 1; );
    RC[k] = bi; bi >= 0 ? ( SEV[bi] = 0; );
    k += 1;
  );

  // gmem export for the Mixing Suite / other Damei tools
  gmem[1100] = 1; gmem[1101] = overall; gmem[1102] = sc_tonal; gmem[1103] = sc_stereo;
  gmem[1104] = sc_dyn; gmem[1105] = pidx_eff; gmem[1106] = stg;
  i = 0; loop(7, gmem[1107+i] = DV[i]; gmem[1114+i] = DV[7+i]; i += 1; );
  gmem[1121] = int_lufs; gmem[1122] = LV[1]; gmem[1123] = LV[4];
  gmem[1124] = time_precise();
  gmem[1126] = sc_vox;
  gmem[1127] = vox_rel_mst;
  gmem[1128] = sub_corr;
  gmem[1129] = drum_crest;

  // Comprehensive Mastering Telemetry Engine
  tp_db = 20*log10(true_pk + 0.000000000001);
  tp_l_db = 20*log10(true_pk_l + 0.000000000001);
  tp_r_db = 20*log10(true_pk_r + 0.000000000001);

  // Streaming platform normalization deltas (dB)
  pen_spotify = max(0, int_lufs - (-14.0));
  pen_apple   = max(0, int_lufs - (-16.0));
  pen_youtube = max(0, int_lufs - (-14.0));
  pen_tidal   = max(0, int_lufs - (-14.0));
  delta_cd    = int_lufs - (-8.5);

  // Mono Summing Cancellation Loss in dB
  mono_loss_db = max(0, 10*log10((sLL + sRR + 0.0000000001) / (2.0*sum_mono2 + 0.0000000001)));

  // Sub-bass (<100Hz) mono integrity (% mono)
  sub_mono_pct = max(0, min(100, (1.0 - LV[13]*1.8) * 100));

  // DC Offset dBFS
  dc_db = 20*log10(max(abs(sum_l), abs(sum_r))/max(tot_n, 1) + 0.000000000001);

  // Publish Extended Mastering Telemetry to gmem[1130..1145]
  gmem[1130] = tp_l_db;
  gmem[1131] = tp_r_db;
  gmem[1132] = tp_db;
  gmem[1133] = lufs_m;
  gmem[1134] = lufs_m_max;
  gmem[1135] = lufs_s;
  gmem[1136] = lufs_s_max;
  gmem[1137] = lra;
  gmem[1138] = pen_spotify;
  gmem[1139] = pen_apple;
  gmem[1140] = pen_youtube;
  gmem[1141] = delta_cd;
  gmem[1142] = mono_loss_db;
  gmem[1143] = sub_mono_pct;
  gmem[1144] = dc_db;
  gmem[1145] = isp_overs;

  // Publish Extended Stem & Comparative Telemetry to gmem[1146..1160]
  gmem[1146] = auto_gain_db;
  gmem[1147] = punch_mix_db;
  gmem[1148] = punch_ref_db;
  gmem[1149] = tilt_delta;
  i = 0; loop(7, gmem[1150+i] = BAND_DIFF[i]; i += 1; );
  gmem[1157] = slider11; // Stem Profile Mode
  gmem[1158] = slider12; // Monitor Mode
  gmem[1159] = int_lufs_ref;
  gmem[1160] = have_ref_data ? 1 : 0;
  // Advanced Telemetry to gmem[1161..1166]
  gmem[1161] = sub_side_pct;
  gmem[1162] = lr_asym_db;
  gmem[1163] = pres_crest_db;
  gmem[1164] = vox_mask_idx;
  gmem[1165] = chorus_lift_db;
  gmem[1166] = chorus_width_lift;
);

// ---- closed-loop correction lane --------------------------------------------------------------------
// Slow, capped, dead-banded integrator on an 8 s moving average of the band energies.
// Publishes trims per suite on gmem[1300 + suite*16 ...]: +0 valid, +1..+7 band dB, +8 side-shelf dB, +15 heartbeat.
function ctl_publish() local(s, b, base, allow_trims) (
  allow_trims = (slider7 == 1 && slider10 == 0);
  s = 0;
  loop(6,
    base = 1300 + s*16;
    gmem[base] = allow_trims ? 1 : 0;
    b = 0; loop(7, gmem[base + 1 + b] = allow_trims ? TT[s*7 + b] : 0; b += 1; );
    gmem[base + 8] = allow_trims ? TW[s] : 0;
    gmem[base + 9] = allow_trims ? (ED * ESW[s]) : 0;   // density request 0..1 (energy lane)
    gmem[base + 15] = time_precise();
    s += 1;
  );
  gmem[1098] = slider10 ? 1 : 0;
  gmem[1099] = raw_captured ? raw_sc_overall : 0;
);

function ctl_block() local(i, w, e, s, b, tot, pct, dvb, cap, ew, bwv, bwr, x, b_cap_pos, b_cap_neg) (
  ema_n += 1;
  w = max(1/ema_n, 1 - ctl_tau_w);
  i = 0; loop(14, EM[i] += (BA[i]/blk_len - EM[i])*w; BA[i] = 0; i += 1; );

  (ema_n >= 20 && ema_n % 5 == 0) ? (
    ctl_publish();
    // Only integrate trims if:
    // 1. Auto-Correct is ON (slider7 == 1)
    // 2. Not in Hold (slider5 == 0)
    // 3. Not in Raw Audit (slider10 == 0)
    // 4. Transport is actively playing ((play_state & 1) == 1)
    // 5. Signal is present and substantial (tot > 0.0005 and have_data)
    tot = 0; i = 0; loop(7, tot += EM[i*2] + EM[i*2+1]; i += 1; );

    (slider7 > 0 && slider10 == 0) ? (
      slider7 == 1 ? (
        // Mode 1: Smooth Static Calibration Lock (ramps over ~1.5s, then locks 100% static)
        !static_locked ? (
          (have_data && tot > 0.0005) ? (
            cap = min(slider8, 2.5);
            b = 0;
            loop(7,
              e = -DV[b]; // measured deviation delta vs reference
              e = abs(e) < ctl_dead ? 0 : (e > 0 ? e - ctl_dead : e + ctl_dead);
              b_cap_pos = (b == 2) ? 0.8 : cap;
              b_cap_neg = (b >= 5) ? 1.5 : cap;
              s = 0;
              loop(6,
                x = WT[s*7+b];
                (b >= 3 && b <= 5) ? (
                  (e < 0) ? ( s == 3 ? ( x *= 0.35; ) : ( (s == 1 || s == 4) ? ( x *= 1.35; ); ); )
                          : ( s == 3 ? ( x *= 1.25; ); );
                ) : ( (b == 2 && e < 0 && (s == 1 || s == 4)) ? ( x *= 1.35; ); );

                target_TT = clampv(e * x * 0.75, -b_cap_neg, b_cap_pos);
                TT[s*7+b] += (target_TT - TT[s*7+b]) * 0.06; // smooth 1.5s ramp
                s += 1;
              );
              b += 1;
            );

            // Side-shelf width target
            b_diff_w = -(DV[11] + DV[12] + DV[13]) * 0.333;
            s = 0;
            loop(6,
              target_TW = clampv(b_diff_w * WGTS[s] * 0.5, -0.6, 1.0);
              TW[s] += (target_TW - TW[s]) * 0.06;
              s += 1;
            );

            lock_timer += 1;
            lock_timer > 35 ? ( static_locked = 1; ); // Lock as permanent static calibration!
          );
        );
      ) : (
        // Mode 2: Psychoacoustic Slow Dynamic (Macro-respiration with silence gate)
        // Signal gate: If audio drops below -30dBFS or silent, freeze trims completely (zero hunting/pumping)
        (have_data && tot > 0.001) ? (
          cap = min(slider8, 2.2);
          b = 0;
          loop(7,
            e = -DV[b];
            e = abs(e) < ctl_dead ? 0 : (e > 0 ? e - ctl_dead : e + ctl_dead);
            // In dynamic mode, only allow mid bands (2, 3, 4: 250Hz - 6kHz) to gently adapt; keep sub and high air locked
            b_dyn_rate = (b >= 2 && b <= 4) ? 0.003 : 0.0008; // 8-15s slow macro integration
            b_cap_pos = (b == 2) ? 0.75 : cap;
            b_cap_neg = (b >= 5) ? 1.2 : cap;
            s = 0;
            loop(6,
              x = WT[s*7+b];
              target_TT = clampv(e * x * 0.75, -b_cap_neg, b_cap_pos);
              // Slew-rate limited adaptive breathing
              TT[s*7+b] += (target_TT - TT[s*7+b]) * b_dyn_rate;
              s += 1;
            );
            b += 1;
          );
          b_diff_w = -(DV[11] + DV[12] + DV[13]) * 0.333;
          s = 0;
          loop(6,
            target_TW = clampv(b_diff_w * WGTS[s] * 0.5, -0.5, 0.8);
            TW[s] += (target_TW - TW[s]) * 0.001;
            s += 1;
          );
        );
      );
      ctl_publish();
    ) : (
      // When Auto-Correct is OFF: ramp smoothly back to 0.0 dB (zero clicks)
      static_locked = 0;
      lock_timer = 0;
      s = 0;
      loop(6,
        b = 0;
        loop(7, TT[s*7+b] *= 0.90; b += 1; );
        TW[s] *= 0.90;
        s += 1;
      );
      ctl_publish();
    );
  );
);

@slider
(slider47 != last_slider47) ? (
  ui_view = (slider47 == 0 ? 0 : (slider47 == 1 ? 1 : (slider47 == 2 ? 2 : (slider47 == 3 ? 3 : (slider47 == 4 ? 4 : 5)))));
  last_slider47 = slider47;
);

@block
(slider47 != last_slider47) ? (
  ui_view = (slider47 == 0 ? 0 : (slider47 == 1 ? 1 : (slider47 == 2 ? 2 : (slider47 == 3 ? 3 : (slider47 == 4 ? 4 : 5)))));
  last_slider47 = slider47;
);
ps = play_state & 1;
(slider6 == 1 && ps && !last_ps) ? ( reset_req = 1; );
last_ps = ps;
(slider10 != last_slider10) ? (
  reset_req = 1;
  last_slider10 = slider10;
);
ctl_publish();

@sample
reset_req ? ( reset_all(); reset_req = 0; );

l = spl0; r = spl1;
ref_l = spl2; ref_r = spl3;

slider5 == 0 ? (
  m = (l + r)*0.5; s = (l - r)*0.5;
  ref_m = (ref_l + ref_r)*0.5; ref_s = (ref_l - ref_r)*0.5;

  b = 0;
  ym_low = 0; ref_ym_low = 0; ym_pres = 0;
  loop(7,
    ym = bqrun(BQC + (b*2)*5,   BQS + (b*2)*2,       m);
    ym = bqrun(BQC + (b*2+1)*5, BQS + (b*2+1)*2,     ym);
    ys = bqrun(BQC + (b*2)*5,   BQS + (14 + b*2)*2,  s);
    ys = bqrun(BQC + (b*2+1)*5, BQS + (14 + b*2+1)*2, ys);
    ACC[b*2] += ym*ym; ACC[b*2+1] += ys*ys;
    BA[b*2] += ym*ym;  BA[b*2+1] += ys*ys;

    // Reference band filtering
    ref_ym = bqrun(BQC + (b*2)*5,   BQS_REF + (b*2)*2,       ref_m);
    ref_ym = bqrun(BQC + (b*2+1)*5, BQS_REF + (b*2+1)*2,     ref_ym);
    ref_ys = bqrun(BQC + (b*2)*5,   BQS_REF + (14 + b*2)*2,  ref_s);
    ref_ys = bqrun(BQC + (b*2+1)*5, BQS_REF + (14 + b*2+1)*2, ref_ys);
    ACC_REF[b*2] += ref_ym*ref_ym; ACC_REF[b*2+1] += ref_ys*ref_ys;
    BA_REF[b*2] += ref_ym*ref_ym;  BA_REF[b*2+1] += ref_ys*ref_ys;

    // Cross correlation mid channel
    ACC_XCORR[b] += ym * ref_ym;

    // Low band tracking (Bands 0 and 1: 20-250 Hz)
    (b == 0 || b == 1) ? (
      ym_low += ym;
      ref_ym_low += ref_ym;
    );

    // Presence band tracking (Bands 3 and 4: 800 Hz - 6 kHz for vocal/snare crack)
    (b == 3 || b == 4) ? (
      ym_pres += ym;
    );

    b += 1;
  );

  pk_low_mix = max(pk_low_mix, abs(ym_low));
  sum_low_mix2 += ym_low * ym_low;
  pk_pres_mix = max(pk_pres_mix, abs(ym_pres));
  sum_pres_mix2 += ym_pres * ym_pres;
  pk_low_ref = max(pk_low_ref, abs(ref_ym_low));
  sum_low_ref2 += ref_ym_low * ref_ym_low;

  // Mix K-weighting
  kl = bqrun(KC, KS + 0, l);  kl = bqrun(KC + 5, KS + 2, kl);
  kr = bqrun(KC, KS + 4, r);  kr = bqrun(KC + 5, KS + 6, kr);
  blk_pow += kl*kl + kr*kr; blk_n += 1;

  // Ref K-weighting
  ref_kl = bqrun(KC, KS_REF + 0, ref_l);  ref_kl = bqrun(KC + 5, KS_REF + 2, ref_kl);
  ref_kr = bqrun(KC, KS_REF + 4, ref_r);  ref_kr = bqrun(KC + 5, KS_REF + 6, ref_kr);
  ref_blk_pow += ref_kl*ref_kl + ref_kr*ref_kr; ref_blk_n += 1;

  sum_m2 += m*m; sum_s2 += s*s; sLR += l*r; sLL += l*l; sRR += r*r;
  pk = max(pk, max(abs(l), abs(r)));
  tot_n += 1;

  ref_sum_m2 += ref_m*ref_m; ref_sum_s2 += ref_s*ref_s;
  ref_sLR += ref_l*ref_r; ref_sLL += ref_l*ref_l; ref_sRR += ref_r*ref_r;
  ref_pk = max(ref_pk, max(abs(ref_l), abs(ref_r)));
  ref_tot_n += 1;

  // 4x Intersample True Peak (ISP) Polyphase Hermite Estimator
  isp_l = max(abs(l), abs((-isp_l_p2 + 9*isp_l_p1 + 9*l - spl0)*0.0625));
  isp_r = max(abs(r), abs((-isp_r_p2 + 9*isp_r_p1 + 9*r - spl1)*0.0625));
  isp_l_p2 = isp_l_p1; isp_l_p1 = l;
  isp_r_p2 = isp_r_p1; isp_r_p1 = r;
  true_pk_l = max(true_pk_l, isp_l);
  true_pk_r = max(true_pk_r, isp_r);
  true_pk = max(true_pk, max(isp_l, isp_r));
  (true_pk >= 1.0) ? ( isp_overs += 1; );

  sum_l += l; sum_r += r;
  mono_s = (l + r) * 0.5;
  sum_mono2 += mono_s * mono_s;

  blk_n >= blk_len ? (
    pw = blk_pow/blk_n; blk_pow = 0; blk_n = 0;
    RB[rpos] = pw; rpos = (rpos + 1) % 30; rcount += 1;
    rcount >= 4 ? (
      mp = 0; q = 0;
      loop(4, mp += RB[(rpos - 1 - q + 60) % 30]; q += 1; );
      lmv = -0.691 + 10*log10(mp/4 + 0.000000000000000001);
      lmv > -70 ? ( bn = clampv(floor((lmv + 70)*5), 0, 399); HSTG[bn] += 1; );
      lufs_m = lmv;
      lufs_m_max = max(lufs_m_max, lmv);
    );
    (rcount >= 30 && rcount % 10 == 0) ? (
      mp = 0; q = 0; loop(30, mp += RB[q]; q += 1; );
      lst = -0.691 + 10*log10(mp/30 + 0.000000000000000001);
      lst > -60 ? ( bn = clampv(floor((lst + 60)*2), 0, 119); HS[bn] += 1; );
      lufs_s = lst;
      lufs_s_max = max(lufs_s_max, lst);
    );

    // Ref block power tracking
    ref_pw = ref_blk_pow/max(ref_blk_n, 1); ref_blk_pow = 0; ref_blk_n = 0;
    RB_REF[ref_rpos] = ref_pw; ref_rpos = (ref_rpos + 1) % 30; ref_rcount += 1;
    ref_rcount >= 4 ? (
      ref_mp = 0; q = 0;
      loop(4, ref_mp += RB_REF[(ref_rpos - 1 - q + 60) % 30]; q += 1; );
      ref_lmv = -0.691 + 10*log10(ref_mp/4 + 0.000000000000000001);
      ref_lmv > -70 ? ( ref_bn = clampv(floor((ref_lmv + 70)*5), 0, 399); HSTG_REF[ref_bn] += 1; );
      ref_lufs_m = ref_lmv;
      ref_lufs_m_max = max(ref_lufs_m_max, ref_lmv);
    );
    (ref_rcount >= 30 && ref_rcount % 10 == 0) ? (
      ref_mp = 0; q = 0; loop(30, ref_mp += RB_REF[q]; q += 1; );
      ref_lst = -0.691 + 10*log10(ref_mp/30 + 0.000000000000000001);
      ref_lst > -60 ? ( ref_bn = clampv(floor((ref_lst + 60)*2), 0, 119); HS_REF[ref_bn] += 1; );
      ref_lufs_s = ref_lst;
      ref_lufs_s_max = max(ref_lufs_s_max, ref_lst);
    );

    (rcount % 5 == 0 && rcount >= 10) ? (
      have_data = 1;
      (ref_rcount >= 10 && (ref_sLL + ref_sRR) > 0.00000001) ? ( have_ref_data = 1; );
      compute_metrics();
    );
    ctl_block();
  );
);

// Monitor routing & Auditory Null output
eff_ref_gain_db = (slider14 == 1 && have_ref_data && have_data) ? clampv(int_lufs - int_lufs_ref, -24, 24) : slider13;
eff_ref_gain = pow(10, eff_ref_gain_db * 0.05);

slider12 == 1 ? (
  spl0 = ref_l * eff_ref_gain;
  spl1 = ref_r * eff_ref_gain;
) : slider12 == 2 ? (
  spl0 = ref_l;
  spl1 = ref_r;
) : slider12 == 3 ? (
  spl0 = l - ref_l * eff_ref_gain;
  spl1 = r - ref_r * eff_ref_gain;
);
// slider12 == 0: spl0 & spl1 left untouched

@serialize
file_var(0, cap_valid);
ci = 0; loop(42, file_var(0, TT[ci]); ci += 1; );
ci = 0; loop(6, file_var(0, TW[ci]); ci += 1; );
ci = 0; loop(32, file_var(0, CAP[ci]); ci += 1; );

@gfx 1020 800
(slider47 != last_slider47) ? (
  ui_view = (slider47 == 0 ? 0 : (slider47 == 1 ? 1 : (slider47 == 2 ? 2 : (slider47 == 3 ? 3 : (slider47 == 4 ? 4 : 5)))));
  last_slider47 = slider47;
);
// ---- helpers ------------------------------------------------------------------
function rct(x, y, w, h) ( gfx_rect(ox + x*gsc, oy + y*gsc, max(1, w*gsc), max(1, h*gsc)); );
function rcto(x, y, w, h) ( gfx_rect(ox + x*gsc, oy + y*gsc, max(1, w*gsc), max(1, h*gsc), 0); );
function lin(x1, y1, x2, y2) ( gfx_line(ox + x1*gsc, oy + y1*gsc, ox + x2*gsc, oy + y2*gsc, 1); );
function cir(x, y, r) ( gfx_circle(ox + x*gsc, oy + y*gsc, max(1, r*gsc), 1); );
function col(r, g, b) ( gfx_r = r; gfx_g = g; gfx_b = b; );
function txt(x, y, s) ( gfx_x = ox + x*gsc; gfx_y = oy + y*gsc; gfx_drawstr(s); );
function txt_r(xr, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = ox + xr*gsc - w; gfx_y = oy + y*gsc; gfx_drawstr(s); );
function status_col(d) ( d <= 1 ? col(0.20, 0.92, 0.62) : (d <= 2 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55)); );

function card(x, y, w, h, ttl, cr, cg, cb) (
  col(0.038, 0.044, 0.068); rct(x, y, w, h);
  col(cr, cg, cb); rcto(x, y, w, h);
  rct(x, y, w, 3);
  gfx_setfont(1); col(cr, cg, cb); txt(x + 14, y + 12, ttl);
);

function dev_bar(x, y, w, h, val, rng, d) local(cx, ww) (
  col(0.07, 0.08, 0.12); rct(x, y, w, h);
  cx = x + w*0.5;
  ww = clampv(val/rng, -1, 1) * w*0.5;
  status_col(d);
  ww >= 0 ? rct(cx, y + 2, ww, h - 4) : rct(cx + ww, y + 2, -ww, h - 4);
  col(0.85, 0.9, 1.0); lin(cx, y - 2, cx, y + h + 2);
);

function fill_bar(x, y, w, h, frac, d) (
  col(0.07, 0.08, 0.12); rct(x, y, w, h);
  status_col(d); rct(x, y + 2, clampv(frac, 0, 1)*w, h - 4);
);

function btn(x, y, w, h, lbl, on) local(hov, clk) (
  hov = (mxs >= x && mxs < x + w && mys >= y && mys < y + h);
  clk = hov && (mouse_cap & 1) && !(last_mc & 1);
  on ? col(0.00, 0.30, 0.28) : (hov ? col(0.12, 0.14, 0.22) : col(0.07, 0.08, 0.13));
  rct(x, y, w, h);
  on ? col(0.00, 0.96, 0.83) : col(0.38, 0.42, 0.55);
  rcto(x, y, w, h);
  gfx_setfont(3); txt(x + 8, y + (h - 12)*0.5, lbl);
  clk;
);

function preset_name(i, out) (
  i == 0  ? strcpy(out, "Default Modern Metal (avg ref)") :
  i == 1  ? strcpy(out, "Lance Prenc - Alpha Wolf") :
  i == 2  ? strcpy(out, "Scott Seigel - DIESECT") :
  i == 3  ? strcpy(out, "Jonathan Dolese - Mirrorcell") :
  i == 4  ? strcpy(out, "Buster Odeholm - thrown") :
  i == 5  ? strcpy(out, "Lewis Johns - blanket") :
  i == 6  ? strcpy(out, "Kel Pinchin - Split Chain") :
  i == 7  ? strcpy(out, "Dan Lancaster - Don Broco") :
  i == 8  ? strcpy(out, "Erik Bickerstaffe - Static Dress") :
  i == 9  ? strcpy(out, "Sam Guaiana - Shyeye") :
  i == 10 ? strcpy(out, "Zach Tuch - Heavenward") :
  i == 11 ? strcpy(out, "Forrester Savell - City Of Souls") :
  i == 12 ? strcpy(out, "Leon Schmidt - SUNBORN") :
  i == 13 ? strcpy(out, "Ermin Hamidovic (avg ref)") :
  i == 14 ? strcpy(out, "Will Putney - FFAA") :
  i == 15 ? strcpy(out, "George Lever - Loathe") :
  i == 16 ? strcpy(out, "Sam Bassal - Thornhill") :
  i == 17 ? strcpy(out, "Henrik Udd - Architects Gravity") :
  i == 18 ? strcpy(out, "Dan Braunstein - Spiritbox Keep Sweet") :
  i == 19 ? strcpy(out, "Cervini & Ron - Bad Omens") :
  i == 20 ? strcpy(out, "Jens Bogren (avg ref)") :
  i == 21 ? strcpy(out, "Nolly Getgood (avg ref)") :
  i == 22 ? strcpy(out, "Acle Kahney - TesseracT King") :
  i == 23 ? strcpy(out, "Adam Cichocki (heaving.)") :
  i == 24 ? strcpy(out, "Manuel Renner (SENNA)") :
            strcpy(out, "Default Modern Metal");
);

function band_label(b, out) (
  b == 0 ? strcpy(out, "Sub 20-60") :
  b == 1 ? strcpy(out, "Low 60-250") :
  b == 2 ? strcpy(out, "Low-mid 250-800") :
  b == 3 ? strcpy(out, "Mid 0.8-2.5k") :
  b == 4 ? strcpy(out, "Hi-mid 2.5-6k") :
  b == 5 ? strcpy(out, "High 6-10k") :
           strcpy(out, "Air 10-18k");
);

function rec_text(code, out) local(b, over) (
  b = floor(code/2); over = code % 2;
  code < 14 ? (
    code == 0  ? strcpy(out, "Sub too light: lift Bass Suite 30-55 Hz anchor / kick weight") :
    code == 1  ? strcpy(out, "Sub too heavy: ease Bass Suite sub anchor, Mixing low shelf") :
    code == 2  ? strcpy(out, "Low end thin: add Bass/Drum weight 60-250 Hz") :
    code == 3  ? strcpy(out, "MUD 60-250: trim Bass low-mids, Drum 200 Hz shell, Guitar chug") :
    code == 4  ? strcpy(out, "Hollow 250-800: ease Mixing mud scoop, add Guitar body") :
    code == 5  ? strcpy(out, "Boxy 250-800: deepen Mixing mud scoop (340 Hz)") :
    code == 6  ? strcpy(out, "Scooped mids: lift Vocal / Guitar 1-2.5 kHz") :
    code == 7  ? strcpy(out, "Honky 0.8-2.5k: carve Guitar/Vocal mids, Ozone EQ") :
    code == 8  ? strcpy(out, "NO PRESENCE 2.5-6k: Vocal presence, widen Guitar De-Fizz, Drum snap") :
    code == 9  ? strcpy(out, "Harsh 2.5-6k: soften Vocal presence, Guitar fizz, Drum snap") :
    code == 10 ? strcpy(out, "Dull 6-10k: raise Vocal air, Synth / Guitar sheen") :
    code == 11 ? strcpy(out, "Bright 6-10k: tame Vocal de-ess / air, Synth sheen") :
    code == 12 ? strcpy(out, "No air 10k+: add Vocal Maag air band, Synth sheen") :
                 strcpy(out, "Fizzy air 10k+: lower Maag air band, Synth 12 kHz sheen");
  ) : code < 28 ? (
    b = floor((code - 14)/2); over = (code - 14) % 2;
    band_label(b, #bl);
    over ? sprintf(out, "Too WIDE at %s: reduce Guitar quad-wall / Synth width / Ozone imager", #bl)
         : sprintf(out, "Too NARROW at %s: add Synth/Guitar imager, Mixing stereo space", #bl);
  ) : (
    code == 28 ? strcpy(out, "Too dynamic (PLR high): more Ozone drive / ceiling push") :
    code == 29 ? strcpy(out, "OVER-SQUASHED (PLR low): back off Mixing VCA / Ozone maximizer") :
    code == 30 ? strcpy(out, "Quieter than ref: master gain/Ozone maximizer (not mix compression)") :
    code == 31 ? strcpy(out, "Louder than ref: reduce Ozone maximizer drive") :
                 strcpy(out, "Low correlation: check phase + wide highs (Imagers, Ozone width)");
  );
);

// ---- Sankofa (Adinkra): "go back and fetch it" - learn from the masters, then build forward -------
// A heart held by two inward spirals. Fits this plugin: the reference tracks are the past we fetch from.
function draw_sankofa(cx, cy, sz) local(k, t, px, py, nx, ny, sc, a, rad, side) (
  sc = sz/34;
  col(1.00, 0.72, 0.02);
  k = 0; px = 0; py = 0;
  loop(41,
    t = k*2*$pi/40;
    nx = cx + 16*pow(sin(t), 3)*sc;
    ny = cy - (13*cos(t) - 5*cos(2*t) - 2*cos(3*t) - cos(4*t))*sc + 1.5*sc;
    k > 0 ? lin(px, py, nx, ny);
    px = nx; py = ny; k += 1;
  );
  col(0.00, 0.96, 0.83);
  side = -1;
  loop(2,
    k = 0;
    loop(30,
      a = k*0.2;
      rad = max(0.4, 5.6*sc*(1 - a/6.2));
      nx = cx + side*7.2*sc + side*rad*cos(a*side + 1.2);
      ny = cy - 5.4*sc - rad*sin(a*side + 1.2);
      k > 0 ? lin(px, py, nx, ny);
      px = nx; py = ny; k += 1;
    );
    side = 1;
  );
  col(1.00, 0.72, 0.02); cir(cx, cy + 6.5*sc, max(1.5, 1.8*sc));
);

function draw_library() local(k, y, rf, sel, hov, clk, best, bm, x0) (
  card(24, 86, 972, 716, "REFERENCE LIBRARY (25 tracks) - click a row to compare", 1.00, 0.85, 0.30);
  gfx_setfont(3); col(0.5, 0.55, 0.68);
  txt(38, 122, "#");  txt(62, 122, "TRACK");
  txt(306, 122, "LUFS"); txt(352, 122, "PLR"); txt(394, 122, "CREST"); txt(440, 122, "LRA"); txt(480, 122, "CORR"); txt(524, 122, "WIDTH");
  txt(576, 122, "SUB"); txt(620, 122, "LOW"); txt(664, 122, "LMID"); txt(708, 122, "MID"); txt(752, 122, "HMID"); txt(796, 122, "HIGH"); txt(840, 122, "AIR");
  txt(892, 122, "LIVE MATCH");
  best = -1; bm = 0; k = 0;
  have_data ? ( loop(25, LM[k] > bm ? ( bm = LM[k]; best = k; ); k += 1; ); );
  k = 0;
  loop(25,
    y = 140 + k*24;
    rf = LIB + k*32;
    sel = (slider3 == 2 && floor(slider9 + 0.5) == k);
    hov = (mxs >= 30 && mxs < 990 && mys >= y - 2 && mys < y + 22);
    clk = hov && (mouse_cap & 1) && !(last_mc & 1);
    sel ? ( col(0.10, 0.22, 0.22); rct(30, y - 2, 960, 23); ) : ( hov ? ( col(0.09, 0.10, 0.16); rct(30, y - 2, 960, 23); ); );
    gfx_setfont(2);
    sel ? col(0.00, 0.96, 0.83) : col(0.85, 0.9, 1.0);
    sprintf(#v, "%d", k + 1); txt(38, y, #v);
    lib_name(k, #ln); txt(62, y, #ln);
    col(0.7, 0.75, 0.85);
    sprintf(#v, "%.1f", rf[0]);  txt(306, y, #v);
    sprintf(#v, "%.1f", rf[1]);  txt(352, y, #v);
    sprintf(#v, "%.1f", rf[2]);  txt(394, y, #v);
    sprintf(#v, "%.1f", rf[3]);  txt(440, y, #v);
    sprintf(#v, "%.2f", rf[4]);  txt(480, y, #v);
    sprintf(#v, "%.2f", rf[5]);  txt(524, y, #v);
    x0 = 576; i = 0;
    loop(7, sprintf(#v, "%.1f", rf[6 + i]); txt(x0 + i*44, y, #v); i += 1; );
    have_data ? (
      LM[k] >= 85 ? col(0.20, 0.92, 0.62) : (LM[k] >= 65 ? col(1.00, 0.85, 0.30) : col(1.00, 0.35, 0.55));
      sprintf(#v, "%d%%%s", floor(LM[k] + 0.5), k == best ? "  NEAREST" : ""); txt(892, y, #v);
    ) : ( col(0.4, 0.45, 0.55); txt(892, y, "--"); );
    clk ? ( slider3 = 2; slider9 = k; slider_automate(slider3); slider_automate(slider9); );
    k += 1;
  );
  // detail strip for the selected library track
  k = floor(slider9 + 0.5);
  rf = LIB + k*32;
  gfx_setfont(3); col(0.00, 0.96, 0.83);
  lib_name(k, #ln);
  LPR[k] >= 0 ? ( preset_name(LPR[k], #pp); ) : ( strcpy(#pp, "no producer preset linked"); );
  sprintf(#v, "%s  |  Producer preset: %s  |  LUFS %.1f  PLR %.1f  Crest %.1f  LRA %.1f  Corr %.2f",
          #ln, #pp, rf[0], rf[1], rf[2], rf[3], rf[4]);
  txt(38, 746, #v);
);

// ---- frame setup ----------------------------------------------------------------
// scale the whole 1020x800 layout to fill the window (letterboxed, centred)
gsc = max(0.35, min(gfx_w/1020, gfx_h/800));
ox = floor((gfx_w - 1020*gsc)*0.5); oy = floor((gfx_h - 800*gsc)*0.5);
mxs = (mouse_x - ox)/gsc; mys = (mouse_y - oy)/gsc;
shift_down = (mouse_cap & 8);
ctrl_down = (mouse_cap & 4);
m_wheel = mouse_wheel; mouse_wheel = 0;
gfx_setfont(1, "Orbitron", max(8, floor(15*gsc + 0.5)), 'b');
gfx_setfont(2, "Arial", max(8, floor(14*gsc + 0.5)));
gfx_setfont(3, "Arial", max(8, floor(13*gsc + 0.5)), 'b');
gfx_setfont(4, "Orbitron", max(12, floor(44*gsc + 0.5)), 'b');
gfx_setfont(5, "Orbitron", max(10, floor(24*gsc + 0.5)), 'b');

// CRT chassis: full-window background + scanlines + bezel (same family as Mixing Suite)
col(0.022, 0.028, 0.038); gfx_rect(0, 0, gfx_w, gfx_h);
col(0.028, 0.035, 0.047);
sl = 0; loop(floor(gfx_h/4) + 1, gfx_rect(0, sl, gfx_w, 1); sl += 4; );
col(0.00, 0.40, 0.36); gfx_rect(0, 0, gfx_w, gfx_h, 0); gfx_rect(1, 1, gfx_w - 2, gfx_h - 2, 0);
col(0.10, 0.12, 0.17); gfx_rect(2, 2, gfx_w - 4, gfx_h - 4, 0); gfx_rect(3, 3, gfx_w - 6, gfx_h - 6, 0);

// header bar: Sankofa sigil far left as part of the name
col(0.050, 0.060, 0.098); rct(10, 8, 1000, 54);
col(0.00, 0.50, 0.46); rcto(10, 8, 1000, 54);
draw_sankofa(44, 35, 38);
gfx_setfont(5); col(0.00, 0.96, 0.83); txt(78, 12, "SANKOFA ORACLE");
gfx_setfont(2); col(1.00, 0.72, 0.02); txt(78, 38, "ASSESSMENT MATRIX");

pn = preset_name(pidx_eff, #pname);
using_cap = (slider3 == 1 && cap_valid);
using_lib = (slider3 == 2);
lib_name(clampv(floor(slider9 + 0.5), 0, 24), #lname);
sprintf(#hdr, "Reference: %s   |   Source: %s   |   Stage: %s",
  using_cap ? "CAPTURED REFERENCE" : (using_lib ? #lname : #pname),
  using_lib ? "Reference Library" : ((slider1 == 0 && gmem[1000] == 1) ? "Mixing Suite (live)" : "Manual"),
  slider4 ? "MASTER" : "MIX BUS");
gfx_setfont(2); col(0.60, 0.65, 0.75); txt(24, 66, #hdr);

// Live Suite Interlock Telemetry Badges
s_mix = (gmem[1000] == 1);
s_vox = (gmem[880] == 1);
s_drm = (gmem[820] == 1);
s_bas = (gmem[860] == 1);
s_gtr = (gmem[840] == 1);
s_syn = (gmem[920] == 1);

function draw_suite_badge(bx, by, bw, bh, name, is_on) (
  col(0.04, 0.05, 0.08); rct(bx, by, bw, bh);
  is_on ? col(0.12, 0.55, 0.35) : col(0.20, 0.22, 0.28); rcto(bx, by, bw, bh);
  is_on ? col(0.20, 0.95, 0.55) : col(0.35, 0.38, 0.45);
  cir(bx + 10, by + bh*0.5, 3.5);
  gfx_setfont(3);
  is_on ? col(0.85, 0.95, 0.90) : col(0.40, 0.45, 0.52);
  txt(bx + 18, by + (bh - 10)*0.5, name);
);

draw_suite_badge(542, 62, 70, 19, "MIX", s_mix);
draw_suite_badge(618, 62, 70, 19, "VOX", s_vox);
draw_suite_badge(694, 62, 70, 19, "DRM", s_drm);
draw_suite_badge(770, 62, 70, 19, "BAS", s_bas);
draw_suite_badge(846, 62, 70, 19, "GTR", s_gtr);
draw_suite_badge(922, 62, 70, 19, "SYN", s_syn);

tmx = 0; s_i = 0;
loop(6, tm = 0; b_i = 0; loop(7, tm = max(tm, abs(TT[s_i*7 + b_i])); b_i += 1; ); tm = max(tm, abs(TW[s_i])); TMV[s_i] = tm; s_i += 1; );
sprintf(#trm, "AUTO-CORRECT %s | trim D%.1f G%.1f B%.1f V%.1f gsc%.1f", slider7 == 1 ? "STATIC" : (slider7 == 2 ? "DYNAMIC" : "OFF"), TMV[0], TMV[1], TMV[2], TMV[3], TMV[4]);
// Positioned starting at x=310, leaving 32px clear margin from SANKOFA ORACLE title (which ends at x=278)
col(0.03, 0.04, 0.07); rct(306, 18, 118, 34);
slider7 > 0 ? (slider7 == 1 ? col(0.20, 0.92, 0.62) : col(0.00, 0.85, 1.00)) : col(0.38, 0.42, 0.55); rcto(306, 18, 118, 34);
gfx_setfont(3); slider7 > 0 ? (slider7 == 1 ? col(0.20, 0.92, 0.62) : col(0.00, 0.85, 1.00)) : col(0.60, 0.65, 0.75);
sprintf(#trm_short, "%s", slider7 == 1 ? (static_locked ? "CORRECT: LOCK" : "CORRECT: AUTO") : (slider7 == 2 ? "CORRECT: DYN" : "CORRECT: OFF"));
txt(312, 28, #trm_short);

btn(430, 18, 76, 34, "MATRIX", ui_view == 0) ? ( ui_view = 0; slider47 = 0; last_slider47 = 0; slider_automate(slider47); );
btn(512, 18, 86, 34, "STEM A/B", ui_view == 4) ? ( ui_view = 4; slider47 = 4; last_slider47 = 4; slider_automate(slider47); );
btn(604, 18, 120, 34, "PRODUCER DNA", ui_view == 5) ? ( ui_view = 5; slider47 = 5; last_slider47 = 5; slider_automate(slider47); );
btn(730, 18, 92, 34, "MASTERING", ui_view == 2) ? ( ui_view = 2; slider47 = 2; last_slider47 = 2; slider_automate(slider47); );
btn(828, 18, 80, 34, "LIBRARY", ui_view == 1) ? ( ui_view = 1; slider47 = 1; last_slider47 = 1; slider_automate(slider47); );
btn(914, 18, 88, 34, "OLLAMA AI", ui_view == 3) ? ( ui_view = 3; slider47 = 3; last_slider47 = 3; slider_automate(slider47); );


function draw_candy_play(x, y, w, h, title, desc_txt, armed) (
  col(0.04, 0.06, 0.10); rct(x, y, w, h);
  armed ? col(0.20, 0.92, 0.62) : col(0.40, 0.45, 0.55); rcto(x, y, w, h);
  gfx_setfont(3); armed ? col(0.20, 0.92, 0.62) : col(0.70, 0.75, 0.85);
  txt(x + 12, y + 8, title);
  // Badge
  col(armed ? 0.08 : 0.15, armed ? 0.25 : 0.15, armed ? 0.18 : 0.18);
  rct(x + w - 74, y + 6, 64, 18);
  armed ? col(0.20, 0.92, 0.62) : col(0.5, 0.5, 0.5); rcto(x + w - 74, y + 6, 64, 18);
  gfx_setfont(3);
  txt(x + w - 68, y + 9, armed ? "[ARMED]" : "OFF");
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  txt(x + 12, y + 26, desc_txt);
);

function draw_producer_dna() local(cal_st, relay_btn_txt, b_rat, r_rat, w_box, h_box, y_pos) (
  card(24, 86, 972, 692, "PRODUCER BLUEPRINT // KEL PINCHIN (SPLIT CHAIN) - BOOMINESS & BRIGHTNESS RADAR", 1.00, 0.72, 0.02);

  // Top Action Banner: Dual Action Buttons with Zero Text Overlap
  col(0.05, 0.12, 0.18); rct(38, 118, 944, 46);
  col(0.00, 0.85, 1.00); rcto(38, 118, 944, 46);
  gfx_setfont(1); col(0.00, 0.96, 0.83);
  txt(52, 124, "PRODUCER TARGET: KEL PINCHIN");
  gfx_setfont(3); col(0.70, 0.80, 0.95);
  txt(52, 144, "'I'm Not Dying To Be Here' (motionblur)");

  cal_st = gmem[1159];
  btn(520, 126, 210, 30, "[APPLY DE-BOOM & AIR]", 0) ? (
    gmem[1096] = 1; // Trigger apply_deboom_and_vocal_lift.lua
  );
  btn(740, 126, 230, 30, cal_st == 1 ? "[SUITES SYNCED]" : "[RELAY BLUEPRINT]", cal_st == 1) ? (
    gmem[1096] = 1;
  );

  // =========================================================================
  // COLUMN 1 (LEFT, w=464): STEM BALANCE MATRIX & LOW-END BOOMINESS RADAR
  // =========================================================================
  card(38, 172, 464, 590, "STEM BALANCE MATRIX & LOW-END BOOMINESS RADAR", 0.00, 0.96, 0.83);

  // Card 1A: Stem Level Balance Matrix (No Guessing on Vocal/Drum/Bass/Synth levels)
  col(0.04, 0.06, 0.10); rct(50, 206, 440, 160);
  col(0.18, 0.25, 0.38); rcto(50, 206, 440, 160);
  gfx_setfont(3); col(1.00, 0.72, 0.02); txt(62, 214, "STEM LEVEL BALANCE BENCHMARK (REF vs CALIBRATED MIX)");
  
  // Table Header
  gfx_setfont(2); col(0.60, 0.65, 0.75);
  txt(62, 236, "STEM"); txt(140, 236, "REF LUFS"); txt(220, 236, "REL TO DRUMS"); txt(320, 236, "CALIBRATION APPLIED");
  
  // Vocals Row
  col(1.00, 0.40, 0.65); txt(62, 258, "VOCALS");
  col(0.85, 0.90, 1.00); txt(140, 258, "-19.7 LUFS");
  col(0.20, 0.92, 0.62); txt(220, 258, "-2.0 dB");
  col(0.20, 0.92, 0.62); txt(320, 258, "+2.2dB Trim + Donut Hole");

  // Drums Row
  col(0.20, 0.92, 0.62); txt(62, 282, "DRUMS");
  col(0.85, 0.90, 1.00); txt(140, 282, "-17.6 LUFS");
  col(1.00, 0.85, 0.30); txt(220, 282, "0.0 dB (Anchor)");
  col(0.85, 0.90, 1.00); txt(320, 282, "Cymbal Silk + BSA 85%");

  // Bass Row
  col(1.00, 0.72, 0.02); txt(62, 306, "BASS");
  col(0.85, 0.90, 1.00); txt(140, 306, "-19.8 LUFS");
  col(0.20, 0.92, 0.62); txt(220, 306, "-2.2 dB");
  col(0.85, 0.90, 1.00); txt(320, 306, "3.0dB Kick Duck + 90Hz Mono");

  // Other (Gtr/Synth) Row
  col(0.00, 0.85, 1.00); txt(62, 330, "OTHER (GTR)");
  col(0.85, 0.90, 1.00); txt(140, 330, "-14.7 LUFS");
  col(0.00, 0.85, 1.00); txt(220, 330, "+2.9 dB (Sides)");
  col(0.85, 0.90, 1.00); txt(320, 330, "Quad-Wall 1.28x + 95Hz HPF");

  // Card 1B: Boominess vs Sub-Bass Cleanliness Radar (80-200 Hz vs 20-60 Hz)
  col(0.04, 0.06, 0.10); rct(50, 376, 440, 185);
  col(0.18, 0.25, 0.38); rcto(50, 376, 440, 185);
  gfx_setfont(3); col(0.00, 0.96, 0.83); txt(62, 384, "LOW-END BOOMINESS vs SUB-BASS CONTROL GAUGE");
  gfx_setfont(2); col(0.85, 0.90, 1.00);
  txt(62, 404, "Sub-Bass (20-60 Hz):     Ref: 16.3%  |  Mix: 11.1%  (Deficit: -5.2%)");
  txt(62, 422, "Boominess (80-200 Hz):   Ref: 21.6%  |  Mix: 28.5%  (Excess Mud: +6.8%)");
  
  // Ratio Comparison
  col(0.20, 0.92, 0.62); txt(62, 444, "Ref Boom/Sub Ratio: 1.32x (Tight Punch)");
  col(1.00, 0.35, 0.55); txt(280, 444, "Mix Ratio: 2.56x (BOOMY!)");

  // Visual Bars for Boominess Comparison - High Contrast Studio Meter
  bw_ref = floor(416 * (1.32 / 3.0));
  bw_mud = floor(416 * ((2.56 - 1.32) / 3.0));
  
  // Track Container
  col(0.05, 0.07, 0.11); rct(62, 464, 416, 22);
  col(0.20, 0.28, 0.40); rcto(62, 464, 416, 22);
  
  // 1. Ref Clean Baseline Segment (High-Visibility Emerald + Pure Dark Charcoal Text)
  col(0.12, 0.78, 0.50); rct(63, 465, bw_ref - 1, 20);
  gfx_setfont(3);
  gfx_measurestr("REF BASELINE [1.32x]", sw_ref, sh_ref);
  col(0.01, 0.12, 0.06); txt(63 + (bw_ref - sw_ref)*0.5, 468, "REF BASELINE [1.32x]");

  // 2. Excess Mud Segment (Vibrant Coral Red + Crisp Pure White Text)
  col(0.88, 0.22, 0.38); rct(62 + bw_ref, 465, bw_mud, 20);
  gfx_setfont(3);
  gfx_measurestr("+6.8% EXCESS MUD", sw_mud, sh_mud);
  col(1.00, 1.00, 1.00); txt(62 + bw_ref + (bw_mud - sw_mud)*0.5, 468, "+6.8% EXCESS MUD");

  // Calibration Threshold Needle
  col(1.00, 1.00, 1.00); lin(62 + bw_ref, 461, 62 + bw_ref, 489);

  // Remaining Headroom / Scale Cap
  gfx_setfont(2); col(0.45, 0.52, 0.65);
  txt(62 + bw_ref + bw_mud + 14, 468, "3.0x MAX");

  col(0.70, 0.75, 0.85);
  txt(62, 492, "Diagnosis: Upper-bass mud (100-160Hz) is masking sub-bass and vocals.");
  col(0.20, 0.92, 0.62);
  txt(62, 510, "Prescription: -2.5dB mud scoop @ 160Hz, 95Hz Guitar HPF, 3.0dB Kick Duck.");
  txt(62, 528, "Linear-Phase HPF: 28 Hz steep on Mix Bus removes infrasonic clutter.");

  // Card 1C: Brightness & High-End Sheen (5 kHz - 16 kHz)
  col(0.04, 0.06, 0.10); rct(50, 570, 440, 180);
  col(0.18, 0.25, 0.38); rcto(50, 570, 440, 180);
  gfx_setfont(3); col(0.00, 0.85, 1.00); txt(62, 578, "BRIGHTNESS & AIR SHEEN RADAR (5 kHz - 16 kHz)");
  gfx_setfont(2); col(0.85, 0.90, 1.00);
  txt(62, 598, "Brightness Energy (5-16k):  Ref: 2.31%  |  Mix: 0.61%  (Deficit: -1.7%)");
  txt(62, 616, "Spectral Sheen Deficit:     +5.0 to +7.4 dB needed between 5kHz and 10kHz.");
  
  col(0.70, 0.75, 0.85);
  txt(62, 638, "HF Match Applied: +1.8 dB Mix Bus Spectral Tilt + Maag 16kHz Air Sheen.");
  txt(62, 654, "Drums: Cymbal Silk Air Sheen >9kHz set to +2.2 dB.");
  txt(62, 670, "Guitars: Air Sheen & Cab Presence >9kHz set to +1.8 dB.");
  txt(62, 686, "Synths: 12kHz Glassy Air Sheen set to +3.2 dB.");
  col(0.20, 0.92, 0.62);
  txt(62, 706, "STATUS: Brightness matched cleanly without introducing harshness.");

  // =========================================================================
  // COLUMN 2 (RIGHT, w=464): VOCAL UNBURY POCKET & PRODUCER PLAYS
  // =========================================================================
  card(518, 172, 464, 590, "VOCAL UNBURY POCKET & PRODUCER PLAYS (ARMED)", 1.00, 0.40, 0.65);

  // Card 2A: Vocal Unbury Pocket Architecture
  col(0.04, 0.06, 0.10); rct(530, 206, 440, 120);
  col(1.00, 0.40, 0.65); rcto(530, 206, 440, 120);
  gfx_setfont(3); col(1.00, 0.40, 0.65); txt(542, 214, "LEAD VOCAL UNBURY & CENTER POCKET ARCHITECTURE");
  gfx_setfont(2); col(0.85, 0.90, 1.00);
  txt(542, 234, "1. Center Donut-Hole: -3.5 dB Notch @ 2500 Hz on Mix Bus Guitars/Synths.");
  txt(542, 252, "2. Center Vocal Level Trim: +2.2 dB applied via Producer Channel (slider41).");
  txt(542, 270, "3. Track Fader: [VOX] optimized to +1.6 dB (sits 2.0 dB below Drums anchor).");
  col(0.20, 0.92, 0.62);
  txt(542, 290, "4. Serial Dynamics: 1176 FET (28%) + LA-2A (24%) + 1.8kHz bite (+1.5dB).");
  txt(542, 306, "RESULT: Lead vocals cut directly through the wall with radio intimacy.");

  // Card 2B: 7 Producer Signature Plays
  draw_candy_play(530, 334, 440, 44, "PLAY 1: REVERSE VOCAL SWELL", "2.0 Bars before Chorus drop | Vocal Sovereign (slider31=1)", 1);
  draw_candy_play(530, 382, 440, 44, "PLAY 2: PRE-DROP MICRO-SILENCE CHOKE", "80 ms dead silence gap before Chorus drop | Devastator (slider22=80)", 1);
  draw_candy_play(530, 430, 440, 44, "PLAY 3: GUITAR PICK-SCRAPE & SWELL", "Pre-drop riser swell into chorus | Guitar Alchemist (slider42=1)", 1);
  draw_candy_play(530, 478, 440, 44, "PLAY 4: QUAD-WALL CHORUS EXPLOSION", "Width expands to 1.28x on downbeat | Mixing & Guitar Suites", 1);
  draw_candy_play(530, 526, 440, 44, "PLAY 5: BREAKDOWN WHAMMY PITCH DIVE", "Automatic tape stop/divebomb on bridge | Guitar Alchemist (slider45=1)", 1);
  draw_candy_play(530, 574, 440, 44, "PLAY 6: MEGAPHONE / TELEPHONE CHOKE", "Final bar Lo-Fi bandpass filter before drop | Vocal Sovereign (slider32=1)", 1);
  draw_candy_play(530, 622, 440, 44, "PLAY 7: DEVASTATOR SUB DIVEBOMB & BRAAM", "AI Context-Aware trailer impacts | Devastator Suite (Slots 1 & 3)", 1);

  // Live Telemetry Strip
  col(0.04, 0.06, 0.10); rct(530, 674, 440, 75);
  col(0.20, 0.92, 0.62); rcto(530, 674, 440, 75);
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  txt(542, 682, "gmem[820]: Kick -> Bass/Synth Duck (3.0dB) | gmem[840]: Gtr Carve (3.0dB)");
  txt(542, 700, "gmem[880]: Vocal -> Gtr Center Donut Carve | gmem[900]: Neural Braam");
  col(0.20, 0.92, 0.62);
  txt(542, 718, "● LIVE CALIBRATION LOCKED: Vocals Forward | De-Boomed | Brightness Aligned");
);

function draw_mastering_console() local(y_r, pass_tp, pass_sp, pass_ap, pass_yt, num_w, num_h) (
  card(24, 86, 972, 692, "COMPREHENSIVE MASTERING TELEMETRY & EBU R128 COMPLIANCE", 0.00, 0.96, 0.83);
  
  // Row 1: 3 Main Metering Racks
  // 1. EBU R128 Loudness Rack
  card(38, 118, 304, 330, "EBU R128 LOUDNESS METER", 1.00, 0.85, 0.30);
  gfx_setfont(3); col(0.6, 0.65, 0.75);
  txt(52, 150, "INTEGRATED (LUFS-I)");
  gfx_setfont(4);
  int_lufs >= -10.0 ? col(1.00, 0.75, 0.20) : (int_lufs >= -14.5 ? col(0.20, 0.92, 0.62) : col(0.70, 0.85, 1.00));
  sprintf(#v, "%.1f", int_lufs); txt(52, 170, #v);
  gfx_setfont(3); txt(170, 186, "LUFS-I");

  gfx_setfont(3); col(0.6, 0.65, 0.75);
  txt(52, 226, "SHORT-TERM (3s)");
  col(0.85, 0.9, 1.0); sprintf(#v, "Live: %.1f LUFS", lufs_s); txt(52, 244, #v);
  col(0.70, 0.85, 1.00); sprintf(#v, "Max:  %.1f LUFS", lufs_s_max); txt(180, 244, #v);
  fill_bar(52, 262, 276, 12, (lufs_s + 36)/30, abs(lufs_s - (-14))/4);

  col(0.6, 0.65, 0.75);
  txt(52, 292, "MOMENTARY (400ms)");
  col(0.85, 0.9, 1.0); sprintf(#v, "Live: %.1f LUFS", lufs_m); txt(52, 310, #v);
  col(0.70, 0.85, 1.00); sprintf(#v, "Max:  %.1f LUFS", lufs_m_max); txt(180, 310, #v);
  fill_bar(52, 328, 276, 12, (lufs_m + 36)/30, abs(lufs_m - (-14))/4);

  col(0.6, 0.65, 0.75); txt(52, 358, "LOUDNESS RANGE (LRA)");
  gfx_setfont(5); col(0.00, 0.96, 0.83); sprintf(#v, "%.1f LU", lra); txt(52, 380, #v);
  gfx_setfont(2); col(0.55, 0.60, 0.70);
  lra < 4 ? txt(160, 386, "Controlled / Dense") : (lra <= 8 ? txt(160, 386, "Optimal Commercial") : txt(160, 386, "Wide Dynamic Range"));

  // 2. True Peak & Inter-Sample Headroom Rack
  card(358, 118, 304, 330, "TRUE PEAK & ISP HEADROOM", 1.00, 0.35, 0.55);
  gfx_setfont(3); col(0.6, 0.65, 0.75);
  txt(372, 150, "TRUE PEAK MAX");
  gfx_setfont(4);
  tp_db > 0.0 ? col(1.00, 0.25, 0.35) : (tp_db > -1.0 ? col(1.00, 0.85, 0.30) : col(0.20, 0.92, 0.62));
  sprintf(#v, "%+.2f", tp_db);
  gfx_measurestr(#v, num_w, num_h);
  txt(372, 170, #v);
  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(372 + num_w + 12, 186, "dBTP");

  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(372, 226, "CHANNEL PEAKS");
  col(0.85, 0.9, 1.0); sprintf(#v, "Left:  %+.2f dBTP", tp_l_db); txt(372, 244, #v);
  sprintf(#v, "Right: %+.2f dBTP", tp_r_db); txt(496, 244, #v);

  col(0.6, 0.65, 0.75); txt(372, 272, "SAMPLE PEAK VS TRUE PEAK");
  col(0.85, 0.9, 1.0); sprintf(#v, "Sample Pk: %+.2f dBFS", pk_db); txt(372, 290, #v);
  isp_diff = tp_db - pk_db;
  col(1.00, 0.75, 0.20); sprintf(#v, "ISP Delta: +%.2f dB", max(0, isp_diff)); txt(496, 290, #v);

  col(0.6, 0.65, 0.75); txt(372, 318, "INTER-SAMPLE OVERS STATUS");
  isp_overs > 0 ? (
    col(1.00, 0.25, 0.35); rct(372, 338, 276, 28);
    col(1.0, 1.0, 1.0); gfx_setfont(3); sprintf(#v, "WARNING: %d ISP OVERS DETECTED", isp_overs); txt(384, 345, #v);
  ) : (
    col(0.00, 0.25, 0.20); rct(372, 338, 276, 28);
    col(0.20, 0.92, 0.62); rcto(372, 338, 276, 28);
    gfx_setfont(3); col(0.20, 0.92, 0.62); txt(384, 345, "PASS: 0 ISP CLIPPING OVERS (<0 dBTP)");
  );

  col(0.6, 0.65, 0.75); txt(372, 382, "CREST & DYNAMIC RANGE (PLR)");
  col(0.00, 0.96, 0.83); sprintf(#v, "PLR: %.1f dB  |  Crest: %.1f dB", LV[1], LV[2]); txt(372, 400, #v);

  // 3. Streaming Platform Distribution Matrix
  card(678, 118, 304, 330, "STREAMING COMPLIANCE", 0.75, 0.45, 1.00);
  gfx_setfont(3); col(0.5, 0.55, 0.68);
  txt(692, 146, "PLATFORM");
  txt_r(810, 146, "TARGET");
  txt_r(888, 146, "PENALTY");
  txt_r(970, 146, "STATUS");

  y_r = 170;
  // Spotify
  col(0.85, 0.9, 1.0); txt(692, y_r, "Spotify");
  col(0.6, 0.65, 0.75); txt_r(810, y_r, "-14 LUFS");
  pen_spotify > 0.2 ? col(1.00, 0.75, 0.20) : col(0.20, 0.92, 0.62);
  sprintf(#v, "-%.1f dB", pen_spotify); txt_r(888, y_r, #v);
  pen_spotify > 0.2 ? ( col(1.00, 0.75, 0.20); txt_r(970, y_r, "TURN DOWN"); ) : ( col(0.20, 0.92, 0.62); txt_r(970, y_r, "PERFECT"); );

  y_r += 32;
  // Apple Music
  col(0.85, 0.9, 1.0); txt(692, y_r, "Apple");
  col(0.6, 0.65, 0.75); txt_r(810, y_r, "-16 LUFS");
  pen_apple > 0.2 ? col(1.00, 0.75, 0.20) : col(0.20, 0.92, 0.62);
  sprintf(#v, "-%.1f dB", pen_apple); txt_r(888, y_r, #v);
  pen_apple > 0.2 ? ( col(1.00, 0.75, 0.20); txt_r(970, y_r, "SOUNDCHECK"); ) : ( col(0.20, 0.92, 0.62); txt_r(970, y_r, "PERFECT"); );

  y_r += 32;
  // YouTube
  col(0.85, 0.9, 1.0); txt(692, y_r, "YouTube");
  col(0.6, 0.65, 0.75); txt_r(810, y_r, "-14 LUFS");
  pen_youtube > 0.2 ? col(1.00, 0.75, 0.20) : col(0.20, 0.92, 0.62);
  sprintf(#v, "-%.1f dB", pen_youtube); txt_r(888, y_r, #v);
  pen_youtube > 0.2 ? ( col(1.00, 0.75, 0.20); txt_r(970, y_r, "TURN DOWN"); ) : ( col(0.20, 0.92, 0.62); txt_r(970, y_r, "PERFECT"); );

  y_r += 32;
  // Tidal / Amazon
  col(0.85, 0.9, 1.0); txt(692, y_r, "Tidal/Amzn");
  col(0.6, 0.65, 0.75); txt_r(810, y_r, "-14 LUFS");
  pen_tidal > 0.2 ? col(1.00, 0.75, 0.20) : col(0.20, 0.92, 0.62);
  sprintf(#v, "-%.1f dB", pen_tidal); txt_r(888, y_r, #v);
  pen_tidal > 0.2 ? ( col(1.00, 0.75, 0.20); txt_r(970, y_r, "TURN DOWN"); ) : ( col(0.20, 0.92, 0.62); txt_r(970, y_r, "PERFECT"); );

  y_r += 32;
  // Commercial CD / Club
  col(0.85, 0.9, 1.0); txt(692, y_r, "CD / Club");
  col(0.6, 0.65, 0.75); txt_r(810, y_r, "-8.5 LUFS");
  abs(delta_cd) <= 1.0 ? col(0.20, 0.92, 0.62) : (delta_cd > 1.0 ? col(1.00, 0.75, 0.20) : col(0.35, 0.85, 1.00));
  sprintf(#v, "%+.1f dB", delta_cd); txt_r(888, y_r, #v);
  abs(delta_cd) <= 1.0 ? ( col(0.20, 0.92, 0.62); txt_r(970, y_r, "OPTIMAL"); ) : ( delta_cd > 1.0 ? ( col(1.00, 0.75, 0.20); txt_r(970, y_r, "HOT LOUD"); ) : ( col(0.35, 0.85, 1.00); txt_r(970, y_r, "HEADROOM"); ) );

  // Bottom Notice
  col(0.04, 0.05, 0.08); rct(692, 342, 276, 88);
  col(0.20, 0.25, 0.35); rcto(692, 342, 276, 88);
  gfx_setfont(2); col(0.60, 0.65, 0.75);
  txt(702, 350, "Streaming services normalize playback volume.");
  txt(702, 368, "Excess loudness is normalized at target ceiling,");
  txt(702, 386, "preserving punch for CD/WAV distribution.");
  col(0.00, 0.96, 0.83);
  txt(702, 404, "Optimal commercial master: -9 to -7 LUFS.");

  // Row 2: 2 Translation Racks
  // 4. Stereo Phase & Mono Compatibility Rack
  card(38, 464, 460, 290, "STEREO PHASE & TRANSLATION", 0.00, 0.96, 0.83);
  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(52, 496, "STEREO CORRELATION (-1 to +1)");
  col(0.85, 0.9, 1.0); sprintf(#v, "%+.2f", LV[4]); txt(240, 496, #v);
  LV[4] >= 0.30 ? ( col(0.20, 0.92, 0.62); txt(300, 496, "PERFECT STEREO PHASE"); ) : ( LV[4] >= 0.0 ? ( col(1.00, 0.85, 0.30); txt(300, 496, "WIDE (CHECK MONO)"); ) : ( col(1.00, 0.25, 0.35); txt(300, 496, "PHASE CANCELLATION!"); ) );
  dev_bar(52, 518, 430, 16, LV[4], 1.0, LV[4] >= 0.3 ? 1 : (LV[4] >= 0 ? 2 : 3));

  col(0.6, 0.65, 0.75); txt(52, 552, "MONO SUMMING CANCELLATION LOSS");
  mono_loss_db <= 1.5 ? col(0.20, 0.92, 0.62) : (mono_loss_db <= 3.0 ? col(1.00, 0.85, 0.30) : col(1.00, 0.25, 0.35));
  sprintf(#v, "%.2f dB lost in mono", mono_loss_db); txt(52, 572, #v);
  mono_loss_db <= 1.5 ? ( col(0.20, 0.92, 0.62); txt(250, 572, "PASS: Safe for Phones & Mono Bluetooth"); ) : ( col(1.00, 0.75, 0.20); txt(250, 572, "WARNING: Side cancellation on phones"); );

  col(0.6, 0.65, 0.75); txt(52, 608, "SUB-BASS (<100Hz) MONO INTEGRITY");
  sub_mono_pct >= 95.0 ? col(0.20, 0.92, 0.62) : (sub_mono_pct >= 85.0 ? col(1.00, 0.85, 0.30) : col(1.00, 0.25, 0.35));
  sprintf(#v, "%.1f%% Mono Anchor", sub_mono_pct); txt(52, 628, #v);
  sub_mono_pct >= 95.0 ? ( col(0.20, 0.92, 0.62); txt(250, 628, "LOCKED: 100% Club & Vinyl Safe"); ) : ( col(1.00, 0.75, 0.20); txt(250, 628, "Wide sub (Check Mono-Maker cutoff)"); );

  col(0.6, 0.65, 0.75); txt(52, 664, "DC OFFSET DETECTION");
  dc_db <= -70.0 ? col(0.20, 0.92, 0.62) : col(1.00, 0.75, 0.20);
  sprintf(#v, "%.1f dBFS  (%s)", dc_db, dc_db <= -70.0 ? "CLEAN" : "DC FILTER RECOMMENDED"); txt(52, 684, #v);

  // 5. Inter-Suite Health & Closed-Loop Trims Rack
  card(518, 464, 464, 290, "MASTER BUS INTERLOCK & HEALTH", 0.20, 0.92, 0.62);
  gfx_setfont(3); col(0.6, 0.65, 0.75); txt(532, 496, "KICK-TO-SUB PHASE INTERLOCK");
  sub_corr >= 0.30 ? col(0.20, 0.92, 0.62) : (sub_corr >= 0.0 ? col(1.00, 0.85, 0.30) : col(1.00, 0.25, 0.35));
  sprintf(#v, "%+.2f (%s)", sub_corr, sub_corr >= 0.30 ? "LOCKED IN-PHASE" : (sub_corr >= 0 ? "PARTIAL" : "PHASE OPPOSITION"));
  txt(532, 516, #v);

  col(0.6, 0.65, 0.75); txt(532, 552, "LEAD VOCAL POCKET DEPTH");
  vox_act ? (
    status_col(abs(vox_dv) <= 1.5 ? 1 : 2);
    sprintf(#v, "%+.1f dB relative to Master (Target: %+.1f dB)", vox_rel_mst, vox_target); txt(532, 572, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(532, 572, "Vocal Suite Telemetry Inactive");
  );

  col(0.6, 0.65, 0.75); txt(532, 608, "DRUM SHELL TRANSIENT CREST");
  drum_act ? (
    col(0.85, 0.9, 1.0); sprintf(#v, "%.1f dB (Target: 9.5 dB punch)", drum_crest); txt(532, 628, #v);
  ) : (
    col(0.5, 0.55, 0.68); txt(532, 628, "Drum Suite Telemetry Inactive");
  );

  col(0.6, 0.65, 0.75); txt(532, 664, "AUTONOMOUS SUITE CORRECTION ENGINE");
  slider7 > 0 ? (slider7 == 1 ? col(0.20, 0.92, 0.62) : col(0.00, 0.85, 1.00)) : col(0.5, 0.55, 0.68);
  sprintf(#v, "Correction Engine: %s  |  Max Trim: %.1f dB", slider7 == 1 ? (static_locked ? "STATIC LOCKED (FROZEN)" : "LOCKING...") : (slider7 == 2 ? "PSYCHOACOUSTIC SLOW DYNAMIC" : "BYPASS"), slider8); txt(532, 684, #v);

  btn(532, 712, 160, 26, "RESET PEAK HOLDS", 0) ? (
    true_pk = 0; true_pk_l = 0; true_pk_r = 0;
    lufs_m_max = -70; lufs_s_max = -70;
    isp_overs = 0;
  );
  btn(704, 712, 160, 26, "< RETURN TO MATRIX", 1) ? (
    ui_view = 0;
  );
);


function draw_ollama_console() local(y_m) (
  card(24, 86, 972, 692, "OLLAMA LOCAL AUDIO AI & MIR CRITIC  (DirectML / NVIDIA RTX 3060)", 0.00, 0.96, 0.83);
  
  // Status Header
  card(38, 118, 944, 52, "LOCAL ENGINE STATUS", 0.20, 0.92, 0.62);
  gfx_setfont(3); col(0.20, 0.92, 0.62);
