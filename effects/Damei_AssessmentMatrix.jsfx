    i == 0 ? strcpy(out, "Alpha Wolf - 60cm Of Steel") :
    i == 1 ? strcpy(out, "DIESECT - Too Many Scars") :
    i == 2 ? strcpy(out, "Mirrorcell - U(phoria)") :
