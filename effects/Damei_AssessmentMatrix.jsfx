  col(0.20, 0.92, 0.62); txt(410, y_m + 8, "[ACTIVE]");
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  txt(62, y_m + 28, "Family: Qwen2.5-Coder (7B GGUF Q4_K_M) | Size: 4.68 GB");
  txt(62, y_m + 46, "Role: Cognitive Mix Agent, Masking Reasoning & ReaScript Prescriptions");
  col(0.50, 0.55, 0.65); txt(62, y_m + 64, "Endpoint: /api/generate & /api/cognitive_mix_engineer (RTX 3060)");

  y_m += 90;
  // Model 2: BS-RoFormer
  col(0.06, 0.08, 0.12); rct(50, y_m, 456, 80);
  col(0.38, 0.42, 0.55); rcto(50, y_m, 456, 80);
  gfx_setfont(3); col(0.85, 0.90, 1.00); txt(62, y_m + 8, "bs-roformer-6stem:latest");
  col(0.20, 0.92, 0.62); txt(410, y_m + 8, "[READY]");
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  txt(62, y_m + 28, "Family: DirectML RTX 3060 Demix (ONNX FP16) | Size: 320 MB");
  txt(62, y_m + 46, "Role: 6-Stem Audio Separation (Drums, Bass, Guitars, Vocals, Synths, FX)");
  col(0.50, 0.55, 0.65); txt(62, y_m + 64, "Acceleration: DirectML ONNX Execution Provider");

  y_m += 90;
  // Model 3: LAION-CLAP Tagger
  col(0.06, 0.08, 0.12); rct(50, y_m, 456, 80);
  col(0.38, 0.42, 0.55); rcto(50, y_m, 456, 80);
  gfx_setfont(3); col(0.85, 0.90, 1.00); txt(62, y_m + 8, "laion-clap-tagger:latest");
  col(0.20, 0.92, 0.62); txt(410, y_m + 8, "[READY]");
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  txt(62, y_m + 28, "Family: Audio Embedding (HTSAT Fused ONNX) | Size: 600 MB");
  txt(62, y_m + 46, "Role: Reference DNA Extraction, Multi-Track Similarity & Genre Tagger");
  col(0.50, 0.55, 0.65); txt(62, y_m + 64, "Endpoint: /api/deconstruct feature extractor");

  y_m += 90;
  // Model 4: CCMusic Structure
  col(0.06, 0.08, 0.12); rct(50, y_m, 456, 80);
  col(0.38, 0.42, 0.55); rcto(50, y_m, 456, 80);
  gfx_setfont(3); col(0.85, 0.90, 1.00); txt(62, y_m + 8, "ccmusic-structure:latest");
  col(0.20, 0.92, 0.62); txt(410, y_m + 8, "[READY]");
  gfx_setfont(2); col(0.70, 0.75, 0.85);
  txt(62, y_m + 28, "Family: CQT MIR Segmentation | Size: 180 MB");
  txt(62, y_m + 46, "Role: Automated Song Structure & Boundary Detection (Verse, Chorus, Bridge)");
  col(0.50, 0.55, 0.65); txt(62, y_m + 64, "Sync: Dynamic Region Alignment Engine");

  y_m += 90;
