desc:Damei Sankofa Oracle (Reference Match Analyzer & Suite Auto-Correct - Tandem with Mixing Suite)
author:Damei
version:1.0
about:
  Insert AFTER the Damei Mixing Suite on the mix master (or after Ozone Suite in the mastering project).
  Audio passes through untouched. Measures 7-band tonal balance, per-band stereo width, correlation,
  integrated LUFS, peak, crest, PLR and LRA, then scores them against the reference fingerprint of the
  producer preset selected in the Mixing Suite (read live over gmem), or against a Captured Reference
  (play any reference track through this plugin, press CAPTURE REF).
  Fingerprints were measured offline from H:\REFERENCES with the identical band filters (gen_fingerprints.py).

// ----------------------------------------------------------------------------
// OPTIONS - shares the Mixing Suite gmem namespace; this plugin writes gmem[1100..1125] only.
// ----------------------------------------------------------------------------
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=65536

slider1:0<0,1,1{Follow Mixing Suite Preset,Manual Preset}>-Reference Source
slider2:18<0,24,1>-Manual Preset Index (0-24)
slider3:0<0,3,1{Producer Preset Reference,Captured Reference,Library Track,Live Sidechain (Pins 3/4)}>-Compare Against
slider9:16<0,24,1>-Library Reference Track (0-24)
slider4:0<0,1,1{Mix Bus Stage (tonal+stereo scored),Master Stage (loudness+dynamics scored too)}>-Assessment Stage
slider5:0<0,1,1{Run,Hold}>-Analysis
slider6:1<0,1,1{Off,On}>-Auto-Reset On Transport Play
slider7:1<0,2,1{Off,Static Calibration Lock,Psychoacoustic Slow Dynamic}>-Auto-Correct Suites (publishes trim lane to the 6 suites)
slider8:3.5<0.5,4.0,0.5>-Max Trim Per Suite (dB)
slider10:0<0,1,1{Normal Processing Active,Audit Raw Mix (Bypass Mixing Suite)}>-Raw Mix Audit Mode
slider11:0<0,4,1{Full Master,Drums,Bass,Vocals,Other / Synth}>-Stem Profile Target
slider12:0<0,3,1{Monitor Mix (Pins 1/2),Monitor Ref Matched (Pins 3/4),Monitor Ref Raw,Auditory Delta Null (Mix - Ref)}>-Monitor Output Mode
slider13:0<-18,18,0.1>-Manual Ref Gain Trim (dB)
slider14:1<0,1,1{Manual Trim,Auto-Matched LUFS}>-Ref Gain Match Mode
slider47:0<0,5,1{Matrix,Library,Mastering,Ollama AI,Stem A/B,Producer DNA}>-Active Console View

in_pin:Mix L
in_pin:Mix R
in_pin:Ref L (Sidechain)
in_pin:Ref R (Sidechain)
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;

// ---- memory map -------------------------------------------------------------
FP   = 0;      // 24 fingerprints x 32 slots = 768 floats
BQC  = 1000;   // band filter coefficients: 14 filters x 5
BQS  = 1100;   // band filter states: 2 chains x 14 x 2
EDG  = 1400;   // band edges (8)
ACC  = 1300;   // per band: [eM, eS]
KC   = 1500;   // K-weighting coeffs (2 x 5)
KS   = 1520;   // K-weighting states (4 x 2)
HSTG   = 2000;   // integrated loudness histogram (400 bins, 0.2 LU)
HS   = 2500;   // short-term histogram (120 bins, 0.5 LU)
RB   = 3000;   // 30 x 100 ms block powers
CAP  = 3200;   // captured reference (32)
LIB  = 4000;   // reference library: 24 tracks x 32 slots (same layout as FP)
LPR  = 4800;   // library track -> producer preset index (-1 = none)
LM   = 4840;   // live match % of the mix against each library track
LV   = 3300;   // live metrics (20)
DV   = 3400;   // deviations (20)
DEVF   = 3430;   // normalised deviations (20)
SEV  = 3460;   // recommendation severity (40)
TMV  = 3830;
RC   = 3510;   // top recommendations (4)
BA   = 3600;   // per-block band energy accumulators (14)
EM   = 3620;   // EMA band energies (14), tau = 8 s
WT   = 3700;   // owner weights: 6 suites x 7 bands
TT   = 3760;   // integrated trims (dB): 6 suites x 7 bands
WGTS   = 3810;   // width weights (6)
TW   = 3820;   // width trims (dB) (6)
RAW_FP = 5000;   // captured raw metrics (20)
RAW_DV = 5040;   // raw deviations (20)

// ---- stem & live sidechain memory map -----------------------------------------
BQS_REF   = 5200;   // 56 floats: band filter states for reference [m, s]
KS_REF    = 5260;   // 8 floats: K-weighting states for reference
ACC_REF   = 5280;   // 14 floats: band energy accumulators for reference [eM, eS]
BA_REF    = 5300;   // 14 floats: block energy accumulators for reference
RB_REF    = 5320;   // 30 floats: 100ms block powers for reference
HSTG_REF  = 5400;   // 400 floats: integrated loudness histogram for reference
HS_REF    = 5850;   // 120 floats: short-term histogram for reference
LIVE_REF  = 6000;   // 32 floats: live metrics for reference
BAND_DIFF = 6040;   // 7 floats: live band energy delta in dB (Mix vs Ref)
BAND_XCORR= 6050;   // 7 floats: band cross-correlation between Mix and Ref
ACC_XCORR = 6060;   // 7 floats: accumulators for cross correlation
STEM_FP   = 6100;   // 5 stem profiles x 32 slots = 160 floats

// ---- fingerprints (generated) - DO NOT EDIT BY HAND ----------------------------
