show_adv_metrics ? (
  gfx_setfont(3); col(0.5, 0.55, 0.68); txt(36, 516, "METRIC"); txt(126, 516, "VALUE"); txt(206, 516, "STATUS");
  have_data ? (
    gfx_setfont(2);
    // Row 1: Sub Side Leakage (<100Hz)
    col(0.85, 0.9, 1.0); txt(36, 534, "Sub Leak");
    sprintf(#v, "%.1f%%", sub_side_pct); txt(126, 534, #v);
    sub_side_pct <= 5.0 ? ( col(0.20, 0.92, 0.62); txt(206, 534, "MONO OK"); ) :
    sub_side_pct <= 12.0 ? ( col(1.00, 0.85, 0.30); txt(206, 534, "MILD SIDE"); ) :
    ( col(1.00, 0.35, 0.55); txt(206, 534, "SIDE LEAK!"); );

    // Row 2: L/R RMS Balance Asymmetry
    col(0.85, 0.9, 1.0); txt(36, 553, "L/R Bal");
    sprintf(#v, "%+.2fdB", lr_asym_db); txt(126, 553, #v);
    abs(lr_asym_db) <= 0.35 ? ( col(0.20, 0.92, 0.62); txt(206, 553, "CENTERED"); ) :
    abs(lr_asym_db) <= 0.80 ? ( col(1.00, 0.85, 0.30); txt(206, 553, lr_asym_db > 0 ? "L-TILT" : "R-TILT"); ) :
    ( col(1.00, 0.35, 0.55); txt(206, 553, lr_asym_db > 0 ? "L-HEAVY!" : "R-HEAVY!"); );

    // Row 3: Presence Crest Factor (1-6 kHz Snare & Vocal Snap)
    col(0.85, 0.9, 1.0); txt(36, 572, "Pres Crest");
    sprintf(#v, "%.1fdB", pres_crest_db); txt(126, 572, #v);
    pres_crest_db >= 9.5 && pres_crest_db <= 14.5 ? ( col(0.20, 0.92, 0.62); txt(206, 572, "SNARE SNAP"); ) :
    pres_crest_db < 9.5 ? ( col(1.00, 0.85, 0.30); txt(206, 572, "DENSE"); ) :
    ( col(0.70, 0.85, 1.00); txt(206, 572, "DYNAMIC"); );

    // Row 4: Vocal-to-Instrumental Masking Index
    col(0.85, 0.9, 1.0); txt(36, 591, "Vox Mask");
    vox_act ? (
      sprintf(#v, "%.0f%%", vox_mask_idx); txt(126, 591, #v);
      vox_mask_idx <= 25.0 ? ( col(0.20, 0.92, 0.62); txt(206, 591, "UNMASKED"); ) :
      vox_mask_idx <= 45.0 ? ( col(1.00, 0.85, 0.30); txt(206, 591, "MODERATE"); ) :
      ( col(1.00, 0.35, 0.55); txt(206, 591, "MASKED!"); );
    ) : (
      col(0.5, 0.55, 0.68); txt(126, 591, "--"); txt(206, 591, "no vocal");
    );

    // Row 5: Chorus Macro Dynamic Lift
    col(0.85, 0.9, 1.0); txt(36, 610, "Chorus Lift");
    sprintf(#v, "%+.1f LU", chorus_lift_db); txt(126, 610, #v);
    chorus_lift_db >= 1.5 ? ( col(0.20, 0.92, 0.62); txt(206, 610, "SLAM"); ) :
    chorus_lift_db >= 0.6 ? ( col(1.00, 0.85, 0.30); txt(206, 610, "MODERATE"); ) :
    ( col(0.55, 0.60, 0.70); txt(206, 610, "SUBTLE"); );

    // Row 6: Chorus Width Bloom Expansion
    col(0.85, 0.9, 1.0); txt(36, 629, "Bloom Lift");
    sprintf(#v, "%.2fx", chorus_width_lift); txt(126, 629, #v);
    chorus_width_lift >= 1.08 ? ( col(0.20, 0.92, 0.62); txt(206, 629, "BLOOM"); ) :
    ( col(0.70, 0.80, 0.95); txt(206, 629, "BALANCED"); );
  ) : (
    gfx_setfont(3); col(0.6, 0.65, 0.75); txt(44, 550, "Awaiting audio stream...");
  );
) : (
  // Neatly framed control buttons with uniform margins & zero border spillage
  btn(34, 518, 136, 26, "RESET ANALYSIS", 0) ? ( reset_req = 1; );
  btn(178, 518, 136, 26, slider5 ? "HELD (RUN)" : "RUNNING", slider5 == 0) ? ( slider5 = !slider5; slider_automate(slider5); );
  btn(34, 548, 136, 26, mir_status == 2 ? "[ANALYZING...]" : (mir_status == 3 ? "[STEM DNA LOADED]" : "[DECONSTRUCT REF]"), mir_status == 3) ? (
    gmem[1090] = 1;
  );
  btn(178, 548, 136, 26, "CAPTURE REF", 0) && have_data ? (
    ci = 0; loop(20, CAP[ci] = LV[ci]; ci += 1; ); CAP[31] = 1; cap_valid = 1; slider3 = 1; slider_automate(slider3);
  );
  btn(34, 578, 136, 26, slider4 ? "STAGE: MASTER" : "STAGE: MIX BUS", slider4) ? ( slider4 = !slider4; slider_automate(slider4); );
  btn(178, 578, 136, 26, slider1 ? "PRESET: MANUAL" : "PRESET: FOLLOW MIX", slider1 == 0) ? ( slider1 = !slider1; slider_automate(slider1); );
  btn(34, 608, 65, 22, "< PREV", 0) ? ( slider1 = 1; slider2 = (slider2 + 24) % 25; slider_automate(slider1); slider_automate(slider2); );
  btn(105, 608, 65, 22, "NEXT >", 0) ? ( slider1 = 1; slider2 = (slider2 + 1) % 25; slider_automate(slider1); slider_automate(slider2); );
  btn(178, 608, 136, 22, slider6 ? "AUTO-RESET: ON" : "AUTO-RESET: OFF", slider6) ? ( slider6 = !slider6; slider_automate(slider6); );

  btn(34, 632, 136, 20, slider7 == 1 ? "CORRECT: STATIC" : (slider7 == 2 ? "CORRECT: DYNAMIC" : "CORRECT: OFF"), slider7 > 0) ? (
    slider7 = (slider7 + 1) % 3;
    static_locked = 0;
    lock_timer = 0;
    slider_automate(slider7);
  );
  btn(178, 632, 136, 20, "CLEAR TRIMS", 0) ? ( ci = 0; loop(42, TT[ci] = 0; ci += 1; ); ci = 0; loop(6, TW[ci] = 0; ci += 1; ); );
);

