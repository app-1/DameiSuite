desc:Damei Devastator Suite (Cinematic Hybrid FX & AI Co-Pilot)
// =============================================================================
// DAMEI DEVASTATOR SUITE // THE 6TH PILLAR (v3.7 Master Hybrid Engine)
// Internal Virtual Sampler + Timeline Baker + Vital-Style Envelopes
// Tactile Carbon Obsidian, Brushed Gunmetal, Blood Crimson & Tactical Amber
// Built by Damei Audio & Antigravity IDE
// =============================================================================

slider1:0<0,3,1{1. Devastator Hub & Vital Envelopes,2. Reactor Core & DSP Sound Bays,3. Tonal ReEQ & Master Compressor,4. Producer Trailer Playbook}>-Main Suite View Mode
slider2:3<0,8,1{Jordan Fish (Bring Me The Horizon),Mick Gordon (DOOM / Wolfenstein),Chris Bedan (ONI NOIRE / KeepForest),Dan Braunstein (Spiritbox / Dayseeker),Buster Odeholm (thrown / Northlane),Bad Omens (THE DEATH OF PEACE OF MIND),Lance Prenc (Alpha Wolf / Polaris),George Lever (Loathe / Sleep Token),Kel Pinchin (Split Chain)}>-Producer Cinematic Blueprint
slider3:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Song Root Key Note
slider4:1<0,2,1{Manual Trigger,AI Context-Aware Auto-Trigger (Energy Delta Reasoning),Full Auto Region Sync}>-AI Creative Decision Mode
slider5:-1.5<-24.0,6.0,0.5>-Master Sub-Bed Trim (dB) [Subtle Mix Integration]
slider6:1<0,1,1{Off,Active Dynamic Ducking vs Drum Kick & Snare (gmem 820)}>-Drum Bus Ducking Interlock
slider7:1<0,1,1{Off,Active Pocket Carve vs Lead Vocal (gmem 880)}>-Lead Vocal Pocket Protection
slider8:1<0,1,1{Off,Active Sub-Foundation Carve vs Guitars (gmem 840)}>-Guitar Wall Low-Mid Handshake
slider9:1<0,2,1{Transparent Linear,Soft Tube Hermite,Hard Industrial Clip}>-Mix Bus Headroom Clipper
slider10:-0.1<-12.0,-0.1,0.1>-Headroom Ceiling (dBTP)

// Slot 1: Trailer Brass & Reese Braam
slider11:1<0,1,1{Bypassed,Active}>-Slot 1: Trailer Braam Active
slider12:42<10,100,1>-Braam Drive & Wavefolding Saturation (%)
slider13:190<60,800,10>-Braam Low-Pass Cutoff (Hz)
slider14:1.35<0.8,2.0,0.05>-Braam Stereo Width Spread
slider15:3.2<0.5,8.0,0.1>-Braam Decay Length (Sec)
slider16:20<0,500,5>-Slot 1: Attack (Fade-In ms)
slider17:3200<200,8000,50>-Slot 1: Release (Fade-Out ms)
slider18:0.0<-24.0,6.0,0.5>-Slot 1: Volume Trim (dB)

// Slot 2: Reversed Suck-Back & Pre-Drop Choke
slider20:1<0,1,1{Bypassed,Active}>-Slot 2: Reversed Suck-Back Active
slider21:2.0<0.5,6.0,0.05>-Suck-Back Duration (Sec)
slider22:80<0,250,5>-Pre-Drop Micro-Silence Choke (ms)
slider23:70<20,100,1>-Suck-Back Resonance & Comb Density (%)
slider24:3500<1000,8000,100>-Suck-Back High-Shelf Rolloff (Hz)
slider25:800<50,3000,50>-Slot 2: Swell Attack (Fade-In ms)
slider26:80<10,500,5>-Slot 2: Choke Gap (Fade-Out ms)
slider27:0.0<-24.0,6.0,0.5>-Slot 2: Volume Trim (dB)

// Slot 3: Sub Divebomb & 808 Impact
slider30:1<0,1,1{Bypassed,Active}>-Slot 3: Sub Divebomb Active
slider31:65<40,110,1>-Sub Drop Start Frequency (Hz)
slider32:28<16,36,1>-Sub Drop End Frequency (Hz)
slider33:1.6<0.4,4.0,0.1>-Sub Drop Exponential Decay (Sec)
slider34:18<0,100,1>-Sub Harmonic Tip Saturation (%)
slider35:5<0,200,5>-Slot 3: Attack Punch (ms)
slider36:1600<200,6000,50>-Slot 3: Sub Decay (Fade-Out ms)
slider37:0.0<-24.0,6.0,0.5>-Slot 3: Volume Trim (dB)

// Slot 4: Cyber Riser & Ambient Pad
slider40:1<0,1,1{Bypassed,Active}>-Slot 4: Ambient Pad & Riser Active
slider41:2.0<0.5,8.0,0.5>-Riser Sweep Bars (Bars)
slider42:0<0,4,1{Smooth,1/16 Stutter,1/32 Glitch,1/64 Industrial Granular,Tape Stop}>-Glitch Stutter Mode
slider43:1200<50,4000,50>-Slot 4: Attack / Swell (Fade-In ms)
slider44:2500<200,8000,50>-Slot 4: Decay / Fade-Out (ms)
slider45:0.0<-24.0,6.0,0.5>-Slot 4: Volume Trim (dB)

// Spectrum Anchors & Spatial Placement
slider46:1<0,1,1{Off (Stereo Sub),Active Sub Mono Anchor (<90Hz)}>-Sub Mono Anchor (<90Hz)
slider47:1.25<0.5,2.0,0.05>-M/S Spatial Widener Spread
slider48:20<0,100,1>-Tape / Hermite Saturation Warmth (%)

// Global Engine Switch: 0=Internal Virtual Sampler (Clean Timeline), 1=Timeline Audio Clips
slider49:0<0,1,1{Internal Virtual Sampler (Clean Timeline),Timeline Audio Clips (Baked)}>-Playback Engine Mode

// Surgical ReEQ (4-Band Mix-Fit)
slider50:1<0,1,1{Bypassed,Active}>-ReEQ Master Processing
slider51:30<20,100,1>-ReEQ Band 1: Subsonic HPF (Hz)
slider52:320<160,800,10>-ReEQ Band 2: Anti-Mud Center Freq (Hz)
slider53:-3.5<-12.0,6.0,0.5>-ReEQ Band 2: Anti-Mud Gain (dB)
slider54:3200<1600,6000,50>-ReEQ Band 3: Vocal Pocket Freq (Hz)
slider55:-2.5<-12.0,6.0,0.5>-ReEQ Band 3: Vocal Pocket Gain (dB)
slider56:12000<6000,16000,100>-ReEQ Band 4: Air Shelf Freq (Hz)
slider57:2.0<-9.0,9.0,0.5>-ReEQ Band 4: Air Shelf Gain (dB)

// Master VCA Glue & Punch Compressor
slider58:1<0,1,1{Bypassed,Active}>-VCA Compressor Master
slider59:-18.0<-36.0,0.0,0.5>-VCA Comp: Threshold (dB)
slider60:3.0<1.5,8.0,0.1>-VCA Comp: Ratio
slider61:25<5,80,1>-VCA Comp: Attack Time (ms)
slider62:120<30,500,5>-VCA Comp: Release Time (ms)
slider63:3.0<0.0,18.0,0.5>-VCA Comp: Makeup Gain (dB)

// AI Mix-Fit Advisor (trims on top of the producer blueprint; reads all suites via gmem)
slider64:1<0,1,1{Off,Auto Mix-Fit (AI trims EQ & Comp to the live project)}>-AI Mix-Fit Advisor
slider65:70<0,100,1>-AI Mix-Fit Strength (%)

slider66:1<0,1,1{Off,On}>-Matrix Trim (applies Assessment Matrix auto-correct lane)
slider67:1<0,1,1{Classic Smart Triggers,Producer Playbook (Region + Energy Aware)}>-Trailer Playbook Mode
slider68:1<0,2,1{Signature Only,Producer Playbook,Full Arsenal}>-Trailer Playbook Intensity
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=2097152
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

