    slider21 = 2.5; slider22 = 60; slider24 = 3000;
    slider25 = 900; slider26 = 60; slider27 = 0.0;
    slider31 = 60; slider32 = 20; slider34 = 45; slider42 = 3;
    slider35 = 2; slider36 = 2200; slider37 = 0.0;
    slider46 = 1; slider47 = 1.20; slider48 = 45;
    slider50 = 1; slider51 = 25; slider52 = 280; slider53 = -1.5; slider54 = 3500; slider55 = -1.0; slider56 = 9000; slider57 = 1.0;
    slider58 = 1; slider59 = -20.0; slider60 = 4.5; slider61 = 15; slider62 = 90; slider63 = 3.0;
  ) : p_idx == 2 ? ( // Chris Bedan (ONI NOIRE)
    slider5 = -1.5; slider12 = 65; slider13 = 140; slider14 = 1.35; slider15 = 2.8;
    slider16 = 25; slider17 = 2600; slider18 = 0.0;
    slider21 = 2.29; slider22 = 50; slider24 = 3500;
    slider25 = 750; slider26 = 50; slider27 = 0.0;
    slider31 = 62; slider32 = 24; slider34 = 25; slider42 = 1;
    slider35 = 5; slider36 = 1500; slider37 = 0.0;
    slider46 = 1; slider47 = 1.35; slider48 = 22;
    slider50 = 1; slider51 = 30; slider52 = 310; slider53 = -3.0; slider54 = 3200; slider55 = -2.5; slider56 = 12000; slider57 = 2.0;
    slider58 = 1; slider59 = -18.0; slider60 = 3.2; slider61 = 25; slider62 = 110; slider63 = 3.0;
