@init

buf_sz = 160;
buf_in_idx = 0;
buf_wave_arr = 10000;
buf_spec_arr = 10200;
buf_sub_arr  = 10400;

braam_phase_l = 0.0;
braam_phase_r = 0.0;
sub_phase = 0.0;
sub_curr_freq = 60.0;
sub_active = 0;
sub_env = 0.0;

suck_active = 0;
suck_time = 0.0;
suck_env = 0.0;

// Smart structure-trigger state (one-shot latches)
dv_last_fire_t = -100;
dv_fire_chorus_abs = -1000;
dv_sub_rgn = -1;
dv_last_pos = 0;

ai_action_notify = 0;
ai_action_text = "";
ai_action_time = 0;

noise_seed = 1234567;
function rand_noise() (
  noise_seed = (noise_seed * 1103515245 + 12345) & $x7fffffff;
  (noise_seed / $x3fffffff) - 1.0;
);

lp_x1 = 0; lp_x2 = 0; lp_y1 = 0; lp_y2 = 0;
sb_lp_x1 = 0; sb_lp_x2 = 0; sb_lp_y1 = 0; sb_lp_y2 = 0;

// ReEQ Filter States (L & R)
hpf_x1_l = 0; hpf_x2_l = 0; hpf_y1_l = 0; hpf_y2_l = 0;
hpf_x1_r = 0; hpf_x2_r = 0; hpf_y1_r = 0; hpf_y2_r = 0;

lomid_x1_l = 0; lomid_x2_l = 0; lomid_y1_l = 0; lomid_y2_l = 0;
lomid_x1_r = 0; lomid_x2_r = 0; lomid_y1_r = 0; lomid_y2_r = 0;

voxeq_x1_l = 0; voxeq_x2_l = 0; voxeq_y1_l = 0; voxeq_y2_l = 0;
voxeq_x1_r = 0; voxeq_x2_r = 0; voxeq_y1_r = 0; voxeq_y2_r = 0;

air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;

// Sub Mono Crossover (<90Hz) States
subx_x1_l = 0; subx_x2_l = 0; subx_y1_l = 0; subx_y2_l = 0;
subx_x1_r = 0; subx_x2_r = 0; subx_y1_r = 0; subx_y2_r = 0;

// VCA Compressor States
cur_comp_gr_db = 0.0;
live_comp_gr_db = 0.0;
ai_fit_score = 100;
bed_att = exp(-1.0 / (0.3 * srate));
bed_vu = 0.0; bed_pk = 0.0;

function update_devastator_filters() (
  w0 = 2.0 * $pi * slider13 / srate;
  cos_w = cos(w0); sin_w = sin(w0);
  alpha = sin_w / (2.0 * 0.90);
  lp_b0 = (1.0 - cos_w) * 0.5;
  lp_b1 = 1.0 - cos_w;
  lp_b2 = (1.0 - cos_w) * 0.5;
  lp_a0 = 1.0 + alpha;
  lp_a1 = -2.0 * cos_w;
  lp_a2 = 1.0 - alpha;
  lp_b0 /= lp_a0; lp_b1 /= lp_a0; lp_b2 /= lp_a0; lp_a1 /= lp_a0; lp_a2 /= lp_a0;

  sw0 = 2.0 * $pi * slider24 / srate;
  scos = cos(sw0); ssin = sin(sw0);
  salpha = ssin / (2.0 * 0.707);
  sb_lp_b0 = (1.0 - scos) * 0.5;
  sb_lp_b1 = 1.0 - scos;
  sb_lp_b2 = (1.0 - scos) * 0.5;
  sb_lp_a0 = 1.0 + salpha;
  sb_lp_a1 = -2.0 * scos;
  sb_lp_a2 = 1.0 - salpha;
  sb_lp_b0 /= sb_lp_a0; sb_lp_b1 /= sb_lp_a0; sb_lp_b2 /= sb_lp_a0; sb_lp_a1 /= sb_lp_a0; sb_lp_a2 /= sb_lp_a0;
);

// Effective parameters = user/blueprint slider + bounded AI trim (never moves the user's sliders)
function compute_eff() local(k) (
  k = slider64 ? slider65 * 0.01 : 0.0;
  eff_hpf      = max(10, min(300, slider51 + k * ai_off_hpf));
  eff_lm_gain  = slider53 + k * ai_off_lm;
  eff_vx_gain  = slider55 + k * ai_off_vx;
  eff_air_gain = slider57 + k * ai_off_air;
  eff_thr      = slider59 + k * ai_off_thr;
  eff_makeup   = slider63 + k * ai_off_mk;
  eff_width    = max(0.5, min(2.0, slider47 + k * ai_off_w));
  eff_sat      = max(0.0, min(100.0, slider48 + k * ai_off_sat));
);

function update_reeq_and_comp_coefficients() (
  compute_eff();
  // 1. HPF (Band 1: Subsonic Butterworth 12dB/oct)
  w0_hp = 2.0 * $pi * eff_hpf / srate;
  cos_hp = cos(w0_hp); sin_hp = sin(w0_hp);
  alpha_hp = sin_hp / (2.0 * 0.7071);
  a0_hp = 1.0 + alpha_hp;
  hpf_b0 = ((1.0 + cos_hp) * 0.5) / a0_hp;
  hpf_b1 = (-(1.0 + cos_hp)) / a0_hp;
  hpf_b2 = ((1.0 + cos_hp) * 0.5) / a0_hp;
  hpf_a1 = (-2.0 * cos_hp) / a0_hp;
  hpf_a2 = (1.0 - alpha_hp) / a0_hp;

  // 2. Lo-Mid Anti-Mud Bell (Band 2)
  A2 = exp(eff_lm_gain * (log(10.0) / 40.0));
  w2 = 2.0 * $pi * max(80, min(1500, slider52)) / srate;
  cos2 = cos(w2); sin2 = sin(w2);
  alpha2 = sin2 / (2.0 * 1.30);
  a0_2 = 1.0 + alpha2 / A2;
  lomid_b0 = (1.0 + alpha2 * A2) / a0_2;
  lomid_b1 = (-2.0 * cos2) / a0_2;
  lomid_b2 = (1.0 - alpha2 * A2) / a0_2;
  lomid_a1 = (-2.0 * cos2) / a0_2;
  lomid_a2 = (1.0 - alpha2 / A2) / a0_2;

  // 3. Lead Vocal Pocket Bell (Band 3)
  A3 = exp(eff_vx_gain * (log(10.0) / 40.0));
  w3 = 2.0 * $pi * max(1000, min(8000, slider54)) / srate;
  cos3 = cos(w3); sin3 = sin(w3);
  alpha3 = sin3 / (2.0 * 1.25);
  a0_3 = 1.0 + alpha3 / A3;
  voxeq_b0 = (1.0 + alpha3 * A3) / a0_3;
  voxeq_b1 = (-2.0 * cos3) / a0_3;
  voxeq_b2 = (1.0 - alpha3 * A3) / a0_3;
  voxeq_a1 = (-2.0 * cos3) / a0_3;
  voxeq_a2 = (1.0 - alpha3 / A3) / a0_3;

  // 4. 10k+ Air High Shelf (Band 4)
  A4 = exp(eff_air_gain * (log(10.0) / 40.0));
  w4 = 2.0 * $pi * min(srate * 0.45, max(4000, slider56)) / srate;
  cos4 = cos(w4); sin4 = sin(w4);
  alpha4 = sin4 / (2.0 * 0.7071);
  sqA4 = 2.0 * sqrt(A4) * alpha4;
  a0_4 = (A4 + 1.0) - (A4 - 1.0) * cos4 + sqA4;
  air_b0 = (A4 * ((A4 + 1.0) + (A4 - 1.0) * cos4 + sqA4)) / a0_4;
  air_b1 = (-2.0 * A4 * ((A4 - 1.0) + (A4 + 1.0) * cos4)) / a0_4;
  air_b2 = (A4 * ((A4 + 1.0) + (A4 - 1.0) * cos4 - sqA4)) / a0_4;
  air_a1 = (2.0 * ((A4 - 1.0) - (A4 + 1.0) * cos4)) / a0_4;
  air_a2 = ((A4 + 1.0) - (A4 - 1.0) * cos4 - sqA4) / a0_4;

  // 5. 90Hz Sub Mono Crossover Low-Pass
  w90 = 2.0 * $pi * 90.0 / srate;
  cos90 = cos(w90); sin90 = sin(w90);
  alpha90 = sin90 / (2.0 * 0.7071);
  a0_90 = 1.0 + alpha90;
  subx_b0 = ((1.0 - cos90) * 0.5) / a0_90;
  subx_b1 = (1.0 - cos90) / a0_90;
  subx_b2 = ((1.0 - cos90) * 0.5) / a0_90;
  subx_a1 = (-2.0 * cos90) / a0_90;
  subx_a2 = (1.0 - alpha90) / a0_90;

  // 6. Compressor Time Constants
  comp_att_coeff = 1.0 - exp(-1.0 / (max(0.001, slider61 * 0.001) * srate));
  comp_rel_coeff = 1.0 - exp(-1.0 / (max(0.001, slider62 * 0.001) * srate));
);

// -----------------------------------------------------------------------------
// AI MIX-FIT ADVISOR: reads the live project (all suites + tonal balance) and the
// Devastator sample profile, then computes small bounded EQ/Comp trims so the
// cinematic bed sits UNDER guitars, drums, bass and the lead vocal.
// Producer scale keeps each blueprint's character (Mick Gordon = in-your-face, etc).
// -----------------------------------------------------------------------------
function run_mixfit_advisor() (
  adv_aw = mst_active;
  adv_lm_ex = adv_aw ? gmem[806] - 30.0 : 0.0;
  adv_hi_ex = adv_aw ? gmem[808] - 2.5 : 0.0;
  adv_bass_on = (gmem[860] == 1);
  adv_syn_on  = (gmem[920] == 1);

  // Sample profile of the active Devastator slots
  adv_prof_low = (slider30 ? 0.5 : 0.0) + (slider11 ? min(1.0, slider12 * 0.01) * 0.5 : 0.0);
  adv_prof_mid = (slider40 ? 0.6 : 0.0) + (slider11 ? 0.3 : 0.0);
  adv_prof_hi  = (slider20 ? min(1.0, slider23 * 0.01) * 0.8 : 0.0) + (slider42 >= 2 ? 0.3 : 0.0);

  adv_ps = slider2 == 0 ? 0.8 : slider2 == 1 ? 0.5 : slider2 == 2 ? 0.8 : slider2 == 3 ? 1.0 : slider2 == 4 ? 0.6 : slider2 == 5 ? 0.9 : slider2 == 6 ? 0.7 : slider2 == 7 ? 1.0 : 0.85;

  // Low-mid: step aside for guitars, bass and any mud already in the mix
  adv_t_lm = -(adv_prof_mid * 1.6 + (gtr_roaring ? 1.2 : 0.0) + (adv_bass_on ? 0.8 : 0.0) + max(0.0, min(1.5, adv_lm_ex / 8.0)));
  adv_t_lm = max(-3.0, min(1.0, adv_t_lm)) * adv_ps;

  // Vocal pocket: deeper while the lead vocal is singing
  adv_vox_amt = vox_singing ? max(0.0, min(1.0, (vox_rms + 42.0) / 18.0)) : 0.0;
  adv_t_vx = vox_active ? -(adv_vox_amt * 1.6 + adv_prof_hi * 0.8) : 0.6;
  adv_t_vx = max(-3.0, min(1.5, adv_t_vx)) * adv_ps;

  // Air: trim if the mix is already bright, add a touch if it is dark
  adv_t_air = -(max(0.0, min(1.5, adv_hi_ex / 2.0)) + (vox_singing ? 0.6 : 0.0) + adv_prof_hi * 0.8) + ((adv_aw && adv_hi_ex < -1.0) ? 0.8 : 0.0);
  adv_t_air = max(-3.0, min(1.5, adv_t_air)) * adv_ps;

  // High-pass: lift to hand the low end to bass/guitars
  adv_t_hpf = min(15.0, (adv_bass_on ? 6.0 : 0.0) + (gtr_roaring ? 4.0 : 0.0)) * adv_ps;

  // Compressor: back off when the mix is already hot, firm up when it is quiet
  adv_t_thr = (mst_rms > -11.0 ? 2.5 : ((mst_rms < -20.0 && adv_aw) ? -2.0 : 0.0)) + (drum_hit_hot ? 1.0 : 0.0);
  adv_t_thr = max(-4.0, min(4.0, adv_t_thr));
  adv_t_mk = mst_rms > -11.0 ? -1.5 : 0.0;

  // Width / saturation: keep the bed from crowding guitars, vocals and kick
  adv_t_w = -((gtr_roaring ? 0.12 : 0.0) + (adv_syn_on ? 0.08 : 0.0) + (drum_hit_hot ? 0.04 : 0.0));
  adv_t_sat = -((drum_hit_hot ? 6.0 : 0.0) + (vox_singing ? 4.0 : 0.0));

  ai_off_lm  += (adv_t_lm  - ai_off_lm)  * 0.06;
  ai_off_vx  += (adv_t_vx  - ai_off_vx)  * 0.06;
  ai_off_air += (adv_t_air - ai_off_air) * 0.06;
  ai_off_hpf += (adv_t_hpf - ai_off_hpf) * 0.06;
  ai_off_thr += (adv_t_thr - ai_off_thr) * 0.06;
  ai_off_mk  += (adv_t_mk  - ai_off_mk)  * 0.06;
  ai_off_w   += (adv_t_w   - ai_off_w)   * 0.06;
  ai_off_sat += (adv_t_sat - ai_off_sat) * 0.06;

  adv_pen = max(0.0, min(10.0, adv_lm_ex)) * 3.0 + (mst_rms > -9.0 ? 15.0 : 0.0) + max(0.0, -live_comp_gr_db - 6.0) * 4.0;
  ai_fit_score = max(0.0, min(100.0, 100.0 - adv_pen));

  update_reeq_and_comp_coefficients();
);

update_devastator_filters();
update_reeq_and_comp_coefficients();

function trigger_sub_divebomb() (
  sub_active = 1;
  sub_curr_freq = slider31;
  sub_env = 1.0;
);

function trigger_reversed_suckback() (
  suck_active = 1;
  suck_time = 0.0;
  suck_env = 0.01;
);


// ===== TRAILER PLAYBOOK BEGIN (producer-specific, region + energy aware trigger rules) =====
// Per producer: which of the three trailer events may fire (pre-chorus suck-back, chorus sub divebomb,
// breakdown sub divebomb), an escalation rule (every chorus / skip first / every 2nd / only when energy rises)
// and a minimum master level. The playbook decides at each region entrance; every decision is logged.
pb_f = 1900000; pb_e = 1900010; pb_s = 1900020; pb_t = 1900030; pb_n = 1900040;
pb_er = 1900060; pb_tip = 1900100;
pb_f[0] = 3; pb_e[0] = 1; pb_s[0] = 1; pb_t[0] = -44;
pb_n[0] = "Jordan Fish";
pb_tip[0] = "Builds the album like a film: first chorus held back.";
pb_tip[1] = "Suck-back leads into each later chorus, then the sub hits.";
pb_tip[2] = "Signature move: the pull-back before the biggest drop.";
pb_tip[3] = "Subtle sub divebomb only when the chorus is truly bigger.";
pb_f[1] = 6; pb_e[1] = 0; pb_s[1] = 2; pb_t[1] = -40;
pb_n[1] = "Mick Gordon";
pb_tip[4] = "Hits, not builds: sub divebomb on every chorus entry.";
pb_tip[5] = "Breakdown entrances get the same weight.";
pb_tip[6] = "No suck-back: the impact IS the transition.";
pb_tip[7] = "Everything fires at full conviction, nothing washy.";
pb_f[2] = 7; pb_e[2] = 3; pb_s[2] = 1; pb_t[2] = -44;
pb_n[2] = "Chris Bedan";
pb_tip[8] = "Cinematic tension: suck-back before later choruses.";
pb_tip[9] = "Sub divebomb only when the energy is rising vs the song.";
pb_tip[10] = "Breakdowns get a dive when the groove is still building.";
pb_tip[11] = "Restraint then release: it waits for the real peak.";
pb_f[3] = 1; pb_e[3] = 2; pb_s[3] = 1; pb_t[3] = -46;
pb_n[3] = "Dan Braunstein";
pb_tip[12] = "Elegant restraint: suck-back on every second chorus only.";
pb_tip[13] = "No sub bombs; the vocal stays the star.";
pb_tip[14] = "The pull-back is quiet and short, never theatrical.";
pb_tip[15] = "Silence before the hook does the real work.";
pb_f[4] = 6; pb_e[4] = 0; pb_s[4] = 4; pb_t[4] = -40;
pb_n[4] = "Buster Odeholm";
pb_tip[16] = "Djent weight: sub divebomb on every breakdown entrance.";
pb_tip[17] = "Chorus hits get the same low-end drop.";
pb_tip[18] = "No risers or suck-backs; just silence then impact.";
pb_tip[19] = "Signature move: the breakdown drop.";
pb_f[5] = 3; pb_e[5] = 3; pb_s[5] = 1; pb_t[5] = -44;
pb_n[5] = "Bad Omens";
pb_tip[20] = "Dark pop tension: suck-back before later choruses.";
pb_tip[21] = "Sub divebomb only when the chorus out-energies the song.";
pb_tip[22] = "Skips the first chorus; the second is the payoff.";
pb_tip[23] = "Pull back, then punch. Never both at once.";
pb_f[6] = 6; pb_e[6] = 1; pb_s[6] = 2; pb_t[6] = -40;
pb_n[6] = "Lance Prenc";
pb_tip[24] = "Heavy and precise: sub divebomb on chorus and breakdown.";
pb_tip[25] = "Skips the first chorus; the later ones hit harder.";
pb_tip[26] = "No suck-back; straight into the impact.";
pb_tip[27] = "Signature move: the chorus divebomb.";
pb_f[7] = 1; pb_e[7] = 1; pb_s[7] = 1; pb_t[7] = -48;
pb_n[7] = "George Lever";
pb_tip[28] = "Slow burn: a long suck-back, but only from chorus two on.";
pb_tip[29] = "No sub bombs; the drop stays organic.";
pb_tip[30] = "Keeps it rare so every fire feels earned.";
pb_tip[31] = "Signature move: the pull-back before the final chorus.";
pb_f[8] = 3; pb_e[8] = 3; pb_s[8] = 1; pb_t[8] = -44;
pb_n[8] = "Kel Pinchin (Split Chain)";
pb_tip[32] = "Grunge drop tension: 2-bar suck-back bloom into hook.";
pb_tip[33] = "Sub divebomb fires when chorus energy out-powers song.";
pb_tip[34] = "Tasteful restraint: skips low-energy sections cleanly.";
pb_tip[35] = "Signature move: the reverse pull-back before the hook.";
pb_er[0] = "every chorus";
pb_er[1] = "skips first chorus";
pb_er[2] = "every 2nd chorus";
pb_er[3] = "escalates with energy";
dv_ch_seen = 0; dv_cnt_rgn = -1; dv_brk_rgn = -1; dv_song_db = -30.0; dv_p = 0;
strcpy(#dv_w1, "Waiting for playback..."); strcpy(#dv_w2, ""); strcpy(#dv_w3, "");

function dv_log(ev, fired, n) (
  strcpy(#dv_w3, #dv_w2); strcpy(#dv_w2, #dv_w1);
  sprintf(#dv_w1, "%s %s  |  chorus %d  |  %s", fired ? "FIRED" : "HELD ",
          ev == 1 ? "suck-back" : (ev == 2 ? "sub divebomb" : "breakdown dive"), n, pb_er[pb_e[dv_p]]);
);

function dv_pb_rule(ev) local(ok) (
  ok = ((pb_f[dv_p] & ev) != 0);
  (slider68 == 0) ? ( ok = (pb_s[dv_p] == ev); );
  (slider68 == 2) ? ( ok = 1; );
  ok;
);

function dv_pb_esc(ev, n) local(e, g) (
  e = pb_e[dv_p]; g = 1;
  (e == 1) ? ( g = (n >= 2); );
  (e == 2) ? ( g = ((n % 2) == 0); );
  (e == 3) ? (
    (ev == 1) ? ( g = (n >= 2); ) : ( g = (mst_rms >= dv_song_db + 1.0); );
  );
  (ev == 4 && (e == 1 || e == 2)) ? ( g = 1; );
  (slider68 == 2) ? ( g = 1; );
  g;
);

function dv_playbook() local(n, lvl, go) (
  dv_p = max(0, min(8, floor(slider2 + 0.5)));
  lvl = (mst_rms > pb_t[dv_p]);

  // 1) pre-chorus suck-back: timed to land on the chorus downbeat; evaluated once per upcoming chorus
  (g_to_chorus_sec > 0.05 && g_to_chorus_sec <= slider21 + 0.03 && g_to_chorus_sec >= slider21 - 0.25 && !suck_active) ? (
    dv_chorus_abs = play_position + g_to_chorus_sec;
    n = dv_ch_seen + 1;
    (abs(dv_chorus_abs - dv_fire_chorus_abs) > 1.0 && dv_cool) ? (
      go = dv_pb_rule(1) && dv_pb_esc(1, n);
      go ? ( trigger_reversed_suckback(); dv_last_fire_t = time_precise(); );
      dv_fire_chorus_abs = dv_chorus_abs;
      dv_log(1, go, n);
    );
  );

  // 2) chorus entrance: count it, then sub divebomb if the playbook allows
  (g_sec_id == 3 && g_rgn_progress < 0.08 && g_cur_rgn != dv_cnt_rgn) ? (
    n = dv_ch_seen + 1; dv_ch_seen = n; dv_cnt_rgn = g_cur_rgn;
    go = dv_pb_rule(2) && dv_pb_esc(2, n) && lvl && !sub_active;
    go ? ( trigger_sub_divebomb(); );
    dv_log(2, go, n);
  );

  // 3) breakdown entrance
  (g_sec_id == 4 && g_rgn_progress < 0.06 && g_cur_rgn != dv_brk_rgn) ? (
    dv_brk_rgn = g_cur_rgn;
    go = dv_pb_rule(4) && dv_pb_esc(4, dv_ch_seen) && lvl && !sub_active;
    go ? ( trigger_sub_divebomb(); );
    dv_log(4, go, dv_ch_seen);
  );
);
// ===== TRAILER PLAYBOOK END =====

function apply_producer_blueprint(p_idx) (
  slider2 = p_idx;
  p_idx == 0 ? ( // Jordan Fish (BMTH)
    slider5 = -1.5; slider12 = 70; slider13 = 180; slider14 = 1.45; slider15 = 3.2;
    slider16 = 15; slider17 = 2800; slider18 = 0.0;
    slider21 = 2.0; slider22 = 40; slider24 = 3800;
    slider25 = 600; slider26 = 40; slider27 = 0.5;
    slider31 = 70; slider32 = 25; slider34 = 30; slider42 = 2;
    slider35 = 5; slider36 = 1400; slider37 = 0.0;
    slider46 = 1; slider47 = 1.45; slider48 = 28;
    slider50 = 1; slider51 = 35; slider52 = 340; slider53 = -4.0; slider54 = 3000; slider55 = -3.2; slider56 = 13000; slider57 = 3.0;
    slider58 = 1; slider59 = -18.0; slider60 = 3.5; slider61 = 20; slider62 = 100; slider63 = 3.5;
