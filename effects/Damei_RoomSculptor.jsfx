// =============================================================================
// DAMEI SUITE -- ATUMPAN ROOMSCULPTOR (v2.5 FLAGSHIP SPACE INFLATOR & SMASH COMPRESSOR)
// Acoustic Space Enhancer, Transient Inflator & Distressor Room Smasher
//
// Modelled after Oxford Inflator, Empirical Labs Distressor Nuke & Soundtoys Devil-Loc
// Afro-Cybernetic Luxury Aesthetics | Studio Reference Standard (960 x 660)
// Interlocked with Atumpan Drum Sentry via gmem=DameiMixMetering
// =============================================================================

desc:Damei Atumpan RoomSculptor (Acoustic Space Inflator & Smash Compressor)
author: Damei Suite / Google DeepMind Pair Programming
version: 2.5

options:gmem=DameiMixMetering
options:maxmemz=4194304
options:gfx_hz=60
options:want_all_kb
options:no_meter

// --- CONTROLS ---
slider1:36<0,100,1>-Space Inflation (%)
slider2:0<-50,50,1>-Inflator Curve (-Warmth / +Excitement)
slider3:1<0,1,1{Soft Clip Off,Clip 0dBFS Safe}>-Clip 0dBFS Mode
slider4:1<0,3,1{Pumping Glue 4:1,Punch VCA 10:1,NUKE All-Buttons-In,Opto Bloom}>-Smash Compressor Mode
slider5:16<0,60,1>-Smash Drive / Threshold (dB)
slider6:14<0.5,50,0.5>-Attack Time (ms)
slider7:95<10,800,5>-Release Time (ms)
slider8:140<30,350,5>-Detector Low-Cut HPF (Hz)
slider9:55<0,100,1>-Parallel Smash Mix (%)
slider10:-8.5<-18.0,18.0,0.1>-Output Makeup Trim (dB)
slider11:0<-256,256,1>-Acoustic Time-Align (Samples)
slider12:0<0,1,1{Normal Polarity,Invert 180 deg}>-Master Polarity
slider13:115<0,200,1>-Room Stereo Width (%)
slider14:24<0,26,1{0: Default Neutral Wire,1: Lance Prenc (Alpha Wolf / Polaris),2: Scott Seigel (DIESECT),3: Jonathan Dolese (Mirrorcell),4: Buster Odeholm (thrown / Northlane),5: Lewis Johns & Grant Berry (Love Is Noise),6: Kel Pinchin (Split Chain),7: Dan Lancaster (Don Broco),8: Erik Bickerstaffe (Static Dress),9: Sam Guaiana (Shyeye),10: Zach Tuch (Heavenward),11: Forrester Savell (City Of Souls),12: Leon Schmidt (SUNBORN),13: Ermin Hamidovic (Benchmark),14: Will Putney (Fit For An Autopsy / Knocked Loose),15: George Lever (Loathe / Sleep Token),16: Sam Bassal (Thornhill),17: Henrik Udd (Architects / BMTH),18: Dan Braunstein (Spiritbox / Dayseeker),19: Zakk Cervini (Bad Omens / Blink-182),20: Jens Bogren (Fascination Street),21: Adam Nolly Getgood (Periphery / GGD),22: Acle Kahney (TesseracT),23: Adam Cichocki (heaving.),24: Manuel Renner (SENNA - Out Of The Blue),25: Matt Thomas (Ashtone - Live Room Authority),26: Mark Williamson (Sugarhouse - Live Cohesion)}>-Producer Signature Preset
slider15:1.5<0.0,10.0,0.2>-Room Air Shimmer Lift (10kHz) (dB)
slider16:1<0,2,1{Clean Transparent,Dist 2 Warm Triode,Dist 3 Aggressive Pentode}>-Distressor Harmonic Color
slider17:4.8<0.0,8.0,0.2>-Room Mud De-Resonator (250Hz) (dB)

in_pin:Room Input L (Ch 1)
in_pin:Room Input R (Ch 2)
out_pin:Sculpted Room L (Ch 1)
out_pin:Sculpted Room R (Ch 2)

// =============================================================================
// @init
// =============================================================================
@init
  ext_noinit = 1;

  // Delay alignment ring buffer
  DLY_BUF_L = 0;
  DLY_BUF_R = 16384;
  dly_pos = 0;
  dly_max = 16384;

  // Waveform Scope Ring Buffer
  WAVE_BUF = 32768;
  wave_w = 480;
  wave_h = 160;
  wave_ppos = 0;
  wave_spos = 0;
  wave_div = 150;
  wave_min = 1.0;
  wave_max = -1.0;
  wave_gr = 0.0;

  // Filter & Detector States
  sc_hpf_x1 = 0; sc_hpf_x2 = 0; sc_hpf_y1 = 0; sc_hpf_y2 = 0;
  air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
  air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;
  mud_x1_l = 0; mud_x2_l = 0; mud_y1_l = 0; mud_y2_l = 0;
  mud_x1_r = 0; mud_x2_r = 0; mud_y1_r = 0; mud_y2_r = 0;

  comp_env = 0.0;
  sifam_gr = 0.0;
  sifam_out = 0.0;
  out_peak = 0.0;

  knob_drag = -1;
  knob_start_y = 0;
  knob_start_val = 0;
  last_preset = -1;
  last_sentry_preset = -1;

  function db(v) ( v > 0.000000001 ? 20.0 * log10(v) : -120.0; );
  function db_to_gain(d) ( pow(10.0, d / 20.0); );
  function clamp(v, mn, mx) ( max(mn, min(mx, v)); );
  function sqr(x) ( x * x; );

  function setup_hpf(f0, Q) local(omega, sn, cs, alpha, a0) (
    omega = 2.0 * $pi * clamp(f0, 20.0, srate * 0.45) / srate;
    sn = sin(omega); cs = cos(omega);
    alpha = sn / (2.0 * Q);
    a0 = 1.0 + alpha;
    b0_hpf = ((1.0 + cs) * 0.5) / a0;
    b1_hpf = (-(1.0 + cs)) / a0;
    b2_hpf = ((1.0 + cs) * 0.5) / a0;
    a1_hpf = (-2.0 * cs) / a0;
    a2_hpf = (1.0 - alpha) / a0;
  );

  function setup_highshelf(f0, gain_db) local(omega, sn, cs, A, alpha, a0) (
    A = pow(10.0, gain_db / 40.0);
    omega = 2.0 * $pi * clamp(f0, 1000.0, srate * 0.45) / srate;
    sn = sin(omega); cs = cos(omega);
    alpha = sn * 0.5 * sqrt((A + 1.0 / A) * (1.0 / 0.707 - 1.0) + 2.0);
    a0 = (A + 1.0) - (A - 1.0) * cs + 2.0 * sqrt(A) * alpha;
    b0_hs = (A * ((A + 1.0) + (A - 1.0) * cs + 2.0 * sqrt(A) * alpha)) / a0;
    b1_hs = (-2.0 * A * ((A - 1.0) + (A + 1.0) * cs)) / a0;
    b2_hs = (A * ((A + 1.0) + (A - 1.0) * cs - 2.0 * sqrt(A) * alpha)) / a0;
    a1_hs = (2.0 * ((A - 1.0) - (A + 1.0) * cs)) / a0;
    a2_hs = ((A + 1.0) - (A - 1.0) * cs - 2.0 * sqrt(A) * alpha) / a0;
  );

  function setup_notch(f0, Q, cut_db) local(omega, sn, cs, alpha, A, a0) (
    A = pow(10.0, -cut_db / 40.0);
    omega = 2.0 * $pi * clamp(f0, 80.0, srate * 0.45) / srate;
    sn = sin(omega); cs = cos(omega);
    alpha = sn / (2.0 * Q);
    a0 = 1.0 + alpha / A;
    b0_mud = (1.0 + alpha * A) / a0;
    b1_mud = (-2.0 * cs) / a0;
    b2_mud = (1.0 - alpha * A) / a0;
    a1_mud = (-2.0 * cs) / a0;
    a2_mud = (1.0 - alpha / A) / a0;
  );

  // Oxford Inflator waveshaper algorithm
  function inflator_process(x, infl_amt, curve_val) local(x_abs, x_sgn, y) (
    x_sgn = x < 0 ? -1.0 : 1.0;
    x_abs = abs(x);
    x_abs > 1.0 ? (
      y = 1.0;
    ) : (
      y = (1.0 + curve_val) * x_abs - curve_val * sqr(x_abs);
      y = 2.0 * y - sqr(y);
      y = (1.0 - infl_amt) * x_abs + infl_amt * y;
    );
    x_sgn * y;
  );

  // Distressor harmonic saturation curve
  function distressor_color(x, color_mode) local(y) (
    color_mode == 1 ? (
      // Dist 2: Warm 2nd Harmonic Triode Saturation
      y = x + 0.12 * sqr(x) - 0.04 * (sqr(x) * x);
    ) : color_mode == 2 ? (
      // Dist 3: Aggressive 3rd Harmonic Pentode Crunch
      y = x - 0.15 * (sqr(x) * x);
    ) : (
      y = x;
    );
    y;
  );

  function set_c(hex) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = 1.0;
  );

  function set_ca(hex, a) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = a;
  );

// =============================================================================
// 
  function calibrate_room_preset(p) (
    p == 1 ? ( // Lance Prenc (Alpha Wolf / Polaris)
      slider1 = 55; slider2 = 15; slider4 = 2; slider5 = 26; slider6 = 6; slider7 = 75; slider8 = 140; slider9 = 80; slider10 = -10.5; slider15 = 4.5; slider16 = 2;
    );
    p == 2 ? ( // Scott Seigel (DIESECT)
      slider1 = 50; slider2 = 10; slider4 = 2; slider5 = 24; slider6 = 8; slider7 = 85; slider8 = 130; slider9 = 75; slider10 = -10.5; slider15 = 4.0; slider16 = 2;
    );
    p == 3 ? ( // Jonathan Dolese (Mirrorcell)
      slider1 = 48; slider2 = 8; slider4 = 1; slider5 = 22; slider6 = 10; slider7 = 100; slider8 = 125; slider9 = 70; slider10 = -10.0; slider15 = 3.8; slider16 = 1;
    );
    p == 4 ? ( // Buster Odeholm (thrown / Northlane)
      slider1 = 65; slider2 = 25; slider4 = 2; slider5 = 30; slider6 = 4; slider7 = 65; slider8 = 150; slider9 = 85; slider10 = -11.0; slider15 = 5.5; slider16 = 2;
    );
    p == 5 ? ( // Lewis Johns & Grant Berry (Love Is Noise)
      slider1 = 45; slider2 = 5; slider4 = 0; slider5 = 18; slider6 = 15; slider7 = 130; slider8 = 115; slider9 = 65; slider10 = -10.0; slider15 = 3.2; slider16 = 1;
    );
    p == 6 ? ( // Kel Pinchin (Split Chain)
      slider1 = 48; slider2 = 8; slider4 = 1; slider5 = 20; slider6 = 12; slider7 = 110; slider8 = 120; slider9 = 68; slider10 = -10.0; slider15 = 3.5; slider16 = 1;
    );
    p == 7 ? ( // Dan Lancaster (Don Broco)
      slider1 = 48; slider2 = 10; slider4 = 1; slider5 = 22; slider6 = 10; slider7 = 100; slider8 = 120; slider9 = 70; slider10 = -10.0; slider15 = 3.8; slider16 = 1;
    );
    p == 14 ? ( // Will Putney (Fit For An Autopsy / Knocked Loose)
      slider1 = 42; slider2 = 0; slider4 = 1; slider5 = 20; slider6 = 14; slider7 = 120; slider8 = 110; slider9 = 65; slider10 = -10.0; slider15 = 3.0; slider16 = 1;
    );
    p == 15 ? ( // George Lever (Loathe / Sleep Token)
      slider1 = 55; slider2 = 15; slider4 = 2; slider5 = 24; slider6 = 8; slider7 = 90; slider8 = 130; slider9 = 75; slider10 = -10.5; slider15 = 4.0; slider16 = 2;
    );
    p == 17 ? ( // Henrik Udd (Architects / BMTH)
      slider1 = 52; slider2 = 12; slider4 = 2; slider5 = 25; slider6 = 7; slider7 = 80; slider8 = 135; slider9 = 75; slider10 = -10.5; slider15 = 4.2; slider16 = 2;
    );
    p == 18 ? ( // Dan Braunstein (Spiritbox / Dayseeker)
      slider1 = 48; slider2 = 10; slider4 = 1; slider5 = 22; slider6 = 10; slider7 = 100; slider8 = 120; slider9 = 70; slider10 = -10.0; slider15 = 3.8; slider16 = 1;
    );
    p == 19 ? ( // Zakk Cervini (Bad Omens / Blink-182)
      slider1 = 50; slider2 = 12; slider4 = 1; slider5 = 23; slider6 = 9; slider7 = 95; slider8 = 125; slider9 = 72; slider10 = -10.0; slider15 = 4.0; slider16 = 2;
    );
    p == 20 ? ( // Jens Bogren (Fascination Street)
      slider1 = 45; slider2 = 5; slider4 = 1; slider5 = 20; slider6 = 12; slider7 = 120; slider8 = 115; slider9 = 68; slider10 = -10.0; slider15 = 3.2; slider16 = 1;
    );
    p == 21 ? ( // Adam Nolly Getgood (Periphery / GGD)
      slider1 = 52; slider2 = 12; slider4 = 2; slider5 = 25; slider6 = 8; slider7 = 85; slider8 = 130; slider9 = 75; slider10 = -10.5; slider15 = 4.2; slider16 = 2;
    );
    p == 24 ? ( // Manuel Renner (SENNA - Out Of The Blue)
      slider1 = 36; slider2 = 0; slider4 = 1; slider5 = 16; slider6 = 14; slider7 = 95; slider8 = 140; slider9 = 55; slider10 = -8.5; slider15 = 1.5; slider16 = 1; slider17 = 4.8;
    );
    p == 25 ? ( // Matt Thomas (Ashtone - Live Room Authority)
      slider1 = 32; slider2 = -8; slider4 = 1; slider5 = 14; slider6 = 18; slider7 = 85; slider8 = 145; slider9 = 45; slider10 = -7.5; slider15 = 1.0; slider16 = 0; slider17 = 5.2;
    );
    p == 26 ? ( // Mark Williamson (Sugarhouse - Live Cohesion)
      slider1 = 30; slider2 = -12; slider4 = 1; slider5 = 18; slider6 = 20; slider7 = 110; slider8 = 135; slider9 = 22; slider10 = -6.5; slider15 = 0.8; slider16 = 1; slider17 = 4.2;
    );
  );


  function draw_knob(cx, cy, radius, val_norm, label_str, val_str, idx)
  local(hov, val_new, a_start, a_end, tw, th) (
    hov = sqrt((mouse_x - cx)^2 + (cy - mouse_y)^2) < radius + 8;
    mouse_cap & 1 ? (
      knob_drag == idx ? (
        val_new = knob_start_val + (knob_start_y - mouse_y) / 130.0;
        val_norm = clamp(val_new, 0.0, 1.0);
      ) : (
        knob_drag == -1 && hov ? (
          knob_drag = idx;
          knob_start_y = mouse_y;
          knob_start_val = val_norm;
        );
      );
    ) : (
      knob_drag == idx ? knob_drag = -1;
    );

    set_c(0x131822); gfx_circle(cx, cy, radius, 1, 1);
    set_c(0x222c3d); gfx_circle(cx, cy, radius, 0, 1);

    a_start = -4.71;
    a_end = a_start + (val_norm * 4.71);
    set_ca(hov ? 0x2899ff : 0xdfb15b, 0.95);
    gfx_arc(cx, cy, radius - 3, a_start, a_end, 1);

    set_c(0x1c2433); gfx_circle(cx, cy, radius * 0.44, 1, 1);
    set_c(0x1b2331); gfx_circle(cx, cy, radius * 0.44, 0, 1);

    // Value text
    gfx_setfont(1, "Orbitron", 11, 'b');
    set_c(0xffffff);
    gfx_measurestr(val_str, tw, th);
    gfx_x = cx - tw * 0.5; gfx_y = cy - th * 0.5;
    gfx_drawstr(val_str);

    // Label below knob
    gfx_setfont(2, "Segoe UI", 11.5, 'b');
    set_c(hov ? 0x2899ff : 0xd6dde8);
    gfx_measurestr(label_str, tw, th);
    gfx_x = cx - tw * 0.5; gfx_y = cy + radius + 8;
    gfx_drawstr(label_str);

    val_norm;
  );

  function draw_btn(bx, by, bw, bh, lbl, is_active) local(hov, clk, tw, th) (
    hov = (mouse_x >= bx && mouse_x < bx + bw && mouse_y >= by && mouse_y < by + bh);
    clk = hov && mouse_clicked;
    set_ca(is_active ? 0xdfab35 : (hov ? 0x222c3d : 0x151b26), is_active ? 1.0 : 0.92);
    gfx_rect(bx, by, bw, bh);
    set_c(is_active ? 0xdfab35 : (hov ? 0x2899ff : 0x2e364c));
    gfx_rect(bx, by, bw, bh, 0);
    gfx_setfont(1, "Orbitron", 11, 'b');
    set_c(is_active ? 0x0a0c10 : 0xffffff);
    gfx_measurestr(lbl, tw, th);
    gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5;
    gfx_drawstr(lbl);
    clk;
  );

  function draw_sifam(mx, my, mw, mh, title_str, norm_val, is_gr)
  local(piv_x, piv_y, r_arc, r_needle, ang_start, ang_end, cur_ang, needle_val, ai, a_step, rad, x1, y1, x2, y2, tw, th, s_val) (
    set_c(0x181c26); gfx_rect(mx, my, mw, mh);
    set_c(0x222c3d); gfx_rect(mx, my, mw, mh, 0);

    set_c(0x0e131d); gfx_rect(mx + 4, my + 4, mw - 8, mh - 8);
    set_c(0x1a2436); gfx_rect(mx + 4, my + 4, mw - 8, mh - 8, 0);

    piv_x = mx + mw * 0.5; piv_y = my + mh - 8;
    r_arc = min(mh - 24, mw * 0.44); r_needle = r_arc - 2;

    ang_start = -48.0 * $pi / 180.0; ang_end = 48.0 * $pi / 180.0;

    set_c(0x2d3a50);
    ai = 0; a_step = (ang_end - ang_start) / 20.0;
    loop(20,
      rad = ang_start + ai * a_step;
      x1 = piv_x + sin(rad) * (r_arc - 2);
      y1 = piv_y - cos(rad) * (r_arc - 2);
      x2 = piv_x + sin(rad + a_step) * (r_arc - 2);
      y2 = piv_y - cos(rad + a_step) * (r_arc - 2);
      gfx_line(x1, y1, x2, y2);
      (ai % 4 == 0) ? (
        set_c(0xdfb15b);
        gfx_line(x1, y1, piv_x + sin(rad) * (r_arc - 6), piv_y - cos(rad) * (r_arc - 6));
        set_c(0x2d3a50);
      );
      ai += 1;
    );

    needle_val = clamp(norm_val, 0.0, 1.0);
    cur_ang = ang_start + needle_val * (ang_end - ang_start);
    set_ca(0x000000, 0.4);
    gfx_line(piv_x + 2, piv_y + 2, piv_x + sin(cur_ang) * r_needle + 2, piv_y - cos(cur_ang) * r_needle + 2);
    set_c(is_gr ? (norm_val > 0.02 ? 0xf03344 : 0x7e8b9b) : (norm_val > 0.95 ? 0xf03344 : 0xdfb15b));
    gfx_line(piv_x, piv_y, piv_x + sin(cur_ang) * r_needle, piv_y - cos(cur_ang) * r_needle);

    set_c(0x283344); gfx_circle(piv_x, piv_y, 5, 1, 1);
    set_c(0xdfb15b); gfx_circle(piv_x, piv_y, 5, 0, 1);

    gfx_setfont(1, "Orbitron", 10.5, 'b'); set_c(0xedf1f7);
    gfx_measurestr(title_str, tw, th); gfx_x = mx + 8; gfx_y = my + 6;
    gfx_drawstr(title_str);

    s_val = is_gr ? sprintf(#, "-%.1f dB", norm_val * 30.0) : sprintf(#, "%.1f dB", db(norm_val));
    gfx_setfont(1, "Orbitron", 11, 'b');
    gfx_measurestr(s_val, tw, th);
    set_c(is_gr ? (norm_val > 0.02 ? 0xf03344 : 0x7e8b9b) : (norm_val > 0.95 ? 0xf03344 : 0x0fe49e));
    gfx_x = mx + mw - tw - 8; gfx_y = my + 6;
    gfx_drawstr(s_val);
  );


@slider
// =============================================================================
@slider
  // Producer Signature Presets (Calibrated from Reference Stems)
  cur_preset = slider14;
  cur_preset != last_preset ? (
    last_preset = cur_preset;
    cur_preset == 1 ? ( // Lance Prenc (Alpha Wolf / Polaris)
      slider1 = 55; slider2 = 15; slider4 = 2; slider5 = 26; slider6 = 6; slider7 = 75; slider8 = 140; slider9 = 80; slider10 = -10.5; slider15 = 4.5; slider16 = 2;
    );
    cur_preset == 2 ? ( // Scott Seigel (DIESECT)
      slider1 = 50; slider2 = 10; slider4 = 2; slider5 = 24; slider6 = 8; slider7 = 85; slider8 = 130; slider9 = 75; slider10 = -10.5; slider15 = 4.0; slider16 = 2;
    );
    cur_preset == 3 ? ( // Jonathan Dolese (Mirrorcell)
      slider1 = 48; slider2 = 8; slider4 = 1; slider5 = 22; slider6 = 10; slider7 = 100; slider8 = 125; slider9 = 70; slider10 = -10.0; slider15 = 3.8; slider16 = 1;
    );
    cur_preset == 4 ? ( // Buster Odeholm (thrown / Northlane)
      slider1 = 65; slider2 = 25; slider4 = 2; slider5 = 30; slider6 = 4; slider7 = 65; slider8 = 150; slider9 = 85; slider10 = -11.0; slider15 = 5.5; slider16 = 2;
    );
    cur_preset == 5 ? ( // Lewis Johns & Grant Berry (Love Is Noise)
      slider1 = 45; slider2 = 5; slider4 = 0; slider5 = 18; slider6 = 15; slider7 = 130; slider8 = 115; slider9 = 65; slider10 = -10.0; slider15 = 3.2; slider16 = 1;
    );
