    );
    cur_preset == 17 ? ( // Henrik Udd (Architects / BMTH)
      slider1 = 52; slider2 = 12; slider4 = 2; slider5 = 25; slider6 = 7; slider7 = 80; slider8 = 135; slider9 = 75; slider10 = -10.5; slider15 = 4.2; slider16 = 2;
    );
    cur_preset == 18 ? ( // Dan Braunstein (Spiritbox / Dayseeker)
      slider1 = 48; slider2 = 10; slider4 = 1; slider5 = 22; slider6 = 10; slider7 = 100; slider8 = 120; slider9 = 70; slider10 = -10.0; slider15 = 3.8; slider16 = 1;
    );
    cur_preset == 19 ? ( // Zakk Cervini (Bad Omens / Blink-182)
      slider1 = 50; slider2 = 12; slider4 = 1; slider5 = 23; slider6 = 9; slider7 = 95; slider8 = 125; slider9 = 72; slider10 = -10.0; slider15 = 4.0; slider16 = 2;
    );
    cur_preset == 20 ? ( // Jens Bogren (Fascination Street)
      slider1 = 45; slider2 = 5; slider4 = 1; slider5 = 20; slider6 = 12; slider7 = 120; slider8 = 115; slider9 = 68; slider10 = -10.0; slider15 = 3.2; slider16 = 1;
    );
    cur_preset == 21 ? ( // Adam Nolly Getgood (Periphery / GGD)
      slider1 = 52; slider2 = 12; slider4 = 2; slider5 = 25; slider6 = 8; slider7 = 85; slider8 = 130; slider9 = 75; slider10 = -10.5; slider15 = 4.2; slider16 = 2;
    );
    cur_preset == 24 ? ( // Manuel Renner (SENNA - Out Of The Blue)
      slider1 = 36; slider2 = 0; slider4 = 1; slider5 = 16; slider6 = 14; slider7 = 95; slider8 = 140; slider9 = 55; slider10 = -8.5; slider15 = 1.5; slider16 = 1; slider17 = 4.8;
    );
    cur_preset == 25 ? ( // Matt Thomas (Ashtone - Live Room Authority)
      slider1 = 32; slider2 = -8; slider4 = 1; slider5 = 14; slider6 = 18; slider7 = 85; slider8 = 145; slider9 = 45; slider10 = -7.5; slider15 = 1.0; slider16 = 0; slider17 = 5.2;
    );
    cur_preset == 26 ? ( // Mark Williamson (Sugarhouse - Live Cohesion)
      slider1 = 30; slider2 = -12; slider4 = 1; slider5 = 18; slider6 = 20; slider7 = 110; slider8 = 135; slider9 = 22; slider10 = -6.5; slider15 = 0.8; slider16 = 1; slider17 = 4.2;
    );
  );

  infl_amt = slider1 / 100.0;
  infl_curve = slider2 / 100.0;
  clip_mode = slider3;

  comp_mode = slider4;
  comp_drive_db = slider5;
  comp_drive = db_to_gain(comp_drive_db);
  
  // Ratio selection
  comp_mode == 0 ? comp_ratio = 4.0 :
  comp_mode == 1 ? comp_ratio = 10.0 :
  comp_mode == 2 ? comp_ratio = 20.0 :
                   comp_ratio = 6.0; // Opto

  att_ms = slider6;
  rel_ms = slider7;
  ga_comp = exp(-1.0 / (srate * (att_ms / 1000.0)));
  gr_comp = exp(-1.0 / (srate * (rel_ms / 1000.0)));

  setup_hpf(slider8, 0.707);
  setup_highshelf(10000.0, slider15);
  setup_notch(250.0, 1.8, slider17);

  smash_mix = slider9 / 100.0;
  out_gain = db_to_gain(slider10);
  delay_smpl = floor(slider11);
  polarity = slider12 ? -1.0 : 1.0;
  stereo_w = slider13 / 100.0;
  dist_mode = slider16;

// =============================================================================
// 
// =============================================================================
// @block
// =============================================================================
@block
  // ECOSYSTEM PRODUCER PRESET COMMS (gmem[200..206])
  // Only sync preset when gmem[201] actually changes, preserving manual user tweaks!
  gmem[200] == 0x4452554D && gmem[202] != last_gmem_seq ? (
    last_gmem_seq = gmem[202];
    sentry_preset = gmem[201];
    
    sentry_preset != last_sentry_preset ? (
      last_sentry_preset = sentry_preset;
      slider14 != sentry_preset ? (
        slider14 = sentry_preset;
        last_preset = sentry_preset;
        sliderchange(slider14);
        calibrate_room_preset(slider14);
      );
    );
    ecosystem_linked = 1;
  );
  infl_amt = slider1 / 100.0;
  infl_curve = slider2 / 100.0;
  clip_mode = slider3;
  comp_mode = slider4;
  comp_drive_db = slider5;
  comp_drive = db_to_gain(comp_drive_db);
  comp_mode == 0 ? comp_ratio = 4.0 :
  comp_mode == 1 ? comp_ratio = 10.0 :
  comp_mode == 2 ? comp_ratio = 20.0 :
                   comp_ratio = 6.0;
  att_ms = slider6;
  rel_ms = slider7;
  ga_comp = exp(-1.0 / (srate * (att_ms / 1000.0)));
  gr_comp = exp(-1.0 / (srate * (rel_ms / 1000.0)));
  setup_hpf(slider8, 0.707);
  setup_highshelf(10000.0, slider15);
  setup_notch(250.0, 1.8, slider17);
  smash_mix = slider9 / 100.0;
  out_gain = db_to_gain(slider10);
  delay_smpl = floor(slider11);
  polarity = slider12 ? -1.0 : 1.0;
  stereo_w = slider13 / 100.0;
  dist_mode = slider16;

@sample
// =============================================================================
@sample
  in_l = spl0;
  in_r = spl1;

  // 1. Time Alignment Delay
  dly_pos >= dly_max ? dly_pos = 0;
  DLY_BUF_L[dly_pos] = in_l;
  DLY_BUF_R[dly_pos] = in_r;
  
  read_pos = dly_pos - delay_smpl;
  read_pos < 0 ? read_pos += dly_max;
  read_pos >= dly_max ? read_pos -= dly_max;

  dry_l = DLY_BUF_L[read_pos];
  dry_r = DLY_BUF_R[read_pos];
  dly_pos += 1;

  // 2. Smash Compressor Sidechain HPF Detector
  sc_mono = (dry_l + dry_r) * 0.5 * comp_drive;
  sc_hp = b0_hpf * sc_mono + b1_hpf * sc_hpf_x1 + b2_hpf * sc_hpf_x2 - a1_hpf * sc_hpf_y1 - a2_hpf * sc_hpf_y2;
  sc_hpf_x2 = sc_hpf_x1; sc_hpf_x1 = sc_mono;
  sc_hpf_y2 = sc_hpf_y1; sc_hpf_y1 = sc_hp;

  det_env = abs(sc_hp);
  comp_env < det_env ? (
    comp_env = det_env + ga_comp * (comp_env - det_env);
  ) : (
    comp_env = det_env + gr_comp * (comp_env - det_env);
  );

  // Distressor Compression Gain Reduction (Calibrated detector threshold)
  comp_gr_linear = 1.0;
  thresh_lin = 0.08; // -22 dBFS detector threshold for sensitive dynamic room breathing
  comp_env > thresh_lin ? (
    env_db = db(comp_env);
    thresh_db = -22.0;
    gr_db = (env_db - thresh_db) * (1.0 - 1.0 / comp_ratio);
    comp_gr_linear = db_to_gain(-gr_db);
  );

  smashed_l = dry_l * comp_drive * comp_gr_linear;
  smashed_r = dry_r * comp_drive * comp_gr_linear;

  // Distressor Harmonic Coloration (Dist 2 / Dist 3)
  smashed_l = distressor_color(smashed_l, dist_mode);
  smashed_r = distressor_color(smashed_r, dist_mode);

  // Parallel Smash Mix
  wet_comp_l = dry_l * (1.0 - smash_mix) + smashed_l * smash_mix;
  wet_comp_r = dry_r * (1.0 - smash_mix) + smashed_r * smash_mix;

  // 3. Oxford Space Inflator
  infl_l = inflator_process(wet_comp_l, infl_amt, infl_curve);
  infl_r = inflator_process(wet_comp_r, infl_amt, infl_curve);

  // 4. Tone Shaping: Mud De-Resonator (250Hz) & High Air Shimmer (10kHz)
  mud_l = b0_mud * infl_l + b1_mud * mud_x1_l + b2_mud * mud_x2_l - a1_mud * mud_y1_l - a2_mud * mud_y2_l;
  mud_x2_l = mud_x1_l; mud_x1_l = infl_l; mud_y2_l = mud_y1_l; mud_y1_l = mud_l;
  mud_r = b0_mud * infl_r + b1_mud * mud_x1_r + b2_mud * mud_x2_r - a1_mud * mud_y1_r - a2_mud * mud_y2_r;
  mud_x2_r = mud_x1_r; mud_x1_r = infl_r; mud_y2_r = mud_y1_r; mud_y1_r = mud_r;

  air_l = b0_hs * mud_l + b1_hs * air_x1_l + b2_hs * air_x2_l - a1_hs * air_y1_l - a2_hs * air_y2_l;
  air_x2_l = air_x1_l; air_x1_l = mud_l; air_y2_l = air_y1_l; air_y1_l = air_l;
  air_r = b0_hs * mud_r + b1_hs * air_x1_r + b2_hs * air_x2_r - a1_hs * air_y1_r - a2_hs * air_y2_r;
  air_x2_r = air_x1_r; air_x1_r = mud_r; air_y2_r = air_y1_r; air_y1_r = air_r;

  // 5. Stereo Width Expansion & Polarity
  mid = (air_l + air_r) * 0.5;
  side = (air_l - air_r) * 0.5 * stereo_w;
  out_l = (mid + side) * out_gain * polarity;
  out_r = (mid - side) * out_gain * polarity;

  // 6. 0dBFS Safe Soft Clipper
  clip_mode ? (
    out_l = abs(out_l) > 0.88 ? (sign(out_l) * (0.88 + 0.10 * ((abs(out_l) - 0.88) / (1.0 + abs(out_l) - 0.88)))) : out_l;
    out_r = abs(out_r) > 0.88 ? (sign(out_r) * (0.88 + 0.10 * ((abs(out_r) - 0.88) / (1.0 + abs(out_r) - 0.88)))) : out_r;
  );

  spl0 = out_l;
  spl1 = out_r;

  // Ballistics
  gr_disp_db = -db(comp_gr_linear);
  sifam_gr += (gr_disp_db - sifam_gr) * 0.20;
  out_peak = max(out_peak * 0.9998, max(abs(spl0), abs(spl1)));
  sifam_out += (out_peak - sifam_out) * 0.15;

  // Scope Buffer
  wave_min = min(wave_min, spl0);
  wave_max = max(wave_max, spl0);
  wave_gr = max(wave_gr, gr_disp_db);

  wave_spos >= wave_div ? (
    buf_sz = wave_w * 3;
    wave_ppos >= buf_sz ? (
      memset(WAVE_BUF, 0, buf_sz);
      wave_ppos = 0;
    );
    WAVE_BUF[wave_ppos] = wave_min;
    WAVE_BUF[wave_ppos + 1] = wave_max;
    WAVE_BUF[wave_ppos + 2] = wave_gr;
    wave_ppos += 3;

    wave_min = 1.0;
    wave_max = -1.0;
    wave_gr = 0.0;
    wave_spos = 0;
  );
  wave_spos += 1;

// =============================================================================
@gfx 980 670
  mouse_down = mouse_cap & 1;
  mouse_clicked = mouse_down && !last_mouse_down;

  // Background Obsidian
  set_c(0x0a0c10); gfx_rect(0, 0, gfx_w, gfx_h);

  // 1. TOP COMMAND BAR (FLAGSHIP STANDARD)
  set_c(0x0d121c); gfx_rect(0, 0, gfx_w, 54);
  set_c(0x222e42); gfx_line(0, 54, gfx_w, 54);

  // Title & Subtitle (Large, bold, high contrast)
  set_c(0xdfab35); gfx_setfont(1, "Orbitron", 17, 'b');
  gfx_x = 20; gfx_y = 12; gfx_drawstr("ATUMPAN ROOMSCULPTOR");

  gfx_setfont(2, "Segoe UI", 12.5, 'b'); set_c(0x38b6ff);
  gfx_x = 285; gfx_y = 15; gfx_drawstr("OXFORD INFLATOR & DISTRESSOR NUKE // ACOUSTIC SPACE SMASHER");

  // Ecosystem Comms Sync Pill
  set_c(ecosystem_linked ? 0x0fe49e : 0xdfab35);
  set_ca(ecosystem_linked ? 0x0fe49e : 0xdfab35, 0.15);
  gfx_rect(650, 11, 150, 32);
  set_c(ecosystem_linked ? 0x0fe49e : 0xdfab35); gfx_rect(650, 11, 150, 32, 0);
  gfx_setfont(1, "Orbitron", 11.5, 'b');
  s_sync = ecosystem_linked ? "SENTRY: SYNCED" : "STANDALONE";
  gfx_measurestr(s_sync, tw, th);
  gfx_x = 650 + (150 - tw) * 0.5; gfx_y = 11 + (32 - th) * 0.5; gfx_drawstr(s_sync);

  // Clip 0dBFS Pill (Safe ceiling)
  btn_clip = mouse_x >= 815 && mouse_x < 960 && mouse_y >= 11 && mouse_y < 43;
  set_c(slider3 ? 0x0fe49e : (btn_clip ? 0x222e42 : 0x151c28)); gfx_rect(815, 11, 145, 32);
  set_c(slider3 ? 0x0fe49e : 0x2e3d55); gfx_rect(815, 11, 145, 32, 0);
  gfx_setfont(1, "Orbitron", 11.5, 'b'); set_c(slider3 ? 0x0a0c10 : 0xffffff);
  s_clip = slider3 ? "0dB CEILING: ON" : "0dB CEILING: OFF";
  gfx_measurestr(s_clip, tw, th); gfx_x = 815 + (145 - tw) * 0.5; gfx_y = 11 + (32 - th) * 0.5; gfx_drawstr(s_clip);
  mouse_clicked && btn_clip ? (slider3 = !slider3; sliderchange(slider3););

  // 2. UPPER SECTION: DUAL SIFAM METERS & LIVE ROOM BLOOM OSCILLOSCOPE
  meter_y = 66; meter_w = 215; meter_h = 175;
  draw_sifam(20, meter_y, meter_w, meter_h, "DISTRESSOR GAIN REDUCTION", clamp(sifam_gr / 30.0, 0.0, 1.0), 1);

  // Center: Live Room Bloom Scope with Gain Reduction Fill
  scope_x = 250; scope_y = 66; scope_w = gfx_w - 250 - 235; scope_h = 175;
  set_c(0x121722); gfx_rect(scope_x, scope_y, scope_w, scope_h);
  set_c(0x253348); gfx_rect(scope_x, scope_y, scope_w, scope_h, 0);

  // Scope Header Card
  set_c(0x0a0e16); gfx_rect(scope_x + 1, scope_y + 1, scope_w - 2, 28);
  set_c(0x1e283a); gfx_line(scope_x, scope_y + 29, scope_x + scope_w, scope_y + 29);
  gfx_setfont(1, "Orbitron", 12.5, 'b'); set_c(0xdfab35);
  gfx_x = scope_x + 14; gfx_y = scope_y + 7; gfx_drawstr("ACOUSTIC ROOM BLOOM & COMPRESSION PUMP");

  sc_h = scope_h - 32; sc_y = scope_y + 30;
  axis_y = sc_y + sc_h * 0.5;
  set_ca(0x1e283a, 0.6); gfx_line(scope_x, axis_y, scope_x + scope_w, axis_y);

  // Draw Waveform and Distortion Trace
  wp = 0; sx = scope_x + 4;
  loop(min(scope_w - 8, wave_w),
    w_min = sc_h * 0.45 * WAVE_BUF[wp];
    w_max = sc_h * 0.45 * WAVE_BUF[wp + 1];
    w_min = clamp(w_min, -sc_h * 0.48, sc_h * 0.48);
    w_max = clamp(w_max, -sc_h * 0.48, sc_h * 0.48);
    gr_val = WAVE_BUF[wp + 2]; // dB

    set_ca(0xdfab35, 0.85);
    gfx_line(sx, axis_y - w_min, sx, axis_y - w_max);

    // Reduction trace (Cyan)
    set_ca(0x0fe49e, 0.95);
    gr_y = sc_y + clamp((gr_val / 30.0) * sc_h, 4, sc_h - 4);
    gfx_line(sx, gr_y, sx, gr_y + 2);

    wp += 3; sx += 1;
  );

  // Right: Master Room Output SIFAM
  draw_sifam(gfx_w - meter_w - 20, meter_y, meter_w, meter_h, "MASTER ROOM OUTPUT", sifam_out, 0);

  // 3. MIDDLE SECTION: DISTRESSOR COMPRESSION TOPOLOGY SELECTOR (4:1 Glue, 10:1 Punch, NUKE, Opto)
  top_y = 252; top_h = 42;
  set_c(0x121722); gfx_rect(20, top_y, gfx_w - 40, top_h);
  set_c(0x253348); gfx_rect(20, top_y, gfx_w - 40, top_h, 0);

  tb_w = (gfx_w - 60) / 4.0;
  draw_btn(25 + 0 * tb_w, top_y + 5, tb_w - 5, 32, "PUMPING GLUE (4:1)", slider4 == 0) ? (slider4 = 0; sliderchange(slider4););
  draw_btn(25 + 1 * tb_w, top_y + 5, tb_w - 5, 32, "PUNCH VCA (10:1)", slider4 == 1) ? (slider4 = 1; sliderchange(slider4););
  draw_btn(25 + 2 * tb_w, top_y + 5, tb_w - 5, 32, "DISTRESSOR NUKE (20:1)", slider4 == 2) ? (slider4 = 2; sliderchange(slider4););
  draw_btn(25 + 3 * tb_w, top_y + 5, tb_w - 5, 32, "OPTO WARM BLOOM", slider4 == 3) ? (slider4 = 3; sliderchange(slider4););

  // 4. LOWER SECTION: PARAMETER RACKS (CARD 1: OXFORD INFLATOR // CARD 2: DISTRESSOR & TONE)
  card_y = 306; card_h = 325; card_w = (gfx_w - 50) * 0.5;

  // CARD 1: OXFORD SPACE INFLATOR
  set_c(0x121722); gfx_rect(20, card_y, card_w, card_h);
  set_c(0x253348); gfx_rect(20, card_y, card_w, card_h, 0);
  set_c(0x0a0e16); gfx_rect(21, card_y + 1, card_w - 2, 32);
  set_c(0x1e283a); gfx_line(20, card_y + 33, 20 + card_w, card_y + 33);
  gfx_setfont(1, "Orbitron", 13.5, 'b'); set_c(0xdfab35);
  gfx_x = 34; gfx_y = card_y + 8; gfx_drawstr("OXFORD SPACE INFLATOR");

  // Knobs Row 1: Space Inflation %, Curve %, Air Shimmer 10kHz, Mud Notch 250Hz
  kr1_y = card_y + 90; kw = card_w / 4.0;
  v = slider1 / 100.0;
  v = draw_knob(20 + 0.5 * kw, kr1_y, 24, v, "INFLATION", sprintf(#, "%d%%", slider1), 1);
  slider1 = floor(v * 100.0);

  v = (slider2 + 50.0) / 100.0;
  v = draw_knob(20 + 1.5 * kw, kr1_y, 24, v, "CURVE", sprintf(#, "%+d%%", slider2), 2);
  slider2 = -50.0 + floor(v * 100.0);

  v = slider15 / 10.0;
  v = draw_knob(20 + 2.5 * kw, kr1_y, 24, v, "10k SHIMMER", sprintf(#, "+%.1fdB", slider15), 15);
  slider15 = v * 10.0;

  v = slider17 / 8.0;
  v = draw_knob(20 + 3.5 * kw, kr1_y, 24, v, "250Hz NOTCH", sprintf(#, "-%.1fdB", slider17), 17);
  slider17 = v * 8.0;

  // Row 2: Stereo Width %, Polarity Invert Button, Distortion Color Mode
  kr2_y = card_y + 205;
  v = slider13 / 200.0;
  v = draw_knob(20 + 0.8 * kw, kr2_y, 24, v, "STEREO WIDTH", sprintf(#, "%d%%", slider13), 13);
  slider13 = floor(v * 200.0);

  // Harmonic Color Mode Button (Clean, Dist 2, Dist 3)
  draw_btn(20 + 1.8 * kw, kr2_y - 18, kw * 1.0, 36, slider16 == 0 ? "COLOR: CLEAN" : (slider16 == 1 ? "COLOR: DIST 2" : "COLOR: DIST 3"), slider16 > 0) ? (
    slider16 = (slider16 + 1) % 3; sliderchange(slider16);
  );

  // Polarity Invert Button
  draw_btn(20 + 2.9 * kw, kr2_y - 18, kw * 0.95, 36, slider12 ? "PHASE: 180 FLIP" : "PHASE: NORMAL", slider12) ? (
    slider12 = !slider12; sliderchange(slider12);
  );

  // CARD 2: DISTRESSOR SMASH COMPRESSOR
  c2_x = 30 + card_w;
  set_c(0x121722); gfx_rect(c2_x, card_y, card_w, card_h);
  set_c(0x253348); gfx_rect(c2_x, card_y, card_w, card_h, 0);
  set_c(0x0a0e16); gfx_rect(c2_x + 1, card_y + 1, card_w - 2, 32);
  set_c(0x1e283a); gfx_line(c2_x, card_y + 33, c2_x + card_w, card_y + 33);
  gfx_setfont(1, "Orbitron", 13.5, 'b'); set_c(0x38b6ff);
  gfx_x = c2_x + 14; gfx_y = card_y + 8; gfx_drawstr("DISTRESSOR ROOM SMASHER");

  // Knobs Row 1: Smash Drive dB, Attack ms, Release ms, Detector HPF Hz
  v = slider5 / 60.0;
  v = draw_knob(c2_x + 0.5 * kw, kr1_y, 24, v, "SMASH DRIVE", sprintf(#, "%ddB", slider5), 5);
  slider5 = floor(v * 60.0);

  v = (slider6 - 0.5) / 49.5;
  v = draw_knob(c2_x + 1.5 * kw, kr1_y, 24, v, "ATTACK", sprintf(#, "%.1fms", slider6), 6);
  slider6 = 0.5 + v * 49.5;

  v = (slider7 - 10) / 790.0;
  v = draw_knob(c2_x + 2.5 * kw, kr1_y, 24, v, "RELEASE", sprintf(#, "%dms", slider7), 7);
  slider7 = 10 + floor(v * 790.0);

  v = (slider8 - 30) / 320.0;
  v = draw_knob(c2_x + 3.5 * kw, kr1_y, 24, v, "SIDECHAIN HPF", sprintf(#, "%dHz", slider8), 8);
  slider8 = 30 + floor(v * 320.0);

  // Knobs Row 2: Parallel Smash Mix %, Output Makeup Trim dB
  v = slider9 / 100.0;
  v = draw_knob(c2_x + 1.0 * kw, kr2_y, 24, v, "PARALLEL MIX", sprintf(#, "%d%%", slider9), 9);
  slider9 = floor(v * 100.0);

  v = (slider10 + 18.0) / 36.0;
  v = draw_knob(c2_x + 2.6 * kw, kr2_y, 24, v, "OUTPUT TRIM", sprintf(#, "%+.1fdB", slider10), 10);
  slider10 = -18.0 + v * 36.0;

  // 5. FOOTER COMMAND BAR: ACTIVE PRODUCER PRESET SELECTOR
  foot_y = gfx_h - 32;
  set_c(0x0d121c); gfx_rect(0, foot_y, gfx_w, 32);
  set_c(0x222e42); gfx_line(0, foot_y, gfx_w, foot_y);

  gfx_setfont(1, "Orbitron", 12, 'b'); set_c(0xdfab35);
  gfx_x = 20; gfx_y = foot_y + 8;
  gfx_drawstr("PRODUCER DNA PRESET: ");

  gfx_setfont(1, "Orbitron", 12, 'b'); set_c(0xffffff);
  slider14 == 0 ? p_name = "Default Neutral Wire" :
  slider14 == 1 ? p_name = "Lance Prenc (Alpha Wolf / Polaris)" :
  slider14 == 2 ? p_name = "Scott Seigel (DIESECT)" :
  slider14 == 3 ? p_name = "Jonathan Dolese (Mirrorcell)" :
  slider14 == 4 ? p_name = "Buster Odeholm (thrown / Northlane)" :
  slider14 == 5 ? p_name = "Lewis Johns & Grant Berry (Love Is Noise)" :
  slider14 == 6 ? p_name = "Kel Pinchin (Split Chain)" :
  slider14 == 7 ? p_name = "Dan Lancaster (Don Broco)" :
  slider14 == 8 ? p_name = "Erik Bickerstaffe (Static Dress)" :
  slider14 == 9 ? p_name = "Sam Guaiana (Shyeye)" :
  slider14 == 10 ? p_name = "Zach Tuch (Heavenward)" :
  slider14 == 11 ? p_name = "Forrester Savell (City Of Souls)" :
  slider14 == 12 ? p_name = "Leon Schmidt (SUNBORN)" :
  slider14 == 13 ? p_name = "Ermin Hamidovic (Benchmark)" :
  slider14 == 14 ? p_name = "Will Putney (Fit For An Autopsy / Knocked Loose)" :
  slider14 == 15 ? p_name = "George Lever (Loathe / Sleep Token)" :
  slider14 == 16 ? p_name = "Sam Bassal (Thornhill)" :
  slider14 == 17 ? p_name = "Henrik Udd (Architects / BMTH)" :
  slider14 == 18 ? p_name = "Dan Braunstein (Spiritbox / Dayseeker)" :
  slider14 == 19 ? p_name = "Zakk Cervini (Bad Omens / Blink-182)" :
  slider14 == 20 ? p_name = "Jens Bogren (Fascination Street)" :
  slider14 == 21 ? p_name = "Adam Nolly Getgood (Periphery / GGD)" :
  slider14 == 22 ? p_name = "Acle Kahney (TesseracT)" :
  slider14 == 23 ? p_name = "Adam Cichocki (heaving.)" :
  slider14 == 24 ? p_name = "Manuel Renner (SENNA - Out Of The Blue)" :
  slider14 == 25 ? p_name = "Matt Thomas (Ashtone - Live Room Authority)" :
                  p_name = "Mark Williamson (Sugarhouse - Live Cohesion)";
  gfx_x = 220; gfx_y = foot_y + 8; gfx_drawstr(p_name);

  draw_btn(gfx_w - 90, foot_y + 3, 32, 26, "<", 0) ? (slider14 = max(0, slider14 - 1); sliderchange(slider14););
  draw_btn(gfx_w - 50, foot_y + 3, 32, 26, ">", 0) ? (slider14 = min(26, slider14 + 1); sliderchange(slider14););

  last_mouse_down = mouse_down;
