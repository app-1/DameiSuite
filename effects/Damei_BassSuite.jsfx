  gfx_r = 0.98; gfx_g = 0.35; gfx_b = 0.20; gfx_rect(sync_x, sync_y, sync_w, 28, 0);
  gfx_setfont(1, "Orbitron", 11.5, 'b'); gfx_r = 1.00; gfx_g = 0.40; gfx_b = 0.25;
  r_str = sprintf(#, "▼ BREAKDOWN: DROP", g_cur_rgn_live);
) : (g_bridge_active && gmem[103] > 0) ? (
  gfx_r = 0.03; gfx_g = 0.14; gfx_b = 0.09; gfx_rect(sync_x, sync_y, sync_w, 28);
  gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50; gfx_rect(sync_x, sync_y, sync_w, 28, 0);
  gfx_setfont(1, "Orbitron", 11.5, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.50;
  r_str = sprintf(#, "● SYNC: %d REGIONS", gmem[103]);
) : (
  gfx_r = 0.03; gfx_g = 0.14; gfx_b = 0.09; gfx_rect(sync_x, sync_y, sync_w, 28);
  gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50; gfx_rect(sync_x, sync_y, sync_w, 28, 0);
  gfx_setfont(1, "Consolas", 11.5, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.50;
  r_str = "● KICK LINK: CH 3/4";
);
r_font_sz = 11.5;
gfx_setfont(1, "Orbitron", r_font_sz, 'b');
gfx_measurestr(r_str, rsw, rsh);
while (rsw > sync_w - 14 && r_font_sz > 8.0) (
