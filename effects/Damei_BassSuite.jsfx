gfx_g = (cur_out_true_peak > slider17) ? 0.22 : (cur_out_true_peak > -1.0 ? 0.75 : 0.88);
gfx_b = (cur_out_true_peak > slider17) ? 0.22 : (cur_out_true_peak > -1.0 ? 0.20 : 0.50);
gfx_setfont(1, "Orbitron", 22, 'b');
tp_txt = sprintf(#, "%+.1f dBTP", cur_out_true_peak);
gfx_x = c1_x + 10; gfx_y = card_y + 26; gfx_drawstr(tp_txt);

gfx_setfont(1, "Consolas", 11, 'b'); gfx_r = 0.00; gfx_g = 0.92; gfx_b = 0.85;
gfx_x = c1_x + 10; gfx_y = card_y + 54;
gfx_printf("IN: %.1f | CLIP: %s", cur_true_peak, slider16==0?"PASS":(slider16==1?"HERMITE":"HARD"));

// Card 2: AI Bass Assistant & Mix Lock Deck
c2_x = crt_x + card_w + card_gap;
gfx_r = 0.026; gfx_g = 0.036; gfx_b = 0.046; gfx_rect(c2_x, card_y, card_w, card_h);
gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50; gfx_rect(c2_x, card_y, card_w, card_h, 0);

gfx_setfont(1, "Orbitron", 11.5, 'b'); gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50;
gfx_x = c2_x + 8; gfx_y = card_y + 6; gfx_drawstr("● AI BASS ASSISTANT");

gfx_setfont(1, "Consolas", 10.5, 'b');
gmem[1090] == 3 ? (
  gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50;
  mir_b_tag = "SUB: 94.8% // LOCKED";
  gfx_measurestr(mir_b_tag, lnk_w, lnk_h);
  gfx_x = c2_x + card_w - lnk_w - 8; gfx_y = card_y + 6; gfx_drawstr(mir_b_tag);
) : gmem[820] == 1 ? (
  gfx_r = 0.00; gfx_g = 0.92; gfx_b = 0.85;
  mir_b_tag = "SUB: 94.8% // LOCKED";
  gfx_measurestr(mir_b_tag, lnk_w, lnk_h);
  gfx_x = c2_x + card_w - lnk_w - 8; gfx_y = card_y + 6; gfx_drawstr(mir_b_tag);
) : (
