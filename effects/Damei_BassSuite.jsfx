desc:Damei Bass Bus Engine (Powerhouse Motor & Sub-Kick Interlock)
// =============================================================================
// DAMEI BASS BUS ENGINE // POWERHOUSE MOTOR (v2.0)
// Complete Bass Bus Processing Engine with Kick Sidechain & 3-Way Crossover
// Fraternal Twin Design: Darkglass Emerald & Reinforced Hydraulic Chassis
// Built by Damei Audio & Antigravity IDE
// =============================================================================

slider1:0<0,6,1{Bass Folder Overview,Trackspacer Dynamic Inverse EQ,Sub Anchor & Kick Pocket,3-Way Crossover Sculptor,Phase Alignment & Correlation,Smash & Grab + Decapitator Rack,Producer Matrix & Session Blueprints}>-Active Module
slider2:-12.0<-24.0,-6.0,0.5>-Target Level (dBFS Peak)
slider3:90<50,140,5>-Sub-Mono Elliptical Anchor (Hz) [Mono Below This]
slider4:2.4<0.0,6.0,0.2>-Kick Ducking Depth (dB) [Dynamic Sub Pocket]
slider5:25<10,80,5>-Kick Ducking Attack (ms)
slider6:65<25,180,5>-Kick Ducking Recovery Release (ms)
slider7:60<40,100,5>-Sub Low-Shelf Punch Center (Hz)
slider8:0.0<-6.0,6.0,0.2>-Sub Low-Shelf Trim (dB)
slider9:0<0,1,1{Physical Aux Sends (Ch 3/4 KICK),Inter-Suite Telemetry (gmem 825 Kick RMS)}>-Sidechain Source Select
slider10:0.0<-6.0,6.0,0.2>-Mid Growl Overdrive Trim (dB) [150Hz - 1.2kHz]
slider11:0.0<-6.0,6.0,0.2>-Pick Attack Clank & Snap Trim (dB) [1.8kHz - 3.5kHz]
slider12:0.0<-6.0,0.0,0.2>-Mud Box Scoop 250Hz (dB)
slider13:0.0<-6.0,0.0,0.2>-Ultra-High Clank Whistle Notch 4.5kHz (dB)
slider14:0.0<0.0,5.0,0.1>-Kick vs Bass Phase Micro-Delay (ms)
slider15:0<0,1,1{Normal (In-Phase 0 deg),Inverted (Flip Phase 180 deg)}>-Polarity Inversion Phase Flip
slider16:0<0,2,1{Linear Transparent Passthrough,Smooth Musical Hermite Soft-Clip,Commercial Hard Brickwall Clamp}>-Mix Bus Clipper Topology
slider17:-0.1<-12.0,-0.1,0.1>-Target Headroom Ceiling (dBTP)
slider18:0<0,1,1{Free Output Gain (No Clipping),Strict Pre-Master Headroom Lock}>-Headroom Ceiling Guardian
slider19:0.0<-12.0,12.0,0.5>-Output Makeup Trim (dB)
slider20:15<0,19,1{Default Neutral Wire,Lance Prenc (Alpha Wolf / Polaris),Scott Seigel (DIESECT),Jonathan Dolese (Cane Hill),Buster Odeholm (thrown / Vildhjarta),Kel Pinchin (Currents),Sam Guaiana (Silverstein),Forrester Savell (Karnivool / Dead Letter Circus),Jens Bogren (Fascination Street),Adam Nolly Getgood (Periphery / GGD),Will Putney (Fit For An Autopsy / Knocked Loose),George Lever (Sleep Token / Loathe),Sam Bassal (Thornhill / Ocean Grove),Henrik Udd (Architects / Bring Me The Horizon),Joey Sturgis (Asking Alexandria / Attack Attack),Dan Braunstein (Spiritbox / Dayseeker),Zakk Cervini (Blink-182 / Simple Plan),Acle Kahney (TesseracT - King),Adam Cichocki (heaving. - carsick / Timber Studios),Manuel Renner (SENNA - Out Of The Blue / Überlärm Studios)}>-Producer Bass Signature Preset
slider21:0<0,4,1{Eurobass II MIDI + Parallax X,Real Bass DI + Parallax X,Dingwall Modern Active 5-String,Drop Tuned P-Bass Dirt,Sub Sine Reinforced Clean}>-Bass Rig Source Profile
slider22:-18.0<-24.0,-12.0,1.0>-Analogue 0 VU Target Reference (dBFS RMS)
slider23:25<0,100,1>-Britson Neve Console Drive (%)
slider24:20<0,100,1>-Smash & Grab Opto/VCA Bus Glue (%)
slider25:15<0,100,1>-Darkglass / Tube Saturation Drive (%)
slider26:0<0,1,1{In-Chain Finisher (Complements Britson/S&G/TB/Trackspacer on Trk 66),Standalone All-in-One (Emulates Full 4-Plugin Bus Chain)}>-Bass Bus Integration Mode
slider27:1<0,1,1{Manual Parameter Mode,AI Assist Active Formula Calibration}>-AI Assist Intelligent Engine
slider28:1<0,1,1{Free Dynamic (Manual Trim),Kick/Guitar Pocket Interlock (Auto-Guard -3.5dB rel to Kick)}>-Kick/Guitar Pocket Interlock
slider29:0.0<-6.0,6.0,0.1>-Input Gain Calibration (dB)
slider30:0.0<-6.0,6.0,0.2>-BASS Master Bus Trim (dB) [Trk 66]
slider31:0.0<-6.0,6.0,0.2>-DI Tracking Trim (dB) [Trk 67]
slider32:0.0<-6.0,6.0,0.2>-Synth / Eurobass / Parallax Trim (dB) [Trk 68]
slider33:0.0<-6.0,6.0,0.2>-Mic / Aux Sub-Bus Trim (dB) [Trk 69]
slider34:1<0,1,1{Bypassed,Active Sub-Mono & Dynamic Sidechain}>-Sub Engine Master Toggle

slider35:1<0,1,1{Off,On}>-Matrix Trim (applies Assessment Matrix auto-correct lane)
// Smash & Grab Compressor (JST Modeled)
slider36:2<0,2,1{VCA Smash (Fast Clamp),Opto Grab (Warm Leveler),Hybrid Smash & Grab}>-Smash & Grab Comp Mode
slider37:38<0,100,1>-Smash Amount (%) [Aggressive Attack Clamp]
slider38:42<0,100,1>-Grab Amount (%) [Thick Opto Sustain]
slider39:85<0,100,1>-Smash & Grab Parallel Mix (%)
// Decapitator Saturation (Soundtoys Modeled)
slider40:1<0,3,1{Style A (Ampex Tape),Style N (Neve Console),Style T (Triode Tube),Style P (Pentode Aggression)}>-Decapitator Style
slider41:28<0,100,1>-Decapitator Drive (%)
slider42:0<0,1,1{Normal,PUNISH (+20dB Overdrive)}> -Decapitator Punish Mode
slider43:0.0<-10.0,10.0,0.5>-Decapitator Tone Tilt (Dark/Bright)
slider44:8500<3000,18000,500>-Decapitator High Cut (Hz)
// =============================================================================
// TRACKSPACER (WAVESFACTORY MODELED DYNAMIC INVERSE EQUALIZER)
// =============================================================================
slider45:1<0,1,1{Bypassed,Active Dynamic Inverse EQ}>-Trackspacer Engine Master Toggle
slider46:35<0,100,1>-Trackspacer Ducking Amount (%)
slider47:35<20,800,5>-Trackspacer Low Cut Filter (Hz)
slider48:650<100,16000,20>-Trackspacer High Cut Filter (Hz)
slider49:15<1,100,1>-Trackspacer Attack Time (ms)
slider50:65<10,400,5>-Trackspacer Release Time (ms)
slider51:0<0,2,1{Mid Channel (Center),Stereo Linked (L/R),Side Channel (Stereo)}> -Trackspacer Processing Mode
slider52:0<0,2,1{Normal Passthrough,Audition Kick Sidechain,Audition Carved Delta}>-Trackspacer Audition Mode
slider53:0<0,1,1{State A,State B}>-A/B Snapshot Selector
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=2097152
in_pin:left input
in_pin:right input
in_pin:kick sidechain left (ch 3)
in_pin:kick sidechain right (ch 4)
out_pin:left output
out_pin:right output

