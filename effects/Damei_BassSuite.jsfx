file_var(0, slider1);
file_var(0, slider2);
file_var(0, slider3);
file_var(0, slider4);
file_var(0, slider5);
file_var(0, slider6);
file_var(0, slider7);
file_var(0, slider8);
file_var(0, slider9);
file_var(0, slider10);
file_var(0, slider11);
file_var(0, slider12);
file_var(0, slider13);
file_var(0, slider14);
file_var(0, slider15);
file_var(0, slider16);
file_var(0, slider17);
file_var(0, slider18);
file_var(0, slider19);
file_var(0, slider20);
file_var(0, slider21);
file_var(0, slider22);
file_var(0, slider23);
file_var(0, slider24);
file_var(0, slider25);
file_var(0, slider26);
file_var(0, slider27);
file_var(0, slider28);
file_var(0, slider29);
file_var(0, slider30);
file_var(0, slider31);
file_var(0, slider32);
file_var(0, slider33);
file_var(0, slider34);
file_var(0, slider36); file_var(0, slider37); file_var(0, slider38); file_var(0, slider39);
file_var(0, slider40); file_var(0, slider41); file_var(0, slider42); file_var(0, slider43); file_var(0, slider44);
file_var(0, slider45); file_var(0, slider46); file_var(0, slider47); file_var(0, slider48);
file_var(0, slider49); file_var(0, slider50); file_var(0, slider51); file_var(0, slider52);

@init

ext_noinit = 1.0;

// =============================================================================
// TRACKSPACER DYNAMIC INVERSE EQ STATE & FILTER INITIALIZATION
// =============================================================================
ts_num_bands = 8;
ts_freqs = 30000;
ts_freqs[0] = 42;  ts_freqs[1] = 68;  ts_freqs[2] = 110; ts_freqs[3] = 180;
ts_freqs[4] = 300; ts_freqs[5] = 600; ts_freqs[6] = 1400; ts_freqs[7] = 3200;

ts_sc_env = 30020;    // live kick sidechain envelope per band (0..7)
ts_gr_db  = 30040;    // live dynamic gain reduction per band (0..7)
ts_smooth_gr = 30060; // smoothed GR per band
ts_band_wt   = 30080; // window weight (low cut -> high cut)

// Biquad state arrays for 8 bands:
// Sidechain Bandpass: sc_bp_x1, sc_bp_x2, sc_bp_y1, sc_bp_y2
ts_sc_x1 = 30100; ts_sc_x2 = 30120; ts_sc_y1 = 30140; ts_sc_y2 = 30160;
// Dynamic Peaking EQ (Mid / Left): eq_x1_l, eq_x2_l, eq_y1_l, eq_y2_l
ts_eq_x1_l = 30200; ts_eq_x2_l = 30220; ts_eq_y1_l = 30240; ts_eq_y2_l = 30260;
// Dynamic Peaking EQ (Right channel for stereo mode): eq_x1_r, eq_x2_r, eq_y1_r, eq_y2_r
ts_eq_x1_r = 30300; ts_eq_x2_r = 30320; ts_eq_y1_r = 30340; ts_eq_y2_r = 30360;

ts_max_gr_live = 0.0;
ts_avg_gr_live = 0.0;

ti_init = 0;
loop(ts_num_bands,
  ts_sc_env[ti_init] = 0.0;
  ts_gr_db[ti_init] = 0.0;
  ts_smooth_gr[ti_init] = 0.0;
  ts_band_wt[ti_init] = 1.0;
  ts_sc_x1[ti_init] = 0; ts_sc_x2[ti_init] = 0; ts_sc_y1[ti_init] = 0; ts_sc_y2[ti_init] = 0;
  ts_eq_x1_l[ti_init] = 0; ts_eq_x2_l[ti_init] = 0; ts_eq_y1_l[ti_init] = 0; ts_eq_y2_l[ti_init] = 0;
  ts_eq_x1_r[ti_init] = 0; ts_eq_x2_r[ti_init] = 0; ts_eq_y1_r[ti_init] = 0; ts_eq_y2_r[ti_init] = 0;
  ti_init += 1;
);


// Smash & Grab + Decapitator State & Ballistics
sg_smash_gr = 0.0; sg_grab_gr = 0.0;
sg_meter_smash = 0.0; sg_meter_grab = 0.0;
dec_hc_lx1 = 0; dec_hc_ly1 = 0; dec_hc_rx1 = 0; dec_hc_ry1 = 0;
dec_tone_lx1 = 0; dec_tone_ly1 = 0; dec_tone_rx1 = 0; dec_tone_ry1 = 0;

cur_rms = -90.0;
cur_true_peak = -90.0;
cur_crest = 0.0;
cur_out_true_peak = -90.0;
cur_vu_rms = -90.0;

duck_gr_db = 0.0;
smooth_duck_gr = 0.0;
kick_env = 0.0;
sub_env = 0.0;
sub_energy_db = -90.0;
cur_kick_bass_corr = 1.0;

// Buffers
buf_in_idx = 0;
buf_sz = 160;
buf_in_arr = 10000;
buf_kick_arr = 10200;
buf_sub_arr = 10400;
buf_mid_arr = 10600;
buf_side_arr = 10800;

// Delay line
dly_buf_l = 20000;
dly_buf_r = 22000;
dly_w_idx = 0;
dly_max = 2048;

// Filters
sm_hp_x1 = 0; sm_hp_x2 = 0; sm_hp_y1 = 0; sm_hp_y2 = 0;
sub_lp_x1_l = 0; sub_lp_x2_l = 0; sub_lp_y1_l = 0; sub_lp_y2_l = 0;
sub_lp_x1_r = 0; sub_lp_x2_r = 0; sub_lp_y1_r = 0; sub_lp_y2_r = 0;
mud_x1_l = 0; mud_x2_l = 0; mud_y1_l = 0; mud_y2_l = 0;
mud_x1_r = 0; mud_x2_r = 0; mud_y1_r = 0; mud_y2_r = 0;
clk_x1_l = 0; clk_x2_l = 0; clk_y1_l = 0; clk_y2_l = 0;
clk_x1_r = 0; clk_x2_r = 0; clk_y1_r = 0; clk_y2_r = 0;
whs_x1_l = 0; whs_x2_l = 0; whs_y1_l = 0; whs_y2_l = 0;
whs_x1_r = 0; whs_x2_r = 0; whs_y1_r = 0; whs_y2_r = 0;

function update_trackspacer_filters() local(bi, f, w_lo, w_hi) (
  ts_att_c = exp(-1.0 / (max(0.001, slider49 * 0.001) * srate));
  ts_rel_c = exp(-1.0 / (max(0.010, slider50 * 0.001) * srate));

  bi = 0;
  loop(ts_num_bands,
    f = ts_freqs[bi];
    w_lo = 1.0 / (1.0 + sqr(max(20.0, slider47) / f) * sqr(max(20.0, slider47) / f));
    w_hi = 1.0 / (1.0 + sqr(f / max(100.0, slider48)) * sqr(f / max(100.0, slider48)));
    ts_band_wt[bi] = w_lo * w_hi;
    bi += 1;
  );
);

function update_bass_filters() (

  // Decapitator High Cut (slider44: 3-18kHz 1st order LP)
  dec_w0 = 2.0 * $pi * max(2000.0, min(18000.0, slider44)) / srate;
  dec_hc_alpha = sin(dec_w0) / (cos(dec_w0) + 1.0);
  dec_hc_b0 = dec_hc_alpha; dec_hc_b1 = dec_hc_alpha;
  dec_hc_a1 = -(1.0 - dec_hc_alpha);
  dec_hc_a0 = 1.0 + dec_hc_alpha;
  dec_hc_b0 /= dec_hc_a0; dec_hc_b1 /= dec_hc_a0; dec_hc_a1 /= dec_hc_a0;

  // 1. Sub-Mono Side Highpass (Butterworth 2nd order at slider3 Hz)
  sm_w0 = 2.0 * $pi * slider3 / srate;
  sm_cos = cos(sm_w0); sm_sin = sin(sm_w0);
  sm_alpha = sm_sin / (2.0 * 0.7071);
  sm_b0 = (1.0 + sm_cos) * 0.5; sm_b1 = -(1.0 + sm_cos); sm_b2 = (1.0 + sm_cos) * 0.5;
  sm_a0 = 1.0 + sm_alpha; sm_a1 = -2.0 * sm_cos; sm_a2 = 1.0 - sm_alpha;
  sm_b0 /= sm_a0; sm_b1 /= sm_a0; sm_b2 /= sm_a0; sm_a1 /= sm_a0; sm_a2 /= sm_a0;

  // 2. Sub Crossover Lowpass (< slider3 Hz)
  sub_w0 = 2.0 * $pi * slider3 / srate;
  sub_cos = cos(sub_w0); sub_sin = sin(sub_w0);
  sub_alpha = sub_sin / (2.0 * 0.7071);
  sub_b0 = (1.0 - sub_cos) * 0.5; sub_b1 = 1.0 - sub_cos; sub_b2 = (1.0 - sub_cos) * 0.5;
  sub_a0 = 1.0 + sub_alpha; sub_a1 = -2.0 * sub_cos; sub_a2 = 1.0 - sub_alpha;
  sub_b0 /= sub_a0; sub_b1 /= sub_a0; sub_b2 /= sub_a0; sub_a1 /= sub_a0; sub_a2 /= sub_a0;

  // 3. 250Hz Boxy Mud Scoop (Peaking EQ)
  m_w0 = 2.0 * $pi * 250.0 / srate;
  m_A = exp(slider12 * (log(10.0) / 40.0));
  m_alpha = sin(m_w0) / (2.0 * 1.5);
  m_b0 = 1.0 + m_alpha * m_A; m_b1 = -2.0 * cos(m_w0); m_b2 = 1.0 - m_alpha * m_A;
  m_a0 = 1.0 + m_alpha / m_A; m_a1 = -2.0 * cos(m_w0); m_a2 = 1.0 - m_alpha / m_A;
  m_b0 /= m_a0; m_b1 /= m_a0; m_b2 /= m_a0; m_a1 /= m_a0; m_a2 /= m_a0;

  // 4. 2.8kHz Pick Clank & Attack Snap
  c_w0 = 2.0 * $pi * 2800.0 / srate;
  c_A = exp(slider11 * (log(10.0) / 40.0));
  c_alpha = sin(c_w0) / (2.0 * 1.6);
  c_b0 = 1.0 + c_alpha * c_A; c_b1 = -2.0 * cos(c_w0); c_b2 = 1.0 - c_alpha * c_A;
  c_a0 = 1.0 + c_alpha / c_A; c_a1 = -2.0 * cos(c_w0); c_a2 = 1.0 - c_alpha / c_A;
  c_b0 /= c_a0; c_b1 /= c_a0; c_b2 /= c_a0; c_a1 /= c_a0; c_a2 /= c_a0;

  // 5. 4.5kHz Whistle Notch Tamer
  w_w0 = 2.0 * $pi * 4500.0 / srate;
  w_A = exp(slider13 * (log(10.0) / 40.0));
  w_alpha = sin(w_w0) / (2.0 * 3.5);
  w_b0 = 1.0 + w_alpha * w_A; w_b1 = -2.0 * cos(w_w0); w_b2 = 1.0 - w_alpha * w_A;
  w_a0 = 1.0 + w_alpha / w_A; w_a1 = -2.0 * cos(w_w0); w_a2 = 1.0 - w_alpha / w_A;
  w_b0 /= w_a0; w_b1 /= w_a0; w_b2 /= w_a0; w_a1 /= w_a0; w_a2 /= w_a0;

  // Ballistics
  duck_att_c = exp(-1.0 / (max(0.005, slider5 * 0.001) * srate));
  duck_rel_c = exp(-1.0 / (max(0.020, slider6 * 0.001) * srate));
);

update_bass_filters();
update_trackspacer_filters();

function apply_bass_preset(p_idx) (
  p_idx == 0 ? (
    // Smash & Grab + Decapitator Producer Calibrations
    slider26 = 1; // Standalone All-In-One Mode
    slider36 = 2; slider37 = 35; slider38 = 40; slider39 = 85;
    slider40 = 1; slider41 = 25; slider42 = 0; slider43 = 0.0; slider44 = 9000;
    slider3 = 90; slider4 = 2.0; slider5 = 25; slider6 = 65; slider7 = 60; slider8 = 0.0;
    slider10 = 0.0; slider11 = 0.0; slider12 = 0.0; slider13 = 0.0;
    slider23 = 20; slider24 = 15; slider25 = 10;
  ) : p_idx == 1 ? (
    // Smash & Grab + Decapitator Producer Calibrations
    slider26 = 1; // Standalone All-In-One Mode
    slider36 = 0; slider37 = 60; slider38 = 35; slider39 = 85;
    slider40 = 3; slider41 = 45; slider42 = 1; slider43 = 1.5; slider44 = 8000;
    slider3 = 95; slider4 = 2.8; slider5 = 20; slider6 = 55; slider7 = 65; slider8 = 1.2;
    slider10 = 1.5; slider11 = 2.6; slider12 = -2.5; slider13 = -1.5;
    slider23 = 35; slider24 = 30; slider25 = 25;
  ) : p_idx == 4 ? (
    // Smash & Grab + Decapitator Producer Calibrations
    slider26 = 1; // Standalone All-In-One Mode
    slider36 = 2; slider37 = 70; slider38 = 50; slider39 = 80;
    slider40 = 3; slider41 = 55; slider42 = 1; slider43 = 2.5; slider44 = 7000;
    slider3 = 85; slider4 = 3.2; slider5 = 18; slider6 = 50; slider7 = 55; slider8 = 2.2;
    slider10 = 2.2; slider11 = 1.8; slider12 = -3.2; slider13 = -2.0;
    slider23 = 40; slider24 = 35; slider25 = 35;
  ) : p_idx == 9 ? (
    // Smash & Grab + Decapitator Producer Calibrations
    slider26 = 1; // Standalone All-In-One Mode
    slider36 = 2; slider37 = 42; slider38 = 45; slider39 = 90;
    slider40 = 0; slider41 = 26; slider42 = 0; slider43 = 0.5; slider44 = 9500;
    slider3 = 90; slider4 = 2.4; slider5 = 25; slider6 = 60; slider7 = 60; slider8 = 0.8;
    slider10 = 1.0; slider11 = 3.2; slider12 = -2.0; slider13 = -1.2;
    slider23 = 25; slider24 = 25; slider25 = 20;
  ) : p_idx == 10 ? (
    // Smash & Grab + Decapitator Producer Calibrations
    slider26 = 1; // Standalone All-In-One Mode
    slider36 = 0; slider37 = 62; slider38 = 38; slider39 = 85;
    slider40 = 3; slider41 = 48; slider42 = 1; slider43 = 1.0; slider44 = 8000;
    slider3 = 90; slider4 = 2.6; slider5 = 22; slider6 = 65; slider7 = 60; slider8 = 1.5;
    slider10 = 2.0; slider11 = 1.5; slider12 = -1.5; slider13 = -1.0;
    slider23 = 35; slider24 = 30; slider25 = 25;
  ) : p_idx == 15 ? (
    // Trackspacer Dan Braunstein Signature Pocket Calibration
    slider45 = 1;  // Trackspacer Active
    slider46 = 35; // 35% Dynamic Carve
    slider47 = 35; // 35 Hz Low Cut
    slider48 = 650;// 650 Hz High Cut (leaves bass upper bite intact)
    slider49 = 15; // 15ms Fast Clamp Attack
    slider50 = 65; // 65ms Musical Decay
    slider51 = 0;  // Mid-Only (protects stereo width)
    slider52 = 0;  // Normal

    // Smash & Grab + Decapitator Producer Calibrations
    slider26 = 1; // Standalone All-In-One Mode
    slider36 = 2; slider37 = 46; slider38 = 48; slider39 = 85;
    slider40 = 1; slider41 = 32; slider42 = 0; slider43 = 0.5; slider44 = 8500;
    slider3 = 92; slider4 = 2.5; slider5 = 22; slider6 = 60; slider7 = 62; slider8 = 1.0;
    slider10 = 0.8; slider11 = 2.8; slider12 = -2.4; slider13 = -1.5;
    slider23 = 28; slider24 = 22; slider25 = 18;
  ) : p_idx == 18 ? (
    // 18: Adam Cichocki (heaving. - carsick / Timber Studios) - Thick Saturated Tube Drive & Sub Weight
    slider26 = 1; slider45 = 1; slider46 = 30; slider47 = 40; slider48 = 550; slider49 = 20; slider50 = 80; slider51 = 0; slider52 = 0;
    slider36 = 1; slider37 = 55; slider38 = 45; slider39 = 80;
    slider40 = 2; slider41 = 45; slider42 = 1; slider43 = 0.8; slider44 = 7500;
    slider3 = 85; slider4 = 2.4; slider5 = 20; slider6 = 60; slider7 = 70; slider8 = 1.2;
    slider10 = 1.5; slider11 = 1.8; slider12 = -1.8; slider13 = -1.0;
    slider23 = 38; slider24 = 32; slider25 = 30;
  ) : p_idx == 19 ? (
    // 19: Manuel Renner (SENNA - Out Of The Blue / Überlärm Studios) - Hyper-Modern German Metalcore Clank & Pure Mono Sub Anchor
    slider26 = 1; slider45 = 1; slider46 = 38; slider47 = 35; slider48 = 600; slider49 = 12; slider50 = 60; slider51 = 0; slider52 = 0;
    slider36 = 2; slider37 = 50; slider38 = 40; slider39 = 90;
    slider40 = 3; slider41 = 35; slider42 = 0; slider43 = 0.4; slider44 = 9000;
    slider3 = 92; slider4 = 2.8; slider5 = 22; slider6 = 55; slider7 = 65; slider8 = 1.0;
    slider10 = 0.5; slider11 = 3.2; slider12 = -2.6; slider13 = -1.2;
    slider23 = 26; slider24 = 28; slider25 = 20;
  ) : (
    slider3 = 90; slider4 = 2.2; slider5 = 25; slider6 = 65; slider7 = 60; slider8 = 0.5;
    slider10 = 0.5; slider11 = 1.5; slider12 = -1.5; slider13 = -1.0;
    slider23 = 25; slider24 = 20; slider25 = 15;
  );
  update_bass_filters();
);

function trigger_bass_ai_assist() (
  mst_active = (gmem[800] > -80.0);
  mst_rms = mst_active ? gmem[800] : -18.0;

  drm_active = (gmem[820] == 1 && gmem[823] > -80.0);
  drm_rms = drm_active ? gmem[823] : (mst_rms - 1.0);

  gtr_active = (gmem[840] == 1 && gmem[843] > -80.0);
  gtr_rms = gtr_active ? gmem[843] : (drm_rms - 2.5);

  bass_rel_drm_db = cur_vu_rms - drm_rms;
  bass_rel_gtr_db = cur_vu_rms - gtr_rms;

  drm_active ? (
    slider4 = max(1.8, min(3.2, 2.2 + max(0.0, (cur_vu_rms - drm_rms + 3.0) * 0.3)));
    slider3 = 90;
  ) : (
    slider4 = 2.2; slider3 = 90;
  );

  slider12 = -2.2;
  slider11 = max(1.0, min(3.0, slider11));

  drm_active ? (
    bass_rel_drm_db > -1.0 ? (
      slider19 = max(-3.5, min(2.0, slider19 - 0.5));
    ) : bass_rel_drm_db < -6.0 ? (
      slider19 = max(-3.5, min(2.0, slider19 + 0.5));
    );
  );

  gmem[860] = 1; gmem[861] = slider20; gmem[862] = cur_out_true_peak;
  gmem[863] = cur_vu_rms; gmem[864] = cur_crest; gmem[865] = sub_energy_db;
  gmem[866] = cur_kick_bass_corr; gmem[867] = duck_gr_db;
  gmem[868] = bass_rel_drm_db; gmem[869] = bass_rel_gtr_db;

  update_bass_filters();
  slider_automate();
);


// ===== MATRIX TRIM BEGIN (auto-correction lane published by Damei_AssessmentMatrix) =====
// Final-stage 7-band + side-shelf trim. Targets arrive on gmem[1300 + lane*16 ...]; ramped (~1 s), capped by the Matrix.
mtrim_lane = 1300 + 2*16;
mtrim_mem  = 2096000;
mtrim_on = 0; mtrim_cnt = 0;
// ENERGY LANE state: smoothed density request (0..1) + shaper coefficient
mtrim_ed = 0; mtrim_ek = 0;
mtrim_cur = mtrim_mem + 200;   // 8 current gains (7 bands + side shelf)
i = 0; loop(8, mtrim_cur[i] = 0; i += 1; );
i = 0; loop(100, mtrim_mem[i] = 0; i += 1; );

function mtrim_bq(c, s, x) local(y) (
  y = c[0]*x + s[0];
  s[0] = c[1]*x - c[3]*y + s[1];
  s[1] = c[2]*x - c[4]*y;
  y;
);

// kind: 0 peaking, 1 low shelf, 2 high shelf
function mtrim_design(c, kind, fc, q, gdb) local(A, w0, cs, sn, al, sa, a0, b0, b1, b2, a1, a2) (
  A = pow(10, gdb/40); w0 = 2*$pi*fc/srate; cs = cos(w0); sn = sin(w0);
  kind == 0 ? (
    al = sn/(2*q);
    b0 = 1 + al*A; b1 = -2*cs; b2 = 1 - al*A; a0 = 1 + al/A; a1 = -2*cs; a2 = 1 - al/A;
  ) : (
    sa = 2*sqrt(A)*(sn*0.70710678);
    kind == 1 ? (
      b0 = A*((A+1) - (A-1)*cs + sa); b1 = 2*A*((A-1) - (A+1)*cs); b2 = A*((A+1) - (A-1)*cs - sa);
      a0 = (A+1) + (A-1)*cs + sa;     a1 = -2*((A-1) + (A+1)*cs);  a2 = (A+1) + (A-1)*cs - sa;
    ) : (
      b0 = A*((A+1) + (A-1)*cs + sa); b1 = -2*A*((A-1) + (A+1)*cs); b2 = A*((A+1) + (A-1)*cs - sa);
      a0 = (A+1) - (A-1)*cs + sa;     a1 = 2*((A-1) - (A+1)*cs);    a2 = (A+1) - (A-1)*cs - sa;
    );
  );
  c[0] = b0/a0; c[1] = b1/a0; c[2] = b2/a0; c[3] = a1/a0; c[4] = a2/a0;
);

function mtrim_block() local(ok, b, tg, any, g) (
  ok = (slider35 == 1) && (gmem[mtrim_lane] == 1) && ((time_precise() - gmem[mtrim_lane + 15]) < 5);
  any = 0; b = 0;
  loop(8,
    tg = ok ? gmem[mtrim_lane + 1 + b] : 0;
    mtrim_cur[b] += (tg - mtrim_cur[b]) * 0.012;
    abs(mtrim_cur[b]) > 0.02 ? ( any = 1; );
    b += 1;
  );
  mtrim_on = any;
  mtrim_ed += ((ok ? gmem[mtrim_lane + 9] : 0) - mtrim_ed) * 0.02;   // ~1 s ramp
  mtrim_ek = max(0, min(1, mtrim_ed)) * 0.05;
  any ? (
    mtrim_design(mtrim_mem + 0,  1, 70,    0.7, mtrim_cur[0]);
    mtrim_design(mtrim_mem + 5,  0, 130,   0.8, mtrim_cur[1]);
    mtrim_design(mtrim_mem + 10, 0, 450,   0.8, mtrim_cur[2]);
    mtrim_design(mtrim_mem + 15, 0, 1400,  0.8, mtrim_cur[3]);
    mtrim_design(mtrim_mem + 20, 0, 3800,  0.8, mtrim_cur[4]);
    mtrim_design(mtrim_mem + 25, 0, 7800,  0.8, mtrim_cur[5]);
    mtrim_design(mtrim_mem + 30, 2, 11000, 0.7, mtrim_cur[6]);
    mtrim_design(mtrim_mem + 35, 2, 3000,  0.7, mtrim_cur[7]);
  );
);

function mtrim_process() local(k, yl, yr, mm, ss) (
  mtrim_on ? (
    yl = spl0; yr = spl1; k = 0;
    loop(7,
      yl = mtrim_bq(mtrim_mem + k*5, mtrim_mem + 50 + k*2, yl);
      yr = mtrim_bq(mtrim_mem + k*5, mtrim_mem + 70 + k*2, yr);
      k += 1;
    );
    mm = (yl + yr)*0.5; ss = (yl - yr)*0.5;
    ss = mtrim_bq(mtrim_mem + 35, mtrim_mem + 90, ss);
    spl0 = mm + ss; spl1 = mm - ss;
  );
  mtrim_ek > 0.002 ? (
    spl0 = spl0 / (1 + mtrim_ek * abs(spl0));
    spl1 = spl1 / (1 + mtrim_ek * abs(spl1));
  );
);
// ===== MATRIX TRIM END =====


// =============================================================================
// GLOBAL A/B SNAPSHOT STATE MEMORY & AUDITION ENGINE (END OF @INIT SCOPE)
// =============================================================================
ab_state = 0; ab_mem_a = 60000; ab_mem_b = 60100; ab_init_done = 0;

function save_ab_bass_snapshot(target_buf) local(k) (
  k = 1; loop(52, target_buf[k] = slider(k); k += 1; );
);

function load_ab_bass_snapshot(src_buf) local(k) (
  k = 1; loop(52, slider(k) = src_buf[k]; k += 1; );
  apply_bass_preset(slider20);
  slider_automate();
);

@slider
update_bass_filters();

@block
inp_gain_mult = exp(slider29 * (log(10.0) / 20.0));
out_trim_mult = exp(slider19 * (log(10.0) / 20.0));
ceil_amp = exp(slider17 * (log(10.0) / 20.0));
phase_mult = slider15 ? -1.0 : 1.0;

delay_samples = floor(slider14 * 0.001 * srate);
delay_samples = max(0, min(dly_max - 1, delay_samples));

drm_active = (gmem[820] == 1 && gmem[823] > -80.0);
drm_rms_live = drm_active ? gmem[823] : -18.0;
gtr_active = (gmem[840] == 1 && gmem[843] > -80.0);
gtr_rms_live = gtr_active ? gmem[843] : -19.5;

bass_to_drm_db = cur_vu_rms - drm_rms_live;
bass_to_gtr_db = cur_vu_rms - gtr_rms_live;

gmem[860] = 1;
gmem[861] = slider20;
gmem[862] = cur_out_true_peak;
gmem[863] = cur_vu_rms;
gmem[864] = cur_crest;
gmem[865] = sub_energy_db;
gmem[866] = cur_kick_bass_corr;
gmem[867] = duck_gr_db;
gmem[868] = bass_to_drm_db;
gmem[869] = bass_to_gtr_db;

  mtrim_block();


@sample
s_l = spl0 * inp_gain_mult;
s_r = spl1 * inp_gain_mult;

dly_buf_l[dly_w_idx] = s_l;
dly_buf_r[dly_w_idx] = s_r;
r_idx = (dly_w_idx - delay_samples + dly_max) % dly_max;
s_l = dly_buf_l[r_idx] * phase_mult;
s_r = dly_buf_r[r_idx] * phase_mult;
dly_w_idx = (dly_w_idx + 1) % dly_max;

slider9 == 0 ? (
  kick_det = max(abs(spl2), abs(spl3));
) : (
  g_kick_env = gmem[825];
  kick_det = exp(g_kick_env * (log(10.0) / 20.0));
);

kick_env = kick_det > kick_env ? (kick_env * duck_att_c + kick_det * (1.0 - duck_att_c)) : (kick_env * duck_rel_c);
kick_db = kick_env > 0.00001 ? 20.0 * log10(kick_env) : -90.0;

kick_over = max(0.0, kick_db - (-24.0));
knee_k = kick_over / (kick_over + 4.0);
target_duck_gr = -min(slider4, (kick_over * knee_k) * 0.45);
smooth_duck_gr = smooth_duck_gr * 0.92 + target_duck_gr * 0.08;
duck_gr_db = smooth_duck_gr;
duck_mult = exp(duck_gr_db * (log(10.0) / 20.0));

mid = (s_l + s_r) * 0.5;
side = (s_l - s_r) * 0.5;

hp_side = sm_b0 * side + sm_b1 * sm_hp_x1 + sm_b2 * sm_hp_x2 - sm_a1 * sm_hp_y1 - sm_a2 * sm_hp_y2;
sm_hp_x2 = sm_hp_x1; sm_hp_x1 = side; sm_hp_y2 = sm_hp_y1; sm_hp_y1 = hp_side;

slider34 ? (
  s_l = mid + hp_side;
  s_r = mid - hp_side;
);

// =============================================================================
// TRACKSPACER DYNAMIC INVERSE EQUALIZER DSP ENGINE
// =============================================================================
slider45 ? (
  // 1. Obtain Sidechain Kick Signal
  slider9 == 0 ? (
    ts_kick_sig = (spl2 + spl3) * 0.5;
  ) : (
    ts_kick_sig = exp(gmem[825] * 0.11512925);
  );

  ts_max_gr_live = 0.0;
  ts_tot_gr = 0.0;
  ts_delta_m = 0.0;

  // Mid/Side split of incoming signal
  ts_mid = (s_l + s_r) * 0.5;
  ts_side = (s_l - s_r) * 0.5;
  ts_orig_mid = ts_mid;
  ts_orig_l = s_l;
  ts_orig_r = s_r;

  ts_b = 0;
  loop(ts_num_bands,
    ts_fc = ts_freqs[ts_b];

    // 2. Sidechain 2nd-Order Bandpass Detector
    ts_w0 = 2.0 * $pi * ts_fc / srate;
    ts_sin = sin(ts_w0); ts_cos = cos(ts_w0);
    ts_alpha = ts_sin / (2.0 * 1.5); // Q = 1.5
    ts_b0_bp = ts_alpha;
    ts_b1_bp = 0.0;
    ts_b2_bp = -ts_alpha;
    ts_a0_bp = 1.0 + ts_alpha;
    ts_a1_bp = -2.0 * ts_cos;
    ts_a2_bp = 1.0 - ts_alpha;

    ts_sc_out = (ts_b0_bp * ts_kick_sig + ts_b1_bp * ts_sc_x1[ts_b] + ts_b2_bp * ts_sc_x2[ts_b] - ts_a1_bp * ts_sc_y1[ts_b] - ts_a2_bp * ts_sc_y2[ts_b]) / ts_a0_bp;
    ts_sc_x2[ts_b] = ts_sc_x1[ts_b]; ts_sc_x1[ts_b] = ts_kick_sig;
    ts_sc_y2[ts_b] = ts_sc_y1[ts_b]; ts_sc_y1[ts_b] = ts_sc_out;

    // 3. Dynamic Ballistics & Envelope
    ts_sc_mag = abs(ts_sc_out);
    ts_sc_env[ts_b] = (ts_sc_mag > ts_sc_env[ts_b]) ? (ts_sc_env[ts_b] * ts_att_c + ts_sc_mag * (1.0 - ts_att_c)) : (ts_sc_env[ts_b] * ts_rel_c);

    // 4. Calculate Dynamic Inverse Notch Gain (dB)
    ts_sc_db = ts_sc_env[ts_b] > 0.00001 ? 20.0 * log10(ts_sc_env[ts_b]) : -90.0;
    ts_kick_over = max(0.0, ts_sc_db - (-28.0));
    ts_target_gr = -min(12.0, ts_kick_over * (slider46 * 0.01) * 0.65) * ts_band_wt[ts_b];
    ts_smooth_gr[ts_b] = ts_smooth_gr[ts_b] * 0.88 + ts_target_gr * 0.12;
    ts_gr_db[ts_b] = ts_smooth_gr[ts_b];

    ts_max_gr_live = min(ts_max_gr_live, ts_gr_db[ts_b]);
    ts_tot_gr += ts_gr_db[ts_b];

    // 5. Apply Dynamic Inverse Notch Filter to Bass
    abs(ts_gr_db[ts_b]) > 0.05 ? (
      ts_A = exp(ts_gr_db[ts_b] * 0.05756462); // 10^(dB/40)
      ts_a0_eq = 1.0 + ts_alpha / ts_A;
      ts_b0_eq = (1.0 + ts_alpha * ts_A) / ts_a0_eq;
      ts_b1_eq = (-2.0 * ts_cos) / ts_a0_eq;
      ts_b2_eq = (1.0 - ts_alpha * ts_A) / ts_a0_eq;
      ts_a1_eq = (-2.0 * ts_cos) / ts_a0_eq;
      ts_a2_eq = (1.0 - ts_alpha / ts_A) / ts_a0_eq;

      // Channel mode: 0=Mid Only, 1=Stereo, 2=Side Only
      slider51 == 0 ? (
        ts_m_out = ts_b0_eq * ts_mid + ts_b1_eq * ts_eq_x1_l[ts_b] + ts_b2_eq * ts_eq_x2_l[ts_b] - ts_a1_eq * ts_eq_y1_l[ts_b] - ts_a2_eq * ts_eq_y2_l[ts_b];
        ts_eq_x2_l[ts_b] = ts_eq_x1_l[ts_b]; ts_eq_x1_l[ts_b] = ts_mid;
        ts_eq_y2_l[ts_b] = ts_eq_y1_l[ts_b]; ts_eq_y1_l[ts_b] = ts_m_out;
        ts_mid = ts_m_out;
      ) : slider51 == 1 ? (
        ts_l_out = ts_b0_eq * s_l + ts_b1_eq * ts_eq_x1_l[ts_b] + ts_b2_eq * ts_eq_x2_l[ts_b] - ts_a1_eq * ts_eq_y1_l[ts_b] - ts_a2_eq * ts_eq_y2_l[ts_b];
        ts_eq_x2_l[ts_b] = ts_eq_x1_l[ts_b]; ts_eq_x1_l[ts_b] = s_l;
        ts_eq_y2_l[ts_b] = ts_eq_y1_l[ts_b]; ts_eq_y1_l[ts_b] = ts_l_out;
        s_l = ts_l_out;

        ts_r_out = ts_b0_eq * s_r + ts_b1_eq * ts_eq_x1_r[ts_b] + ts_b2_eq * ts_eq_x2_r[ts_b] - ts_a1_eq * ts_eq_y1_r[ts_b] - ts_a2_eq * ts_eq_y2_r[ts_b];
        ts_eq_x2_r[ts_b] = ts_eq_x1_r[ts_b]; ts_eq_x1_r[ts_b] = s_r;
        ts_eq_y2_r[ts_b] = ts_eq_y1_r[ts_b]; ts_eq_y1_r[ts_b] = ts_r_out;
        s_r = ts_r_out;
      ) : (
        ts_s_out = ts_b0_eq * ts_side + ts_b1_eq * ts_eq_x1_l[ts_b] + ts_b2_eq * ts_eq_x2_l[ts_b] - ts_a1_eq * ts_eq_y1_l[ts_b] - ts_a2_eq * ts_eq_y2_l[ts_b];
        ts_eq_x2_l[ts_b] = ts_eq_x1_l[ts_b]; ts_eq_x1_l[ts_b] = ts_side;
        ts_eq_y2_l[ts_b] = ts_eq_y1_l[ts_b]; ts_eq_y1_l[ts_b] = ts_s_out;
        ts_side = ts_s_out;
      );
    );

    ts_b += 1;
  );

  slider51 == 0 ? (
    ts_delta_m = ts_orig_mid - ts_mid;
    s_l = ts_mid + ts_side;
    s_r = ts_mid - ts_side;
  ) : slider51 == 2 ? (
    ts_delta_m = ts_orig_mid - (ts_mid);
    s_l = ts_mid + ts_side;
    s_r = ts_mid - ts_side;
  ) : (
    ts_delta_m = ((ts_orig_l + ts_orig_r) - (s_l + s_r)) * 0.5;
  );

  // Audition Modes:
  // 1 = Audition Kick Sidechain Detector
  // 2 = Audition Dynamic Carve Delta (what is being removed from bass)
  slider52 == 1 ? (
    s_l = ts_kick_sig;
    s_r = ts_kick_sig;
  ) : slider52 == 2 ? (
    s_l = ts_delta_m;
    s_r = ts_delta_m;
  );
);


sub_l = sub_b0 * s_l + sub_b1 * sub_lp_x1_l + sub_b2 * sub_lp_x2_l - sub_a1 * sub_lp_y1_l - sub_a2 * sub_lp_y2_l;
sub_lp_x2_l = sub_lp_x1_l; sub_lp_x1_l = s_l; sub_lp_y2_l = sub_lp_y1_l; sub_lp_y1_l = sub_l;
sub_r = sub_b0 * s_r + sub_b1 * sub_lp_x1_r + sub_b2 * sub_lp_x2_r - sub_a1 * sub_lp_y1_r - sub_a2 * sub_lp_y2_r;
sub_lp_x2_r = sub_lp_x1_r; sub_lp_x1_r = s_r; sub_lp_y2_r = sub_lp_y1_r; sub_lp_y1_r = sub_r;

top_l = s_l - sub_l;
top_r = s_r - sub_r;

slider34 ? (
  sub_l *= duck_mult;
  sub_r *= duck_mult;
);

m_l = m_b0 * top_l + m_b1 * mud_x1_l + m_b2 * mud_x2_l - m_a1 * mud_y1_l - m_a2 * mud_y2_l;
mud_x2_l = mud_x1_l; mud_x1_l = top_l; mud_y2_l = mud_y1_l; mud_y1_l = m_l;
m_r = m_b0 * top_r + m_b1 * mud_x1_r + m_b2 * mud_x2_r - m_a1 * mud_y1_r - m_a2 * mud_y2_r;
mud_x2_r = mud_x1_r; mud_x1_r = top_r; mud_y2_r = mud_y1_r; mud_y1_r = m_r;

c_l = c_b0 * m_l + c_b1 * clk_x1_l + c_b2 * clk_x2_l - c_a1 * clk_y1_l - c_a2 * clk_y2_l;
clk_x2_l = clk_x1_l; clk_x1_l = m_l; clk_y2_l = clk_y1_l; clk_y1_l = c_l;
c_r = c_b0 * m_r + c_b1 * clk_x1_r + c_b2 * clk_x2_r - c_a1 * clk_y1_r - c_a2 * clk_y2_r;
clk_x2_r = clk_x1_r; clk_x1_r = m_r; clk_y2_r = clk_y1_r; clk_y1_r = c_r;

w_l = w_b0 * c_l + w_b1 * whs_x1_l + w_b2 * whs_x2_l - w_a1 * whs_y1_l - w_a2 * whs_y2_l;
whs_x2_l = whs_x1_l; whs_x1_l = c_l; whs_y2_l = whs_y1_l; whs_y1_l = w_l;
w_r = w_b0 * c_r + w_b1 * whs_x1_r + w_b2 * whs_x2_r - w_a1 * whs_y1_r - w_a2 * whs_y2_r;
whs_x2_r = whs_x1_r; whs_x1_r = c_r; whs_y2_r = whs_y1_r; whs_y1_r = w_r;

out_l = sub_l + w_l;
out_r = sub_r + w_r;

drv_amt = slider23 * 0.003;
tube_amt = slider25 * 0.004;
out_l = out_l + (out_l - 0.33 * out_l * out_l * out_l) * drv_amt + sin(out_l * 1.5) * tube_amt;
out_r = out_r + (out_r - 0.33 * out_r * out_r * out_r) * drv_amt + sin(out_r * 1.5) * tube_amt;


// ---- Smash & Grab Dual-Stage Compressor (VCA Slam + Opto Leveling) ----
(slider26 == 1 || slider37 > 0 || slider38 > 0) ? (
  sg_dry_l = out_l; sg_dry_r = out_r;

  sg_det = max(abs(out_l), abs(out_r));
  sg_db = sg_det > 0.000001 ? 20.0 * log10(sg_det) : -120.0;

  // 1. Smash Stage (Fast VCA clamp, 2ms attack, 65ms release, 8:1 ratio)
  smash_thr = -14.0 - (slider37 * 0.22);
  smash_over = max(0.0, sg_db - smash_thr);
  smash_tgt = smash_over * (1.0 - 1.0 / 8.0) * (slider37 * 0.01);
  sg_smash_gr = smash_tgt > sg_smash_gr ? (smash_tgt + (sg_smash_gr - smash_tgt) * 0.94) : (smash_tgt + (sg_smash_gr - smash_tgt) * 0.985);
  sg_meter_smash = sg_meter_smash * 0.90 + sg_smash_gr * 0.10;

  // 2. Grab Stage (Smooth Opto sustain, 15ms attack, 180ms dual release, 3.5:1 ratio)
  grab_thr = -18.0 - (slider38 * 0.18);
  grab_over = max(0.0, sg_db - grab_thr);
  grab_tgt = grab_over * (1.0 - 1.0 / 3.5) * (slider38 * 0.01);
  sg_grab_gr = grab_tgt > sg_grab_gr ? (grab_tgt + (sg_grab_gr - grab_tgt) * 0.96) : (grab_tgt + (sg_grab_gr - grab_tgt) * 0.992);
  sg_meter_grab = sg_meter_grab * 0.90 + sg_grab_gr * 0.10;

  // 3. Combined Reduction based on Mode (0: Smash, 1: Grab, 2: Hybrid)
  tot_gr = slider36 == 0 ? sg_smash_gr : (slider36 == 1 ? sg_grab_gr : (sg_smash_gr * 0.65 + sg_grab_gr * 0.55));
  sg_gain = exp(-tot_gr * 0.11512925);
  sg_wet_l = out_l * sg_gain;
  sg_wet_r = out_r * sg_gain;

  sg_mix = slider39 * 0.01;
  out_l = sg_dry_l * (1.0 - sg_mix) + sg_wet_l * sg_mix;
  out_r = sg_dry_r * (1.0 - sg_mix) + sg_wet_r * sg_mix;
);

// ---- Decapitator Saturation Engine (Soundtoys Modeled A/N/T/P Styles) ----
(slider26 == 1 || slider41 > 0 || slider42 == 1) ? (
  dec_drv = (slider41 * 0.01) * (slider42 == 1 ? 4.8 : 1.35) + 1.0;
  dec_in_l = out_l * dec_drv;
  dec_in_r = out_r * dec_drv;

  // Style Selection:
  slider40 == 0 ? ( // Style A (Ampex Tape: warm symmetrical soft saturation)
    dec_sat_l = (dec_in_l * 0.85) / (1.0 + abs(dec_in_l * 0.85) * 0.5) * 1.15;
    dec_sat_r = (dec_in_r * 0.85) / (1.0 + abs(dec_in_r * 0.85) * 0.5) * 1.15;
  ) : slider40 == 1 ? ( // Style N (Neve Console: 2nd harmonic transformer crunch)
    dec_sat_l = (dec_in_l - 0.20 * dec_in_l * dec_in_l) / (1.0 + abs(dec_in_l) * 0.40);
    dec_sat_r = (dec_in_r - 0.20 * dec_in_r * dec_in_r) / (1.0 + abs(dec_in_r) * 0.40);
  ) : slider40 == 2 ? ( // Style T (Triode Tube: rich warm tube glow)
    dec_sat_l = sin(max(-1.57, min(1.57, dec_in_l * 0.70))) * 1.35;
    dec_sat_r = sin(max(-1.57, min(1.57, dec_in_r * 0.70))) * 1.35;
  ) : ( // Style P (Pentode: aggressive modern dirt & growl)
    dec_sat_l = max(-0.95, min(0.95, dec_in_l - 0.33 * dec_in_l * dec_in_l * dec_in_l));
    dec_sat_r = max(-0.95, min(0.95, dec_in_r - 0.33 * dec_in_r * dec_in_r * dec_in_r));
  );

  // Tone Tilt (-10 to +10)
  slider43 != 0.0 ? (
    tilt_gain = exp((slider43 * 0.3) * 0.11512925);
    dec_sat_l *= tilt_gain;
    dec_sat_r *= tilt_gain;
  );

  // High Cut Filter
  slider44 < 17500 ? (
    dec_hc_out_l = dec_hc_b0 * dec_sat_l + dec_hc_b1 * dec_hc_lx1 - dec_hc_a1 * dec_hc_ly1;
    dec_hc_lx1 = dec_sat_l; dec_hc_ly1 = dec_hc_out_l;
    dec_sat_l = dec_hc_out_l;

    dec_hc_out_r = dec_hc_b0 * dec_sat_r + dec_hc_b1 * dec_hc_rx1 - dec_hc_a1 * dec_hc_ry1;
    dec_hc_rx1 = dec_sat_r; dec_hc_ry1 = dec_hc_out_r;
    dec_sat_r = dec_hc_out_r;
  );

  // Blend into output
  dec_mix = min(1.0, (slider41 * 0.01) * 0.75 + (slider42 == 1 ? 0.35 : 0.0));
  out_l = out_l * (1.0 - dec_mix) + dec_sat_l * dec_mix;
  out_r = out_r * (1.0 - dec_mix) + dec_sat_r * dec_mix;
);

out_l *= out_trim_mult;
out_r *= out_trim_mult;

slider16 == 1 ? (
  out_l = max(-ceil_amp, min(ceil_amp, out_l - 0.15 * out_l * out_l * out_l));
  out_r = max(-ceil_amp, min(ceil_amp, out_r - 0.15 * out_r * out_r * out_r));
) : slider16 == 2 ? (
  out_l = max(-ceil_amp, min(ceil_amp, out_l));
  out_r = max(-ceil_amp, min(ceil_amp, out_r));
);

spl0 = out_l;
spl1 = out_r;

in_abs = max(abs(out_l), abs(out_r));
cur_true_peak = in_abs > 0.00001 ? 20.0 * log10(in_abs) : -90.0;
cur_out_true_peak = cur_true_peak;
cur_rms = cur_rms * 0.9995 + (out_l * out_l + out_r * out_r) * 0.0005;
cur_vu_rms = cur_rms > 0.00000001 ? 10.0 * log10(cur_rms * 0.5) : -90.0;
cur_crest = max(0.0, cur_out_true_peak - cur_vu_rms);

sub_abs = max(abs(sub_l), abs(sub_r));
sub_env = sub_abs > sub_env ? (sub_env * 0.95 + sub_abs * 0.05) : (sub_env * 0.999);
sub_energy_db = sub_env > 0.00001 ? 20.0 * log10(sub_env) : -90.0;

sub_mono_sum = (sub_l + sub_r) * 0.5;
kick_mono_sum = (spl2 + spl3) * 0.5;
kick_sub_prod = sub_mono_sum * kick_mono_sum;
kick_sub_sq = max(0.00001, abs(sub_mono_sum) * abs(kick_mono_sum));
raw_corr = kick_sub_sq > 0.00005 ? (kick_sub_prod / kick_sub_sq) : 1.0;
cur_kick_bass_corr = cur_kick_bass_corr * 0.995 + raw_corr * 0.005;
cur_kick_bass_corr = max(-1.0, min(1.0, cur_kick_bass_corr));

(sample_cnt += 1) >= 28 ? (
  sample_cnt = 0;
  buf_in_arr[buf_in_idx] = in_abs;
  buf_kick_arr[buf_in_idx] = kick_env;
  buf_sub_arr[buf_in_idx] = sub_env;
  buf_mid_arr[buf_in_idx] = mid;
  buf_side_arr[buf_in_idx] = hp_side;
  buf_in_idx = (buf_in_idx + 1) % buf_sz;
);

  // Universal Song Section Bus - Musical Transition Flow (Chokes removed to prevent audio dropouts)
  mtrim_process();

@gfx 1080 700
// =============================================================================
// DAMEI BASS BUS ENGINE // FRATERNAL TWIN: DARKGLASS EMERALD & REINFORCED CHASSIS
// =============================================================================
scale = min(gfx_w / 1080, gfx_h / 700);
scale = max(0.65, min(1.5, scale));

mouse_clicked = (mouse_cap & 1) && !(prev_mouse_cap & 1);
mouse_down = (mouse_cap & 1);
prev_mouse_cap = mouse_cap;
shift_down = (mouse_cap & 8);
ctrl_down = (mouse_cap & 4);
is_double_click = 0;
mouse_clicked ? (
  (time_precise() - last_click_t < 0.28) ? ( is_double_click = 1; );
  last_click_t = time_precise();
);
m_wheel = mouse_wheel; mouse_wheel = 0;
!ab_init_done ? (
  save_ab_bass_snapshot(ab_mem_a);
  save_ab_bass_snapshot(ab_mem_b);
  ab_init_done = 1;
);

// Deep Industrial Sub-Gunmetal Background
gfx_r = 0.018; gfx_g = 0.024; gfx_b = 0.030; gfx_a = 1.0;
gfx_rect(0, 0, gfx_w, gfx_h);

// REINFORCED INDUSTRIAL CHASSIS (FRATERNAL TWIN CORNER CHAMFERS & RIVETS)
// Outer Darkglass Emerald Structural Frame
gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50; // Acid Jade / Darkglass Emerald
gfx_rect(8, 8, gfx_w - 16, gfx_h - 16, 0);

// Inner Gunmetal Protective Inset
gfx_r = 0.14; gfx_g = 0.22; gfx_b = 0.28;
gfx_rect(10, 10, gfx_w - 20, gfx_h - 20, 0);

// 4 Industrial Corner Reinforcement Gussets (Diagonal Braces)
gus_sz = 14;
gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50;
gfx_line(8, 8 + gus_sz, 8 + gus_sz, 8);
gfx_line(gfx_w - 8 - gus_sz, 8, gfx_w - 8, 8 + gus_sz);
gfx_line(8, gfx_h - 8 - gus_sz, 8 + gus_sz, gfx_h - 8);
gfx_line(gfx_w - 8 - gus_sz, gfx_h - 8, gfx_w - 8, gfx_h - 8 - gus_sz);

// 4 Hex-Rivet Seismic Containment Anchors
gfx_r = 0.18; gfx_g = 0.28; gfx_b = 0.36;
gfx_circle(20, 20, 4, 1); gfx_circle(gfx_w - 20, 20, 4, 1);
gfx_circle(20, gfx_h - 20, 4, 1); gfx_circle(gfx_w - 20, gfx_h - 20, 4, 1);
gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50;
gfx_circle(20, 20, 4, 0); gfx_circle(gfx_w - 20, 20, 4, 0);
gfx_circle(20, gfx_h - 20, 4, 0); gfx_circle(gfx_w - 20, gfx_h - 20, 4, 0);

// TOP HEADER BAR (42px)
hdr_y = 16; hdr_h = 42;
gfx_r = 0.028; gfx_g = 0.038; gfx_b = 0.048;
gfx_rect(14, hdr_y, gfx_w - 28, hdr_h);
gfx_r = 0.14; gfx_g = 0.32; gfx_b = 0.30;
gfx_rect(14, hdr_y, gfx_w - 28, hdr_h, 0);

// Subterranean Radar Logo & Branding (Pulsing Emerald Rings)
gfx_r = 0.06; gfx_g = 0.88; gfx_b = 0.50;
gfx_circle(36, hdr_y + 21, 11, 0);
gfx_circle(36, hdr_y + 21, 6, 0);
gfx_circle(36, hdr_y + 21, 2, 1);

gfx_setfont(1, "Orbitron", 17, 'b');
gfx_r = 0.15; gfx_g = 0.96; gfx_b = 0.60;
gfx_x = 56; gfx_y = hdr_y + 11;
gfx_drawstr("DAMEI // BASS BUS ENGINE");

// Preset Navigator Selector Box
p_box_x = 360; p_box_w = 260; p_box_y = hdr_y + 7; p_box_h = 28;
gfx_r = 0.03; gfx_g = 0.06; gfx_b = 0.08; gfx_rect(p_box_x, p_box_y, p_box_w, p_box_h);
gfx_r = 0.06; gfx_g = 0.65; gfx_b = 0.45; gfx_rect(p_box_x, p_box_y, p_box_w, p_box_h, 0);

// Left / Right Steppers
p_btn_w = 24;
left_hov = (mouse_x >= p_box_x && mouse_x <= p_box_x + p_btn_w && mouse_y >= p_box_y && mouse_y <= p_box_y + p_box_h);
right_hov = (mouse_x >= p_box_x + p_box_w - p_btn_w && mouse_x <= p_box_x + p_box_w && mouse_y >= p_box_y && mouse_y <= p_box_y + p_box_h);
gfx_r = left_hov ? 0.10 : 0.05; gfx_g = left_hov ? 0.30 : 0.14; gfx_b = left_hov ? 0.22 : 0.10;
gfx_rect(p_box_x, p_box_y, p_btn_w, p_box_h);
gfx_r = right_hov ? 0.10 : 0.05; gfx_g = right_hov ? 0.30 : 0.14; gfx_b = right_hov ? 0.22 : 0.10;
gfx_rect(p_box_x + p_box_w - p_btn_w, p_box_y, p_btn_w, p_box_h);

gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.00; gfx_g = 0.92; gfx_b = 0.85;
gfx_x = p_box_x + 8; gfx_y = p_box_y + 6; gfx_drawstr("<");
gfx_x = p_box_x + p_box_w - 16; gfx_y = p_box_y + 6; gfx_drawstr(">");

mouse_clicked && left_hov ? (
  slider20 = max(0, slider20 - 1); apply_bass_preset(slider20); slider_automate();
);
mouse_clicked && right_hov ? (
  slider20 = min(19, slider20 + 1); apply_bass_preset(slider20); slider_automate();
);
mouse_clicked && (mouse_x > p_box_x + p_btn_w && mouse_x < p_box_x + p_box_w - p_btn_w && mouse_y >= p_box_y && mouse_y <= p_box_y + p_box_h) ? (
  b_choice = gfx_showmenu("0: Default Neutral Wire|1: Lance Prenc (Alpha Wolf / Polaris)|2: Scott Seigel (DIESECT)|3: Jonathan Dolese (Cane Hill)|4: Buster Odeholm (thrown / Vildhjarta)|5: Kel Pinchin (Currents)|6: Sam Guaiana (Silverstein)|7: Forrester Savell (Karnivool)|8: Jens Bogren (Fascination Street)|9: Adam Nolly Getgood (Periphery)|10: Will Putney (Fit For An Autopsy)|11: George Lever (Sleep Token)|12: Sam Bassal (Thornhill)|13: Henrik Udd (Architects)|14: Joey Sturgis (Asking Alexandria)|15: Dan Braunstein (Spiritbox)|16: Zakk Cervini (Blink-182)|17: Acle Kahney (TesseracT - King)|18: Adam Cichocki (heaving. - carsick / Timber Studios)|19: Manuel Renner (SENNA - Out Of The Blue / Überlärm Studios)");
  b_choice > 0 ? (slider20 = b_choice - 1; apply_bass_preset(slider20); slider_automate(););
);

// Preset Name Center
gfx_setfont(1, "Consolas", 11.5, 'b'); gfx_r = 0.40; gfx_g = 1.00; gfx_b = 0.70;
p_name = (
