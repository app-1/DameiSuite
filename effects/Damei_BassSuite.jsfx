  slider20 == 6  ? "6: Sam Guaiana (Silverstein)" :
  slider20 == 7  ? "7: Forrester Savell (Karnivool)" :
  slider20 == 8  ? "8: Jens Bogren (Fascination)" :
  slider20 == 9  ? "9: Adam Nolly (Periphery)" :
  slider20 == 10 ? "10: Will Putney (FFAA)" :
  slider20 == 11 ? "11: George Lever (Sleep Token)" :
  slider20 == 12 ? "12: Sam Bassal (Thornhill)" :
  slider20 == 13 ? "13: Henrik Udd (Architects)" :
  slider20 == 14 ? "14: Joey Sturgis (Asking Alex)" :
  slider20 == 15 ? "15: Dan Braunstein (Spiritbox)" :
  slider20 == 16 ? "16: Zakk Cervini (Blink-182)" :
  slider20 == 17 ? "17: Acle Kahney (TesseracT)" :
  slider20 == 18 ? "18: Adam Cichocki (heaving.)" :
  "19: Manuel Renner (SENNA)"
);
p_font_sz = 11.5;
