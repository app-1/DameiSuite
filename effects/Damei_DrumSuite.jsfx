  // CARD 3: DEVIL-SLAM & BUS CLIPPER
  // ─────────────────────────────────────────────────────────────────────────────
  c3_x = disp_x + 22 + card_w_t4 * 2; c3_y = disp_y + 36;
  gfx_r = 0.035; gfx_g = 0.046; gfx_b = 0.062; gfx_rect(c3_x, c3_y, card_w_t4, card_h_t4);
  gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22; gfx_rect(c3_x, c3_y, card_w_t4, card_h_t4, 0);

  gfx_setfont(1, "Orbitron", 14, 'b'); gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;
  gfx_x = c3_x + 16; gfx_y = c3_y + 14; gfx_drawstr("DEVIL-SLAM & BUS CLIPPER");

  // Parameter 1: Devil-Loc Parallel Crush (0 to 100%)
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = c3_x + 16; gfx_y = p1_y;
  gfx_drawstr("DEVIL-SLAM (PARALLEL CRUSH)");
  gfx_setfont(1, "Orbitron", 16, 'b'); gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;
  dslam_str = sprintf(#, "%d%%", slider36);
  gfx_measurestr(dslam_str, dsw2, dsh2);
  gfx_x = c3_x + card_w_t4 - dsw2 - 16; gfx_y = p1_y - 2; gfx_drawstr(dslam_str);

  // Meter Bar 5 with dynamic parallel crush slam bounce
  m5_x = c3_x + 16; m5_y = p1_y + 22; m5_w = card_w_t4 - 32; m5_h = 20;
  m5_hov = (mouse_x >= m5_x && mouse_x <= m5_x + m5_w && mouse_y >= m5_y && mouse_y <= m5_y + m5_h);
  gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.05; gfx_rect(m5_x, m5_y, m5_w, m5_h);
  gfx_r = 0.20; gfx_g = 0.25; gfx_b = 0.35; gfx_rect(m5_x, m5_y, m5_w, m5_h, 0);
  base_dslam_w = floor((m5_w - 4) * max(0.0, min(1.0, slider36 / 100.0)));
  live_dslam_w = floor((m5_w - 4) * min(1.0, (1.0 - d_g) * (slider36 / 100.0) * 2.5));
  gfx_r = 0.50; gfx_g = 0.10; gfx_b = 0.10;
  gfx_rect(m5_x + 2, m5_y + 2, base_dslam_w, m5_h - 4);
  gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22; gfx_a = 0.85;
  gfx_rect(m5_x + 2, m5_y + 2, min(m5_w - 4, max(base_dslam_w, live_dslam_w)), m5_h - 4);
  gfx_a = 1.00;
  mouse_down && m5_hov ? (
    slider36 = max(0, min(100, floor(((mouse_x - m5_x) / m5_w) * 100.0)));
    update_drum_filters(); slider_automate();
  );

  // Parameter 2: Clipper Topology Selector (3 Clickable Buttons)
  p3_top_y = p1_y + 54;
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = c3_x + 16; gfx_y = p3_top_y;
  gfx_drawstr("BUS CLIPPER TOPOLOGY");

  top_btn_w = floor((card_w_t4 - 32 - 12) / 3);
  top_btn_h = 26;
  tpi = 0;
  loop(3,
    tpx = c3_x + 16 + tpi * (top_btn_w + 6); tpy = p3_top_y + 22;
    is_tpsel = (slider21 == tpi);
    tp_hov = (mouse_x >= tpx && mouse_x <= tpx + top_btn_w && mouse_y >= tpy && mouse_y <= tpy + top_btn_h);
    gfx_r = is_tpsel ? 0.18 : (tp_hov ? 0.08 : 0.03);
    gfx_g = is_tpsel ? 0.10 : (tp_hov ? 0.06 : 0.04);
    gfx_b = is_tpsel ? 0.12 : (tp_hov ? 0.08 : 0.06);
    gfx_rect(tpx, tpy, top_btn_w, top_btn_h);
    gfx_r = is_tpsel ? 0.98 : 0.35; gfx_g = is_tpsel ? 0.22 : 0.35; gfx_b = is_tpsel ? 0.22 : 0.45;
    gfx_rect(tpx, tpy, top_btn_w, top_btn_h, 0);
    gfx_setfont(1, "Orbitron", 11, 'b');
    is_tpsel ? (gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;) : (gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.80;);
    tp_lbl = tpi == 0 ? "LINEAR" : (tpi == 1 ? "HERMITE" : "CLAMP");
    gfx_measurestr(tp_lbl, tpw2, tph2);
    gfx_x = tpx + (top_btn_w - tpw2) * 0.5; gfx_y = tpy + 6; gfx_drawstr(tp_lbl);
    mouse_clicked && tp_hov ? (slider21 = tpi; slider_automate(););
    tpi += 1;
  );

  // Parameter 3: Headroom Ceiling Lock
  p3_ceil_y = p3_top_y + 60;
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = c3_x + 16; gfx_y = p3_ceil_y;
  gfx_printf("CEILING TARGET: %4.1f dBTP (PRE-MASTER GUARD)", slider22);

  // Clipper Display Panel
  g3_x = c3_x + 16; g3_y = p3_ceil_y + 26; g3_w = card_w_t4 - 32; g3_h = max(70, card_h_t4 - (g3_y - c3_y) - 16);
  gfx_r = 0.018; gfx_g = 0.024; gfx_b = 0.035; gfx_rect(g3_x, g3_y, g3_w, g3_h);
  gfx_r = 0.16; gfx_g = 0.22; gfx_b = 0.30; gfx_rect(g3_x, g3_y, g3_w, g3_h, 0);
  gfx_setfont(1, "Consolas", 12.5, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = g3_x + 8; gfx_y = g3_y + 8;
  gfx_printf("STATUS       : %s", slider23 ? "STRICT PRE-MASTER -6dB LOCK" : "FREE DYNAMIC PASSTHROUGH");
  gfx_x = g3_x + 8; gfx_y = g3_y + 28;
  gfx_printf("PEAK STATUS  : %+.1fdBTP (IN-BUS CLIPPER PASS)", cur_max_tp);
);

slider1 == 6 ? (
  // =============================================================================
  // TAB 5: PRODUCER DRUM MATRIX & LIVE DRUM TONAL BALANCE TARGET CURVE
  // =============================================================================
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25; gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 14; gfx_y = disp_y + 10;
  gfx_drawstr("PRODUCER DRUM MATRIX // 19 MIXING-GRADE COMMERCIAL BENCHMARKS");

  // 1. 19 Producer Pills arranged in 3 neat rows (7 per row)
  pi = 0; pill_w = floor((disp_w - 60) / 7); pill_h = 32;
  loop(19,
    p_row = floor(pi / 7); p_col = pi % 7;
    px = disp_x + 10 + p_col * (pill_w + 6); py = disp_y + 36 + p_row * (pill_h + 6);
    is_sel = (slider25 == pi);
    p_hov = (mouse_x >= px && mouse_x <= px + pill_w && mouse_y >= py && mouse_y <= py + pill_h);
    gfx_r = is_sel ? 0.18 : (p_hov ? 0.08 : 0.035);
    gfx_g = is_sel ? 0.28 : (p_hov ? 0.12 : 0.048);
    gfx_b = is_sel ? 0.38 : (p_hov ? 0.18 : 0.068);
    gfx_rect(px, py, pill_w, pill_h);
    gfx_r = is_sel ? 1.00 : (p_hov ? 0.40 : 0.18);
    gfx_g = is_sel ? 0.82 : (p_hov ? 0.50 : 0.24);
    gfx_b = is_sel ? 0.25 : (p_hov ? 0.65 : 0.34);
    gfx_rect(px, py, pill_w, pill_h, 0);

    gfx_setfont(1, "Consolas", 13, 'b');
    is_sel ? (gfx_r = 1.00; gfx_g = 0.90; gfx_b = 0.30;) : (gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;);
    p_name = pi == 0 ? "0: GGD M&M" :
             pi == 1 ? "1: PRENC" :
             pi == 2 ? "2: SEIGEL" :
             pi == 3 ? "3: DOLESE" :
             pi == 4 ? "4: ODEHOLM" :
             pi == 5 ? "5: PINCHIN" :
             pi == 6 ? "6: GUAIANA" :
             pi == 7 ? "7: SAVELL" :
             pi == 8 ? "8: BOGREN" :
             pi == 9 ? "9: NOLLY" :
             pi == 10? "10: PUTNEY" :
             pi == 11? "11: LEVER" :
             pi == 12? "12: BASSAL" :
             pi == 13? "13: UDD" :
             pi == 14? "14: STURGIS" :
             pi == 15? "15: BRAUNSTEIN" :
             pi == 16? "16: CERVINI" :
             pi == 17? "17: ACLE" :
                       "18: HEAVING";
    gfx_measurestr(p_name, pnw, pnh);
    gfx_x = floor(px + (pill_w - pnw) * 0.5); gfx_y = py + 8;
    gfx_drawstr(p_name);

    mouse_clicked && p_hov ? (
      slider25 = pi; apply_drum_preset(pi); slider_automate();
    );
    pi += 1;
  );

  // 2. Active Producer Signature Move Plaque
  plaque_y = disp_y + 158;
  plaque_w = disp_w - 20;
  plaque_h = 44;
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.048; gfx_rect(disp_x + 10, plaque_y, plaque_w, plaque_h);
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25; gfx_rect(disp_x + 10, plaque_y, plaque_w, plaque_h, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25;
  gfx_x = disp_x + 18; gfx_y = plaque_y + 6;
  gfx_drawstr("ACTIVE PRODUCER SIGNATURE MOVE & TONAL RECIPE:");

  gfx_setfont(1, "Consolas", 13.5, 'b'); gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
  gfx_x = disp_x + 18; gfx_y = plaque_y + 24;
  p_sel = slider25;
  p_rec = p_sel == 0 ? "DEFAULT GGD M&M // 100% Bit-Exact 1:1 Wire Passthrough Baseline" :
          p_sel == 1 ? "LANCE PRENC // Polaris / Alpha Wolf: Snare +2.8dB (205Hz), Mud Scoop -2.8dB, Stick Snap +2.0dB" :
          p_sel == 2 ? "SCOTT SEIGEL // DIESECT: Tight Modern Metalcore Pocket, Snare +2.6dB, Sub Punch +1.6dB" :
          p_sel == 3 ? "JONATHAN DOLESE // Mirrorcell: Low-Mid Shell Weight +3.0dB, Mud Notch -2.2dB, Warm Acoustic" :
          p_sel == 4 ? "BUSTER ODEHOLM // thrown / Northlane: High-Velocity Thall Snap +2.4dB, Snare +2.8dB, Scoop -3.6dB" :
          p_sel == 5 ? "KEL PINCHIN // Currents / Invent Animate: Ultra-Tight Prog Pocket, Snare +2.6dB, De-Box -2.8dB" :
          p_sel == 6 ? "SAM GUAIANA // Silverstein / TDWP: Punchy Forward Snare Explosion +3.0dB, Crisp Shell Crack" :
          p_sel == 7 ? "FORRESTER SAVELL // Karnivool: Organic Dynamic Breathing, 55Hz Sub Anchor, High-Air Sheen" :
          p_sel == 8 ? "JENS BOGREN // Fascination Street: Scandinavian Heavy Snare +3.0dB, Raw Mud Notch -2.8dB" :
          p_sel == 9 ? "NOLLY GETGOOD // Periphery / GGD: Surgical Modern Balance, Snare +2.6dB, Chest Punch +1.5dB" :
          p_sel == 10? "WILL PUTNEY // Fit For An Autopsy: Aggressive Shell Bite +3.4dB, Deep Scoop -3.2dB, Stick +2.2dB" :
          p_sel == 11? "GEORGE LEVER // Sleep Token: Cinematic Sub Anchor 52Hz, Snare +2.5dB, Open Ethereal Silk" :
          p_sel == 12? "SAM BASSAL // Thornhill: 90s Alternative Grit, Snare Body +3.0dB, Mud Notch -2.6dB" :
          p_sel == 13? "HENRIK UDD // Architects / BMTH: Massive Polished UK Metal, Snare +2.8dB, Scoop -3.0dB" :
          p_sel == 14? "JOEY STURGIS // Asking Alexandria: Hyper Metalcore Slam, Snare +3.2dB, Deep Scoop -3.8dB" :
          p_sel == 15? "DAN BRAUNSTEIN // Spiritbox: Snare Weight +3.2dB, Scoop -2.8dB, Silk +2.0dB" :
          p_sel == 16? "ZAKK CERVINI // Blink-182 / BMTH: Upfront Radio Rimshot Crack +3.2dB, Stick +2.0dB" :
          p_sel == 17? "ACLE KAHNEY // TesseracT: Snare Snap (+1.6dB), 120ms Dynamic Punch, Silk Cymbals" :
                       "HEAVING. // carsick: Crushed Shoegaze Room Wash, Heavy Fat Snare (+1.4dB Tail)";
  gfx_drawstr(p_rec);

  // 3. Drum Kit Source Model (4 Wide Cards)
  src_y = plaque_y + plaque_h + 10;
  gfx_setfont(1, "Orbitron", 13, 'b'); gfx_r = 0.85; gfx_g = 0.68; gfx_b = 0.20;
  gfx_x = disp_x + 14; gfx_y = src_y;
  gfx_drawstr("DRUM KIT SOURCE MODEL (ACOUSTIC vs MIDI)");

  si = 0; s_btn_w = floor((disp_w - 40) / 4);
  loop(4,
    sx = disp_x + 10 + si * (s_btn_w + 6); sy = src_y + 20;
    is_s = (slider26 == si);
    s_hov = (mouse_x >= sx && mouse_x <= sx + s_btn_w && mouse_y >= sy && mouse_y <= sy + 38);
    gfx_r = is_s ? 0.08 : (s_hov ? 0.05 : 0.03);
    gfx_g = is_s ? 0.24 : (s_hov ? 0.12 : 0.04);
    gfx_b = is_s ? 0.18 : (s_hov ? 0.18 : 0.06);
    gfx_rect(sx, sy, s_btn_w, 38);
    gfx_r = is_s ? 0.15 : 0.30; gfx_g = is_s ? 0.95 : 0.35; gfx_b = is_s ? 0.45 : 0.45;
    gfx_rect(sx, sy, s_btn_w, 38, 0);

    gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = is_s ? 1.0 : 0.85; gfx_g = 1.0; gfx_b = 1.0;
    gfx_x = sx + 10; gfx_y = sy + 6;
    si == 0 ? gfx_drawstr("1. GGD M&M (CLEAN)") :
    si == 1 ? gfx_drawstr("2. CAMBRIDGE RESCUE") :
    si == 2 ? gfx_drawstr("3. SAMPLE HYBRID BUS") :
              gfx_drawstr("4. LIVE ROOM ACOUSTIC");

    gfx_setfont(1, "Consolas", 11, 'b'); gfx_r = 0.60; gfx_g = 0.70; gfx_b = 0.80;
    gfx_x = sx + 10; gfx_y = sy + 22;
    si == 0 ? gfx_drawstr("MIDI Passthrough (0dB Gate)") :
    si == 1 ? gfx_drawstr("Active Bleed & Trash Taming") :
    si == 2 ? gfx_drawstr("Punch Lock & Transient Focus") :
              gfx_drawstr("Ambient Natural Room Dynamics");

    mouse_clicked && s_hov ? (
      slider26 = si;
      si == 1 ? (
        slider12 = -4.5; slider13 = 2.0; slider14 = -2.0;
        slider16 = 1.2; slider17 = 2.8; slider18 = -3.2; slider11 = -18.0;
      ) : si == 0 ? (
        slider12 = -2.0; slider13 = 1.2; slider14 = -0.5;
        slider16 = 0.8; slider17 = 2.6; slider18 = -1.8; slider11 = 0.0;
      );
      update_drum_filters();
      slider_automate();
    );
    si += 1;
  );

  // 4. Live Drum Tonal Balance Curve with live audio frequency bounce
  tb_y = src_y + 66;
  tb_h = max(90, disp_h - (tb_y - disp_y) - 10);
  tb_w = disp_w - 20;
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.048; gfx_rect(disp_x + 10, tb_y, tb_w, tb_h);
  gfx_r = 0.18; gfx_g = 0.28; gfx_b = 0.38; gfx_rect(disp_x + 10, tb_y, tb_w, tb_h, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = disp_x + 18; gfx_y = tb_y + 8;
  gfx_drawstr("5-BAND DRUM TONAL CORRIDOR // TARGET EQ ENVELOPE (LIVE ACTIVE)");

  band_w = floor((tb_w - 30) / 5);
  bi = 0;
  loop(5,
    bx = disp_x + 16 + bi * (band_w + 5);
    by = tb_y + 28;
    bw = band_w;
    bh = tb_h - 36;

    gfx_r = 0.035; gfx_g = 0.048; gfx_b = 0.065; gfx_rect(bx, by, bw, bh);
    gfx_r = 0.14; gfx_g = 0.20; gfx_b = 0.28; gfx_rect(bx, by, bw, bh, 0);

    // Live audio activity LED indicators for each band
    gfx_setfont(1, "Consolas", 12.5, 'b');
    bi == 0 ? (
      live_b0_act = min(1.0, det_k_mag * 3.0);
      gfx_r = 1.00; gfx_g = 0.72 + live_b0_act * 0.25; gfx_b = 0.15;
      gfx_x = bx + 8; gfx_y = by + 6; gfx_drawstr("1. SUB KICK");
      gfx_x = bx + 8; gfx_y = by + 22; gfx_printf("%dHz | +%.1fdB", slider15, slider16);
      gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
      gfx_x = bx + 8; gfx_y = by + 38; gfx_printf("BOOM: %.1fdB", slider40);
    ) : bi == 1 ? (
      live_b1_act = min(1.0, det_s_mag * 3.0);
      gfx_r = 1.00; gfx_g = 0.82 + live_b1_act * 0.15; gfx_b = 0.25;
      gfx_x = bx + 8; gfx_y = by + 6; gfx_drawstr("2. SNARE BODY");
      gfx_x = bx + 8; gfx_y = by + 22; gfx_printf("205Hz | +%.1fdB", slider17);
      gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
      gfx_x = bx + 8; gfx_y = by + 38; gfx_drawstr("BRAUNSTEIN STD");
    ) : bi == 2 ? (
      gfx_r = 0.85; gfx_g = 0.45; gfx_b = 0.20;
      gfx_x = bx + 8; gfx_y = by + 6; gfx_drawstr("3. MUD SCOOP");
      gfx_x = bx + 8; gfx_y = by + 22; gfx_printf("340Hz | %.1fdB", slider18);
      gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
      gfx_x = bx + 8; gfx_y = by + 38; gfx_drawstr("BOX DE-CLUTTER");
    ) : bi == 3 ? (
      live_b3_act = min(1.0, abs(trash_l + trash_r) * 1.5);
      gfx_r = 0.85 + live_b3_act * 0.15; gfx_g = 0.45; gfx_b = 1.00;
      gfx_x = bx + 8; gfx_y = by + 6; gfx_drawstr("4. DE-TRASH");
      gfx_x = bx + 8; gfx_y = by + 22; gfx_printf("3.2k/4.6k: %.1fdB", slider12);
      gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
      gfx_x = bx + 8; gfx_y = by + 38; gfx_drawstr("HARSH NOTCHING");
    ) : (
      live_b4_act = min(1.0, abs(silk_l + silk_r) * 1.5);
      gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
      gfx_x = bx + 8; gfx_y = by + 6; gfx_drawstr("5. AIR SILK");
      gfx_x = bx + 8; gfx_y = by + 22; gfx_printf(">9.5k: +%.1fdB", slider13);
      gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25;
      gfx_x = bx + 8; gfx_y = by + 38; gfx_printf("SNAP: +%.1fdB", slider19);
    );
    bi += 1;
  );
);
// Scanlines Overlay (Subtle CRT Glow)
scan_y = floor(disp_y);
gfx_r = 0.00; gfx_g = 0.04; gfx_b = 0.06; gfx_a = 0.035;
loop(floor(disp_h / 3),
  gfx_line(disp_x, scan_y, disp_x + disp_w, scan_y);
  scan_y += 3;
);
gfx_a = 1.00;

prev_mouse_down = mouse_down;
