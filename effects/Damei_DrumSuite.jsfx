desc:Damei Drum Bus Architect (Atumpan Matrix & Beat Leveler)
// =============================================================================
// DAMEI DRUM BUS ARCHITECT // ATUMPAN MATRIX (v2.1)
// Complete Drum Bus Processing Engine with Formulaic AI Assist
// Built by Damei Audio & Antigravity IDE
// =============================================================================

slider1:0<0,6,1{Drum Overview,Beat Leveler (Sound Radix),Cymbal Silk & De-Trash,Shell Weight & Bleed Tamer,BSA Drum Bus (Black Salt Audio),Transient Snap & Analog Chain,Producer Matrix & GGD Mode}>-Active Module
slider2:-12.0<-24.0,-6.0,0.5>-Target Level (dBFS Peak)
slider3:0<-100,100,1>-Leveling Compression / Expansion (%) [0% = Transparent]
slider4:-28.0<-36.0,-12.0,0.5>-Low Threshold (Gate / Bleed Boundary)
slider5:-2.5<-12.0,0.0,0.5>-High Threshold (Accent Passthrough Ceiling)
slider6:1.0<0.5,8.0,0.5>-Max Gain Range (+/- dB)
slider7:35<5,120,1>-Transient Hold Time (ms)
slider8:120<20,350,5>-Recovery Release Time (ms)
slider9:75<10,100,1>-Beat Detector Sensitivity (%)
slider10:42<15,120,1>-Min Retrigger Time (ms)
slider11:0.0<-36.0,0.0,0.5>-Bleed Floor Attenuation (dB) [0dB = Bypassed]
slider12:0.0<-8.0,0.0,0.5>-Cymbal De-Trash Resonance Suppression (dB)
slider13:0.0<0.0,6.0,0.2>-Cymbal Silk Air Sheen (>9kHz dB)
slider14:0.0<-4.0,4.0,0.2>-Stick Clang vs Wash Balance (dB)
slider15:75<45,105,1>-Sub-Kick Anchor Cutoff (Hz)
slider16:0.0<0.0,4.0,0.2>-Sub-Kick 75Hz Resonant Chest Punch (dB)
slider17:0.0<0.0,6.0,0.2>-Snare Body 200Hz Shell Weight (dB)
slider18:0.0<-6.0,0.0,0.2>-Room Mud Boxiness Scoop 340Hz (dB)
slider19:0.0<0.0,4.0,0.1>-Drum Transient Attack Snap (dB)
slider20:0.0<-4.0,4.0,0.2>-Drum Transient Sustain Tail (dB)
slider21:0<0,2,1{Linear Transparent Passthrough,Smooth Musical Hermite Soft-Clip,Commercial Hard Brickwall Clamp}>-Mix Bus Clipper Topology
slider22:-0.1<-12.0,-0.1,0.1>-Target Headroom Ceiling (dBTP)
slider23:0<0,1,1{Free Output Gain (No Clipping),Strict Pre-Master Headroom Lock}>-Headroom Ceiling Guardian
slider24:0.0<-12.0,12.0,0.5>-Output Makeup Trim (dB)
slider25:0<0,19,1{Default GGD Modern & Massive,Lance Prenc (Alpha Wolf / Polaris),Scott Seigel (DIESECT),Jonathan Dolese (Mirrorcell / Cane Hill),Buster Odeholm (thrown / Northlane),Kel Pinchin (Currents / Invent Animate),Sam Guaiana (Silverstein / TDWP),Forrester Savell (Karnivool / DLC),Jens Bogren (Fascination Street),Adam Nolly Getgood (Periphery / GGD),Will Putney (Fit For An Autopsy),George Lever (Sleep Token / Loathe),Sam Bassal (Thornhill / Ocean Grove),Henrik Udd (Architects / BMTH),Joey Sturgis (Asking Alexandria),Dan Braunstein (Spiritbox / Dayseeker),Zakk Cervini (Blink-182 / BMTH),Acle Kahney (TesseracT - King),Adam Cichocki (heaving. - carsick / Timber Studios),Manuel Renner (SENNA - Out Of The Blue / Überlärm Studios)}>-Producer Drum Signature Preset
slider26:0<0,3,1{GetGood Drums Modern & Massive (Optimized),Raw Cambridge MT Stems (Rescue Mode),Sample-Replaced Hybrid Drum Bus,Live Room Acoustic Tracking}>-Drum Kit Source Model
slider27:-18.0<-24.0,-12.0,1.0>-Analogue 0 VU Target Reference (dBFS RMS)
slider28:1<0,3,1{Off,Tasteful Auto-Impact,Commercial Drop Slam,Subtle Dynamic Breathing}>-Song Structure & Chorus Impact AI
slider29:0<0,2,1{Hybrid Prioritize REAPER Regions,Strict Project Regions,Autonomous Acoustic AI}>-Song Structure Detection Mode
slider30:1<0,1,1{Bypassed,Active Cymbal Silk & Trash Tamer}>-Cymbal Silk Master Engine
slider31:0<0,3,1{Smart Drum Bus (Kick + Snare Split),Kick Transient Focus (55-160Hz),Snare Crack Focus (200-3.5kHz),Wide Drum Bus Transients (100-5kHz)}>-Internal Sidechain Detector Mode
slider32:50<0,100,1>-Kick vs Snare Detection Balance (%)
slider33:0.42<-12.0,12.0,0.1>-Input Gain Calibration (DeeGain dB)
slider34:25<0,100,1>-Britson Neve Console Drive (%)
slider35:20<0,100,1>-BSA Drum Bus Glue & Heat Drive (%)
slider36:0<0,100,1>-Devil-Slam Parallel Crush & Pump (%)
slider37:0<0,1,1{In-Chain Finisher (Complements DeeGain/Britson/BSA/Devil-Loc),Standalone All-in-One (Emulates Full 4-Plugin Chain)}>-Drum Bus Integration Mode
slider38:1<0,1,1{Manual Parameter Mode,AI Assist Active Formula Calibration}>-AI Assist Intelligent Engine
slider39:80<30,160,5>-Sidechain Highpass Detection Filter (Hz)
slider40:-1.5<-6.0,2.0,0.5>-Sub-Kick Dynamic Boom Tamer 40Hz (dB)
slider41:1<0,1,1{Free Dynamic (Manual Trim),Mix Suite Headroom Link (Auto-Guard)}>-Mix Headroom Balance Anchor

slider42:1<0,1,1{Off,On}>-Matrix Trim (applies Assessment Matrix auto-correct lane)
// BSA Drum Bus (Black Salt Audio Modeled Rack)
slider43:0<0,1,1{Standard (Musical 4:1 Glue),Slammed (Aggressive 20:1 Crush)}>-BSA Mode
slider44:38<0,100,1>-BSA Comp Drive (%)
slider45:26<0,100,1>-BSA Heat Saturation (%)
slider46:60<0,100,1>-BSA Attack Punch (%)
slider47:50<0,100,1>-BSA Tone Tilt (%)
slider48:35<0,100,1>-BSA Salt Sheen Exciter (%)
slider49:80<20,300,5>-BSA Sidechain HPF (Hz)
slider50:85<0,100,1>-BSA Parallel Mix (%)
slider51:0.0<-12.0,12.0,0.5>-BSA Output Trim (dB)
slider52:0<0,1,1{Normal Passthrough,Audition Delta Solo (Clipper & Dynamics)}>-Audition Delta Solo
slider53:0<0,1,1{State A (Current Calibrated),State B (Alternate Snapshot)}>-A/B Snapshot Selector
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=2097152
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@serialize
file_var(0, slider1);
file_var(0, slider2);
file_var(0, slider3);
file_var(0, slider4);
file_var(0, slider5);
file_var(0, slider6);
file_var(0, slider7);
file_var(0, slider8);
file_var(0, slider9);
file_var(0, slider10);
file_var(0, slider11);
file_var(0, slider12);
file_var(0, slider13);
file_var(0, slider14);
file_var(0, slider15);
file_var(0, slider16);
file_var(0, slider17);
file_var(0, slider18);
file_var(0, slider19);
file_var(0, slider20);
file_var(0, slider21);
file_var(0, slider22);
file_var(0, slider23);
file_var(0, slider24);
file_var(0, slider25);
file_var(0, slider26);
file_var(0, slider27);
file_var(0, slider28);
file_var(0, slider29);
file_var(0, slider30);
file_var(0, slider31);
file_var(0, slider32);
file_var(0, slider33);
file_var(0, slider34);
file_var(0, slider35);
file_var(0, slider36);
file_var(0, slider37);
file_var(0, slider38);
file_var(0, slider39);
file_var(0, slider40);
file_var(0, slider41);
file_var(0, slider43); file_var(0, slider44); file_var(0, slider45);
file_var(0, slider46); file_var(0, slider47); file_var(0, slider48);
file_var(0, slider49); file_var(0, slider50); file_var(0, slider51);
file_var(0, is_user_customized);
file_var(0, prev_preset);
file_var(0, prev_source_model);
file_var(0, prev_integration_mode);

@init

ext_noinit = 1;
srate <= 0 ? srate = 48000;

// Circular history visualizer buffers for Hybrid Scrolling Canvas
buf_sz = 600;
buf_in_idx = 0;
buf_in_arr = 100000;
buf_boost_arr = 101000;
buf_cut_arr = 102000;
buf_out_arr = 103000;
buf_tag_arr = 104000;

memset(buf_in_arr, 0, buf_sz);
memset(buf_boost_arr, 0, buf_sz);
memset(buf_cut_arr, 0, buf_sz);
memset(buf_out_arr, 0, buf_sz);
memset(buf_tag_arr, 0, buf_sz);

// Beat Leveler Detector state
det_env_fast = 0.0;
det_env_slow = 0.0;
det_prev_env = 0.0;
samples_since_beat = 999999;
in_beat_hold = 0;
hold_samples_rem = 0;
cur_leveler_gain = 1.0;
target_leveler_gain = 1.0;
recent_beat_peak = -90.0;
recent_beat_boost = 0.0;
recent_beat_cut = 0.0;
recent_beat_tag = 0;

// Internal Bandpass Sidechain Filter Buffers (Kick, Snare & Wide)
sc_k_x1 = 0; sc_k_x2 = 0; sc_k_y1 = 0; sc_k_y2 = 0;
sc_k_b0 = 1; sc_k_b1 = 0; sc_k_b2 = 0; sc_k_a1 = 0; sc_k_a2 = 0;

sc_s_x1 = 0; sc_s_x2 = 0; sc_s_y1 = 0; sc_s_y2 = 0;
sc_s_b0 = 1; sc_s_b1 = 0; sc_s_b2 = 0; sc_s_a1 = 0; sc_s_a2 = 0;

sc_w_x1 = 0; sc_w_x2 = 0; sc_w_y1 = 0; sc_w_y2 = 0;
sc_w_b0 = 1; sc_w_b1 = 0; sc_w_b2 = 0; sc_w_a1 = 0; sc_w_a2 = 0;

// Sidechain Highpass Filter (BSA Modeled 80Hz cutoff)
sc_hp_x1 = 0; sc_hp_x2 = 0; sc_hp_y1 = 0; sc_hp_y2 = 0;
sc_hp_b0 = 1; sc_hp_b1 = 0; sc_hp_b2 = 0; sc_hp_a1 = 0; sc_hp_a2 = 0;

// Kick Punch 75Hz Resonant Peak Filter (tight chest punch, no fake sine wave)
kp_x1_l = 0; kp_x2_l = 0; kp_y1_l = 0; kp_y2_l = 0;
kp_x1_r = 0; kp_x2_r = 0; kp_y1_r = 0; kp_y2_r = 0;

// Sub-Boom 40Hz Dynamic Tamer Notch
boom_x1_l = 0; boom_x2_l = 0; boom_y1_l = 0; boom_y2_l = 0;
boom_x1_r = 0; boom_x2_r = 0; boom_y1_r = 0; boom_y2_r = 0;

// Sub-Kick Mono Anchor Filter Buffers (<75Hz)
sub_x1_l = 0; sub_x2_l = 0; sub_y1_l = 0; sub_y2_l = 0;
sub_x1_r = 0; sub_x2_r = 0; sub_y1_r = 0; sub_y2_r = 0;

// Snare 200Hz Body & 340Hz Box Scoop Buffers
sn_body_x1_l = 0; sn_body_x2_l = 0; sn_body_y1_l = 0; sn_body_y2_l = 0;
sn_body_x1_r = 0; sn_body_x2_r = 0; sn_body_y1_r = 0; sn_body_y2_r = 0;

box_x1_l = 0; box_x2_l = 0; box_y1_l = 0; box_y2_l = 0;
box_x1_r = 0; box_x2_r = 0; box_y1_r = 0; box_y2_r = 0;

// Cymbal De-Trash Dynamic Resonance Notches (3.2kHz & 4.6kHz)
trash1_x1_l = 0; trash1_x2_l = 0; trash1_y1_l = 0; trash1_y2_l = 0;
trash1_x1_r = 0; trash1_x2_r = 0; trash1_y1_r = 0; trash1_y2_r = 0;

trash2_x1_l = 0; trash2_x2_l = 0; trash2_y1_l = 0; trash2_y2_l = 0;
trash2_x1_r = 0; trash2_x2_r = 0; trash2_y1_r = 0; trash2_y2_r = 0;

// Cymbal Air Silk High-Shelf (>9kHz)
air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;

// Transient Designer Envelope Follower Buffers
trans_fast_env = 0.0;
trans_slow_env = 0.0;
trans_gain_smooth = 1.0;

// Devil-Loc Crush Envelope & Filter Buffers
devil_env = 0.0;
devil_smooth_l = 0.0;
devil_smooth_r = 0.0;

// AI Assist Energy Analysis
ai_sub_energy = 0.0;
ai_mid_energy = 0.0;
ai_sub_ratio = 1.0;
mix_guard_gain = 1.0;
drum_to_mix_db = -5.5;
ai_calibrate_trigger = 0;

// Sifam VU Meter Ballistics (300ms moving coil)
vu_attack_c = exp(-1.0 / (0.300 * srate));
vu_ballistics = 0.0;
cur_vu_rms = -90.0;
cur_true_peak = -90.0;
cur_out_true_peak = -90.0;
cur_crest = 8.5;

function update_drum_filters() (

  // BSA Sidechain HPF (slider49: 20-300Hz 2nd order Butterworth)
  bsa_hp_w0 = 2.0 * $pi * max(20.0, min(300.0, slider49)) / srate;
  bsa_hp_alpha = sin(bsa_hp_w0) * 0.7071;
  bsa_hp_b0 = (1.0 + cos(bsa_hp_w0)) * 0.5;
  bsa_hp_b1 = -(1.0 + cos(bsa_hp_w0));
  bsa_hp_b2 = (1.0 + cos(bsa_hp_w0)) * 0.5;
  bsa_hp_a0 = 1.0 + bsa_hp_alpha;
  bsa_hp_a1 = -2.0 * cos(bsa_hp_w0);
  bsa_hp_a2 = 1.0 - bsa_hp_alpha;
  bsa_hp_b0 /= bsa_hp_a0; bsa_hp_b1 /= bsa_hp_a0; bsa_hp_b2 /= bsa_hp_a0;
  bsa_hp_a1 /= bsa_hp_a0; bsa_hp_a2 /= bsa_hp_a0;

  // BSA Tone Tilt (slider47: 0-100%, 50% = flat; tilt low shelf @ 130Hz, high shelf @ 3.8kHz)
  bsa_tilt_db = (slider47 - 50.0) * 0.12; // -6dB to +6dB tilt
  bsa_t_a = exp(bsa_tilt_db * 0.11512925); // 10^(db/20)
  bsa_tl_w0 = 2.0 * $pi * 130.0 / srate;
  bsa_tl_cs = cos(bsa_tl_w0); bsa_tl_sn = sin(bsa_tl_w0);
  bsa_tl_al = bsa_tl_sn * 0.5 * sqrt((bsa_t_a + 1.0/bsa_t_a)*(1.0/0.7071 - 1.0) + 2.0);
  bsa_tl_a0 = (bsa_t_a + 1.0) + (bsa_t_a - 1.0)*bsa_tl_cs + 2.0*sqrt(bsa_t_a)*bsa_tl_al;
  bsa_tl_b0 = (bsa_t_a * ((bsa_t_a + 1.0) - (bsa_t_a - 1.0)*bsa_tl_cs + 2.0*sqrt(bsa_t_a)*bsa_tl_al)) / bsa_tl_a0;
  bsa_tl_b1 = (2.0 * bsa_t_a * ((bsa_t_a - 1.0) - (bsa_t_a + 1.0)*bsa_tl_cs)) / bsa_tl_a0;
  bsa_tl_b2 = (bsa_t_a * ((bsa_t_a + 1.0) - (bsa_t_a - 1.0)*bsa_tl_cs - 2.0*sqrt(bsa_t_a)*bsa_tl_al)) / bsa_tl_a0;
  bsa_tl_a1 = (-2.0 * ((bsa_t_a - 1.0) + (bsa_t_a + 1.0)*bsa_tl_cs)) / bsa_tl_a0;
  bsa_tl_a2 = ((bsa_t_a + 1.0) + (bsa_t_a - 1.0)*bsa_tl_cs - 2.0*sqrt(bsa_t_a)*bsa_tl_al) / bsa_tl_a0;

  // BSA Salt Sheen Exciter (slider48: highpass @ 7.8kHz)
  bsa_st_w0 = 2.0 * $pi * 7800.0 / srate;
  bsa_st_al = sin(bsa_st_w0) * 0.7071;
  bsa_st_a0 = 1.0 + bsa_st_al;
  bsa_st_b0 = ((1.0 + cos(bsa_st_w0)) * 0.5) / bsa_st_a0;
  bsa_st_b1 = (-(1.0 + cos(bsa_st_w0))) / bsa_st_a0;
  bsa_st_b2 = ((1.0 + cos(bsa_st_w0)) * 0.5) / bsa_st_a0;
  bsa_st_a1 = (-2.0 * cos(bsa_st_w0)) / bsa_st_a0;
  bsa_st_a2 = (1.0 - bsa_st_al) / bsa_st_a0;

  // 1A. Kick Transient Internal Sidechain Bandpass Filter (85 Hz, Q=1.35)
  f0_k = 85.0; q_k = 1.35;
  w0_k = 2.0 * $pi * f0_k / srate;
  cos_k = cos(w0_k); sin_k = sin(w0_k);
  alpha_k = sin_k / (2.0 * q_k);
  k_a0 = 1.0 + alpha_k;
  sc_k_b0 = (sin_k * 0.5) / k_a0;
  sc_k_b1 = 0.0;
  sc_k_b2 = (-sin_k * 0.5) / k_a0;
  sc_k_a1 = (-2.0 * cos_k) / k_a0;
  sc_k_a2 = (1.0 - alpha_k) / k_a0;

  // 1B. Snare Crack Internal Sidechain Bandpass Filter (950 Hz, Q=0.75)
  f0_s = 950.0; q_s = 0.75;
  w0_s = 2.0 * $pi * f0_s / srate;
  cos_s = cos(w0_s); sin_s = sin(w0_s);
  alpha_s = sin_s / (2.0 * q_s);
  s_a0 = 1.0 + alpha_s;
  sc_s_b0 = (sin_s * 0.5) / s_a0;
  sc_s_b1 = 0.0;
  sc_s_b2 = (-sin_s * 0.5) / s_a0;
  sc_s_a1 = (-2.0 * cos_s) / s_a0;
  sc_s_a2 = (1.0 - alpha_s) / s_a0;

  // 1C. Wide Drum Bus Transient Bandpass Filter (120 Hz to 4.5 kHz)
  f0_w = 750.0; q_w = 0.55;
  w0_w = 2.0 * $pi * f0_w / srate;
  cos_w = cos(w0_w); sin_w = sin(w0_w);
  alpha_w = sin_w / (2.0 * q_w);
  w_a0 = 1.0 + alpha_w;
  sc_w_b0 = (sin_w * 0.5) / w_a0;
  sc_w_b1 = 0.0;
  sc_w_b2 = (-sin_w * 0.5) / w_a0;
  sc_w_a1 = (-2.0 * cos_w) / w_a0;
  sc_w_a2 = (1.0 - alpha_w) / w_a0;

  // 1D. Sidechain Highpass Filter (modeled after BSA Drum Bus 80Hz cutoff)
  f0_hp = slider39;
  w0_hp = 2.0 * $pi * f0_hp / srate;
  cos_hp = cos(w0_hp); sin_hp = sin(w0_hp);
  alpha_hp = sin_hp / (2.0 * 0.7071);
  hp_a0 = 1.0 + alpha_hp;
  sc_hp_b0 = ((1.0 + cos_hp) * 0.5) / hp_a0;
  sc_hp_b1 = (-(1.0 + cos_hp)) / hp_a0;
  sc_hp_b2 = ((1.0 + cos_hp) * 0.5) / hp_a0;
  sc_hp_a1 = (-2.0 * cos_hp) / hp_a0;
  sc_hp_a2 = (1.0 - alpha_hp) / hp_a0;

  // 2. Sub-Kick 75Hz Resonant Chest Punch (Pure Acoustic Biquad, Zero Fake Sine Wave)
  f0_kp = slider15; gain_kp = slider16; q_kp = 1.6;
  a_kp = exp(gain_kp * (log(10.0) / 40.0));
  w0_kp = 2.0 * $pi * f0_kp / srate;
  cos_kp = cos(w0_kp); sin_kp = sin(w0_kp);
  alpha_kp = sin_kp / (2.0 * q_kp);
  kp_a0 = 1.0 + alpha_kp / a_kp;
  kp_b0 = (1.0 + alpha_kp * a_kp) / kp_a0;
  kp_b1 = (-2.0 * cos_kp) / kp_a0;
  kp_b2 = (1.0 - alpha_kp * a_kp) / kp_a0;
  kp_a1 = (-2.0 * cos_kp) / kp_a0;
  kp_a2 = (1.0 - alpha_kp / a_kp) / kp_a0;

  // 3. Sub-Kick Dynamic Boom Tamer (40Hz Notch to Prevent Mud/Boom)
  f0_bm = 40.0; gain_bm = slider40; q_bm = 1.8;
  a_bm = exp(gain_bm * (log(10.0) / 40.0));
  w0_bm = 2.0 * $pi * f0_bm / srate;
  cos_bm = cos(w0_bm); sin_bm = sin(w0_bm);
  alpha_bm = sin_bm / (2.0 * q_bm);
  bm_a0 = 1.0 + alpha_bm / a_bm;
  boom_b0 = (1.0 + alpha_bm * a_bm) / bm_a0;
  boom_b1 = (-2.0 * cos_bm) / bm_a0;
  boom_b2 = (1.0 - alpha_bm * a_bm) / bm_a0;
  boom_a1 = (-2.0 * cos_bm) / bm_a0;
  boom_a2 = (1.0 - alpha_bm / a_bm) / bm_a0;

  // 4. Sub-Kick Mono Anchor Filter (Butterworth Low-Pass)
  f0_sub = slider15;
  w0_sub = 2.0 * $pi * f0_sub / srate;
  cos_sub = cos(w0_sub); sin_sub = sin(w0_sub);
  alpha_sub = sin_sub / (2.0 * 0.7071);
  sub_a0 = 1.0 + alpha_sub;
  sub_lp_b0 = ((1.0 - cos_sub) * 0.5) / sub_a0;
  sub_lp_b1 = (1.0 - cos_sub) / sub_a0;
  sub_lp_b2 = ((1.0 - cos_sub) * 0.5) / sub_a0;
  sub_lp_a1 = (-2.0 * cos_sub) / sub_a0;
  sub_lp_a2 = (1.0 - alpha_sub) / sub_a0;

  // 5. Snare Body Weight Peak Filter (200Hz Peak Boost)
  f0_sn = 205.0; gain_sn = slider17; q_sn = 1.6;
  a_sn = exp(gain_sn * (log(10.0) / 40.0));
  w0_sn = 2.0 * $pi * f0_sn / srate;
  cos_sn = cos(w0_sn); sin_sn = sin(w0_sn);
  alpha_sn = sin_sn / (2.0 * q_sn);
  sn_a0 = 1.0 + alpha_sn / a_sn;
  sn_body_b0 = (1.0 + alpha_sn * a_sn) / sn_a0;
  sn_body_b1 = (-2.0 * cos_sn) / sn_a0;
  sn_body_b2 = (1.0 - alpha_sn * a_sn) / sn_a0;
  sn_body_a1 = (-2.0 * cos_sn) / sn_a0;
  sn_body_a2 = (1.0 - alpha_sn / a_sn) / sn_a0;

  // 6. Room Mud Boxiness Scoop (340Hz Notch/Dip)
  f0_bx = 340.0; gain_bx = slider18; q_bx = 1.8;
  a_bx = exp(gain_bx * (log(10.0) / 40.0));
  w0_bx = 2.0 * $pi * f0_bx / srate;
  cos_bx = cos(w0_bx); sin_bx = sin(w0_bx);
  alpha_bx = sin_bx / (2.0 * q_bx);
  bx_a0 = 1.0 + alpha_bx / a_bx;
  box_b0 = (1.0 + alpha_bx * a_bx) / bx_a0;
  box_b1 = (-2.0 * cos_bx) / bx_a0;
  box_b2 = (1.0 - alpha_bx * a_bx) / bx_a0;
  box_a1 = (-2.0 * cos_bx) / bx_a0;
  box_a2 = (1.0 - alpha_bx / a_bx) / bx_a0;

  // 7. Cymbal De-Trash Dynamic Resonance Notch 1 (3.2kHz)
  f0_t1 = 3250.0; gain_t1 = slider30 ? slider12 : 0.0; q_t1 = 3.2;
  a_t1 = exp(gain_t1 * (log(10.0) / 40.0));
  w0_t1 = 2.0 * $pi * f0_t1 / srate;
  cos_t1 = cos(w0_t1); sin_t1 = sin(w0_t1);
  alpha_t1 = sin_t1 / (2.0 * q_t1);
  t1_a0 = 1.0 + alpha_t1 / a_t1;
  trash1_b0 = (1.0 + alpha_t1 * a_t1) / t1_a0;
  trash1_b1 = (-2.0 * cos_t1) / t1_a0;
  trash1_b2 = (1.0 - alpha_t1 * a_t1) / t1_a0;
  trash1_a1 = (-2.0 * cos_t1) / t1_a0;
  trash1_a2 = (1.0 - alpha_t1 / a_t1) / t1_a0;

  // 8. Cymbal De-Trash Resonance Notch 2 (4.6kHz)
  f0_t2 = 4650.0; gain_t2 = slider30 ? (slider12 * 0.85) : 0.0; q_t2 = 3.6;
  a_t2 = exp(gain_t2 * (log(10.0) / 40.0));
  w0_t2 = 2.0 * $pi * f0_t2 / srate;
  cos_t2 = cos(w0_t2); sin_t2 = sin(w0_t2);
  alpha_t2 = sin_t2 / (2.0 * q_t2);
  t2_a0 = 1.0 + alpha_t2 / a_t2;
  trash2_b0 = (1.0 + alpha_t2 * a_t2) / t2_a0;
  trash2_b1 = (-2.0 * cos_t2) / t2_a0;
  trash2_b2 = (1.0 - alpha_t2 * a_t2) / t2_a0;
  trash2_a1 = (-2.0 * cos_t2) / t2_a0;
  trash2_a2 = (1.0 - alpha_t2 / a_t2) / t2_a0;

  // 9. Cymbal Air Silk High-Shelf (>9.5kHz)
  f0_air = 9500.0; gain_air = slider30 ? slider13 : 0.0; q_air = 0.75;
  a_air = exp(gain_air * (log(10.0) / 40.0));
  w0_air = 2.0 * $pi * f0_air / srate;
  cos_air = cos(w0_air); sin_air = sin(w0_air);
  alpha_air = sin_air / (2.0 * q_air);
  two_sqrt_a_alpha = 2.0 * sqrt(a_air) * alpha_air;
  air_a0 = (a_air + 1.0) - (a_air - 1.0) * cos_air + two_sqrt_a_alpha;
  air_b0 = (a_air * ((a_air + 1.0) + (a_air - 1.0) * cos_air + two_sqrt_a_alpha)) / air_a0;
  air_b1 = (-2.0 * a_air * ((a_air - 1.0) + (a_air + 1.0) * cos_air)) / air_a0;
  air_b2 = (a_air * ((a_air + 1.0) - (a_air - 1.0) * cos_air - two_sqrt_a_alpha)) / air_a0;
  air_a1 = (2.0 * ((a_air - 1.0) - (a_air + 1.0) * cos_air)) / air_a0;
  air_a2 = ((a_air + 1.0) - (a_air - 1.0) * cos_air - two_sqrt_a_alpha) / air_a0;
);

