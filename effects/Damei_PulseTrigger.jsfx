    new_vol = -60.0 + v * 72.0;
    s_idx == 0 ? slider11 = new_vol : s_idx == 1 ? slider21 = new_vol : slider31 = new_vol;

    // Pan Knob
    v = (s_pan + 100.0) / 200.0;
    v = draw_knob(165, sy, 30, v, "PAN", sprintf(str_buf, "%d%%", s_pan), 20 + s_idx);
    new_pan = floor(-100.0 + v * 200.0);
    s_idx == 0 ? slider12 = new_pan : s_idx == 1 ? slider22 = new_pan : slider32 = new_pan;

    // Tune Knob (+/- 12 Semitones)
    v = (s_tune + 12.0) / 24.0;
