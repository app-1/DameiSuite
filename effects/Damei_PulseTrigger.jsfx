  // TAB 4: SUB SINE SYNTHESIZER
  active_tab == 4 ? (
    draw_panel(16, content_y, content_w, content_h, "TUNABLE SUB-SINE SYNTHESIZER", "INSTANT LOW-END REINFORCEMENT");

    // Enable Toggle
    btn_sub = mouse_x >= 30 && mouse_x < 150 && mouse_y >= content_y + 40 && mouse_y < content_y + 80;
    set_c(slider44 ? 0x0fe49e : (btn_sub ? 0x222c3d : 0x151b26));
    gfx_rect(30, content_y + 40, 120, 40);
    set_c(slider44 ? 0x0fe49e : 0x1b2331);
    gfx_rect(30, content_y + 40, 120, 40, 0);
    gfx_setfont(1, "Orbitron", 10, 'b');
    set_c(slider44 ? 0x0a0c10 : 0xedf1f7);
    gfx_measurestr(slider44 ? "SYNTH ON" : "SYNTH OFF", tw, th);
    gfx_x = 30 + (120 - tw) * 0.5; gfx_y = content_y + 40 + (40 - th) * 0.5;
    gfx_drawstr(slider44 ? "SYNTH ON" : "SYNTH OFF");
    mouse_clicked && btn_sub ? (slider44 = !slider44; sliderchange(slider44););

    // Controls
    sy = content_y + 140;
    // Freq Knob (30 - 100 Hz)
    v = (slider45 - 30) / 70.0;
    v = draw_knob(90, sy, 34, v, "SUB FREQ", sprintf(str_buf, "%d Hz", slider45), 40);
    slider45 = 30 + floor(v * 70.0);

    // Decay Knob (30 - 600 ms)
    v = (slider46 - 30) / 570.0;
    v = draw_knob(210, sy, 34, v, "SUB DECAY", sprintf(str_buf, "%d ms", slider46), 41);
    slider46 = 30 + floor(v * 570.0);

    // Volume Knob (-48 to +6 dB)
    v = (slider47 + 48.0) / 54.0;
    v = draw_knob(330, sy, 34, v, "SUB LEVEL", sprintf(str_buf, "%.1f dB", slider47), 42);
    slider47 = -48.0 + v * 54.0;

    gfx_setfont(2, "Segoe UI", 11);
    set_c(0x6e788d);
    gfx_x = 420; gfx_y = sy - 20;
    gfx_drawstr("Generates a phase-locked sub sine wave directly at the acoustic onset.");
    gfx_x = 420; gfx_y = sy;
    gfx_drawstr("Tune directly to the key of the song (e.g., 55 Hz = A1, 49 Hz = G1, 41 Hz = E1).");
  );

  // TAB 5: OUTPUT & AUGMENTATION BLEND
  active_tab == 5 ? (
    draw_panel(16, content_y, content_w, content_h, "MASTER ENVELOPE, BLEND & GOLDEN AUGMENTATION", "TARGET: -15 dB AUGMENT");

    oy = content_y + 80;
    // Attack
    v = slider51 / 100.0;
    v = draw_knob(70, oy, 30, v, "ATTACK", sprintf(str_buf, "%d ms", slider51), 50);
    slider51 = floor(v * 100.0);

    // Decay
    v = (slider52 - 10) / 990.0;
    v = draw_knob(165, oy, 30, v, "DECAY", sprintf(str_buf, "%d ms", slider52), 51);
    slider52 = 10 + floor(v * 990.0);

    // Dry Vol
    v = (slider53 + 60.0) / 60.0;
    v = draw_knob(260, oy, 30, v, "DRY VOL", slider53 <= -59.5 ? "-inf" : sprintf(str_buf, "%d dB", slider53), 52);
    slider53 = floor(-60.0 + v * 60.0);

    // Wet Vol
    v = (slider54 + 60.0) / 72.0;
    v = draw_knob(355, oy, 30, v, "WET VOL", sprintf(str_buf, "%.1f dB", slider54), 53);
    slider54 = -60.0 + v * 72.0;

    // Mix Blend
    v = slider55 / 100.0;
    v = draw_knob(450, oy, 30, v, "MIX", sprintf(str_buf, "%d%%", slider55), 54);
    slider55 = floor(v * 100.0);

    // Master Phase Invert (Phase)
    btn_mph = mouse_x >= 520 && mouse_x < 590 && mouse_y >= oy - 15 && mouse_y < oy + 25;
    set_c(slider57 ? 0xf03344 : (btn_mph ? 0x222c3d : 0x151b26)); gfx_rect(520, oy - 15, 70, 40);
    set_c(0x1b2331); gfx_rect(520, oy - 15, 70, 40, 0);
    set_c(slider57 ? 0x0a0c10 : 0xedf1f7);
    gfx_measurestr("MASTER Phase", tw, th);
    gfx_x = 520 + (70 - tw) * 0.5; gfx_y = oy - 15 + (40 - th) * 0.5;
    gfx_drawstr("MASTER Phase");
    mouse_clicked && btn_mph ? (slider57 = !slider57; sliderchange(slider57););

    // GOLDEN RATIO AUGMENTATION BUTTONS
    ay = content_y + 180;
    gfx_setfont(1, "Orbitron", 10.5, 'b');
    set_c(0xdfb15b); gfx_x = 30; gfx_y = ay - 18; gfx_drawstr("DAMEI GOLDEN RATIO STEM AUGMENTATION LOCK");

    btn_free = mouse_x >= 30 && mouse_x < 190 && mouse_y >= ay && mouse_y < ay + 36;
    btn_k_15 = mouse_x >= 205 && mouse_x < 420 && mouse_y >= ay && mouse_y < ay + 36;
    btn_s_15 = mouse_x >= 435 && mouse_x < 650 && mouse_y >= ay && mouse_y < ay + 36;

    set_c(slider56 == 0 ? 0xdfb15b : 0x151b26); gfx_rect(30, ay, 160, 36); set_c(0x1b2331); gfx_rect(30, ay, 160, 36, 0);
    set_c(slider56 == 1 ? 0xdfb15b : 0x151b26); gfx_rect(205, ay, 215, 36); set_c(0x1b2331); gfx_rect(205, ay, 215, 36, 0);
    set_c(slider56 == 2 ? 0xdfb15b : 0x151b26); gfx_rect(435, ay, 215, 36); set_c(0x1b2331); gfx_rect(435, ay, 215, 36, 0);

    set_c(slider56 == 0 ? 0x0a0c10 : 0xedf1f7); gfx_x = 45; gfx_y = ay + 10; gfx_drawstr("FREE BLEND");
    set_c(slider56 == 1 ? 0x0a0c10 : 0xedf1f7); gfx_x = 215; gfx_y = ay + 10; gfx_drawstr("-15 dB KICK AUGMENT");
    set_c(slider56 == 2 ? 0x0a0c10 : 0xedf1f7); gfx_x = 445; gfx_y = ay + 10; gfx_drawstr("-15 dB SNARE AUGMENT");

    mouse_clicked && btn_free ? (slider56 = 0; sliderchange(slider56););
    mouse_clicked && btn_k_15 ? (slider56 = 1; sliderchange(slider56););
    mouse_clicked && btn_s_15 ? (slider56 = 2; sliderchange(slider56););
  );

  // --- FOOTER BAR ---
  set_c(0x0d111a); gfx_rect(0, gfx_h - 22, gfx_w, 22);
  set_c(0x1b2331); gfx_line(0, gfx_h - 22, gfx_w, gfx_h - 22);
  gfx_setfont(2, "Segoe UI", 9);
  set_c(0x6e788d); gfx_x = 16; gfx_y = gfx_h - 17;
  gfx_drawstr("Damei Suite Atumpan Pulse v2.5 -- Reverse-Engineered Slate Digital Trigger 2 Architecture -- Zero Latency Phase-Locked");

  // Mouse Up Persistence
  last_mouse_cap = mouse_cap;

