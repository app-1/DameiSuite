    ph_x = 330; ph_y = sy - 15; ph_w = 60; ph_h = 32;
    btn_ph = mouse_x >= ph_x && mouse_x < ph_x + ph_w && mouse_y >= ph_y && mouse_y < ph_y + ph_h;
    set_c(s_phase ? 0xf03344 : (btn_ph ? 0x222c3d : 0x151b26)); gfx_rect(ph_x, ph_y, ph_w, ph_h);
    set_c(0x1b2331); gfx_rect(ph_x, ph_y, ph_w, ph_h, 0);
    gfx_setfont(1, "Orbitron", 10, 'b');
    set_c(s_phase ? 0x0a0c10 : 0xedf1f7);
    gfx_measurestr("Phase 180 deg", tw, th);
    gfx_x = ph_x + (ph_w - tw) * 0.5; gfx_y = ph_y + (ph_h - th) * 0.5;
    gfx_drawstr("Phase 180 deg");
    mouse_clicked && btn_ph ? (
      s_idx == 0 ? slider14 = !slider14 : s_idx == 1 ? slider24 = !slider24 : slider34 = !slider34;
      sliderchange(s_idx == 0 ? slider14 : s_idx == 1 ? slider24 : slider34);
    );

    // Mute Button
    m_x = 405; m_y = sy - 15; m_w = 55; m_h = 32;
    btn_m = mouse_x >= m_x && mouse_x < m_x + m_w && mouse_y >= m_y && mouse_y < m_y + m_h;
    set_c(s_mute ? 0xf03344 : (btn_m ? 0x222c3d : 0x151b26)); gfx_rect(m_x, m_y, m_w, m_h);
    set_c(0x1b2331); gfx_rect(m_x, m_y, m_w, m_h, 0);
    set_c(s_mute ? 0x0a0c10 : 0xedf1f7);
    gfx_measurestr("MUTE", tw, th);
    gfx_x = m_x + (m_w - tw) * 0.5; gfx_y = m_y + (m_h - th) * 0.5;
    gfx_drawstr("MUTE");
    mouse_clicked && btn_m ? (
      s_idx == 0 ? slider15 = !slider15 : s_idx == 1 ? slider25 = !slider25 : slider35 = !slider35;
      sliderchange(s_idx == 0 ? slider15 : s_idx == 1 ? slider25 : slider35);
    );

    // Solo Button
    so_x = 475; so_y = sy - 15; so_w = 55; so_h = 32;
    btn_so = mouse_x >= so_x && mouse_x < so_x + so_w && mouse_y >= so_y && mouse_y < so_y + so_h;
    set_c(s_solo ? 0xdfb15b : (btn_so ? 0x222c3d : 0x151b26)); gfx_rect(so_x, so_y, so_w, so_h);
    set_c(0x1b2331); gfx_rect(so_x, so_y, so_w, so_h, 0);
    set_c(s_solo ? 0x0a0c10 : 0xedf1f7);
    gfx_measurestr("SOLO", tw, th);
    gfx_x = so_x + (so_w - tw) * 0.5; gfx_y = so_y + (so_h - th) * 0.5;
    gfx_drawstr("SOLO");
    mouse_clicked && btn_so ? (
      s_idx == 0 ? slider16 = !slider16 : s_idx == 1 ? slider26 = !slider26 : slider36 = !slider36;
      sliderchange(s_idx == 0 ? slider16 : s_idx == 1 ? slider26 : slider36);
    );

    // QUICK SAMPLE PACK LOAD BUTTONS
    qy = content_y + 225;
    gfx_setfont(1, "Orbitron", 9.5, 'b');
    set_c(0x2899ff); gfx_x = 30; gfx_y = qy - 18; gfx_drawstr("QUICK LOAD REPUTABLE SAMPLES");

    btn_load_loathe_k = mouse_x >= 30 && mouse_x < 220 && mouse_y >= qy && mouse_y < qy + 30;
    btn_load_loathe_s = mouse_x >= 235 && mouse_x < 425 && mouse_y >= qy && mouse_y < qy + 30;
    btn_load_caskets  = mouse_x >= 440 && mouse_x < 630 && mouse_y >= qy && mouse_y < qy + 30;

    set_c(btn_load_loathe_k ? 0xdfb15b : 0x151b26); gfx_rect(30, qy, 190, 30); set_c(0x1b2331); gfx_rect(30, qy, 190, 30, 0);
    set_c(btn_load_loathe_s ? 0xdfb15b : 0x151b26); gfx_rect(235, qy, 190, 30); set_c(0x1b2331); gfx_rect(235, qy, 190, 30, 0);
    set_c(btn_load_caskets ? 0xdfb15b : 0x151b26); gfx_rect(440, qy, 190, 30); set_c(0x1b2331); gfx_rect(440, qy, 190, 30, 0);

    set_c(btn_load_loathe_k ? 0x0a0c10 : 0xedf1f7); gfx_x = 40; gfx_y = qy + 8; gfx_drawstr("LOAD 01 LOATHE KICK");
    set_c(btn_load_loathe_s ? 0x0a0c10 : 0xedf1f7); gfx_x = 245; gfx_y = qy + 8; gfx_drawstr("LOAD 05 LOATHE SNARE");
    set_c(btn_load_caskets ? 0x0a0c10 : 0xedf1f7); gfx_x = 450; gfx_y = qy + 8; gfx_drawstr("LOAD CASKETS KICK OUT");

