    gfx_setfont(2, "Segoe UI", 11);
    set_c(0x6e788d);
    gfx_x = 600; gfx_y = by + 8;
    sprintf(str_buf, "Target: Preset %d (Sankofa Matrix)", slider62);
    gfx_drawstr(str_buf);
  );

  // TABS 1, 2, 3: SAMPLE SLOTS (Close, Sub, Room)
  (active_tab >= 1 && active_tab <= 3) ? (
    s_idx = active_tab - 1;
    s_idx == 0 ? (
      s_name = "SLOT 1: CLOSE / ATTACK"; s_path = slider41; s_vol = slider11; s_pan = slider12;
      s_tune = slider13; s_phase = slider14; s_mute = slider15; s_solo = slider16;
      s_len = sample_len0; s_nch = sample_nch0; s_sr = sample_sr0;
    ) : s_idx == 1 ? (
      s_name = "SLOT 2: SUB / BODY"; s_path = slider42; s_vol = slider21; s_pan = slider22;
      s_tune = slider23; s_phase = slider24; s_mute = slider25; s_solo = slider26;
      s_len = sample_len1; s_nch = sample_nch1; s_sr = sample_sr1;
    ) : (
      s_name = "SLOT 3: ROOM / AMBIENCE"; s_path = slider43; s_vol = slider31; s_pan = slider32;
      s_tune = slider33; s_phase = slider34; s_mute = slider35; s_solo = slider36;
      s_len = sample_len2; s_nch = sample_nch2; s_sr = sample_sr2;
    );

    draw_panel(16, content_y, content_w, content_h, s_name, s_len > 0 ? "SAMPLE LOADED" : "EMPTY");

    // File Info Box & Drop Zone
    fz_x = 30; fz_y = content_y + 40; fz_w = content_w - 60; fz_h = 50;
    set_c(0x0e131d); gfx_rect(fz_x, fz_y, fz_w, fz_h);
    set_c(0x1b2331); gfx_rect(fz_x, fz_y, fz_w, fz_h, 0);

    // Extract filename only
    fn_len = strlen(s_path);
    fn_start = fn_len - 1;
    while(fn_start > 0 && str_getchar(s_path, fn_start) != 47 && str_getchar(s_path, fn_start) != 92;
      fn_start -= 1;
    );
    str_getchar(s_path, fn_start) == 47 || str_getchar(s_path, fn_start) == 92 ? fn_start += 1;
    strcpy(str_buf, s_path);
    strcpy_from(str_buf, str_buf, fn_start);

    gfx_setfont(1, "Orbitron", 10.5, 'b');
    set_c(s_len > 0 ? 0xdfb15b : 0x6e788d);
    gfx_x = fz_x + 14; gfx_y = fz_y + 12;
    gfx_drawstr(s_len > 0 ? str_buf : "NO SAMPLE LOADED -- DRAG & DROP .WAV HERE OR CLICK BROWSE");

    gfx_setfont(2, "Consolas", 9.5);
    set_c(0x2899ff);
    gfx_x = fz_x + 14; gfx_y = fz_y + 30;
    s_len > 0 ? (
      sprintf(str_buf, "%d samples | %.1f ms | %s | %d Hz", s_len, s_len / (s_sr > 0 ? s_sr : 48000) * 1000.0, s_nch > 1 ? "Stereo" : "Mono", s_sr);
      gfx_drawstr(str_buf);
    ) : (
      gfx_drawstr("Slate Trigger 2 Architecture: Close Snap, Sub Body, Ambient Room");
    );

    // BROWSE BUTTON (Native Windows Dialog via @serialize)
    bz_x = fz_x + fz_w - 110; bz_y = fz_y + 8; bz_w = 95; bz_h = 34;
    bz_hov = mouse_x >= bz_x && mouse_x < bz_x + bz_w && mouse_y >= bz_y && mouse_y < bz_y + bz_h;
    set_c(bz_hov ? 0xdfb15b : 0x1b2331); gfx_rect(bz_x, bz_y, bz_w, bz_h);
    set_c(0x1b2331); gfx_rect(bz_x, bz_y, bz_w, bz_h, 0);
    gfx_setfont(1, "Orbitron", 9.5, 'b');
    set_c(bz_hov ? 0x0a0c10 : 0xedf1f7);
    gfx_measurestr("BROWSE", tw, th);
    gfx_x = bz_x + (bz_w - tw) * 0.5; gfx_y = bz_y + (bz_h - th) * 0.5;
