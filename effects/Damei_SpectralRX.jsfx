desc:Damei SpectralRX (Multi-Track Spectral Restoration, De-Noise, De-Hum & Resonance Tamer) [Damei Suite]
// =============================================================================
// DAMEI SUITE // SPECTRAL RX (v2.5 FLAGSHIP RESTORATION ENGINE)
// Native Recreation of iZotope RX Advanced Restoration, De-Noise, De-Hum & Deconstruct
// Coupled with Dynamic Sub & Sympathetic Resonance Tamer (45-280Hz LR4 Split-Band Clamp)
// Design: Darkglass Emerald & Reinforced Hydraulic Chassis Visual Engine
// Built for Modern Metal, Rock & Precision Stem Restoration
// =============================================================================

tags: restoration spectral denoise dehum deconstruct resonance tamer damei

slider1:24<0,26,1{0: Manual / Custom,1: Chris Lord-Alge,2: Andy Wallace,3: Colin Richardson,4: Jens Bogren,5: Buster Odeholm,6: Nolly Getgood,7: Zakk Cervini,8: Jordan Fish,9: Dan Lancaster,10: Will Putney,11: George Lever,12: Andrew Scheps,13: Terry Date,14: Ross Robinson,15: David Bendeth,16: Joey Sturgis,17: Taylor Larson,18: Henrik Udd,19: Fredrik Nordstrom,20: Tom Lord-Alge,21: Brendan O'Brien,22: Butch Vig,23: Forrester Savell,24: Manuel Renner (SENNA - Out Of The Blue),25: Matt Thomas (Ashtone - Live Room Authority),26: Mark Williamson (Sugarhouse - Live Cohesion)}>-Producer DNA Preset
slider2:1<0,6,1{0: Universal Transparent RX (Any Track / Stem),1: Bass Stem + 6-Str Low-B Tamer (Musical Preserve),2: Bass Harmonic / Accent Stem (Chime & Idle Clean),3: High-Gain Guitar Amp / Cab De-Noise,4: Vocal / Dialogue Isolate & Breath/Hiss De-Noise,5: Acoustic Drum / Tom Sympathetic Ring & Bleed Tamer,6: Master / Bus Tape & Analog Hum Restoration}>-Target Source Profile
slider3:1<0,1,1{Bypassed,Active}>-Spectral De-Noise Enable
slider4:-45<-75,-18,0.5>-Tape/Amp Hiss Floor Threshold (dBFS)
slider5:16<0,36,0.5>-Spectral Hiss Reduction (dB)
slider6:1850<600,5000,10>-Hiss Focus Crossover (Hz)
slider7:-62<-80,-24,0.5>-Idle Stem Silence Gate Threshold (dBFS)
slider8:18<0,90,1>-Idle Stem Silence Attenuation (dB)
slider9:1<0,1,1{Bypassed,Active}>-De-Hum Enable
slider10:0<0,1,1{50 Hz (UK/EU/AU Mains),60 Hz (US Mains)}>-Mains Hum Fundamental
slider11:12<0,24,0.5>-Hum & Harmonic Notch Depth (dB)
slider12:14<4,30,1>-Notch Q Factor (Surgical)
slider13:0.0<-6,6,0.1>-Tonal Fundamental Gain (dB)
slider14:-4.0<-24,0,0.5>-Noisy Hiss/Fuzz Component Gain (dB)
slider15:3.5<0,15,0.5>-Fret Squeak & String Slide Tamer (2.8kHz dB)
slider16:2.0<0,12,0.5>-Pick/Pluck Click Softener (dB)
slider17:1<0,1,1{Bypassed,Active}>-Low-End / Sympathetic Resonance Tamer Enable
slider18:-15.5<-36,-3,0.5>-Sub / Resonance Ceiling Threshold (dBFS)
slider19:10.0<0,20,0.5>-Max Dynamic Resonance Clamp (dB)
slider20:66<45,280,1>-Low-B / Resonance Crossover (Hz)
slider21:27<18,35,0.5>-Sub-Infrasonic Rumble Cut (Hz)
slider22:0.0<-12,12,0.1>-Input Trim (dB)
slider23:0.0<-12,12,0.1>-Output Makeup Trim (dB)
slider24:100<0,100,1>-Dry / Wet Mix (%)
slider25:0<0,2,1{0: Normal Restoration Out,1: Delta Solo (Removed Hiss & Resonance Excess),2: Resonance Band Solo (45-280Hz)}>-Audition Mode

in_pin:Left Input
in_pin:Right Input
out_pin:Left Output
out_pin:Right Output

options:gmem=DameiMixMetering,no_meter

@serialize
file_var(0, slider1);
file_var(0, slider2);
file_var(0, slider3);
file_var(0, slider4);
file_var(0, slider5);
file_var(0, slider6);
file_var(0, slider7);
file_var(0, slider8);
file_var(0, slider9);
file_var(0, slider10);
file_var(0, slider11);
file_var(0, slider12);
file_var(0, slider13);
file_var(0, slider14);
file_var(0, slider15);
file_var(0, slider16);
file_var(0, slider17);
file_var(0, slider18);
file_var(0, slider19);
file_var(0, slider20);
file_var(0, slider21);
file_var(0, slider22);
file_var(0, slider23);
file_var(0, slider24);
file_var(0, slider25);

@init
  ext_noinit = 1;

  SCOPE_SIZE = 240;
  SCOPE_IN   = 1024;
  SCOPE_OUT  = 1536;
  SCOPE_CLAMP= 2048;
  SCOPE_HISS = 2560;

  scope_ptr  = 0;
  scope_sub  = 0;

  last_preset  = -1;
  last_profile = -1;
  last_gmem_p  = -1;

  prev_mouse_cap = 0;
  drag_knob = 0;
  drag_start_y = 0;
  drag_start_val = 0;

  cur_clamp_db    = 0.0;
  cur_hiss_red_db = 0.0;
  cur_gate_att_db = 0.0;
  cur_squeak_cut  = 0.0;

  low_b_level_db  = -60.0;
  mid_ref_db      = -60.0;
  hiss_level_db   = -60.0;
  tonal_level_db  = -60.0;
  harm_level_db   = -60.0;
  stem_level_db   = -60.0;

  low_b_env_sq    = 0.000001;
  mid_ref_env_sq  = 0.000001;
  hiss_env        = 0.0001;
  tonal_env       = 0.0001;
  harm_env_sq     = 0.000001;
  stem_env        = 0.0001;

  squeak_env      = 0.0001;
  click_fast_env  = 0.0001;
  click_slow_env  = 0.0001;

  sifam_in_db     = -60.0;
  sifam_out_db    = -60.0;

  // Filter state variables
  hp_x1_l = 0; hp_x2_l = 0; hp_y1_l = 0; hp_y2_l = 0;
  hp_x1_r = 0; hp_x2_r = 0; hp_y1_r = 0; hp_y2_r = 0;

  hum1_x1_l = 0; hum1_x2_l = 0; hum1_y1_l = 0; hum1_y2_l = 0;
  hum1_x1_r = 0; hum1_x2_r = 0; hum1_y1_r = 0; hum1_y2_r = 0;
  hum2_x1_l = 0; hum2_x2_l = 0; hum2_y1_l = 0; hum2_y2_l = 0;
  hum2_x1_r = 0; hum2_x2_r = 0; hum2_y1_r = 0; hum2_y2_r = 0;
  hum3_x1_l = 0; hum3_x2_l = 0; hum3_y1_l = 0; hum3_y2_l = 0;
  hum3_x1_r = 0; hum3_x2_r = 0; hum3_y1_r = 0; hum3_y2_r = 0;

  sub_lp1_x1_l = 0; sub_lp1_x2_l = 0; sub_lp1_y1_l = 0; sub_lp1_y2_l = 0;
  sub_lp2_x1_l = 0; sub_lp2_x2_l = 0; sub_lp2_y1_l = 0; sub_lp2_y2_l = 0;
  sub_hp1_x1_l = 0; sub_hp1_x2_l = 0; sub_hp1_y1_l = 0; sub_hp1_y2_l = 0;
  sub_hp2_x1_l = 0; sub_hp2_x2_l = 0; sub_hp2_y1_l = 0; sub_hp2_y2_l = 0;

  sub_lp1_x1_r = 0; sub_lp1_x2_r = 0; sub_lp1_y1_r = 0; sub_lp1_y2_r = 0;
  sub_lp2_x1_r = 0; sub_lp2_x2_r = 0; sub_lp2_y1_r = 0; sub_lp2_y2_r = 0;
  sub_hp1_x1_r = 0; sub_hp1_x2_r = 0; sub_hp1_y1_r = 0; sub_hp1_y2_r = 0;
  sub_hp2_x1_r = 0; sub_hp2_x2_r = 0; sub_hp2_y1_r = 0; sub_hp2_y2_r = 0;

  mid_bp_x1 = 0; mid_bp_x2 = 0; mid_bp_y1 = 0; mid_bp_y2 = 0;
  harm_bp_x1 = 0; harm_bp_x2 = 0; harm_bp_y1 = 0; harm_bp_y2 = 0;

  hiss_lp1_x1_l = 0; hiss_lp1_x2_l = 0; hiss_lp1_y1_l = 0; hiss_lp1_y2_l = 0;
  hiss_lp2_x1_l = 0; hiss_lp2_x2_l = 0; hiss_lp2_y1_l = 0; hiss_lp2_y2_l = 0;
  hiss_hp1_x1_l = 0; hiss_hp1_x2_l = 0; hiss_hp1_y1_l = 0; hiss_hp1_y2_l = 0;
  hiss_hp2_x1_l = 0; hiss_hp2_x2_l = 0; hiss_hp2_y1_l = 0; hiss_hp2_y2_l = 0;

  hiss_lp1_x1_r = 0; hiss_lp1_x2_r = 0; hiss_lp1_y1_r = 0; hiss_lp1_y2_r = 0;
  hiss_lp2_x1_r = 0; hiss_lp2_x2_r = 0; hiss_lp2_y1_r = 0; hiss_lp2_y2_r = 0;
  hiss_hp1_x1_r = 0; hiss_hp1_x2_r = 0; hiss_hp1_y1_r = 0; hiss_hp1_y2_r = 0;
  hiss_hp2_x1_r = 0; hiss_hp2_x2_r = 0; hiss_hp2_y1_r = 0; hiss_hp2_y2_r = 0;

  sqk_bp_x1 = 0; sqk_bp_x2 = 0; sqk_bp_y1 = 0; sqk_bp_y2 = 0;
  sqk_nt_x1_l = 0; sqk_nt_x2_l = 0; sqk_nt_y1_l = 0; sqk_nt_y2_l = 0;
  sqk_nt_x1_r = 0; sqk_nt_x2_r = 0; sqk_nt_y1_r = 0; sqk_nt_y2_r = 0;

  function clamp(x, lo, hi) (
    x < lo ? lo : (x > hi ? hi : x);
  );

  function lin2db(lin) (
    lin > 0.000000001 ? 20.0 * log10(lin) : -120.0;
  );

  function db2lin(dbv) (
    10.0^(dbv / 20.0);
  );

  function set_c(hex) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = 1.0;
  );

  function set_ca(hex, a) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = a;
  );

  function get_producer_name(p, out_s) (
    p == 0  ? strcpy(out_s, "0: Manual / Custom") :
    p == 1  ? strcpy(out_s, "1: Chris Lord-Alge (CLA Green)") :
    p == 2  ? strcpy(out_s, "2: Andy Wallace (Tight Low-End)") :
    p == 3  ? strcpy(out_s, "3: Colin Richardson (Machine Head)") :
    p == 4  ? strcpy(out_s, "4: Jens Bogren (Fascination Street)") :
    p == 5  ? strcpy(out_s, "5: Buster Odeholm (thrown / Northlane)") :
    p == 6  ? strcpy(out_s, "6: Nolly Getgood (Periphery / GGD)") :
    p == 7  ? strcpy(out_s, "7: Zakk Cervini (Bad Omens / Blink)") :
    p == 8  ? strcpy(out_s, "8: Jordan Fish (BMTH Post-Human)") :
    p == 9  ? strcpy(out_s, "9: Dan Lancaster (Don Broco)") :
    p == 10 ? strcpy(out_s, "10: Will Putney (Fit For An Autopsy)") :
    p == 11 ? strcpy(out_s, "11: George Lever (Loathe / Sleep Token)") :
    p == 12 ? strcpy(out_s, "12: Andrew Scheps (Rear Bus Density)") :
    p == 13 ? strcpy(out_s, "13: Terry Date (Pantera / Deftones)") :
    p == 14 ? strcpy(out_s, "14: Ross Robinson (Korn / Sepultura)") :
    p == 15 ? strcpy(out_s, "15: David Bendeth (Paramore)") :
    p == 16 ? strcpy(out_s, "16: Joey Sturgis (Asking Alexandria)") :
    p == 17 ? strcpy(out_s, "17: Taylor Larson (Periphery / Modern)") :
    p == 18 ? strcpy(out_s, "18: Henrik Udd (Architects / BMTH)") :
    p == 19 ? strcpy(out_s, "19: Fredrik Nordstrom (Studio Fredman)") :
    p == 20 ? strcpy(out_s, "20: Tom Lord-Alge (Weezer / Blink)") :
    p == 21 ? strcpy(out_s, "21: Brendan O'Brien (RATM / STP)") :
    p == 22 ? strcpy(out_s, "22: Butch Vig (Nevermind / Pumpkins)") :
    p == 23 ? strcpy(out_s, "23: Forrester Savell (Karnivool)") :
    p == 24 ? strcpy(out_s, "24: Manuel Renner (SENNA - Out Of The Blue)") :
    p == 25 ? strcpy(out_s, "25: Matt Thomas (Ashtone - Live Room Authority)") :
              strcpy(out_s, "26: Mark Williamson (Sugarhouse - Live Cohesion)");
  );

  function get_profile_name(m, out_s) (
    m == 0 ? strcpy(out_s, "UNIVERSAL TRANSPARENT RX") :
    m == 1 ? strcpy(out_s, "BASS STEM + LOW-B TAMER") :
    m == 2 ? strcpy(out_s, "BASS HARMONIC ACCENT") :
    m == 3 ? strcpy(out_s, "HIGH-GAIN GUITAR DE-NOISE") :
    m == 4 ? strcpy(out_s, "VOCAL ISOLATE & HISS") :
    m == 5 ? strcpy(out_s, "TOM RING & BLEED TAMER") :
             strcpy(out_s, "MASTER TAPE & HUM RX");
  );

  function update_coeffs() local(w0, cw, sw, alpha, a0, depth_db, A_hum, f_hum, q_hum) (
    // 1. Infrasonic HPF (slider21: 18..35 Hz, default 27 Hz, 2nd-order Butterworth)
    w0 = 2.0 * $pi * clamp(slider21, 18.0, 35.0) / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / (2.0 * 0.70710678);
    a0 = 1.0 + alpha;
    hp_b0 = ((1.0 + cw) * 0.5) / a0;
    hp_b1 = (-(1.0 + cw)) / a0;
    hp_b2 = hp_b0;
    hp_a1 = (-2.0 * cw) / a0;
    hp_a2 = (1.0 - alpha) / a0;

    // 2. Adaptive De-Hum Filters (3 harmonics at f_hum, 2*f_hum, 3*f_hum)
    f_hum = slider10 == 0 ? 50.0 : 60.0;
    q_hum = clamp(slider12, 4.0, 30.0);
    depth_db = -clamp(slider11, 0.0, 24.0);
    A_hum = 10.0^(depth_db / 40.0);

    // Harmonic 1
    w0 = 2.0 * $pi * f_hum / srate;
    cw = cos(w0); sw = sin(w0); alpha = sw / (2.0 * q_hum);
    a0 = 1.0 + alpha / A_hum;
    hum1_b0 = (1.0 + alpha * A_hum) / a0;
    hum1_b1 = (-2.0 * cw) / a0;
    hum1_b2 = (1.0 - alpha * A_hum) / a0;
    hum1_a1 = (-2.0 * cw) / a0;
    hum1_a2 = (1.0 - alpha / A_hum) / a0;

    // Harmonic 2
    w0 = 2.0 * $pi * (2.0 * f_hum) / srate;
    cw = cos(w0); sw = sin(w0); alpha = sw / (2.0 * q_hum);
    a0 = 1.0 + alpha / A_hum;
    hum2_b0 = (1.0 + alpha * A_hum) / a0;
    hum2_b1 = (-2.0 * cw) / a0;
    hum2_b2 = (1.0 - alpha * A_hum) / a0;
    hum2_a1 = (-2.0 * cw) / a0;
    hum2_a2 = (1.0 - alpha / A_hum) / a0;

    // Harmonic 3
    w0 = 2.0 * $pi * (3.0 * f_hum) / srate;
    cw = cos(w0); sw = sin(w0); alpha = sw / (2.0 * q_hum);
    a0 = 1.0 + alpha / A_hum;
    hum3_b0 = (1.0 + alpha * A_hum) / a0;
    hum3_b1 = (-2.0 * cw) / a0;
    hum3_b2 = (1.0 - alpha * A_hum) / a0;
    hum3_a1 = (-2.0 * cw) / a0;
    hum3_a2 = (1.0 - alpha / A_hum) / a0;

    // 3. Low-End / Resonance Crossover (LR4 split at slider20: 45..280 Hz, default 66 Hz)
    w0 = 2.0 * $pi * clamp(slider20, 45.0, 280.0) / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / (2.0 * 0.70710678);
    a0 = 1.0 + alpha;
    sub_lp_b0 = ((1.0 - cw) * 0.5) / a0;
    sub_lp_b1 = (1.0 - cw) / a0;
    sub_lp_b2 = sub_lp_b0;
    sub_lp_a1 = (-2.0 * cw) / a0;
    sub_lp_a2 = (1.0 - alpha) / a0;

    sub_hp_b0 = ((1.0 + cw) * 0.5) / a0;
    sub_hp_b1 = (-(1.0 + cw)) / a0;
    sub_hp_b2 = sub_hp_b0;
    sub_hp_a1 = sub_lp_a1;
    sub_hp_a2 = sub_lp_a2;

    // 4. Mid-Fundamental Reference Bandpass (70..280 Hz, center ~140 Hz)
    w0 = 2.0 * $pi * 140.0 / srate;
    cw = cos(w0); sw = sin(w0); alpha = sw / (2.0 * 0.67);
    a0 = 1.0 + alpha;
    mid_b0 = alpha / a0;
    mid_b1 = 0.0;
    mid_b2 = -alpha / a0;
    mid_a1 = (-2.0 * cw) / a0;
    mid_a2 = (1.0 - alpha) / a0;

    // 5. High-Frequency Hiss Crossover (LR4 split at slider6: 600..5000 Hz, default 1450 Hz)
    w0 = 2.0 * $pi * clamp(slider6, 600.0, 5000.0) / srate;
    cw = cos(w0); sw = sin(w0);
    alpha = sw / (2.0 * 0.70710678);
    a0 = 1.0 + alpha;
    hiss_lp_b0 = ((1.0 - cw) * 0.5) / a0;
    hiss_lp_b1 = (1.0 - cw) / a0;
    hiss_lp_b2 = hiss_lp_b0;
    hiss_lp_a1 = (-2.0 * cw) / a0;
    hiss_lp_a2 = (1.0 - alpha) / a0;

    hiss_hp_b0 = ((1.0 + cw) * 0.5) / a0;
    hiss_hp_b1 = (-(1.0 + cw)) / a0;
    hiss_hp_b2 = hiss_hp_b0;
    hiss_hp_a1 = hiss_lp_a1;
    hiss_hp_a2 = hiss_lp_a2;

    // 6. Concentrated Harmonic Bandpass Detector (400..2800 Hz, center ~1058 Hz)
    w0 = 2.0 * $pi * 1058.0 / srate;
    cw = cos(w0); sw = sin(w0); alpha = sw / (2.0 * 0.44);
    a0 = 1.0 + alpha;
    harm_b0 = alpha / a0;
    harm_b1 = 0.0;
    harm_b2 = -alpha / a0;
    harm_a1 = (-2.0 * cw) / a0;
    harm_a2 = (1.0 - alpha) / a0;

    // 7. Fret Squeak Bandpass Detector (2850 Hz, Q=2.85)
    w0 = 2.0 * $pi * 2850.0 / srate;
    cw = cos(w0); sw = sin(w0); alpha = sw / (2.0 * 2.85);
    a0 = 1.0 + alpha;
    sqk_det_b0 = alpha / a0;
    sqk_det_b1 = 0.0;
    sqk_det_b2 = -alpha / a0;
    sqk_det_a1 = (-2.0 * cw) / a0;
    sqk_det_a2 = (1.0 - alpha) / a0;

    // Gains & Ballistics
    in_trim_lin  = db2lin(slider22);
    out_trim_lin = db2lin(slider23);
    wet_mix      = slider24 / 100.0;
    tonal_gain   = db2lin(slider13);

    sub_att_c  = exp(-1.0 / max(1.0, 0.004 * srate));  // 4ms attack
    sub_rel_c  = exp(-1.0 / max(1.0, 0.065 * srate));  // 65ms release
    hiss_att_c = exp(-1.0 / max(1.0, 0.006 * srate));  // 6ms attack
    hiss_rel_c = exp(-1.0 / max(1.0, 0.045 * srate));  // 45ms release
    gate_open_c  = exp(-1.0 / max(1.0, (slider2 == 2 ? 0.008 : 0.005) * srate));  // 5-8ms opening attack
    gate_close_c = exp(-1.0 / max(1.0, (slider2 == 2 ? 0.320 : 0.220) * srate));  // 220-320ms release
  );

  function apply_target_profile(m) (
    m == 0 ? ( // Universal Transparent RX (Any Track / Stem)
      slider3 = 1; slider4 = -48.0; slider5 = 14.0; slider6 = 2200; slider7 = -62.0; slider8 = 18.0;
      slider9 = 1; slider10 = 0; slider11 = 10.0; slider12 = 14;
      slider13 = 0.0; slider14 = 0.0; slider15 = 0.0; slider16 = 0.0;
      slider17 = 0; slider18 = -18.0; slider19 = 6.0; slider20 = 60; slider21 = 22;
      slider22 = 0.0; slider23 = 0.0; slider24 = 100; slider25 = 0;
    ) : m == 1 ? ( // Bass Stem + 6-Str Low-B Tamer (Musical Preserve) (Tr 45)
      slider3 = 1; slider4 = -45.0; slider5 = 16.0; slider6 = 1850; slider7 = -62.0; slider8 = 18.0;
      slider9 = 1; slider10 = 0; slider11 = 12.0; slider12 = 14;
      slider13 = 0.0; slider14 = -4.0; slider15 = 3.5; slider16 = 2.0;
      slider17 = 1; slider18 = -15.5; slider19 = 10.0; slider20 = 66; slider21 = 27;
      slider22 = 0.0; slider23 = 0.0; slider24 = 100; slider25 = 0;
    ) : m == 2 ? ( // Bass Harmonic / Accent Stem (Chime & Idle Clean) (Tr 44)
      slider3 = 1; slider4 = -44.0; slider5 = 20.0; slider6 = 2400; slider7 = -46.0; slider8 = 45.0;
      slider9 = 1; slider10 = 0; slider11 = 14.0; slider12 = 16;
      slider13 = 1.5; slider14 = -6.0; slider15 = 4.0; slider16 = 2.5;
      slider17 = 1; slider18 = -17.0; slider19 = 8.0; slider20 = 62; slider21 = 28;
      slider22 = 0.0; slider23 = 0.0; slider24 = 100; slider25 = 0;
    ) : m == 3 ? ( // High-Gain Guitar Amp / Cab De-Noise
      slider3 = 1; slider4 = -40.0; slider5 = 24.0; slider6 = 1250; slider7 = -48.0; slider8 = 65.0;
      slider9 = 1; slider10 = 0; slider11 = 16.0; slider12 = 18;
      slider13 = 0.0; slider14 = -8.0; slider15 = 5.0; slider16 = 3.0;
      slider17 = 0; slider18 = -18.0; slider19 = 6.0; slider20 = 75; slider21 = 32;
      slider22 = 0.0; slider23 = 0.0; slider24 = 100; slider25 = 0;
    ) : m == 4 ? ( // Vocal / Dialogue Isolate & Breath/Hiss De-Noise
      slider3 = 1; slider4 = -48.0; slider5 = 16.0; slider6 = 3000; slider7 = -54.0; slider8 = 30.0;
      slider9 = 1; slider10 = 0; slider11 = 12.0; slider12 = 20;
      slider13 = 1.0; slider14 = -4.0; slider15 = 0.0; slider16 = 3.5;
      slider17 = 0; slider18 = -20.0; slider19 = 6.0; slider20 = 80; slider21 = 35;
      slider22 = 0.0; slider23 = 0.0; slider24 = 100; slider25 = 0;
    ) : m == 5 ? ( // Acoustic Drum / Tom Sympathetic Ring & Bleed Tamer
      slider3 = 1; slider4 = -46.0; slider5 = 14.0; slider6 = 3500; slider7 = -52.0; slider8 = 36.0;
      slider9 = 0; slider10 = 0; slider11 = 8.0; slider12 = 12;
      slider13 = 0.0; slider14 = -4.0; slider15 = 0.0; slider16 = 0.0;
      slider17 = 1; slider18 = -14.0; slider19 = 12.0; slider20 = 145; slider21 = 24;
