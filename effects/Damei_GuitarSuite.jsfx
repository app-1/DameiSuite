@init
ext_noinit = 1.0;

// MultiBand-Comp State & Filters (<220Hz, 220-3.2kHz, >3.2kHz)
mb_gr_low = 0.0; mb_gr_mid = 0.0; mb_gr_hi = 0.0;
mb_meter_low = 0.0; mb_meter_mid = 0.0; mb_meter_hi = 0.0;
mb_low_lx1 = 0; mb_low_lx2 = 0; mb_low_ly1 = 0; mb_low_ly2 = 0;
mb_low_rx1 = 0; mb_low_rx2 = 0; mb_low_ry1 = 0; mb_low_ry2 = 0;
mb_hi_lx1 = 0; mb_hi_lx2 = 0; mb_hi_ly1 = 0; mb_hi_ly2 = 0;
mb_hi_rx1 = 0; mb_hi_rx2 = 0; mb_hi_ry1 = 0; mb_hi_ry2 = 0;

cur_rms = -90.0;
cur_true_peak = -90.0;
cur_crest = 8.0;
vu_ballistics = 0.0;
vu_attack_c = exp(-1.0 / (0.300 * srate));
vu_val_db = -90.0;
cur_out_true_peak = -90.0;

chug_env = 0.0;
chug_gr_db = 0.0;
smooth_chug_gr = 0.0;

fizz_energy_env = 0.0;
fizz_energy_db = -60.0;
chug_energy_db = -60.0;

// Sub-bus live energy measurements
rhythm_env = 0.0; overdub_env = 0.0; cleans_env = 0.0; lead_env = 0.0; amb_env = 0.0;

// Correlation & Stereo vector state
corr_sum_xy = 0.0; corr_sum_xx = 0.0; corr_sum_yy = 0.0;
corr_val = 1.0;

// Biquad Filter States
hp_x1_l = 0; hp_x2_l = 0; hp_y1_l = 0; hp_y2_l = 0;
hp_x1_r = 0; hp_x2_r = 0; hp_y1_r = 0; hp_y2_r = 0;

chug_bp_x1_l = 0; chug_bp_x2_l = 0; chug_bp_y1_l = 0; chug_bp_y2_l = 0;
chug_bp_x1_r = 0; chug_bp_x2_r = 0; chug_bp_y1_r = 0; chug_bp_y2_r = 0;

mud_x1_l = 0; mud_x2_l = 0; mud_y1_l = 0; mud_y2_l = 0;
mud_x1_r = 0; mud_x2_r = 0; mud_y1_r = 0; mud_y2_r = 0;

fizz1_x1_l = 0; fizz1_x1_r = 0; fizz1_x2_l = 0; fizz1_x2_r = 0;
fizz1_y1_l = 0; fizz1_y1_r = 0; fizz1_y2_l = 0; fizz1_y2_r = 0;

fizz2_x1_l = 0; fizz2_x1_r = 0; fizz2_x2_l = 0; fizz2_x2_r = 0;
fizz2_y1_l = 0; fizz2_y1_r = 0; fizz2_y2_l = 0; fizz2_y2_r = 0;

fizz3_x1_l = 0; fizz3_x1_r = 0; fizz3_x2_l = 0; fizz3_x2_r = 0;
fizz3_y1_l = 0; fizz3_y1_r = 0; fizz3_y2_l = 0; fizz3_y2_r = 0;

bite_x1_l = 0; bite_x1_r = 0; bite_x2_l = 0; bite_x2_r = 0;
bite_y1_l = 0; bite_y1_r = 0; bite_y2_l = 0; bite_y2_r = 0;

air_x1_l = 0; air_x1_r = 0; air_x2_l = 0; air_x2_r = 0;
air_y1_l = 0; air_y1_r = 0; air_y2_l = 0; air_y2_r = 0;

mid_carve_x1 = 0; mid_carve_x2 = 0; mid_carve_y1 = 0; mid_carve_y2 = 0;
vbp_x1 = 0; vbp_x2 = 0; vbp_y1 = 0; vbp_y2 = 0;
vox_duck_env = 0.0;

vca_gain = 1.0;
vca_env = 0.0;
tape_rot = 0.0;

// Ring Buffers for Oscilloscope & Vector Visualizers
buf_sz = 256;
buf_in_arr = 10000;
buf_chug_arr = 10300;
buf_out_arr = 10600;
buf_mid_arr = 10900;
buf_side_arr = 11200;
buf_in_idx = 0;

prev_preset = slider23;
prev_source_model = slider24;

// Hyperbolic tangent function for analog console saturation
function tanh(x) local(e2x) (
  x > 15.0 ? 1.0 : x < -15.0 ? -1.0 : (
    e2x = exp(2.0 * x);
    (e2x - 1.0) / (e2x + 1.0);
  );
);

// ─────────────────────────────────────────────────────────────────────────────
// FILTER COEFF UPDATE FUNCTION
// ─────────────────────────────────────────────────────────────────────────────
function update_guitar_filters() (

  // MultiBand Crossover 1: 220Hz (Low Chug boundary)
  mb_w1 = 2.0 * $pi * 220.0 / srate;
  mb_al1 = sin(mb_w1) * 0.7071;
  mb_lp1_a0 = 1.0 + mb_al1;
  mb_lp1_b0 = ((1.0 - cos(mb_w1)) * 0.5) / mb_lp1_a0;
  mb_lp1_b1 = (1.0 - cos(mb_w1)) / mb_lp1_a0;
  mb_lp1_b2 = ((1.0 - cos(mb_w1)) * 0.5) / mb_lp1_a0;
  mb_lp1_a1 = (-2.0 * cos(mb_w1)) / mb_lp1_a0;
  mb_lp1_a2 = (1.0 - mb_al1) / mb_lp1_a0;

  // MultiBand Crossover 2: 3200Hz (High Fizz boundary)
  mb_w2 = 2.0 * $pi * 3200.0 / srate;
  mb_al2 = sin(mb_w2) * 0.7071;
  mb_hp2_a0 = 1.0 + mb_al2;
  mb_hp2_b0 = ((1.0 + cos(mb_w2)) * 0.5) / mb_hp2_a0;
  mb_hp2_b1 = (-(1.0 + cos(mb_w2))) / mb_hp2_a0;
  mb_hp2_b2 = ((1.0 + cos(mb_w2)) * 0.5) / mb_hp2_a0;
  mb_hp2_a1 = (-2.0 * cos(mb_w2)) / mb_hp2_a0;
  mb_hp2_a2 = (1.0 - mb_al2) / mb_hp2_a0;

  // 1. Sub-Guitar Highpass Anchor (slider9 Hz Butterworth 12dB/oct)
  w0_hp = 2.0 * $pi * slider9 / srate;
  cos_hp = cos(w0_hp); sin_hp = sin(w0_hp);
  alpha_hp = sin_hp / (2.0 * 0.7071);
  hp_a0 = 1.0 + alpha_hp;
  hp_b0 = ((1.0 + cos_hp) * 0.5) / hp_a0;
  hp_b1 = (-(1.0 + cos_hp)) / hp_a0;
  hp_b2 = ((1.0 + cos_hp) * 0.5) / hp_a0;
  hp_a1 = (-2.0 * cos_hp) / hp_a0;
  hp_a2 = (1.0 - alpha_hp) / hp_a0;

  // 2. Chug Bandpass Detector Filter (slider4 Hz, Q=1.6)
  w0_cb = 2.0 * $pi * slider4 / srate;
  cos_cb = cos(w0_cb); sin_cb = sin(w0_cb);
  alpha_cb = sin_cb / (2.0 * 1.6);
  cb_a0 = 1.0 + alpha_cb;
  cb_b0 = (sin_cb * 0.5) / cb_a0;
  cb_b1 = 0.0;
  cb_b2 = (-sin_cb * 0.5) / cb_a0;
  cb_a1 = (-2.0 * cos_cb) / cb_a0;
  cb_a2 = (1.0 - alpha_cb) / cb_a0;

  // 3. Low-Mid Mud Scoop (380Hz, Q=1.5, slider10 dB)
  f0_mud = 380.0; gain_mud = slider10; q_mud = 1.5;
  a_mud = exp(gain_mud * (log(10.0) / 40.0));
  w0_mud = 2.0 * $pi * f0_mud / srate;
  cos_mud = cos(w0_mud); sin_mud = sin(w0_mud);
  alpha_mud = sin_mud / (2.0 * q_mud);
  mud_a0 = 1.0 + alpha_mud / a_mud;
  mud_b0 = (1.0 + alpha_mud * a_mud) / mud_a0;
  mud_b1 = (-2.0 * cos_mud) / mud_a0;
  mud_b2 = (1.0 - alpha_mud * a_mud) / mud_a0;
  mud_a1 = (-2.0 * cos_mud) / mud_a0;
  mud_a2 = (1.0 - alpha_mud / a_mud) / mud_a0;

  // 4. De-Fizz Notch 1: 3.2kHz (Gojira X / 5150 harsh whistling, Q=3.8)
  f0_f1 = 3200.0; gain_f1 = slider28 ? slider11 : 0.0; q_f1 = 3.8;
  a_f1 = exp(gain_f1 * (log(10.0) / 40.0));
  w0_f1 = 2.0 * $pi * f0_f1 / srate;
  cos_f1 = cos(w0_f1); sin_f1 = sin(w0_f1);
  alpha_f1 = sin_f1 / (2.0 * q_f1);
  f1_a0 = 1.0 + alpha_f1 / a_f1;
  f1_b0 = (1.0 + alpha_f1 * a_f1) / f1_a0;
  f1_b1 = (-2.0 * cos_f1) / f1_a0;
  f1_b2 = (1.0 - alpha_f1 * a_f1) / f1_a0;
  f1_a1 = (-2.0 * cos_f1) / f1_a0;
  f1_a2 = (1.0 - alpha_f1 / a_f1) / f1_a0;

  // 5. De-Fizz Notch 2: 4.2kHz (Digital frizzle / sizzle, Q=3.6)
  f0_f2 = 4200.0; gain_f2 = slider28 ? slider12 : 0.0; q_f2 = 3.6;
  a_f2 = exp(gain_f2 * (log(10.0) / 40.0));
  w0_f2 = 2.0 * $pi * f0_f2 / srate;
  cos_f2 = cos(w0_f2); sin_f2 = sin(w0_f2);
  alpha_f2 = sin_f2 / (2.0 * q_f2);
  f2_a0 = 1.0 + alpha_f2 / a_f2;
  f2_b0 = (1.0 + alpha_f2 * a_f2) / f2_a0;
  f2_b1 = (-2.0 * cos_f2) / f2_a0;
  f2_b2 = (1.0 - alpha_f2 * a_f2) / f2_a0;
  f2_a1 = (-2.0 * cos_f2) / f2_a0;
  f2_a2 = (1.0 - alpha_f2 / a_f2) / f2_a0;

  // 6. De-Fizz Notch 3: 6.8kHz (Cali cab high whistle / alias harshness, Q=4.0)
  f0_f3 = 6800.0; gain_f3 = slider28 ? slider13 : 0.0; q_f3 = 4.0;
  a_f3 = exp(gain_f3 * (log(10.0) / 40.0));
  w0_f3 = 2.0 * $pi * f0_f3 / srate;
  cos_f3 = cos(w0_f3); sin_f3 = sin(w0_f3);
  alpha_f3 = sin_f3 / (2.0 * q_f3);
  f3_a0 = 1.0 + alpha_f3 / a_f3;
  f3_b0 = (1.0 + alpha_f3 * a_f3) / f3_a0;
  f3_b1 = (-2.0 * cos_f3) / f3_a0;
  f3_b2 = (1.0 - alpha_f3 * a_f3) / f3_a0;
  f3_a1 = (-2.0 * cos_f3) / f3_a0;
  f3_a2 = (1.0 - alpha_f3 / a_f3) / f3_a0;

  // 7. Pick Attack Clarity & Bite: 1.8kHz Peaking (Q=1.2, slider14 dB)
  f0_bite = 1800.0; gain_bite = slider14; q_bite = 1.2;
  a_bite = exp(gain_bite * (log(10.0) / 40.0));
  w0_bite = 2.0 * $pi * f0_bite / srate;
  cos_bite = cos(w0_bite); sin_bite = sin(w0_bite);
  alpha_bite = sin_bite / (2.0 * q_bite);
  bite_a0 = 1.0 + alpha_bite / a_bite;
  bite_b0 = (1.0 + alpha_bite * a_bite) / bite_a0;
  bite_b1 = (-2.0 * cos_bite) / bite_a0;
  bite_b2 = (1.0 - alpha_bite * a_bite) / bite_a0;
  bite_a1 = (-2.0 * cos_bite) / bite_a0;
  bite_a2 = (1.0 - alpha_bite / a_bite) / bite_a0;

  // 8. Air Sheen High Shelf: >9.5kHz (Q=0.75, slider15 dB)
  f0_air = 9500.0; gain_air = slider15; q_air = 0.75;
  a_air = exp(gain_air * (log(10.0) / 40.0));
  w0_air = 2.0 * $pi * f0_air / srate;
  cos_air = cos(w0_air); sin_air = sin(w0_air);
  alpha_air = sin_air / (2.0 * q_air);
  two_sqrt_a_alpha = 2.0 * sqrt(a_air) * alpha_air;
  air_a0 = (a_air + 1.0) - (a_air - 1.0) * cos_air + two_sqrt_a_alpha;
  air_b0 = (a_air * ((a_air + 1.0) + (a_air - 1.0) * cos_air + two_sqrt_a_alpha)) / air_a0;
  air_b1 = (-2.0 * a_air * ((a_air - 1.0) + (a_air + 1.0) * cos_air)) / air_a0;
  air_b2 = (a_air * ((a_air + 1.0) - (a_air - 1.0) * cos_air - two_sqrt_a_alpha)) / air_a0;
  air_a1 = (2.0 * ((a_air - 1.0) - (a_air + 1.0) * cos_air)) / air_a0;
  air_a2 = ((a_air + 1.0) - (a_air - 1.0) * cos_air - two_sqrt_a_alpha) / air_a0;

  // Radio Megaphone AM Filter Coefficients (450Hz High-Pass & 3200Hz Low-Pass)
  rd_hp_w0 = 2.0 * $pi * 450.0 / srate;
  rd_hp_cos = cos(rd_hp_w0); rd_hp_sin = sin(rd_hp_w0);
  rd_hp_alpha = rd_hp_sin / (2.0 * 0.7071);
  rd_hp_b0 = (1.0 + rd_hp_cos) * 0.5; rd_hp_b1 = -(1.0 + rd_hp_cos); rd_hp_b2 = (1.0 + rd_hp_cos) * 0.5;
  rd_hp_a0 = 1.0 + rd_hp_alpha; rd_hp_a1 = -2.0 * rd_hp_cos; rd_hp_a2 = 1.0 - rd_hp_alpha;
  rd_hp_b0 /= rd_hp_a0; rd_hp_b1 /= rd_hp_a0; rd_hp_b2 /= rd_hp_a0; rd_hp_a1 /= rd_hp_a0; rd_hp_a2 /= rd_hp_a0;

  rd_lp_w0 = 2.0 * $pi * 3200.0 / srate;
  rd_lp_cos = cos(rd_lp_w0); rd_lp_sin = sin(rd_lp_w0);
  rd_lp_alpha = rd_lp_sin / (2.0 * 0.7071);
  rd_lp_b0 = (1.0 - rd_lp_cos) * 0.5; rd_lp_b1 = 1.0 - rd_lp_cos; rd_lp_b2 = (1.0 - rd_lp_cos) * 0.5;
  rd_lp_a0 = 1.0 + rd_lp_alpha; rd_lp_a1 = -2.0 * rd_lp_cos; rd_lp_a2 = 1.0 - rd_lp_alpha;
  rd_lp_b0 /= rd_lp_a0; rd_lp_b1 /= rd_lp_a0; rd_lp_b2 /= rd_lp_a0; rd_lp_a1 /= rd_lp_a0; rd_lp_a2 /= rd_lp_a0;

  // 9. Center Channel Snare/Vocal Pocket Cut: 1.8kHz - 2.5kHz in Mid channel (slider17 dB)
  f0_mc = 2100.0; gain_mc = slider17; q_mc = 1.1;
  a_mc = exp(gain_mc * (log(10.0) / 40.0));
  w0_mc = 2.0 * $pi * f0_mc / srate;
  cos_mc = cos(w0_mc); sin_mc = sin(w0_mc);
  alpha_mc = sin_mc / (2.0 * q_mc);
  mc_a0 = 1.0 + alpha_mc / a_mc;
  mc_b0 = (1.0 + alpha_mc * a_mc) / mc_a0;
  mc_b1 = (-2.0 * cos_mc) / mc_a0;
  mc_b2 = (1.0 - alpha_mc * a_mc) / mc_a0;
  mc_a1 = (-2.0 * cos_mc) / mc_a0;
  mc_a2 = (1.0 - alpha_mc / a_mc) / mc_a0;

  // 9b. Dynamic Vocal Unmasking Pocket Filter (2.4kHz Bell on Mid Channel)
  vbp_f0 = 2400.0; vbp_q = 1.2;
  vbp_w0 = 2.0 * $pi * vbp_f0 / srate;
  vbp_cos = cos(vbp_w0); vbp_sin = sin(vbp_w0);
  vbp_alpha = vbp_sin / (2.0 * vbp_q);
  vbp_a0 = 1.0 + vbp_alpha;
  vbp_b0 = vbp_alpha / vbp_a0;
  vbp_b1 = 0.0;
  vbp_b2 = -vbp_alpha / vbp_a0;
  vbp_a1 = (-2.0 * vbp_cos) / vbp_a0;
  vbp_a2 = (1.0 - vbp_alpha) / vbp_a0;

  vox_duck_att = exp(-1.0 / (0.012 * srate)); // 12 ms fast attack
  vox_duck_rel = exp(-1.0 / (0.180 * srate)); // 180 ms smooth release

  chug_att_c = exp(-1.0 / (max(0.005, slider7 * 0.001) * srate));
  chug_rel_c = exp(-1.0 / (max(0.020, slider8 * 0.001) * srate));
);


// ===== EAR-CANDY DIRECTOR BEGIN (shared region + energy aware producer tricks) =====
// Reads REAPER regions (gmem 100-109) AND the measured energy of this bus. Per region it picks a small,
// producer-specific set of tricks, then fires them only inside the right musical window. Every wet
// signal is derived from the performance itself and capped, so it stays barely audible.
dk_bm = 780000;
dk_rv = dk_bm;            dk_rv_sz = 400000;      // reverse-bloom capture
dk_dA = dk_bm + 400000;   dk_dB = dk_bm + 600000; dk_dA_sz = 200000;   // ping-pong throw
dk_ec = dk_bm + 800000;   dk_ec_sz = 200000;      // ducked echo
dk_hl = dk_bm + 1000000;                          // hall (4 combs x 8000 + 2 allpass x 3000)
dk_sh = dk_bm + 1060000;  dk_sh_sz = 16384;       // shifter / tap ring
dk_sl = dk_bm + 1080000;  dk_sl_sz = 30000;       // slap
memset(dk_bm, 0, 1110000);

dk_tip = 1900000; dk_pn = 1900080; dk_pm = 1900100; dk_ps = 1900120; dk_pd = 1900140; dk_pg = 1900160;
dk_nm = 1900180; dk_hint = 1900200; dk_tn = 1900220;
dk_tbl = 1900240; dk_env = dk_tbl; dk_hold = dk_tbl + 16; dk_tg = dk_tbl + 32; dk_ga = dk_tbl + 48; dk_tgp = dk_tbl + 64;
dk_hp = 1900330; dk_hd = 1900340; dk_sp = 1900350; dk_bs = 1900360;
dk_i = 0; loop(80, dk_tbl[dk_i] = 0; dk_i += 1; );
dk_i = 0; loop(8, dk_hp[dk_i] = 0; dk_hd[dk_i] = 0; dk_i += 1; );
dk_sp[0] = 0.0; dk_sp[1] = 0.33; dk_sp[2] = 0.66;
dk_vis = 65535;
dk_susm = 63232;   // sustained tricks: BREATH GHOSTUP GHOSTDN GRIT WIDE TREM SWEEP
dk_boot = 1;

dk_bs[0] = 0.22; dk_bs[1] = 0.30; dk_bs[2] = 0.30; dk_bs[3] = 0.20; dk_bs[4] = 0.45; dk_bs[5] = 0.55;
dk_bs[6] = 0.60; dk_bs[7] = 0.50; dk_bs[8] = 0.50; dk_bs[9] = 0.12; dk_bs[10] = 0.15; dk_bs[11] = 0.22;
dk_bs[12] = 0.30; dk_bs[13] = 0.10; dk_bs[14] = 0.18; dk_bs[15] = 0.20;

dk_nm[0] = "Chord Throw";
dk_hint[0] = "last phrase thrown ping-pong into the drop";
