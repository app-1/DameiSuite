desc:Damei Guitar Bus Alchemist (Harmonic Forge & Quad-Wall Sculptor)
// =============================================================================
// DAMEI GUITAR BUS ALCHEMIST // HARMONIC FORGE (v2.1)
// Complete Guitar Bus Processing Engine with Formulaic AI Assist
// Built by Damei Audio & Antigravity IDE
// =============================================================================

slider1:0<0,6,1{Guitar Wall Overview,Dynamic Chug Sculptor,Harshness & De-Fizz Tamer,Quad-Wall Stereo Imager,ReEQ & MultiBand-Comp Rack,Producer Matrix & Session Tips,Ear-Candy Director}>-Active Module
slider2:-12.0<-24.0,-6.0,0.5>-Target Level (dBFS Peak)
slider3:0<-100,100,1>-Dynamic Chug Clamp Strength (%) [0% = Transparent]
slider4:190<120,280,5>-Chug Resonance Center Frequency (Hz)
slider5:-22.0<-36.0,-12.0,0.5>-Chug Dynamic Threshold (dBFS)
slider6:3.5<1.0,8.0,0.5>-Chug Max Attenuation Depth (dB)
slider7:40<15,120,5>-Chug Attack Time (ms)
slider8:140<40,350,10>-Chug Release Recovery Time (ms)
slider9:80<50,120,5>-Sub-Guitar Highpass Anchor (Hz)
slider10:0.0<-6.0,0.0,0.2>-Low-Mid Mud Box Scoop 380Hz (dB)
slider11:0.0<-8.0,0.0,0.2>-Harsh Fizz Notch 1 at 3.2kHz (dB)
slider12:0.0<-8.0,0.0,0.2>-Harsh Fizz Notch 2 at 4.2kHz (dB)
slider13:0.0<-6.0,0.0,0.2>-Cali/Digital Whistle Notch at 6.8kHz (dB)
slider14:0.0<0.0,4.0,0.2>-Pick Attack Clarity & Bite 1.8kHz (dB)
slider15:0.0<0.0,4.0,0.2>-Air Sheen & Cabinet Presence >9kHz (dB)
slider16:1.00<0.60,1.60,0.02>-Stereo Quad-Wall Width Ratio (1.0 = Normal)
slider17:0.0<-6.0,0.0,0.2>-Center Channel Snare/Vocal Pocket Cut (dB)
slider18:0<0,2,1{Off (Standard Stereo),Focus Sides (Quad-Wall Immersion),Mono Center Check}>-Mid/Side Carving Mode
slider19:0<0,2,1{Linear Transparent Passthrough,Smooth Musical Hermite Soft-Clip,Commercial Hard Brickwall Clamp}>-Mix Bus Clipper Topology
slider20:-0.1<-12.0,-0.1,0.1>-Target Headroom Ceiling (dBTP)
slider21:0<0,1,1{Free Output Gain (No Clipping),Strict Pre-Master Headroom Lock}>-Headroom Ceiling Guardian
slider22:0.0<-12.0,12.0,0.5>-Output Makeup Trim (dB)
slider23:0<0,16,1{Default Neutral Wire Passthrough,Lance Prenc (Alpha Wolf / Polaris),Scott Seigel (DIESECT),Jonathan Dolese (Mirrorcell / Cane Hill),Buster Odeholm (thrown / Northlane),Kel Pinchin (Currents / Invent Animate),Sam Guaiana (Silverstein / TDWP),Forrester Savell (Karnivool / DLC),Jens Bogren (Fascination Street),Adam Nolly Getgood (Periphery / GGD),Will Putney (Fit For An Autopsy),George Lever (Sleep Token / Loathe),Sam Bassal (Thornhill / Ocean Grove),Henrik Udd (Architects / BMTH),Joey Sturgis (Asking Alexandria),Dan Braunstein (Spiritbox / Dayseeker),Zakk Cervini (Blink-182 / BMTH)}>-Producer Guitar Signature Preset
slider24:0<0,4,1{Gojira X + GGD Cali (Active Project Quad-Wall),Nolly X + Clean Split,High-Gain 7/8-String Modern Metal,Drop-Tuned Hardcore Raw DIs,Ambient / Shoegaze Layered Wall}>-Guitar Rig Source Model
slider25:-18.0<-24.0,-12.0,1.0>-Analogue 0 VU Target Reference (dBFS RMS)
slider26:1<0,3,1{Off,Tasteful Auto-Impact (+0.08x Width in Chorus),Commercial Drop Slam (+0.14x Width / +0.8dB Drive),Subtle Dynamic Breathing}>-Song Structure & Chorus Impact AI
slider27:0<0,2,1{Hybrid Prioritize REAPER Regions,Strict Project Regions,Autonomous Acoustic AI}>-Song Structure Detection Mode
slider28:1<0,1,1{Bypassed,Active De-Fizz & Resonance Notcher}>-De-Fizz Master Engine
slider29:0<0,3,1{Full Guitar Bus (Stereo Sum),Rhythm Focus Detector (Chug Dominant),Overdub / Mid Focus,Cali Cab Resonant Band}>-Sidechain Detector Mode
slider30:0.0<-6.0,6.0,0.1>-Input Gain Calibration (dB)
slider31:25<0,100,1>-Britson Neve Console Drive (%)
slider32:20<0,100,1>-Tape Saturation & Heat (Tape Cassette 2 Emulation) (%)
slider33:15<0,100,1>-VCA Bus Glue & Punch (DC1A3 Emulation) (%)
slider34:0<0,1,1{In-Chain Finisher (Complements Britson/Tape/DC1A on Track 48),Standalone All-in-One (Emulates Full 3-Plugin Bus Chain)}>-Guitar Bus Integration Mode
slider35:1<0,1,1{Manual Parameter Mode,AI Assist Active Formula Calibration}>-AI Assist Intelligent Engine
slider36:1<0,1,1{Free Dynamic (Manual Trim),Drum Bus Pocket Link (Auto-Guard -4.5dB rel to Drums)}>-Drum Bus Pocket Balance Link
slider37:0.0<-6.0,6.0,0.2>-Rhythm Sub-Bus Balance Trim (dB)
slider38:0.0<-6.0,6.0,0.2>-Overdub Sub-Bus Balance Trim (dB)
slider39:0.0<-6.0,6.0,0.2>-Clean Sub-Bus Balance Trim (dB)
slider40:0.0<-6.0,6.0,0.2>-Lead Sub-Bus Balance Trim (dB)
slider41:0.0<-6.0,6.0,0.2>-Ambient Sub-Bus Balance Trim (dB)

// Producer Ear-Candy & Transition Engine
slider42:1<0,2,1{Off,Auto Pick-Scrape on Pre-Drop,Always Active Riser}>-Producer Ear-Candy: Pick Scrape & Swell
slider43:1<0,2,1{Off,Killswitch 1/16th Chopper,Killswitch 1/8th Triplet Chopper}>-Pre-Drop Killswitch Stutter
slider44:0<0,2,1{Off,Auto Radio Megaphone Pre-Drop,Always Active AM Radio}>-Radio Megaphone Pre-Drop Choke
slider45:1<0,2,1{Off,Auto Whammy Pitch Dive on Breakdown,Tape Stop Slowdown}>-Breakdown Pitch Dive & Tape Stop
slider46:30<0,100,5>-Ear-Candy Wet / Dry Blend (%)
slider48:1<0,1,1{Classic Fixed-Timing Automators,Ear-Candy Director (Region + Energy Aware)}>-Ear-Candy Director
slider49:40<0,100,1>-Ear-Candy Amount (%%)
slider50:22<0,65535,1>-Ear-Candy Trick Palette (bitmask)
slider51:1<0,1,1{Manual Palette,Follow Producer Preset}>-Ear-Candy Palette Follows Producer
// ReEQ, Comp, MultiBand-Comp & Saturation Studio Rack
slider52:1<0,1,1{Bypassed,Active}>-MultiBand-Comp Engine Toggle
slider53:35<0,100,1>-MultiBand Low Chug Clamp (%) [<220Hz]
slider54:25<0,100,1>-MultiBand Mid Crunch Punch (%) [220Hz-3.2kHz]
slider55:28<0,100,1>-MultiBand High Fizz Tamer (%) [>3.2kHz]
slider56:2.5<1.0,8.0,0.5>-MultiBand Comp Ratio

slider47:1<0,1,1{Off,On}>-Matrix Trim (applies Assessment Matrix auto-correct lane)
options:gmem=DameiMixMetering
options:no_meter
options:maxmem=2097152
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

