  gfx_setfont(1, "Orbitron", 11, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = bp_x + 14; gfx_y = pm_y + 264; gfx_drawstr("PRODUCER HEURISTICS:");
  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  tip_base = slider2 * 4;
  gfx_x = bp_x + 14; gfx_y = pm_y + 284; gfx_drawstr(dk_tip[tip_base + 0]);
  gfx_x = bp_x + 14; gfx_y = pm_y + 302; gfx_drawstr(dk_tip[tip_base + 1]);
  gfx_x = bp_x + 14; gfx_y = pm_y + 320; gfx_drawstr(dk_tip[tip_base + 2]);
  gfx_x = bp_x + 14; gfx_y = pm_y + 338; gfx_drawstr(dk_tip[tip_base + 3]);
);

// =============================================================================
// TAB 7: EAR CANDY DOCK & PRODUCER PLAYBOOK
// =============================================================================
slider1 == 7 ? (
  draw_component_header("TAB 7 // EAR-CANDY DIRECTOR & PRODUCER PLAYBOOK",
                        "Real-time intelligent director applying producer craft tricks dynamically",
                        "Reads song structure & live bus energy; injects subtle ear-candy on section entries",
                        "REAPER REGIONS -> LIVE ENERGY RADAR -> DYNAMIC ENVELOPE DOCK -> SUMMING BUS");

  ec_y = ws_y + 68;
  ec_h = ws_h - 78;
  col_w = floor((ws_w - 32) * 0.50);

  // ---------------------------------------------------------------------------
  // LEFT COLUMN: EAR-CANDY DIRECTOR & TRICK PALETTE DOCK
  // ---------------------------------------------------------------------------
  lx = ws_x + 12;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(lx, ec_y, col_w, ec_h);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(lx, ec_y, col_w, ec_h, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = lx + 16; gfx_y = ec_y + 12;
  gfx_drawstr("EAR-CANDY DIRECTOR // DYNAMIC PALETTE");

  // Director Mode Toggle Button
  dm_y = ec_y + 38;
  dm_hov = (mouse_x >= lx + 16 && mouse_x <= lx + col_w - 16 && mouse_y >= dm_y && mouse_y <= dm_y + 28);
  gfx_r = slider48 ? 0.05 : 0.02; gfx_g = slider48 ? 0.16 : 0.03; gfx_b = slider48 ? 0.24 : 0.04;
  gfx_rect(lx + 16, dm_y, col_w - 32, 28);
  gfx_r = slider48 ? 0.00 : 0.30; gfx_g = slider48 ? 0.85 : 0.35; gfx_b = slider48 ? 1.00 : 0.45;
  gfx_rect(lx + 16, dm_y, col_w - 32, 28, 0);

  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_r = slider48 ? 1.0 : 0.70; gfx_g = slider48 ? 1.0 : 0.75; gfx_b = slider48 ? 1.0 : 0.80;
  dm_str = slider48 ? "DIRECTOR ON: REGION + ENERGY AWARE" : "DIRECTOR OFF: FIXED MANUAL TIMING";
  gfx_measurestr(dm_str, dm_w, dm_h);
  gfx_x = lx + 16 + floor((col_w - 32 - dm_w) * 0.5); gfx_y = dm_y + floor((28 - dm_h) * 0.5);
  gfx_drawstr(dm_str);
  mouse_clicked && dm_hov ? (slider48 = !slider48; slider_automate(););

  // Intensity Slider Track
  is_y = dm_y + 36;
  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = lx + 16; gfx_y = is_y; gfx_printf("EAR-CANDY INTENSITY AMOUNT: %d %%", slider49);

  gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06; gfx_rect(lx + 16, is_y + 16, col_w - 32, 12);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(lx + 16, is_y + 16, col_w - 32, 12, 0);
  fill_w = floor((slider49 / 100.0) * (col_w - 34));
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(lx + 17, is_y + 17, fill_w, 10);

  // Slider interaction
  (mouse_cap & 1) && (mouse_x >= lx + 16 && mouse_x <= lx + col_w - 16 && mouse_y >= is_y + 12 && mouse_y <= is_y + 32) ? (
    slider49 = clamp(floor(((mouse_x - (lx + 16)) / (col_w - 32)) * 100), 0, 100);
    slider_automate();
  );

  // 8 Selectable Producer Instrumental Tricks
  tr_y = is_y + 36;
  tr_h = 24;
  k_i = 0;
  while (k_i < 8) (
    ty = tr_y + k_i * (tr_h + 4);
    is_on = (slider50 & (1 << k_i)) > 0;
    t_hov = (mouse_x >= lx + 16 && mouse_x <= lx + col_w - 16 && mouse_y >= ty && mouse_y <= ty + tr_h);

    gfx_r = is_on ? 0.04 : 0.015; gfx_g = is_on ? 0.08 : 0.020; gfx_b = is_on ? 0.12 : 0.028;
    gfx_rect(lx + 16, ty, col_w - 32, tr_h);

    // Live Activity Meter Fill
    cur_env = k_i == 0 ? dk_env0 : (k_i == 1 ? dk_env1 : (k_i == 2 ? dk_env2 : (k_i == 3 ? dk_env3 : (k_i == 4 ? dk_env4 : (k_i == 5 ? dk_env5 : (k_i == 6 ? dk_env6 : dk_env7))))));
    act_w = floor(cur_env * (col_w - 34));
    act_w > 0 ? (
      gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 0.40;
      gfx_rect(lx + 17, ty + 1, act_w, tr_h - 2);
      gfx_a = 1.0;
    );

    gfx_r = is_on ? 0.85 : 0.25; gfx_g = is_on ? 0.70 : 0.30; gfx_b = is_on ? 0.22 : 0.40;
    gfx_rect(lx + 16, ty, col_w - 32, tr_h, 0);

    gfx_setfont(2, "Consolas", 10.5, 'b');
    gfx_r = is_on ? 1.0 : 0.55; gfx_g = is_on ? 0.95 : 0.60; gfx_b = is_on ? 0.70 : 0.70;
    gfx_x = lx + 24; gfx_y = ty + 6;
    gfx_drawstr(dk_nm[k_i]);

    gfx_r = 0.55; gfx_g = 0.65; gfx_b = 0.75; gfx_x = lx + 200; gfx_y = ty + 6;
    gfx_drawstr(dk_hint[k_i]);

    mouse_clicked && t_hov ? (
      slider50 = is_on ? (slider50 - (1 << k_i)) : (slider50 + (1 << k_i));
      slider_automate();
    );
    k_i += 1;
  );

  // Director Real-Time Reasoning Log Window
  log_y = tr_y + 8 * (tr_h + 4) + 6;
  log_h = ec_h - (log_y - ec_y) - 12;
  gfx_r = 0.010; gfx_g = 0.014; gfx_b = 0.020; gfx_rect(lx + 16, log_y, col_w - 32, log_h);
