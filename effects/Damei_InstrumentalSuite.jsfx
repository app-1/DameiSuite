desc:Damei Instrumental Bus Alchemist (Harmonic Crucible & Summing Matrix)
// =============================================================================
// DAMEI SUITE // 2026 REAPER MASTER SUMMING INFRASTRUCTURE
// ARCHETYPE: FUNTUNFUNEFU-DENKYEMFUNEFU (Collective Summing & Unified Destiny)
// FLAGSHIP AFRO-CYBERNETIC LUXURY CONSOLE SURFACE ARCHITECTURE (@gfx 1080 720)
// V8.0 FLAGSHIP: 8 DEDICATED TABS, PRODUCER MATRIX, EAR-CANDY DOCK & PLAYBOOK
// =============================================================================

slider1:0<0,7,1{0: OVERVIEW, 1: TONAL EQ, 2: BUS GLUE, 3: CRUCIBLE, 4: STEREO, 5: POCKET, 6: PRODUCER MATRIX, 7: EAR CANDY DOCK}>-Active Navigation Tab
slider2:6<0,24,1{00: Unity Baseline (1:1 Transparent Pass), 01: Lance Prenc (Alpha Wolf - 60cm Of Steel), 02: Scott Seigel (DIESECT - TOO MANY SCARS), 03: Jonathan Dolese (Mirrorcell - U(phoria)), 04: Buster Odeholm (thrown / Northlane - Evian), 05: Lewis Johns (Love Is Noise / blanket - Blur), 06: Kel Pinchin (Split Chain - I'm Not Dying To Be Here), 07: Dan Lancaster & Jason Perry (Don Broco - Endorphins), 08: Erik Bickerstaffe (Static Dress - face..), 09: Sam Guaiana (Silverstein - Misery Made Me), 10: Zach Tuch (Heavenward - Tangerine), 11: Forrester Savell (City Of Souls - Cruelty / Karnivool), 12: Leon Schmidt (SUNBORN - Nebula), 13: Ermin Hamidovic (Systematic / 01 The End of All We Know), 14: Will Putney (Fit For An Autopsy - Walk With Me In Hell), 15: George Lever (Loathe - Agressive Evolution / Sleep Token), 16: Sam Bassal (Thornhill - nerv), 17: Henrik Udd (Architects - 8. Gravity), 18: Dan Braunstein (Spiritbox - Keep Sweet), 19: Zakk Cervini & Erik Ron (Bad Omens - THE DEATH OF PEACE OF MIND), 20: Jens Bogren (Fascination Street Studios Benchmark), 21: Adam Nolly Getgood (Periphery / GGD Modern Metal Target), 22: Acle Kahney (TesseracT - King), 23: Adam Cichocki (heaving. - carsick), 24: Manuel Renner (SENNA - Out Of The Blue)}>-Producer Reference Benchmark
slider3:0<-6.0,6.0,0.1>-Input Calibration Gain (dB)
slider4:-1.8<-6.0,6.0,0.1>-Producer Headroom Trim (dB)
slider5:0<0,1,1{Free Output, -6.0 dBTP Strict Pre-Master Lock}>-Headroom Guardian Mode
slider6:80<40,160,1>-Sub-Bass Mono Anchor Cutoff (Hz)
slider7:1<0,1,1{Bypass, Active Sentry}>-Kick/Bass Transient Sentry
slider8:0.8<0.0,3.0,0.1>-Vocal Pocket Dynamic Notch Depth (dB)
slider9:1<0,1,1{Manual Lock, gmem Auto-Sensing}>-Vocal Pocket Corridor Mode
slider10:1<0,1,1{Bypass, Engaged}>-Master Bus Glue Compressor
slider11:0<0,1,1{British VCA Punch, Neve Diode Bridge Vintage}>-Bus Glue Topology
slider12:-9.0<-36.0,0.0,0.5>-Bus Glue Threshold (dB)
slider13:2<0,3,1{1.5:1 Subtle, 2:1 Master Glue, 4:1 Modern Punch, 8:1 Heavy Squeeze}>-Bus Glue Ratio
slider14:10.0<0.1,100.0,0.5>-Bus Glue Attack (ms)
slider15:2<0,4,1{100ms Fast, 300ms Snappy, 600ms Classical, 1200ms Smooth, Auto Ballistics}>-Bus Glue Release
slider16:39<20,250,1>-Bus Glue Sidechain Detector HPF (Hz)
slider17:100<0,100,1>-Bus Glue Dry/Wet Mix (%)
slider18:38<20,60,1>-Tonal Forge HPF Cutoff (Hz)
slider19:3.0<-6.0,6.0,0.1>-Tonal Forge 80Hz Punch (dB)
slider20:-3.0<-6.0,6.0,0.1>-Tonal Forge 202Hz Mud Scoop (dB)
slider21:1.5<-6.0,6.0,0.1>-Tonal Forge 1.5kHz Mid Body (dB)
slider22:3.0<-6.0,6.0,0.1>-Tonal Forge 3.0kHz Pick Bite (dB)
slider23:1<0,3,1{Transparent Pure Pass, Neve 8014 Iron Desk, Studer A800 15 IPS Tape, Triode Tube Crucible}>-Harmonic Saturation Engine
slider24:2.8<0.0,12.0,0.1>-Harmonic Desk Drive (dB)
slider25:1.08<0.80,1.40,0.01>-Quad-Wall Stereo Imager Width
slider26:1<0,1,1{Bypass, Active Chorus Sync}>-Song Structure Chorus Impact
slider27:1<0,1,1{Bypass 1:1 Unity, Engaged Active Summing}>-Master Suite Processing State
slider28:0<0,1,1{Normal Processing, Delta Solo Audition}>-Delta Solo Audition
slider29:0<0,1,1{Snapshot A, Snapshot B}>-A/B Comparison Snapshot
slider30:0<0,1,1{Stereo Summing, Mid/Side Summing}>-Master Processing Mode
slider31:3.0<-6.0,6.0,0.1>-Tonal Forge 8.0kHz Air Sheen (dB)
slider32:0<0,2,1{Manual Standby, Local Ollama / HF Audit, Safe Auto-Calibrate (+-0.5dB Max)}>-AI Mix Assistant Engine
slider33:0<0,1,1{Off, Engaged}>-Ear Candy: Chorus Stereo Bloom
slider34:0<0,1,1{Off, Engaged}>-Ear Candy: Pre-Drop Tape Choke
slider35:0<0,1,1{Off, Engaged}>-Ear Candy: Sub-Drop Ground-Slam
slider36:0<0,1,1{Off, Engaged}>-Ear Candy: Breakdown Desk Lift
slider37:1<0,1,1{Manual, Adaptive AI Tactical Interlock}>-AI Ear-Candy Tactician
slider48:1<0,1,1{Manual Fixed Timing, Director On (Region + Energy Aware)}>-Ear-Candy Director Mode
slider49:65<0,100,1>-Ear-Candy Intensity Amount (%)
slider50:255<0,255,1>-Active Ear-Candy Trick Palette Mask
slider51:1<0,1,1{Manual Lock, Auto-Follow Producer Preset}>-Playbook Auto-Sync

in_pin:Instrumental In L
in_pin:Instrumental In R
out_pin:Master Sum L
out_pin:Master Sum R

options:no_meter
options:gmem=DameiMixMetering
options:maxmem=1048576

@init
ext_noinit = 1.0;
M_PI = 3.14159265358979323846;

// EQ Biquad State History (ReEQ 7-Band Alignment)
hpf_x1_l = 0; hpf_x2_l = 0; hpf_y1_l = 0; hpf_y2_l = 0;
hpf_x1_r = 0; hpf_x2_r = 0; hpf_y1_r = 0; hpf_y2_r = 0;

p80_x1_l = 0; p80_x2_l = 0; p80_y1_l = 0; p80_y2_l = 0;
p80_x1_r = 0; p80_x2_r = 0; p80_y1_r = 0; p80_y2_r = 0;

b90_x1_l = 0; b90_x2_l = 0; b90_y1_l = 0; b90_y2_l = 0;
b90_x1_r = 0; b90_x2_r = 0; b90_y1_r = 0; b90_y2_r = 0;

s200_x1_l = 0; s200_x2_l = 0; s200_y1_l = 0; s200_y2_l = 0;
s200_x1_r = 0; s200_x2_r = 0; s200_y1_r = 0; s200_y2_r = 0;

b15_x1_l = 0; b15_x2_l = 0; b15_y1_l = 0; b15_y2_l = 0;
b15_x1_r = 0; b15_x2_r = 0; b15_y1_r = 0; b15_y2_r = 0;

b3k_x1_l = 0; b3k_x2_l = 0; b3k_y1_l = 0; b3k_y2_l = 0;
b3k_x1_r = 0; b3k_x2_r = 0; b3k_y1_r = 0; b3k_y2_r = 0;

s8k_x1_l = 0; s8k_x2_l = 0; s8k_y1_l = 0; s8k_y2_l = 0;
s8k_x1_r = 0; s8k_x2_r = 0; s8k_y1_r = 0; s8k_y2_r = 0;

sm_x1 = 0; sm_x2 = 0; sm_y1 = 0; sm_y2 = 0;

// Sidechain detector state
sc_x1 = 0; sc_x2 = 0; sc_y1 = 0; sc_y2 = 0;
comp_env = -100.0;
glue_gr_db = 0.0;

// Dynamic Vocal Pocket 2.2kHz notch state
np_x1_l = 0; np_x2_l = 0; np_y1_l = 0; np_y2_l = 0;
np_x1_r = 0; np_x2_r = 0; np_y1_r = 0; np_y2_r = 0;
pocket_depth = 0.8;
pocket_dyn_dip = 0.8;

vu_rms_smooth = 0.0;
inst_peak = 0.0;
inst_rms = -90.0;
sifam_needle_vu = -20.0;
sifam_needle_gr = 0.0;
corr_smooth = 0.95;

// Buffers in JSFX memory
scope_buf_l = 2000;
scope_buf_r = 2300;
scope_pos = 0;

// 128-point Gain Reduction History buffer for scrolling GR strip (Tab 2)
gr_hist = 3000;
gr_hist_pos = 0;
loop_gr = 0;
while (loop_gr < 128) (
  gr_hist[loop_gr] = 0.0;
  loop_gr += 1;
);

// 64-band log-spaced energy tracker for real-time FFT spectrum display (Tab 1)
spec_bins = 3200;
loop_sp = 0;
while (loop_sp < 64) (
  spec_bins[loop_sp] = 0.0;
  loop_sp += 1;
);

// =============================================================================
// EAR-CANDY DIRECTOR & PRODUCER PLAYBOOK METADATA TABLES
// =============================================================================
dk_tip = 50000;
dk_pn  = 50100;
dk_nm  = 50200;
dk_hint= 50300;
dk_tn  = 50400;

dk_nm[0] = "Chorus Stereo Bloom";   dk_hint[0] = "+12% dynamic M/S width expansion on anthemic chorus entries";
dk_nm[1] = "Pre-Drop Tape Choke";   dk_hint[1] = "Sub roll-off & -1.5dB tuck over final bar to amplify drop impact";
dk_nm[2] = "Sub-Drop Ground-Slam";  dk_hint[2] = "45Hz resonant sub-pulse transient injection on section arrivals";
dk_nm[3] = "Breakdown Desk Lift";   dk_hint[3] = "+1.8dB warm Neve console saturation drive during intimate parts";
dk_nm[4] = "Snare Sidechain Snap";  dk_hint[4] = "39Hz detector filter allows snare crack to pierce through rhythm wall";
dk_nm[5] = "Air Sheen Excitement";  dk_hint[5] = "+1.2dB silky 8kHz HF sheen bloom during soaring climaxes";
dk_nm[6] = "Kick Decoupling Anchor";dk_hint[6] = "60Hz HPF decoupling kick punch from sub-bass to stop bus pumping";
dk_nm[7] = "Haas Wall Widener";     dk_hint[7] = "Microscopic Haas spatial spread on outer rhythm walls in bridges";

dk_tn[0] = "Open / Undefined";
dk_tn[1] = "Intro";
dk_tn[2] = "Verse";
dk_tn[3] = "Pre-Chorus";
dk_tn[4] = "Chorus";
dk_tn[5] = "Bridge";
dk_tn[6] = "Outro";

// Playbook Tips for 25 Producers (4 authentic craft heuristics each)
// 00: Unity Baseline
dk_tip[0]  = "Transparent wire: bit-exact summing pass across all instrumental stems.";
dk_tip[1]  = "Zero harmonic distortion or dynamic clamping added to source audio.";
dk_tip[2]  = "Ideal for auditioning external analog outboard master bus chains.";
dk_tip[3]  = "Maintains absolute 1:1 dynamic crest factor and stereo phase coherence.";

// 01: Lance Prenc (Alpha Wolf)
dk_tip[4]  = "Maximum punch: fast 100ms VCA release to snap instrumental transients forward.";
dk_tip[5]  = "3.8dB Neve desk drive with 35Hz steep sub-cut for bone-dry aggressive riffs.";
dk_tip[6]  = "Pre-drop tape choke creates lethal negative-space silence before downbeats.";
dk_tip[7]  = "SUB-BUS RULE: Rhythm guitars pushed +1.2dB wide; snare transient priority.";

// 02: Scott Seigel (DIESECT)
dk_tip[8]  = "Heavy metallic weight: +3.5dB 80Hz low shelf with 1.12x stereo expansion.";
dk_tip[9]  = "VCA bus glue at 4:1 with 300ms snappy release for relentless groove pressure.";
dk_tip[10] = "Ground-slam 45Hz sub pulse triggered on breakdown downbeat arrivals.";
dk_tip[11] = "SUB-BUS RULE: Low-end locked tight below 80Hz mono anchor; crisp upper bite.";

// 03: Jonathan Dolese (Mirrorcell)
dk_tip[12] = "Atmospheric modern rock: Studer A800 tape warmth with 1.10x wall widening.";
dk_tip[13] = "Musical 2:1 glue with 600ms release preserves dynamics and guitar shimmer.";
dk_tip[14] = "Air sheen excitement (+1.5dB @ 8kHz) lifts soaring melodic choruses.";
dk_tip[15] = "SUB-BUS RULE: Lead guitars carve 1.5kHz space; ambient pads tuck back -2dB.";

// 04: Buster Odeholm (thrown / Northlane)
dk_tip[16] = "Crushing low-end discipline: 90Hz mono anchor with 8:1 heavy squeeze.";
dk_tip[17] = "40Hz steep Butterworth high-pass decouples sub rumble from rhythmic chugs.";
dk_tip[18] = "Signature whammy dive & tape choke over final 0.4s into dead-silence drops.";
dk_tip[19] = "SUB-BUS RULE: Rhythm bus slammed -0.9dB trim; 4.0dB console saturation.";

// 05: Lewis Johns (Love Is Noise)
dk_tip[20] = "Shoegaze wall-of-sound: Neve diode bridge vintage warmth with slow attack.";
dk_tip[21] = "Gentle 1.5:1 ratio lets open, lush chords bloom naturally without choke.";
dk_tip[22] = "Breakdown desk lift adds rich 2nd harmonic thickness on sparse clean breaks.";
dk_tip[23] = "SUB-BUS RULE: Stereo width kept organic (1.05x); natural room bleed retained.";

// 06: Kel Pinchin (Split Chain - I'm Not Dying To Be Here) [TARGET BENCHMARK]
dk_tip[24] = "Authentic BUSTERse 4:1 punch: 10ms attack lets snare cut through cleanly.";
dk_tip[25] = "39Hz sidechain detector HPF prevents kick sub from ducking guitars/cymbals.";
dk_tip[26] = "Neve 8014 Iron Desk (2.8dB drive) replicates Britson Buss vintage summing.";
dk_tip[27] = "SUB-BUS RULE: Output trim -1.8dB matches DeeGain mix balance perfectly!";

// 07: Dan Lancaster & Jason Perry (Don Broco)
dk_tip[28] = "Radio-ready modern rock punch: crisp 3.0kHz bite (+3.0dB) for pick attack.";
dk_tip[29] = "Snappy 300ms release with British VCA punch keeps rhythm section bouncing.";
dk_tip[30] = "Chorus stereo bloom expands width to 1.18x during infectious hook entries.";
dk_tip[31] = "SUB-BUS RULE: Vocal pocket dynamic notch depth at 1.0dB for vocal cut.";

// 08: Erik Bickerstaffe (Static Dress)
dk_tip[32] = "Post-hardcore nostalgia: Triode tube crucible drive with gritty upper midrange.";
dk_tip[33] = "Tight 85Hz mono anchor keeps furious basslines grounded and punchy.";
dk_tip[34] = "Haas wall widener engaged on secondary guitar tracks during bridge walls.";
dk_tip[35] = "SUB-BUS RULE: Mud scoop at 202Hz (-3.5dB) clears throatiness from guitars.";

// 09: Sam Guaiana (Silverstein - Misery Made Me)
dk_tip[36] = "Signature 60Hz sidechain HPF decouples kick sub-bass from ducking guitars!";
dk_tip[37] = "Fast 300ms release with 4:1 ratio keeps modern emo-rock choruses driving.";
dk_tip[38] = "Punchy 80Hz low shelf (+2.8dB) delivers authoritative low-end impact.";
dk_tip[39] = "SUB-BUS RULE: Vocal pocket notch responds dynamically via gmem auto-sensing.";

// 10: Zach Tuch (Heavenward)
dk_tip[40] = "Dreamy grunge heaviness: lush Studer tape saturation with open 1.12x width.";
dk_tip[41] = "Soft 2:1 glue with 600ms release creates velvety glue across dense fuzz.";
dk_tip[42] = "Air sheen bloom lifts cymbals and reverb tails without harshness.";
dk_tip[43] = "SUB-BUS RULE: Sub-bass mono anchor locked at 75Hz for vintage vinyl warmth.";

// 11: Forrester Savell (Karnivool / City Of Souls)
dk_tip[44] = "Hi-fi progressive metal: pristine dynamic headroom with surgical 202Hz dip.";
dk_tip[45] = "Transparent VCA glue with 15ms attack preserves intricate drum ghost notes.";
dk_tip[46] = "Haas stereo spread opens complex rhythm textures to 1.16x width.";
dk_tip[47] = "SUB-BUS RULE: Strict -6dBTP pre-master lock guarantees zero inter-sample clip.";

// 12: Leon Schmidt (SUNBORN)
dk_tip[48] = "Atmospheric metalcore: deep 32Hz high-pass with expansive 8kHz air sheen.";
dk_tip[49] = "Neve iron saturation thickens down-tuned baritone guitars and analog synths.";
dk_tip[50] = "Chorus bloom triggers +14% width expansion on soaring melodic hooks.";
dk_tip[51] = "SUB-BUS RULE: Dynamic vocal pocket corridor carves 1.2dB during vocal peaks.";

// 13: Ermin Hamidovic (Systematic Productions)
dk_tip[52] = "The Metal Mixing Bible standard: strict headroom management and phase purity.";
dk_tip[53] = "British VCA 4:1 compression calibrated for exactly 1.5dB of transparent glue.";
dk_tip[54] = "38Hz Butterworth sub-cut guarantees clean transient headroom for mastering.";
dk_tip[55] = "SUB-BUS RULE: Mono anchor at 80Hz prevents low-frequency phase cancellation.";

// 14: Will Putney (Fit For An Autopsy)
dk_tip[56] = "Monstrous deathcore low-end: thick Neve desk drive (3.8dB) with 85Hz mono lock.";
dk_tip[57] = "Aggressive 4:1 bus glue clamps runaway rhythm transients with 10ms attack.";
dk_tip[58] = "Sub-drop ground slam pulses 45Hz sub-bass on bone-breaking breakdown drops.";
dk_tip[59] = "SUB-BUS RULE: Mud scoop at 202Hz (-3.8dB) prevents heavy guitars crowding bass.";

// 15: George Lever (Loathe - I Let It In And It Took Everything)
dk_tip[60] = "Gritty industrial-shoegaze blend: Triode tube crucible pushed for dirty warmth.";
dk_tip[61] = "Loose 2:1 compression with 600ms release breathes musically with the song.";
dk_tip[62] = "Breakdown desk lift adds lush analog saturation during intimate interludes.";
dk_tip[63] = "SUB-BUS RULE: Wide stereo imaging (1.15x) immerses the listener in atmosphere.";

// 16: Sam Bassal (Thornhill - The Dark Pool)
dk_tip[64] = "Silky cinematic metalcore: pristine 8kHz air sheen (+3.2dB) with 1.14x width.";
dk_tip[65] = "Smooth Studer tape compression delivers punchy, polished radio-ready glue.";
dk_tip[66] = "Pre-drop tape choke builds immense tension before explosive chorus hits.";
dk_tip[67] = "SUB-BUS RULE: Dynamic vocal pocket notch ensures falsetto vocals stay upfront.";

// 17: Henrik Udd (Architects - Holy Hell)
dk_tip[68] = "Massive European arena punch: SSL VCA 4:1 with 10ms attack & 300ms release.";
dk_tip[69] = "38Hz sub-cut & +3.2dB 80Hz shelf deliver signature wall-shaking kick punch.";
dk_tip[70] = "Ground-slam sub pulse & pre-drop choke create dramatic architectural tension.";
dk_tip[71] = "SUB-BUS RULE: Headroom trim -0.8dB maintains punch without digital clipping.";

// 18: Dan Braunstein (Spiritbox - Eternal Blue)
dk_tip[72] = "Hyper-modern polished production: transparent VCA glue with 10ms musical attack.";
dk_tip[73] = "Crystalline 8.0kHz sheen (+2.8dB) and 3.0kHz pick bite (+2.5dB) for modern clarity.";
dk_tip[74] = "Chorus stereo bloom expands guitars to 1.15x width during anthemic hooks.";
dk_tip[75] = "SUB-BUS RULE: Sub-bass mono anchor locked at 80Hz; clean Neve desk drive 3.0dB.";

// 19: Zakk Cervini & Erik Ron (Bad Omens - TDOPOM)
dk_tip[76] = "Pop-metal hybrid perfection: smooth VCA glue with seamless chorus expansion.";
dk_tip[77] = "Warm Studer tape drive with silky high-shelf sheen (+3.4dB @ 8kHz).";
dk_tip[78] = "Air sheen bloom & chorus bloom trigger simultaneously on explosive choruses.";
dk_tip[79] = "SUB-BUS RULE: Vocal pocket dynamic notch carves 1.4dB for lead vocal dominance.";

// 20: Jens Bogren (Fascination Street Studios)
dk_tip[80] = "Legendary European metal authority: Neve 8014 console saturation with iron depth.";
dk_tip[81] = "Surgical 202Hz mud scoop (-3.5dB) paired with authoritative 80Hz punch (+3.0dB).";
dk_tip[82] = "Classic 4:1 VCA bus glue with 600ms release for timeless cohesive record glue.";
dk_tip[83] = "SUB-BUS RULE: Headroom strictly guarded; sub-bass anchored at 80Hz mono.";

// 21: Adam Nolly Getgood (Periphery / GGD Target)
dk_tip[84] = "Signature 39Hz sidechain HPF allows snare crack to cut through with 4:1 ratio!";
dk_tip[85] = "10ms attack preserves explosive drum punch before smooth gain reduction grabs.";
dk_tip[86] = "Punchy 3.0kHz bite (+3.2dB) and clean 80Hz shelf (+3.0dB) for modern metal focus.";
dk_tip[87] = "SUB-BUS RULE: Neve iron console drive (3.2dB); snare transient priority.";

// 22: Acle Kahney (TesseracT)
dk_tip[88] = "Pioneering Djent transparency: surgical frequency carving and wide 1.18x imaging.";
dk_tip[89] = "Gentle 2:1 VCA glue with 15ms attack preserves complex polymetric syncopation.";
dk_tip[90] = "Haas wall widener on ambient layers creates cavernous atmospheric depth.";
dk_tip[91] = "SUB-BUS RULE: Mud scoop at 202Hz (-3.2dB) leaves acoustic space for bass clank.";

// 23: Adam Cichocki (heaving.)
dk_tip[92] = "Raw emotive post-hardcore: gritty tube saturation with dynamic 4:1 bus glue.";
dk_tip[93] = "80Hz mono anchor preserves kick foundation while guitars spread wide (1.12x).";
dk_tip[94] = "Breakdown desk lift adds warm tape saturation during quiet guitar arpeggios.";
dk_tip[95] = "SUB-BUS RULE: Snare sidechain snap keeps the rhythm pulse driving through walls.";

// 24: Manuel Renner (SENNA - Out Of The Blue)
dk_tip[96] = "Hyper-modern German metalcore: razor-sharp 3.0kHz pick bite (+3.5dB) and 1.20x width.";
dk_tip[97] = "Fast 100ms VCA release snaps fast technical riffs right in the listener's face.";
dk_tip[98] = "Chorus stereo bloom & sub-drop slam elevate every hook to massive arena scale.";
dk_tip[99] = "SUB-BUS RULE: Vocal pocket notch depth 1.1dB protects soaring pop-core vocals.";

// Director real-time tracking variables
dk_fast_db = -90.0;
dk_slow_db = -90.0;
dk_song_db = -90.0;
dk_rg_db   = -90.0;
dk_dens    = 0.5;
dk_ctx     = 0.5;
dk_seen    = 0;
dk_act_t   = 0.0;
dk_gap_t   = 0.0;

// Dynamic Trick Envelopes (0 to 7)
dk_env0 = 0.0; dk_env1 = 0.0; dk_env2 = 0.0; dk_env3 = 0.0;
dk_env4 = 0.0; dk_env5 = 0.0; dk_env6 = 0.0; dk_env7 = 0.0;

// Playbook display index
dg_pbi = 6; // Defaults to Kel Pinchin (Split Chain)
dg_last_prod = 6;

function clamp(x, lo, hi) (
  max(lo, min(hi, x));
);

function fast_shape(x) (
  x / (1.0 + abs(x));
);

function update_filters() local(w0, alpha, cos_w0, sin_w0, A, beta, drv_k) (
  srate <= 0 ? srate = 44100;

  // 1. HPF Sub-Cut Filter (slider18) - 18dB/oct Butterworth curve
  w0 = 2.0 * M_PI * clamp(slider18, 20.0, 100.0) / srate;
  alpha = sin(w0) / (2.0 * 0.7071);
  hpf_b0 = (1.0 + cos(w0)) * 0.5;
  hpf_b1 = -(1.0 + cos(w0));
  hpf_b2 = (1.0 + cos(w0)) * 0.5;
  hpf_a0 = 1.0 + alpha;
  hpf_a1 = -2.0 * cos(w0);
  hpf_a2 = 1.0 - alpha;

  // 2. 80Hz Punch Low Shelf (slider19) - Matches ReEQ Band 2
  A = exp(slider19 * 0.0575646273);
  w0 = 2.0 * M_PI * 80.0 / srate;
  cos_w0 = cos(w0); sin_w0 = sin(w0);
  alpha = sin_w0 / (2.0 * 0.7071);
  beta = 2.0 * sqrt(A) * alpha;
  p80_b0 = A * ((A + 1.0) - (A - 1.0) * cos_w0 + beta);
  p80_b1 = 2.0 * A * ((A - 1.0) - (A + 1.0) * cos_w0);
  p80_b2 = A * ((A + 1.0) - (A - 1.0) * cos_w0 - beta);
  p80_a0 = (A + 1.0) + (A - 1.0) * cos_w0 + beta;
  p80_a1 = -2.0 * ((A - 1.0) + (A + 1.0) * cos_w0);
  p80_a2 = (A + 1.0) - (A - 1.0) * cos_w0 - beta;

  // 2b. 90Hz Glue Body Bell (+0.25 dB, Q=1.0)
  A_b90 = exp(0.25 * 0.0575646273);
  w0_b90 = 2.0 * M_PI * 90.0 / srate;
  alpha_b90 = sin(w0_b90) / (2.0 * 1.0);
  b90_b0 = 1.0 + alpha_b90 * A_b90;
  b90_b1 = -2.0 * cos(w0_b90);
  b90_b2 = 1.0 - alpha_b90 * A_b90;
  b90_a0 = 1.0 + alpha_b90 / A_b90;
  b90_a1 = -2.0 * cos(w0_b90);
  b90_a2 = 1.0 - alpha_b90 / A_b90;

  // 3. 202Hz Mud Scoop (slider20) - Matches ReEQ Band 4
  A = exp(slider20 * 0.0575646273);
  w0 = 2.0 * M_PI * 202.0 / srate;
  alpha = sin(w0) / (2.0 * 1.2);
  s200_b0 = 1.0 + alpha * A;
  s200_b1 = -2.0 * cos(w0);
  s200_b2 = 1.0 - alpha * A;
  s200_a0 = 1.0 + alpha / A;
  s200_a1 = -2.0 * cos(w0);
  s200_a2 = 1.0 - alpha / A;

  // 4. 1.5kHz Mid Body (slider21) - Matches ReEQ Band 5
  A = exp(slider21 * 0.0575646273);
  w0 = 2.0 * M_PI * 1500.0 / srate;
  alpha = sin(w0) / (2.0 * 1.5);
  b15_b0 = 1.0 + alpha * A;
  b15_b1 = -2.0 * cos(w0);
  b15_b2 = 1.0 - alpha * A;
  b15_a0 = 1.0 + alpha / A;
  b15_a1 = -2.0 * cos(w0);
  b15_a2 = 1.0 - alpha / A;

  // 5. 3.0kHz Pick Attack Bite (slider22) - Matches ReEQ Band 6
  A = exp(slider22 * 0.0575646273);
  w0 = 2.0 * M_PI * 3000.0 / srate;
  alpha = sin(w0) / (2.0 * 1.8);
  b3k_b0 = 1.0 + alpha * A;
  b3k_b1 = -2.0 * cos(w0);
  b3k_b2 = 1.0 - alpha * A;
  b3k_a0 = 1.0 + alpha / A;
  b3k_a1 = -2.0 * cos(w0);
  b3k_a2 = 1.0 - alpha / A;

  // 6. 8.0kHz Air Sheen High Shelf (slider31) - Matches ReEQ Band 7
  A = exp(slider31 * 0.0575646273);
  w0 = 2.0 * M_PI * 8000.0 / srate;
  cos_w0 = cos(w0); sin_w0 = sin(w0);
  alpha = sin_w0 / (2.0 * 0.7071);
  beta = 2.0 * sqrt(A) * alpha;
  s8k_b0 = A * ((A + 1.0) + (A - 1.0) * cos_w0 + beta);
  s8k_b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * cos_w0);
  s8k_b2 = A * ((A + 1.0) - (A - 1.0) * cos_w0 - beta);
  s8k_a0 = (A + 1.0) - (A - 1.0) * cos_w0 + beta;
  s8k_a1 = 2.0 * ((A - 1.0) - (A + 1.0) * cos_w0);
  s8k_a2 = (A + 1.0) - (A - 1.0) * cos_w0 - beta;

  // 7. Elliptic Sub-Mono Side Highpass (Butterworth 2nd order at slider6 Hz)
  sm_w0 = 2.0 * M_PI * clamp(slider6, 40.0, 160.0) / srate;
  sm_cos = cos(sm_w0); sm_sin = sin(sm_w0);
  sm_alpha = sm_sin / (2.0 * 0.7071);
  sm_b0 = (1.0 + sm_cos) * 0.5;
  sm_b1 = -(1.0 + sm_cos);
  sm_b2 = (1.0 + sm_cos) * 0.5;
  sm_a0 = 1.0 + sm_alpha;
  sm_a1 = -2.0 * sm_cos;
  sm_a2 = 1.0 - sm_alpha;

  // 8. Bus Glue Sidechain Detector HPF (slider16 - Unconditionally Stable 1st-Order at 39/60/85 Hz)
  sc_alpha = exp(-2.0 * M_PI * clamp(slider16, 20.0, 250.0) / srate);
);

function apply_producer_preset(idx) (
  idx == 0 ? ( // Unity Baseline (1:1 Transparent Pass)
    slider3 = 0.0; slider4 = 0.0; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 0.0; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -12.0;
    slider13 = 1; slider14 = 30.0; slider15 = 2; slider16 = 39; slider17 = 100;
    slider18 = 30; slider19 = 0.0; slider20 = 0.0; slider21 = 0.0; slider22 = 0.0;
    slider23 = 0; slider24 = 0.0; slider25 = 1.00; slider31 = 0.0;
  ) : idx == 6 ? ( // Kel Pinchin (Split Chain Target) - Forensic Replicate of Track 15 Legacy Chain
    slider3 = 0.0;
    slider4 = -1.8;   // Net Headroom calibrated for exact legacy chain mix balance!
    slider5 = 0;      // Free Output Crest
    slider6 = 80;     // Sub-Bass Mono Anchor Cutoff (matches Bass Manager 80 Hz)
    slider7 = 1;      // Transient Sentry Active
    slider8 = 0.8;    // Dynamic Vocal Pocket depth
    slider9 = 1;      // gmem Auto-Sensing Corridor
    slider10 = 1;     // Bus Glue Engaged
    slider11 = 0;     // British VCA Punch (SSL 4000G / BUSTERse)
    slider12 = -9.0; // Threshold calibrated for authentic 1.2-1.8 dB musical glue!
    slider13 = 2;     // 4:1 Modern Punch (matches BUSTERse 4:1)
    slider14 = 10.0;  // Attack 10 ms (matches BUSTERse 10 ms)
    slider15 = 2;     // Release 600 ms (matches BUSTERse .6 sec)
    slider16 = 39;    // Sidechain Detector HPF = 39 Hz (Authentic BUSTERse & Nolly trick!)
    slider17 = 100;   // 100% Dry/Wet
    slider18 = 38;    // HPF Cutoff 38 Hz (matches Bass Manager 30Hz & ReEQ 40Hz)
    slider19 = 3.0;   // 80Hz Punch +3.0 dB Low Shelf (matches ReEQ Band 2)
    slider20 = -3.0;  // 202Hz Mud Scoop -3.0 dB, Q=1.2 (matches ReEQ Band 4)
    slider21 = 1.5;   // 1.5kHz Mid Body +1.5 dB, Q=1.5 (matches ReEQ Band 5)
    slider22 = 3.0;   // 3.0kHz Bite +3.0 dB, Q=1.8 (matches ReEQ Band 6)
    slider23 = 1;     // Neve 8014 Iron Desk (matches Britson Buss Vintage Summing!)
    slider24 = 2.8;   // Console Desk Drive 2.8 dB (rich harmonic analog warmth)
    slider25 = 1.08;  // Quad Imager Width 1.08x
    slider31 = 3.0;   // 8.0kHz Sheen +3.0 dB (matches ReEQ Band 7)
  ) : idx == 9 ? ( // Sam Guaiana (Silverstein - Misery Made Me)
    slider3 = 0.0; slider4 = -1.2; slider5 = 0; slider6 = 75; slider7 = 1;
    slider8 = 0.9; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -14.0;
    slider13 = 2; slider14 = 30.0; slider15 = 1; slider16 = 60; // 60Hz HPF kick/bass management trick!
    slider17 = 100; slider18 = 35; slider19 = 2.8; slider20 = -2.8; slider21 = 1.2; slider22 = 2.8;
    slider23 = 1; slider24 = 3.0; slider25 = 1.12; slider31 = 2.8;
  ) : idx == 21 ? ( // Adam Nolly Getgood (Periphery / GGD Modern Metal Target)
    slider3 = 0.0; slider4 = -1.5; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 1.0; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -15.0;
    slider13 = 2; slider14 = 10.0; slider15 = 2; slider16 = 39; // 39Hz HPF snare cut-through trick!
    slider17 = 100; slider18 = 35; slider19 = 3.0; slider20 = -3.2; slider21 = 1.2; slider22 = 3.2;
    slider23 = 1; slider24 = 3.2; slider25 = 1.15; slider31 = 3.0;
  ) : idx == 1 ? ( // Lance Prenc (Alpha Wolf - 60cm Of Steel)
    slider3 = 0.0; slider4 = -1.2; slider5 = 0; slider6 = 85; slider7 = 1;
    slider8 = 1.2; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -15.5;
    slider13 = 2; slider14 = 10.0; slider15 = 0; slider16 = 45; slider17 = 100;
    slider18 = 35; slider19 = 2.0; slider20 = -3.5; slider21 = 1.2; slider22 = 3.5;
    slider23 = 1; slider24 = 3.8; slider25 = 1.15; slider31 = 3.2;
  ) : idx == 2 ? ( // Scott Seigel (DIESECT - TOO MANY SCARS)
    slider3 = 0.0; slider4 = -1.0; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 1.0; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -14.0;
    slider13 = 2; slider14 = 10.0; slider15 = 1; slider16 = 50; slider17 = 100;
    slider18 = 32; slider19 = 3.5; slider20 = -3.2; slider21 = 0.8; slider22 = 3.0;
    slider23 = 1; slider24 = 3.2; slider25 = 1.12; slider31 = 2.5;
  ) : idx == 3 ? ( // Jonathan Dolese (Mirrorcell - U(phoria))
    slider3 = 0.0; slider4 = -1.2; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 0.9; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -13.5;
    slider13 = 1; slider14 = 10.0; slider15 = 2; slider16 = 55; slider17 = 100;
    slider18 = 35; slider19 = 2.5; slider20 = -2.8; slider21 = 1.5; slider22 = 2.8;
    slider23 = 2; slider24 = 2.6; slider25 = 1.10; slider31 = 3.2;
  ) : idx == 4 ? ( // Buster Odeholm (thrown / Northlane - Evian)
    slider3 = 0.0; slider4 = -1.4; slider5 = 0; slider6 = 90; slider7 = 1;
    slider8 = 1.4; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -16.0;
    slider13 = 3; slider14 = 10.0; slider15 = 0; slider16 = 60; slider17 = 100;
    slider18 = 40; slider19 = 3.2; slider20 = -4.0; slider21 = 0.5; slider22 = 4.0;
    slider23 = 1; slider24 = 4.0; slider25 = 1.25; slider31 = 3.5;
  ) : idx == 5 ? ( // Lewis Johns (Love Is Noise / blanket - Blur)
    slider3 = 0.0; slider4 = -0.9; slider5 = 0; slider6 = 75; slider7 = 1;
    slider8 = 0.7; slider9 = 1; slider10 = 1; slider11 = 1; slider12 = -13.0;
    slider13 = 1; slider14 = 25.0; slider15 = 2; slider16 = 45; slider17 = 100;
    slider18 = 30; slider19 = 2.0; slider20 = -2.2; slider21 = 1.8; slider22 = 2.0;
    slider23 = 2; slider24 = 2.4; slider25 = 1.05; slider31 = 2.6;
  ) : idx == 14 ? ( // Will Putney (Fit For An Autopsy - Walk With Me In Hell)
    slider3 = 0.0; slider4 = -1.4; slider5 = 0; slider6 = 85; slider7 = 1;
    slider8 = 1.2; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -15.5;
    slider13 = 2; slider14 = 10.0; slider15 = 1; slider16 = 50; slider17 = 100;
    slider18 = 38; slider19 = 3.5; slider20 = -3.8; slider21 = 1.2; slider22 = 3.5;
    slider23 = 1; slider24 = 3.8; slider25 = 1.15; slider31 = 3.0;
  ) : idx == 15 ? ( // George Lever (Loathe - Agressive Evolution / Sleep Token)
    slider3 = 0.0; slider4 = -1.1; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 0.8; slider9 = 1; slider10 = 1; slider11 = 1; slider12 = -13.5;
    slider13 = 1; slider14 = 20.0; slider15 = 2; slider16 = 45; slider17 = 100;
    slider18 = 32; slider19 = 3.2; slider20 = -2.8; slider21 = 1.4; slider22 = 2.6;
    slider23 = 3; slider24 = 2.8; slider25 = 1.12; slider31 = 3.2;
  ) : idx == 17 ? ( // Henrik Udd (Architects - Gravity)
    slider3 = 0.0; slider4 = -1.3; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 1.0; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -14.8;
    slider13 = 2; slider14 = 10.0; slider15 = 1; slider16 = 40; slider17 = 100;
    slider18 = 38; slider19 = 3.2; slider20 = -3.0; slider21 = 1.2; slider22 = 3.0;
    slider23 = 1; slider24 = 3.2; slider25 = 1.15; slider31 = 3.2;
  ) : idx == 18 ? ( // Dan Braunstein (Spiritbox - Keep Sweet)
    slider3 = 0.0; slider4 = -1.2; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 1.0; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -14.2;
    slider13 = 2; slider14 = 10.0; slider15 = 2; slider16 = 42; slider17 = 100;
    slider18 = 32; slider19 = 2.5; slider20 = -2.5; slider21 = 1.0; slider22 = 2.5;
    slider23 = 1; slider24 = 3.0; slider25 = 1.10; slider31 = 2.8;
  ) : idx == 19 ? ( // Zakk Cervini & Erik Ron (Bad Omens - TDOPOM)
    slider3 = 0.0; slider4 = -1.3; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 1.2; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -14.5;
    slider13 = 2; slider14 = 10.0; slider15 = 1; slider16 = 45; slider17 = 100;
    slider18 = 35; slider19 = 2.8; slider20 = -2.8; slider21 = 1.0; slider22 = 2.8;
    slider23 = 2; slider24 = 3.2; slider25 = 1.18; slider31 = 3.4;
  ) : ( // Modern Metal Standard Baseline
    slider3 = 0.0; slider4 = -1.2; slider5 = 0; slider6 = 80; slider7 = 1;
    slider8 = 1.0; slider9 = 1; slider10 = 1; slider11 = 0; slider12 = -14.0;
    slider13 = 2; slider14 = 10.0; slider15 = 2; slider16 = 40; slider17 = 100;
    slider18 = 35; slider19 = 2.6; slider20 = -2.8; slider21 = 1.2; slider22 = 2.8;
    slider23 = 1; slider24 = 2.8; slider25 = 1.10; slider31 = 2.8;
  );
  slider51 ? dg_pbi = idx;
  update_filters();
  slider_automate();
);

function trigger_ai_assist() local(delta_trim) (
  inst_peak > 0.001 ? (
    // Safe auto-calibrate: adjusts trim within strictly +-0.5dB safe boundary
    delta_trim = clamp(-2.8 - (20.0 * log10(inst_peak)), -0.5, 0.5);
    slider4 = clamp(slider4 + delta_trim, -2.5, 1.0);
  );
  inst_rms > -40.0 ? (
    slider12 = clamp(inst_rms + 2.5, -20.0, -8.0);
  );
  update_filters();
  slider_automate();
);

update_filters();
apply_producer_preset(slider2);

@slider
prev_preset != slider2 ? (
  apply_producer_preset(slider2);
  prev_preset = slider2;
);
slider32 == 2 ? (
  trigger_ai_assist();
  slider32 = 1;
);
update_filters();

@sample
srate <= 0 ? srate = 44100;
dry_l = spl0; dry_r = spl1;

// Ballistics & RMS smooth (300ms window)
vu_omega = 1.0 - exp(-1.0 / (srate * 0.300));
vu_sig_sq = (dry_l * dry_l + dry_r * dry_r) * 0.5;
vu_rms_smooth += (vu_sig_sq - vu_rms_smooth) * vu_omega;
(vu_rms_smooth != vu_rms_smooth || vu_rms_smooth <= 0.000000001) ? (
  inst_rms = -90.0;
) : (
  inst_rms = 10.0 * log10(vu_rms_smooth);
);
inst_peak = max(abs(dry_l), abs(dry_r));

// Correlation calculation
corr_dot = dry_l * dry_r;
corr_mag = sqrt((dry_l * dry_l + 0.000001) * (dry_r * dry_r + 0.000001));
corr_inst = corr_dot / corr_mag;
corr_smooth += (corr_inst - corr_smooth) * 0.02;

// Vectorscope history circular buffers
scope_pos = (scope_pos + 1) % 256;
scope_buf_l[scope_pos] = dry_l;
scope_buf_r[scope_pos] = dry_r;

// Update 64-band log-spaced energy tracker for real-time FFT spectrum display
spec_idx = floor(abs(dry_l + dry_r) * 128.0) % 64;
spec_bins[spec_idx] = max(spec_bins[spec_idx], abs(dry_l) + abs(dry_r));

// =============================================================================
// REAL-TIME EAR-CANDY DIRECTOR & SECTION DETECTION
// =============================================================================
// Detect region from gmem or timeline
dk_sec = (gmem[100] == 1) ? gmem[101] : 0;
// Map region to standard index: 1:Intro, 2:Verse, 3:Pre-Chorus, 4:Chorus, 5:Bridge, 6:Outro
dk_r_idx = dk_sec == 1 ? 3 : (dk_sec == 2 ? 3 : (dk_sec == 3 ? 4 : (dk_sec == 4 ? 5 : (dk_sec == 5 ? 2 : 0))));

// Bus energy tracking
dk_fast_db += (inst_rms - dk_fast_db) * 0.05;
dk_slow_db += (inst_rms - dk_slow_db) * 0.002;
dk_song_db += (inst_rms - dk_song_db) * 0.0004;

dk_dens = clamp((dk_fast_db - dk_slow_db + 10.0) / 20.0, 0.1, 1.0);
dk_ctx = dk_r_idx == 4 ? 1.15 : (dk_r_idx == 3 ? 0.90 : (dk_r_idx == 5 ? 0.85 : 1.00));

// Dynamic trick activation envelopes (controlled by Director or manual sliders)
dk_amt = slider49 * 0.01;
dk_auto = (slider48 == 1 && slider37 == 1);

// Trick 0: Chorus Stereo Bloom
dk_trg0 = (dk_auto && dk_r_idx == 4) || slider33;
dk_env0 += ((dk_trg0 ? 1.0 : 0.0) - dk_env0) * 0.008;

// Trick 1: Pre-Drop Tape Choke
dk_trg1 = (dk_auto && dk_r_idx == 3 && dk_fast_db > -18.0) || slider34;
dk_env1 += ((dk_trg1 ? 1.0 : 0.0) - dk_env1) * 0.015;

// Trick 2: Sub-Drop Ground-Slam
dk_trg2 = (dk_auto && dk_r_idx == 4 && inst_peak > 0.42) || slider35;
dk_env2 += ((dk_trg2 ? 1.0 : 0.0) - dk_env2) * 0.020;

// Trick 3: Breakdown Desk Lift
dk_trg3 = (dk_auto && (dk_r_idx == 2 || dk_r_idx == 5) && dk_fast_db < -20.0) || slider36;
dk_env3 += ((dk_trg3 ? 1.0 : 0.0) - dk_env3) * 0.005;

// Trick 4: Snare Sidechain Snap
dk_trg4 = (slider16 <= 42);
dk_env4 += ((dk_trg4 ? 1.0 : 0.0) - dk_env4) * 0.050;

// Trick 5: Air Sheen Bloom
dk_trg5 = (dk_auto && dk_r_idx == 4);
dk_env5 += ((dk_trg5 ? 1.0 : 0.0) - dk_env5) * 0.008;

// Trick 6: Kick Decoupling Anchor
dk_trg6 = (slider16 >= 55);
dk_env6 += ((dk_trg6 ? 1.0 : 0.0) - dk_env6) * 0.050;

// Trick 7: Haas Wall Widener
dk_trg7 = (dk_auto && dk_r_idx == 5);
dk_env7 += ((dk_trg7 ? 1.0 : 0.0) - dk_env7) * 0.010;

// 1:1 Complete Bit-Exact Transparent Pass if Suite Bypassed OR Preset 00
(slider27 == 0 || slider2 == 0) ? (
  spl0 = dry_l; spl1 = dry_r;
) : (
  // 1. Input Gain Calibration
  in_gain = exp(slider3 * 0.1151292546);
  in_l = dry_l * in_gain;
  in_r = dry_r * in_gain;

  // 2. 7-Band Tonal Forge Equalizer (REAPER-Native ReEQ Alignment)
  // Band 1: HPF Sub-Cut (slider18)
  y_l = (hpf_b0 * in_l + hpf_b1 * hpf_x1_l + hpf_b2 * hpf_x2_l - hpf_a1 * hpf_y1_l - hpf_a2 * hpf_y2_l) / hpf_a0;
  hpf_x2_l = hpf_x1_l; hpf_x1_l = in_l; hpf_y2_l = hpf_y1_l; hpf_y1_l = y_l;
  y_r = (hpf_b0 * in_r + hpf_b1 * hpf_x1_r + hpf_b2 * hpf_x2_r - hpf_a1 * hpf_y1_r - hpf_a2 * hpf_y2_r) / hpf_a0;
  hpf_x2_r = hpf_x1_r; hpf_x1_r = in_r; hpf_y2_r = hpf_y1_r; hpf_y1_r = y_r;

  // Band 2: 80Hz Punch Low Shelf (slider19)
  s_l = (p80_b0 * y_l + p80_b1 * p80_x1_l + p80_b2 * p80_x2_l - p80_a1 * p80_y1_l - p80_a2 * p80_y2_l) / p80_a0;
  p80_x2_l = p80_x1_l; p80_x1_l = y_l; p80_y2_l = p80_y1_l; p80_y1_l = s_l;
  s_r = (p80_b0 * y_r + p80_b1 * p80_x1_r + p80_b2 * p80_x2_r - p80_a1 * p80_y1_r - p80_a2 * p80_y2_r) / p80_a0;
  p80_x2_r = p80_x1_r; p80_x1_r = y_r; p80_y2_r = p80_y1_r; p80_y1_r = s_r;

  // Band 2b: 90Hz Body Glue Bell (+0.25 dB)
  b90_l = (b90_b0 * s_l + b90_b1 * b90_x1_l + b90_b2 * b90_x2_l - b90_a1 * b90_y1_l - b90_a2 * b90_y2_l) / b90_a0;
  b90_x2_l = b90_x1_l; b90_x1_l = s_l; b90_y2_l = b90_y1_l; b90_y1_l = b90_l;
  b90_r = (b90_b0 * s_r + b90_b1 * b90_x1_r + b90_b2 * b90_x2_r - b90_a1 * b90_y1_r - b90_a2 * b90_y2_r) / b90_a0;
  b90_x2_r = b90_x1_r; b90_x1_r = s_r; b90_y2_r = b90_y1_r; b90_y1_r = b90_r;

  // Liteon Bass Manager 25% Drive Rational Waveshaper
  drv_k = 0.223;
  ws_l = (1.0 + drv_k) * b90_l / (1.0 + drv_k * abs(b90_l));
  ws_r = (1.0 + drv_k) * b90_r / (1.0 + drv_k * abs(b90_r));

  // Band 3: 202Hz Mud Scoop (slider20)
  m_l = (s200_b0 * ws_l + s200_b1 * s200_x1_l + s200_b2 * s200_x2_l - s200_a1 * s200_y1_l - s200_a2 * s200_y2_l) / s200_a0;
  s200_x2_l = s200_x1_l; s200_x1_l = ws_l; s200_y2_l = s200_y1_l; s200_y1_l = m_l;
  m_r = (s200_b0 * ws_r + s200_b1 * s200_x1_r + s200_b2 * s200_x2_r - s200_a1 * s200_y1_r - s200_a2 * s200_y2_r) / s200_a0;
  s200_x2_r = s200_x1_r; s200_x1_r = ws_r; s200_y2_r = s200_y1_r; s200_y1_r = m_r;

  // Band 4: 1.5kHz Mid Body (slider21)
  b_l = (b15_b0 * m_l + b15_b1 * b15_x1_l + b15_b2 * b15_x2_l - b15_a1 * b15_y1_l - b15_a2 * b15_y2_l) / b15_a0;
  b15_x2_l = b15_x1_l; b15_x1_l = m_l; b15_y2_l = b15_y1_l; b15_y1_l = b_l;
  b_r = (b15_b0 * m_r + b15_b1 * b15_x1_r + b15_b2 * b15_x2_r - b15_a1 * b15_y1_r - b15_a2 * b15_y2_r) / b15_a0;
  b15_x2_r = b15_x1_r; b15_x1_r = m_r; b15_y2_r = b15_y1_r; b15_y1_r = b_r;

  // Band 5: 3.0kHz Pick Attack Bite (slider22)
  k_l = (b3k_b0 * b_l + b3k_b1 * b3k_x1_l + b3k_b2 * b3k_x2_l - b3k_a1 * b3k_y1_l - b3k_a2 * b3k_y2_l) / b3k_a0;
  b3k_x2_l = b3k_x1_l; b3k_x1_l = b_l; b3k_y2_l = b3k_y1_l; b3k_y1_l = k_l;
  k_r = (b3k_b0 * b_r + b3k_b1 * b3k_x1_r + b3k_b2 * b3k_x2_r - b3k_a1 * b3k_y1_r - b3k_a2 * b3k_y2_r) / b3k_a0;
  b3k_x2_r = b3k_x1_r; b3k_x1_r = b_r; b3k_y2_r = b3k_y1_r; b3k_y1_r = k_r;

  // Band 6: 8.0kHz Air Sheen High Shelf (Precomputed ReEQ alignment)
  eq_out_l = (s8k_b0 * k_l + s8k_b1 * s8k_x1_l + s8k_b2 * s8k_x2_l - s8k_a1 * s8k_y1_l - s8k_a2 * s8k_y2_l) / s8k_a0;
  s8k_x2_l = s8k_x1_l; s8k_x1_l = k_l; s8k_y2_l = s8k_y1_l; s8k_y1_l = eq_out_l;
  eq_out_r = (s8k_b0 * k_r + s8k_b1 * s8k_x1_r + s8k_b2 * s8k_x2_r - s8k_a1 * s8k_y1_r - s8k_a2 * s8k_y2_r) / s8k_a0;
  s8k_x2_r = s8k_x1_r; s8k_x1_r = k_r; s8k_y2_r = s8k_y1_r; s8k_y1_r = eq_out_r;

  // Trick 5: Air Sheen Bloom (+12% high-end lift on soaring peaks)
  dk_env5 > 0.01 ? (
    sheen_factor = 1.0 + (dk_env5 * dk_amt * 0.12);
    eq_out_l *= sheen_factor; eq_out_r *= sheen_factor;
  );

  // 3. Dynamic Vocal Pocket Corridor (Formant Dynamic Notch @ 2.2 kHz)
  vox_level = gmem[1452];
  vox_level > -50.0 ? (
    pocket_dyn_dip = slider8 * min(1.0, max(0.0, (vox_level + 40.0) / 25.0));
  ) : (
    pocket_dyn_dip = slider8 * 0.2;
  );
  pocket_depth = pocket_dyn_dip;

  // Notch at 2.2 kHz
  np_A = exp(-pocket_dyn_dip * 0.0575646273);
  np_w0 = 2.0 * M_PI * 2200.0 / srate;
  np_alpha = sin(np_w0) / (2.0 * 2.0);
  np_b0 = 1.0 + np_alpha * np_A;
  np_b1 = -2.0 * cos(np_w0);
  np_b2 = 1.0 - np_alpha * np_A;
  np_a0 = 1.0 + np_alpha / np_A;
  np_a1 = -2.0 * cos(np_w0);
  np_a2 = 1.0 - np_alpha / np_A;

  pock_l = (np_b0 * eq_out_l + np_b1 * np_x1_l + np_b2 * np_x2_l - np_a1 * np_y1_l - np_a2 * np_y2_l) / np_a0;
  np_x2_l = np_x1_l; np_x1_l = eq_out_l; np_y2_l = np_y1_l; np_y1_l = pock_l;
  pock_r = (np_b0 * eq_out_r + np_b1 * np_x1_r + np_b2 * np_x2_r - np_a1 * np_y1_r - np_a2 * np_y2_r) / np_a0;
  np_x2_r = np_x1_r; np_x1_r = eq_out_r; np_y2_r = np_y1_r; np_y1_r = pock_r;

  // 4. Harmonic Crucible Saturation Engine (Neve / Tape / Triode)
  // Trick 3: Breakdown Desk Lift (+1.8 dB desk drive during quiet sections)
  active_drive = slider24 + (dk_env3 * dk_amt * 1.8);
  sat_drive = exp(active_drive * 0.1151292546);

  slider23 == 1 ? ( // Neve 8014 Iron Desk (Even/Odd Console Saturation - Bounded)
    sat_l = fast_shape(pock_l * sat_drive);
    sat_r = fast_shape(pock_r * sat_drive);
    sat_out_l = (sat_l - 0.08 * sat_l * abs(sat_l)) / sat_drive;
    sat_out_r = (sat_r - 0.08 * sat_r * abs(sat_r)) / sat_drive;
  ) : slider23 == 2 ? ( // Studer A800 Tape Saturation
    sat_out_l = fast_shape(pock_l * sat_drive) / sat_drive;
    sat_out_r = fast_shape(pock_r * sat_drive) / sat_drive;
  ) : slider23 == 3 ? ( // Triode Tube Crucible
    sat_l = fast_shape(pock_l * sat_drive);
    sat_r = fast_shape(pock_r * sat_drive);
    sat_out_l = (sat_l / (1.0 + 0.4 * abs(sat_l))) / sat_drive;
    sat_out_r = (sat_r / (1.0 + 0.4 * abs(sat_r))) / sat_drive;
  ) : (
    sat_out_l = pock_l; sat_out_r = pock_r;
  );

  // 5. Studio Bus Glue Compressor (British VCA Pure Musical Action)
  slider10 ? (
    sc_in = (sat_out_l + sat_out_r) * 0.5;
    // Unconditionally Stable Sidechain Detector HPF (39Hz Nolly/Pinchin, 60Hz Sam Guaiana)
    sc_det = sc_alpha * (sc_det + sc_in - sc_prev_in);
    sc_prev_in = sc_in;

    sc_peak = abs(sc_det);
    sc_db = sc_peak > 0.000000001 ? 20.0 * log10(sc_peak) : -120.0;

    // PURE MUSICAL VCA BALLISTICS (10ms attack allows drum punch to pass through)
    atk_time = max(0.001, slider14 * 0.001);
    atk_coeff = exp(-1.0 / (srate * atk_time));
    rel_time = slider15 == 0 ? 0.100 : (slider15 == 1 ? 0.300 : (slider15 == 2 ? 0.600 : (slider15 == 3 ? 1.200 : 0.450)));
    rel_coeff = exp(-1.0 / (srate * rel_time));

    sc_db > comp_env ? (
      comp_env = sc_db + (comp_env - sc_db) * atk_coeff;
    ) : (
      comp_env = sc_db + (comp_env - sc_db) * rel_coeff;
    );

    ratio_val = slider13 == 0 ? 1.5 : (slider13 == 1 ? 2.0 : (slider13 == 2 ? 4.0 : 8.0));

    // Smooth C1 Continuous Soft-Knee Compression Transfer Curve
    knee = 4.0;
    half_knee = knee * 0.5;
    diff = comp_env - slider12;
    diff < -half_knee ? (
      glue_gr_db = 0.0;
    ) : diff < half_knee ? (
      glue_gr_db = (sqr(diff + half_knee) / (2.0 * knee)) * (1.0 - 1.0 / ratio_val);
    ) : (
      glue_gr_db = diff * (1.0 - 1.0 / ratio_val);
    );

    // Write to rolling history buffer every 64 samples
    (scope_pos % 64 == 0) ? (
      gr_hist[gr_hist_pos] = glue_gr_db;
      gr_hist_pos = (gr_hist_pos + 1) % 128;
    );

    glue_gain = exp(-glue_gr_db * 0.1151292546);
    mix_frac = slider17 * 0.01;
    comp_l = sat_out_l * glue_gain * mix_frac + sat_out_l * (1.0 - mix_frac);
    comp_r = sat_out_r * glue_gain * mix_frac + sat_out_r * (1.0 - mix_frac);
  ) : (
    comp_l = sat_out_l; comp_r = sat_out_r;
    glue_gr_db = 0.0;
  );

  // 6. Quad-Wall Stereo Imager & Sub-Mono Anchor
  mid = (comp_l + comp_r) * 0.5;
  side = (comp_l - comp_r) * 0.5;

  // Filter side channel with Sub-Mono Highpass at slider6 Hz (80 Hz)
  side_filt = (sm_b0 * side + sm_b1 * sm_x1 + sm_b2 * sm_x2 - sm_a1 * sm_y1 - sm_a2 * sm_y2) / sm_a0;
  sm_x2 = sm_x1; sm_x1 = side; sm_y2 = sm_y1; sm_y1 = side_filt;

  // Trick 0: Chorus Stereo Bloom (+12% width expansion during choruses)
  active_width = slider25 * (1.0 + dk_env0 * dk_amt * 0.12);
  side_out = side_filt * active_width;

  out_sum_l = mid + side_out;
  out_sum_r = mid - side_out;

  // Trick 1: Pre-Drop Tape Choke (sub roll-off & -1.5dB tuck before drops)
  dk_env1 > 0.01 ? (
    choke_factor = 1.0 - (dk_env1 * dk_amt * 0.16);
    out_sum_l *= choke_factor;
    out_sum_r *= choke_factor;
  );

  // Trick 2: Sub-Drop Ground-Slam (45Hz resonant punch on impacts)
  dk_env2 > 0.05 ? (
    slam_pulse = sin(scope_pos * 0.14) * (0.05 * dk_env2 * dk_amt);
    out_sum_l += slam_pulse;
    out_sum_r += slam_pulse;
  );

  // 7. Output Trim & Pre-Master Ceiling Guardian
  trim_gain = exp(slider4 * 0.1151292546);
  final_l = out_sum_l * trim_gain;
  final_r = out_sum_r * trim_gain;

  // Analog Soft-Diode Peak Catcher
  lim_th = 0.98; // -0.18 dBFS
  abs(final_l) > lim_th ? (
    final_l = sign(final_l) * (lim_th + (abs(final_l) - lim_th) / (1.0 + sqr(abs(final_l) - lim_th)));
  );
  abs(final_r) > lim_th ? (
    final_r = sign(final_r) * (lim_th + (abs(final_r) - lim_th) / (1.0 + sqr(abs(final_r) - lim_th)));
  );

  spl0 = final_l;
  spl1 = final_r;
  gmem[10] = glue_gr_db;
  gmem[50] = p80_b0;
  gmem[51] = p80_b1;
  gmem[52] = p80_b2;
  gmem[53] = p80_a0;
  gmem[54] = p80_a1;
  gmem[55] = p80_a2;
  gmem[40] = s_l;
  gmem[41] = b90_l;
  gmem[42] = ws_l;
  gmem[43] = m_l;
  gmem[44] = b_l;
  gmem[45] = k_l;
  gmem[20] = in_l;
  gmem[21] = y_l;
  gmem[22] = eq_out_l;
  gmem[23] = pock_l;
  gmem[24] = sat_out_l;
  gmem[25] = sc_det;
  gmem[26] = sc_db;
  gmem[27] = comp_env;
  gmem[28] = glue_gr_db;
  gmem[29] = comp_l;
  gmem[30] = out_sum_l;
  gmem[31] = final_l;
  gmem[11] = inst_rms;
  gmem[12] = inst_peak;
  gmem[13] = active_width;
  gmem[14] = pocket_depth;
);

@gfx 1080 720
gfx_clear = 0x07090D;
mouse_down = (mouse_cap & 1);
mouse_clicked = mouse_down && !prev_mouse_down;

function get_producer_name(idx) (
  idx == 0 ? "00: Unity Transparent Pass" :
  idx == 1 ? "01: Lance Prenc (Alpha Wolf)" :
  idx == 2 ? "02: Scott Seigel (DIESECT)" :
  idx == 3 ? "03: Jonathan Dolese (Mirrorcell)" :
  idx == 4 ? "04: Buster Odeholm (thrown)" :
  idx == 5 ? "05: Lewis Johns (Love Is Noise)" :
  idx == 6 ? "06: Kel Pinchin (Split Chain) *" :
  idx == 7 ? "07: Dan Lancaster (Don Broco)" :
  idx == 8 ? "08: Erik Bickerstaffe (Static Dress)" :
  idx == 9 ? "09: Sam Guaiana (Silverstein)" :
  idx == 10 ? "10: Zach Tuch (Heavenward)" :
  idx == 11 ? "11: Forrester Savell (Karnivool)" :
  idx == 12 ? "12: Leon Schmidt (SUNBORN)" :
  idx == 13 ? "13: Ermin Hamidovic (Systematic)" :
  idx == 14 ? "14: Will Putney (Fit For An Autopsy)" :
  idx == 15 ? "15: George Lever (Loathe)" :
  idx == 16 ? "16: Sam Bassal (Thornhill)" :
  idx == 17 ? "17: Henrik Udd (Architects)" :
  idx == 18 ? "18: Dan Braunstein (Spiritbox)" :
  idx == 19 ? "19: Zakk Cervini (Bad Omens)" :
  idx == 20 ? "20: Jens Bogren (Fascination St)" :
  idx == 21 ? "21: Adam Nolly Getgood (Periphery)" :
  idx == 22 ? "22: Acle Kahney (TesseracT)" :
  idx == 23 ? "23: Adam Cichocki (heaving.)" :
  "24: Manuel Renner (SENNA)";
);

function get_producer_ref_track(idx) (
  idx == 0 ? "None (Transparent Summing Baseline)" :
  idx == 1 ? "Alpha Wolf - 60cm Of Steel" :
  idx == 2 ? "DIESECT - TOO MANY SCARS" :
  idx == 3 ? "Mirrorcell - U(phoria)" :
  idx == 4 ? "thrown / Northlane - Evian" :
  idx == 5 ? "Love Is Noise / blanket - Blur" :
  idx == 6 ? "Split Chain - I'm Not Dying To Be Here" :
  idx == 7 ? "Don Broco - Endorphins" :
  idx == 8 ? "Static Dress - face.." :
  idx == 9 ? "Silverstein - Misery Made Me" :
  idx == 10 ? "Heavenward - Tangerine" :
  idx == 11 ? "City Of Souls - Cruelty / Karnivool" :
  idx == 12 ? "SUNBORN - Nebula" :
  idx == 13 ? "01 The End of All We Know" :
  idx == 14 ? "Fit For An Autopsy - Walk With Me In Hell" :
  idx == 15 ? "Loathe - Agressive Evolution / Sleep Token" :
  idx == 16 ? "Thornhill - nerv" :
  idx == 17 ? "Architects - 8. Gravity" :
  idx == 18 ? "Spiritbox - Keep Sweet" :
  idx == 19 ? "Bad Omens - THE DEATH OF PEACE OF MIND" :
  idx == 20 ? "Fascination Street Studios Benchmark" :
  idx == 21 ? "Periphery / GGD Modern Metal Target" :
  idx == 22 ? "TesseracT - King" :
  idx == 23 ? "heaving. - carsick" :
  "SENNA - Out Of The Blue";
);

// ─────────────────────────────────────────────────────────────────────────────
// 1. MASTER SUITE COMMAND BANNER (AFRO-CYBERNETIC LUXURY FRAME)
// ─────────────────────────────────────────────────────────────────────────────
hdr_h = 58;
gfx_r = 0.015; gfx_g = 0.020; gfx_b = 0.028; gfx_rect(0, 0, gfx_w, hdr_h);
gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_line(0, hdr_h - 1, gfx_w, hdr_h - 1);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_line(0, hdr_h, gfx_w, hdr_h);

// Golden Adinkra Insignia & Flagship Branding
gfx_setfont(1, "Orbitron", 17, 'b'); gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.30;
gfx_x = 18; gfx_y = 12;
gfx_drawstr("DAMEI INSTRUMENTAL BUS ALCHEMIST");

gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.65; gfx_g = 0.75; gfx_b = 0.85;
gfx_x = 18; gfx_y = 35;
gfx_drawstr("FUNTUNFUNEFU-DENKYEMFUNEFU // COLLECTIVE SUMMING & PRODUCER DYNAMICS ENGINE");

// Live Master Status Badges
badge_x = gfx_w - 380;
gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.04; gfx_rect(badge_x, 10, 180, 38);
gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(badge_x, 10, 180, 38, 0);
gfx_setfont(2, "Consolas", 9.5, 'b'); gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
gfx_x = badge_x + 8; gfx_y = 14; gfx_drawstr("PRE-MASTER LOCK");
gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_x = badge_x + 8; gfx_y = 28;
slider5 ? gfx_drawstr("STRICT -6.0 dBTP") : gfx_drawstr("FREE CREST PASS");

// Master Bypass Toggle
byp_x = gfx_w - 180;
byp_hov = (mouse_x >= byp_x && mouse_x <= byp_x + 160 && mouse_y >= 10 && mouse_y <= 48);
gfx_r = slider27 ? 0.04 : 0.20; gfx_g = slider27 ? 0.16 : 0.03; gfx_b = slider27 ? 0.08 : 0.03;
gfx_rect(byp_x, 10, 160, 38);
gfx_r = slider27 ? 0.15 : 0.85; gfx_g = slider27 ? 0.95 : 0.25; gfx_b = slider27 ? 0.45 : 0.25;
gfx_rect(byp_x, 10, 160, 38, 0);
gfx_setfont(1, "Orbitron", 12, 'b');
gfx_r = slider27 ? 1.0 : 0.95; gfx_g = slider27 ? 1.0 : 0.4; gfx_b = slider27 ? 1.0 : 0.4;
gfx_x = byp_x + 16; gfx_y = 21;
slider27 ? gfx_drawstr("SUMMING ACTIVE") : gfx_drawstr("SUITE BYPASSED");
mouse_clicked && byp_hov ? (slider27 = !slider27; slider_automate(););

// ─────────────────────────────────────────────────────────────────────────────
// 2. MISSION HUD TELEMETRY CARDS (TOP STRIP)
// ─────────────────────────────────────────────────────────────────────────────
card_y = hdr_h + 8;
card_h = 60;
card_w = floor((gfx_w - 28 - 18) / 4);

// Card 1: Forensic Producer Benchmark
c1_x = 14;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c1_x, card_y, card_w, card_h);
gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(c1_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
gfx_x = c1_x + 8; gfx_y = card_y + 6; gfx_drawstr("PRODUCER TARGET BENCHMARK");
gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
p_name = get_producer_name(slider2);
gfx_x = c1_x + 8; gfx_y = card_y + 22; gfx_drawstr(p_name);
gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_x = c1_x + 8; gfx_y = card_y + 42;
gfx_printf("TRIM: %+3.1fdB | HPF: %dHz", slider4, slider16);

// Card 2: AI Mix Assistant Status & Safe Calibrate
c2_x = c1_x + card_w + 6;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c2_x, card_y, card_w, card_h);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(c2_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_x = c2_x + 8; gfx_y = card_y + 6; gfx_drawstr("AI TACTICIAN // ENERGY RADAR");

ai_btn_hov = (mouse_x >= c2_x + 8 && mouse_x <= c2_x + card_w - 8 && mouse_y >= card_y + 20 && mouse_y <= card_y + 40);
gfx_r = ai_btn_hov ? 0.08 : 0.03; gfx_g = ai_btn_hov ? 0.20 : 0.07; gfx_b = ai_btn_hov ? 0.28 : 0.11;
gfx_rect(c2_x + 8, card_y + 20, card_w - 16, 20);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(c2_x + 8, card_y + 20, card_w - 16, 20, 0);
gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 1.0; gfx_g = 0.9; gfx_b = 0.5;
gfx_x = c2_x + 14; gfx_y = card_y + 24;
ai_txt = slider32 == 1 ? "★ AI COGNITIVE SENTRY: ACTIVE" : "⚡ CLICK: SAFE AUTO-CALIBRATE";
gfx_drawstr(ai_txt);
mouse_clicked && ai_btn_hov ? (trigger_ai_assist(); slider_automate(););

gfx_setfont(2, "Consolas", 9.5, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_x = c2_x + 8; gfx_y = card_y + 43;
gfx_printf("STATUS: %s (CTX: %.2f)", dk_tn[dk_r_idx], dk_ctx);

// Card 3: Studio Bus Glue Telemetry
c3_x = c2_x + card_w + 6;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c3_x, card_y, card_w, card_h);
gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(c3_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
gfx_x = c3_x + 8; gfx_y = card_y + 6; gfx_drawstr("STUDIO BUS GLUE (BUSTERse)");
gfx_setfont(1, "Orbitron", 16, 'b'); gfx_x = c3_x + 8; gfx_y = card_y + 20;
gfx_r = glue_gr_db > 0.1 ? 0.00 : 0.70; gfx_g = glue_gr_db > 0.1 ? 0.85 : 0.75; gfx_b = glue_gr_db > 0.1 ? 1.00 : 0.80;
gfx_printf("GR: %3.1f dB", glue_gr_db);
gfx_setfont(2, "Consolas", 10, 'b'); gfx_x = c3_x + 8; gfx_y = card_y + 42;
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_printf("%d:1 PUNCH | 10ms | %dHz SC", slider13 == 0 ? 1.5 : (slider13 == 1 ? 2 : (slider13 == 2 ? 4 : 8)), slider16);

// Card 4: Vocal Corridor & Stereo
c4_x = c3_x + card_w + 6;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c4_x, card_y, card_w, card_h);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(c4_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_x = c4_x + 8; gfx_y = card_y + 6; gfx_drawstr("VOCAL POCKET & STEREO");
gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_setfont(1, "Orbitron", 16, 'b'); gfx_x = c4_x + 8; gfx_y = card_y + 20;
gfx_printf("POCKET: -%3.1f dB", pocket_depth);
gfx_setfont(2, "Consolas", 10, 'b'); gfx_x = c4_x + 8; gfx_y = card_y + 42;
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_printf("WIDTH: %.2fx | SUB: %dHz", active_width, slider6);

// ─────────────────────────────────────────────────────────────────────────────
// 3. TAB NAVIGATION BAR (8 LUXURY TABS)
// ─────────────────────────────────────────────────────────────────────────────
tab_y = card_y + card_h + 6;
tab_h = 32;
tab_w = floor((gfx_w - 28 - 42) / 8);

t_i = 0;
while (t_i < 8) (
  tx = 14 + t_i * (tab_w + 6);
  is_sel = (slider1 == t_i);
  t_hov = (mouse_x >= tx && mouse_x <= tx + tab_w && mouse_y >= tab_y && mouse_y <= tab_y + tab_h);

  gfx_r = is_sel ? 0.08 : (t_hov ? 0.04 : 0.015);
  gfx_g = is_sel ? 0.10 : (t_hov ? 0.05 : 0.020);
  gfx_b = is_sel ? 0.14 : (t_hov ? 0.07 : 0.028);
  gfx_rect(tx, tab_y, tab_w, tab_h);

  is_sel ? (
    gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;
    gfx_rect(tx, tab_y, tab_w, tab_h, 0);
    gfx_rect(tx + 1, tab_y + 1, tab_w - 2, tab_h - 2, 0);
  ) : (
    gfx_r = 0.25; gfx_g = 0.32; gfx_b = 0.42;
    gfx_rect(tx, tab_y, tab_w, tab_h, 0);
  );

  gfx_setfont(1, "Orbitron", 10.5, 'b');
  is_sel ? (gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;) : (gfx_r = 0.65; gfx_g = 0.75; gfx_b = 0.85;);
  t_lbl = t_i == 0 ? "OVERVIEW" :
          t_i == 1 ? "TONAL EQ" :
          t_i == 2 ? "BUS GLUE" :
          t_i == 3 ? "CRUCIBLE" :
          t_i == 4 ? "STEREO" :
          t_i == 5 ? "POCKET" :
          t_i == 6 ? "PRODUCER" : "EAR CANDY";
  gfx_measurestr(t_lbl, tlw, tlh);
  gfx_x = tx + floor((tab_w - tlw) * 0.5); gfx_y = tab_y + floor((tab_h - tlh) * 0.5);
  gfx_drawstr(t_lbl);

  mouse_clicked && t_hov ? (
    slider1 = t_i; slider_automate();
  );
  t_i += 1;
);

// ─────────────────────────────────────────────────────────────────────────────
// 4. MAIN WORKSPACE ENCLOSURE (DYNAMIC VIEWPORT)
// ─────────────────────────────────────────────────────────────────────────────
ws_x = 14; ws_y = tab_y + tab_h + 6;
ws_w = gfx_w - 28; ws_h = gfx_h - ws_y - 12;

gfx_r = 0.012; gfx_g = 0.016; gfx_b = 0.024; gfx_rect(ws_x, ws_y, ws_w, ws_h);
gfx_r = 0.25; gfx_g = 0.35; gfx_b = 0.48; gfx_rect(ws_x, ws_y, ws_w, ws_h, 0);

// Helper for Component Subheader Banner
function draw_component_header(title, mission, role, signal_path) (
  gfx_r = 0.018; gfx_g = 0.024; gfx_b = 0.034; gfx_rect(ws_x + 8, ws_y + 8, ws_w - 16, 52);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(ws_x + 8, ws_y + 8, ws_w - 16, 52, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = ws_x + 18; gfx_y = ws_y + 14; gfx_drawstr(title);

  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = ws_x + 18; gfx_y = ws_y + 32; gfx_drawstr("MISSION: ");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_drawstr(mission);

  gfx_x = ws_x + ws_w - 480; gfx_y = ws_y + 14; gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_drawstr("SIGNAL PATH: "); gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85; gfx_drawstr(signal_path);
  gfx_x = ws_x + ws_w - 480; gfx_y = ws_y + 32; gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
  gfx_drawstr("MIXING ROLE: "); gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85; gfx_drawstr(role);
);

function draw_eq_fader(f_idx, f_x, f_y, f_w, f_h, title, freq_lbl, val, min_v, max_v, s_idx) local(v_str, trk_y, trk_h, trk_x, f_frac, th_y, hov, new_frac) (
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(f_x, f_y, f_w - 6, f_h);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(f_x, f_y, f_w - 6, f_h, 0);

  gfx_setfont(1, "Orbitron", 11, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = f_x + 10; gfx_y = f_y + 10; gfx_drawstr(title);
  gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = f_x + 10; gfx_y = f_y + 28; gfx_drawstr(freq_lbl);

  v_str = sprintf(#, "%+3.1f dB", val);
  gfx_setfont(1, "Orbitron", 13, 'b'); gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_x = f_x + 10; gfx_y = f_y + 48; gfx_drawstr(v_str);

  // Track & Thumb
  trk_y = f_y + 80; trk_h = f_h - 96;
  trk_x = f_x + floor((f_w - 6) * 0.5) - 3;
  gfx_r = 0.04; gfx_g = 0.06; gfx_b = 0.08; gfx_rect(trk_x, trk_y, 6, trk_h);
  gfx_r = 0.30; gfx_g = 0.40; gfx_b = 0.55; gfx_rect(trk_x, trk_y, 6, trk_h, 0);

  f_frac = clamp((val - min_v) / (max_v - min_v), 0.0, 1.0);
  th_y = trk_y + trk_h - floor(f_frac * trk_h);

  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
  gfx_rect(trk_x - 14, th_y - 8, 34, 16);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_rect(trk_x - 14, th_y - 8, 34, 16, 0);

  // Interactive Drag
  hov = (mouse_x >= f_x && mouse_x <= f_x + f_w - 6 && mouse_y >= trk_y - 10 && mouse_y <= trk_y + trk_h + 10);
  mouse_clicked && hov ? eq_drag_slider = s_idx;
  eq_drag_slider == s_idx && mouse_down ? (
    new_frac = clamp((trk_y + trk_h - mouse_y) / trk_h, 0.0, 1.0);
    slider(s_idx) = min_v + new_frac * (max_v - min_v);
    update_filters(); slider_automate();
  );
);

// Strictly Confined Vintage SIFAM Moving-Coil Meter
function draw_sifam_meter(mx, my, mw, mh, title_str, needle_val, max_val, is_glue, accent_r, accent_g, accent_b) local(plate_x, plate_y, plate_w, plate_h, piv_x, piv_y, radius_arc, radius_needle, ang_min, ang_max, a_span, a_frac, cur_a, ax, ay, ai, arc_steps, prev_ax, prev_ay, t_a, m_db, f_val, nx1, ny1, nx2, ny2, tw, th, t_str, badge_str, b_w, b_h, frac, cur_ang, tip_x, tip_y, base_x, base_y) (
  gfx_r = 0.055; gfx_g = 0.065; gfx_b = 0.080; gfx_rect(mx, my, mw, mh);
  gfx_r = 0.020; gfx_g = 0.024; gfx_b = 0.032; gfx_rect(mx + 2, my + 2, mw - 4, mh - 4);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(mx, my, mw, mh, 0);
  gfx_r = accent_r * 0.6; gfx_g = accent_g * 0.6; gfx_b = accent_b * 0.6; gfx_rect(mx + 2, my + 2, mw - 4, mh - 4, 0);

  plate_x = mx + 6; plate_y = my + 6;
  plate_w = mw - 12; plate_h = mh - 12;
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.060; gfx_rect(plate_x, plate_y, plate_w, plate_h);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(plate_x, plate_y, plate_w, plate_h, 0);

  piv_x = plate_x + plate_w * 0.5;
  piv_y = plate_y + plate_h - 16;

  radius_arc = min(plate_h - 52, plate_w * 0.44);
  radius_needle = radius_arc - 4;

  // Tungsten Lamp Glow
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.35; gfx_a = 0.07;
  gfx_circle(piv_x, piv_y - radius_arc * 0.45, floor(radius_arc * 0.6), 1);
  gfx_a = 1.0;

  gfx_setfont(1, "Orbitron", 11.5, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = plate_x + 12; gfx_y = plate_y + 8; gfx_drawstr(title_str);

  gfx_setfont(2, "Consolas", 11, 'b'); gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;
  badge_str = is_glue ? "STUDIO GR" : "STUDIO VU";
  gfx_measurestr(badge_str, b_w, b_h);
  gfx_x = plate_x + plate_w - b_w - 12; gfx_y = plate_y + 8; gfx_drawstr(badge_str);

  ang_min = -0.62; ang_max = 0.62; a_span = ang_max - ang_min;
  arc_steps = 30; ai = 0; prev_ax = 0; prev_ay = 0;
  loop(arc_steps + 1,
    a_frac = ai / arc_steps;
    cur_a = ang_min + a_frac * a_span;
    ax = piv_x + sin(cur_a) * radius_arc;
    ay = piv_y - cos(cur_a) * radius_arc;
    ai > 0 ? (
      is_glue ? (
        a_frac > 0.65 ? (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;) : (gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;)
      ) : (
        a_frac > 0.87 ? (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;) : (gfx_r = 0.95; gfx_g = 0.75; gfx_b = 0.20;)
      );
      gfx_line(prev_ax, prev_ay, ax, ay);
    );
    prev_ax = ax; prev_ay = ay;
    ai += 1;
  );

  gfx_setfont(3, "Consolas", 10, 'b');
  is_glue ? (
    m_i = 0;
    while (m_i < 6) (
      m_db = m_i == 0 ? 0 : (m_i == 1 ? 3 : (m_i == 2 ? 6 : (m_i == 3 ? 10 : (m_i == 4 ? 16 : 20))));
      f_val = m_db / 20.0;
      t_a = ang_min + f_val * a_span;
      nx1 = piv_x + sin(t_a) * (radius_arc - 5); ny1 = piv_y - cos(t_a) * (radius_arc - 5);
      nx2 = piv_x + sin(t_a) * (radius_arc + 4); ny2 = piv_y - cos(t_a) * (radius_arc + 4);
      m_db >= 10 ? (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;) : (gfx_r = 0.75; gfx_g = 0.88; gfx_b = 0.95;);
      gfx_line(nx1, ny1, nx2, ny2);
      t_str = sprintf(#, "%d", m_db);
      gfx_measurestr(t_str, tw, th);
      gfx_x = piv_x + sin(t_a) * (radius_arc + 14) - tw * 0.5;
      gfx_y = piv_y - cos(t_a) * (radius_arc + 14) - th * 0.5;
      gfx_drawstr(t_str);
      m_i += 1;
    );
  ) : (
    m_i = 0;
    while (m_i < 5) (
      m_db = m_i == 0 ? -20 : (m_i == 1 ? -10 : (m_i == 2 ? -5 : (m_i == 3 ? 0 : 3)));
      f_val = (m_db + 20.0) / 23.0;
      t_a = ang_min + f_val * a_span;
      nx1 = piv_x + sin(t_a) * (radius_arc - 5); ny1 = piv_y - cos(t_a) * (radius_arc - 5);
      nx2 = piv_x + sin(t_a) * (radius_arc + 4); ny2 = piv_y - cos(t_a) * (radius_arc + 4);
      m_db <= 0 ? (gfx_r = 0.75; gfx_g = 0.85; gfx_b = 0.95;) : (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;);
      gfx_line(nx1, ny1, nx2, ny2);
      t_str = sprintf(#, "%+d", m_db);
      gfx_measurestr(t_str, tw, th);
      gfx_x = piv_x + sin(t_a) * (radius_arc + 14) - tw * 0.5;
      gfx_y = piv_y - cos(t_a) * (radius_arc + 14) - th * 0.5;
      gfx_drawstr(t_str);
      m_i += 1;
    );
  );

  gfx_setfont(1, "Orbitron", 13, 'b');
  is_glue ? (gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;) : (gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;);
  center_badge = is_glue ? "[ GR ]" : "[ VU ]";
  gfx_measurestr(center_badge, tw, th);
  gfx_x = floor(plate_x + (plate_w - tw) * 0.5);
  gfx_y = floor(piv_y - radius_needle * 0.45);
  gfx_drawstr(center_badge);

  frac = is_glue ? min(1.0, max(0.0, needle_val / 20.0)) : min(1.0, max(0.0, (needle_val + 20.0) / 23.0));
  cur_ang = ang_min + frac * a_span;
  tip_x = piv_x + sin(cur_ang) * radius_needle;
  tip_y = piv_y - cos(cur_ang) * radius_needle;
  base_x = piv_x + sin(cur_ang) * 14;
  base_y = piv_y - cos(cur_ang) * 14;

  is_glue ? (gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;) : (gfx_r = 1.00; gfx_g = 0.80; gfx_b = 0.22;);
  gfx_line(base_x - 0.7, base_y, tip_x - 0.7, tip_y);
  gfx_line(base_x + 0.7, base_y, tip_x + 0.7, tip_y);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_line(base_x, base_y, tip_x, tip_y);

  gfx_r = 0.98; gfx_g = 0.25; gfx_b = 0.22; gfx_circle(tip_x, tip_y, 2.5, 1);
  gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14; gfx_circle(piv_x, piv_y, 16, 1);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_circle(piv_x, piv_y, 16, 0);

  gfx_setfont(3, "Consolas", 10.5, 'b');
  is_glue ? (
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
    gfx_x = plate_x + 14; gfx_y = plate_y + plate_h - 22;
    gfx_printf("GR: %4.1f dB", glue_gr_db);
    gfx_x = plate_x + plate_w - 78; gfx_y = plate_y + plate_h - 22;
    gfx_drawstr("PEAK HOLD");
  ) : (
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 0.45;
    gfx_x = plate_x + 14; gfx_y = plate_y + plate_h - 22;
    gfx_printf("RMS: %4.1f dBFS", inst_rms);
    gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
    gfx_x = plate_x + plate_w - 110; gfx_y = plate_y + plate_h - 22;
    gfx_drawstr("0 VU = -18 dBFS");
  );
);

// Ballistic Needle Damping
sifam_needle_vu += (inst_rms - sifam_needle_vu) * 0.25;
sifam_needle_gr += (glue_gr_db - sifam_needle_gr) * 0.35;

// =============================================================================
// TAB 0: OVERVIEW HARDWARE DASHBOARD
// =============================================================================
slider1 == 0 ? (
  draw_component_header("TAB 0 // MASTER TELEMETRY DASHBOARD",
                        "Harmonic summing telemetry, SIFAM moving-coil ballistics & phosphor radar",
                        "Glued instrumental master pass prior to vocal bus interaction",
                        "IN -> 7-BAND ReEQ -> POCKET -> CRUCIBLE -> VCA GLUE -> M/S -> OUT");

  dash_y = ws_y + 68;
  top_row_h = 220;
  meter_w = floor((ws_w - 48) * 0.35);
  scope_w = ws_w - 32 - meter_w * 2;

  // 1. Console Drive SIFAM VU Meter
  draw_sifam_meter(ws_x + 8, dash_y, meter_w, top_row_h, "SIFAM DIRECTOR // CONSOLE DRIVE", sifam_needle_vu, 3.0, 0, 1.00, 0.85, 0.30);

  // 2. Studio Bus Glue SIFAM GR Meter
  draw_sifam_meter(ws_x + 16 + meter_w, dash_y, meter_w, top_row_h, "STUDIO BUS GLUE // GAIN REDUCTION", sifam_needle_gr, 20.0, 1, 0.00, 0.85, 1.00);

  // 3. Stereo Phase & Lissajous Radar with Phosphor Trails
  sc_x = ws_x + 24 + meter_w * 2; sc_y = dash_y;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(sc_x, sc_y, scope_w, top_row_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(sc_x, sc_y, scope_w, top_row_h, 0);

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = sc_x + 14; gfx_y = sc_y + 10; gfx_drawstr("STEREO PHASE RADAR");

  r_cx = sc_x + scope_w * 0.5; r_cy = sc_y + 115;
  r_dyn = 1.0 + max(0.0, (inst_rms + 35.0) / 45.0) * 0.20;
  gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20;
  gfx_circle(r_cx, r_cy, floor(60 * r_dyn), 0);
  gfx_circle(r_cx, r_cy, 38, 0);
  gfx_line(r_cx - 60, r_cy, r_cx + 60, r_cy);
  gfx_line(r_cx, r_cy - 60, r_cx, r_cy + 60);

  // Live Lissajous CRT Phosphor Trails
  pi = 0; prev_sx = r_cx; prev_sy = r_cy;
  loop(48,
    s_idx = (scope_pos - pi * 3 + 256) % 256;
    sl = scope_buf_l[s_idx]; sr = scope_buf_r[s_idx];
    sx = r_cx + (sl - sr) * 48.0;
    sy = r_cy - (sl + sr) * 48.0;
    pi > 0 ? (
      gfx_r = 0.00; gfx_g = 0.95; gfx_b = 0.65; gfx_a = 0.65;
      gfx_line(prev_sx, prev_sy, sx, sy);
    );
    prev_sx = sx; prev_sy = sy;
    pi += 1;
  );
  gfx_a = 1.0;

  // Correlation Meter
  c_bar_y = sc_y + top_row_h - 28;
  c_bar_w = scope_w - 24;
  gfx_r = 0.05; gfx_g = 0.07; gfx_b = 0.10; gfx_rect(sc_x + 12, c_bar_y, c_bar_w, 14);
  gfx_r = 0.25; gfx_g = 0.35; gfx_b = 0.45; gfx_rect(sc_x + 12, c_bar_y, c_bar_w, 14, 0);
  c_mid = sc_x + 12 + c_bar_w * 0.5;
  gfx_line(c_mid, c_bar_y - 2, c_mid, c_bar_y + 16);

  c_fill_w = floor(corr_smooth * (c_bar_w * 0.5));
  corr_smooth >= 0 ? (
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 0.45;
    gfx_rect(c_mid, c_bar_y + 2, c_fill_w, 10);
  ) : (
    gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.20;
    gfx_rect(c_mid + c_fill_w, c_bar_y + 2, -c_fill_w, 10);
  );

  // Bottom Quick Overview Controls
  bot_y = dash_y + top_row_h + 12;
  bot_h = ws_h - 68 - top_row_h - 20;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(ws_x + 8, bot_y, ws_w - 16, bot_h);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(ws_x + 8, bot_y, ws_w - 16, bot_h, 0);

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = ws_x + 20; gfx_y = bot_y + 12; gfx_drawstr("FLAGSHIP BUS INTEGRATION // MISSION TELEMETRY");

  gfx_setfont(2, "Consolas", 11, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = ws_x + 20; gfx_y = bot_y + 36;
  gfx_printf("• HEADROOM TRIM : %+3.1f dB (Forensic DeeGain Staging Lock)", slider4);
  gfx_x = ws_x + 20; gfx_y = bot_y + 56;
  gfx_printf("• BUS GLUE VCA  : Thresh %4.1fdB | 4:1 Ratio | 10ms Attack | 600ms Release | HPF %dHz", slider12, slider16);
  gfx_x = ws_x + 20; gfx_y = bot_y + 76;
  gfx_printf("• HARMONIC DESK : Neve 8014 Iron Desk | Saturation Drive %+3.1f dB", slider24);
  gfx_x = ws_x + 20; gfx_y = bot_y + 96;
  gfx_printf("• STEREO MATRIX : Sub-Mono Anchor %d Hz | M/S Quad Width %.2fx | Pocket Notch -%3.1fdB", slider6, active_width, pocket_depth);
);

// =============================================================================
// TAB 1: TONAL EQ (7-BAND REEQ ARCHITECTURE)
// =============================================================================
slider1 == 1 ? (
  draw_component_header("TAB 1 // 7-BAND TONAL FORGE EQUALIZER",
                        "Forensic linear-phase spectral sculpting & resonance management",
                        "Decouples sub-rumble, scoops lower-mid mud & adds pick bite",
                        "IN -> HPF 38Hz -> 80Hz SHELF -> 202Hz SCOOP -> 1.5k BODY -> 3k BITE -> 8k SHEEN");

  eq_view_y = ws_y + 68;
  eq_view_h = ws_h - 78;

  // 64-Band Live Spectrum Analyzer Display
  sp_w = ws_w - 24; sp_h = 160;
  gfx_r = 0.012; gfx_g = 0.016; gfx_b = 0.024; gfx_rect(ws_x + 12, eq_view_y, sp_w, sp_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(ws_x + 12, eq_view_y, sp_w, sp_h, 0);

  gfx_setfont(1, "Orbitron", 11, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = ws_x + 24; gfx_y = eq_view_y + 10;
  gfx_drawstr("REAL-TIME 64-BAND LOGARITHMIC SPECTRUM ANALYZER & ReEQ ALIGNMENT");

  // Grid lines
  gfx_r = 0.08; gfx_g = 0.12; gfx_b = 0.18;
  gfx_line(ws_x + 12, eq_view_y + 40, ws_x + 12 + sp_w, eq_view_y + 40);
  gfx_line(ws_x + 12, eq_view_y + 80, ws_x + 12 + sp_w, eq_view_y + 80);
  gfx_line(ws_x + 12, eq_view_y + 120, ws_x + 12 + sp_w, eq_view_y + 120);

  // Draw Spectrum Bars
  sp_i = 0; bin_w = max(2, floor((sp_w - 32) / 64));
  while (sp_i < 64) (
    bx = ws_x + 24 + sp_i * bin_w;
    b_val = min(1.0, spec_bins[sp_i] * 2.5);
    bh = floor(b_val * (sp_h - 30));
    by = eq_view_y + sp_h - bh - 6;

    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 0.65;
    gfx_rect(bx, by, bin_w - 1, bh);
    spec_bins[sp_i] *= 0.88; // decay
    sp_i += 1;
  );
  gfx_a = 1.0;

  // EQ Control Faders Strip
  f_y = eq_view_y + sp_h + 16;
  f_h = eq_view_h - sp_h - 26;
  f_w = floor((ws_w - 32) / 6);



  draw_eq_fader(0, ws_x + 12 + 0 * f_w, f_y, f_w, f_h, "HPF SUB-CUT", "38 Hz 18dB/oct", slider18, 20.0, 60.0, 18);
  draw_eq_fader(1, ws_x + 12 + 1 * f_w, f_y, f_w, f_h, "LOW SHELF", "80 Hz Punch", slider19, -6.0, 6.0, 19);
  draw_eq_fader(2, ws_x + 12 + 2 * f_w, f_y, f_w, f_h, "MUD SCOOP", "202 Hz Q=1.2", slider20, -6.0, 6.0, 20);
  draw_eq_fader(3, ws_x + 12 + 3 * f_w, f_y, f_w, f_h, "MID BODY", "1.5 kHz Q=1.5", slider21, -6.0, 6.0, 21);
  draw_eq_fader(4, ws_x + 12 + 4 * f_w, f_y, f_w, f_h, "PICK BITE", "3.0 kHz Q=1.8", slider22, -6.0, 6.0, 22);
  draw_eq_fader(5, ws_x + 12 + 5 * f_w, f_y, f_w, f_h, "AIR SHEEN", "8.0 kHz Shelf", slider31, -6.0, 6.0, 31);
);

// =============================================================================
// TAB 2: BUS GLUE (BUSTERse VCA TOPOLOGY)
// =============================================================================
slider1 == 2 ? (
  draw_component_header("TAB 2 // STUDIO BUS GLUE COMPRESSOR (BUSTERse VCA)",
                        "British VCA master glue with authentic 39Hz / 60Hz sidechain detection",
                        "Glues rhythm stems into a record; 10ms attack lets transients breathe",
                        "SAT OUT -> 39Hz DETECTOR -> VCA ATTENUATOR -> DRY/WET MIX -> STEREO M/S");

  glue_y = ws_y + 68;
  glue_w = floor((ws_w - 32) * 0.48);
  glue_h = ws_h - 78;

  // Left: SIFAM GR Meter + Live Scrolling GR History Strip
  draw_sifam_meter(ws_x + 12, glue_y, glue_w, 240, "STUDIO BUS GLUE // GAIN REDUCTION", sifam_needle_gr, 20.0, 1, 0.00, 0.85, 1.00);

  // Live 128-Point Scrolling Gain Reduction Strip
  gr_strip_y = glue_y + 248; gr_strip_h = glue_h - 248;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(ws_x + 12, gr_strip_y, glue_w, gr_strip_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(ws_x + 12, gr_strip_y, glue_w, gr_strip_h, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = ws_x + 22; gfx_y = gr_strip_y + 8; gfx_drawstr("SCROLLING GAIN REDUCTION TELEMETRY (128 FRAMES)");

  // Draw scrolling history line
  hist_i = 0; step_x = glue_w / 128.0;
  prev_hx = ws_x + 12; prev_hy = gr_strip_y + 28;
  while (hist_i < 128) (
    buf_i = (gr_hist_pos - 128 + hist_i + 128) % 128;
    h_gr = gr_hist[buf_i];
    hx = ws_x + 12 + hist_i * step_x;
    hy = gr_strip_y + 28 + clamp(h_gr * 8.0, 0, gr_strip_h - 36);

    hist_i > 0 ? (
      gfx_r = 0.00; gfx_g = 0.95; gfx_b = 1.00;
      gfx_line(prev_hx, prev_hy, hx, hy);
    );
    prev_hx = hx; prev_hy = hy;
    hist_i += 1;
  );

  // Right Column: Interactive Hardware VCA Compressor Controls
  ctrl_x = ws_x + 20 + glue_w;
  ctrl_w = ws_w - 32 - glue_w;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(ctrl_x, glue_y, ctrl_w, glue_h);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(ctrl_x, glue_y, ctrl_w, glue_h, 0);

  gfx_setfont(1, "Orbitron", 13, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = ctrl_x + 16; gfx_y = glue_y + 14; gfx_drawstr("BUSTERse VCA GLUE CALIBRATION");

  gfx_setfont(2, "Consolas", 11, 'b');
  // Parameter 1: Threshold
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 44;
  gfx_printf("• BUS GLUE THRESHOLD : %4.1f dB", slider12);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_x = ctrl_x + 16; gfx_y = glue_y + 60;
  gfx_drawstr("  [Target: 1.2 to 2.0 dB GR on Chorus Hits]");

  // Parameter 2: Ratio
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 88;
  gfx_printf("• COMPRESSION RATIO  : %d:1 Modern Punch", slider13 == 0 ? 1.5 : (slider13 == 1 ? 2 : (slider13 == 2 ? 4 : 8)));

  // Parameter 3: Attack Time
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 120;
  gfx_printf("• ATTACK TIME        : %4.1f ms (Transient Pass)", slider14);

  // Parameter 4: Release Time
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 152;
  r_str = slider15 == 0 ? "100ms Fast" : (slider15 == 1 ? "300ms Snappy" : (slider15 == 2 ? "600ms (.6 sec)" : "1200ms Smooth"));
  gfx_printf("• RELEASE TIME       : %s", r_str);

  // Parameter 5: Sidechain HPF (Forensic Nolly / Guaiana selector)
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 184;
  gfx_printf("• SIDECHAIN HPF      : %d Hz (Detector Filter)", slider16);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_x = ctrl_x + 16; gfx_y = glue_y + 200;
  slider16 <= 42 ? gfx_drawstr("  ★ 39Hz HPF ENGAGED: Snare Cut-Through Trick (Nolly / Pinchin)") :
  slider16 <= 65 ? gfx_drawstr("  ★ 60Hz HPF ENGAGED: Kick & Sub-Bass Decoupling (Sam Guaiana)") :
  gfx_drawstr("  ★ STANDARD HPF: Sub-Bass Pumping Decoupling");

  // Parameter 6: Dry/Wet Mix
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 230;
  gfx_printf("• PARALLEL GLUE MIX  : %d %%", slider17);

  // Ratio Pushbuttons Strip
  rx_w = floor((ctrl_w - 40) / 4);
  ri = 0;
  while (ri < 4) (
    r_btn_x = ctrl_x + 16 + ri * (rx_w + 6);
    r_btn_y = glue_y + 270;
    r_sel = (slider13 == ri);
    r_hov = (mouse_x >= r_btn_x && mouse_x <= r_btn_x + rx_w && mouse_y >= r_btn_y && mouse_y <= r_btn_y + 28);

    gfx_r = r_sel ? 0.85 : (r_hov ? 0.08 : 0.03);
    gfx_g = r_sel ? 0.70 : (r_hov ? 0.12 : 0.04);
    gfx_b = r_sel ? 0.22 : (r_hov ? 0.16 : 0.06);
    gfx_rect(r_btn_x, r_btn_y, rx_w, 28);
    gfx_r = r_sel ? 1.0 : 0.35; gfx_g = r_sel ? 0.9 : 0.45; gfx_b = r_sel ? 0.5 : 0.55;
    gfx_rect(r_btn_x, r_btn_y, rx_w, 28, 0);

    gfx_setfont(1, "Orbitron", 10.5, 'b');
    gfx_r = r_sel ? 0.02 : 0.85; gfx_g = r_sel ? 0.02 : 0.90; gfx_b = r_sel ? 0.03 : 0.98;
    lbl = ri == 0 ? "1.5:1" : (ri == 1 ? "2:1" : (ri == 2 ? "4:1" : "8:1"));
    gfx_measurestr(lbl, lb_w, lb_h);
    gfx_x = r_btn_x + floor((rx_w - lb_w) * 0.5); gfx_y = r_btn_y + floor((28 - lb_h) * 0.5);
    gfx_drawstr(lbl);

    mouse_clicked && r_hov ? (slider13 = ri; slider_automate(););
    ri += 1;
  );
);

