  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = lx + 24; gfx_y = log_y + 8;
  gfx_drawstr("DIRECTOR REASONING LOG // REAL-TIME TELEMETRY");

  gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = lx + 24; gfx_y = log_y + 26;
  gfx_printf("SECTION: [%s] | CTX FACTOR: %.2f | ENERGY: %4.1f dBFS (SONG: %4.1f)", dk_tn[dk_r_idx], dk_ctx, dk_fast_db, dk_song_db);

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = lx + 24; gfx_y = log_y + 44;
  gfx_printf("DENSITY: %d%% | AUTO-DEPLOY TACTICIAN: %s", floor(dk_dens * 100), slider37 ? "ENGAGED" : "MANUAL");

  gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.30; gfx_x = lx + 24; gfx_y = log_y + 62;
  dk_r_idx == 4 ? gfx_drawstr("STATUS: ACTIVE CHORUS BLOOM (+12% WIDTH) & SILK AIR EXPANSION") :
  dk_r_idx == 3 ? gfx_drawstr("STATUS: PRE-DROP TENSION ARMING // SUB-CUT TUCK READY") :
  dk_r_idx == 2 ? gfx_drawstr("STATUS: VERSE GROOVE DISCIPLINE // TRANSIENT PASS PRIORITIZED") :
  gfx_drawstr("STATUS: MONITORING SONG TIMELINE FOR NEXT TRANSITION ENTRY");

  // ---------------------------------------------------------------------------
  // RIGHT COLUMN: PRODUCER PLAYBOOK CAROUSEL & CRAFT HEURISTICS
  // ---------------------------------------------------------------------------
  rx = ws_x + 20 + col_w;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(rx, ec_y, col_w, ec_h);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(rx, ec_y, col_w, ec_h, 0);

  // Playbook Carousel Header with < > Navigation
  gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(rx + 16, ec_y + 12, col_w - 32, 34);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(rx + 16, ec_y + 12, col_w - 32, 34, 0);

  // Left Arrow
  prev_hov = (mouse_x >= rx + 20 && mouse_x <= rx + 52 && mouse_y >= ec_y + 14 && mouse_y <= ec_y + 44);
  gfx_setfont(1, "Orbitron", 14, 'b'); gfx_r = prev_hov ? 1.0 : 0.85; gfx_g = prev_hov ? 1.0 : 0.70; gfx_b = prev_hov ? 1.0 : 0.22;
  gfx_x = rx + 28; gfx_y = ec_y + 19; gfx_drawstr("<");
  mouse_clicked && prev_hov ? (dg_pbi = (dg_pbi - 1 + 25) % 25;);

  // Producer Title
  p_title = get_producer_name(dg_pbi);
  gfx_measurestr(p_title, ptw, pth);
  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = rx + 16 + floor((col_w - 32 - ptw) * 0.5); gfx_y = ec_y + 20;
  gfx_drawstr(p_title);

  // Right Arrow
  next_hov = (mouse_x >= rx + col_w - 52 && mouse_x <= rx + col_w - 20 && mouse_y >= ec_y + 14 && mouse_y <= ec_y + 44);
  gfx_setfont(1, "Orbitron", 14, 'b'); gfx_r = next_hov ? 1.0 : 0.85; gfx_g = next_hov ? 1.0 : 0.70; gfx_b = next_hov ? 1.0 : 0.22;
  gfx_x = rx + col_w - 40; gfx_y = ec_y + 19; gfx_drawstr(">");
  mouse_clicked && next_hov ? (dg_pbi = (dg_pbi + 1) % 25;);

  // Playbook Craft Heuristics Card
  ch_y = ec_y + 56;
