    p_sel = (slider2 == p_idx);
    p_hov = (mouse_x >= bx && mouse_x <= bx + btn_w && mouse_y >= by && mouse_y <= by + btn_h);

    gfx_r = p_sel ? 0.08 : (p_hov ? 0.04 : 0.015);
    gfx_g = p_sel ? 0.12 : (p_hov ? 0.06 : 0.020);
    gfx_b = p_sel ? 0.18 : (p_hov ? 0.09 : 0.028);
    gfx_rect(bx, by, btn_w, btn_h);

    p_sel ? (
      gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;
      gfx_rect(bx, by, btn_w, btn_h, 0);
    ) : (
      gfx_r = 0.25; gfx_g = 0.32; gfx_b = 0.42;
      gfx_rect(bx, by, btn_w, btn_h, 0);
    );

    gfx_setfont(1, "Orbitron", 9.5, 'b');
    gfx_r = p_sel ? 1.0 : 0.75; gfx_g = p_sel ? 0.85 : 0.80; gfx_b = p_sel ? 0.30 : 0.85;
    gfx_x = bx + 6; gfx_y = by + 6;
    lbl = p_idx == 0 ? "00: Unity" :
          p_idx == 1 ? "01: Prenc" :
          p_idx == 2 ? "02: Seigel" :
          p_idx == 3 ? "03: Dolese" :
          p_idx == 4 ? "04: Buster" :
          p_idx == 5 ? "05: Johns" :
          p_idx == 6 ? "06: SplitChain*" :
          p_idx == 7 ? "07: Broco" :
          p_idx == 8 ? "08: Static" :
          p_idx == 9 ? "09: Guaiana" :
          p_idx == 10 ? "10: Tuch" :
          p_idx == 11 ? "11: Savell" :
          p_idx == 12 ? "12: Schmidt" :
          p_idx == 13 ? "13: Ermin" :
          p_idx == 14 ? "14: Putney" :
          p_idx == 15 ? "15: Lever" :
          p_idx == 16 ? "16: Bassal" :
          p_idx == 17 ? "17: Udd" :
          p_idx == 18 ? "18: Dan B" :
          p_idx == 19 ? "19: Cervini" :
          p_idx == 20 ? "20: Bogren" :
          p_idx == 21 ? "21: Nolly" :
          p_idx == 22 ? "22: Acle" :
          p_idx == 23 ? "23: Adam C" : "24: Renner";
    gfx_drawstr(lbl);

    mouse_clicked && p_hov ? (
      slider2 = p_idx;
      apply_producer_preset(p_idx);
      slider_automate();
    );
    p_idx += 1;
  );

  // Right Column: Active Producer Forensic Blueprint Plaque
  bp_x = ws_x + 24 + grid_w;
  bp_w = pm_w - grid_w - 24;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(bp_x, pm_y + 14, bp_w, pm_h - 28);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(bp_x, pm_y + 14, bp_w, pm_h - 28, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.0; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = bp_x + 14; gfx_y = pm_y + 26;
  gfx_drawstr("FORENSIC BENCHMARK BLUEPRINT");

  gfx_setfont(2, "Consolas", 11, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = bp_x + 14; gfx_y = pm_y + 50;
  gfx_printf("TARGET: %s", get_producer_name(slider2));
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = bp_x + 14; gfx_y = pm_y + 68;
  gfx_printf("REF   : %s", get_producer_ref_track(slider2));

  gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85;
  gfx_x = bp_x + 14; gfx_y = pm_y + 94;
  gfx_printf("• Output Trim  : %+3.1f dB (DeeGain Match)", slider4);
  gfx_x = bp_x + 14; gfx_y = pm_y + 114;
  gfx_printf("• Tonal EQ     : 80Hz +%3.1fdB | 202Hz -%3.1fdB", slider19, abs(slider20));
  gfx_x = bp_x + 14; gfx_y = pm_y + 134;
  gfx_printf("• Mid/High Bite: 1.5k +%3.1fdB | 3.0k +%3.1fdB", slider21, slider22);
  gfx_x = bp_x + 14; gfx_y = pm_y + 154;
  gfx_printf("• Air Sheen    : 8.0kHz +%3.1fdB High Shelf", slider31);
  gfx_x = bp_x + 14; gfx_y = pm_y + 174;
  gfx_printf("• Bus Glue VCA : Thresh %4.1fdB | 4:1 | 10ms", slider12);
  gfx_x = bp_x + 14; gfx_y = pm_y + 194;
  gfx_printf("• Sidechain HPF: %d Hz (%s)", slider16, slider16 <= 42 ? "Nolly Snare Cut" : (slider16 <= 65 ? "Guaiana Kick Decouple" : "Sub Decouple"));
  gfx_x = bp_x + 14; gfx_y = pm_y + 214;
  gfx_printf("• Harmonic Desk: Neve 8014 Drive %+3.1f dB", slider24);
  gfx_x = bp_x + 14; gfx_y = pm_y + 234;
