  pl_h = ec_h - (pl_y - ec_y) - 12;
  gfx_r = 0.010; gfx_g = 0.014; gfx_b = 0.020; gfx_rect(rx + 16, pl_y, col_w - 32, pl_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_rect(rx + 16, pl_y, col_w - 32, pl_h, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = rx + 24; gfx_y = pl_y + 8; gfx_drawstr("SIGNATURE REFERENCE SPECIFICATIONS:");

  gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = rx + 24; gfx_y = pl_y + 26;
  gfx_printf("• REFERENCE TRACK: %s", get_producer_ref_track(dg_pbi));
  gfx_x = rx + 24; gfx_y = pl_y + 44;
  gfx_printf("• SIGNATURE HPF  : %d Hz (BUSTERse Sidechain Detector)", dg_pbi == 9 ? 60 : (dg_pbi == 6 || dg_pbi == 21 ? 39 : 45));
  gfx_x = rx + 24; gfx_y = pl_y + 62;
  gfx_printf("• CONSOLE ENGINE : Neve 8014 Iron Desk Vintage Summing");
);

