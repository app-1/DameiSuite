  gfx_x = rx + 18; gfx_y = ch_y; gfx_drawstr("PRODUCER CRAFT HEURISTICS (AUTHENTIC REFERENCE RECIPE):");

  gfx_setfont(2, "Consolas", 11, 'b');
  pb_tip_idx = dg_pbi * 4;
  ti = 0;
  while (ti < 4) (
    t_row_y = ch_y + 22 + ti * 26;
    ti == 0 ? (gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;) :
    ti == 1 ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) :
    ti == 2 ? (gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.30;) : (gfx_r = 0.95; gfx_g = 0.55; gfx_b = 0.90;);
    gfx_x = rx + 20; gfx_y = t_row_y;
    gfx_drawstr("- ");
    gfx_drawstr(dk_tip[pb_tip_idx + ti]);
    ti += 1;
  );

  // Button: Load This Palette Into The Director
  load_y = ch_y + 136;
  load_hov = (mouse_x >= rx + 16 && mouse_x <= rx + col_w - 16 && mouse_y >= load_y && mouse_y <= load_y + 32);
  gfx_r = load_hov ? 0.10 : 0.04; gfx_g = load_hov ? 0.25 : 0.10; gfx_b = load_hov ? 0.35 : 0.15;
  gfx_rect(rx + 16, load_y, col_w - 32, 32);
  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22; gfx_rect(rx + 16, load_y, col_w - 32, 32, 0);

  gfx_setfont(1, "Orbitron", 11, 'b'); gfx_r = 1.0; gfx_g = 0.9; gfx_b = 0.5;
  btn_lbl = "LOAD THIS PALETTE INTO THE DIRECTOR";
  gfx_measurestr(btn_lbl, blw, blh);
  gfx_x = rx + 16 + floor((col_w - 32 - blw) * 0.5); gfx_y = load_y + floor((32 - blh) * 0.5);
  gfx_drawstr(btn_lbl);

  mouse_clicked && load_hov ? (
    slider2 = dg_pbi;
    apply_producer_preset(dg_pbi);
    slider_automate();
  );

  // Auto-Follow Toggle Button
  af_y = load_y + 40;
  af_hov = (mouse_x >= rx + 16 && mouse_x <= rx + col_w - 16 && mouse_y >= af_y && mouse_y <= af_y + 28);
  gfx_r = slider51 ? 0.08 : 0.02; gfx_g = slider51 ? 0.20 : 0.03; gfx_b = slider51 ? 0.12 : 0.04;
  gfx_rect(rx + 16, af_y, col_w - 32, 28);
  gfx_r = slider51 ? 0.15 : 0.35; gfx_g = slider51 ? 0.95 : 0.45; gfx_b = slider51 ? 0.45 : 0.55;
  gfx_rect(rx + 16, af_y, col_w - 32, 28, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b');
