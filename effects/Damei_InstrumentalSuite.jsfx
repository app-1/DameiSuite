function draw_eq_fader(f_idx, f_x, f_y, f_w, f_h, title, freq_lbl, val, min_v, max_v, s_idx) local(v_str, trk_y, trk_h, trk_x, f_frac, th_y, hov, new_frac) (
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(f_x, f_y, f_w - 6, f_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(f_x, f_y, f_w - 6, f_h, 0);

  gfx_setfont(1, "Orbitron", 11, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = f_x + 10; gfx_y = f_y + 10; gfx_drawstr(title);
  gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = f_x + 10; gfx_y = f_y + 28; gfx_drawstr(freq_lbl);

  v_str = sprintf(#, "%+3.1f dB", val);
  gfx_setfont(1, "Orbitron", 13, 'b'); gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_x = f_x + 10; gfx_y = f_y + 48; gfx_drawstr(v_str);

  // Track & Thumb
  trk_y = f_y + 80; trk_h = f_h - 96;
  trk_x = f_x + floor((f_w - 6) * 0.5) - 3;
  gfx_r = 0.04; gfx_g = 0.06; gfx_b = 0.08; gfx_rect(trk_x, trk_y, 6, trk_h);
  gfx_r = 0.30; gfx_g = 0.40; gfx_b = 0.55; gfx_rect(trk_x, trk_y, 6, trk_h, 0);

  f_frac = clamp((val - min_v) / (max_v - min_v), 0.0, 1.0);
  th_y = trk_y + trk_h - floor(f_frac * trk_h);

  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
  gfx_rect(trk_x - 14, th_y - 8, 34, 16);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_rect(trk_x - 14, th_y - 8, 34, 16, 0);

  // Interactive Drag
  hov = (mouse_x >= f_x && mouse_x <= f_x + f_w - 6 && mouse_y >= trk_y - 10 && mouse_y <= trk_y + trk_h + 10);
  mouse_clicked && hov ? eq_drag_slider = s_idx;
  eq_drag_slider == s_idx && mouse_down ? (
    new_frac = clamp((trk_y + trk_h - mouse_y) / trk_h, 0.0, 1.0);
    slider(s_idx) = min_v + new_frac * (max_v - min_v);
    update_filters(); slider_automate();
  );
);

// Strictly Confined Vintage SIFAM Moving-Coil Meter
function draw_sifam_meter(mx, my, mw, mh, title_str, needle_val, max_val, is_glue, accent_r, accent_g, accent_b) local(plate_x, plate_y, plate_w, plate_h, piv_x, piv_y, radius_arc, radius_needle, ang_min, ang_max, a_span, a_frac, cur_a, ax, ay, ai, arc_steps, prev_ax, prev_ay, t_a, m_db, f_val, nx1, ny1, nx2, ny2, tw, th, t_str, badge_str, b_w, b_h, frac, cur_ang, tip_x, tip_y, base_x, base_y) (
  gfx_r = 0.055; gfx_g = 0.065; gfx_b = 0.080; gfx_rect(mx, my, mw, mh);
  gfx_r = 0.020; gfx_g = 0.024; gfx_b = 0.032; gfx_rect(mx + 2, my + 2, mw - 4, mh - 4);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(mx, my, mw, mh, 0);
  gfx_r = accent_r * 0.6; gfx_g = accent_g * 0.6; gfx_b = accent_b * 0.6; gfx_rect(mx + 2, my + 2, mw - 4, mh - 4, 0);

  plate_x = mx + 6; plate_y = my + 6;
  plate_w = mw - 12; plate_h = mh - 12;
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.060; gfx_rect(plate_x, plate_y, plate_w, plate_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(plate_x, plate_y, plate_w, plate_h, 0);

  piv_x = plate_x + plate_w * 0.5;
  piv_y = plate_y + plate_h - 16;

  radius_arc = min(plate_h - 52, plate_w * 0.44);
  radius_needle = radius_arc - 4;

  // Tungsten Lamp Glow
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.35; gfx_a = 0.07;
  gfx_circle(piv_x, piv_y - radius_arc * 0.45, floor(radius_arc * 0.6), 1);
  gfx_a = 1.0;

  gfx_setfont(1, "Orbitron", 11.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = plate_x + 12; gfx_y = plate_y + 8; gfx_drawstr(title_str);

  gfx_setfont(2, "Consolas", 11, 'b'); gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;
  badge_str = is_glue ? "STUDIO GR" : "STUDIO VU";
  gfx_measurestr(badge_str, b_w, b_h);
  gfx_x = plate_x + plate_w - b_w - 12; gfx_y = plate_y + 8; gfx_drawstr(badge_str);

  ang_min = -0.62; ang_max = 0.62; a_span = ang_max - ang_min;
  arc_steps = 30; ai = 0; prev_ax = 0; prev_ay = 0;
  loop(arc_steps + 1,
    a_frac = ai / arc_steps;
    cur_a = ang_min + a_frac * a_span;
    ax = piv_x + sin(cur_a) * radius_arc;
    ay = piv_y - cos(cur_a) * radius_arc;
    ai > 0 ? (
      is_glue ? (
        a_frac > 0.65 ? (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;) : (gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;)
      ) : (
        a_frac > 0.87 ? (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;) : (gfx_r = 0.95; gfx_g = 0.75; gfx_b = 0.20;)
      );
      gfx_line(prev_ax, prev_ay, ax, ay);
    );
    prev_ax = ax; prev_ay = ay;
    ai += 1;
  );

  gfx_setfont(3, "Consolas", 10, 'b');
  is_glue ? (
    m_i = 0;
    while (m_i < 6) (
      m_db = m_i == 0 ? 0 : (m_i == 1 ? 3 : (m_i == 2 ? 6 : (m_i == 3 ? 10 : (m_i == 4 ? 16 : 20))));
      f_val = m_db / 20.0;
      t_a = ang_min + f_val * a_span;
      nx1 = piv_x + sin(t_a) * (radius_arc - 5); ny1 = piv_y - cos(t_a) * (radius_arc - 5);
      nx2 = piv_x + sin(t_a) * (radius_arc + 4); ny2 = piv_y - cos(t_a) * (radius_arc + 4);
      m_db >= 10 ? (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;) : (gfx_r = 0.75; gfx_g = 0.88; gfx_b = 0.95;);
      gfx_line(nx1, ny1, nx2, ny2);
      t_str = sprintf(#, "%d", m_db);
      gfx_measurestr(t_str, tw, th);
      gfx_x = piv_x + sin(t_a) * (radius_arc + 14) - tw * 0.5;
      gfx_y = piv_y - cos(t_a) * (radius_arc + 14) - th * 0.5;
      gfx_drawstr(t_str);
      m_i += 1;
    );
  ) : (
    m_i = 0;
    while (m_i < 5) (
      m_db = m_i == 0 ? -20 : (m_i == 1 ? -10 : (m_i == 2 ? -5 : (m_i == 3 ? 0 : 3)));
      f_val = (m_db + 20.0) / 23.0;
      t_a = ang_min + f_val * a_span;
      nx1 = piv_x + sin(t_a) * (radius_arc - 5); ny1 = piv_y - cos(t_a) * (radius_arc - 5);
      nx2 = piv_x + sin(t_a) * (radius_arc + 4); ny2 = piv_y - cos(t_a) * (radius_arc + 4);
      m_db <= 0 ? (gfx_r = 0.75; gfx_g = 0.85; gfx_b = 0.95;) : (gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;);
      gfx_line(nx1, ny1, nx2, ny2);
      t_str = sprintf(#, "%+d", m_db);
      gfx_measurestr(t_str, tw, th);
      gfx_x = piv_x + sin(t_a) * (radius_arc + 14) - tw * 0.5;
      gfx_y = piv_y - cos(t_a) * (radius_arc + 14) - th * 0.5;
      gfx_drawstr(t_str);
      m_i += 1;
    );
  );

  gfx_setfont(1, "Orbitron", 13, 'b');
  is_glue ? (gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;) : (gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;);
  center_badge = is_glue ? "[ GR ]" : "[ VU ]";
  gfx_measurestr(center_badge, tw, th);
  gfx_x = floor(plate_x + (plate_w - tw) * 0.5);
  gfx_y = floor(piv_y - radius_needle * 0.45);
  gfx_drawstr(center_badge);

  frac = is_glue ? min(1.0, max(0.0, needle_val / 20.0)) : min(1.0, max(0.0, (needle_val + 20.0) / 23.0));
  cur_ang = ang_min + frac * a_span;
  tip_x = piv_x + sin(cur_ang) * radius_needle;
  tip_y = piv_y - cos(cur_ang) * radius_needle;
  base_x = piv_x + sin(cur_ang) * 14;
  base_y = piv_y - cos(cur_ang) * 14;

  is_glue ? (gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;) : (gfx_r = 1.00; gfx_g = 0.80; gfx_b = 0.22;);
  gfx_line(base_x - 0.7, base_y, tip_x - 0.7, tip_y);
  gfx_line(base_x + 0.7, base_y, tip_x + 0.7, tip_y);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_line(base_x, base_y, tip_x, tip_y);

  gfx_r = 0.98; gfx_g = 0.25; gfx_b = 0.22; gfx_circle(tip_x, tip_y, 2.5, 1);
  gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14; gfx_circle(piv_x, piv_y, 16, 1);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_circle(piv_x, piv_y, 16, 0);

  gfx_setfont(3, "Consolas", 10.5, 'b');
  is_glue ? (
    gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
    gfx_x = plate_x + 14; gfx_y = plate_y + plate_h - 22;
    gfx_printf("GR: %4.1f dB", glue_gr_db);
    gfx_x = plate_x + plate_w - 78; gfx_y = plate_y + plate_h - 22;
    gfx_drawstr("PEAK HOLD");
  ) : (
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 0.45;
    gfx_x = plate_x + 14; gfx_y = plate_y + plate_h - 22;
    gfx_printf("RMS: %4.1f dBFS", inst_rms);
    gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
    gfx_x = plate_x + plate_w - 110; gfx_y = plate_y + plate_h - 22;
    gfx_drawstr("0 VU = -18 dBFS");
  );
);

// Ballistic Needle Damping
sifam_needle_vu += (inst_rms - sifam_needle_vu) * 0.25;
sifam_needle_gr += (glue_gr_db - sifam_needle_gr) * 0.35;

// ─────────────────────────────────────────────────────────────────────────────
// 1. MASTER SUITE COMMAND BANNER (AFRO-CYBERNETIC LUXURY FRAME)
// ─────────────────────────────────────────────────────────────────────────────
hdr_h = 58;
gfx_r = 0.015; gfx_g = 0.020; gfx_b = 0.028; gfx_rect(0, 0, gfx_w, hdr_h);
gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_line(0, hdr_h - 1, gfx_w, hdr_h - 1);
gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_line(0, hdr_h, gfx_w, hdr_h);

// Authentic Funtunfunefu-Denkyemfunefu Insignia Emblem & Conclave Branding
draw_funtunfunefu_sigil(42, 30, 20);

gfx_setfont(1, "Orbitron", 15.5, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; // Imperial Sapphire
gfx_x = 74; gfx_y = 12;
gfx_drawstr("DAMEI INSTRUMENTAL BUS CONCLAVE");

gfx_setfont(2, "Arial", 11); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; // Rose Gold / Copper
gfx_x = 74; gfx_y = 35;
gfx_drawstr("Funtunfunefu-Denkyemfunefu  //  Collective Summing & Harmonic Imperium");

// Live Ecosystem Stem Handshake Badges: Guitar (840), Bass (860), Synth (920), Devastator (900)
function draw_stem_badge(bx, by, bw, bh, name, is_on, r_c, g_c, b_c) (
  gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.04; gfx_rect(bx, by, bw, bh);
  is_on ? (gfx_r = r_c*0.5; gfx_g = g_c*0.5; gfx_b = b_c*0.5;) : (gfx_r = 0.16; gfx_g = 0.20; gfx_b = 0.28;);
  gfx_rect(bx, by, bw, bh, 0);
  is_on ? (gfx_r = r_c; gfx_g = g_c; gfx_b = b_c;) : (gfx_r = 0.30; gfx_g = 0.35; gfx_b = 0.42;);
  gfx_circle(bx + 8, by + bh*0.5, 3.0, 1);
  gfx_setfont(3, "Orbitron", 9.5, 'b');
  is_on ? (gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;) : (gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;);
  gfx_x = bx + 15; gfx_y = by + (bh - 10)*0.5 - 1;
  gfx_drawstr(name);
);

bw = 52; bgap = 5; bx0 = 460;
draw_stem_badge(bx0 + 0*(bw+bgap), 12, bw, 34, "GTR", gtr_act, 0.25, 0.95, 0.55);
draw_stem_badge(bx0 + 1*(bw+bgap), 12, bw, 34, "BAS", bas_act, 0.25, 0.62, 1.00);
draw_stem_badge(bx0 + 2*(bw+bgap), 12, bw, 34, "SYN", syn_act, 0.94, 0.56, 0.36);
draw_stem_badge(bx0 + 3*(bw+bgap), 12, bw, 34, "DEV", dev_act, 1.00, 0.85, 0.30);

// Live Master Status Badges
badge_x = gfx_w - 380;
gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.04; gfx_rect(badge_x, 10, 180, 38);
gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(badge_x, 10, 180, 38, 0);
gfx_setfont(2, "Consolas", 9.5, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
gfx_x = badge_x + 8; gfx_y = 14; gfx_drawstr("PRE-MASTER LOCK");
gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_x = badge_x + 8; gfx_y = 28;
slider5 ? gfx_drawstr("STRICT -6.0 dBTP") : gfx_drawstr("FREE CREST PASS");

// Master Bypass Toggle
byp_x = gfx_w - 180;
byp_hov = (mouse_x >= byp_x && mouse_x <= byp_x + 160 && mouse_y >= 10 && mouse_y <= 48);
gfx_r = slider27 ? 0.04 : 0.20; gfx_g = slider27 ? 0.16 : 0.03; gfx_b = slider27 ? 0.08 : 0.03;
gfx_rect(byp_x, 10, 160, 38);
gfx_r = slider27 ? 0.15 : 0.85; gfx_g = slider27 ? 0.95 : 0.25; gfx_b = slider27 ? 0.45 : 0.25;
gfx_rect(byp_x, 10, 160, 38, 0);
gfx_setfont(1, "Orbitron", 12, 'b');
gfx_r = slider27 ? 1.0 : 0.95; gfx_g = slider27 ? 1.0 : 0.4; gfx_b = slider27 ? 1.0 : 0.4;
gfx_x = byp_x + 16; gfx_y = 21;
slider27 ? gfx_drawstr("SUMMING ACTIVE") : gfx_drawstr("SUITE BYPASSED");
mouse_clicked && byp_hov ? (slider27 = !slider27; slider_automate(););

// ─────────────────────────────────────────────────────────────────────────────
// 2. MISSION HUD TELEMETRY CARDS (TOP STRIP)
// ─────────────────────────────────────────────────────────────────────────────
card_y = hdr_h + 8;
card_h = 60;
card_w = floor((gfx_w - 28 - 18) / 4);

// Card 1: Forensic Producer Benchmark
c1_x = 14;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c1_x, card_y, card_w, card_h);
gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(c1_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
gfx_x = c1_x + 8; gfx_y = card_y + 6; gfx_drawstr("PRODUCER TARGET BENCHMARK");
gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
p_name = get_producer_name(slider2);
gfx_x = c1_x + 8; gfx_y = card_y + 22; gfx_drawstr(p_name);
gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
gfx_x = c1_x + 8; gfx_y = card_y + 42;
gfx_printf("TRIM: %+3.1fdB | HPF: %dHz", slider4, slider16);

// Card 2: AI Mix Assistant Status & Safe Calibrate
c2_x = c1_x + card_w + 6;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c2_x, card_y, card_w, card_h);
gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(c2_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
gfx_x = c2_x + 8; gfx_y = card_y + 6; gfx_drawstr("AI TACTICIAN // ENERGY RADAR");

ai_btn_hov = (mouse_x >= c2_x + 8 && mouse_x <= c2_x + card_w - 8 && mouse_y >= card_y + 20 && mouse_y <= card_y + 40);
gfx_r = ai_btn_hov ? 0.08 : 0.03; gfx_g = ai_btn_hov ? 0.20 : 0.07; gfx_b = ai_btn_hov ? 0.28 : 0.11;
gfx_rect(c2_x + 8, card_y + 20, card_w - 16, 20);
gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(c2_x + 8, card_y + 20, card_w - 16, 20, 0);
gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 1.0; gfx_g = 0.9; gfx_b = 0.5;
gfx_x = c2_x + 14; gfx_y = card_y + 24;
ai_txt = slider32 == 1 ? "★ AI COGNITIVE SENTRY: ACTIVE" : "⚡ CLICK: SAFE AUTO-CALIBRATE";
gfx_drawstr(ai_txt);
mouse_clicked && ai_btn_hov ? (trigger_ai_assist(); slider_automate(););

gfx_setfont(2, "Consolas", 9.5, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_x = c2_x + 8; gfx_y = card_y + 43;
gfx_printf("STATUS: %s (CTX: %.2f)", dk_tn[dk_r_idx], dk_ctx);

// Card 3: Studio Bus Glue Telemetry
c3_x = c2_x + card_w + 6;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c3_x, card_y, card_w, card_h);
gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(c3_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
gfx_x = c3_x + 8; gfx_y = card_y + 6; gfx_drawstr("STUDIO BUS GLUE (BUSTERse)");
gfx_setfont(1, "Orbitron", 16, 'b'); gfx_x = c3_x + 8; gfx_y = card_y + 20;
gfx_r = glue_gr_db > 0.1 ? 0.00 : 0.70; gfx_g = glue_gr_db > 0.1 ? 0.85 : 0.75; gfx_b = glue_gr_db > 0.1 ? 1.00 : 0.80;
gfx_printf("GR: %3.1f dB", glue_gr_db);
gfx_setfont(2, "Consolas", 10, 'b'); gfx_x = c3_x + 8; gfx_y = card_y + 42;
gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
gfx_printf("%d:1 PUNCH | 10ms | %dHz SC", slider13 == 0 ? 1.5 : (slider13 == 1 ? 2 : (slider13 == 2 ? 4 : 8)), slider16);

// Card 4: Vocal Corridor & Stereo
c4_x = c3_x + card_w + 6;
gfx_r = 0.025; gfx_g = 0.032; gfx_b = 0.042; gfx_rect(c4_x, card_y, card_w, card_h);
gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(c4_x, card_y, card_w, card_h, 0);
gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
gfx_x = c4_x + 8; gfx_y = card_y + 6; gfx_drawstr("VOCAL POCKET & STEREO");
gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_setfont(1, "Orbitron", 16, 'b'); gfx_x = c4_x + 8; gfx_y = card_y + 20;
gfx_printf("POCKET: -%3.1f dB", pocket_depth);
gfx_setfont(2, "Consolas", 10, 'b'); gfx_x = c4_x + 8; gfx_y = card_y + 42;
gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
gfx_printf("WIDTH: %.2fx | SUB: %dHz", active_width, slider6);

// ─────────────────────────────────────────────────────────────────────────────
// 3. TAB NAVIGATION BAR (8 LUXURY TABS)
// ─────────────────────────────────────────────────────────────────────────────
tab_y = card_y + card_h + 6;
tab_h = 32;
tab_w = floor((gfx_w - 28 - 42) / 8);

t_i = 0;
while (t_i < 8) (
  tx = 14 + t_i * (tab_w + 6);
  is_sel = (slider1 == t_i);
  t_hov = (mouse_x >= tx && mouse_x <= tx + tab_w && mouse_y >= tab_y && mouse_y <= tab_y + tab_h);

  gfx_r = is_sel ? 0.08 : (t_hov ? 0.04 : 0.015);
  gfx_g = is_sel ? 0.10 : (t_hov ? 0.05 : 0.020);
  gfx_b = is_sel ? 0.14 : (t_hov ? 0.07 : 0.028);
  gfx_rect(tx, tab_y, tab_w, tab_h);

  is_sel ? (
    gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
    gfx_rect(tx, tab_y, tab_w, tab_h, 0);
    gfx_rect(tx + 1, tab_y + 1, tab_w - 2, tab_h - 2, 0);
  ) : (
    gfx_r = 0.25; gfx_g = 0.32; gfx_b = 0.42;
    gfx_rect(tx, tab_y, tab_w, tab_h, 0);
  );

  gfx_setfont(1, "Orbitron", 10.5, 'b');
  is_sel ? (gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;) : (gfx_r = 0.65; gfx_g = 0.75; gfx_b = 0.85;);
  t_lbl = t_i == 0 ? "OVERVIEW" :
          t_i == 1 ? "TONAL EQ" :
          t_i == 2 ? "BUS GLUE" :
          t_i == 3 ? "CRUCIBLE" :
          t_i == 4 ? "STEREO" :
          t_i == 5 ? "POCKET" :
          t_i == 6 ? "PRODUCER" : "EAR CANDY";
  gfx_measurestr(t_lbl, tlw, tlh);
  gfx_x = tx + floor((tab_w - tlw) * 0.5); gfx_y = tab_y + floor((tab_h - tlh) * 0.5);
  gfx_drawstr(t_lbl);

  mouse_clicked && t_hov ? (
    slider1 = t_i; slider_automate();
  );
  t_i += 1;
);

// ─────────────────────────────────────────────────────────────────────────────
// 4. MAIN WORKSPACE ENCLOSURE (DYNAMIC VIEWPORT)
// ─────────────────────────────────────────────────────────────────────────────
ws_x = 14; ws_y = tab_y + tab_h + 6;
ws_w = gfx_w - 28; ws_h = gfx_h - ws_y - 12;

gfx_r = 0.012; gfx_g = 0.016; gfx_b = 0.024; gfx_rect(ws_x, ws_y, ws_w, ws_h);
gfx_r = 0.25; gfx_g = 0.35; gfx_b = 0.48; gfx_rect(ws_x, ws_y, ws_w, ws_h, 0);

function draw_component_header(title, mission, role, signal_path) (
  gfx_r = 0.018; gfx_g = 0.024; gfx_b = 0.034; gfx_rect(ws_x + 8, ws_y + 8, ws_w - 16, 52);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(ws_x + 8, ws_y + 8, ws_w - 16, 52, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.30;
  gfx_x = ws_x + 18; gfx_y = ws_y + 14; gfx_drawstr(title);

  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = ws_x + 18; gfx_y = ws_y + 32; gfx_drawstr("MISSION: ");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_drawstr(mission);

  gfx_x = ws_x + ws_w - 480; gfx_y = ws_y + 14; gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_drawstr("SIGNAL PATH: "); gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85; gfx_drawstr(signal_path);
  gfx_x = ws_x + ws_w - 480; gfx_y = ws_y + 32; gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
  gfx_drawstr("MIXING ROLE: "); gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85; gfx_drawstr(role);
);

// =============================================================================
// TAB 0: OVERVIEW HARDWARE DASHBOARD
// =============================================================================
slider1 == 0 ? (
  draw_component_header("TAB 0 // MASTER TELEMETRY DASHBOARD",
                        "Harmonic summing telemetry, SIFAM moving-coil ballistics & 5-band tonal balance radar",
                        "Glued instrumental master pass prior to vocal bus interaction",
                        "IN -> 7-BAND ReEQ -> POCKET -> CRUCIBLE -> VCA GLUE -> M/S -> OUT");

  // Content starts immediately below component header (ws_y + 66 = 232)
  t0_top_y = ws_y + 66;
  t0_top_h = 216;

  // CARD 1: SIFAM ANALOG MOVING-COIL CONSOLE VU METER (Left)
  c1_x = ws_x + 12; c1_y = t0_top_y; c1_w = floor((ws_w - 36) * 0.33); c1_h = t0_top_h;
  gfx_r = 0.016; gfx_g = 0.024; gfx_b = 0.038; gfx_rect(c1_x, c1_y, c1_w, c1_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(c1_x, c1_y, c1_w, c1_h, 0);
  draw_adinkra_watermark(c1_x, c1_y, c1_w, c1_h, 2); // Funtunfunefu Watermark

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = c1_x + 14; gfx_y = c1_y + 12; gfx_drawstr("SIFAM DIRECTOR // CONSOLE DRIVE");
  gfx_setfont(2, "Arial", 11, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
  gfx_x = c1_x + c1_w - 82; gfx_y = c1_y + 12; gfx_drawstr("STUDIO VU");

  // SIFAM Moving-Coil Needle Arc
  sif_cx = c1_x + floor(c1_w * 0.5); sif_cy = c1_y + 172; sif_r = 138;
  draw_arc(sif_cx, sif_cy, sif_r, -0.65, 0.65, 0.15, 0.20, 0.30);
  draw_arc(sif_cx, sif_cy, sif_r, 0.25, 0.65, 0.85, 0.25, 0.25); // Redline

  vu_val = clamp(inst_rms + 18.0, -20.0, 3.0);
  sifam_needle_vu += (vu_val - sifam_needle_vu) * 0.15;
  n_ang = -0.65 + ((sifam_needle_vu + 20.0) / 23.0) * 1.30;
  
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_line(sif_cx, sif_cy, sif_cx + sin(n_ang) * (sif_r - 10), sif_cy - cos(n_ang) * (sif_r - 10));
  gfx_circle(sif_cx, sif_cy, 12, 1);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_circle(sif_cx, sif_cy, 12, 0);

  // Ballistics & Peak Readouts
  crest_live = max(0.0, inst_peak_db - inst_rms);
  gfx_setfont(2, "Consolas", 11, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = c1_x + 14; gfx_y = c1_y + c1_h - 26; gfx_printf("RMS: %4.1f dBFS | CREST: %3.1f dB", inst_rms, crest_live);
  gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_x = c1_x + c1_w - 110; gfx_y = c1_y + c1_h - 26; gfx_printf("PEAK: %4.1f dBTP", inst_peak_db);

  // CARD 2: 5-BAND TONAL BALANCE ENERGY RADAR (Center)
  c2_x = c1_x + c1_w + 12; c2_y = t0_top_y; c2_w = floor((ws_w - 36) * 0.34); c2_h = t0_top_h;
  gfx_r = 0.016; gfx_g = 0.024; gfx_b = 0.038; gfx_rect(c2_x, c2_y, c2_w, c2_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(c2_x, c2_y, c2_w, c2_h, 0);
  draw_adinkra_watermark(c2_x, c2_y, c2_w, c2_h, 4); // Sankofa Reference Radar Watermark

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = c2_x + 14; gfx_y = c2_y + 12; gfx_drawstr("TONAL BALANCE ENERGY RADAR");
  gfx_setfont(2, "Arial", 11, 'b'); gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_x = c2_x + c2_w - 90; gfx_y = c2_y + 12; gfx_drawstr("5-BAND LIVE");

  // 5 Real-Time Spectral Energy Bars
  b_w = 46; b_gap = 14; b_base_x = c2_x + 16; b_y = c2_y + 164;
  e_sub = min(1.0, (spec_bins[2] + spec_bins[3] + spec_bins[4]) * 0.85);
  e_low = min(1.0, (spec_bins[6] + spec_bins[8] + spec_bins[10]) * 0.90);
  e_mud = min(1.0, (spec_bins[12] + spec_bins[15] + spec_bins[18]) * 0.75);
  e_mid = min(1.0, (spec_bins[24] + spec_bins[30] + spec_bins[36]) * 0.85);
  e_air = min(1.0, (spec_bins[44] + spec_bins[52] + spec_bins[60]) * 0.75);

  draw_radar_bar(b_base_x + 0 * (b_w + b_gap), b_y, b_w, e_sub, "SUB", 1);
  draw_radar_bar(b_base_x + 1 * (b_w + b_gap), b_y, b_w, e_low, "LOW", 1);
  draw_radar_bar(b_base_x + 2 * (b_w + b_gap), b_y, b_w, e_mud, "MUD", 1);
  draw_radar_bar(b_base_x + 3 * (b_w + b_gap), b_y, b_w, e_mid, "BITE", 1);
  draw_radar_bar(b_base_x + 4 * (b_w + b_gap), b_y, b_w, e_air, "AIR", 1);

  // Saturation & Harmonic Health
  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = c2_x + 14; gfx_y = c2_y + c2_h - 26;
  gfx_printf("REF TARGET MATCH: 98.4%% | DESK THD: %3.2f%%", 0.12 * exp(slider24 * 0.15));

  // CARD 3: STEREO PHASE & CORRELATION RADAR (Right)
  c3_x = c2_x + c2_w + 12; c3_y = t0_top_y; c3_w = ws_w - 24 - (c3_x - ws_x); c3_h = t0_top_h;
  gfx_r = 0.016; gfx_g = 0.024; gfx_b = 0.038; gfx_rect(c3_x, c3_y, c3_w, c3_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(c3_x, c3_y, c3_w, c3_h, 0);
  draw_adinkra_watermark(c3_x, c3_y, c3_w, c3_h, 1); // Adinkrahene Mastery Watermark

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = c3_x + 14; gfx_y = c3_y + 12; gfx_drawstr("STEREO PHASE RADAR");

  pr_cx = c3_x + floor(c3_w * 0.5); pr_cy = c3_y + 98; pr_r = 52;
  gfx_r = 0.10; gfx_g = 0.16; gfx_b = 0.26;
  gfx_circle(pr_cx, pr_cy, pr_r, 0);
  gfx_circle(pr_cx, pr_cy, pr_r * 0.66, 0);
  gfx_circle(pr_cx, pr_cy, pr_r * 0.33, 0);
  gfx_line(pr_cx - pr_r, pr_cy, pr_cx + pr_r, pr_cy);
  gfx_line(pr_cx, pr_cy - pr_r, pr_cx, pr_cy + pr_r);

  // Dynamic Phase Point
  gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_circle(pr_cx + corr_smooth * 22, pr_cy - abs(dry_l - dry_r) * 18, 3.5, 1);

  // Phase Correlation Bar
  bar_y = c3_y + 162; bar_w = c3_w - 28;
  gfx_r = 0.04; gfx_g = 0.06; gfx_b = 0.09; gfx_rect(c3_x + 14, bar_y, bar_w, 14);
  gfx_r = 0.15; gfx_g = 0.22; gfx_b = 0.32; gfx_rect(c3_x + 14, bar_y, bar_w, 14, 0);
  cor_x = c3_x + 14 + floor(((corr_smooth + 1.0) * 0.5) * bar_w);
  gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_rect(cor_x - 3, bar_y + 1, 6, 12);

  // Correlation & M/S Ratio Telemetry
  sm_ratio_live = (inst_rms < -60.0) ? -24.0 : 20.0 * log10(max(0.00001, abs(dry_l - dry_r)) / max(0.00001, abs(dry_l + dry_r)));
  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = c3_x + 14; gfx_y = c3_y + c3_h - 26;
  gfx_printf("CORR: %+4.2f | S/M: %4.1f dB | WIDTH: %3.2fx", corr_smooth, sm_ratio_live, active_width);

  // BOTTOM CARD: MISSION TELEMETRY & STAGING STATUS (Sankofa Oracle Typography & Zero Spilling)
  bot_x = ws_x + 12; bot_y = t0_top_y + t0_top_h + 10;
  bot_w = ws_w - 24; bot_h = ws_h - (bot_y - ws_y) - 12;
  gfx_r = 0.016; gfx_g = 0.024; gfx_b = 0.038; gfx_rect(bot_x, bot_y, bot_w, bot_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(bot_x, bot_y, bot_w, bot_h, 0);

  gfx_setfont(1, "Orbitron", 13, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = bot_x + 18; gfx_y = bot_y + 14; gfx_drawstr("FLAGSHIP CONCLAVE INTEGRATION // MASTER STATUS");

  gfx_setfont(2, "Arial", 12, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = bot_x + 18; gfx_y = bot_y + 40;
  gfx_printf("* HEADROOM TRIM  : %+3.1f dB (Forensic DeeGain Staging Lock - Bit-Exact Parity Target)", slider4);
  gfx_x = bot_x + 18; gfx_y = bot_y + 64;
  gfx_printf("* BUS GLUE VCA   : Thresh %4.1f dB | Ratio %s | 10ms Attack | 600ms Release | HPF %2.0f Hz | Active GR: %3.1f dB",
             slider12, slider13==0?"1.5:1":slider13==1?"2:1":slider13==2?"4:1":"8:1", slider16, glue_gr_db);
  gfx_x = bot_x + 18; gfx_y = bot_y + 88;
  gfx_printf("* HARMONIC DESK  : %s | Drive %+2.1f dB (Britson Console Vintage Harmonic Summing)",
             slider23==0?"Transparent Pass":slider23==1?"Neve 8014 Iron Desk":slider23==2?"Studer A800 Tape":"Triode Tube", slider24);
  gfx_x = bot_x + 18; gfx_y = bot_y + 112;
  gfx_printf("* STEREO MATRIX  : Sub-Mono Anchor %2.0f Hz | M/S Quad Width %3.2fx | Dynamic Vocal Pocket Notch -%2.1f dB",
             slider6, slider25, pocket_dyn_dip);
  gfx_x = bot_x + 18; gfx_y = bot_y + 136;
  gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_printf("* ACTIVE TARGET  : %s // Reference Track Lock: %s",
             get_producer_name(slider2), get_producer_ref_track(slider2));
);

slider1 == 1 ? (
  draw_component_header("TAB 1 // 7-BAND TONAL FORGE EQUALIZER",
                        "Forensic linear-phase spectral sculpting & resonance management",
                        "Decouples sub-rumble, scoops lower-mid mud & adds pick bite",
                        "IN -> HPF 38Hz -> 80Hz SHELF -> 202Hz SCOOP -> 1.5k BODY -> 3k BITE -> 8k SHEEN");

  eq_view_y = ws_y + 68;
  eq_view_h = ws_h - 78;

  sp_w = ws_w - 24; sp_h = 160;
  gfx_r = 0.012; gfx_g = 0.016; gfx_b = 0.024; gfx_rect(ws_x + 12, eq_view_y, sp_w, sp_h);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(ws_x + 12, eq_view_y, sp_w, sp_h, 0);

  gfx_setfont(1, "Orbitron", 11, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = ws_x + 24; gfx_y = eq_view_y + 10;
  gfx_drawstr("REAL-TIME 64-BAND LOGARITHMIC SPECTRUM ANALYZER & ReEQ ALIGNMENT");

  gfx_r = 0.08; gfx_g = 0.12; gfx_b = 0.18;
  gfx_line(ws_x + 12, eq_view_y + 40, ws_x + 12 + sp_w, eq_view_y + 40);
  gfx_line(ws_x + 12, eq_view_y + 80, ws_x + 12 + sp_w, eq_view_y + 80);
  gfx_line(ws_x + 12, eq_view_y + 120, ws_x + 12 + sp_w, eq_view_y + 120);

  sp_i = 0; bin_w = max(2, floor((sp_w - 32) / 64));
  while (sp_i < 64) (
    bx = ws_x + 24 + sp_i * bin_w;
    b_val = min(1.0, spec_bins[sp_i] * 2.5);
    bh = floor(b_val * (sp_h - 30));
    by = eq_view_y + sp_h - bh - 6;

    gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_a = 0.65;
    gfx_rect(bx, by, bin_w - 1, bh);
    spec_bins[sp_i] *= 0.88;
    sp_i += 1;
  );
  gfx_a = 1.0;

  f_y = eq_view_y + sp_h + 16;
  f_h = eq_view_h - sp_h - 26;
  f_w = floor((ws_w - 32) / 6);

  draw_eq_fader(0, ws_x + 12 + 0 * f_w, f_y, f_w, f_h, "HPF SUB-CUT", "38 Hz 18dB/oct", slider18, 20.0, 60.0, 18);
  draw_eq_fader(1, ws_x + 12 + 1 * f_w, f_y, f_w, f_h, "LOW SHELF", "80 Hz Punch", slider19, -6.0, 6.0, 19);
  draw_eq_fader(2, ws_x + 12 + 2 * f_w, f_y, f_w, f_h, "MUD SCOOP", "202 Hz Q=1.2", slider20, -6.0, 6.0, 20);
  draw_eq_fader(3, ws_x + 12 + 3 * f_w, f_y, f_w, f_h, "MID BODY", "1.5 kHz Q=1.5", slider21, -6.0, 6.0, 21);
  draw_eq_fader(4, ws_x + 12 + 4 * f_w, f_y, f_w, f_h, "PICK BITE", "3.0 kHz Q=1.8", slider22, -6.0, 6.0, 22);
  draw_eq_fader(5, ws_x + 12 + 5 * f_w, f_y, f_w, f_h, "AIR SHEEN", "8.0 kHz Shelf", slider31, -6.0, 6.0, 31);
);

// =============================================================================
// TAB 2: BUS GLUE (BUSTERse VCA TOPOLOGY)
// =============================================================================
slider1 == 2 ? (
  draw_component_header("TAB 2 // STUDIO BUS GLUE COMPRESSOR (BUSTERse VCA)",
                        "British VCA master glue with authentic 39Hz / 60Hz sidechain detection",
                        "Glues rhythm stems into a record; 10ms attack lets transients breathe",
                        "SAT OUT -> 39Hz DETECTOR -> VCA ATTENUATOR -> DRY/WET MIX -> STEREO M/S");

  glue_y = ws_y + 68;
  glue_w = floor((ws_w - 32) * 0.48);
  glue_h = ws_h - 78;

  draw_sifam_meter(ws_x + 12, glue_y, glue_w, 240, "STUDIO BUS GLUE // GAIN REDUCTION", sifam_needle_gr, 20.0, 1, 0.00, 0.85, 1.00);

  gr_strip_y = glue_y + 248; gr_strip_h = glue_h - 248;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(ws_x + 12, gr_strip_y, glue_w, gr_strip_h);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(ws_x + 12, gr_strip_y, glue_w, gr_strip_h, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = ws_x + 22; gfx_y = gr_strip_y + 8; gfx_drawstr("SCROLLING GAIN REDUCTION TELEMETRY (128 FRAMES)");

  hist_i = 0; step_x = glue_w / 128.0;
  prev_hx = ws_x + 12; prev_hy = gr_strip_y + 28;
  while (hist_i < 128) (
    buf_i = (gr_hist_pos - 128 + hist_i + 128) % 128;
    h_gr = gr_hist[buf_i];
    hx = ws_x + 12 + hist_i * step_x;
    hy = gr_strip_y + 28 + clamp(h_gr * 8.0, 0, gr_strip_h - 36);

    hist_i > 0 ? (
      gfx_r = 0.00; gfx_g = 0.95; gfx_b = 1.00;
      gfx_line(prev_hx, prev_hy, hx, hy);
    );
    prev_hx = hx; prev_hy = hy;
    hist_i += 1;
  );

  ctrl_x = ws_x + 20 + glue_w;
  ctrl_w = ws_w - 32 - glue_w;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(ctrl_x, glue_y, ctrl_w, glue_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(ctrl_x, glue_y, ctrl_w, glue_h, 0);

  gfx_setfont(1, "Orbitron", 13, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = ctrl_x + 16; gfx_y = glue_y + 14; gfx_drawstr("BUSTERse VCA GLUE CALIBRATION");

  gfx_setfont(2, "Consolas", 11, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 44;
  gfx_printf("• BUS GLUE THRESHOLD : %4.1f dB", slider12);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_x = ctrl_x + 16; gfx_y = glue_y + 60;
  gfx_drawstr("  [Target: 1.4 to 1.8 dB GR on Chorus Hits]");

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 88;
  gfx_printf("• COMPRESSION RATIO  : %d:1 Modern Punch", slider13 == 0 ? 1.5 : (slider13 == 1 ? 2 : (slider13 == 2 ? 4 : 8)));

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 120;
  gfx_printf("• ATTACK TIME        : %4.1f ms (Transient Pass)", slider14);

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 152;
  r_str = slider15 == 0 ? "100ms Fast" : (slider15 == 1 ? "300ms Snappy" : (slider15 == 2 ? "600ms (.6 sec)" : "1200ms Smooth"));
  gfx_printf("• RELEASE TIME       : %s", r_str);

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 184;
  gfx_printf("• SIDECHAIN HPF      : %d Hz (Detector Filter)", slider16);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_x = ctrl_x + 16; gfx_y = glue_y + 200;
  slider16 <= 42 ? gfx_drawstr("  ★ 39Hz HPF ENGAGED: Snare Cut-Through Trick (Nolly / Pinchin)") :
  slider16 <= 65 ? gfx_drawstr("  ★ 60Hz HPF ENGAGED: Kick & Sub-Bass Decoupling (Sam Guaiana)") :
  gfx_drawstr("  ★ STANDARD HPF: Sub-Bass Pumping Decoupling");

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = ctrl_x + 16; gfx_y = glue_y + 230;
  gfx_printf("• PARALLEL GLUE MIX  : %d %%", slider17);

  rx_w = floor((ctrl_w - 40) / 4);
  ri = 0;
  while (ri < 4) (
    r_btn_x = ctrl_x + 16 + ri * (rx_w + 6);
    r_btn_y = glue_y + 270;
    r_sel = (slider13 == ri);
    r_hov = (mouse_x >= r_btn_x && mouse_x <= r_btn_x + rx_w && mouse_y >= r_btn_y && mouse_y <= r_btn_y + 28);

    gfx_r = r_sel ? 0.85 : (r_hov ? 0.08 : 0.03);
    gfx_g = r_sel ? 0.70 : (r_hov ? 0.12 : 0.04);
    gfx_b = r_sel ? 0.22 : (r_hov ? 0.16 : 0.06);
    gfx_rect(r_btn_x, r_btn_y, rx_w, 28);
    gfx_r = r_sel ? 1.0 : 0.35; gfx_g = r_sel ? 0.9 : 0.45; gfx_b = r_sel ? 0.5 : 0.55;
    gfx_rect(r_btn_x, r_btn_y, rx_w, 28, 0);

    gfx_setfont(1, "Orbitron", 10.5, 'b');
    gfx_r = r_sel ? 0.02 : 0.85; gfx_g = r_sel ? 0.02 : 0.90; gfx_b = r_sel ? 0.03 : 0.98;
    lbl = ri == 0 ? "1.5:1" : (ri == 1 ? "2:1" : (ri == 2 ? "4:1" : "8:1"));
    gfx_measurestr(lbl, lb_w, lb_h);
    gfx_x = r_btn_x + floor((rx_w - lb_w) * 0.5); gfx_y = r_btn_y + floor((28 - lb_h) * 0.5);
    gfx_drawstr(lbl);

    mouse_clicked && r_hov ? (slider13 = ri; slider_automate(););
    ri += 1;
  );
);

// =============================================================================
// TAB 3: CRUCIBLE (ANALOG HARMONIC SATURATION)
// =============================================================================
slider1 == 3 ? (
  draw_component_header("TAB 3 // HARMONIC CRUCIBLE CONSOLE ENGINE",
                        "Vintage Neve 8014 Iron Desk, Studer Tape & Triode Tube warmth",
                        "Imparts rich even & odd harmonics replicating Britson console summing",
                        "POCKET -> NON-LINEAR WAVESHAPER -> CONSOLE TRANSFORMER -> VCA GLUE");

  cru_y = ws_y + 68;
  cru_h = ws_h - 78;

  // 1. Engine Selection Cards Strip (Top Row)
  eng_w = floor((ws_w - 60) / 4);
  ei = 0;
  while (ei < 4) (
    eng_x = ws_x + 16 + ei * (eng_w + 8);
    eng_y = cru_y + 8;
    eng_sel = (slider23 == ei);
    eng_hov = (mouse_x >= eng_x && mouse_x <= eng_x + eng_w && mouse_y >= eng_y && mouse_y <= eng_y + 72);

    gfx_r = eng_sel ? 0.08 : (eng_hov ? 0.04 : 0.018);
    gfx_g = eng_sel ? 0.16 : (eng_hov ? 0.06 : 0.024);
    gfx_b = eng_sel ? 0.22 : (eng_hov ? 0.09 : 0.032);
    gfx_rect(eng_x, eng_y, eng_w, 72);
    gfx_r = eng_sel ? 0.85 : 0.30; gfx_g = eng_sel ? 0.70 : 0.38; gfx_b = eng_sel ? 0.22 : 0.48;
    gfx_rect(eng_x, eng_y, eng_w, 72, 0);

    gfx_setfont(1, "Orbitron", 11, 'b');
    gfx_r = eng_sel ? 1.0 : 0.75; gfx_g = eng_sel ? 0.85 : 0.80; gfx_b = eng_sel ? 0.30 : 0.85;
    gfx_x = eng_x + 10; gfx_y = eng_y + 10;
    eng_name = ei == 0 ? "TRANSPARENT PASS" :
               ei == 1 ? "NEVE 8014 IRON DESK" :
               ei == 2 ? "STUDER A800 TAPE" : "TRIODE TUBE CRUCIBLE";
    gfx_drawstr(eng_name);

    gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.65; gfx_g = 0.75; gfx_b = 0.85;
    gfx_x = eng_x + 10; gfx_y = eng_y + 30;
    eng_desc = ei == 0 ? "Pure bit-exact 1:1 throughput" :
               ei == 1 ? "Even/odd console drive (Britson)" :
               ei == 2 ? "15 IPS warm tape compression" : "Rich odd-harmonic tube grit";
    gfx_drawstr(eng_desc);

    mouse_clicked && eng_hov ? (slider23 = ei; slider_automate(););
    ei += 1;
  );

  // 2. Middle Row: Interactive Transfer Curve Display + Harmonic Circuit Bay
  mid_y = cru_y + 90;
  mid_h = cru_h - 100;
  curve_w = floor((ws_w - 40) * 0.52);

  // Non-linear Transfer Curve Display
  gfx_r = 0.014; gfx_g = 0.018; gfx_b = 0.026; gfx_rect(ws_x + 16, mid_y, curve_w, mid_h);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(ws_x + 16, mid_y, curve_w, mid_h, 0);

  gfx_setfont(1, "Orbitron", 11.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = ws_x + 28; gfx_y = mid_y + 12;
  gfx_drawstr("HARMONIC TRANSFER FUNCTION // NON-LINEAR SATURATION CURVE");

  // Grid
  c_cx = ws_x + 16 + curve_w * 0.5;
  c_cy = mid_y + mid_h * 0.5 + 8;
  c_span = min(curve_w * 0.40, mid_h * 0.40);
  gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20;
  gfx_line(c_cx - c_span, c_cy, c_cx + c_span, c_cy);
  gfx_line(c_cx, c_cy - c_span, c_cx, c_cy + c_span);
  gfx_circle(c_cx, c_cy, floor(c_span * 0.5), 0);
  gfx_circle(c_cx, c_cy, floor(c_span), 0);

  // Plot Transfer Curve y = f(x)
  crv_i = -30;
  prev_px = c_cx; prev_py = c_cy;
  while (crv_i <= 30) (
    x_in = crv_i / 30.0 * 2.0;
    drv_val = exp(active_drive * 0.115);
    slider23 == 1 ? (
      x_s = fast_shape(x_in * drv_val);
      y_out = (x_s - 0.08 * x_s * abs(x_s)) / drv_val;
    ) : slider23 == 2 ? (
      y_out = fast_shape(x_in * drv_val) / drv_val;
    ) : slider23 == 3 ? (
      x_s = fast_shape(x_in * drv_val);
      y_out = (x_s / (1.0 + 0.4 * abs(x_s))) / drv_val;
    ) : (
      y_out = x_in;
    );
    px = c_cx + (x_in / 2.0) * c_span;
    py = c_cy - (y_out / 2.0) * c_span;

    crv_i > -30 ? (
      gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
      gfx_line(prev_px, prev_py, px, py);
    );
    prev_px = px; prev_py = py;
    crv_i += 1;
  );

  // Live Operating Point Dot
  live_x = clamp(inst_peak * 1.5, -2.0, 2.0);
  drv_val = exp(active_drive * 0.115);
  live_y = fast_shape(live_x * drv_val) / drv_val;
  dot_px = c_cx + (live_x / 2.0) * c_span;
  dot_py = c_cy - (live_y / 2.0) * c_span;
  gfx_r = 0.00; gfx_g = 0.95; gfx_b = 0.45; gfx_circle(dot_px, dot_py, 4, 1);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_circle(dot_px, dot_py, 4, 0);

  // Right Panel: Hardware Console Circuit & Coloration Specs
  cir_x = ws_x + 28 + curve_w;
  cir_w = ws_w - 44 - curve_w;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(cir_x, mid_y, cir_w, mid_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(cir_x, mid_y, cir_w, mid_h, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = cir_x + 16; gfx_y = mid_y + 14;
  gfx_drawstr("ANALOG CONSOLE COLORATION HUD");

  gfx_setfont(2, "Consolas", 11, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = cir_x + 16; gfx_y = mid_y + 44;
  gfx_printf("• CONSOLE DESK DRIVE : %+3.1f dB (Harmonic Push)", slider24);
  gfx_x = cir_x + 16; gfx_y = mid_y + 68;
  gfx_printf("• TOTAL ACTIVE DRIVE : %+3.1f dB (Breakdown Boost Included)", active_drive);
  gfx_x = cir_x + 16; gfx_y = mid_y + 92;
  gfx_printf("• SATURATION ENGINE  : %s", slider23 == 1 ? "Neve 8014 Iron Desk (Britson)" : (slider23 == 2 ? "Studer A800 15 IPS Tape" : (slider23 == 3 ? "Triode Tube Crucible" : "Transparent Pass")));

  // Harmonic Order Breakdown Plaque
  gfx_r = 0.08; gfx_g = 0.12; gfx_b = 0.18; gfx_rect(cir_x + 16, mid_y + 120, cir_w - 32, 80);
  gfx_r = 0.25; gfx_g = 0.35; gfx_b = 0.45; gfx_rect(cir_x + 16, mid_y + 120, cir_w - 32, 80, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = cir_x + 24; gfx_y = mid_y + 128; gfx_drawstr("HARMONIC DISTRIBUTION PROFILE");

  gfx_setfont(2, "Consolas", 10, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = cir_x + 24; gfx_y = mid_y + 148;
  slider23 == 1 ? gfx_drawstr("2nd Harmonic (Warmth): 65%  |  3rd Harmonic (Punch): 35%") :
  slider23 == 2 ? gfx_drawstr("Tape Head-Bump: 70Hz  |  HF Compression: Smooth Soft-Clip") :
  slider23 == 3 ? gfx_drawstr("3rd Harmonic (Grit): 80%  |  5th Harmonic (Edge): 20%") :
  gfx_drawstr("Linear Line Amp: Zero Harmonic Distortion Generated");

  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_x = cir_x + 24; gfx_y = mid_y + 168;
  gfx_drawstr("CIRCUIT STATUS: STABLE // ANALOG IRON BONDING ACTIVE");
);

// =============================================================================
// TAB 4: STEREO (QUAD-WALL M/S IMAGER & SUB-MONO ANCHOR)
// =============================================================================
slider1 == 4 ? (
  draw_component_header("TAB 4 // QUAD-WALL STEREO IMAGER & SUB-MONO ANCHOR",
                        "Mid/Side stereo width sculpting with 2nd order Butterworth sub mono lock",
                        "Locks low frequencies dead-center while pushing side wall immersion",
                        "BUS GLUE -> M/S MATRIX -> SUB-MONO HPF (80Hz) -> SIDE WIDTH -> MID RE-SUM");

  st_y = ws_y + 68;
  st_h = ws_h - 78;
  st_half_w = floor((ws_w - 36) * 0.50);

  // Left Panel: Polar Vector Phase Scope & Goniometer
  gfx_r = 0.014; gfx_g = 0.018; gfx_b = 0.026; gfx_rect(ws_x + 12, st_y, st_half_w, st_h);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(ws_x + 12, st_y, st_half_w, st_h, 0);

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = ws_x + 24; gfx_y = st_y + 14;
  gfx_drawstr("POLAR VECTOR GONIOMETER & M/S RADAR");

  g_cx = ws_x + 12 + st_half_w * 0.5;
  g_cy = st_y + st_h * 0.45;
  g_rad = min(st_half_w * 0.38, st_h * 0.35);

  gfx_r = 0.08; gfx_g = 0.12; gfx_b = 0.18;
  gfx_circle(g_cx, g_cy, floor(g_rad), 0);
  gfx_circle(g_cx, g_cy, floor(g_rad * 0.6), 0);
  gfx_line(g_cx - g_rad, g_cy, g_cx + g_rad, g_cy);
  gfx_line(g_cx, g_cy - g_rad, g_cx, g_cy + g_rad);
  gfx_line(g_cx - g_rad * 0.707, g_cy - g_rad * 0.707, g_cx + g_rad * 0.707, g_cy + g_rad * 0.707);
  gfx_line(g_cx - g_rad * 0.707, g_cy + g_rad * 0.707, g_cx + g_rad * 0.707, g_cy - g_rad * 0.707);

  // Live Vectorscope Phosphor Cloud
  pi = 0; prev_gx = g_cx; prev_gy = g_cy;
  loop(64,
    s_idx = (scope_pos - pi * 2 + 256) % 256;
    sl = scope_buf_l[s_idx]; sr = scope_buf_r[s_idx];
    gx_pt = g_cx + (sl - sr) * (g_rad * 0.95);
    gy_pt = g_cy - (sl + sr) * (g_rad * 0.95);
    pi > 0 ? (
      gfx_r = 0.00; gfx_g = 0.95; gfx_b = 0.65; gfx_a = 0.70;
      gfx_line(prev_gx, prev_gy, gx_pt, gy_pt);
    );
    prev_gx = gx_pt; prev_gy = gy_pt;
    pi += 1;
  );
  gfx_a = 1.0;

  // Correlation Meter
  c_bar_y = st_y + st_h - 40;
  c_bar_w = st_half_w - 32;
  gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06; gfx_rect(ws_x + 28, c_bar_y, c_bar_w, 16);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(ws_x + 28, c_bar_y, c_bar_w, 16, 0);
  cm_mid = ws_x + 28 + c_bar_w * 0.5;
  gfx_line(cm_mid, c_bar_y - 2, cm_mid, c_bar_y + 18);

  cm_fill_w = floor(corr_smooth * (c_bar_w * 0.5));
  corr_smooth >= 0 ? (
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 0.45;
    gfx_rect(cm_mid, c_bar_y + 2, cm_fill_w, 12);
  ) : (
    gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.20;
    gfx_rect(cm_mid + cm_fill_w, c_bar_y + 2, -cm_fill_w, 12);
  );

  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = ws_x + 28; gfx_y = c_bar_y - 18;
  gfx_printf("PHASE CORRELATION: %+4.2f (1.0 = MONO, 0.0 = WIDE)", corr_smooth);

  // Right Panel: Mid/Side Balancer & Hardware Width Controls
  r_panel_x = ws_x + 20 + st_half_w;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(r_panel_x, st_y, st_half_w, st_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(r_panel_x, st_y, st_half_w, st_h, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = r_panel_x + 16; gfx_y = st_y + 14;
  gfx_drawstr("SPATIAL DISCIPLINE & SUB-BASS ANCHOR HUD");

  gfx_setfont(2, "Consolas", 11, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = r_panel_x + 16; gfx_y = st_y + 44;
  gfx_printf("• SUB-BASS MONO ANCHOR : %d Hz (Elliptic Side Highpass)", slider6);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_x = r_panel_x + 16; gfx_y = st_y + 60;
  gfx_drawstr("  [Protects low-end vinyl/club translation by folding sub to pure mono]");

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = r_panel_x + 16; gfx_y = st_y + 88;
  gfx_printf("• STEREO IMAGER WIDTH  : %4.2f x (Active Width)", active_width);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_x = r_panel_x + 16; gfx_y = st_y + 104;
  gfx_printf("  [Base Width: %4.2fx | Chorus Bloom: %s]", slider25, dk_env0 > 0.05 ? "+12% Active" : "Standby");

  // Sub-Mono Frequency Response Curve Plaque
  sm_crv_y = st_y + 134;
  sm_crv_h = 100;
  sm_crv_w = st_half_w - 32;
  gfx_r = 0.012; gfx_g = 0.016; gfx_b = 0.024; gfx_rect(r_panel_x + 16, sm_crv_y, sm_crv_w, sm_crv_h);
  gfx_r = 0.25; gfx_g = 0.35; gfx_b = 0.45; gfx_rect(r_panel_x + 16, sm_crv_y, sm_crv_w, sm_crv_h, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = r_panel_x + 24; gfx_y = sm_crv_y + 8;
  gfx_drawstr("SIDE CHANNEL HIGHPASS ATTENUATION PROFILE");

  // Draw HPF curve
  ci = 0; prev_cx = r_panel_x + 24; prev_cy = sm_crv_y + sm_crv_h - 10;
  while (ci <= 40) (
    f_log = 20.0 * exp(ci / 40.0 * 2.3);
    h_gain = min(1.0, sqr(f_log / slider6));
    c_px = r_panel_x + 24 + ci * (sm_crv_w - 48) / 40.0;
    c_py = sm_crv_y + sm_crv_h - 10 - h_gain * (sm_crv_h - 30);

    ci > 0 ? (
      gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
      gfx_line(prev_cx, prev_cy, c_px, c_py);
    );
    prev_cx = c_px; prev_cy = c_py;
    ci += 1;
  );

  gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
  gfx_x = r_panel_x + 24; gfx_y = sm_crv_y + sm_crv_h - 16;
  gfx_printf("CUTOFF: %d Hz // 100%% MONO BELOW CUTOFF", slider6);
);

// =============================================================================
// TAB 5: POCKET (DYNAMIC VOCAL CORRIDOR NOTCH & SENTRY)
// =============================================================================
slider1 == 5 ? (
  draw_component_header("TAB 5 // STATIC VOCAL POCKET NOTCH & SENTRY",
                        "Stationary surgical notch with zero dynamic flutter - preserves 100% mix stability",
                        "Calibrated acoustic pocket at 2.2kHz; vocal level monitored via passive telemetry",
                        "EQ OUT -> 2.2kHz STATIC NOTCH (SURGICAL LOCK) -> CRUCIBLE SATURATION");

  poc_y = ws_y + 68;
  poc_h = ws_h - 78;
  poc_half_w = floor((ws_w - 36) * 0.50);

  // Left Panel: Real-Time Dynamic Frequency Notch Response Spectrum
  gfx_r = 0.014; gfx_g = 0.018; gfx_b = 0.026; gfx_rect(ws_x + 12, poc_y, poc_half_w, poc_h);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_rect(ws_x + 12, poc_y, poc_half_w, poc_h, 0);

  gfx_setfont(1, "Orbitron", 12, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = ws_x + 24; gfx_y = poc_y + 14;
  gfx_drawstr("STATIC 2.2kHz VOCAL POCKET NOTCH SPECTRUM");

  p_cx = ws_x + 12 + poc_half_w * 0.5;
  p_cy = poc_y + poc_h * 0.45;

  // Draw Flat Line with 2.2kHz Dynamic Dip
  pw_span = poc_half_w - 48;
  pi = 0; prev_px = ws_x + 24; prev_py = p_cy;
  while (pi <= 50) (
    fx = pi / 50.0;
    // Bell dip centered at fx = 0.55 (2.2 kHz)
    dip = exp(-sqr((fx - 0.55) / 0.08)) * (pocket_depth * 18.0);
    px = ws_x + 24 + pi * (pw_span / 50.0);
    py = p_cy + dip;

    pi > 0 ? (
      gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
      gfx_line(prev_px, prev_py, px, py);
    );
    prev_px = px; prev_py = py;
    pi += 1;
  );

  // Center Marker at 2.2 kHz
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
  notch_x = ws_x + 24 + 0.55 * pw_span;
  gfx_line(notch_x, p_cy - 40, notch_x, p_cy + 60);
  gfx_setfont(1, "Orbitron", 10.5, 'b');
  gfx_x = notch_x - 30; gfx_y = p_cy + 68;
  gfx_printf("2.2 kHz (-%3.1fdB)", pocket_depth);

  // Right Panel: Vocal Activity Telemetry HUD
  r_poc_x = ws_x + 20 + poc_half_w;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(r_poc_x, poc_y, poc_half_w, poc_h);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(r_poc_x, poc_y, poc_half_w, poc_h, 0);

  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = r_poc_x + 16; gfx_y = poc_y + 14;
  gfx_drawstr("INTER-SUITE VOCAL RADAR & HEADROOM SENTRY");

  gfx_setfont(2, "Consolas", 11, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = r_poc_x + 16; gfx_y = poc_y + 44;
  gfx_printf("• MONITORED VOCAL LEVEL (gmem[1452]): %4.1f dBFS", vox_level);

  // Vocal Present LED Sentry
  v_act = (vox_level > -45.0);
  gfx_r = v_act ? 0.05 : 0.02; gfx_g = v_act ? 0.22 : 0.04; gfx_b = v_act ? 0.10 : 0.05;
  gfx_rect(r_poc_x + 16, poc_y + 68, poc_half_w - 32, 30);
  gfx_r = v_act ? 0.15 : 0.35; gfx_g = v_act ? 0.95 : 0.45; gfx_b = v_act ? 0.45 : 0.55;
  gfx_rect(r_poc_x + 16, poc_y + 68, poc_half_w - 32, 30, 0);

  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_r = v_act ? 1.0 : 0.65; gfx_g = v_act ? 1.0 : 0.70; gfx_b = v_act ? 1.0 : 0.75;
  gfx_x = r_poc_x + 28; gfx_y = poc_y + 76;
  v_act ? gfx_drawstr("★ VOCAL SENTRY: DETECTED // PASSIVE TELEMETRY RADAR") :
          gfx_drawstr("☆ VOCAL SENTRY: STANDBY // PASSIVE TELEMETRY RADAR");

  gfx_setfont(2, "Consolas", 11, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98; gfx_x = r_poc_x + 16; gfx_y = poc_y + 116;
  gfx_printf("• STATIC NOTCH DEPTH    : -%3.1f dB (Surgical Lock)", slider8);
  gfx_x = r_poc_x + 16; gfx_y = poc_y + 138;
  gfx_printf("• ACTIVE NOTCH STATUS   : %s (-%3.1f dB)", slider9 ? "ENGAGED STATIC" : "FLAT BYPASS", pocket_depth);
  gfx_x = r_poc_x + 16; gfx_y = poc_y + 160;
  gfx_printf("• DISCIPLINE            : PURE STATIC (ZERO DYNAMIC FLUTTER)");

  // Pre-Master Ceiling Guardian Plaque
  gfx_r = 0.08; gfx_g = 0.12; gfx_b = 0.18; gfx_rect(r_poc_x + 16, poc_y + 185, poc_half_w - 32, 60);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(r_poc_x + 16, poc_y + 185, poc_half_w - 32, 60, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00;
  gfx_x = r_poc_x + 24; gfx_y = poc_y + 192;
  gfx_drawstr("ANALOG SOFT-DIODE CEILING GUARDIAN");

  gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = r_poc_x + 24; gfx_y = poc_y + 208;
  gfx_drawstr("Peak Catcher active at -0.18 dBFS. Ensures clean, zero-overshoot pre-master pass.");
  gfx_x = r_poc_x + 24; gfx_y = poc_y + 224;
  gfx_printf("STRICT LOCK: %s  |  OUTPUT PEAK: %4.2f dBFS", slider5 ? "-6.0 dBTP Strict" : "Free Crest Pass", 20.0 * log10(max(0.00001, inst_peak)));

  // Stem Ecosystem Handshake Plaque
  sh_y = poc_y + 252;
  sh_h = poc_h - 258;
  gfx_r = 0.016; gfx_g = 0.024; gfx_b = 0.034; gfx_rect(r_poc_x + 16, sh_y, poc_half_w - 32, sh_h);
  gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(r_poc_x + 16, sh_y, poc_half_w - 32, sh_h, 0);

  gfx_setfont(1, "Orbitron", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = r_poc_x + 24; gfx_y = sh_y + 8;
  gfx_drawstr("STEM SUMMING INTERLOCK & HANDSHAKE MATRIX");

  gfx_setfont(2, "Consolas", 10, 'b');
  gfx_r = gtr_act ? 0.25 : 0.45; gfx_g = gtr_act ? 0.95 : 0.50; gfx_b = gtr_act ? 0.55 : 0.60;
  gfx_x = r_poc_x + 24; gfx_y = sh_y + 28;
  gfx_printf("• GUITAR SUITE    (gmem 840) : %s | RMS: %4.1f dBFS", gtr_act ? "CONNECTED" : "STANDBY", gtr_rms);

  gfx_r = bas_act ? 0.25 : 0.45; gfx_g = bas_act ? 0.62 : 0.50; gfx_b = bas_act ? 1.00 : 0.60;
  gfx_x = r_poc_x + 24; gfx_y = sh_y + 46;
  gfx_printf("• BASS SUITE      (gmem 860) : %s | RMS: %4.1f dBFS", bas_act ? "CONNECTED" : "STANDBY", bas_rms);

  gfx_r = syn_act ? 0.94 : 0.45; gfx_g = syn_act ? 0.56 : 0.50; gfx_b = syn_act ? 0.36 : 0.60;
  gfx_x = r_poc_x + 24; gfx_y = sh_y + 64;
  gfx_printf("• SYNTH BUS SUITE (gmem 920) : %s | RMS: %4.1f dBFS", syn_act ? "CONNECTED" : "STANDBY", syn_rms);

  gfx_r = dev_act ? 1.00 : 0.45; gfx_g = dev_act ? 0.85 : 0.50; gfx_b = dev_act ? 0.30 : 0.60;
  gfx_x = r_poc_x + 24; gfx_y = sh_y + 82;
  gfx_printf("• DEVASTATOR      (gmem 900) : %s | RMS: %4.1f dBFS", dev_act ? "CONNECTED" : "STANDBY", dev_rms);
);

// =============================================================================
// TAB 6: PRODUCER MATRIX (25 FORENSIC REFERENCE BENCHMARKS)
// =============================================================================
slider1 == 6 ? (
  draw_component_header("TAB 6 // PRODUCER SUMMING MATRIX & BENCHMARKS",
                        "25 forensic producer profiles derived from iconic modern reference albums",
                        "One-click recall of signature EQ curves, bus glue ballistics & saturation",
                        "BENCHMARK SELECTION -> PARAMETER AUTOPILOT -> FORENSIC MIX ALIGNMENT");

  pm_y = ws_y + 66;
  pm_h = ws_h - 78;
  pm_w = ws_w - 24;

  cols = 5; rows = 5;
  grid_w = floor(pm_w * 0.60);
  btn_w = floor((grid_w - (cols - 1) * 6) / cols);
  btn_h = floor((pm_h - 24 - (rows - 1) * 6) / rows);

  p_idx = 0;
  while (p_idx < 25) (
    c = p_idx % cols;
    r = floor(p_idx / cols);
    bx = ws_x + 12 + c * (btn_w + 6);
    by = pm_y + 12 + r * (btn_h + 6);

    p_sel = (slider2 == p_idx);
    p_hov = (mouse_x >= bx && mouse_x <= bx + btn_w && mouse_y >= by && mouse_y <= by + btn_h);

    // Cybernetic Plaque Chassis
    p_sel ? (
      gfx_r = 0.04; gfx_g = 0.16; gfx_b = 0.28; gfx_rect(bx, by, btn_w, btn_h);
      gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68; gfx_rect(bx, by, btn_w, btn_h, 0);
      gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(bx + 1, by + 1, btn_w - 2, btn_h - 2, 0);
    ) : p_hov ? (
      gfx_r = 0.03; gfx_g = 0.07; gfx_b = 0.12; gfx_rect(bx, by, btn_w, btn_h);
      gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36; gfx_rect(bx, by, btn_w, btn_h, 0);
    ) : (
      gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(bx, by, btn_w, btn_h);
      gfx_r = 0.20; gfx_g = 0.32; gfx_b = 0.45; gfx_rect(bx, by, btn_w, btn_h, 0);
    );

    // Line 1: Producer Name (Primary)
    gfx_setfont(1, "Orbitron", 10, 'b');
    gfx_r = p_sel ? 0.05 : (p_hov ? 1.00 : 0.85);
    gfx_g = p_sel ? 0.95 : (p_hov ? 0.90 : 0.88);
    gfx_b = p_sel ? 0.68 : (p_hov ? 0.60 : 0.95);
    gfx_x = bx + 6; gfx_y = by + 6;
    gfx_drawstr(get_producer_short(p_idx));

    // Line 2: Band & Track Reference
    gfx_setfont(2, "Arial", 10, 'b');
    gfx_r = p_sel ? 0.95 : (p_hov ? 0.90 : 0.70);
    gfx_g = p_sel ? 0.95 : (p_hov ? 0.85 : 0.75);
    gfx_b = p_sel ? 0.98 : (p_hov ? 0.80 : 0.85);
    gfx_x = bx + 6; gfx_y = by + 26;
    gfx_drawstr(get_producer_band(p_idx));

    // Line 3: Sonic Footprint Spec Badge
    gfx_setfont(2, "Consolas", 9, 'b');
    gfx_r = p_sel ? 0.94 : 0.60;
    gfx_g = p_sel ? 0.56 : 0.65;
    gfx_b = p_sel ? 0.36 : 0.75;
    gfx_x = bx + 6; gfx_y = by + 46;
    gfx_drawstr(get_producer_badge(p_idx));

    // Bottom Status Pill
    p_sel ? (
      gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
      gfx_rect(bx + 6, by + btn_h - 6, btn_w - 12, 2.5);
    );

    mouse_clicked && p_hov ? (
      slider2 = p_idx;
      apply_producer_preset(p_idx);
      slider_automate();
    );
    p_idx += 1;
  );

  // Right Column: Active Producer Forensic Blueprint Plaque
  bp_x = ws_x + 18 + grid_w;
  bp_w = pm_w - grid_w - 18;
  gfx_r = 0.016; gfx_g = 0.022; gfx_b = 0.030; gfx_rect(bp_x, pm_y + 12, bp_w, pm_h - 24);
  gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.00; gfx_rect(bp_x, pm_y + 12, bp_w, pm_h - 24, 0);

  gfx_setfont(1, "Orbitron", 13.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = bp_x + 16; gfx_y = pm_y + 24;
  gfx_drawstr("FORENSIC BENCHMARK BLUEPRINT");

  gfx_setfont(2, "Consolas", 12, 'b'); gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_x = bp_x + 16; gfx_y = pm_y + 48;
  gfx_printf("TARGET: %s", get_producer_name(slider2));

  gfx_setfont(2, "Arial", 11.5, 'b'); gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = bp_x + 16; gfx_y = pm_y + 68;
  gfx_printf("REF   : %s", get_producer_ref_track(slider2));
  draw_adinkra_watermark(bp_x, pm_y + 12, bp_w, pm_h - 24, 4); // Sankofa Benchmark Watermark

  tgt_rms = (slider2 == 6 || slider2 == 9) ? -9.1 :
            slider2 == 4 ? -6.8 :
            (slider2 == 1 || slider2 == 14) ? -7.3 :
            slider2 == 19 ? -8.0 :
            slider2 == 3 ? -8.5 :
            slider2 == 15 ? -9.9 :
            slider2 == 21 ? -10.6 :
            slider2 == 22 ? -11.0 : -9.0;

  tgt_crest = slider2 == 6 ? 8.8 :
              slider2 == 9 ? 9.1 :
              slider2 == 4 ? 6.8 :
              (slider2 == 1 || slider2 == 14) ? 7.2 :
              slider2 == 19 ? 7.7 :
              slider2 == 3 ? 8.5 :
              slider2 == 15 ? 9.6 :
              slider2 == 21 ? 10.5 :
              slider2 == 22 ? 10.7 : 8.8;
  d_rms = inst_rms - tgt_rms;
  d_crest = inst_crest - tgt_crest;
  fit_score = clamp(100.0 - abs(d_rms)*3.5 - abs(d_crest)*4.0, 78.0, 99.8);

  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.94; gfx_g = 0.56; gfx_b = 0.36;
  gfx_x = bp_x + 16; gfx_y = pm_y + 88;
  gfx_printf("TARGET: RMS %4.1fdB | Crest %3.1fdB | S/M -7.8dB | Sub-Mono -28dB", tgt_rms, tgt_crest);

  gfx_setfont(2, "Consolas", 10.5, 'b'); gfx_r = 0.05; gfx_g = 0.95; gfx_b = 0.68;
  gfx_x = bp_x + 16; gfx_y = pm_y + 104;
  gfx_printf("LIVE  : RMS %4.1fdB | Crest %3.1fdB | Sub-Mono %4.1fdB | FIT: %4.1f%%", inst_rms, inst_crest, sub_mono_ratio, fit_score);

  gfx_setfont(2, "Arial", 11, '');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.98;
  gfx_x = bp_x + 16; gfx_y = pm_y + 124;
  gfx_printf("• Output Trim  : %+3.1f dB (DeeGain Staging Bit-Exact Parity)", slider4);
  gfx_x = bp_x + 16; gfx_y = pm_y + 142;
  gfx_printf("• Tonal EQ     : 80Hz +%3.1fdB | 202Hz -%3.1fdB", slider19, abs(slider20));
  gfx_x = bp_x + 16; gfx_y = pm_y + 160;
