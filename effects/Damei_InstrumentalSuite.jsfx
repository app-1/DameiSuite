    gfx_b = eng_sel ? 0.20 : (eng_hov ? 0.09 : 0.032);
    gfx_rect(eng_x, eng_y, eng_w, 80);
    gfx_r = eng_sel ? 0.85 : 0.30; gfx_g = eng_sel ? 0.70 : 0.38; gfx_b = eng_sel ? 0.22 : 0.48;
    gfx_rect(eng_x, eng_y, eng_w, 80, 0);

    gfx_setfont(1, "Orbitron", 11, 'b');
    gfx_r = eng_sel ? 1.0 : 0.75; gfx_g = eng_sel ? 0.85 : 0.80; gfx_b = eng_sel ? 0.30 : 0.85;
    gfx_x = eng_x + 10; gfx_y = eng_y + 12;
    eng_name = ei == 0 ? "TRANSPARENT PASS" :
               ei == 1 ? "NEVE 8014 IRON DESK" :
               ei == 2 ? "STUDER A800 TAPE" : "TRIODE TUBE CRUCIBLE";
    gfx_drawstr(eng_name);

    gfx_setfont(2, "Consolas", 10, 'b'); gfx_r = 0.65; gfx_g = 0.75; gfx_b = 0.85;
    gfx_x = eng_x + 10; gfx_y = eng_y + 34;
    eng_desc = ei == 0 ? "Pure 1:1 uncolored throughput" :
               ei == 1 ? "Even/odd console saturation (Britson)" :
               ei == 2 ? "15 IPS warm tape compression" : "Odd-harmonic tube saturation & drive";
    gfx_drawstr(eng_desc);

    mouse_clicked && eng_hov ? (slider23 = ei; slider_automate(););
    ei += 1;
  );

  // Saturation Drive Readout & Telemetry
  gfx_setfont(1, "Orbitron", 12.5, 'b'); gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.22;
  gfx_x = ws_x + 28; gfx_y = cru_y + 160;
  gfx_printf("ACTIVE CONSOLE DRIVE: %+3.1f dB (Harmonic Gain)", slider24);

  gfx_setfont(2, "Consolas", 11, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = ws_x + 28; gfx_y = cru_y + 185;
  gfx_drawstr("HARMONIC CHARACTER: Rich 2nd order warmth & 3rd order punch across the midrange.");
);

