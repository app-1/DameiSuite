  );

  // Interactive buttons: [ TOPOLOGY ] [ Thresh - ] [ Thresh + ] (Fixed Luminous Text)
  b_top_cycle = (mouse_x >= disp_x + 16 && mouse_x <= disp_x + 16 + c_btn_w && mouse_y >= c_btn_y && mouse_y <= c_btn_y + 28);
