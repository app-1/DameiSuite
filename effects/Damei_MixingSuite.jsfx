  // Dynamic Visualizer: VCA Gain Reduction LED Bar
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 18, dyn_scope_y, c_col_w - 28, dyn_scope_h);
