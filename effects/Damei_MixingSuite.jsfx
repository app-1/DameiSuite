      target_punch_boost = -0.05 * scale_mult;
      target_drive_boost =  0.10 * scale_mult;
      target_vocal_boost =  0.05 * scale_mult;
      struct_status_str = "VERSE // FADER WARM TAPE FLOAT";
    ) : p_idx == 3 ? ( // Jonathan Dolese (Hook Vocal Clarity)
      target_width_boost = -0.02 * scale_mult;
      target_punch_boost =  0.00;
      target_drive_boost =  0.05 * scale_mult;
      target_vocal_boost =  0.20 * scale_mult;
      struct_status_str = "VERSE // DOLESE HOOK VOCAL CLARITY";
    ) : p_idx == 20 ? ( // Jens Bogren (Scandinavian Rhythm Weight)
      target_width_boost = -0.02 * scale_mult;
      target_punch_boost =  0.05 * scale_mult;
      target_drive_boost =  0.10 * scale_mult;
      target_vocal_boost =  0.00;
      struct_status_str = "VERSE // BOGREN SCANDINAVIAN RHYTHM WEIGHT";
    ) : p_idx == 21 ? ( // Adam Nolly Getgood (Surgical Groove Precision)
      target_width_boost = -0.02 * scale_mult;
      target_punch_boost =  0.05 * scale_mult;
      target_drive_boost =  0.05 * scale_mult;
      target_vocal_boost =  0.05 * scale_mult;
      struct_status_str = "VERSE // NOLLY SURGICAL GROOVE PRECISION";
    ) : (
      target_width_boost = 0.0;
      target_punch_boost = 0.0;
      target_drive_boost = 0.0;
      target_vocal_boost = 0.0;
      struct_status_str = "VERSE // PRODUCER BALANCE ACTIVE";
    );
  );

  // Asymmetric morph: snappy instantaneous attack on chorus drop, smooth musical release
  struct_state == 3 ? (
    morph_c = exp(-1.0 / (0.025 * srate)); // 25ms explosive chorus drop downbeat slam
  ) : struct_state == 2 ? (
    morph_c = exp(-1.0 / (0.05 * srate));  // 50ms pre-drop breath suction
  ) : (
    morph_c = exp(-1.0 / (0.15 * srate));  // 150ms smooth musical return
  );
  dyn_width_boost = dyn_width_boost * morph_c + target_width_boost * (1.0 - morph_c);
  dyn_punch_boost = dyn_punch_boost * morph_c + target_punch_boost * (1.0 - morph_c);
  dyn_drive_boost = dyn_drive_boost * morph_c + target_drive_boost * (1.0 - morph_c);
  dyn_vocal_boost = dyn_vocal_boost * morph_c + target_vocal_boost * (1.0 - morph_c);
  gmem[810] = struct_state;
  gmem[811] = p_idx;
  gmem[812] = dyn_width_boost;
  gmem[813] = dyn_punch_boost;
  gmem[814] = dyn_drive_boost;
  gmem[815] = dyn_vocal_boost;
) : (
  dyn_width_boost = 0.0;
  dyn_punch_boost = 0.0;
  dyn_drive_boost = 0.0;
  dyn_vocal_boost = 0.0;
  gmem[810] = 0;
  gmem[811] = slider39;
  gmem[812] = 0.0;
  gmem[813] = 0.0;
  gmem[814] = 0.0;
  gmem[815] = 0.0;
  struct_status_str = "SONG STRUCTURE AI: BYPASSED";
);

// =============================================================================
// 1. DRUM TRANSIENT DESIGNER (MUSICAL MIX-BUS SCALING)
// =============================================================================
att_fast_c = exp(-1.0 / (0.002 * srate));
att_slow_c = exp(-1.0 / (0.025 * srate));
sust_c     = exp(-1.0 / (0.120 * srate));

abs_l = abs(s_in_l);
abs_r = abs(s_in_r);

env_trans_fast_l = env_trans_fast_l * att_fast_c + abs_l * (1.0 - att_fast_c);
env_trans_fast_r = env_trans_fast_r * att_fast_c + abs_r * (1.0 - att_fast_c);

env_trans_slow_l = env_trans_slow_l * att_slow_c + abs_l * (1.0 - att_slow_c);
env_trans_slow_r = env_trans_slow_r * att_slow_c + abs_r * (1.0 - att_slow_c);

env_trans_sust_l = env_trans_sust_l * sust_c + abs_l * (1.0 - sust_c);
env_trans_sust_r = env_trans_sust_r * sust_c + abs_r * (1.0 - sust_c);

diff_att_l = max(0.0, env_trans_fast_l - env_trans_slow_l);
diff_att_r = max(0.0, env_trans_fast_r - env_trans_slow_r);

// Musical mix-bus transient scaling: Envelope-normalized punch
att_ratio_l = diff_att_l / max(0.012, env_trans_slow_l);
att_ratio_r = diff_att_r / max(0.012, env_trans_slow_r);
eff_punch = max(-6.0, min(6.0, slider34 + dyn_punch_boost));
g_att_l = 1.0 + min(1.25, att_ratio_l) * (exp(eff_punch * (log(10.0)/20.0)) - 1.0) * 0.70;
g_att_r = 1.0 + min(1.25, att_ratio_r) * (exp(eff_punch * (log(10.0)/20.0)) - 1.0) * 0.70;

sust_ratio_l = env_trans_sust_l / max(0.015, env_trans_slow_l);
sust_ratio_r = env_trans_sust_r / max(0.015, env_trans_slow_r);
g_sust_l = 1.0 + min(1.10, sust_ratio_l) * (exp(slider35 * (log(10.0)/20.0)) - 1.0) * 0.55;
g_sust_r = 1.0 + min(1.10, sust_ratio_r) * (exp(slider35 * (log(10.0)/20.0)) - 1.0) * 0.55;

g_att_l  = max(0.70, min(1.40, g_att_l));
g_att_r  = max(0.70, min(1.40, g_att_r));
g_sust_l = max(0.70, min(1.40, g_sust_l));
g_sust_r = max(0.70, min(1.40, g_sust_r));

(slider34 != 0.0 || slider35 != 0.0) ? (
  t_proc_l = s_in_l * g_att_l * g_sust_l;
  t_proc_r = s_in_r * g_att_r * g_sust_r;
  trans_punch_meter = (g_att_l + g_att_r) * 0.5 - 1.0;
  trans_sust_meter  = (g_sust_l + g_sust_r) * 0.5 - 1.0;
) : (
  t_proc_l = s_in_l;
  t_proc_r = s_in_r;
  trans_punch_meter = 0.0;
  trans_sust_meter = 0.0;
);

// =============================================================================
// 2. PRECISION SIBILANCE DE-ESSER
// =============================================================================
slider38 > 0 ? (
  ds_sc_l = deess_b0*t_proc_l + deess_b1*deess_x1_l + deess_b2*deess_x2_l - deess_a1*deess_y1_l - deess_a2*deess_y2_l;
  deess_x2_l = deess_x1_l; deess_x1_l = t_proc_l;
  deess_y2_l = deess_y1_l; deess_y1_l = ds_sc_l;

  ds_sc_r = deess_b0*t_proc_r + deess_b1*deess_x1_r + deess_b2*deess_x2_r - deess_a1*deess_y1_r - deess_a2*deess_y2_r;
  deess_x2_r = deess_x1_r; deess_x1_r = t_proc_r;
  deess_y2_r = deess_y1_r; deess_y1_r = ds_sc_r;

  sc_sig = max(abs(ds_sc_l), abs(ds_sc_r));
  deess_att = exp(-1.0 / (0.001 * srate));
  deess_rel = exp(-1.0 / (0.045 * srate));
  sc_sig > env_deess ? (
    env_deess = env_deess * deess_att + sc_sig * (1.0 - deess_att);
  ) : (
    env_deess = env_deess * deess_rel + sc_sig * (1.0 - deess_rel);
  );

  sc_db = 20.0 * log10(max(env_deess, 0.000001));
  ds_over = sc_db - slider36;
  ds_over > 0.0 ? (
    target_ds_gr = min(2.0, ds_over * 0.40); // Gentle 2.0 dB split-band clamp
    deess_gr = deess_gr * 0.90 + target_ds_gr * 0.10;
  ) : (
    deess_gr = deess_gr * 0.92;
  );

  ds_gain_lin = exp(-deess_gr * (log(10.0)/20.0));
  slider38 == 1 ? (
    ds_out_l = t_proc_l + (ds_sc_l * (ds_gain_lin - 1.0));
    ds_out_r = t_proc_r + (ds_sc_r * (ds_gain_lin - 1.0));
  ) : (
    ds_out_l = t_proc_l * ds_gain_lin;
    ds_out_r = t_proc_r * ds_gain_lin;
  );
) : (
  ds_out_l = t_proc_l;
  ds_out_r = t_proc_r;
  deess_gr = 0.0;
);

// =============================================================================
// 3. GUITAR PALM-MUTE CHUG GUARD
// =============================================================================
slider30 > 0 ? (
  ch_det_l = chug_b0*ds_out_l + chug_b1*chug_x1_l + chug_b2*chug_x2_l - chug_a1*chug_y1_l - chug_a2*chug_y2_l;
  chug_x2_l = chug_x1_l; chug_x1_l = ds_out_l;
  chug_y2_l = chug_y1_l; chug_y1_l = ch_det_l;

  ch_det_r = chug_b0*ds_out_r + chug_b1*chug_x1_r + chug_b2*chug_x2_r - chug_a1*chug_y1_r - chug_a2*chug_y2_r;
  chug_x2_r = chug_x1_r; chug_x1_r = ds_out_r;
  chug_y2_r = chug_y1_r; chug_y1_r = ch_det_r;

  ch_sig = max(abs(ch_det_l), abs(ch_det_r));
  ch_att = exp(-1.0 / (0.003 * srate));
  ch_rel = exp(-1.0 / (0.080 * srate));
  ch_sig > env_chug ? (
    env_chug = env_chug * ch_att + ch_sig * (1.0 - ch_att);
  ) : (
    env_chug = env_chug * ch_rel + ch_sig * (1.0 - ch_rel);
  );

  ch_db = 20.0 * log10(max(env_chug, 0.000001));
  ch_thresh = -12.0; // Musical threshold
  ch_over = ch_db - ch_thresh;
  ch_over > 0.0 ? (
    t_ch_gr = min(1.5, ch_over * 0.35); // Gentle 1.5 dB clamp
    chug_gr = chug_gr * 0.88 + t_ch_gr * 0.12;
  ) : (
    chug_gr = chug_gr * 0.94;
  );

  ch_gain_lin = exp(-chug_gr * (log(10.0)/20.0));
  chug_out_l = ds_out_l + (ch_det_l * (ch_gain_lin - 1.0));
  chug_out_r = ds_out_r + (ch_det_r * (ch_gain_lin - 1.0));
) : (
  chug_out_l = ds_out_l;
  chug_out_r = ds_out_r;
  chug_gr = 0.0;
);

// =============================================================================
// 4. MID-CHANNEL VOCAL PROCESSING & STEREO SPACE (ANTI-DRUM BLEED ISOLATED)
// =============================================================================
mid_sig  = (chug_out_l + chug_out_r) * 0.5;
side_sig = (chug_out_l - chug_out_r) * 0.5;

// Anti-Drum Transient Isolation:
// Use drum transient detector (diff_att_l, diff_att_r) to gate out snare & kick attacks
max_drum_trans = max(diff_att_l, diff_att_r);
max_drum_trans > 0.020 ? (
  voc_drum_gate = 0.0; // Instantly clamp vocal feed on snare/kick attack!
) : (
  voc_drum_gate = min(1.0, voc_drum_gate + 0.008); // Smooth recovery for sustained vocals
);

// Vocal Formant Bandpass Isolation: 750 Hz HPF to 4.5 kHz LPF (rejects kick sub and snare body)
voc_hpf_s = voc_hpf_s * 0.90 + mid_sig * 0.10;
voc_mid_band = mid_sig - voc_hpf_s;
voc_lpf_s = voc_lpf_s * 0.65 + voc_mid_band * 0.35;
voc_formant = voc_lpf_s;

// A. Vocal Donut Hole Mid Notch (Carves pocket in guitars)
slider28 > 0 ? (
  m_carve = donut_b0*mid_sig + donut_b1*donut_x1 + donut_b2*donut_x2 - donut_a1*donut_y1 - donut_a2*donut_y2;
  donut_x2 = donut_x1; donut_x1 = mid_sig;
  donut_y2 = donut_y1; donut_y1 = m_carve;
  mid_sig = m_carve;
);

// B. Producer Center Vocal Level Trim (Band-limited to vocal formant, drum-immune!)
(slider41 != 0.0 || dyn_vocal_boost != 0.0) ? (
  v_trim_lin = exp((slider41 + dyn_vocal_boost) * (log(10.0)/20.0));
  // Applies ONLY to vocal formant band and ducks to 0 on drum transients: snare level is 100% UNTOUCHED!
  mid_sig += voc_formant * (v_trim_lin - 1.0) * 0.85 * voc_drum_gate;
);

// C. Producer Vocal Saturation & Bite (Formant-only, drum-gated)
slider43 > 0.0 ? (
  v_drv = slider43 * 0.10;
  v_sat = (sin(voc_formant * 1.5707963 * (1.0 + v_drv)) - voc_formant) * 0.20 * voc_drum_gate;
  mid_sig += v_sat;
);

// D. Producer Vocal Space & Ambience Halo (Stereo Side-Channel Only: ZERO Center Snare Bleed!)
slider42 > 0 ? (
  // Feed buffer receives only clean, drum-gated vocal formant: snare NEVER enters delay memory!
  voc_buf_feed = voc_formant * voc_drum_gate;
  voc_buf_l[voc_idx] = voc_buf_feed;
  voc_buf_r[voc_idx] = voc_buf_feed;
  
  slider42 == 1 ? (
    // Mode 1: 3D Stereo Micro-Pitch Halo (Subtle width aura, -27 dB, sides only)
    d_l_s = (voc_idx - floor(0.014 * srate) + voc_buf_sz) % voc_buf_sz;
    d_r_s = (voc_idx - floor(0.021 * srate) + voc_buf_sz) % voc_buf_sz;
    halo_l = voc_buf_l[d_l_s] * 0.045;
    halo_r = voc_buf_r[d_r_s] * 0.045;
    side_sig += (halo_l - halo_r) * 0.45;
  ) : slider42 == 2 ? (
    // Mode 2: Ambient Shoegaze Bloom (Diffused multi-tap cloud, -33 dB, sides only: ZERO center doubling)
    t1 = (voc_idx - floor(0.045 * srate) + voc_buf_sz) % voc_buf_sz;
    t2 = (voc_idx - floor(0.075 * srate) + voc_buf_sz) % voc_buf_sz;
    t3 = (voc_idx - floor(0.110 * srate) + voc_buf_sz) % voc_buf_sz;
    t4 = (voc_idx - floor(0.145 * srate) + voc_buf_sz) % voc_buf_sz;
    diff_cloud = (voc_buf_l[t1] - voc_buf_r[t2] + voc_buf_l[t3] - voc_buf_r[t4]) * 0.018;
    side_sig += diff_cloud * 0.50;
  ) : (
    // Mode 3: Vintage Tape Slap (Filtered subtle slapback on sides only, -28 dB)
    d_slap = (voc_idx - floor(0.115 * srate) + voc_buf_sz) % voc_buf_sz;
    slap_s = voc_buf_l[d_slap] * 0.040;
    side_sig += slap_s * 0.35;
  );
  voc_idx = (voc_idx + 1) % voc_buf_sz;
);

// Sub-Bass Mono Anchor (2nd-Order HPF on Side channel)
y_side = mono_b0*side_sig + mono_b1*mono_x1_l + mono_b2*mono_x2_l - mono_a1*mono_y1_l - mono_a2*mono_y2_l;
mono_x2_l = mono_x1_l; mono_x1_l = side_sig;
mono_y2_l = mono_y1_l; mono_y1_l = y_side;

eff_width = max(0.5, min(1.5, slider7 + dyn_width_boost));
y_side *= eff_width; // Dynamic Chorus-Aware Stereo Dimension Width

lr_l = mid_sig + y_side;
lr_r = mid_sig - y_side;

// =============================================================================
// 5. BASS 3-WAY CROSSOVER ARCHITECTURE
// =============================================================================
slider33 > 0 ? (
  b_box_l = bass_box_b0*lr_l + bass_box_b1*bass_box_x1_l + bass_box_b2*bass_box_x2_l - bass_box_a1*bass_box_y1_l - bass_box_a2*bass_box_y2_l;
  bass_box_x2_l = bass_box_x1_l; bass_box_x1_l = lr_l;
  bass_box_y2_l = bass_box_y1_l; bass_box_y1_l = b_box_l;

  b_box_r = bass_box_b0*lr_r + bass_box_b1*bass_box_x1_r + bass_box_b2*bass_box_x2_r - bass_box_a1*bass_box_y1_r - bass_box_a2*bass_box_y2_r;
  bass_box_x2_r = bass_box_x1_r; bass_box_x1_r = lr_r;
  bass_box_y2_r = bass_box_y1_r; bass_box_y1_r = b_box_r;

  b_grit_l = bass_grit_b0*b_box_l + bass_grit_b1*bass_grit_x1_l + bass_grit_b2*bass_grit_x2_l - bass_grit_a1*bass_grit_y1_l - bass_grit_a2*bass_grit_y2_l;
  bass_grit_x2_l = bass_grit_x1_l; bass_grit_x1_l = b_box_l;
  bass_grit_y2_l = bass_grit_y1_l; bass_grit_y1_l = b_grit_l;

  b_grit_r = bass_grit_b0*b_box_r + bass_grit_b1*bass_grit_x1_r + bass_grit_b2*bass_grit_x2_r - bass_grit_a1*bass_grit_y1_r - bass_grit_a2*bass_grit_y2_r;
  bass_grit_x2_r = bass_grit_x1_r; bass_grit_x1_r = b_box_r;
  bass_grit_y2_r = bass_grit_y1_r; bass_grit_y1_r = b_grit_r;

  bass_out_l = b_grit_l;
  bass_out_r = b_grit_r;
) : (
  bass_out_l = lr_l;
  bass_out_r = lr_r;
);

// =============================================================================
// 6. SPECTRAL TILT & DYNAMIC DE-BOX / DE-HARSH
// =============================================================================
y_air_l = air_b0*bass_out_l + air_b1*air_x1_l + air_b2*air_x2_l - air_a1*air_y1_l - air_a2*air_y2_l;
air_x2_l = air_x1_l; air_x1_l = bass_out_l;
air_y2_l = air_y1_l; air_y1_l = y_air_l;

y_air_r = air_b0*bass_out_r + air_b1*air_x1_r + air_b2*air_x2_r - air_a1*air_y1_r - air_a2*air_y2_r;
air_x2_r = air_x1_r; air_x1_r = bass_out_r;
air_y2_r = air_y1_r; air_y1_r = y_air_r;

y_deb_l = debox_b0*y_air_l + debox_b1*debox_x1_l + debox_b2*debox_x2_l - debox_a1*debox_y1_l - debox_a2*debox_y2_l;
debox_x2_l = debox_x1_l; debox_x1_l = y_air_l;
debox_y2_l = debox_y1_l; debox_y1_l = y_deb_l;

y_deb_r = debox_b0*y_air_r + debox_b1*debox_x1_r + debox_b2*debox_x2_r - debox_a1*debox_y1_r - debox_a2*debox_y2_r;
debox_x2_r = debox_x1_r; debox_x1_r = y_air_r;
debox_y2_r = debox_y1_r; debox_y1_r = y_deb_r;

y_deh_l = deharsh_b0*y_deb_l + deharsh_b1*deharsh_x1_l + deharsh_b2*deharsh_x2_l - deharsh_a1*deharsh_y1_l - deharsh_a2*deharsh_y2_l;
deharsh_x2_l = deharsh_x1_l; deharsh_x1_l = y_deb_l;
deharsh_y2_l = deharsh_y1_l; deharsh_y1_l = y_deh_l;

y_deh_r = deharsh_b0*y_deb_r + deharsh_b1*deharsh_x1_r + deharsh_b2*deharsh_x2_r - deharsh_a1*deharsh_y1_r - deharsh_a2*deharsh_y2_r;
deharsh_x2_r = deharsh_x1_r; deharsh_x1_r = y_deb_r;
deharsh_y2_r = deharsh_y1_r; deharsh_y1_r = y_deh_r;

proc_l = y_deh_l;
proc_r = y_deh_r;

// =============================================================================
// 7. CONSOLE MIX DYNAMICS (CONTINUOUS PEAK-ENVELOPE DETECTOR & ANTI-PUMPING GLUE)
// =============================================================================
sc_in = 0.5 * (proc_l + proc_r);
sc_filt = sc_hpf_b0*sc_in + sc_hpf_b1*sc_hpf_x1 + sc_hpf_b2*sc_hpf_x2 - sc_hpf_a1*sc_hpf_y1 - sc_hpf_a2*sc_hpf_y2;
sc_hpf_x2 = sc_hpf_x1; sc_hpf_x1 = sc_in;
sc_hpf_y2 = sc_hpf_y1; sc_hpf_y1 = sc_filt;

// Continuous Musical Peak-Envelope Detector (ZERO RIPPLE & ZERO FLUTTER)
sc_rect = abs(sc_filt);
det_att_c = exp(-1.0 / (0.015 * srate)); // 15ms musical integration
det_rel_c = exp(-1.0 / (0.180 * srate)); // 180ms smooth envelope release
sc_rect > comp_det_env ? (
  comp_det_env = comp_det_env * det_att_c + sc_rect * (1.0 - det_att_c);
) : (
  comp_det_env = comp_det_env * det_rel_c + sc_rect * (1.0 - det_rel_c);
);

detect_sig = comp_det_env;
detect_db = 20.0 * log10(max(detect_sig, 0.000001));
over_db = detect_db - slider9;

over_db > 0 ? (
  ratio = (slider10==0 ? 1.5 : (slider10==1 ? 2.0 : (slider10==2 ? 4.0 : (slider10==3 ? 8.0 : 20.0))));
  target_gr = over_db * (1.0 - 1.0 / ratio);
) : (
  target_gr = 0.0;
);

att_coeff = exp(-1.0 / (slider11 * 0.001 * srate));

// Program-dependent smooth auto-release (ZERO PUMPING)
auto_rel_time = (comp_gr > 1.0) ? 400.0 : 280.0;
rel_time = (slider12==0 ? auto_rel_time : (slider12==1 ? 250 : (slider12==2 ? 300 : (slider12==3 ? 600 : (slider12==4 ? 1200 : 400)))));
rel_coeff = exp(-1.0 / (rel_time * 0.001 * srate));

target_gr > comp_gr ? (
  comp_gr = comp_gr * att_coeff + target_gr * (1.0 - att_coeff);
) : (
  comp_gr = comp_gr * rel_coeff + target_gr * (1.0 - rel_coeff);
);

comp_gain_lin = exp(-comp_gr * (log(10.0) / 20.0));
makeup_lin = exp(slider14 * (log(10.0) / 20.0));

wet_l = proc_l * comp_gain_lin * makeup_lin;
wet_r = proc_r * comp_gain_lin * makeup_lin;
mix_amt = slider15 * 0.01;

comp_out_l = proc_l * (1.0 - mix_amt) + wet_l * mix_amt;
comp_out_r = proc_r * (1.0 - mix_amt) + wet_r * mix_amt;
comp_red_meter = comp_gr;

// =============================================================================
// 8. ANALOG HARMONIC COLORATION & TAPE DRIVE
// =============================================================================
eff_drv = max(0.0, min(10.0, slider21 + dyn_drive_boost));
eff_drv > 0 ? (
  drv_mult = exp(eff_drv * (log(10.0) / 16.0));
  scale_fac = 2.2;
  in_sc_l = comp_out_l * drv_mult * scale_fac;
  in_sc_r = comp_out_r * drv_mult * scale_fac;

  slider22 == 0 ? (
    // Warm Triode Tube: Asymmetric 2nd harmonic thickness & vocal body
    s_l = in_sc_l + 0.28 * in_sc_l * abs(in_sc_l) - 0.08 * in_sc_l * in_sc_l * in_sc_l;
    s_r = in_sc_r + 0.28 * in_sc_r * abs(in_sc_r) - 0.08 * in_sc_r * in_sc_r * in_sc_r;
  ) : slider22 == 1 ? (
    // Punchy Pentode: Aggressive 3rd harmonic bite & guitar crunch
    s_l = in_sc_l / (1.0 + 0.35 * abs(in_sc_l) + 0.15 * in_sc_l * in_sc_l);
    s_r = in_sc_r / (1.0 + 0.35 * abs(in_sc_r) + 0.15 * in_sc_r * in_sc_r);
  ) : (
    // Vintage Tape Saturation: Soft-knee compression & smooth rounded saturation
    s_l = sin(max(-1.57, min(1.57, in_sc_l * 0.75))) * 1.25;
    s_r = sin(max(-1.57, min(1.57, in_sc_r * 0.75))) * 1.25;
  );
  sat_out_l = s_l / (drv_mult * scale_fac);
  sat_out_r = s_r / (drv_mult * scale_fac);

  sat_mix = min(1.0, slider21 * 0.30 + 0.25);
  comp_out_l = comp_out_l * (1.0 - sat_mix) + sat_out_l * sat_mix;
  comp_out_r = comp_out_r * (1.0 - sat_mix) + sat_out_r * sat_mix;
);

// =============================================================================
// 9. DYNAMIC CREST & INTERNAL AUTOMATION RIDER (ZERO DAW LANES NEEDED)
// =============================================================================
slider24 > 0 ? (
  r_pk = max(abs(comp_out_l), abs(comp_out_r));
  
  // Dual-ballistic peak & RMS integration
  r_pk_att = exp(-1.0 / (0.005 * srate)); // 5ms peak catch
  r_pk_rel = exp(-1.0 / (0.080 * srate)); // 80ms release
  r_pk > rider_fast_pk ? (
    rider_fast_pk = rider_fast_pk * r_pk_att + r_pk * (1.0 - r_pk_att);
  ) : (
    rider_fast_pk = rider_fast_pk * r_pk_rel + r_pk * (1.0 - r_pk_rel);
  );
  
  r_rms_c = exp(-1.0 / (0.150 * srate)); // 150ms musical RMS
  rider_fast_rms = rider_fast_rms * r_rms_c + (r_pk * r_pk) * (1.0 - r_rms_c);
  
  r_macro_c = exp(-1.0 / (2.2 * srate)); // 2.2s song-section macro level
  rider_macro_rms = rider_macro_rms * r_macro_c + (r_pk * r_pk) * (1.0 - r_macro_c);
  
  // Real-time instantaneous crest calculation (dB)
  pk_db = 20.0 * log10(max(0.000001, rider_fast_pk));
  rms_db = 10.0 * log10(max(0.000000001, rider_fast_rms));
  macro_rms_db = 10.0 * log10(max(0.000000001, rider_macro_rms));
  
  cur_inst_crest = max(4.0, min(24.0, pk_db - rms_db));
  
  // Golden Commercial Crest Target: 11.5 dB
  target_crest = 11.5;
  delta_crest = cur_inst_crest - target_crest;
  
  // A. Micro Crest Density Adjustment
  // Excess crest (>12.5dB, sparse/spiky) -> smooth optical lift (+0.5 to +1.2dB)
  // Low crest (<9.5dB, wall-of-sound) -> gentle cushioning pull-back (-0.4 to -0.8dB)
  t_micro_gain = (delta_crest > 1.0) ? min(1.2, delta_crest * 0.25) :
                 (delta_crest < -1.5) ? max(-0.8, delta_crest * 0.20) : 0.0;
                 
  // B. Macro Song Section Automation Rider
  // Target Mix RMS: -18.0 dBFS
  target_mix_rms = -18.0;
  macro_deficit = target_mix_rms - macro_rms_db;
  max_macro_range = (slider24 == 1 ? 1.5 : (slider24 == 2 ? 2.5 : 2.0));
  t_macro_gain = max(-max_macro_range, min(max_macro_range, macro_deficit * 0.25));
  
  // C. Song Structure Exciter & Pre-Drop Breath (in Mode 3 or with AI)
  t_struct_rider = 0.0;
  (slider24 == 3 || slider44 > 0) ? (
    struct_state == 1 ? (t_struct_rider = 0.4); // Pre-chorus build
    struct_state == 2 ? (t_struct_rider = -0.6); // Pre-drop breath ducking
    struct_state == 3 ? (t_struct_rider = 0.3);  // Chorus downbeat slam (balanced 0 VU headroom)
    struct_state == 4 ? (t_struct_rider = -0.4); // Bridge breakdown intimacy
  );
  
  combined_rider_target = max(-max_macro_range, min(max_macro_range, t_macro_gain * 0.70 + t_micro_gain * 0.30 + t_struct_rider));
  
  // Program-dependent smooth analog optical ballistics (ZERO PUMPING)
  rider_smooth_coeff = combined_rider_target > mix_rider_smooth ? 
    exp(-1.0 / (0.600 * srate)) : // 600ms smooth ramp up
    exp(-1.0 / (1.200 * srate));  // 1200ms transparent release down
    
  cur_rms > -50.0 ? (
    mix_rider_smooth = mix_rider_smooth * rider_smooth_coeff + combined_rider_target * (1.0 - rider_smooth_coeff);
  ) : (
    mix_rider_smooth = mix_rider_smooth * 0.99998;
  );
  
  m_rider_lin = exp(mix_rider_smooth * (log(10.0) / 20.0));
  comp_out_l *= m_rider_lin;
  comp_out_r *= m_rider_lin;
) : (
  mix_rider_smooth = 0.0;
);

// =============================================================================
// 10. SMOOTH -6.0 dBTP HEADROOM GUARDIAN & BUS CLIPPER
// =============================================================================
s_in_pk = max(abs(comp_out_l), abs(comp_out_r));
cur_in_peak = cur_in_peak * 0.9995 + s_in_pk * 0.0005;
in_peak_hold = max(in_peak_hold * 0.99995, s_in_pk);
cur_true_peak = 20.0 * log10(max(in_peak_hold, 0.000001));

// Static linear trim fader (ZERO DYNAMIC BEAT MODULATION)
target_ceil_db = slider3; // -6.0 dBTP Pre-Master Export Ceiling
total_trim_db = slider5;  // Pure static mathematical headroom trim (ZERO FLUTTER)
trim_lin = exp(total_trim_db * (log(10.0) / 20.0));

bus_l = comp_out_l * trim_lin;
bus_r = comp_out_r * trim_lin;

// ⚡ SANKOFA ORACLE RAW AUDIT: If gmem[1098] == 1, bypass mix processing and feed raw input to metering and output
oracle_raw_audit = (gmem[1098] == 1);
oracle_raw_audit ? (
  bus_l = s_in_l;
  bus_r = s_in_r;
);

// =============================================================================
// 11. TONAL BALANCE 4-BAND REAL-TIME CROSSOVER ACCUMULATOR
// =============================================================================
tb_in = 0.5 * (bus_l + bus_r);

tb_low_s = tb_lp250_b0*tb_in + tb_lp250_b1*tb_lp250_x1 + tb_lp250_b2*tb_lp250_x2 - tb_lp250_a1*tb_lp250_y1 - tb_lp250_a2*tb_lp250_y2;
tb_lp250_x2 = tb_lp250_x1; tb_lp250_x1 = tb_in;
tb_lp250_y2 = tb_lp250_y1; tb_lp250_y1 = tb_low_s;

tb_2k_s = tb_lp2k_b0*tb_in + tb_lp2k_b1*tb_lp2k_x1 + tb_lp2k_b2*tb_lp2k_x2 - tb_lp2k_a1*tb_lp2k_y1 - tb_lp2k_a2*tb_lp2k_y2;
tb_lp2k_x2 = tb_lp2k_x1; tb_lp2k_x1 = tb_in;
tb_lp2k_y2 = tb_lp2k_y1; tb_lp2k_y1 = tb_2k_s;

tb_8k_s = tb_lp8k_b0*tb_in + tb_lp8k_b1*tb_lp8k_x1 + tb_lp8k_b2*tb_lp8k_x2 - tb_lp8k_a1*tb_lp8k_y1 - tb_lp8k_a2*tb_lp8k_y2;
tb_lp8k_x2 = tb_lp8k_x1; tb_lp8k_x1 = tb_in;
tb_lp8k_y2 = tb_lp8k_y1; tb_lp8k_y1 = tb_8k_s;

sig_low = tb_low_s;
sig_lmid = tb_2k_s - tb_low_s;
sig_hmid = tb_8k_s - tb_2k_s;
sig_high = tb_in - tb_8k_s;

tb_coeff = exp(-1.0 / (0.45 * srate));
tb_nrg_low  = tb_nrg_low  * tb_coeff + (sig_low  * sig_low)  * (1.0 - tb_coeff);
tb_nrg_lmid = tb_nrg_lmid * tb_coeff + (sig_lmid * sig_lmid) * (1.0 - tb_coeff);
tb_nrg_hmid = tb_nrg_hmid * tb_coeff + (sig_hmid * sig_hmid) * (1.0 - tb_coeff);
tb_nrg_high = tb_nrg_high * tb_coeff + (sig_high * sig_high) * (1.0 - tb_coeff);

tb_tot = tb_nrg_low + tb_nrg_lmid + tb_nrg_hmid + tb_nrg_high + 0.0000000001;
tb_pct_low  = (tb_nrg_low  / tb_tot) * 100.0;
tb_pct_lmid = (tb_nrg_lmid / tb_tot) * 100.0;
tb_pct_hmid = (tb_nrg_hmid / tb_tot) * 100.0;
tb_pct_high = (tb_nrg_high / tb_tot) * 100.0;

// Loudness & Correlation telemetry
sq_sum = (bus_l * bus_l + bus_r * bus_r) * 0.5;
rms_sq_smooth = rms_sq_smooth * 0.999 + sq_sum * 0.001;
cur_rms = rms_sq_smooth > 0.0000000001 ? 10.0 * log10(rms_sq_smooth) : -90.0;
cur_crest = max(0.0, 20.0 * log10(max(s_in_pk * trim_lin, 0.000001)) - cur_rms);

cross = bus_l * bus_r;
sq_sum > 0.000002 ? (
  corr_inst = cross / max(sq_sum, 0.000001);
  cur_corr = cur_corr * 0.998 + corr_inst * 0.002;
) : (
  cur_corr = cur_corr * 0.998 + 1.0 * 0.002;
);
cur_corr = max(-1.0, min(1.0, cur_corr));

scope_counter = (scope_counter + 1) % 4;
scope_counter == 0 ? (
  scope_buf_l[scope_idx] = bus_l;
  scope_buf_r[scope_idx] = bus_r;
  scope_idx = (scope_idx + 1) % 64;
);

ceil_lin = exp(target_ceil_db * (log(10.0) / 20.0));

// Staged soft-clipping or transparent linear headroom
slider40 == 1 ? (
  // Lance Prenc Musical Bus Soft-Clipper
  t_k = ceil_lin * 0.92;
  bus_l > t_k ? (
    ov = bus_l - t_k;
    sp = ceil_lin - t_k;
    bus_l = t_k + ov / (1.0 + (ov / sp) * (ov / sp));
  ) : bus_l < -t_k ? (
    ov = -bus_l - t_k;
    sp = ceil_lin - t_k;
    bus_l = -(t_k + ov / (1.0 + (ov / sp) * (ov / sp)));
  );
  bus_r > t_k ? (
    ov = bus_r - t_k;
    sp = ceil_lin - t_k;
    bus_r = t_k + ov / (1.0 + (ov / sp) * (ov / sp));
  ) : bus_r < -t_k ? (
    ov = -bus_r - t_k;
    sp = ceil_lin - t_k;
    bus_r = -(t_k + ov / (1.0 + (ov / sp) * (ov / sp)));
  );
) : slider40 == 2 ? (
  // Hard Converter Clip
  bus_l = max(-ceil_lin, min(ceil_lin, bus_l));
  bus_r = max(-ceil_lin, min(ceil_lin, bus_r));
) : (
  // Transparent Linear Headroom: Pristine unclipped passthrough with safety ceiling clamp
  (abs(bus_l) > ceil_lin || abs(bus_r) > ceil_lin) ? (
    sc_ratio = ceil_lin / max(abs(bus_l), abs(bus_r));
    bus_l *= sc_ratio;
    bus_r *= sc_ratio;
  );
);

// ZERO CLIPPING IN MODE 0: 100% Linear floating-point output
spl0 = bus_l;
spl1 = bus_r;

// ─── CAR TEST & TRANSLATION MONITOR AUDITION MATRIX (NON-DESTRUCTIVE) ───
slider46 == 1 ? (
  // 1. CAR TEST: Automotive Cabin Resonance (52Hz Boom, 240Hz Door Panel, 3.8kHz Glass Reflection & Crossfeed)
  l1 = car_p1_b0*spl0 + car_p1_b1*cp1_x1_l + car_p1_b2*cp1_x2_l - car_p1_a1*cp1_y1_l - car_p1_a2*cp1_y2_l;
  cp1_x2_l = cp1_x1_l; cp1_x1_l = spl0; cp1_y2_l = cp1_y1_l; cp1_y1_l = l1;
  l2 = car_p2_b0*l1 + car_p2_b1*cp2_x1_l + car_p2_b2*cp2_x2_l - car_p2_a1*cp2_y1_l - car_p2_a2*cp2_y2_l;
  cp2_x2_l = cp2_x1_l; cp2_x1_l = l1; cp2_y2_l = cp2_y1_l; cp2_y1_l = l2;
  l3 = car_sh_b0*l2 + car_sh_b1*csh_x1_l + car_sh_b2*csh_x2_l - car_sh_a1*csh_y1_l - car_sh_a2*csh_y2_l;
  csh_x2_l = csh_x1_l; csh_x1_l = l2; csh_y2_l = csh_y1_l; csh_y1_l = l3;

  r1 = car_p1_b0*spl1 + car_p1_b1*cp1_x1_r + car_p1_b2*cp1_x2_r - car_p1_a1*cp1_y1_r - car_p1_a2*cp1_y2_r;
  cp1_x2_r = cp1_x1_r; cp1_x1_r = spl1; cp1_y2_r = cp1_y1_r; cp1_y1_r = r1;
  r2 = car_p2_b0*r1 + car_p2_b1*cp2_x1_r + car_p2_b2*cp2_x2_r - car_p2_a1*cp2_y1_r - car_p2_a2*cp2_y2_r;
  cp2_x2_r = cp2_x1_r; cp2_x1_r = r1; cp2_y2_r = cp2_y1_r; cp2_y1_r = r2;
  r3 = car_sh_b0*r2 + car_sh_b1*csh_x1_r + car_sh_b2*csh_x2_r - car_sh_a1*csh_y1_r - car_sh_a2*csh_y2_r;
  csh_x2_r = csh_x1_r; csh_x1_r = r2; csh_y2_r = csh_y1_r; csh_y1_r = r3;

  spl0 = (l3 * 0.82 + r3 * 0.18) * 0.80; // Scaled to prevent DAC clipping on cabin resonance
  spl1 = (r3 * 0.82 + l3 * 0.18) * 0.80;
) : slider46 == 2 ? (
  // 2. PHONE TEST: Mono Smartphone Small Speaker (220Hz - 11.5kHz Bandpass)
  mono_in = (spl0 + spl1) * 0.5;
  m_hp = phone_hp_b0*mono_in + phone_hp_b1*php_x1 + phone_hp_b2*php_x2 - phone_hp_a1*php_y1 - phone_hp_a2*php_y2;
  php_x2 = php_x1; php_x1 = mono_in; php_y2 = php_y1; php_y1 = m_hp;
  m_bp = phone_lp_b0*m_hp + phone_lp_b1*plp_x1 + phone_lp_b2*plp_x2 - phone_lp_a1*plp_y1 - phone_lp_a2*plp_y2;
  plp_x2 = plp_x1; plp_x1 = m_hp; plp_y2 = plp_y1; plp_y1 = m_bp;
  spl0 = m_bp; spl1 = m_bp;
) : slider46 == 3 ? (
  // 3. CLUB SUB CHECK: 95Hz Pure Mono Subwoofer Isolation
  mono_in = (spl0 + spl1) * 0.5;
  m_sub = club_lp_b0*mono_in + club_lp_b1*clp_x1 + club_lp_b2*clp_x2 - club_lp_a1*clp_y1 - club_lp_a2*clp_y2;
  clp_x2 = clp_x1; clp_x1 = mono_in; clp_y2 = clp_y1; clp_y1 = m_sub;
  spl0 = m_sub; spl1 = m_sub;
);

// Ensure bit-transparent raw audio passthrough when Oracle Raw Audit is active
oracle_raw_audit ? (
  spl0 = s_in_l;
  spl1 = s_in_r;
);

s_out_pk = max(abs(spl0), abs(spl1));
out_peak_hold = max(out_peak_hold * 0.99995, s_out_pk);
cur_out_true_peak = 20.0 * log10(max(out_peak_hold, 0.000001));

sq_out = (spl0 * spl0 + spl1 * spl1) * 0.5;
vu_att = exp(-1.0 / (0.300 * srate));
vu_ballistics = vu_ballistics * vu_att + sq_out * (1.0 - vu_att);
cur_vu_rms = vu_ballistics > 0.0000000001 ? 10.0 * log10(vu_ballistics) : -90.0;
cur_crest = max(1.0, cur_out_true_peak - cur_vu_rms);

// Broadcast Live Master Bus Telemetry to gmem for Drum Bus Architect & Systemwide AI
gmem[800] = cur_vu_rms;
gmem[801] = cur_out_true_peak;
gmem[802] = cur_crest;
gmem[805] = tb_pct_low;
gmem[806] = tb_pct_lmid;
gmem[807] = tb_pct_hmid;
gmem[808] = tb_pct_high;

// Project State Bus (decimated, ~46 Hz at 48k)
pb_cnt += 1;
pb_cnt >= 1024 ? (
  pb_cnt = 0;
  publish_project_state();
);

// Whole-Song & Section Dynamics Audit Accumulator
audit_active ? (
  audit_samples += 1;
  (audit_samples % 2048) == 0 ? (
    s_rms_db = 20.0 * log10(max(cur_rms, 0.000001));
    s_rms_db > -70.0 ? (
      audit_rms_sum += (cur_rms * cur_rms);
      audit_rms_count += 1;
      audit_peak_hold = max(audit_peak_hold, cur_out_true_peak);

      s_rms_db > audit_loudest_rms ? audit_loudest_rms = s_rms_db;
      (s_rms_db < audit_quietest_rms || audit_quietest_rms == 0.0) ? audit_quietest_rms = s_rms_db;

      struct_state == 3 ? (
        chorus_rms_acc   += (cur_rms * cur_rms);
        chorus_acc_count += 1;
      ) : struct_state == 5 ? (
        verse_rms_acc   += (cur_rms * cur_rms);
        verse_acc_count += 1;
      );
    );
  );
);

assist_state == 1 ? (
  assist_samples += 1;
  assist_samples >= srate * 4.0 ? (
    assist_state = 0;
    ai_calibrated = 1;
    calibrate_to_project(slider39);
  );
);

@gfx 1080 700
w = gfx_w;
h = gfx_h;

mouse_clicked = (mouse_cap & 1) && !prev_mouse_down;
mouse_down = (mouse_cap & 1);
shift_down = (mouse_cap & 8);
ctrl_down = (mouse_cap & 4);
is_double_click = 0;
mouse_clicked ? (
  (time_precise() - last_click_t < 0.28) ? ( is_double_click = 1; );
  last_click_t = time_precise();
);
m_wheel = mouse_wheel; mouse_wheel = 0;

crt_margin = 8;
crt_x = crt_margin;
crt_y = crt_margin;
crt_w = w - crt_margin * 2;
crt_h = h - crt_margin * 2;

// Outer CRT Chassis Background (100% Canvas Coverage)
gfx_r = 0.022; gfx_g = 0.028; gfx_b = 0.038;
gfx_rect(0, 0, w, h);

// Corner Machine Hex Screws
draw_hex_bolt(crt_x + 10, crt_y + 10);
draw_hex_bolt(crt_x + crt_w - 10, crt_y + 10);
draw_hex_bolt(crt_x + 10, crt_y + crt_h - 10);
draw_hex_bolt(crt_x + crt_w - 10, crt_y + crt_h - 10);

// Outer Bezel Chamfer & Metal Outline
gfx_r = 0.07; gfx_g = 0.10; gfx_b = 0.14;
gfx_rect(crt_x, crt_y, crt_w, crt_h, 0);
gfx_rect(crt_x + 1, crt_y + 1, crt_w - 2, crt_h - 2, 0);

// ─────────────────────────────────────────────────────────────────────────────
// 1. TOP HEADER BAR: ZERO-WARP & ZERO-OVERLAP DYNAMIC RESPONSIVE GEOMETRY
// ─────────────────────────────────────────────────────────────────────────────
hdr_h = 48;
gfx_r = 0.035; gfx_g = 0.048; gfx_b = 0.065;
gfx_rect(crt_x + 2, crt_y + 2, crt_w - 4, hdr_h);
gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20;
gfx_line(crt_x + 2, crt_y + hdr_h + 2, crt_x + crt_w - 2, crt_y + hdr_h + 2);

// Authentic Adinkra Mate Masie Sigil ("What I hear, I keep" - Deep Listening & Wisdom)
draw_matemasie_sigil(crt_x + 24, crt_y + 24, 12);

gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_setfont(1, "Orbitron", 17, 'b');
gfx_x = crt_x + 44; gfx_y = crt_y + 15;
gfx_drawstr("DAMEI // MIXING CONSOLE");

// Dynamic Boundary Anchors
title_end_x = crt_x + 295;

// Glowing Oracle Raw Audit Badge
gmem[1098] == 1 ? (
  raw_badge_w = 260;
  raw_badge_x = crt_x + 305;
  gfx_r = 0.85; gfx_g = 0.15; gfx_b = 0.20; gfx_rect(raw_badge_x, crt_y + 9, raw_badge_w, 30);
  gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.20; gfx_rect(raw_badge_x, crt_y + 9, raw_badge_w, 30, 0);
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_r = 1.00; gfx_g = 0.95; gfx_b = 0.85;
  raw_str = "⚡ ORACLE RAW AUDIT: PASSTHROUGH";
  gfx_measurestr(raw_str, rsw, rsh);
  gfx_x = raw_badge_x + (raw_badge_w - rsw) * 0.5; gfx_y = crt_y + 17;
  gfx_drawstr(raw_str);
);

// ─────────────────────────────────────────────────────────────────────────────
// SHOOTOUT MONITOR TOGGLE (Syncs with Sankofa Oracle via gmem[1158])
// ─────────────────────────────────────────────────────────────────────────────
gmem[1160] == 1 ? (
  sh_x = crt_x + 575;
  sh_w = 145;
  sh_h = 30;
  sh_mode = gmem[1158]; // 0=Mix, 1=Ref Matched, 2=Ref Raw, 3=Null Diff
  sh_hov = (mouse_x >= sh_x && mouse_x <= sh_x + sh_w && mouse_y >= crt_y + 9 && mouse_y <= crt_y + 39);
  sh_clk = sh_hov && (mouse_cap & 1) && !prev_mouse_down;
  sh_clk ? (
    sh_mode = (sh_mode == 0 ? 1 : (sh_mode == 1 ? 3 : 0));
    gmem[1158] = sh_mode;
  );
  sh_mode == 0 ? (
