  c_btn_w = max(36, floor((c_col_w - 28) / 3));
  c_btn_y = disp_y + 32 + c_h - 34;
  dyn_scope_y = disp_y + 134;
  dyn_scope_h = max(28, c_btn_y - dyn_scope_y - 8);

  // ── Card 1: Bus Comp Glue ──
