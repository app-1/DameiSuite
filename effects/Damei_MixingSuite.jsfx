  de_t_plus  = (mouse_x >= disp_x + 32 + eq_col_w * 2 + btn_w1 && mouse_x <= disp_x + 32 + eq_col_w * 2 + btn_w1 * 2 && mouse_y >= btn_y1 && mouse_y <= btn_y1 + 28);
