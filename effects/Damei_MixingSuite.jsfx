  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = disp_x + 24; gfx_y = dyn_scope_y + 4; gfx_drawstr("VCA GLUE COMPRESSION ACTIVITY");
  gr_bar_w = c_col_w - 44;
