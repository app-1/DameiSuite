@init
ext_noinit = 1;
srate <= 0 ? srate = 48000;
env_headroom_rms = 0;
smooth_headroom_fader = 0.0;

// Filter buffers & biquads
hpf_x1_l = 0; hpf_x2_l = 0; hpf_y1_l = 0; hpf_y2_l = 0;
hpf_x1_r = 0; hpf_x2_r = 0; hpf_y1_r = 0; hpf_y2_r = 0;

debox_x1_l = 0; debox_x2_l = 0; debox_y1_l = 0; debox_y2_l = 0;
debox_x1_r = 0; debox_x2_r = 0; debox_y1_r = 0; debox_y2_r = 0;

deharsh_x1_l = 0; deharsh_x2_l = 0; deharsh_y1_l = 0; deharsh_y2_l = 0;
deharsh_x1_r = 0; deharsh_x2_r = 0; deharsh_y1_r = 0; deharsh_y2_r = 0;

mono_x1_l = 0; mono_x2_l = 0; mono_y1_l = 0; mono_y2_l = 0;
mono_x1_r = 0; mono_x2_r = 0; mono_y1_r = 0; mono_y2_r = 0;

tilt_x1_l = 0; tilt_x2_l = 0; tilt_y1_l = 0; tilt_y2_l = 0;
tilt_x1_r = 0; tilt_x2_r = 0; tilt_y1_r = 0; tilt_y2_r = 0;

// Vocal Donut Hole biquads & buffers
donut_x1 = 0; donut_x2 = 0; donut_y1 = 0; donut_y2 = 0;

// Vocal Space & Halo Delay Buffers with Anti-Drum Transient Isolation
voc_buf_l = 80000;
voc_buf_r = 95000;
voc_buf_sz = 14000;
voc_idx = 0;
voc_halo_lp_l = 0;
voc_halo_lp_r = 0;
voc_hpf_s = 0;
voc_lpf_s = 0;
voc_drum_gate = 1.0;
donut_b0 = 1; donut_b1 = 0; donut_b2 = 0; donut_a1 = 0; donut_a2 = 0;

// Guitar Chug Guard biquads & buffers
chug_x1_l = 0; chug_x2_l = 0; chug_y1_l = 0; chug_y2_l = 0;
chug_x1_r = 0; chug_x2_r = 0; chug_y1_r = 0; chug_y2_r = 0;
chug_b0 = 1; chug_b1 = 0; chug_b2 = 0; chug_a1 = 0; chug_a2 = 0;
env_chug = 0;
chug_gr = 0;

// Bass 3-Way Crossover biquads & buffers
bass_grit_x1_l = 0; bass_grit_x2_l = 0; bass_grit_y1_l = 0; bass_grit_y2_l = 0;
bass_grit_x1_r = 0; bass_grit_x2_r = 0; bass_grit_y1_r = 0; bass_grit_y2_r = 0;
bass_grit_b0 = 1; bass_grit_b1 = 0; bass_grit_b2 = 0; bass_grit_a1 = 0; bass_grit_a2 = 0;

bass_box_x1_l = 0; bass_box_x2_l = 0; bass_box_y1_l = 0; bass_box_y2_l = 0;
bass_box_x1_r = 0; bass_box_x2_r = 0; bass_box_y1_r = 0; bass_box_y2_r = 0;
bass_box_b0 = 1; bass_box_b1 = 0; bass_box_b2 = 0; bass_box_a1 = 0; bass_box_a2 = 0;

// Drum Transient Designer state
env_trans_fast_l = 0; env_trans_fast_r = 0;
env_trans_slow_l = 0; env_trans_slow_r = 0;
env_trans_sust_l = 0; env_trans_sust_r = 0;
trans_punch_meter = 0;
trans_sust_meter = 0;

// Air Sheen High-Shelf filter buffers
air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;
air_b0 = 1; air_b1 = 0; air_b2 = 0; air_a1 = 0; air_a2 = 0;

// Precision Sibilance De-Esser biquads & state
deess_x1_l = 0; deess_x2_l = 0; deess_y1_l = 0; deess_y2_l = 0;
deess_x1_r = 0; deess_x2_r = 0; deess_y1_r = 0; deess_y2_r = 0;
deess_b0 = 1; deess_b1 = 0; deess_b2 = 0; deess_a1 = 0; deess_a2 = 0;
env_deess = 0;
deess_gr = 0;

// Sidechain HPF Detector biquad buffers
sc_hpf_x1 = 0; sc_hpf_x2 = 0; sc_hpf_y1 = 0; sc_hpf_y2 = 0;
sc_hpf_b0 = 1; sc_hpf_b1 = 0; sc_hpf_b2 = 0; sc_hpf_a1 = 0; sc_hpf_a2 = 0;

// Tonal Balance 4-Band Crossover Filter Bank (250Hz, 2kHz, 8kHz Linkwitz-Riley)
tb_lp250_x1 = 0; tb_lp250_x2 = 0; tb_lp250_y1 = 0; tb_lp250_y2 = 0;
tb_lp2k_x1 = 0; tb_lp2k_x2 = 0; tb_lp2k_y1 = 0; tb_lp2k_y2 = 0;
tb_lp8k_x1 = 0; tb_lp8k_x2 = 0; tb_lp8k_y1 = 0; tb_lp8k_y2 = 0;

tb_nrg_low = 0; tb_nrg_lmid = 0; tb_nrg_hmid = 0; tb_nrg_high = 0;
tb_pct_low = 55.0; tb_pct_lmid = 30.0; tb_pct_hmid = 13.0; tb_pct_high = 2.0;

// Tonal Balance Target Corridors for Active Preset
tb_tgt_low_min = 50.0; tb_tgt_low_max = 60.0;
tb_tgt_lmid_min = 28.0; tb_tgt_lmid_max = 36.0;
tb_tgt_hmid_min = 9.0;  tb_tgt_hmid_max = 14.0;
tb_tgt_high_min = 1.0;  tb_tgt_high_max = 2.5;

// Mix Bus Compressor continuous envelope follower
comp_gr = 0.0;
comp_det_env = 0.0;
comp_red_meter = 0;

// Mix Headroom & Loudness telemetry
cur_peak = 0.0;
cur_in_peak = 0.0;
in_peak_hold = 0.0;
cur_true_peak = -90.0;
cur_out_true_peak = -90.0;
out_peak_hold = 0.0;
peak_hold = 0.0;
cur_rms = -90.0;
rms_sq_smooth = 0.000000001;
cur_crest = 14.0;
cur_corr = 1.0;
headroom_margin = 6.0;
auto_headroom_gain = 0.0;

// Analogue 0 VU Leveler state
cur_vu_rms = -90.0;
vu_ballistics = 0.000000001;
vu_auto_gain = 0.0;

// Telemetry buffers
scope_idx = 0;
scope_buf_l = 1000;
scope_buf_r = 1100;

// AI Mix State Machine
!is_mix_initialized ? (
  is_mix_initialized = 1;
  ai_mix_state = 0;
  mix_rider_smooth = 0.0;
);
mix_dyn_tilt = 0.0;
mix_dyn_demud = 0.0;
ai_mix_samples = 0;
ai_mix_msg = "Mix Headroom Guardian Active: Ready for analysis.";
ai_selected_ref = slider39 > 0 ? slider39 : 1;
ai_calibrated = 0;
ai_cal_trim = 0.0;
ai_cal_thresh = -12.0;
ai_cal_gr_target = 1.5;
ai_status_l1 = "REF ENGINE : Bandcamp CD Master System";
ai_status_l2 = "CAL STATUS : Awaiting Audio Stream...";
ai_status_l3 = "HEADROOM   : Strict <= -6.0 dBTP Locked";
ai_status_l4 = "BUS CLIPPER: Staged Hermite Knee Ready";
ai_status_l5 = "AUDIT READY: Click 'Tailor & Calibrate'";

// Song Structure & Chorus Explosion AI Engine
struct_slow_rms = -18.0;
struct_fast_rms = -18.0;
struct_hi_nrg = 2.0;
struct_state = 0; // 0=Verse/Baseline, 1=Pre-Chorus, 2=Pre-Drop Breath, 3=Chorus Impact, 4=Bridge
chorus_hold_timer = 0;
dyn_width_boost = 0.0;
dyn_punch_boost = 0.0;
dyn_drive_boost = 0.0;
dyn_vocal_boost = 0.0;
struct_status_str = "VERSE // PRESET FIDELITY BALANCED";

// CRT Aesthetic parameters
crt_phase = 0.0;
prev_mouse_down = 0;

function draw_hex_bolt(bx, by) (
  gfx_r = 0.28; gfx_g = 0.35; gfx_b = 0.45;
  gfx_circle(bx, by, 3, 1);
  gfx_r = 0.12; gfx_g = 0.16; gfx_b = 0.22;
  gfx_line(bx - 2, by, bx + 2, by);
);

function draw_matemasie_sigil(cx, cy, sz) (
  d = sz * 0.54;
  r_out = sz * 0.44;
  r_in = sz * 0.22;
  gfx_r = 0.00; gfx_g = 0.55; gfx_b = 0.70;
  gfx_line(cx - d, cy - d, cx + d, cy + d);
  gfx_line(cx - d, cy + d, cx + d, cy - d);
  gfx_line(cx - d, cy, cx + d, cy);
  gfx_line(cx, cy - d, cx, cy + d);
  gfx_r = 0.00; gfx_g = 0.90; gfx_b = 1.00;
  gfx_circle(cx - d, cy - d, r_out, 0);
  gfx_circle(cx + d, cy - d, r_out, 0);
  gfx_circle(cx - d, cy + d, r_out, 0);
  gfx_circle(cx + d, cy + d, r_out, 0);
  gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  gfx_circle(cx - d, cy - d, r_in, 1);
  gfx_circle(cx + d, cy - d, r_in, 1);
  gfx_circle(cx - d, cy + d, r_in, 1);
  gfx_circle(cx + d, cy + d, r_in, 1);
  gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_circle(cx, cy, max(2, sz * 0.16), 1);
);

function draw_dwennimmen_sigil(cx, cy, sz) (
  // Dwennimmen (Ram's Horns - Strength paired with Humility & Restraint)
  r1 = sz * 0.50; r2 = sz * 0.32;
  gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  gfx_circle(cx - r1 * 0.7, cy, r1, 0);
  gfx_circle(cx + r1 * 0.7, cy, r1, 0);
  gfx_circle(cx - r1 * 0.7, cy, r2, 0);
  gfx_circle(cx + r1 * 0.7, cy, r2, 0);
  gfx_line(cx, cy - sz * 0.7, cx, cy + sz * 0.7);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_circle(cx, cy, 2, 1);
);

function draw_asase_sigil(cx, cy, sz) (
  // Asase Ye Duru (The Earth has weight - Foundational Sub-Bass Authority)
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_rect(cx - sz * 0.6, cy - sz * 0.6, sz * 1.2, sz * 1.2, 0);
  gfx_circle(cx, cy, sz * 0.4, 0);
  gfx_line(cx - sz * 0.6, cy, cx + sz * 0.6, cy);
  gfx_line(cx, cy - sz * 0.6, cx, cy + sz * 0.6);
  gfx_circle(cx, cy, 2, 1);
);

function calc_biquad_lpf(f, q) (
  w0 = 2.0 * $pi * f / srate;
  alpha = sin(w0) / (2.0 * q);
  cos_w0 = cos(w0);
  b0 = (1.0 - cos_w0) * 0.5;
  b1 = 1.0 - cos_w0;
  b2 = (1.0 - cos_w0) * 0.5;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cos_w0;
  a2 = 1.0 - alpha;
  lpf_b0 = b0 / a0; lpf_b1 = b1 / a0; lpf_b2 = b2 / a0;
  lpf_a1 = a1 / a0; lpf_a2 = a2 / a0;
);

function calc_biquad_hpf(f, q) (
  w0 = 2.0 * $pi * f / srate;
  alpha = sin(w0) / (2.0 * q);
  cos_w0 = cos(w0);
  b0 = (1.0 + cos_w0) * 0.5;
  b1 = -(1.0 + cos_w0);
  b2 = (1.0 + cos_w0) * 0.5;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cos_w0;
  a2 = 1.0 - alpha;
  hpf_b0 = b0 / a0; hpf_b1 = b1 / a0; hpf_b2 = b2 / a0;
  hpf_a1 = a1 / a0; hpf_a2 = a2 / a0;
);

function calc_biquad_highshelf(f, gain_db, q) (
  w0 = 2.0 * $pi * f / srate;
  A = exp(gain_db * (log(10.0) / 40.0));
  cos_w0 = cos(w0);
  sin_w0 = sin(w0);
  alpha = sin_w0 / (2.0 * q);
  beta = 2.0 * sqrt(A) * alpha;
  b0 = A * ((A + 1.0) + (A - 1.0) * cos_w0 + beta);
  b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * cos_w0);
  b2 = A * ((A + 1.0) + (A - 1.0) * cos_w0 - beta);
  a0 = (A + 1.0) - (A - 1.0) * cos_w0 + beta;
  a1 = 2.0 * ((A - 1.0) - (A + 1.0) * cos_w0);
  a2 = (A + 1.0) - (A - 1.0) * cos_w0 - beta;
  hs_b0 = b0 / a0; hs_b1 = b1 / a0; hs_b2 = b2 / a0;
  hs_a1 = a1 / a0; hs_a2 = a2 / a0;
);

function calc_biquad_bell(f, gain_db, q) (
  w0 = 2.0 * $pi * f / srate;
  alpha = sin(w0) / (2.0 * q);
  A = exp(gain_db * (log(10.0) / 40.0));
  cos_w0 = cos(w0);
  b0 = 1.0 + alpha * A;
  b1 = -2.0 * cos_w0;
  b2 = 1.0 - alpha * A;
  a0 = 1.0 + alpha / A;
  a1 = -2.0 * cos_w0;
  a2 = 1.0 - alpha / A;
  bell_b0 = b0 / a0; bell_b1 = b1 / a0; bell_b2 = b2 / a0;
  bell_a1 = a1 / a0; bell_a2 = a2 / a0;
);

function update_mix_filters() (
  calc_biquad_highshelf(9500.0, slider16, 0.7071);
  air_b0 = hs_b0; air_b1 = hs_b1; air_b2 = hs_b2;
  air_a1 = hs_a1; air_a2 = hs_a2;

  calc_biquad_hpf(30.0, 0.7071);
  calc_biquad_bell(slider18, slider17, 1.4);
  debox_b0 = bell_b0; debox_b1 = bell_b1; debox_b2 = bell_b2;
  debox_a1 = bell_a1; debox_a2 = bell_a2;

  calc_biquad_bell(slider20, slider19, 1.8);
  deharsh_b0 = bell_b0; deharsh_b1 = bell_b1; deharsh_b2 = bell_b2;
  deharsh_a1 = bell_a1; deharsh_a2 = bell_a2;

  calc_biquad_hpf(slider6, 0.7071);
  mono_b0 = hpf_b0; mono_b1 = hpf_b1; mono_b2 = hpf_b2;
  mono_a1 = hpf_a1; mono_a2 = hpf_a2;

  // Vocal Donut-Hole Carver (Mid channel notch)
  d_gain = (slider28 == 1 ? -1.8 : (slider28 == 2 ? -3.5 : 0.0));
  calc_biquad_bell(slider29, d_gain, 2.2);
  donut_b0 = bell_b0; donut_b1 = bell_b1; donut_b2 = bell_b2;
  donut_a1 = bell_a1; donut_a2 = bell_a2;

  // Guitar Palm-Mute Chug Guard (Dynamic Low-Mid Notch)
  c_gain = (slider30 == 1 ? -2.5 : (slider30 == 2 ? -5.0 : 0.0));
  calc_biquad_bell(slider31, c_gain, 3.2);
  chug_b0 = bell_b0; chug_b1 = bell_b1; chug_b2 = bell_b2;
  chug_a1 = bell_a1; chug_a2 = bell_a2;

  // Bass 3-Way Crossover (250Hz Box Scoop + Mid Grit)
  box_gain = (slider33 > 0 ? -2.2 : 0.0);
  calc_biquad_bell(250.0, box_gain, 1.8);
  bass_box_b0 = bell_b0; bass_box_b1 = bell_b1; bass_box_b2 = bell_b2;
  bass_box_a1 = bell_a1; bass_box_a2 = bell_a2;

  grit_gain = (slider33 == 1 ? 1.8 : (slider33 == 2 ? 3.6 : 0.0));
  calc_biquad_bell(1200.0, grit_gain, 1.4);
  bass_grit_b0 = bell_b0; bass_grit_b1 = bell_b1; bass_grit_b2 = bell_b2;
  bass_grit_a1 = bell_a1; bass_grit_a2 = bell_a2;

  // Precision De-Esser Sidechain Bell (5.5kHz - 8.5kHz)
  calc_biquad_bell(slider37, 6.0, 2.5);
  deess_b0 = bell_b0; deess_b1 = bell_b1; deess_b2 = bell_b2;
  deess_a1 = bell_a1; deess_a2 = bell_a2;

  // Mix Bus Comp Sidechain HPF (slider13: 20 - 250 Hz - ELIMINATES LOW-END PUMPING)
  calc_biquad_hpf(slider13, 0.7071);
  sc_hpf_b0 = hpf_b0; sc_hpf_b1 = hpf_b1; sc_hpf_b2 = hpf_b2;
  sc_hpf_a1 = hpf_a1; sc_hpf_a2 = hpf_a2;

  // Tonal Balance 4-Band Crossover Filters (250Hz, 2kHz, 8kHz Linkwitz-Riley)
  calc_biquad_lpf(250.0, 0.7071);
  tb_lp250_b0 = lpf_b0; tb_lp250_b1 = lpf_b1; tb_lp250_b2 = lpf_b2;
  tb_lp250_a1 = lpf_a1; tb_lp250_a2 = lpf_a2;

  calc_biquad_lpf(2000.0, 0.7071);
  tb_lp2k_b0 = lpf_b0; tb_lp2k_b1 = lpf_b1; tb_lp2k_b2 = lpf_b2;
  tb_lp2k_a1 = lpf_a1; tb_lp2k_a2 = lpf_a2;

  calc_biquad_lpf(8000.0, 0.7071);
  tb_lp8k_b0 = lpf_b0; tb_lp8k_b1 = lpf_b1; tb_lp8k_b2 = lpf_b2;
  tb_lp8k_a1 = lpf_a1; tb_lp8k_a2 = lpf_a2;
);

function init_translation_filters() (
  // 1. Car Cabin Standing Wave Resonance: Peak EQ at 52 Hz, +5.0 dB, Q = 1.6
  f0_c = 52.0; gain_c = 5.0; q_c = 1.6;
  a_c = exp(gain_c * (log(10.0) / 40.0));
  w0_c = 2.0 * $pi * f0_c / srate;
  cos_c = cos(w0_c); sin_c = sin(w0_c);
  alpha_c = sin_c / (2.0 * q_c);
  b0_c = 1.0 + alpha_c * a_c; b1_c = -2.0 * cos_c; b2_c = 1.0 - alpha_c * a_c;
  a0_c = 1.0 + alpha_c / a_c; a1_c = -2.0 * cos_c; a2_c = 1.0 - alpha_c / a_c;
  car_p1_b0 = b0_c/a0_c; car_p1_b1 = b1_c/a0_c; car_p1_b2 = b2_c/a0_c;
  car_p1_a1 = a1_c/a0_c; car_p1_a2 = a2_c/a0_c;

  // 2. Door Panel Cavity Resonance: Peak EQ at 240 Hz, +2.2 dB, Q = 2.0
  f0_d = 240.0; gain_d = 2.2; q_d = 2.0;
  a_d = exp(gain_d * (log(10.0) / 40.0));
  w0_d = 2.0 * $pi * f0_d / srate;
  cos_d = cos(w0_d); sin_d = sin(w0_d);
  alpha_d = sin_d / (2.0 * q_d);
  b0_d = 1.0 + alpha_d * a_d; b1_d = -2.0 * cos_d; b2_d = 1.0 - alpha_d * a_d;
  a0_d = 1.0 + alpha_d / a_d; a1_d = -2.0 * cos_d; a2_d = 1.0 - alpha_d / a_d;
  car_p2_b0 = b0_d/a0_d; car_p2_b1 = b1_d/a0_d; car_p2_b2 = b2_d/a0_d;
  car_p2_a1 = a1_d/a0_d; car_p2_a2 = a2_d/a0_d;

  // 3. Windshield Glass Reflection Tilt: High-Shelf at 3.8 kHz, +2.5 dB, Q = 0.8
  f0_g = 3800.0; gain_g = 2.5; q_g = 0.8;
  a_g = exp(gain_g * (log(10.0) / 40.0));
  w0_g = 2.0 * $pi * f0_g / srate;
  cos_g = cos(w0_g); sin_g = sin(w0_g);
  alpha_g = sin_g / (2.0 * q_g);
  two_sqrt_a_alpha = 2.0 * sqrt(a_g) * alpha_g;
  b0_g = a_g * ((a_g + 1.0) + (a_g - 1.0)*cos_g + two_sqrt_a_alpha);
  b1_g = -2.0 * a_g * ((a_g - 1.0) + (a_g + 1.0)*cos_g);
  b2_g = a_g * ((a_g + 1.0) + (a_g - 1.0)*cos_g - two_sqrt_a_alpha);
  a0_g = (a_g + 1.0) - (a_g - 1.0)*cos_g + two_sqrt_a_alpha;
  a1_g = 2.0 * ((a_g - 1.0) - (a_g + 1.0)*cos_g);
  a2_g = (a_g + 1.0) - (a_g - 1.0)*cos_g - two_sqrt_a_alpha;
  car_sh_b0 = b0_g/a0_g; car_sh_b1 = b1_g/a0_g; car_sh_b2 = b2_g/a0_g;
  car_sh_a1 = a1_g/a0_g; car_sh_a2 = a2_g/a0_g;

  // 4. Phone Speaker Bandpass: 220Hz HPF & 11.5kHz LPF
  w0_php = 2.0 * $pi * 220.0 / srate;
  cos_php = cos(w0_php); alpha_php = sin(w0_php) / (2.0 * 0.7071);
  php_a0 = 1.0 + alpha_php;
  phone_hp_b0 = ((1.0 + cos_php)*0.5) / php_a0;
  phone_hp_b1 = (-(1.0 + cos_php)) / php_a0;
  phone_hp_b2 = ((1.0 + cos_php)*0.5) / php_a0;
  phone_hp_a1 = (-2.0 * cos_php) / php_a0;
  phone_hp_a2 = (1.0 - alpha_php) / php_a0;

  w0_plp = 2.0 * $pi * 11500.0 / srate;
  cos_plp = cos(w0_plp); alpha_plp = sin(w0_plp) / (2.0 * 0.7071);
  plp_a0 = 1.0 + alpha_plp;
  phone_lp_b0 = ((1.0 - cos_plp)*0.5) / plp_a0;
  phone_lp_b1 = (1.0 - cos_plp) / plp_a0;
  phone_lp_b2 = ((1.0 - cos_plp)*0.5) / plp_a0;
  phone_lp_a1 = (-2.0 * cos_plp) / plp_a0;
  phone_lp_a2 = (1.0 - alpha_plp) / plp_a0;

  // 5. Club Subwoofer Check: 95Hz LPF (Butterworth)
  w0_clp = 2.0 * $pi * 95.0 / srate;
  cos_clp = cos(w0_clp); alpha_clp = sin(w0_clp) / (2.0 * 0.7071);
  clp_a0 = 1.0 + alpha_clp;
  club_lp_b0 = ((1.0 - cos_clp)*0.5) / clp_a0;
  club_lp_b1 = (1.0 - cos_clp) / clp_a0;
  club_lp_b2 = ((1.0 - cos_clp)*0.5) / clp_a0;
  club_lp_a1 = (-2.0 * cos_clp) / clp_a0;
  club_lp_a2 = (1.0 - alpha_clp) / clp_a0;
);
init_translation_filters();
update_mix_filters();

function apply_mix_preset(p_idx) (
  slider3 = -6.0; // Pre-Master Export Target Ceiling ALWAYS locked to -6.0 dBTP
  slider4 = 1;    // Strict -6.0 dBTP Headroom Guardian Leveler ACTIVE
  slider44 = 1;   // Default Song Structure & Chorus Impact AI: Active (Tasteful Auto-Impact)
  
  // Real-time pre-master trim alignment: Attenuate loud mixes down to -6.0 dBTP, clamp max boost to +0.5 dB
  cur_true_peak > -75.0 ? (
    slider5 = max(-18.0, min(0.5, -6.0 - cur_true_peak));
  ) : (
    slider5 = 0.0;
  );

  p_idx == 1 ? (
    // Lance Prenc (Alpha Wolf / Polaris)
    // Reference: Alpha Wolf - 60cm Of Steel (RMS: -7.54, Crest: 7.44, Corr: 0.613, Width: 0.49)
    // Sonic Signature: Snapping punch, aggressive guitars, vocal pocket, pentode bite — NO PUMPING, BALANCED
    slider8  = 0;     // British VCA
    slider9  = -7.5;  // Threshold relaxed (prevents over-compression and pumping)
    slider10 = 1;     // Ratio: 2:1
    slider11 = 30.0;  // Attack: 30ms (Transient snap)
    slider12 = 0;     // Auto Release (zero pumping)
    slider13 = 130.0; // SC HPF: 130 Hz (protects kick & sub drops from pumping)
    slider14 = 0.2;   // Makeup: +0.2 dB
    slider15 = 100;
    slider16 = 0.7;   // Modern air sheen: +0.7 dB (never dark!)
    slider17 = -2.4;  // De-Box: -2.4 dB at 330 Hz (removes low-mid boxiness)
    slider18 = 330;
    slider19 = 0.0;
    slider21 = 1.4;   // Pentode Harmonic Drive: +1.4 dB (dialed back from 2.2dB: crisp crunch, zero harsh distortion)
    slider22 = 1;     // Punchy Pentode
    slider23 = 1;     // Tape sheen active
    slider24 = 0;
    slider27 = 0;
    slider28 = 1;     // Vocal Donut Hole: -1.8dB at 2.5 kHz
    slider29 = 2500;
    slider30 = 1;     // Guitar Palm-Mute Chug Guard: 190 Hz
    slider31 = 190;
    slider33 = 1;     // Bass Crossover: Sub DI anchor + 1.2kHz mid bite
    slider34 = 1.3;   // Drum Attack Punch: +1.3 dB (punchy snare/kick crack, no distortion)
    slider35 = -0.2;  // Drum Sustain: -0.2 dB
    slider36 = -18.0;
    slider37 = 6800;
    slider38 = 1;     // De-Esser precision clamp
    slider40 = 1;     // Smooth Musical Bus Clipper
    slider41 = 0.8;   // Vocal Level: +0.8dB (cuts through dense wall with snare crack)
    slider42 = 0;     // Space: Dry Upfront Punch
    slider43 = 1.6;   // Vocal Bite: +1.6dB Pentode edge
    slider6  = 100;   // Sub Mono: 100 Hz (tight low-end, zero buildup)
    slider7  = 1.08;  // Dimension: 1.08x
    
    tb_tgt_low_min = 54.0; tb_tgt_low_max = 61.0;
    tb_tgt_lmid_min = 26.0; tb_tgt_lmid_max = 32.0;
    tb_tgt_hmid_min = 10.5; tb_tgt_hmid_max = 14.0;
    tb_tgt_high_min = 1.0;  tb_tgt_high_max = 2.0;
  ) : p_idx == 2 ? (
    // Scott Seigel (DIESECT)
    // Reference: DIESECT - TOO MANY SCARS (RMS: -7.79, Crest: 7.79, Corr: 0.667, Width: 0.45)
    // Sonic Signature: Crushing heavy wall-of-sound, surgical 320Hz box scoop, pentode grit — BALANCED, NO PUMPING
    slider8  = 0;     // British VCA
    slider9  = -8.0;  // Threshold relaxed (prevents over-compression)
    slider10 = 1;     // Ratio: 2:1
    slider11 = 30.0;  // Attack: 30ms
    slider12 = 0;     // Auto Release (zero pumping)
    slider13 = 135.0; // SC HPF: 135 Hz (shields heavy sub drops from pumping)
    slider14 = 0.3;   // Makeup: +0.3 dB
    slider15 = 100;
    slider16 = 0.7;   // High Presence & Air: +0.7 dB (never dark!)
    slider17 = -2.8;  // De-Box Mud Scoop: -2.8 dB at 320 Hz (clears low-mid buildup)
    slider18 = 320;
    slider19 = -0.8;  // De-Harsh: -0.8 dB at 4.2 kHz
    slider20 = 4200;
    slider21 = 1.5;   // Pentode Drive: +1.5 dB (dialed back from 2.5dB: heavy crunch without distortion fuzz)
    slider22 = 1;     // Punchy Pentode
    slider23 = 1;     // Tape sheen active
    slider24 = 0;
    slider27 = 0;
    slider28 = 1;     // Vocal pocket: -1.8 dB at 2.4 kHz
    slider29 = 2400;
    slider30 = 1;     // Palm-Mute Tamer (180 Hz)
    slider31 = 180;
    slider33 = 1;     // Bass Crossover: Sub DI anchor + mid grit (tamed from tractor grind, zero mud)
    slider34 = 1.2;   // Drum Attack Punch: +1.2 dB
    slider35 = 0.1;   // Drum Sustain: +0.1 dB
    slider36 = -18.0;
    slider38 = 0;
    slider40 = 1;     // Smooth Musical Bus Clipper
    slider41 = 1.0;   // Vocal Level: +1.0dB (in-your-face aggressive crush)
    slider42 = 0;     // Space: Dry Upfront Punch
    slider43 = 2.0;   // Vocal Bite: +2.0dB Heavy Drive
    slider6  = 95;    // Sub Mono: 95 Hz
    slider7  = 1.02;  // Dense Wall of Sound
    
    tb_tgt_low_min = 58.0; tb_tgt_low_max = 65.0;
    tb_tgt_lmid_min = 18.0; tb_tgt_lmid_max = 24.0;
    tb_tgt_hmid_min = 12.0; tb_tgt_hmid_max = 16.0;
    tb_tgt_high_min = 2.5;  tb_tgt_high_max = 4.2;
  ) : p_idx == 3 ? (
    // Jonathan Dolese (Mirrorcell / Cane Hill)
    // Reference: Mirrorcell - U(phoria) (RMS: -7.31, Crest: 7.31, Corr: 0.442, Width: 0.62)
    // Sonic Signature: Expansive 3D stereo soundstage, warm triode tube, vocal donut hole, smooth optical glue
    slider8  = 1;     // Opto 2A Smooth Leveler
    slider9  = -8.0;  // Thresh: -8.0 dB
    slider10 = 0;     // Ratio: 1.5:1
    slider11 = 30.0;
    slider12 = 0;     // Smooth Auto Release
    slider13 = 120.0; // SC HPF: 115 Hz
    slider14 = 0.2;   // Makeup: +0.2 dB
    slider15 = 100;
    slider16 = 0.6;   // Air sheen: +0.6 dB (open, silky top end)
    slider17 = -2.0;  // De-Box: -2.0 dB at 340 Hz
    slider18 = 340;
    slider19 = 0.0;
    slider21 = 1.6;   // Warm Triode Tube: +1.6 dB (rich 2nd harmonic warmth)
    slider22 = 0;     // Warm Triode Tube
    slider23 = 1;     // Tape Air Sheen Active
    slider24 = 0;
    slider27 = 0;
    slider28 = 2;     // Deep Vocal Donut Hole: -2.5 dB at 2.8 kHz
    slider29 = 2800;
    slider30 = 1;     // Chug Guard: 190 Hz
    slider31 = 190;
    slider33 = 1;     // Bass Crossover: Sub DI anchor (<105Hz) + warm tube body
    slider34 = 0.9;   // Drum Attack: +0.9 dB
    slider35 = 0.3;   // Drum Sustain: +0.3 dB
    slider36 = -18.0;
    slider37 = 6500;
    slider38 = 1;
    slider40 = 1;     // Smooth Musical Bus Clipper
    slider41 = 0.8;   // Vocal Level: +0.8dB (wide 3D presence)
    slider42 = 1;     // Space: Stereo 3D Halo
    slider43 = 0.8;   // Vocal Bite: +0.8dB Triode
    slider6  = 105;   // Sub Mono: 105 Hz
    slider7  = 1.18;  // Dimension Width: 1.18x
    
    tb_tgt_low_min = 54.0; tb_tgt_low_max = 61.0;
    tb_tgt_lmid_min = 31.0; tb_tgt_lmid_max = 38.0;
    tb_tgt_hmid_min = 5.0;  tb_tgt_hmid_max = 9.0;
    tb_tgt_high_min = 1.2;  tb_tgt_high_max = 2.5;
  ) : p_idx == 4 ? (
    // Buster Odeholm (thrown / Northlane)
    // References: thrown - on the verge (RMS: -6.85, Crest: 6.85), Northlane - Evian (RMS: -8.58, Crest: 8.48)
    // Sonic Signature: Swedish hyper-punch transient definition, crisp surgical carve, tight British VCA glue
    slider8  = 0;     // British VCA Punch
    slider9  = -8.5;  // Thresh: -8.5 dB
    slider10 = 1;     // Ratio: 2:1
    slider11 = 30.0;  // Attack: 30ms
    slider12 = 0;     // Auto Release (zero pumping)
    slider13 = 125.0; // SC HPF: 125 Hz
    slider14 = 0.3;   // Makeup: +0.3 dB
    slider15 = 100;
    slider16 = 0.8;   // Modern air tilt: +0.8 dB
    slider17 = -2.6;  // De-Box: -2.6 dB at 320 Hz
    slider18 = 320;
    slider19 = -1.0;  // De-Harsh 4.2 kHz: -1.0 dB
    slider20 = 4200;
    slider21 = 1.6;   // Pentode punch drive: +1.6 dB
    slider22 = 1;
    slider23 = 1;     // Tape sheen
    slider24 = 0;
    slider27 = 0;
    slider28 = 1;     // Vocal carve -1.8 dB at 2.6 kHz
    slider29 = 2600;
    slider30 = 1;     // Chug Guard
    slider31 = 185;
    slider33 = 1;     // Bass Crossover: Sub DI + 1.2kHz grit
    slider34 = 1.5;   // Drum Transient Attack: +1.5 dB (hyper-punch snap)
    slider35 = -0.3;  // Drum Sustain: -0.3 dB
    slider36 = -18.0;
    slider37 = 7000;
    slider38 = 1;
    slider40 = 1;     // Smooth Musical Bus Clipper
    slider41 = 1.2;   // Vocal Level: +1.2dB (hyper-punch upfront vocal aggression)
    slider42 = 0;     // Space: Dry Upfront Punch
    slider43 = 1.4;   // Vocal Bite: +1.4dB
    slider6  = 95;    // Sub Mono: 95 Hz
    slider7  = 1.12;  // Dimension: 1.12x
    
    tb_tgt_low_min = 54.0; tb_tgt_low_max = 60.0;
    tb_tgt_lmid_min = 22.0; tb_tgt_lmid_max = 28.0;
    tb_tgt_hmid_min = 13.5; tb_tgt_hmid_max = 17.0;
    tb_tgt_high_min = 2.0;  tb_tgt_high_max = 3.5;
  ) : p_idx == 5 ? (
    // Lewis Johns (Love Is Noise / blanket)
    // References: blanket - Blur (RMS: -8.54, Crest: 8.29), Love Is Noise - Hole In Me (RMS: -7.76, Crest: 7.43)
    // Sonic Signature: Organic breathing, spacious post-hardcore soundstage, lush room sustain, vintage tape warmth
    slider8  = 0;     // British VCA Smooth
    slider9  = -8.0;  // Thresh: -8.0 dB
    slider10 = 0;     // Ratio: 1.5:1
    slider11 = 30.0;  // 30ms attack
    slider12 = 2;     // Smooth 0.3s release (Organic, zero pumping)
    slider13 = 105.0; // SC HPF: 105 Hz
    slider14 = 0.2;   // Makeup: +0.2 dB
    slider15 = 100;
    slider16 = 0.5;   // Natural air sheen: +0.5 dB
    slider17 = -1.8;  // De-Box: -1.8 dB at 340 Hz
    slider18 = 340;
    slider19 = 0.0;
    slider21 = 1.5;   // Vintage Tape Saturation: +1.5 dB (luscious tape character)
    slider22 = 2;     // Vintage Tape Saturation
    slider23 = 1;     // Tape air sheen
    slider24 = 0;
    slider27 = 0;
    slider28 = 1;     // Vocal Donut Hole: -1.5 dB at 2.6 kHz
    slider29 = 2600;
    slider30 = 1;     // Guitar Palm-Mute Chug Guard: 185 Hz (tames low shoegaze fuzz buildup)
    slider31 = 185;
    slider33 = 1;     // Bass Crossover: Sub DI anchor + mid fuzz split
    slider34 = 0.8;   // Drum Attack: +0.8 dB
    slider35 = 0.7;   // Drum Transient Sustain: +0.7 dB (Lush roomy drum tail)
    slider36 = -20.0;
    slider37 = 6200;
    slider38 = 1;
    slider40 = 0;     // Transparent Linear Headroom (Pure dynamic fidelity)
    slider41 = 0.5;   // Vocal Level: +0.5dB (emotional vocal presence floating over ambient wall)
    slider42 = 2;     // Space: Ambient Shoegaze Bloom
    slider43 = 0.6;   // Vocal Bite: +0.6dB Tape Warmth
    slider6  = 95;    // Sub Mono: 90 Hz
    slider7  = 1.18;  // Dimension: 1.18x (Expansive soundstage)
    
    tb_tgt_low_min = 46.0; tb_tgt_low_max = 54.0;
    tb_tgt_lmid_min = 36.0; tb_tgt_lmid_max = 44.0;
    tb_tgt_hmid_min = 7.5;  tb_tgt_hmid_max = 11.5;
    tb_tgt_high_min = 0.8;  tb_tgt_high_max = 1.8;
  ) : p_idx == 6 ? (
    // Kel Pinchin (Split Chain)
    // Reference: Split Chain - I'm Not Dying To Be Here (RMS: -9.23, Crest: 8.93, Corr: 0.478, Width: 0.59)
    // Sonic Signature: Grungy 90s shoegaze fuzz warmth, punchy glue, balanced body, tape sheen
    slider8  = 0;     // British VCA
    slider9  = -8.0;  // Thresh: -8.0 dB
    slider10 = 1;     // Ratio: 2:1
    slider11 = 30.0;  // Attack: 30ms
    slider12 = 0;     // Auto release (zero pumping)
    slider13 = 110.0; // SC HPF: 110 Hz
    slider14 = 0.3;   // Makeup: +0.3 dB
    slider15 = 100;
    slider16 = 0.6;   // Tilt: +0.6 dB (open, clear top end)
    slider17 = -2.0;  // De-Box: -2.0 dB at 330 Hz
    slider18 = 330;
    slider19 = 0.0;
    slider21 = 1.6;   // Pentode Harmonic Drive: +1.6 dB (shoegaze fuzz warmth)
    slider22 = 1;     // Punchy Pentode
    slider23 = 1;     // Tape sheen
    slider24 = 0;
    slider27 = 0;
    slider28 = 1;     // Vocal pocket: -2.0 dB at 2.7 kHz (carves clear pocket in fuzz guitars)
    slider29 = 2700;
    slider30 = 1;     // Chug guard 195 Hz
    slider31 = 195;
    slider33 = 2;     // Bass Crossover: Tractor Grind Aggressive (grunge overdriven bass)
    slider34 = 1.1;   // Drum Attack: +1.1 dB
    slider35 = 0.5;   // Drum Sustain: +0.5 dB
    slider36 = -18.0;
    slider37 = 6800;
    slider38 = 1;
    slider40 = 1;     // Smooth Musical Bus Clipper
    slider41 = 0.8;   // Vocal Level: +0.8dB (clear lyric intelligibility over grunge fuzz)
    slider42 = 3;     // Space: Vintage Tape Slap
    slider43 = 1.5;   // Vocal Bite: +1.5dB Grunge Fuzz
    slider44 = 2;     // Commercial Drop Slam (+0.16x Width / +1.4dB Punch on chorus drops)
    slider6  = 100;    // Sub Mono: 95 Hz
    slider7  = 1.14;  // Dimension: 1.14x
    
    tb_tgt_low_min = 46.0; tb_tgt_low_max = 53.0;
    tb_tgt_lmid_min = 27.0; tb_tgt_lmid_max = 33.0;
    tb_tgt_hmid_min = 16.0; tb_tgt_hmid_max = 21.0;
    tb_tgt_high_min = 0.7;  tb_tgt_high_max = 1.6;
  ) : p_idx == 7 ? (
    // Dan Lancaster & Jason Perry (Don Broco / Bring Me The Horizon)
