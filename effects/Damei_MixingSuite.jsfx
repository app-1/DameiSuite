  // 4. Drive Badge
  badge_x += badge_w + 6;
  gfx_r = 0.04; gfx_g = 0.08; gfx_b = 0.12; gfx_rect(badge_x, badge_y, badge_w, badge_h);
  abs(dyn_drive_boost) > 0.01 ? (gfx_r = 0.95; gfx_g = 0.35; gfx_b = 0.25;) : (gfx_r = 0.18; gfx_g = 0.26; gfx_b = 0.36;);
  gfx_rect(badge_x, badge_y, badge_w, badge_h, 0);
