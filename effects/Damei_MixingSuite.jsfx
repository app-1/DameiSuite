  gfx_r = 0.04; gfx_g = 0.06; gfx_b = 0.08; gfx_rect(disp_x + 24, dyn_scope_y + 24, gr_bar_w, 14);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_rect(disp_x + 24, dyn_scope_y + 24, gr_fill_w, 14);
  dyn_scope_h >= 65 ? (
