// =============================================================================
slider1 == 5 ? (
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 14; gfx_y = disp_y + 8;
  gfx_drawstr("PRE-MASTER AI MIX ASSISTANT // BANDCAMP UNCOMPRESSED CD BENCHMARKS");

