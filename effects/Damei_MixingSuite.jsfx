  badge_w = 74; badge_h = 18;
  badge_x = hud_x + hud_w - 12 - (badge_w * 4 + 18);
  badge_y = hud_y + 28;

  // 1. Width Badge
  gfx_r = 0.04; gfx_g = 0.08; gfx_b = 0.12; gfx_rect(badge_x, badge_y, badge_w, badge_h);
  abs(dyn_width_boost) > 0.001 ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) : (gfx_r = 0.18; gfx_g = 0.26; gfx_b = 0.36;);
  gfx_rect(badge_x, badge_y, badge_w, badge_h, 0);
  gfx_setfont(1, "Consolas", 11, 'b');
  w_str = sprintf(#, "W:%+.2fx", dyn_width_boost);
  gfx_measurestr(w_str, bw_w, bw_h);
  gfx_x = floor(badge_x + (badge_w - bw_w) * 0.5); gfx_y = badge_y + 2;
  gfx_drawstr(w_str);

  // 2. Punch Badge
  badge_x += badge_w + 6;
  gfx_r = 0.04; gfx_g = 0.08; gfx_b = 0.12; gfx_rect(badge_x, badge_y, badge_w, badge_h);
  abs(dyn_punch_boost) > 0.01 ? (gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;) : (gfx_r = 0.18; gfx_g = 0.26; gfx_b = 0.36;);
  gfx_rect(badge_x, badge_y, badge_w, badge_h, 0);
  p_str = sprintf(#, "P:%+.1fdB", dyn_punch_boost);
  gfx_measurestr(p_str, bw_w, bw_h);
  gfx_x = floor(badge_x + (badge_w - bw_w) * 0.5); gfx_y = badge_y + 2;
