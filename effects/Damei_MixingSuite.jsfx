c2_x = crt_x + 12 + card_w;
gfx_rect(c2_x, card_y, card_w, card_h);
gfx_r = 0.00; gfx_g = 0.80; gfx_b = 0.95;
gfx_setfont(1, "Consolas", 14, 'b');
gfx_x = c2_x + 10; gfx_y = card_y + 6;
gfx_drawstr("ANALOGUE 0 VU (-18 RMS)");
vu_dev = cur_vu_rms - slider26;
abs(vu_dev) <= 2.0 ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) : (gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;);
gfx_setfont(1, "Orbitron", 24, 'b');
gfx_x = c2_x + 10; gfx_y = card_y + 24;
cur_vu_rms > -90.0 ? gfx_printf("%.1f VU (%+.1f)", vu_dev, cur_vu_rms) : gfx_drawstr("0 VU SWEET");

// Card 3: Dynamic Crest Factor
gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
c3_x = crt_x + 18 + card_w * 2;
gfx_rect(c3_x, card_y, card_w, card_h);
gfx_r = 0.00; gfx_g = 0.80; gfx_b = 0.95;
gfx_setfont(1, "Consolas", 14, 'b');
gfx_x = c3_x + 10; gfx_y = card_y + 6;
gfx_drawstr("CREST DYNAMICS (PUNCH)");
gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
gfx_setfont(1, "Orbitron", 24, 'b');
gfx_x = c3_x + 10; gfx_y = card_y + 24;
gfx_printf("%.1f dB", cur_crest);

// Card 4: Cybernetic AI Mix Assistant & Chorus Impact Panel (Zero-Overlap)
c4_x = crt_x + 24 + card_w * 3;
gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
gfx_rect(c4_x, card_y, card_w, card_h);
gfx_r = 0.16; gfx_g = 0.22; gfx_b = 0.32;
gfx_rect(c4_x, card_y, card_w, card_h, 0);

audit_active == 1 ? (
  gfx_r = 0.08; gfx_g = 0.25; gfx_b = 0.18;
  gfx_rect(c4_x, card_y, card_w, card_h);
  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
  gfx_rect(c4_x, card_y, card_w, card_h, 0);
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = c4_x + 10; gfx_y = card_y + 8;
  gfx_drawstr("● SCANNING SONG STRUCTURE...");

  fin_btn_w = card_w - 20;
  fin_hover = (mouse_x >= c4_x + 10 && mouse_x <= c4_x + 10 + fin_btn_w && mouse_y >= card_y + 32 && mouse_y <= card_y + 62);
  gfx_r = fin_hover ? 0.00 : 0.12; gfx_g = fin_hover ? 0.85 : 0.65; gfx_b = fin_hover ? 0.50 : 0.35;
  gfx_rect(c4_x + 10, card_y + 32, fin_btn_w, 30);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 12, 'b');
  fin_txt = "★ SOLVE CHORUS IMPACT";
  gfx_measurestr(fin_txt, fw, fh);
  gfx_x = floor(c4_x + 10 + (fin_btn_w - fw) * 0.5); gfx_y = card_y + 39;
  gfx_drawstr(fin_txt);

  mouse_clicked && fin_hover ? (
    solve_mixing_chorus_impact();
  );
) : assist_state == 1 ? (
  gfx_r = 0.08; gfx_g = 0.22; gfx_b = 0.28;
  gfx_rect(c4_x, card_y, card_w, card_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 0.40;
  assist_prog = min(1.0, assist_samples / (srate * 4.0));
  gfx_rect(c4_x, card_y, card_w * assist_prog, card_h);
  gfx_a = 1.0;
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 11, 'b');
  ai_label = "MATCHING 4-BAND SPECTRUM...";
  gfx_measurestr(ai_label, alw, alh);
  gfx_x = floor(c4_x + (card_w - alw) * 0.5); gfx_y = card_y + 14;
  gfx_drawstr(ai_label);
  gfx_r = 0.80; gfx_g = 0.95; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 12);
  sub_lbl = "Target: -6.0 dBTP Clean";
  gfx_measurestr(sub_lbl, slw, slh);
  gfx_x = floor(c4_x + (card_w - slw) * 0.5); gfx_y = card_y + 40;
  gfx_drawstr(sub_lbl);
) : ai_calibrated == 1 ? (
  gfx_r = 1.00; gfx_g = 0.78; gfx_b = 0.20;
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = c4_x + 10; gfx_y = card_y + 8;
  gfx_drawstr("★ CHORUS IMPACT ACTIVE");

  re_w = floor((card_w - 24) * 0.48);
  ab_w = floor((card_w - 24) * 0.52);
  re_x = c4_x + 8;
  ab_x = c4_x + 12 + re_w;

  re_hover = (mouse_x >= re_x && mouse_x <= re_x + re_w && mouse_y >= card_y + 32 && mouse_y <= card_y + 62);
  ab_hover = (mouse_x >= ab_x && mouse_x <= ab_x + ab_w && mouse_y >= card_y + 32 && mouse_y <= card_y + 62);

  gfx_r = re_hover ? 0.22 : 0.12; gfx_g = re_hover ? 0.28 : 0.16; gfx_b = re_hover ? 0.38 : 0.22;
  gfx_rect(re_x, card_y + 32, re_w, 30);
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Orbitron", 11, 'b');
  rt_txt = "RE-SCAN";
  gfx_measurestr(rt_txt, rtw, rth);
  gfx_x = floor(re_x + (re_w - rtw) * 0.5); gfx_y = card_y + 40;
  gfx_drawstr(rt_txt);

  gfx_r = ab_bypass ? (ab_hover ? 0.60 : 0.45) : (ab_hover ? 0.18 : 0.10);
  gfx_g = ab_bypass ? (ab_hover ? 0.20 : 0.15) : (ab_hover ? 0.24 : 0.14);
  gfx_b = ab_bypass ? (ab_hover ? 0.20 : 0.15) : (ab_hover ? 0.34 : 0.20);
  gfx_rect(ab_x, card_y + 32, ab_w, 30);
  gfx_r = ab_bypass ? 1.0 : 0.00;
  gfx_g = ab_bypass ? 0.7 : 0.85;
  gfx_b = ab_bypass ? 0.7 : 1.00;
  ab_txt = ab_bypass ? "RAW PRESET" : "A/B: AI ON";
  gfx_measurestr(ab_txt, abtw, abth);
  gfx_x = floor(ab_x + (ab_w - abtw) * 0.5); gfx_y = card_y + 40;
  gfx_drawstr(ab_txt);

  mouse_clicked && re_hover ? (
    audit_active = 1;
    audit_samples = 0;
    audit_loudest_rms = -120.0;
    audit_quietest_rms = 0.0;
    audit_peak_hold = 0.0;
    audit_rms_sum = 0.0;
    audit_rms_count = 0;
    verse_rms_acc = 0.0; verse_acc_count = 0;
    chorus_rms_acc = 0.0; chorus_acc_count = 0;
  );
  mouse_clicked && ab_hover ? (
    ab_bypass = !ab_bypass;
    update_mix_filters();
  );
) : (
  gfx_r = 0.00; gfx_g = 0.88; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = c4_x + 10; gfx_y = card_y + 8;
  gfx_drawstr("◆ AI MIX INTELLIGENCE");

  g_bridge_active ? (
    gfx_r = 0.15; gfx_g = 0.85; gfx_b = 0.45;
    gfx_setfont(1, "Consolas", 11, 'b');
    c4_rgn_str = sprintf(#, "● %d REGIONS SYNCED", g_num_regions_live > 0 ? g_num_regions_live : 20);
    gfx_measurestr(c4_rgn_str, crw, crh);
    gfx_x = c4_x + card_w - crw - 10; gfx_y = card_y + 9;
    gfx_drawstr(c4_rgn_str);
  );

  // Pulsing cyan indicator
  gfx_r = 0.00; gfx_g = 0.88; gfx_b = 1.00;
  gfx_circle(c4_x + card_w - 14, card_y + 14, 3, 1);

  b1_w = floor((card_w - 24) * 0.48);
  b2_w = floor((card_w - 24) * 0.52);
  b1_x = c4_x + 8;
  b2_x = c4_x + 12 + b1_w;

  h1 = (mouse_x >= b1_x && mouse_x <= b1_x + b1_w && mouse_y >= card_y + 32 && mouse_y <= card_y + 62);
  h2 = (mouse_x >= b2_x && mouse_x <= b2_x + b2_w && mouse_y >= card_y + 32 && mouse_y <= card_y + 62);

  // Button 1: 4s Listen (Dark Titanium Cyan)
  gfx_r = h1 ? 0.16 : 0.10; gfx_g = h1 ? 0.24 : 0.14; gfx_b = h1 ? 0.35 : 0.20;
  gfx_rect(b1_x, card_y + 32, b1_w, 30);
  gfx_r = h1 ? 0.00 : 0.18; gfx_g = h1 ? 0.85 : 0.28; gfx_b = h1 ? 1.00 : 0.38;
  gfx_rect(b1_x, card_y + 32, b1_w, 30, 0);
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Orbitron", 11, 'b');
  b1_txt = "⚡ 4s MATCH";
  gfx_measurestr(b1_txt, b1w, b1h);
  gfx_x = floor(b1_x + (b1_w - b1w) * 0.5); gfx_y = card_y + 40;
  gfx_drawstr(b1_txt);

  // Button 2: Scan Song (Emerald Accent)
  gfx_r = h2 ? 0.00 : 0.08; gfx_g = h2 ? 0.70 : 0.45; gfx_b = h2 ? 0.90 : 0.65;
  gfx_rect(b2_x, card_y + 32, b2_w, 30);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 11, 'b');
  b2_txt = "★ SCAN SONG";
  gfx_measurestr(b2_txt, b2w, b2h);
  gfx_x = floor(b2_x + (b2_w - b2w) * 0.5); gfx_y = card_y + 40;
  gfx_drawstr(b2_txt);

  mouse_clicked && h1 ? (
    assist_state = 1;
    assist_samples = 0;
  );
  mouse_clicked && h2 ? (
    audit_active = 1;
    audit_samples = 0;
    audit_loudest_rms = -120.0;
    audit_quietest_rms = 0.0;
    audit_peak_hold = 0.0;
    audit_rms_sum = 0.0;
    audit_rms_count = 0;
    verse_rms_acc = 0.0; verse_acc_count = 0;
    chorus_rms_acc = 0.0; chorus_acc_count = 0;
  );
);

// ─────────────────────────────────────────────────────────────────────────────
// 4. RETRO HARDWARE MODULE TABS (RESPONSIVE LABELS & CENTERED ALIGNMENT)
// ─────────────────────────────────────────────────────────────────────────────
tab_y = card_y + card_h + 8;
tab_h = 40;
tab_w = floor((crt_w - 24) / 6);
ti = 0;
loop(6,
  tx = crt_x + 8 + ti * tab_w;
  sel = (slider1 == ti);
  sel ? (
    gfx_r = 0.09; gfx_g = 0.14; gfx_b = 0.20;
  ) : (
    gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.070;
  );
  gfx_rect(tx, tab_y, tab_w - 4, tab_h);

  sel ? (
    gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
    gfx_rect(tx, tab_y + tab_h - 3, tab_w - 4, 3);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    gfx_r = 0.55; gfx_g = 0.65; gfx_b = 0.75;
  );
  gfx_setfont(1, "Orbitron", 13, 'b');
  tab_w >= 140 ? (
    t_lbl = (ti==0 ? "Mix Overview" : (ti==1 ? "EQ & De-Ess" : (ti==2 ? "Comp & Punch" : (ti==3 ? "Color & Tape" : (ti==4 ? "Stereo Space" : "AI Mix Assist")))));
  ) : (
    t_lbl = (ti==0 ? "Overview" : (ti==1 ? "EQ / Notch" : (ti==2 ? "Comp / Bus" : (ti==3 ? "Color / Sat" : (ti==4 ? "Stereo" : "AI Assist")))));
  );
  gfx_measurestr(t_lbl, tlw, tlh);
  gfx_x = floor(tx + (tab_w - 4 - tlw) * 0.5); gfx_y = tab_y + 11;
  gfx_drawstr(t_lbl);

  mouse_clicked && (mouse_x >= tx && mouse_x <= tx + tab_w - 4 && mouse_y >= tab_y && mouse_y <= tab_y + tab_h) ? (
    slider1 = ti;
    slider_automate();
  );
  ti += 1;
);

dock_h = max(135, min(165, floor(h * 0.24)));
dock_y = crt_y + crt_h - dock_h - 6;
dock_x = crt_x + 6;
dock_w = crt_w - 12;

disp_x = crt_x + 6;
disp_y = tab_y + tab_h + 6;
disp_w = crt_w - 12;
disp_h = max(160, dock_y - disp_y - 6);

gfx_r = 0.018; gfx_g = 0.024; gfx_b = 0.034;
gfx_rect(disp_x, disp_y, disp_w, disp_h);
gfx_r = 0.08; gfx_g = 0.12; gfx_b = 0.18;
gfx_rect(disp_x, disp_y, disp_w, disp_h, 0);

// =============================================================================
// TAB 0: AUTHENTIC ILLUMINATED ANALOG VU METER & 4-BAND TONAL BALANCE
// =============================================================================
slider1 == 0 ? (
  // Fixed Global HUD bounds for Tab 0 (guarantees zero overlap with elements above)
  hud_h = 50;
  hud_y = disp_y + disp_h - hud_h - 6;
  hud_x = disp_x + 10;
  hud_w = disp_w - 20;

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 14; gfx_y = disp_y + 6;
  gfx_drawstr("ANALOGUE 0 VU SIFAM METER & TONAL BALANCE MATRIX");

  // Sifam Director 14 Calibrated Meter Frame (Strictly confined above hud_y)
  vm_x = disp_x + 14;
  vm_y = disp_y + 24;
  vm_w = min(480, max(370, floor(disp_w * 0.44)));
  vm_h = min(220, max(170, floor(hud_y - vm_y - 8)));

  // Bezel / Chassis Frame: Outer dark brushed obsidian with dual bevel
  gfx_r = 0.055; gfx_g = 0.065; gfx_b = 0.080;
  gfx_rect(vm_x, vm_y, vm_w, vm_h);
  gfx_r = 0.14; gfx_g = 0.17; gfx_b = 0.22;
  gfx_rect(vm_x, vm_y, vm_w, vm_h, 0);

  // Inner Sifam Dial Face: Dark Obsidian Faceplate with High-Contrast Retro Gold Border
  plate_x = vm_x + 6; plate_y = vm_y + 6;
  plate_w = vm_w - 12; plate_h = vm_h - 12;
  gfx_r = 0.035; gfx_g = 0.046; gfx_b = 0.062; gfx_rect(plate_x, plate_y, plate_w, plate_h);
  gfx_r = 0.85; gfx_g = 0.68; gfx_b = 0.20; gfx_rect(plate_x, plate_y, plate_w, plate_h, 0);

  piv_x = plate_x + plate_w * 0.5;
  piv_y = plate_y + plate_h - 16;

  // Strict Needle Confinement: Radius mathematically locked inside meter boundary
  radius_arc = min(plate_h - 52, plate_w * 0.44);
  radius_needle = radius_arc - 4;

  ang_min = -0.65; ang_max = 0.65;
  vu_val_db = cur_vu_rms - slider26;
  vu_pos = (vu_val_db + 20.0) / 23.0;
  vu_pos = max(0.0, min(1.15, vu_pos));
  vu_cur_ang = ang_min + vu_pos * (ang_max - ang_min);

  // Top Faceplate Titles (High Contrast)
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25;
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_x = plate_x + 14; gfx_y = plate_y + 10; gfx_drawstr("SIFAM DIRECTOR 14");
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_measurestr("STUDIO VU", sw_v, sh_v);
  gfx_x = plate_x + plate_w - sw_v - 14; gfx_y = plate_y + 10; gfx_drawstr("STUDIO VU");

  // Calibrated Curved Scale Arc
  arc_steps = 30;
  ai = 0;
  prev_ax = 0; prev_ay = 0;
  loop(arc_steps + 1,
    a_frac = ai / arc_steps;
    cur_a = ang_min + a_frac * (ang_max - ang_min);
    ax = piv_x + sin(cur_a) * radius_arc;
    ay = piv_y - cos(cur_a) * radius_arc;
    ai > 0 ? (
      a_frac > 0.87 ? (
        gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;
      ) : (
        gfx_r = 0.95; gfx_g = 0.75; gfx_b = 0.20;
      );
      gfx_line(prev_ax, prev_ay, ax, ay);
    );
    prev_ax = ax; prev_ay = ay;
    ai += 1;
  );

  // Dial Major Scale Numbers & Tick Marks
  gfx_setfont(1, "Consolas", 11, 'b');
  t_a = ang_min;
  gfx_r = 0.75; gfx_g = 0.75; gfx_b = 0.75;
  gfx_line(piv_x + sin(t_a) * (radius_arc - 6), piv_y - cos(t_a) * (radius_arc - 6), piv_x + sin(t_a) * (radius_arc + 4), piv_y - cos(t_a) * (radius_arc + 4));
  gfx_x = piv_x + sin(t_a) * (radius_arc + 7) - 10; gfx_y = piv_y - cos(t_a) * (radius_arc + 7) - 10; gfx_drawstr("-20");

  t_a = ang_min + 0.43 * (ang_max - ang_min);
  gfx_line(piv_x + sin(t_a) * (radius_arc - 5), piv_y - cos(t_a) * (radius_arc - 5), piv_x + sin(t_a) * (radius_arc + 4), piv_y - cos(t_a) * (radius_arc + 4));
  gfx_x = piv_x + sin(t_a) * (radius_arc + 7) - 8; gfx_y = piv_y - cos(t_a) * (radius_arc + 7) - 10; gfx_drawstr("-10");

  t_a = ang_min + 0.65 * (ang_max - ang_min);
  gfx_line(piv_x + sin(t_a) * (radius_arc - 5), piv_y - cos(t_a) * (radius_arc - 5), piv_x + sin(t_a) * (radius_arc + 4), piv_y - cos(t_a) * (radius_arc + 4));
  gfx_x = piv_x + sin(t_a) * (radius_arc + 7) - 6; gfx_y = piv_y - cos(t_a) * (radius_arc + 7) - 10; gfx_drawstr("-5");

  t_a = ang_min + 0.87 * (ang_max - ang_min);
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25;
  gfx_line(piv_x + sin(t_a) * (radius_arc - 7), piv_y - cos(t_a) * (radius_arc - 7), piv_x + sin(t_a) * (radius_arc + 6), piv_y - cos(t_a) * (radius_arc + 6));
  gfx_x = piv_x + sin(t_a) * (radius_arc + 8) - 4; gfx_y = piv_y - cos(t_a) * (radius_arc + 8) - 10; gfx_drawstr("0");

  t_a = ang_max;
  gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;
  gfx_line(piv_x + sin(t_a) * (radius_arc - 6), piv_y - cos(t_a) * (radius_arc - 6), piv_x + sin(t_a) * (radius_arc + 5), piv_y - cos(t_a) * (radius_arc + 5));
  gfx_x = piv_x + sin(t_a) * (radius_arc + 8) - 6; gfx_y = piv_y - cos(t_a) * (radius_arc + 8) - 10; gfx_drawstr("+3");

  // Golden [ VU ] Badge (Standardized at 0.52 of plate height)
  gfx_setfont(1, "Orbitron", 16, 'b');
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25;
  gfx_measurestr("[ VU ]", str_w, str_h);
  gfx_x = floor(plate_x + (plate_w - str_w) * 0.5);
  gfx_y = floor(plate_y + plate_h * 0.52);
  gfx_drawstr("[ VU ]");

  // High-Contrast Confined Needle
  tip_x = piv_x + sin(vu_cur_ang) * radius_needle;
  tip_y = piv_y - cos(vu_cur_ang) * radius_needle;
  base_x = piv_x + sin(vu_cur_ang) * 14;
  base_y = piv_y - cos(vu_cur_ang) * 14;

  gfx_r = 1.00; gfx_g = 0.78; gfx_b = 0.20;
  gfx_line(base_x - 0.7, base_y, tip_x - 0.7, tip_y);
  gfx_line(base_x + 0.7, base_y, tip_x + 0.7, tip_y);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_line(base_x, base_y, tip_x, tip_y);

  gfx_r = 0.98; gfx_g = 0.22; gfx_b = 0.22;
  gfx_circle(tip_x, tip_y, 2, 1);

  gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14; gfx_circle(piv_x, piv_y, 18, 1);
  gfx_r = 0.85; gfx_g = 0.68; gfx_b = 0.20; gfx_circle(piv_x, piv_y, 18, 0);

  // Bottom Confined Readings (Clean, un-crowded readouts)
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = plate_x + 12; gfx_y = plate_y + plate_h - 22;
  gfx_printf("RMS: %5.1f dBFS", cur_vu_rms);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_measurestr("0 VU = -18 dBFS", sw_0, sh_0);
  gfx_x = plate_x + plate_w - sw_0 - 12; gfx_y = plate_y + plate_h - 22;
  gfx_printf("0 VU = %.0f dBFS", slider26);

  right_x = vm_x + vm_w + 14;
  right_w = disp_w - vm_w - 38;

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = right_x; gfx_y = vm_y + 2;
  gfx_drawstr("TONAL BALANCE 4-BAND CORRIDOR TRACKER");

  tb_bar_y = vm_y + 24;
  tb_bar_h = 28;
  tb_gap = 5;
  tb_lbl_w = min(170, max(130, floor(right_w * 0.30)));
  tb_stat_w = min(110, max(85, floor(right_w * 0.22)));
  tb_track_x = right_x + tb_lbl_w + 8;
  tb_track_w = max(60, right_w - tb_lbl_w - tb_stat_w - 20);
  tb_stat_x = tb_track_x + tb_track_w + 8;
  
  // Band 1: Low (20-250 Hz)
  in_band_low = (tb_pct_low >= tb_tgt_low_min && tb_pct_low <= tb_tgt_low_max);
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h);
  gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = right_x + 8; gfx_y = tb_bar_y + 6;
  gfx_drawstr("LOW 20-250Hz");

  // Track & Corridor
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(tb_track_x, tb_bar_y, tb_track_w, tb_bar_h);
  c_x1 = tb_track_x + (tb_tgt_low_min / 100.0) * tb_track_w;
  c_x2 = tb_track_x + (tb_tgt_low_max / 100.0) * tb_track_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h, 0);
  cur_x = tb_track_x + min(1.0, max(0.0, tb_pct_low / 100.0)) * tb_track_w;
  in_band_low ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) : (gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;);
  gfx_rect(cur_x - 3, tb_bar_y, 6, tb_bar_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_line(cur_x, tb_bar_y, cur_x, tb_bar_y + tb_bar_h);

  // Dedicated Right Readout Box (Zero Overlap Guaranteed)
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h);
  gfx_r = in_band_low ? 0.15 : 0.80; gfx_g = in_band_low ? 0.85 : 0.50; gfx_b = in_band_low ? 0.45 : 0.15;
  gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 12, 'b');
  stat_str = in_band_low ? "OK" : (tb_pct_low < tb_tgt_low_min ? "LOW" : "HIGH");
  s_readout = sprintf(#, "%4.1f%% %s", tb_pct_low, stat_str);
  gfx_measurestr(s_readout, srw, srh);
  gfx_x = floor(tb_stat_x + (tb_stat_w - srw) * 0.5); gfx_y = tb_bar_y + 6;
  gfx_drawstr(s_readout);

  // Band 2: Low-Mid (250-2000 Hz)
  tb_bar_y += tb_bar_h + tb_gap;
  in_band_lmid = (tb_pct_lmid >= tb_tgt_lmid_min && tb_pct_lmid <= tb_tgt_lmid_max);
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h);
  gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = right_x + 8; gfx_y = tb_bar_y + 6;
  gfx_drawstr("LMID 250-2kHz");

  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(tb_track_x, tb_bar_y, tb_track_w, tb_bar_h);
  c_x1 = tb_track_x + (tb_tgt_lmid_min / 100.0) * tb_track_w;
  c_x2 = tb_track_x + (tb_tgt_lmid_max / 100.0) * tb_track_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h, 0);
  cur_x = tb_track_x + min(1.0, max(0.0, tb_pct_lmid / 100.0)) * tb_track_w;
  in_band_lmid ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) : (gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;);
  gfx_rect(cur_x - 3, tb_bar_y, 6, tb_bar_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_line(cur_x, tb_bar_y, cur_x, tb_bar_y + tb_bar_h);

  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h);
  gfx_r = in_band_lmid ? 0.15 : 0.80; gfx_g = in_band_lmid ? 0.85 : 0.50; gfx_b = in_band_lmid ? 0.45 : 0.15;
  gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 12, 'b');
  stat_str = in_band_lmid ? "OK" : (tb_pct_lmid < tb_tgt_lmid_min ? "LOW" : "HIGH");
  s_readout = sprintf(#, "%4.1f%% %s", tb_pct_lmid, stat_str);
  gfx_measurestr(s_readout, srw, srh);
  gfx_x = floor(tb_stat_x + (tb_stat_w - srw) * 0.5); gfx_y = tb_bar_y + 6;
  gfx_drawstr(s_readout);

  // Band 3: High-Mid (2000-8000 Hz)
  tb_bar_y += tb_bar_h + tb_gap;
  in_band_hmid = (tb_pct_hmid >= tb_tgt_hmid_min && tb_pct_hmid <= tb_tgt_hmid_max);
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h);
  gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = right_x + 8; gfx_y = tb_bar_y + 6;
  gfx_drawstr("HMID 2k-8kHz");

  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(tb_track_x, tb_bar_y, tb_track_w, tb_bar_h);
  c_x1 = tb_track_x + (tb_tgt_hmid_min / 100.0) * tb_track_w;
  c_x2 = tb_track_x + (tb_tgt_hmid_max / 100.0) * tb_track_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h, 0);
  cur_x = tb_track_x + min(1.0, max(0.0, tb_pct_hmid / 100.0)) * tb_track_w;
  in_band_hmid ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) : (gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;);
  gfx_rect(cur_x - 3, tb_bar_y, 6, tb_bar_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_line(cur_x, tb_bar_y, cur_x, tb_bar_y + tb_bar_h);

  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h);
  gfx_r = in_band_hmid ? 0.15 : 0.80; gfx_g = in_band_hmid ? 0.85 : 0.50; gfx_b = in_band_hmid ? 0.45 : 0.15;
  gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 12, 'b');
  stat_str = in_band_hmid ? "OK" : (tb_pct_hmid < tb_tgt_hmid_min ? "LOW" : "HIGH");
  s_readout = sprintf(#, "%4.1f%% %s", tb_pct_hmid, stat_str);
  gfx_measurestr(s_readout, srw, srh);
  gfx_x = floor(tb_stat_x + (tb_stat_w - srw) * 0.5); gfx_y = tb_bar_y + 6;
  gfx_drawstr(s_readout);

  // Band 4: High (>8000 Hz)
  tb_bar_y += tb_bar_h + tb_gap;
  in_band_high = (tb_pct_high >= tb_tgt_high_min && tb_pct_high <= tb_tgt_high_max);
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h);
  gfx_r = 0.10; gfx_g = 0.14; gfx_b = 0.20; gfx_rect(right_x, tb_bar_y, tb_lbl_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = right_x + 8; gfx_y = tb_bar_y + 6;
  gfx_drawstr("AIR > 8kHz");

  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(tb_track_x, tb_bar_y, tb_track_w, tb_bar_h);
  c_x1 = tb_track_x + (tb_tgt_high_min / 100.0) * tb_track_w;
  c_x2 = tb_track_x + (tb_tgt_high_max / 100.0) * tb_track_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(c_x1, tb_bar_y, max(6, c_x2 - c_x1), tb_bar_h, 0);
  cur_x = tb_track_x + min(1.0, max(0.0, tb_pct_high / 100.0)) * tb_track_w;
  in_band_high ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) : (gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;);
  gfx_rect(cur_x - 3, tb_bar_y, 6, tb_bar_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_line(cur_x, tb_bar_y, cur_x, tb_bar_y + tb_bar_h);

  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h);
  gfx_r = in_band_high ? 0.15 : 0.80; gfx_g = in_band_high ? 0.85 : 0.50; gfx_b = in_band_high ? 0.45 : 0.15;
  gfx_rect(tb_stat_x, tb_bar_y, tb_stat_w, tb_bar_h, 0);
  gfx_setfont(1, "Consolas", 12, 'b');
  stat_str = in_band_high ? "OK" : (tb_pct_high < tb_tgt_high_min ? "LOW" : "HIGH");
  s_readout = sprintf(#, "%4.1f%% %s", tb_pct_high, stat_str);
  gfx_measurestr(s_readout, srw, srh);
  gfx_x = floor(tb_stat_x + (tb_stat_w - srw) * 0.5); gfx_y = tb_bar_y + 6;
  gfx_drawstr(s_readout);

  btn_cal_y = tb_bar_y + tb_bar_h + 6;
  btn_cal_h = 26;
  b_hover = (mouse_x >= right_x && mouse_x <= right_x + right_w && mouse_y >= btn_cal_y && mouse_y <= btn_cal_y + btn_cal_h);
  gfx_r = b_hover ? 0.00 : 0.08;
  gfx_g = b_hover ? 0.90 : 0.65;
  gfx_b = b_hover ? 0.45 : 0.35;
  gfx_rect(right_x, btn_cal_y, right_w, btn_cal_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 12, 'b');
  gfx_measurestr("AUTO-CALIBRATE HEADROOM & TONAL BALANCE", str_w, str_h);
  gfx_x = floor(right_x + (right_w - str_w) * 0.5); gfx_y = btn_cal_y + 6;
  gfx_drawstr("AUTO-CALIBRATE HEADROOM & TONAL BALANCE");
  mouse_clicked && b_hover ? (
    calibrate_to_project(slider39);
  );

  // ─────────────────────────────────────────────────────────────────────────
  // HARMONIC BALANCE & MIX POCKET HEALTH MONITOR (Single Clean Row, Zero HUD Collision)
  // ─────────────────────────────────────────────────────────────────────────
  mx_card_y = btn_cal_y + btn_cal_h + 6;
  mx_card_h = max(46, hud_y - mx_card_y - 6);
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065;
  gfx_rect(right_x, mx_card_y, right_w, mx_card_h);
  gfx_r = 0.12; gfx_g = 0.16; gfx_b = 0.24;
  gfx_rect(right_x, mx_card_y, right_w, mx_card_h, 0);

  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = right_x + 10; gfx_y = mx_card_y + 4;
  gfx_drawstr("HARMONIC BALANCE & MIX POCKET HEALTH MONITOR");

  t_gap = 6;
  tile_w = floor((right_w - 16 - t_gap * 3) / 4);
  tile_h = max(18, min(22, mx_card_h - 22));
  t_y = mx_card_y + 19;

  // Tile 1: Sub-Bass Mono Anchor
  tx1 = right_x + 8;
  gfx_r = 0.050; gfx_g = 0.065; gfx_b = 0.090; gfx_rect(tx1, t_y, tile_w, tile_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(tx1, t_y, tile_w, tile_h, 0);
  gfx_setfont(1, "Consolas", 11, 'b');
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  t1_str = sprintf(#, "MONO:%dHz", slider6);
  gfx_measurestr(t1_str, tw1, th1);
  gfx_x = tx1 + floor((tile_w - tw1) * 0.5); gfx_y = t_y + 2;
  gfx_drawstr(t1_str);

  // Tile 2: De-Box Mud Clearance
  tx2 = tx1 + tile_w + t_gap;
  gfx_r = 0.050; gfx_g = 0.065; gfx_b = 0.090; gfx_rect(tx2, t_y, tile_w, tile_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(tx2, t_y, tile_w, tile_h, 0);
  gfx_r = slider17 < -0.1 ? 0.15 : 0.70; gfx_g = slider17 < -0.1 ? 0.95 : 0.70; gfx_b = slider17 < -0.1 ? 0.45 : 0.70;
  t2_str = sprintf(#, "DE-BOX:%.1fdB", slider17);
  gfx_measurestr(t2_str, tw2, th2);
  gfx_x = tx2 + floor((tile_w - tw2) * 0.5); gfx_y = t_y + 2;
  gfx_drawstr(t2_str);

  // Tile 3: Center Vocal Donut Hole
  tx3 = tx2 + tile_w + t_gap;
  gfx_r = 0.050; gfx_g = 0.065; gfx_b = 0.090; gfx_rect(tx3, t_y, tile_w, tile_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(tx3, t_y, tile_w, tile_h, 0);
  gfx_r = slider28 ? 0.00 : 0.60; gfx_g = slider28 ? 0.85 : 0.65; gfx_b = slider28 ? 1.00 : 0.70;
  t3_str = sprintf(#, "VOCAL:%s", slider28 ? "-1.8dB" : "PASS");
  gfx_measurestr(t3_str, tw3, th3);
  gfx_x = tx3 + floor((tile_w - tw3) * 0.5); gfx_y = t_y + 2;
  gfx_drawstr(t3_str);

  // Tile 4: Transient Kick & Snare Snap
  tx4 = tx3 + tile_w + t_gap;
  gfx_r = 0.050; gfx_g = 0.065; gfx_b = 0.090; gfx_rect(tx4, t_y, tile_w, tile_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(tx4, t_y, tile_w, tile_h, 0);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  t4_str = sprintf(#, "SNAP:%+.1fdB", slider34);
  gfx_measurestr(t4_str, tw4, th4);
  gfx_x = tx4 + floor((tile_w - tw4) * 0.5); gfx_y = t_y + 2;
  gfx_drawstr(t4_str);

  // ─────────────────────────────────────────────────────────────────────────
  // BOTTOM HUD: REAPER REGION SYNC & PRODUCER INFO STATUS BAR (Guaranteed Clear)
  // ─────────────────────────────────────────────────────────────────────────
  gfx_r = 0.022; gfx_g = 0.032; gfx_b = 0.045;
  gfx_rect(hud_x, hud_y, hud_w, hud_h);
  
  // High-visibility glowing border keyed to active section
  disp_state == 3 ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) :
  disp_state == 2 ? (gfx_r = 0.85; gfx_g = 0.45; gfx_b = 1.00;) :
  disp_state == 1 ? (gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.15;) :
  disp_state == 4 ? (gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;) :
  disp_state == 5 ? (gfx_r = 0.30; gfx_g = 0.65; gfx_b = 0.95;) :
                    (gfx_r = 0.15; gfx_g = 0.70; gfx_b = 0.50;);
  gfx_rect(hud_x, hud_y, hud_w, hud_h, 0);

  // Row 1: Glowing Sync Beacon & Active Song Structure Radar
  b_phase = (b_phase + 0.08) % 6.283;
  b_glow = 0.5 + sin(b_phase) * 0.5;
  gfx_a = 0.6 + b_glow * 0.4;
  gfx_circle(hud_x + 16, hud_y + 14, 4, 1);
  gfx_a = 1.00;

  gfx_setfont(1, "Orbitron", 12, 'b');
  gfx_x = hud_x + 26; gfx_y = hud_y + 7;
  rgn_label = (disp_state == 3 ? "CHORUS (DROP IMPACT)" :
              (disp_state == 2 ? "PRE-DROP BREATH (VACUUM)" :
              (disp_state == 1 ? "PRE-CHORUS (TENSION BUILD)" :
              (disp_state == 4 ? "BREAKDOWN / BRIDGE (SLAM)" :
              (disp_state == 5 ? (g_rgn_type_live == 1 ? "INTRO" : (g_rgn_type_live == 6 ? "OUTRO" : "VERSE (GROOVE POCKET)")) :
              "PROJECT REGION RADAR ONLINE")))));
  gfx_printf("REAPER REGION SYNC: ONLINE // REGION #%d OF %d: %s",
             g_cur_rgn_live > 0 ? g_cur_rgn_live : (disp_state==3?4:(disp_state==1||disp_state==2?3:(disp_state==4?8:(disp_state==5?2:1)))),
             g_num_regions_live > 0 ? g_num_regions_live : 20,
             rgn_label);

  // Right side of Row 1: Drop Countdown or Live Dynamic Lift Status
  disp_state == 3 ? (
    r1_right = sprintf(#, "⚡ CHORUS IMPACT: +%.1fdB LIFT", dyn_punch_boost);
    gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  ) : (disp_state == 1 || disp_state == 2) && g_to_chorus_live > 0.0 ? (
    r1_right = sprintf(#, "⚡ DROP IN: -%.1fs", g_to_chorus_live);
    disp_state == 2 ? (gfx_r = 0.85; gfx_g = 0.45; gfx_b = 1.00;) : (gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.15;);
  ) : disp_state == 4 ? (
    r1_right = "◆ BREAKDOWN SLAM ACTIVE";
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  ) : disp_state == 5 ? (
    r1_right = "■ VERSE RHYTHM LOCK";
    gfx_r = 0.35; gfx_g = 0.75; gfx_b = 1.00;
  ) : (
    r1_right = "● READY FOR PLAYBACK";
    gfx_r = 0.15; gfx_g = 0.85; gfx_b = 0.50;
  );
  gfx_setfont(1, "Consolas", 12, 'b');
  gfx_measurestr(r1_right, rrw, rrh);
  gfx_x = hud_x + hud_w - rrw - 12; gfx_y = hud_y + 8;
  gfx_drawstr(r1_right);

  // Row 2: Live Producer Signature Move & Real-Time DSP Telemetry Badges
  gfx_setfont(1, "Orbitron", 12, 'b');
  gfx_r = 1.00; gfx_g = 0.82; gfx_b = 0.25;
  gfx_x = hud_x + 14; gfx_y = hud_y + 28;
  
  p_m = slider39;
  disp_state == 3 ? (
    p_m == 1 ? move_title = "LANCE PRENC // PRENC GUITAR WALL & SNARE CRACK" :
    p_m == 9 ? move_title = "SAM GUAIANA // GUAIANA EXPLOSIVE WALL & AIR SHEEN" :
    p_m == 4 ? move_title = "BUSTER ODEHOLM // ODEHOLM SLAM DETONATION" :
    p_m == 2 ? move_title = "SCOTT SEIGEL // SEIGEL SUB SLAM ACTIVE" :
    p_m == 3 ? move_title = "JONATHAN DOLESE // POP-METAL HOOK PRESENCE" :
    p_m == 5 ? move_title = "LEWIS JOHNS // FADER ORGANIC WALL OF SOUND" :
