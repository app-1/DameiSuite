  gfx_x = disp_x + 28 + c_btn_w * 2; gfx_y = c_btn_y + 5; gfx_drawstr("Thresh +");

  mouse_clicked && b_top_cycle ? (slider8 = (slider8 + 1) % 3; is_user_customized = 1; update_mix_filters(); slider_automate(););
  mouse_clicked && b_th_minus  ? (slider9 = max(-36.0, slider9 - 0.5); is_user_customized = 1; update_mix_filters(); slider_automate(););
  mouse_clicked && b_th_plus   ? (slider9 = min(0.0, slider9 + 0.5); is_user_customized = 1; update_mix_filters(); slider_automate(););

  // ── Card 2: Drum Transient Designer ──
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 16 + c_col_w, disp_y + 32, c_col_w, c_h);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  gfx_rect(disp_x + 16 + c_col_w, disp_y + 32, c_col_w, c_h, 0);
  
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 24 + c_col_w; gfx_y = disp_y + 40;
  gfx_drawstr("DRUM TRANSIENT DESIGNER");
  
  gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = disp_x + 24 + c_col_w; gfx_y = disp_y + 64;
  gfx_printf("Attack Punch : %+.1fdB (Kick Snap)", slider34);
  gfx_x = disp_x + 24 + c_col_w; gfx_y = disp_y + 82;
  gfx_printf("Sustain Tail : %+.1fdB (Room Air)", slider35);
  gfx_x = disp_x + 24 + c_col_w; gfx_y = disp_y + 98;
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  gfx_printf("TRANSIENT POP ACTIVITY: %+.1f", trans_punch_meter);

  // Dynamic Visualizer: Drum Snap Waveform Scope
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 24 + c_col_w, dyn_scope_y, c_col_w - 28, dyn_scope_h);
  gfx_r = 0.18; gfx_g = 0.14; gfx_b = 0.08; gfx_rect(disp_x + 24 + c_col_w, dyn_scope_y, c_col_w - 28, dyn_scope_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  gfx_x = disp_x + 30 + c_col_w; gfx_y = dyn_scope_y + 4; gfx_drawstr("TRANSIENT ATTACK & SUSTAIN PROFILE");
  dt_bar_w = c_col_w - 44;
  dt_fill_w = min(dt_bar_w, floor(max(0.0, (trans_punch_meter + 1.0) / 4.0) * dt_bar_w));
  gfx_r = 0.04; gfx_g = 0.06; gfx_b = 0.08; gfx_rect(disp_x + 30 + c_col_w, dyn_scope_y + 24, dt_bar_w, 14);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15; gfx_rect(disp_x + 30 + c_col_w, dyn_scope_y + 24, dt_fill_w, 14);
  dyn_scope_h >= 65 ? (
    gfx_setfont(1, "Consolas", 14); gfx_r = 0.85; gfx_g = 0.88; gfx_b = 0.92;
    gfx_x = disp_x + 30 + c_col_w; gfx_y = dyn_scope_y + dyn_scope_h - 20;
    gfx_printf("Punch: %+.1fdB | Tail: %+.1fdB", slider34, slider35);
  );

  // Steppers: [ Punch - ] [ Punch + ] [ Tail +/- ] (Fixed Luminous Text)
  b_att_minus = (mouse_x >= disp_x + 22 + c_col_w && mouse_x <= disp_x + 22 + c_col_w + c_btn_w && mouse_y >= c_btn_y && mouse_y <= c_btn_y + 28);
  b_att_plus  = (mouse_x >= disp_x + 26 + c_col_w + c_btn_w && mouse_x <= disp_x + 26 + c_col_w + c_btn_w * 2 && mouse_y >= c_btn_y && mouse_y <= c_btn_y + 28);
  b_sus_plus  = (mouse_x >= disp_x + 30 + c_col_w + c_btn_w * 2 && mouse_x <= disp_x + 30 + c_col_w + c_btn_w * 3 && mouse_y >= c_btn_y && mouse_y <= c_btn_y + 28);

  gfx_r = b_att_minus ? 0.28 : 0.16; gfx_g = b_att_minus ? 0.22 : 0.12; gfx_b = 0.08;
  gfx_rect(disp_x + 22 + c_col_w, c_btn_y, c_btn_w, 28);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 26 + c_col_w; gfx_y = c_btn_y + 5; gfx_drawstr("Punch -");

  gfx_r = b_att_plus ? 0.28 : 0.16; gfx_g = b_att_plus ? 0.22 : 0.12; gfx_b = 0.08;
  gfx_rect(disp_x + 26 + c_col_w + c_btn_w, c_btn_y, c_btn_w, 28);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 30 + c_col_w + c_btn_w; gfx_y = c_btn_y + 5; gfx_drawstr("Punch +");

  gfx_r = b_sus_plus ? 0.28 : 0.16; gfx_g = b_sus_plus ? 0.22 : 0.12; gfx_b = 0.08;
  gfx_rect(disp_x + 30 + c_col_w + c_btn_w * 2, c_btn_y, c_btn_w, 28);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 34 + c_col_w + c_btn_w * 2; gfx_y = c_btn_y + 5; gfx_drawstr("Tail +/-");

  mouse_clicked && b_att_minus ? (slider34 = max(-6.0, slider34 - 0.2); is_user_customized = 1; slider_automate(););
  mouse_clicked && b_att_plus  ? (slider34 = min(6.0, slider34 + 0.2); is_user_customized = 1; slider_automate(););
  mouse_clicked && b_sus_plus  ? (slider35 = slider35 >= 1.0 ? -0.5 : slider35 + 0.3; is_user_customized = 1; slider_automate(););

  // ── Card 3: Bass 3-Way Crossover & Anti-Pumping ──
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 22 + c_col_w * 2, disp_y + 32, c_col_w, c_h);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_rect(disp_x + 22 + c_col_w * 2, disp_y + 32, c_col_w, c_h, 0);
  
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 30 + c_col_w * 2; gfx_y = disp_y + 40;
  gfx_drawstr("BASS CROSSOVER & GRIT");
  
  gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = disp_x + 30 + c_col_w * 2; gfx_y = disp_y + 64;
  gfx_drawstr("Sub DI Anchor (<95Hz) + 1.2kHz Mid Growl");
  gfx_x = disp_x + 30 + c_col_w * 2; gfx_y = disp_y + 82;
  gfx_printf("Mode: %s", slider33==0?"Full-Band Transparent":(slider33==1?"Systematic Split (+1.8dB)":"Tractor Grind (+3.6dB)"));
  gfx_x = disp_x + 30 + c_col_w * 2; gfx_y = disp_y + 98;
  gfx_drawstr("Detector: Continuous Peak-Envelope (Anti-Pump)");

  // Dynamic Visualizer: 3-Way Bass Architecture Diagram
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 30 + c_col_w * 2, dyn_scope_y, c_col_w - 28, dyn_scope_h);
  gfx_r = 0.10; gfx_g = 0.20; gfx_b = 0.14; gfx_rect(disp_x + 30 + c_col_w * 2, dyn_scope_y, c_col_w - 28, dyn_scope_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = disp_x + 36 + c_col_w * 2; gfx_y = dyn_scope_y + 4; gfx_drawstr("3-WAY BASS FREQUENCY CROSSOVER");
  bc_w = c_col_w - 44;
  gfx_r = 0.05; gfx_g = 0.18; gfx_b = 0.28; gfx_rect(disp_x + 36 + c_col_w * 2, dyn_scope_y + 24, floor(bc_w * 0.40), 14);
  gfx_r = slider33 > 0 ? 0.15 : 0.06; gfx_g = slider33 > 0 ? 0.35 : 0.10; gfx_b = slider33 > 0 ? 0.20 : 0.14;
  gfx_rect(disp_x + 36 + c_col_w * 2 + floor(bc_w * 0.40), dyn_scope_y + 24, floor(bc_w * 0.60), 14);
  dyn_scope_h >= 65 ? (
    gfx_setfont(1, "Consolas", 14); gfx_r = 0.85; gfx_g = 0.88; gfx_b = 0.92;
    gfx_x = disp_x + 36 + c_col_w * 2; gfx_y = dyn_scope_y + dyn_scope_h - 20;
    gfx_printf("Sub DI: %dHz | Mid Grit: %s", slider6, slider33>0?"ENGAGED":"CLEAN");
  );

  b_bass_toggle = (mouse_x >= disp_x + 28 + c_col_w * 2 && mouse_x <= disp_x + c_col_w * 3 && mouse_y >= c_btn_y && mouse_y <= c_btn_y + 28);
  gfx_r = 0.08; gfx_g = 0.22; gfx_b = 0.14;
  gfx_rect(disp_x + 28 + c_col_w * 2, c_btn_y, c_col_w - 24, 28);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 36 + c_col_w * 2; gfx_y = c_btn_y + 5;
  gfx_drawstr(slider33==0?"ENABLE BASS GRIT (SPLIT)":(slider33==1?"SWITCH TO TRACTOR GRIND":"BYPASS BASS GRIT"));
  mouse_clicked && b_bass_toggle ? (slider33 = (slider33 + 1) % 3; is_user_customized = 1; update_mix_filters(); slider_automate(););

  hud_x = disp_x + 10; hud_y = disp_y + disp_h - 56; hud_w = disp_w - 20; hud_h = 50;
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(hud_x, hud_y, hud_w, hud_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(hud_x, hud_y, hud_w, hud_h, 0);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15; gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = hud_x + 12; gfx_y = hud_y + 6;
  gfx_drawstr("DYNAMICS CONTROL // INTERACTIVE GLUE & TRANSIENT PUNCH");
  gfx_r = 0.92; gfx_g = 0.96; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = hud_x + 12; gfx_y = hud_y + 27;
  gfx_drawstr("Tweak glue threshold, ratio, attack punch, and bass grit. All settings persist seamlessly in your REAPER project.");
);

// =============================================================================
// TAB 3: COLOR & TAPE (AFRO-CYBER HIGH LEGIBILITY & DUAL TUBE/TAPE CORE)
slider1 == 3 ? (
  gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  draw_matemasie_sigil(disp_x + 22, disp_y + 16, 8);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 36; gfx_y = disp_y + 8;
  gfx_drawstr("ANALOG HARMONIC COLORATION & VINTAGE TAPE SHEEN");

  col_w3 = (disp_w - 38) / 3;
  col_h3 = max(110, (hud_y - 8) - (disp_y + 32));

  // ── CARD 1: ANALOG HARMONIC DRIVE ─────────────────────────────
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 10, disp_y + 32, col_w3, col_h3);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_rect(disp_x + 10, disp_y + 32, col_w3, col_h3, 0);
  
  gfx_setfont(1, "Orbitron", 16, 'b');
  gfx_x = disp_x + 18; gfx_y = disp_y + 40;
  gfx_drawstr("ANALOG HARMONIC DRIVE");
  
  // Section A: Drive Intensity
  gfx_r = 0.75; gfx_g = 0.88; gfx_b = 1.00;
  gfx_setfont(1, "Segoe UI", 15, 'b');
  gfx_x = disp_x + 18; gfx_y = disp_y + 64;
  gfx_drawstr("DRIVE INTENSITY");
  
  gfx_r = 0.00; gfx_g = 0.95; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 24, 'b');
  gfx_x = disp_x + 18; gfx_y = disp_y + 82;
  gfx_printf("+%.1f dB", slider21);

  // Steppers for Drive
  btn_w_drv = (col_w3 - 28) / 2;
  btn_y_drv = disp_y + 114;
  b_drv_m = (mouse_x >= disp_x + 16 && mouse_x <= disp_x + 16 + btn_w_drv && mouse_y >= btn_y_drv && mouse_y <= btn_y_drv + 28);
  b_drv_p = (mouse_x >= disp_x + 20 + btn_w_drv && mouse_x <= disp_x + 20 + btn_w_drv * 2 && mouse_y >= btn_y_drv && mouse_y <= btn_y_drv + 28);
  
  gfx_r = b_drv_m ? 0.22 : 0.10; gfx_g = b_drv_m ? 0.32 : 0.16; gfx_b = b_drv_m ? 0.44 : 0.24;
  gfx_rect(disp_x + 16, btn_y_drv, btn_w_drv, 28);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 22; gfx_y = btn_y_drv + 5; gfx_drawstr("DRIVE -0.2dB");

  gfx_r = b_drv_p ? 0.22 : 0.10; gfx_g = b_drv_p ? 0.32 : 0.16; gfx_b = b_drv_p ? 0.44 : 0.24;
  gfx_rect(disp_x + 20 + btn_w_drv, btn_y_drv, btn_w_drv, 28);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 26 + btn_w_drv; gfx_y = btn_y_drv + 5; gfx_drawstr("DRIVE +0.2dB");

  mouse_clicked && b_drv_m ? (slider21 = max(0.0, slider21 - 0.2); is_user_customized = 1; slider_automate(););
  mouse_clicked && b_drv_p ? (slider21 = min(10.0, slider21 + 0.2); is_user_customized = 1; slider_automate(););

  // Section B: Topology Readout
  gfx_r = 0.75; gfx_g = 0.88; gfx_b = 1.00;
  gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 18; gfx_y = disp_y + 148;
  gfx_drawstr("TOPOLOGY:");
  gfx_r = 1.00; gfx_g = 0.80; gfx_b = 0.25;
  gfx_x = disp_x + 92; gfx_y = disp_y + 148;
  gfx_drawstr(slider22==0 ? "Warm Triode (2nd)" : (slider22==1 ? "Punch Pentode (3rd)" : "Vintage Tape Sheen"));

  // Bottom Button: Cycle Topology
  btn_y_top = disp_y + col_h3 - 34;
  b_top_cyc = (mouse_x >= disp_x + 16 && mouse_x <= disp_x + col_w3 - 12 && mouse_y >= btn_y_top && mouse_y <= btn_y_top + 30);

  // Dynamic Visualizer: Harmonic Transfer Function Scope
  sc1_y = disp_y + 172;
  sc1_h = max(45, btn_y_top - sc1_y - 8);
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 16, sc1_y, col_w3 - 24, sc1_h);
  gfx_r = 0.08; gfx_g = 0.14; gfx_b = 0.22; gfx_rect(disp_x + 16, sc1_y, col_w3 - 24, sc1_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = disp_x + 22; gfx_y = sc1_y + 4; gfx_drawstr("HARMONIC TRANSFER FUNCTION");

  // Center axes
  ax_cx = disp_x + 16 + (col_w3 - 24) * 0.50;
  ax_cy = sc1_y + sc1_h * 0.52;
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.25;
  gfx_line(disp_x + 20, ax_cy, disp_x + col_w3 - 12, ax_cy);
  gfx_line(ax_cx, sc1_y + 20, ax_cx, sc1_y + sc1_h - 4);

  // Plot Transfer Curve
  drv_scale = slider21 * 0.10;
  prev_px = disp_x + 20;
  prev_py = ax_cy;
  gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  step_i = 0;
  n_steps = 24;
  step_w = (col_w3 - 32) / n_steps;
  loop(n_steps + 1,
    in_norm = (step_i / n_steps) * 2.0 - 1.0;
    slider22 == 0 ? (
      // Warm Triode: Asymmetric 2nd harmonic compression
      out_norm = in_norm * (1.0 + drv_scale) - 0.22 * in_norm * in_norm * drv_scale;
    ) : slider22 == 1 ? (
      // Punchy Pentode: Symmetrical odd-harmonic saturation
      out_norm = in_norm * (1.0 + drv_scale * 1.2) / (1.0 + abs(in_norm) * drv_scale * 1.5);
    ) : (
      // Vintage Tape: Progressive soft saturation knee
      out_norm = in_norm * (1.0 + drv_scale * 0.8) / (1.0 + 0.35 * in_norm * in_norm * drv_scale);
    );
    pt_x = disp_x + 20 + step_i * step_w;
    pt_y = ax_cy - out_norm * (sc1_h * 0.38);
    step_i > 0 ? gfx_line(prev_px, prev_py, pt_x, pt_y);
    prev_px = pt_x; prev_py = pt_y;
    step_i += 1;
  );
  sc1_h >= 65 ? (
    gfx_setfont(1, "Consolas", 14); gfx_r = 0.70; gfx_g = 0.80; gfx_b = 0.90;
    gfx_x = disp_x + 22; gfx_y = sc1_y + sc1_h - 18;
    gfx_printf("Curve: %s | +%.1fdB Sat", slider22==0?"Asymmetric 2nd":(slider22==1?"Odd 3rd Crunch":"Tape Core Flux"), slider21);
  );

  gfx_r = b_top_cyc ? 0.18 : 0.08; gfx_g = b_top_cyc ? 0.30 : 0.16; gfx_b = b_top_cyc ? 0.42 : 0.24;
  gfx_rect(disp_x + 16, btn_y_top, col_w3 - 24, 30);
  gfx_r = 0.00; gfx_g = 0.95; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 24; gfx_y = btn_y_top + 6;
  gfx_drawstr("CYCLE TUBE / TAPE TOPOLOGY");
  mouse_clicked && b_top_cyc ? (slider22 = (slider22 + 1) % 3; is_user_customized = 1; slider_automate(););

  // ── CARD 2: TAPE AIR SHEEN & DE-ESS ──────────────────────────
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 16 + col_w3, disp_y + 32, col_w3, col_h3);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  gfx_rect(disp_x + 16 + col_w3, disp_y + 32, col_w3, col_h3, 0);
  
  gfx_setfont(1, "Orbitron", 16, 'b');
  gfx_x = disp_x + 24 + col_w3; gfx_y = disp_y + 40;
  gfx_drawstr("TAPE AIR SHEEN & DE-ESS");
  
  gfx_r = 0.75; gfx_g = 0.88; gfx_b = 1.00;
  gfx_setfont(1, "Segoe UI", 15, 'b');
  gfx_x = disp_x + 24 + col_w3; gfx_y = disp_y + 64;
  gfx_drawstr("HF SILK & TAPE ROUNDING");

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.96;
  gfx_setfont(1, "Segoe UI", 14);
  gfx_x = disp_x + 24 + col_w3; gfx_y = disp_y + 84;
  gfx_drawstr("Soft-knee analog tape harmonic sheen above 9.5kHz.");
  gfx_x = disp_x + 24 + col_w3; gfx_y = disp_y + 102;
  gfx_drawstr("Eliminates digital harshness without darkening.");

  // Status Badge
  gfx_r = slider23 ? 0.18 : 0.08; gfx_g = slider23 ? 0.14 : 0.08; gfx_b = slider23 ? 0.04 : 0.08;
  gfx_rect(disp_x + 24 + col_w3, disp_y + 124, col_w3 - 36, 32);
  gfx_r = slider23 ? 1.00 : 0.50; gfx_g = slider23 ? 0.75 : 0.50; gfx_b = slider23 ? 0.20 : 0.50;
  gfx_rect(disp_x + 24 + col_w3, disp_y + 124, col_w3 - 36, 32, 0);
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 36 + col_w3; gfx_y = disp_y + 132;
  gfx_drawstr(slider23 ? "STATUS: ACTIVE TAPE SHEEN" : "STATUS: TAPE SHEEN BYPASSED");

  btn_y_sheen = disp_y + col_h3 - 34;
  b_sheen_btn = (mouse_x >= disp_x + 22 + col_w3 && mouse_x <= disp_x + col_w3 * 2 - 6 && mouse_y >= btn_y_sheen && mouse_y <= btn_y_sheen + 30);

  // Dynamic Visualizer: Tape Frequency Response Curve
  sc2_y = disp_y + 164;
  sc2_h = max(45, btn_y_sheen - sc2_y - 8);
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 22 + col_w3, sc2_y, col_w3 - 24, sc2_h);
  gfx_r = 0.18; gfx_g = 0.14; gfx_b = 0.08; gfx_rect(disp_x + 22 + col_w3, sc2_y, col_w3 - 24, sc2_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  gfx_x = disp_x + 28 + col_w3; gfx_y = sc2_y + 4; gfx_drawstr("TAPE FLUX & HF SHEEN CURVE");

  tp_base_y = sc2_y + sc2_h * 0.58;
  tp_knee_x = disp_x + 22 + col_w3 + (col_w3 - 24) * 0.65;
  gfx_r = 0.25; gfx_g = 0.30; gfx_b = 0.38;
  gfx_line(disp_x + 26 + col_w3, tp_base_y, tp_knee_x, tp_base_y);

  slider23 ? (
    // Active Tape Silk Shelf Curve
    gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.25;
    gfx_line(disp_x + 26 + col_w3, tp_base_y, tp_knee_x, tp_base_y);
    gfx_line(tp_knee_x, tp_base_y, tp_knee_x + 18, tp_base_y - 12);
    gfx_line(tp_knee_x + 18, tp_base_y - 12, disp_x + col_w3 * 2 - 8, tp_base_y - 12);
  ) : (
    // Bypassed flat response
    gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.58;
    gfx_line(tp_knee_x, tp_base_y, disp_x + col_w3 * 2 - 8, tp_base_y);
  );
  sc2_h >= 65 ? (
    gfx_setfont(1, "Consolas", 14); gfx_r = 0.70; gfx_g = 0.80; gfx_b = 0.90;
    gfx_x = disp_x + 28 + col_w3; gfx_y = sc2_y + sc2_h - 18;
    gfx_printf("Air Lift: %s", slider23 ? "+0.8dB @ 9.5kHz (Silk Knee)" : "0.0dB Flat (Bypassed)");
  );

  gfx_r = slider23 ? 0.35 : 0.12; gfx_g = slider23 ? 0.25 : 0.14; gfx_b = 0.08;
  gfx_rect(disp_x + 22 + col_w3, btn_y_sheen, col_w3 - 24, 30);
  gfx_r = 1.00; gfx_g = 0.85; gfx_b = 0.25; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 34 + col_w3; gfx_y = btn_y_sheen + 6;
  gfx_drawstr(slider23 ? "CLICK TO BYPASS TAPE SHEEN" : "CLICK TO ENGAGE TAPE SHEEN");
  mouse_clicked && b_sheen_btn ? (slider23 = !slider23; is_user_customized = 1; slider_automate(););

  // ── CARD 3: BUS CLIPPER & CEILING ────────────────────────────
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 22 + col_w3 * 2, disp_y + 32, col_w3, col_h3);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_rect(disp_x + 22 + col_w3 * 2, disp_y + 32, col_w3, col_h3, 0);
  
  gfx_setfont(1, "Orbitron", 16, 'b');
  gfx_x = disp_x + 30 + col_w3 * 2; gfx_y = disp_y + 40;
  gfx_drawstr("BUS CLIPPER & CEILING");

  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_setfont(1, "Consolas", 15, 'b');
  gfx_x = disp_x + 30 + col_w3 * 2; gfx_y = disp_y + 64;
  gfx_printf("TARGET CEIL : <= %.1f dBTP", slider3);

  gfx_r = 0.75; gfx_g = 0.88; gfx_b = 1.00;
  gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 30 + col_w3 * 2; gfx_y = disp_y + 88;
  gfx_drawstr("TOPOLOGY:");
  gfx_r = 1.00; gfx_g = 1.00; gfx_b = 1.00;
  gfx_x = disp_x + 110 + col_w3 * 2; gfx_y = disp_y + 88;
  gfx_drawstr(slider40==0 ? "Linear Transparent" : (slider40==1 ? "Smooth Bus Clipper" : "Hard Brickwall"));

  gfx_r = 0.80; gfx_g = 0.88; gfx_b = 0.95;
  gfx_setfont(1, "Segoe UI", 14);
  gfx_x = disp_x + 30 + col_w3 * 2; gfx_y = disp_y + 110;
  gfx_drawstr(slider40==0 ? "Pure linear float with safety clamp." : (slider40==1 ? "Soft-knee Hermite clipper shaves peaks." : "Digital truncation for commercial slam."));

  btn_y_clip = disp_y + col_h3 - 34;
  b_clip_cyc = (mouse_x >= disp_x + 28 + col_w3 * 2 && mouse_x <= disp_x + col_w3 * 3 && mouse_y >= btn_y_clip && mouse_y <= btn_y_clip + 30);

  // Dynamic Visualizer: Peak Ceiling & Clamp Scope
  sc3_y = disp_y + 138;
  sc3_h = max(45, btn_y_clip - sc3_y - 8);
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 28 + col_w3 * 2, sc3_y, col_w3 - 24, sc3_h);
  gfx_r = 0.08; gfx_g = 0.18; gfx_b = 0.12; gfx_rect(disp_x + 28 + col_w3 * 2, sc3_y, col_w3 - 24, sc3_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = disp_x + 34 + col_w3 * 2; gfx_y = sc3_y + 4; gfx_drawstr("PEAK CEILING & CLAMP SCOPE");

  // Ceiling clamp line
  ceil_line_y = sc3_y + 24;
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_line(disp_x + 32 + col_w3 * 2, ceil_line_y, disp_x + col_w3 * 3 - 2, ceil_line_y);
  gfx_line(disp_x + 32 + col_w3 * 2, ceil_line_y - 1, disp_x + col_w3 * 3 - 2, ceil_line_y - 1);

  // Simulated peak waveforms hitting ceiling
  pk_w = (col_w3 - 40) / 3;
  pk_i = 0;
  loop(3,
    pk_x = disp_x + 34 + col_w3 * 2 + pk_i * pk_w;
    pk_base = sc3_y + sc3_h - 22;
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
    slider40 == 0 ? (
      // Linear unclipped peaks under ceiling
      gfx_line(pk_x + 4, pk_base, pk_x + pk_w * 0.5, ceil_line_y + 6);
      gfx_line(pk_x + pk_w * 0.5, ceil_line_y + 6, pk_x + pk_w - 4, pk_base);
    ) : slider40 == 1 ? (
      // Soft rounded Hermite top
      gfx_line(pk_x + 4, pk_base, pk_x + pk_w * 0.35, ceil_line_y);
      gfx_line(pk_x + pk_w * 0.35, ceil_line_y, pk_x + pk_w * 0.65, ceil_line_y);
      gfx_line(pk_x + pk_w * 0.65, ceil_line_y, pk_x + pk_w - 4, pk_base);
    ) : (
      // Hard brickwall flat clamp
      gfx_line(pk_x + 4, pk_base, pk_x + pk_w * 0.25, ceil_line_y);
      gfx_r = 1.00; gfx_g = 0.25; gfx_b = 0.25;
      gfx_line(pk_x + pk_w * 0.25, ceil_line_y, pk_x + pk_w * 0.75, ceil_line_y);
      gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
      gfx_line(pk_x + pk_w * 0.75, ceil_line_y, pk_x + pk_w - 4, pk_base);
    );
    pk_i += 1;
  );
  sc3_h >= 65 ? (
    gfx_setfont(1, "Consolas", 14); gfx_r = 0.85; gfx_g = 0.95; gfx_b = 0.85;
    gfx_x = disp_x + 34 + col_w3 * 2; gfx_y = sc3_y + sc3_h - 18;
    gfx_printf("True Peak: %5.1f dBTP (Ceil: -6.0)", cur_out_true_peak);
  );

  gfx_r = b_clip_cyc ? 0.14 : 0.06; gfx_g = b_clip_cyc ? 0.32 : 0.18; gfx_b = b_clip_cyc ? 0.20 : 0.10;
  gfx_rect(disp_x + 28 + col_w3 * 2, btn_y_clip, col_w3 - 24, 30);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 38 + col_w3 * 2; gfx_y = btn_y_clip + 6;
  gfx_drawstr("CYCLE CLIPPER TOPOLOGY");
  mouse_clicked && b_clip_cyc ? (slider40 = (slider40 + 1) % 3; is_user_customized = 1; slider_automate(););

  // Bottom HUD
  hud_x = disp_x + 10; hud_y = disp_y + disp_h - 56; hud_w = disp_w - 20; hud_h = 50;
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(hud_x, hud_y, hud_w, hud_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(hud_x, hud_y, hud_w, hud_h, 0);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = hud_x + 12; gfx_y = hud_y + 6;
  gfx_drawstr("HARMONIC COLOR & TAPE WARMTH // INTERACTIVE SATURATION ENGINE");
  gfx_r = 0.92; gfx_g = 0.96; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = hud_x + 12; gfx_y = hud_y + 27;
  gfx_drawstr("Adjust drive intensity, switch tube/tape modes, or toggle tape air sheen. Instant real-time updates.");
);

slider1 == 4 ? (
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 14; gfx_y = disp_y + 8;
  gfx_drawstr("STEREO DIMENSION & SUB-BASS MONO ANCHOR");

  col_w4 = (disp_w - 38) / 3;
  col_h4 = max(110, (hud_y - 8) - (disp_y + 32));

  s_btn_y = disp_y + col_h4 - 34;
  s_btn_w = (col_w4 - 28) / 2;
  s_scope_y = disp_y + 118;
  s_scope_h = max(45, s_btn_y - s_scope_y - 8);

  // ── Card 1: Stereo Width ──
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 10, disp_y + 32, col_w4, col_h4);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_rect(disp_x + 10, disp_y + 32, col_w4, col_h4, 0);
  
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 18; gfx_y = disp_y + 40;
  gfx_drawstr("STEREO DIMENSION WIDTH");
  
  gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = disp_x + 18; gfx_y = disp_y + 64;
  gfx_printf("Width Multiplier : %.2fx", slider7);
  gfx_x = disp_x + 18; gfx_y = disp_y + 84;
  gfx_printf("Mode: %s", slider7 > 1.0 ? "Expanded Panoramic Stereo" : (slider7 < 1.0 ? "Narrow Focused Soundstage" : "1.00x Unity Passthrough"));

  // Dynamic Visualizer: Stereo Width Spatial Goniometer
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 18, s_scope_y, col_w4 - 28, s_scope_h);
  gfx_r = 0.08; gfx_g = 0.16; gfx_b = 0.24; gfx_rect(disp_x + 18, s_scope_y, col_w4 - 28, s_scope_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = disp_x + 24; gfx_y = s_scope_y + 4; gfx_drawstr("MID / SIDE PANORAMA EXPANSION");
  sg_cx = disp_x + 18 + (col_w4 - 28) * 0.5;
  sg_cy = s_scope_y + s_scope_h * 0.55;
  sg_rx = floor(min(col_w4 * 0.38, 55) * slider7);
  sg_ry = 18;
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 0.70;
  gfx_circle(sg_cx, sg_cy, sg_ry, 0);
  gfx_line(sg_cx - sg_rx, sg_cy, sg_cx + sg_rx, sg_cy);
  gfx_line(sg_cx, sg_cy - sg_ry, sg_cx, sg_cy + sg_ry);
  gfx_a = 1.00;

  // Steppers: [ Width -0.02x ] [ Width +0.02x ] (Clean Luminous Fonts)
  b_w_minus = (mouse_x >= disp_x + 16 && mouse_x <= disp_x + 16 + s_btn_w && mouse_y >= s_btn_y && mouse_y <= s_btn_y + 28);
  b_w_plus  = (mouse_x >= disp_x + 20 + s_btn_w && mouse_x <= disp_x + 20 + s_btn_w * 2 && mouse_y >= s_btn_y && mouse_y <= s_btn_y + 28);

  gfx_r = b_w_minus ? 0.22 : 0.10; gfx_g = b_w_minus ? 0.30 : 0.16; gfx_b = b_w_minus ? 0.40 : 0.24;
  gfx_rect(disp_x + 16, s_btn_y, s_btn_w, 28);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 20; gfx_y = s_btn_y + 5; gfx_drawstr("Width -0.02");

  gfx_r = b_w_plus ? 0.22 : 0.10; gfx_g = b_w_plus ? 0.30 : 0.16; gfx_b = b_w_plus ? 0.40 : 0.24;
  gfx_rect(disp_x + 20 + s_btn_w, s_btn_y, s_btn_w, 28);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 24 + s_btn_w; gfx_y = s_btn_y + 5; gfx_drawstr("Width +0.02");

  mouse_clicked && b_w_minus ? (slider7 = max(0.5, slider7 - 0.02); is_user_customized = 1; slider_automate(););
  mouse_clicked && b_w_plus  ? (slider7 = min(1.5, slider7 + 0.02); is_user_customized = 1; slider_automate(););

  // ── Card 2: Sub-Bass Mono Anchor ──
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 16 + col_w4, disp_y + 32, col_w4, col_h4);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_rect(disp_x + 16 + col_w4, disp_y + 32, col_w4, col_h4, 0);
  
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 24 + col_w4; gfx_y = disp_y + 40;
  gfx_drawstr("SUB-BASS MONO ANCHOR");
  
  gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = disp_x + 24 + col_w4; gfx_y = disp_y + 64;
  gfx_printf("Cutoff Freq: %d Hz (Elliptic Filter)", slider6);
  gfx_x = disp_x + 24 + col_w4; gfx_y = disp_y + 84;
  gfx_drawstr("Collapses sub-bass to 100% Mono");

  // Dynamic Visualizer: Elliptic Sub Crossover Curve
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.050; gfx_rect(disp_x + 24 + col_w4, s_scope_y, col_w4 - 28, s_scope_h);
  gfx_r = 0.10; gfx_g = 0.20; gfx_b = 0.14; gfx_rect(disp_x + 24 + col_w4, s_scope_y, col_w4 - 28, s_scope_h, 0);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = disp_x + 30 + col_w4; gfx_y = s_scope_y + 4; gfx_drawstr("ELLIPTIC MONO-SUMMING CROSSOVER");
  sub_cx = disp_x + 24 + col_w4 + (col_w4 - 28) * 0.45;
  sub_cy = s_scope_y + s_scope_h * 0.55;
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_line(disp_x + 30 + col_w4, sub_cy - 12, sub_cx - 15, sub_cy - 12);
  gfx_line(sub_cx - 15, sub_cy - 12, sub_cx + 15, sub_cy + 12);
  gfx_line(sub_cx + 15, sub_cy + 12, disp_x + col_w4 * 2 - 14, sub_cy + 12);
  s_scope_h >= 65 ? (
    gfx_setfont(1, "Consolas", 14); gfx_r = 0.85; gfx_g = 0.88; gfx_b = 0.92;
    gfx_x = disp_x + 30 + col_w4; gfx_y = s_scope_y + s_scope_h - 20;
    gfx_printf("Phase-Locked Mono Below %d Hz", slider6);
  );

  // Steppers: [ Cutoff -5Hz ] [ Cutoff +5Hz ] (Clean Luminous Fonts)
  b_sub_minus = (mouse_x >= disp_x + 22 + col_w4 && mouse_x <= disp_x + 22 + col_w4 + s_btn_w && mouse_y >= s_btn_y && mouse_y <= s_btn_y + 28);
  b_sub_plus  = (mouse_x >= disp_x + 26 + col_w4 + s_btn_w && mouse_x <= disp_x + 26 + col_w4 + s_btn_w * 2 && mouse_y >= s_btn_y && mouse_y <= s_btn_y + 28);

  gfx_r = b_sub_minus ? 0.16 : 0.08; gfx_g = b_sub_minus ? 0.32 : 0.20; gfx_b = b_sub_minus ? 0.20 : 0.12;
  gfx_rect(disp_x + 22 + col_w4, s_btn_y, s_btn_w, 28);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 26 + col_w4; gfx_y = s_btn_y + 5; gfx_drawstr("Cutoff -5");

  gfx_r = b_sub_plus ? 0.16 : 0.08; gfx_g = b_sub_plus ? 0.32 : 0.20; gfx_b = b_sub_plus ? 0.20 : 0.12;
  gfx_rect(disp_x + 26 + col_w4 + s_btn_w, s_btn_y, s_btn_w, 28);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_setfont(1, "Segoe UI", 14, 'b');
  gfx_x = disp_x + 30 + col_w4 + s_btn_w; gfx_y = s_btn_y + 5; gfx_drawstr("Cutoff +5");

  mouse_clicked && b_sub_minus ? (slider6 = max(40, slider6 - 5); is_user_customized = 1; update_mix_filters(); slider_automate(););
  mouse_clicked && b_sub_plus  ? (slider6 = min(250, slider6 + 5); is_user_customized = 1; update_mix_filters(); slider_automate(););

  // ── Card 3: Real Phase Correlation Matrix ──
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(disp_x + 22 + col_w4 * 2, disp_y + 32, col_w4, col_h4);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  gfx_rect(disp_x + 22 + col_w4 * 2, disp_y + 32, col_w4, col_h4, 0);
  
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 30 + col_w4 * 2; gfx_y = disp_y + 40;
  gfx_drawstr("PHASE CORRELATION MATRIX");
  
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = disp_x + 30 + col_w4 * 2; gfx_y = disp_y + 64;
  cur_rms < -55.0 ? (
    gfx_printf("Real-Time Correlation: +1.00 (Standby)");
    gfx_x = disp_x + 30 + col_w4 * 2; gfx_y = disp_y + 84;
    gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
    gfx_drawstr("SAFE: Phase-Locked Mono / Stereo Ready");
    needle_corr = 1.0;
  ) : (
    gfx_printf("Real-Time Correlation: %+.2f", cur_corr);
    gfx_x = disp_x + 30 + col_w4 * 2; gfx_y = disp_y + 84;
    cur_corr < 0.0 ? (
      gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.25; gfx_drawstr("ALERT: Out-Of-Phase Cancellation");
    ) : cur_corr < 0.30 ? (
      gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15; gfx_drawstr("CAUTION: Wide Ambience In Stereo");
    ) : (
      gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_drawstr("SAFE: 100% Mono-Compatible");
    );
    needle_corr = cur_corr;
  );

  // Dynamic Horizontal Phase Correlation Meter Bar (-1.0 to +1.0)
  pcm_x = disp_x + 30 + col_w4 * 2;
  pcm_w = col_w4 - 40;
  pcm_y = s_scope_y + 10;
  pcm_h = 24;
  gfx_r = 0.035; gfx_g = 0.045; gfx_b = 0.065; gfx_rect(pcm_x, pcm_y, pcm_w, pcm_h);
  // Red Danger Zone (-1.0 to 0.0)
  gfx_r = 0.35; gfx_g = 0.08; gfx_b = 0.08; gfx_a = 0.50; gfx_rect(pcm_x, pcm_y, floor(pcm_w * 0.50), pcm_h);
  // Green Safe Zone (0.0 to +1.0)
  gfx_r = 0.08; gfx_g = 0.25; gfx_b = 0.12; gfx_a = 0.50; gfx_rect(pcm_x + floor(pcm_w * 0.50), pcm_y, floor(pcm_w * 0.50), pcm_h);
  gfx_a = 1.00;
  gfx_r = 0.30; gfx_g = 0.36; gfx_b = 0.48; gfx_rect(pcm_x, pcm_y, pcm_w, pcm_h, 0);
  // Center 0.0 mark
  gfx_r = 0.80; gfx_g = 0.85; gfx_b = 0.90; gfx_line(pcm_x + floor(pcm_w * 0.50), pcm_y, pcm_x + floor(pcm_w * 0.50), pcm_y + pcm_h);
  // Moving Needle
  needle_frac = max(0.0, min(1.0, (needle_corr + 1.0) * 0.50));
  nx = pcm_x + needle_frac * pcm_w;
  needle_corr < 0.0 ? (gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.25;) : (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;);
  gfx_rect(nx - 3, pcm_y - 2, 6, pcm_h + 4);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_line(nx, pcm_y - 2, nx, pcm_y + pcm_h + 2);

  // Meter Labels
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.82;
  gfx_x = pcm_x + 4; gfx_y = pcm_y + pcm_h + 6; gfx_drawstr("-1.0");
  gfx_x = pcm_x + floor(pcm_w * 0.50) - 10; gfx_y = pcm_y + pcm_h + 6; gfx_drawstr("0.0");
  gfx_x = pcm_x + pcm_w - 32; gfx_y = pcm_y + pcm_h + 6; gfx_drawstr("+1.0");

  hud_x = disp_x + 10; hud_y = disp_y + disp_h - 56; hud_w = disp_w - 20; hud_h = 50;
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(hud_x, hud_y, hud_w, hud_h);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.26; gfx_rect(hud_x, hud_y, hud_w, hud_h, 0);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_setfont(1, "Orbitron", 14, 'b');
