  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = col2_x + 10; gfx_y = p_content_y + 24;
  gfx_printf("Ceil: %.1f dBTP | Trim: %+.1fdB | Crest: %.1fdB", cur_out_true_peak, slider5, cur_crest);

  cal_btn_w = col2_w - 20;
  cal_btn_h = 28;
  cal_btn_x = col2_x + 10;
  cal_btn_y = p_content_y + p_content_h - cal_btn_h - 6;
  cal_hover = (mouse_x >= cal_btn_x && mouse_x <= cal_btn_x + cal_btn_w && mouse_y >= cal_btn_y && mouse_y <= cal_btn_y + cal_btn_h);

  // 4-Band Telemetry Corridor Display (Full Labels & Tolerances)
  t_row_y = p_content_y + 44;
  t_row_h = 20;
  t_gap = 6;
  t_bar_w = col2_w - 24;

  // Band 1: Low (20-250 Hz)
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h);
  gfx_r = 0.10; gfx_g = 0.15; gfx_b = 0.22; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h, 0);
  cx1 = col2_x + 12 + (tb_tgt_low_min / 100.0) * t_bar_w;
  cx2 = col2_x + 12 + (tb_tgt_low_max / 100.0) * t_bar_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h, 0);
  lx = col2_x + 12 + min(1.0, tb_pct_low / 100.0) * t_bar_w;
  in_b1 = (tb_pct_low >= tb_tgt_low_min && tb_pct_low <= tb_tgt_low_max);
  gfx_r = in_b1 ? 0.15 : 1.00; gfx_g = in_b1 ? 0.95 : 0.72; gfx_b = in_b1 ? 0.45 : 0.15;
  gfx_rect(lx - 2, t_row_y, 4, t_row_h);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = col2_x + 16; gfx_y = t_row_y + 2; gfx_printf("LOW (20-250Hz) %4.1f%%", tb_pct_low);

  // Band 2: Low-Mid (250-2000 Hz)
  t_row_y += t_row_h + t_gap;
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h);
  gfx_r = 0.10; gfx_g = 0.15; gfx_b = 0.22; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h, 0);
  cx1 = col2_x + 12 + (tb_tgt_lmid_min / 100.0) * t_bar_w;
  cx2 = col2_x + 12 + (tb_tgt_lmid_max / 100.0) * t_bar_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h, 0);
  lx = col2_x + 12 + min(1.0, tb_pct_lmid / 100.0) * t_bar_w;
  in_b2 = (tb_pct_lmid >= tb_tgt_lmid_min && tb_pct_lmid <= tb_tgt_lmid_max);
  gfx_r = in_b2 ? 0.15 : 1.00; gfx_g = in_b2 ? 0.95 : 0.72; gfx_b = in_b2 ? 0.45 : 0.15;
  gfx_rect(lx - 2, t_row_y, 4, t_row_h);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = col2_x + 16; gfx_y = t_row_y + 2; gfx_printf("LMID (250-2k)  %4.1f%%", tb_pct_lmid);

  // Band 3: High-Mid (2000-8000 Hz)
  t_row_y += t_row_h + t_gap;
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h);
  gfx_r = 0.10; gfx_g = 0.15; gfx_b = 0.22; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h, 0);
  cx1 = col2_x + 12 + (tb_tgt_hmid_min / 100.0) * t_bar_w;
  cx2 = col2_x + 12 + (tb_tgt_hmid_max / 100.0) * t_bar_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h, 0);
  lx = col2_x + 12 + min(1.0, tb_pct_hmid / 100.0) * t_bar_w;
  in_b3 = (tb_pct_hmid >= tb_tgt_hmid_min && tb_pct_hmid <= tb_tgt_hmid_max);
  gfx_r = in_b3 ? 0.15 : 1.00; gfx_g = in_b3 ? 0.95 : 0.72; gfx_b = in_b3 ? 0.45 : 0.15;
  gfx_rect(lx - 2, t_row_y, 4, t_row_h);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = col2_x + 16; gfx_y = t_row_y + 2; gfx_printf("HMID (2k-8kHz) %4.1f%%", tb_pct_hmid);

  // Band 4: Air Sheen (>8000 Hz)
  t_row_y += t_row_h + t_gap;
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h);
  gfx_r = 0.10; gfx_g = 0.15; gfx_b = 0.22; gfx_rect(col2_x + 12, t_row_y, t_bar_w, t_row_h, 0);
  cx1 = col2_x + 12 + (tb_tgt_high_min / 100.0) * t_bar_w;
  cx2 = col2_x + 12 + (tb_tgt_high_max / 100.0) * t_bar_w;
  gfx_r = 0.00; gfx_g = 0.35; gfx_b = 0.45; gfx_a = 0.45; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00; gfx_a = 1.00; gfx_rect(cx1, t_row_y, max(4, cx2 - cx1), t_row_h, 0);
  lx = col2_x + 12 + min(1.0, tb_pct_high / 100.0) * t_bar_w;
  in_b4 = (tb_pct_high >= tb_tgt_high_min && tb_pct_high <= tb_tgt_high_max);
  gfx_r = in_b4 ? 0.15 : 1.00; gfx_g = in_b4 ? 0.95 : 0.72; gfx_b = in_b4 ? 0.45 : 0.15;
  gfx_rect(lx - 2, t_row_y, 4, t_row_h);
  gfx_setfont(1, "Consolas", 14, 'b'); gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_x = col2_x + 16; gfx_y = t_row_y + 2; gfx_printf("AIR  (>8kHz)   %4.1f%%", tb_pct_high);

  gfx_r = cal_hover ? 0.00 : 0.08;
  gfx_g = cal_hover ? 0.90 : 0.65;
  gfx_b = cal_hover ? 0.45 : 0.35;
  gfx_rect(cal_btn_x, cal_btn_y, cal_btn_w, cal_btn_h);

  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_measurestr("TAILOR & CALIBRATE TO PROJECT", cb_w, cb_h);
  gfx_x = floor(cal_btn_x + (cal_btn_w - cb_w) * 0.5); gfx_y = cal_btn_y + 6;
  gfx_drawstr("TAILOR & CALIBRATE TO PROJECT");

  mouse_clicked && cal_hover ? (
    audit_active == 1 ? (
      solve_mixing_chorus_impact();
    ) : (
      audit_active = 1;
      audit_samples = 0;
      audit_loudest_rms = -120.0;
      audit_quietest_rms = 0.0;
      audit_peak_hold = 0.0;
      audit_rms_sum = 0.0;
      audit_rms_count = 0;
      verse_rms_acc = 0.0; verse_acc_count = 0;
      chorus_rms_acc = 0.0; chorus_acc_count = 0;
    );
  );

  // ── Column 3: AI Audit & Adaptation Log Terminal ──
  gfx_r = 0.025; gfx_g = 0.035; gfx_b = 0.048;
  gfx_rect(col3_x, p_content_y, col3_w, p_content_h);
  gfx_r = 0.20; gfx_g = 0.26; gfx_b = 0.36;
  gfx_rect(col3_x, p_content_y, col3_w, p_content_h, 0);

  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = col3_x + 10; gfx_y = p_content_y + 8;
  gfx_drawstr("AI AUDIT & ADAPTATION LOG");

  col3_w >= 410 ? gfx_setfont(1, "Consolas", 12, 'b') :
  col3_w >= 340 ? gfx_setfont(1, "Consolas", 11, 'b') : gfx_setfont(1, "Consolas", 11);
  log_y = p_content_y + 26;
  log_step = min(20, max(16, floor((p_content_h - 72) / 5)));

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = col3_x + 10; gfx_y = log_y;
  gfx_drawstr(ai_status_l1);

  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_x = col3_x + 10; gfx_y = log_y + log_step;
  gfx_drawstr(ai_status_l2);

  gfx_r = 0.95; gfx_g = 0.85; gfx_b = 0.25;
  gfx_x = col3_x + 10; gfx_y = log_y + log_step * 2;
  slider24 > 0 ? (
    gfx_printf("RIDER AUTO  : %+.1fdB [CREST: %.1fdB]", mix_rider_smooth, cur_inst_crest);
  ) : (
    gfx_drawstr(ai_status_l3);
  );

  // Live Song Structure Section Detection State
  gfx_x = col3_x + 10; gfx_y = log_y + log_step * 3;
  struct_state == 3 ? (gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;) :
  (struct_state == 1 || struct_state == 2) ? (gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;) :
  struct_state == 4 ? (gfx_r = 0.40; gfx_g = 0.75; gfx_b = 1.00;) :
  struct_state == 5 ? (gfx_r = 0.65; gfx_g = 0.70; gfx_b = 0.75;) :
                      (gfx_r = 0.85; gfx_g = 0.92; gfx_b = 1.00;);
  (struct_state == 1 && g_to_chorus > 0.0 && g_to_chorus < 8.0) ? (
    gfx_printf("PRE-CHORUS // BUILD [-%.1fs]", g_to_chorus);
  ) : (
    gfx_drawstr(struct_status_str);
  );

  // Real-Time Dynamic Chorus Impact Offsets
  gfx_x = col3_x + 10; gfx_y = log_y + log_step * 4;
  gfx_r = 0.00; gfx_g = 0.95; gfx_b = 1.00;
  gfx_printf("AI OFFSETS: W:%+.2fx | P:%+.1fdB | Sat:%+.1fdB", dyn_width_boost, dyn_punch_boost, dyn_drive_boost);

  // Mission Control Interactive Mode Button: Song Structure AI
  m_struct_hover = (mouse_x >= col3_x + 10 && mouse_x <= col3_x + col3_w - 10 && mouse_y >= p_content_y + p_content_h - 38 && mouse_y <= p_content_y + p_content_h - 8);
  gfx_r = m_struct_hover ? 0.08 : 0.040; gfx_g = m_struct_hover ? 0.12 : 0.055; gfx_b = m_struct_hover ? 0.16 : 0.075;
  gfx_rect(col3_x + 10, p_content_y + p_content_h - 38, col3_w - 20, 30);
  gfx_r = slider44 ? 0.15 : 0.50; gfx_g = slider44 ? 0.95 : 0.50; gfx_b = slider44 ? 0.45 : 0.50;
  gfx_rect(col3_x + 10, p_content_y + p_content_h - 38, col3_w - 20, 30, 0);
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = col3_x + 16; gfx_y = p_content_y + p_content_h - 32;
  slider44 == 0 ? gfx_drawstr("SONG STRUCTURE AI: BYPASSED (CLICK)") :
  slider44 == 1 ? gfx_drawstr("AI CHORUS: TASTEFUL AUTO-IMPACT (CLICK)") :
  slider44 == 2 ? gfx_drawstr("AI CHORUS: COMMERCIAL DROP SLAM (CLICK)") :
                  gfx_drawstr("AI CHORUS: SUBTLE BREATHING (CLICK)");
  mouse_clicked && m_struct_hover ? (
    slider44 = (slider44 + 1) % 4;
    slider_automate();
  );
);

crt_phase = (crt_phase + 0.035) % 6.2831853;
crt_glow = 0.032 + sin(crt_phase * 2.0) * 0.003;

scan_y = floor(disp_y);
gfx_r = 0.00; gfx_g = 0.04; gfx_b = 0.06; gfx_a = crt_glow;
loop(floor(disp_h / 3),
  gfx_line(disp_x, scan_y, disp_x + disp_w, scan_y);
  scan_y += 3;
);

gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45; gfx_a = 0.65;
ret_len = 14;
gfx_line(disp_x, disp_y, disp_x + ret_len, disp_y);
gfx_line(disp_x, disp_y, disp_x, disp_y + ret_len);
gfx_line(disp_x + disp_w - ret_len, disp_y, disp_x + disp_w, disp_y);
gfx_line(disp_x + disp_w, disp_y, disp_x + disp_w, disp_y + ret_len);
gfx_line(disp_x, disp_y + disp_h - ret_len, disp_x, disp_y + disp_h);
gfx_line(disp_x, disp_y + disp_h, disp_x + ret_len, disp_y + disp_h);

gfx_r = 0.035; gfx_g = 0.048; gfx_b = 0.065;
gfx_rect(dock_x, dock_y, dock_w, dock_h);
gfx_r = 0.12; gfx_g = 0.16; gfx_b = 0.22;
gfx_line(dock_x, dock_y, dock_x + dock_w, dock_y);

dk_col_w = (dock_w - 36) / 4;
card_btn_y = dock_y + dock_h - 42;

// Dock Column 1: Headroom Guardian
gfx_r = 0.045; gfx_g = 0.058; gfx_b = 0.078;
gfx_rect(dock_x + 6, dock_y + 8, dk_col_w, dock_h - 16);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_setfont(1, "Orbitron", 14, 'b');
gfx_x = dock_x + 14; gfx_y = dock_y + 14;
gfx_drawstr("HEADROOM GUARDIAN");
gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
gfx_setfont(1, "Consolas", 16, 'b');
gfx_x = dock_x + 14; gfx_y = dock_y + 38;
gfx_printf("Ceiling: %.1f dBTP", slider3);

at_hover = (mouse_x >= dock_x + 14 && mouse_x <= dock_x + dk_col_w - 14 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 28);
gfx_r = slider4 ? 0.08 : (at_hover ? 0.22 : 0.12);
gfx_g = slider4 ? 0.45 : (at_hover ? 0.26 : 0.14);
gfx_b = slider4 ? 0.22 : (at_hover ? 0.35 : 0.18);
gfx_rect(dock_x + 14, card_btn_y, dk_col_w - 28, 32);
gfx_r = slider4 ? 0.15 : 0.95; gfx_g = slider4 ? 0.95 : 0.98; gfx_b = slider4 ? 0.45 : 1.00;
gfx_setfont(1, "Orbitron", 14, 'b');
gfx_x = dock_x + 22; gfx_y = card_btn_y + 7;
gfx_drawstr(slider4 ? "LOCK <= -6 dBTP" : "ENABLE -6dB LOCK");
mouse_clicked && at_hover ? (slider4 = !slider4; slider_automate(););

// Dock Column 2: Sub Mono-Anchor (Interactive Steppers)
gfx_r = 0.045; gfx_g = 0.058; gfx_b = 0.078;
gfx_rect(dock_x + 12 + dk_col_w, dock_y + 8, dk_col_w, dock_h - 16);
gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
gfx_setfont(1, "Orbitron", 14, 'b');
gfx_x = dock_x + 20 + dk_col_w; gfx_y = dock_y + 14;
gfx_drawstr("SUB MONO-ANCHOR");
gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
gfx_setfont(1, "Consolas", 16, 'b');
gfx_x = dock_x + 20 + dk_col_w; gfx_y = dock_y + 38;
gfx_printf("Cutoff: %d Hz (Mono)", slider6);

sm_btn_minus = (mouse_x >= dock_x + 20 + dk_col_w && mouse_x <= dock_x + 60 + dk_col_w && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 28);
sm_btn_plus  = (mouse_x >= dock_x + 66 + dk_col_w && mouse_x <= dock_x + 106 + dk_col_w && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 28);
gfx_r = sm_btn_minus ? 0.22 : 0.12; gfx_g = sm_btn_minus ? 0.28 : 0.14; gfx_b = sm_btn_minus ? 0.35 : 0.18;
gfx_rect(dock_x + 20 + dk_col_w, card_btn_y, 44, 30);
gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Consolas", 18, 'b');
gfx_x = dock_x + 36 + dk_col_w; gfx_y = card_btn_y + 4; gfx_drawstr("-");

gfx_r = sm_btn_plus ? 0.22 : 0.12; gfx_g = sm_btn_plus ? 0.28 : 0.14; gfx_b = sm_btn_plus ? 0.35 : 0.18;
gfx_rect(dock_x + 66 + dk_col_w, card_btn_y, 44, 30);
gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Consolas", 18, 'b');
gfx_x = dock_x + 82 + dk_col_w; gfx_y = card_btn_y + 4; gfx_drawstr("+");
mouse_clicked && sm_btn_minus ? (slider6 = max(60, slider6 - 5); update_mix_filters(); slider_automate(););
mouse_clicked && sm_btn_plus  ? (slider6 = min(160, slider6 + 5); update_mix_filters(); slider_automate(););

// Dock Column 3: Console Comp Glue (Interactive Ratio Cycle)
gfx_r = 0.045; gfx_g = 0.058; gfx_b = 0.078;
gfx_rect(dock_x + 18 + dk_col_w * 2, dock_y + 8, dk_col_w, dock_h - 16);
gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
gfx_setfont(1, "Orbitron", 14, 'b');
gfx_x = dock_x + 26 + dk_col_w * 2; gfx_y = dock_y + 14;
gfx_drawstr("CONSOLE COMP GLUE");
gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
gfx_setfont(1, "Consolas", 15, 'b');
gfx_x = dock_x + 26 + dk_col_w * 2; gfx_y = dock_y + 38;
gfx_printf("Thresh: %.1fdB | Ratio: %s", slider9, slider10==0?"1.5:1":(slider10==1?"2:1":(slider10==2?"4:1":"8:1")));

cg_ratio_btn = (mouse_x >= dock_x + 26 + dk_col_w * 2 && mouse_x <= dock_x + dk_col_w * 3 - 8 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 28);
gfx_r = cg_ratio_btn ? 0.32 : 0.16; gfx_g = cg_ratio_btn ? 0.25 : 0.12; gfx_b = cg_ratio_btn ? 0.10 : 0.06;
gfx_rect(dock_x + 26 + dk_col_w * 2, card_btn_y, dk_col_w - 24, 30);
gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
gfx_setfont(1, "Orbitron", 14, 'b');
gfx_x = dock_x + 34 + dk_col_w * 2; gfx_y = card_btn_y + 6;
gfx_printf("CYCLE RATIO: %s", slider10==0?"1.5:1":(slider10==1?"2:1":(slider10==2?"4:1":"8:1")));
mouse_clicked && cg_ratio_btn ? (slider10 = (slider10 + 1) % 4; update_mix_filters(); slider_automate(););

// Dock Column 4: Mix Output Trim
gfx_r = 0.045; gfx_g = 0.058; gfx_b = 0.078;
gfx_rect(dock_x + 24 + dk_col_w * 3, dock_y + 8, dk_col_w, dock_h - 16);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
gfx_setfont(1, "Orbitron", 14, 'b');
gfx_x = dock_x + 32 + dk_col_w * 3; gfx_y = dock_y + 14;
gfx_drawstr("MIX OUTPUT TRIM");
gfx_r = 0.00; gfx_g = 0.95; gfx_b = 1.00;
gfx_setfont(1, "Consolas", 20, 'b');
gfx_x = dock_x + 32 + dk_col_w * 3; gfx_y = dock_y + 38;
gfx_printf("%+.1f dB", slider5);

tm_btn = (mouse_x >= dock_x + 32 + dk_col_w * 3 && mouse_x <= dock_x + 72 + dk_col_w * 3 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 28);
tp_btn = (mouse_x >= dock_x + 78 + dk_col_w * 3 && mouse_x <= dock_x + 118 + dk_col_w * 3 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 28);

gfx_r = tm_btn ? 0.22 : 0.12; gfx_g = tm_btn ? 0.26 : 0.14; gfx_b = tm_btn ? 0.35 : 0.18;
gfx_rect(dock_x + 32 + dk_col_w * 3, card_btn_y, 46, 32);
gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Consolas", 18, 'b');
gfx_x = dock_x + 48 + dk_col_w * 3; gfx_y = card_btn_y + 5; gfx_drawstr("-");

gfx_r = tp_btn ? 0.22 : 0.12; gfx_g = tp_btn ? 0.26 : 0.14; gfx_b = tp_btn ? 0.35 : 0.18;
