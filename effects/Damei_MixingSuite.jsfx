      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "BUS GLUE     : 2:1 British VCA | 125Hz SC HPF");
      ai_status_l4 = sprintf(#, "CLARITY      : -2.6dB 330Hz De-Box | 4.2k De-Harsh Notch");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 18 ? (
      // 18. DAN BRAUNSTEIN (Spiritbox / Dayseeker)
      slider8  = 0;
      slider9  = max(-26.0, min(-12.0, c_rms_db + 2.5));
      slider10 = 1;     // 2:1 Ratio
      slider11 = 30.0;
      slider12 = 0;
      slider13 = 120.0;
      slider14 = 1.2;
      slider34 = 1.3;
      slider28 = 1;
      slider29 = 2600;  // Wide vocal pocket
      slider41 = 1.1;
      slider30 = 1;
      slider31 = 180;
      slider17 = -2.6;
      slider18 = 340;
      slider21 = 1.2;
      slider22 = 0;
      slider7  = 1.18;  // 1.18x Expansive Width
      slider6  = 90;
      ai_status_l1 = sprintf(#, "BRAUNSTEIN IMPACT: Ethereal Soundstage (1.18x) & Vocal Donut");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "VOCAL DONUT  : -2.0dB @ 2.6kHz (Wide Space for Lead Vocals)");
      ai_status_l4 = sprintf(#, "SOUNDSTAGE   : 1.18x Expansive Width | Triode Tape Sheen");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 19 ? (
      // 19. ZAKK CERVINI & ERIK RON (Bad Omens)
      slider8  = 0;
      slider9  = max(-26.0, min(-12.0, c_rms_db + 2.0));
      slider10 = 1;     // 2:1 Ratio
      slider11 = 30.0;
      slider12 = 0;
      slider13 = 140.0; // 140Hz SC HPF protects massive 808 sub bass
      slider14 = 1.3;
      slider34 = 1.4;
      slider28 = 1;
      slider29 = 2500;
      slider41 = 1.3;   // Upfront pop/metal lead vocal
      slider30 = 1;
      slider31 = 180;
      slider17 = -2.5;
      slider18 = 350;
      slider21 = 1.4;
      slider22 = 1;
      slider7  = 1.15;
      slider6  = 85;    // 85Hz Sub Mono Anchor for 808s
      ai_status_l1 = sprintf(#, "CERVINI IMPACT: Radio Crossover Slam & 808 Sub Drop Protection");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "808 SUB SHIELD: 140Hz SC HPF | 85Hz Sub Mono Anchor");
      ai_status_l4 = sprintf(#, "VOCAL IMPACT : +1.3dB Upfront Commercial Lead Presence");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 20 ? (
      // 20. JENS BOGREN (Fascination Street Studios / Opeth / Sepultura)
      slider8  = 0;     // British VCA
      slider9  = max(-26.0, min(-12.0, c_rms_db + 2.0));
      slider10 = 1;     // 2:1 Ratio
      slider11 = 30.0;
      slider12 = 0;
      slider13 = 120.0; // 120Hz SC HPF
      slider14 = 1.2;
      slider34 = 1.4;   // +1.4dB Punch Attack
      slider28 = 1;
      slider29 = 2600;
      slider41 = 1.0;
      slider30 = 1;
      slider31 = 185;
      slider17 = -2.4;  // -2.4dB Mud Scoop at 330Hz
      slider18 = 330;
      slider21 = 1.4;   // +1.4dB Pentode Drive
      slider22 = 1;
      slider7  = 1.12;  // 1.12x Width
      slider6  = 95;    // 95Hz Sub Mono Anchor
      ai_status_l1 = sprintf(#, "BOGREN IMPACT : Scandinavian Heavy Weight (+1.4dB Punch) & VCA Glue");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "BUS GLUE     : 2:1 VCA | 120Hz SC HPF | -2.4dB @ 330Hz Mud Scoop");
      ai_status_l4 = sprintf(#, "ANALOG DRIVE : +1.4dB Pentode Saturation | 95Hz Sub Mono Anchor");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 21 ? (
      // 21. ADAM NOLLY GETGOOD (Periphery / GGD / Animals As Leaders)
      slider8  = 0;     // British VCA
      slider9  = max(-26.0, min(-12.0, c_rms_db + 2.2));
      slider10 = 1;     // 2:1 Ratio
      slider11 = 30.0;
      slider12 = 0;
      slider13 = 130.0; // 130Hz SC HPF
      slider14 = 1.1;
      slider34 = 1.3;   // +1.3dB Punch Attack
      slider28 = 1;
      slider29 = 2700;
      slider41 = 1.1;
      slider30 = 1;
      slider31 = 190;
      slider17 = -2.2;  // -2.2dB Mud Scoop at 350Hz
      slider18 = 350;
      slider21 = 1.2;   // +1.2dB Warm Triode + Tape
      slider22 = 0;
      slider7  = 1.10;  // 1.10x Tight Focused Width
      slider6  = 90;    // 90Hz Sub Mono Anchor
      ai_status_l1 = sprintf(#, "NOLLY IMPACT  : Surgical GGD Transient Dynamics & 130Hz SC Shield");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "SURGICAL GLUE: 2:1 VCA | 130Hz SC HPF | 350Hz Mud Clearance");
      ai_status_l4 = sprintf(#, "FIDELITY     : +1.2dB Triode Tape | Tight 1.10x Stereo Stage");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 22 ? (
      // 22. ACLE KAHNEY (TesseracT - King / 4D Sounds)
      slider8  = 0;     // British VCA
      slider9  = max(-28.0, min(-14.0, c_rms_db + 3.0));
      slider10 = 0;     // 1.5:1 Ratio (open audiophile dynamics)
      slider11 = 30.0;  // 30ms Transient Snap
      slider12 = 0;
      slider13 = 125.0; // 125Hz SC HPF
      slider14 = 0.5;
      slider34 = 1.6;   // +1.6dB Drum Attack Punch
      slider28 = 1;
      slider29 = 2800;
      slider41 = 0.8;
      slider30 = 1;
      slider31 = 185;
      slider17 = -2.0;  // -2.0dB Mud Scoop at 330Hz
      slider18 = 330;
      slider21 = 0.8;   // +0.8dB Triode Warmth
      slider22 = 0;
      slider7  = 1.15;  // 1.15x Expansive Stereo Field
      slider6  = 90;    // 90Hz Sub Mono Anchor
      ai_status_l1 = sprintf(#, "ACLE IMPACT   : Audiophile Djent Dynamics (+1.6dB Snare) & 125Hz Shield");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "DYNAMIC GLUE : 1.5:1 VCA | 125Hz SC HPF | 330Hz Mud Clearance");
      ai_status_l4 = sprintf(#, "SPACE        : Pristine 1.15x Stereo Stage | Crystal 16kHz Air");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 23 ? (
      // 23. HEAVING. (carsick / Grungegaze)
      slider8  = 0;     // British VCA
      slider9  = max(-24.0, min(-10.0, c_rms_db + 1.5));
      slider10 = 2;     // 4:1 Ratio (wall of fuzz glue)
      slider11 = 10.0;  // 10ms fast crunch attack
      slider12 = 0;
      slider13 = 110.0;
      slider14 = 1.3;
      slider34 = 1.0;
      slider35 = 1.4;   // +1.4dB Drum Tail / Room Wash
      slider28 = 1;
      slider29 = 2500;
      slider41 = 0.4;
      slider30 = 1;
      slider31 = 195;
      slider17 = -2.8;  // -2.8dB Mud Scoop at 320Hz
      slider18 = 320;
      slider21 = 2.2;   // +2.2dB Pentode Overdrive
      slider22 = 1;
      slider7  = 1.10;
      slider6  = 100;
      ai_status_l1 = sprintf(#, "ADAM CICHOCKI (heaving.): Saturated Wall of Fuzz & Room Wash Slam (+2.2dB Drive)");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "FUZZ GLUE    : 4:1 VCA Crunch | 110Hz SC HPF | Heavy Tape Warmth");
      ai_status_l4 = sprintf(#, "EMBEDDED VOX : -2.2dB @ 2.5kHz Donut Hole | Ambient Bloom");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : p_idx == 24 ? (
      // 24. MANUEL RENNER (SENNA - Out Of The Blue / Überlärm Studios)
      slider8  = 0;     // British VCA Glue
      slider9  = max(-24.0, min(-12.0, c_rms_db + 2.0));
      slider10 = 2;     // 4:1 Ratio
      slider11 = 30.0;  // 30ms Attack
      slider12 = 0;     // Auto Release
      slider13 = 120.0; // 120Hz SC HPF Detector
      slider14 = 1.3;
      slider34 = 1.6;   // +1.6dB Snare & Kick Transient Snap
      slider35 = 0.8;
      slider28 = 1;
      slider29 = 2600;  // 2.6kHz Vocal Pocket Notch
      slider41 = 0.8;
      slider30 = 1;
      slider31 = 185;
      slider17 = -3.2;  // -3.2dB Mud Scoop @ 280Hz
      slider18 = 280;
      slider21 = 1.8;   // +1.8dB Discrete Desk Drive
      slider22 = 1;
      slider7  = 1.15;  // 115% Stereo Width
      slider6  = 100;
      ai_status_l1 = sprintf(#, "SENNA IMPACT: Hyper-Modern German Metalcore Punch & Polished Clarity");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "VCA GLUE     : 4:1 Ratio | 30ms Att / Auto Rel | 120Hz SC HPF");
      ai_status_l4 = sprintf(#, "SUB ANCHOR   : 90Hz Mono Anchor (0.9704 Correlation) | 115%% Width");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    ) : (
      // 0. DEFAULT MODERN METAL CLEAN (2026 Clarity & Punch)
      slider8  = 0;     // British VCA
      slider9  = max(-24.0, min(-12.0, c_rms_db + 2.5));
      slider10 = 1;     // 2:1 Ratio
      slider11 = 30.0;
      slider12 = 0;
      slider13 = 125.0;
      slider14 = 1.2;
      slider34 = 1.3;
      slider28 = 1;
      slider29 = 2800;
      slider41 = 1.0;
      slider30 = 1;
      slider31 = 190;
      slider17 = -2.5;
      slider18 = 340;
      slider21 = 1.2;
      slider22 = 1;
      slider7  = 1.14;
      slider6  = 100;
      ai_status_l1 = sprintf(#, "CLEAN 2026 IMPACT: Balanced Chorus Lift & Mud Clearance");
      ai_status_l2 = sprintf(#, "CHORUS LIFT  : +%.1fdB (V:%.1f -> C:%.1f dBFS)", dyn_lift, v_rms_db, c_rms_db);
      ai_status_l3 = sprintf(#, "BUS GLUE     : Thresh %.1fdB | 2:1 VCA | 125Hz SC HPF", slider9);
      ai_status_l4 = sprintf(#, "VOCAL CUT    : 2.8k Donut Notch | +1.0dB Vocal Lift");
      ai_status_l5 = sprintf(#, "HEADROOM CAL : Strict -6.0 dBTP Pre-Master Locked");
    );

    // Guaranteed Pre-Master Headroom Lock (-6.0 dBTP)
    slider4 = 1; // Strict -6.0 dBTP ceiling lock
    slider3 = -6.0;
    cur_true_peak > -75.0 ? (
      slider5 = max(-18.0, min(1.0, -6.0 - cur_true_peak));
    ) : (
      slider5 = 0.0;
    );
  ) : (
    calibrate_to_project(p_idx);
  );

  update_mix_filters();
  slider_automate();
);

// -----------------------------------------------------------------------------
// PROJECT STATE BUS (gmem 1000-1039, DameiMixMetering) - read-only awareness layer.
// Mixing Suite reads every suite block (Drum 820, Guitar 840, Bass 860, Vocal 880,
// Devastator 900-939, Synth 920) and republishes one consolidated state vector that
// any suite (or the Lua relay feeding the Mastering Suite) can read. No audio impact.
// -----------------------------------------------------------------------------
function publish_project_state() (
  pb_dr = (gmem[820] == 1); pb_gt = (gmem[840] == 1); pb_bs = (gmem[860] == 1);
  pb_vx = (gmem[880] == 1); pb_sy = (gmem[920] == 1); pb_dv = (gmem[900] == 1);
  pb_in = (gmem[960] == 1);
  gmem[1000] = 1;
  gmem[1001] = 1 + pb_dr + pb_gt + pb_bs + pb_vx + pb_sy + pb_dv + pb_in;
  gmem[1002] = pb_dr; gmem[1003] = pb_gt; gmem[1004] = pb_bs;
  gmem[1005] = pb_vx; gmem[1006] = pb_sy; gmem[1007] = pb_dv;
  gmem[1040] = pb_in;
  gmem[1008] = slider39;
  gmem[1009] = pb_dv ? gmem[901] : -1;
  // Producer coherence: Devastator blueprint vs Mixing preset (1 match, 0 mismatch, -1 n/a)
  pb_dvp = gmem[901];
  pb_map = pb_dvp == 0 ? 7 : pb_dvp == 1 ? -1 : pb_dvp == 2 ? -1 : pb_dvp == 3 ? 18 : pb_dvp == 4 ? 4 : pb_dvp == 5 ? 19 : pb_dvp == 6 ? 1 : 15;
  gmem[1010] = !pb_dv ? -1 : (pb_map < 0 ? -1 : (pb_map == slider39 ? 1 : 0));
  gmem[1011] = pb_dr ? gmem[823] : -90;
  gmem[1012] = pb_gt ? gmem[843] : -90;
  gmem[1013] = pb_bs ? gmem[863] : -90;
  gmem[1014] = pb_vx ? gmem[883] : -90;
  gmem[1015] = pb_sy ? gmem[923] : -90;
  gmem[1016] = pb_dv ? gmem[903] : -90;
  gmem[1017] = cur_vu_rms; gmem[1018] = cur_out_true_peak; gmem[1019] = cur_crest;
  gmem[1020] = tb_pct_low; gmem[1021] = tb_pct_lmid; gmem[1022] = tb_pct_hmid; gmem[1023] = tb_pct_high;
  gmem[1024] = struct_state;
  gmem[1025] = pb_dv ? gmem[907] : 0;
  gmem[1026] = pb_dv ? gmem[910] : 0;
  gmem[1027] = pb_dv ? gmem[912] : 0;
  gmem[1028] = pb_dv ? gmem[913] : 0;
  gmem[1029] = pb_dv ? gmem[914] : 0;
  gmem[1030] = pb_dv ? gmem[930] : 0;
  gmem[1031] = pb_dv ? gmem[919] : 100;
  gmem[1032] = pb_dv ? gmem[918] : 1.0;
  gmem[1033] = pb_dv ? gmem[917] : 0;
  gmem[1034] = -1.0 - cur_out_true_peak;
  gmem[1035] = max(0.0, tb_pct_lmid - 30.0);
  gmem[1036] = (pb_vx && pb_gt && gmem[843] > -22.0) ? 1 : 0;
  gmem[1037] = (gmem[1034] > 2.0 && gmem[1035] < 6.0) ? 1 : 0;
  pb_hb += 1;
  gmem[1039] = pb_hb;
);

@slider
slider2 ? (
  slider2 = 0;
  calibrate_to_project(slider39);
);
slider39 != prev_preset ? (
  prev_preset = slider39;
  apply_mix_preset(slider39);
  slider_automate();
);
update_mix_filters();

@sample
s_in_l = spl0;
s_in_r = spl1;

// =============================================================================
// 0. SONG STRUCTURE & CHORUS IMPACT AI ENGINE
// =============================================================================
slider44 > 0 ? (
  slow_rms_c = exp(-1.0 / (6.0 * srate));
  struct_slow_rms = struct_slow_rms * slow_rms_c + cur_rms * (1.0 - slow_rms_c);

  fast_rms_c = exp(-1.0 / (0.35 * srate));
  struct_fast_rms = struct_fast_rms * fast_rms_c + cur_rms * (1.0 - fast_rms_c);

  struct_hi_nrg = struct_hi_nrg * 0.9998 + tb_pct_high * 0.0002;

  gmem_active = (gmem[100] == 1);
  g_sec_id = gmem_active ? gmem[101] : 0;
  g_to_chorus = gmem_active ? gmem[102] : -1.0;
  g_num_regions = gmem_active ? gmem[103] : 0;
  g_cur_rgn = gmem_active ? gmem[104] : 0;
  g_rgn_prog = gmem_active ? gmem[105] : 0.0;
  g_rgn_type = gmem_active ? gmem[106] : 0;
  g_is_playing = gmem_active ? gmem[107] : 0;
  g_rgn_time_left = gmem_active ? gmem[108] : 0.0;

  use_regions = (slider45 == 1 && gmem_active) || 
                (slider45 == 0 && gmem_active && (g_sec_id > 0 || (g_to_chorus > 0.0 && g_to_chorus < 8.0)));

  use_regions ? (
    g_sec_id == 3 ? (
      struct_state = 3;
    ) : g_sec_id == 2 ? (
      struct_state = 2;
    ) : (g_sec_id == 1 || (g_to_chorus > 0.0 && g_to_chorus < 5.0)) ? (
      struct_state = 1;
    ) : g_sec_id == 4 ? (
      struct_state = 4;
    ) : g_sec_id == 5 ? (
      struct_state = 5;
    ) : (
      struct_state = 0;
    );
  ) : (
    delta_nrg = struct_fast_rms - struct_slow_rms;
    is_building = (delta_nrg > 1.2 && delta_nrg < 3.2 && tb_pct_high > struct_hi_nrg * 1.15);
    is_breath = (is_building && (tb_pct_low < 35.0 || cur_crest > 12.0));
    is_chorus_impact = (delta_nrg >= 2.5 && tb_pct_low >= 45.0 && cur_rms > -40.0);

    is_chorus_impact ? (
      struct_state = 3;
      chorus_hold_timer = srate * 16.0;
    ) : chorus_hold_timer > 0 ? (
      chorus_hold_timer -= 1;
      struct_state = 3;
    ) : is_breath ? (
      struct_state = 2;
    ) : is_building ? (
      struct_state = 1;
    ) : delta_nrg < -3.5 ? (
      struct_state = 4;
    ) : (
      struct_state = 0;
    );
  );

  proj_dyn_factor = (dyn_lift > 0.5) ? max(0.75, min(1.35, dyn_lift / 3.0)) : 1.0;
  scale_mult = (slider44 == 1 ? 1.0 : (slider44 == 2 ? 1.5 : 0.6)) * proj_dyn_factor;
  p_idx = slider39; // Active Mixing Producer Signature Preset (0 to 13)

  struct_state == 3 ? (
    // ⚡ CHORUS IMPACT: All 14 Producers
    p_idx == 0 ? ( // Default Modern Metal Clean (2026 Clarity & Punch)
      target_width_boost =  0.10 * scale_mult;
      target_punch_boost =  0.80 * scale_mult;
      target_drive_boost =  0.30 * scale_mult;
      target_vocal_boost =  0.50 * scale_mult;
      struct_status_str = "CHORUS IMPACT // BALANCED EXPLOSION ACTIVE";
    ) : p_idx == 1 ? ( // Lance Prenc (Stereo Guitar Wall & Snare Crack)
      target_width_boost =  0.14 * scale_mult;
      target_punch_boost =  1.20 * scale_mult;
      target_drive_boost =  0.50 * scale_mult;
      target_vocal_boost =  0.80 * scale_mult;
      struct_status_str = "CHORUS IMPACT // PRENC GUITAR WALL & SNARE CRACK";
    ) : p_idx == 2 ? ( // Scott Seigel (Nu-Metal Slam & Sub Punch)
      target_width_boost =  0.12 * scale_mult;
      target_punch_boost =  1.00 * scale_mult;
      target_drive_boost =  0.40 * scale_mult;
      target_vocal_boost =  0.60 * scale_mult;
      struct_status_str = "CHORUS IMPACT // SEIGEL SUB SLAM ACTIVE";
    ) : p_idx == 3 ? ( // Jonathan Dolese (Pop-Metal Hook Vocal Shimmer)
      target_width_boost =  0.12 * scale_mult;
      target_punch_boost =  0.90 * scale_mult;
      target_drive_boost =  0.40 * scale_mult;
      target_vocal_boost =  1.20 * scale_mult;
      struct_status_str = "CHORUS IMPACT // DOLESE POP-METAL HOOK PRESENCE";
    ) : p_idx == 4 ? ( // Buster Odeholm (Explosive Drum Punch & High Saturation)
      target_width_boost =  0.16 * scale_mult;
      target_punch_boost =  1.60 * scale_mult;
      target_drive_boost =  0.70 * scale_mult;
      target_vocal_boost =  0.70 * scale_mult;
      struct_status_str = "CHORUS IMPACT // ODEHOLM SLAM DETONATION";
    ) : p_idx == 5 ? ( // Lewis Johns / Grant Berry (Shoegaze Organic Wall)
      target_width_boost =  0.14 * scale_mult;
      target_punch_boost =  0.60 * scale_mult;
      target_drive_boost =  0.40 * scale_mult;
      target_vocal_boost =  0.50 * scale_mult;
      struct_status_str = "CHORUS IMPACT // FADER ORGANIC WALL OF SOUND";
    ) : p_idx == 6 ? ( // Kel Pinchin & Robin Schmidt (Split Chain 90s Grunge Explosion)
      target_width_boost =  0.13 * scale_mult;
      target_punch_boost =  1.10 * scale_mult;
      target_drive_boost =  0.55 * scale_mult;
      target_vocal_boost =  0.75 * scale_mult;
      struct_status_str = "CHORUS IMPACT // SPLIT CHAIN 90S GRUNGE EXPLOSION";
    ) : p_idx == 7 ? ( // Dan Lancaster & Jason Perry / Ted Jensen (Commercial High-Impact)
      target_width_boost =  0.11 * scale_mult;
      target_punch_boost =  1.10 * scale_mult;
      target_drive_boost =  0.40 * scale_mult;
      target_vocal_boost =  1.00 * scale_mult;
      struct_status_str = "CHORUS IMPACT // LANCASTER COMMERCIAL RADIO PUNCH";
    ) : p_idx == 8 ? ( // Erik Bickerstaffe & Robin Schmidt (Static Dress Post-Hardcore Slam)
      target_width_boost =  0.12 * scale_mult;
      target_punch_boost =  1.15 * scale_mult;
      target_drive_boost =  0.50 * scale_mult;
      target_vocal_boost =  0.70 * scale_mult;
      struct_status_str = "CHORUS IMPACT // STATIC DRESS POST-HARDCORE SLAM";
    ) : p_idx == 9 ? ( // Sam Guaiana (Shyeye / Silverstein: Snare Crack & Vocal Donut Notch)
      target_width_boost =  0.15 * scale_mult;
      target_punch_boost =  1.60 * scale_mult;
      target_drive_boost =  0.45 * scale_mult;
      target_vocal_boost =  1.00 * scale_mult;
      struct_status_str = "CHORUS IMPACT // GUAIANA DETONATION & 5kHz SNARE CRACK";
    ) : p_idx == 10 ? ( // Zach Tuch & Nick Townsend (Heavenward Analog Tape Bloom)
      target_width_boost =  0.09 * scale_mult;
      target_punch_boost =  0.80 * scale_mult;
