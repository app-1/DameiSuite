  gfx_drawstr("[CD-LEVEL LUFS-I // SPOTIFY NORMALIZATION BYPASSED]");

  // Sleek 3-Row Grid for 22 Presets: 8 per row with ample width and zero collision!
  pill_cols = 8;
  pill_gap = 6;
  pill_w = floor((disp_w - 20 - pill_gap * 7) / 8);
  pill_h = 24;

  pi = 0;
  loop(22,
    p_row = floor(pi / 8);
    p_col = pi % 8;
    px = disp_x + 10 + p_col * (pill_w + pill_gap);
    py = disp_y + 32 + p_row * (pill_h + 4);
    
    ref_idx = pi;
    is_sel = (slider39 == ref_idx);
    p_hover = (mouse_x >= px && mouse_x <= px + pill_w && mouse_y >= py && mouse_y <= py + pill_h);
    
    gfx_r = is_sel ? 0.09 : (p_hover ? 0.06 : 0.035);
    gfx_g = is_sel ? 0.20 : (p_hover ? 0.10 : 0.048);
    gfx_b = is_sel ? 0.30 : (p_hover ? 0.16 : 0.068);
    gfx_rect(px, py, pill_w, pill_h);
    
    gfx_r = is_sel ? 0.00 : (p_hover ? 0.40 : 0.18);
    gfx_g = is_sel ? 0.85 : (p_hover ? 0.50 : 0.24);
    gfx_b = is_sel ? 1.00 : (p_hover ? 0.65 : 0.34);
    gfx_rect(px, py, pill_w, pill_h, 0);
    
    gfx_r = is_sel ? 1.00 : (p_hover ? 0.95 : 0.80);
    gfx_g = is_sel ? 0.85 : (p_hover ? 0.95 : 0.85);
    gfx_b = is_sel ? 0.30 : (p_hover ? 0.95 : 0.90);
    gfx_setfont(1, "Consolas", 12, 'b');
    gfx_x = px + 6; gfx_y = py + 4;
    pi == 0 ? gfx_drawstr("0: CLEAN") :
    pi == 1 ? gfx_drawstr("1: PRENC") :
    pi == 2 ? gfx_drawstr("2: SEIGEL") :
    pi == 3 ? gfx_drawstr("3: DOLESE") :
    pi == 4 ? gfx_drawstr("4: ODEHOLM") :
