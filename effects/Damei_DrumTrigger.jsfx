// ============================================================================
@serialize
  browse_request ? (
    browse_request = 0;
    active_view == 0 ? file_open(slider41) :
    active_view == 1 ? file_open(slider42) :
    active_view == 2 ? file_open(slider43) :
                       file_open(slider41);
  );

  file_var(0, slider1);
  file_var(0, slider2);
  file_var(0, slider3);
  file_var(0, slider4);
  file_var(0, slider5);
  file_var(0, slider6);
  file_var(0, slider7);
  file_var(0, slider8);
  file_var(0, slider9);
  file_var(0, slider10);

  file_var(0, slider11);
  file_var(0, slider12);
  file_var(0, slider13);
  file_var(0, slider14);
  file_var(0, slider15);
  file_var(0, slider16);

  file_var(0, slider21);
  file_var(0, slider22);
  file_var(0, slider23);
  file_var(0, slider24);
  file_var(0, slider25);
  file_var(0, slider26);

  file_var(0, slider31);
  file_var(0, slider32);
  file_var(0, slider33);
  file_var(0, slider34);
  file_var(0, slider35);
  file_var(0, slider36);

  file_var(0, slider44);
  file_var(0, slider45);
  file_var(0, slider46);
  file_var(0, slider47);

  file_var(0, slider51);
  file_var(0, slider52);
  file_var(0, slider53);
  file_var(0, slider54);
  file_var(0, slider55);
  file_var(0, slider56);
  file_var(0, slider57);
  file_var(0, slider58);
  file_var(0, slider59);

  file_var(0, slider60);
  file_var(0, slider61);
  file_var(0, slider62);

  file_string(0, #slot_path0);
  file_string(0, #slot_path1);
  file_string(0, #slot_path2);