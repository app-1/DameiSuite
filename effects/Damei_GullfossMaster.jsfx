gfx_x = btn_p_x + 9; gfx_y = ctrl_y + 55; gfx_drawstr("+");
(mouse_cap & 1) && !prev_mouse_cap && b_t_m ? (slider3 = max(0, slider3 - 2); slider_automate(););
