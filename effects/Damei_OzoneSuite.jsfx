);

// ── RIGHT HEADER CONTROLS (RESPONSIVE DYNAMIC ZERO-OVERLAP GEOMETRY) ──
right_x = w - 24;

// 1. A/B Snapshot Toggle Button
ab_w = 48;
ab_btn_x = right_x - ab_w;
