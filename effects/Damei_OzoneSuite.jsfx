// ─── 3. MODULE NAVIGATION TABS (6 ELEVATED, UN-BURIED TABS) ───
tab_y = 152;
tab_h = 36;
tab_w = (w - 32) / 7;
ti = 0;
loop(7,
  tx = 16 + ti * tab_w;
  sel = (slider2 == ti);
  t_hov = (mouse_x >= tx && mouse_x <= tx + tab_w - 4 && mouse_y >= tab_y && mouse_y <= tab_y + tab_h);
  sel ? (
    gfx_r = 0.12; gfx_g = 0.17; gfx_b = 0.25;
  ) : (
    gfx_r = t_hov ? 0.09 : 0.06; gfx_g = t_hov ? 0.11 : 0.07; gfx_b = t_hov ? 0.16 : 0.11;
  );
  gfx_rect(tx, tab_y, tab_w - 4, tab_h);
  gfx_r = 0.18; gfx_g = 0.24; gfx_b = 0.34;
  gfx_rect(tx, tab_y, tab_w - 4, tab_h, 0);

  sel ? (
    gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
    gfx_rect(tx, tab_y + tab_h - 3, tab_w - 4, 3);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    gfx_r = t_hov ? 0.90 : 0.65; gfx_g = t_hov ? 0.95 : 0.70; gfx_b = t_hov ? 1.00 : 0.80;
  );
  gfx_setfont(1, "Orbitron", 12, sel ? 'b' : 0);
  t_lbl = (ti==0 ? "Overview" : (ti==1 ? "Tonal Bal" : (ti==2 ? "Master EQ" : (ti==3 ? "Dynamics" : (ti==4 ? "Imager" : (ti==5 ? "Maximizer" : "Playbook"))))));
  gfx_measurestr(t_lbl, tw, th);
  gfx_x = tx + (tab_w - 4 - tw) * 0.5;
  gfx_y = tab_y + (tab_h - th) * 0.5;
  gfx_drawstr(t_lbl);

  mouse_clicked && t_hov && (slider2 != ti) ? (
    slider2 = ti;
    slider_automate(2);
  );
  ti += 1;
);

// ─── 4. DYNAMIC VIEWPORT & BOTTOM DOCK SIZING (PERFECTLY ELEVATED) ───
dock_h = max(124, min(156, floor(h * 0.24)));
dock_y = h - dock_h - 10;
dock_x = 16;
dock_w = w - 32;

disp_x = 16;
disp_y = 196; // 8px below tab_y + tab_h (152 + 36 = 188) — ZERO OVERLAP!
disp_w = w - 32;
disp_h = max(140, dock_y - disp_y - 8);

// Base display canvas
gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06;
gfx_rect(disp_x, disp_y, disp_w, disp_h);
gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
gfx_line(disp_x, disp_y, disp_x + disp_w, disp_y);
gfx_line(disp_x, disp_y + disp_h, disp_x + disp_w, disp_y + disp_h);

// ═════════════════════════════════════════════════════════════════════════════
// TAB 0: OVERVIEW — WEYLAND-YUTANI 2179 TACTICAL MASTERING STATION
// ═════════════════════════════════════════════════════════════════════════════
slider2 == 0 ? (
  // ── DEDICATED W-Y TACTICAL SIGNAL CHAIN HEADER RACK (HIGH CONTRAST & LEGIBILITY) ──
  rack_h = 44;
  gfx_r = 0.05; gfx_g = 0.065; gfx_b = 0.095;
  gfx_rect(disp_x, disp_y, disp_w, rack_h);
  gfx_r = 0.16; gfx_g = 0.22; gfx_b = 0.30;
  gfx_line(disp_x, disp_y + rack_h, disp_x + disp_w, disp_y + rack_h);

  // Mate Masie Sigil in Signal Rack
  draw_matemasie_sigil(disp_x + 22, disp_y + 22, 11);

  // Section Header: Orbitron Bold Cyan
  gfx_r = 0.00; gfx_g = 0.92; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = disp_x + 38; gfx_y = disp_y + 14;
  gfx_drawstr("SIGNAL FLOW");

  // 5 High-Contrast Cyber Module Badges with dark slate tiles and glowing borders
  chain_x = disp_x + 145;
  chain_avail = max(380, disp_w - 350);
  badge_w = (chain_avail - 20) / 5;
  badge_h = 30;
  badge_y = disp_y + 6;

  // Module 1: EQ
  b1_x = chain_x;
  gfx_r = 0.08; gfx_g = 0.11; gfx_b = 0.16;
  gfx_rect(b1_x, badge_y, badge_w - 12, badge_h);
  gfx_r = 0.20; gfx_g = 0.26; gfx_b = 0.36;
  gfx_rect(b1_x, badge_y, badge_w - 12, badge_h, 0);
  gfx_r = 0.10; gfx_g = 0.95; gfx_b = 0.50;
  gfx_circle(b1_x + 8, badge_y + 14, 3.0, 1);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 12, 'b');
  gfx_x = b1_x + 16; gfx_y = badge_y + 8;
  gfx_drawstr("EQ MATCH");
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = b1_x + badge_w - 10; gfx_y = badge_y + 8;
  gfx_drawstr(">");

  // Module 2: Glue Comp
  b2_x = chain_x + badge_w;
  overview_glue_gr = max(0.0, comp_gr_disp);
  gfx_r = 0.08; gfx_g = 0.11; gfx_b = 0.16;
  gfx_rect(b2_x, badge_y, badge_w - 12, badge_h);
  gfx_r = 0.20; gfx_g = 0.26; gfx_b = 0.36;
  gfx_rect(b2_x, badge_y, badge_w - 12, badge_h, 0);
  comp_gr_disp > 0.1 ? (gfx_r = 0.10; gfx_g = 0.95; gfx_b = 0.50;) : (gfx_r = 0.45; gfx_g = 0.55; gfx_b = 0.70;);
  gfx_circle(b2_x + 8, badge_y + 14, 3.0, 1);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 12, 'b');
  gfx_x = b2_x + 16; gfx_y = badge_y + 8;
  overview_glue_gr > 0.05 ? gfx_printf("GLUE -%.1fdB", overview_glue_gr) : gfx_drawstr("GLUE 2:1");
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = b2_x + badge_w - 10; gfx_y = badge_y + 8;
  gfx_drawstr(">");

  // Module 3: Multiband & Chug Guard
  b3_x = chain_x + badge_w * 2;
  gfx_r = 0.08; gfx_g = 0.11; gfx_b = 0.16;
  gfx_rect(b3_x, badge_y, badge_w - 12, badge_h);
  gfx_r = 0.20; gfx_g = 0.26; gfx_b = 0.36;
  gfx_rect(b3_x, badge_y, badge_w - 12, badge_h, 0);
  slider32 ? (gfx_r = 0.10; gfx_g = 0.95; gfx_b = 0.50;) : (gfx_r = 0.45; gfx_g = 0.55; gfx_b = 0.70;);
  gfx_circle(b3_x + 8, badge_y + 14, 3.0, 1);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 12, 'b');
  gfx_x = b3_x + 16; gfx_y = badge_y + 8;
  slider32 ? gfx_drawstr("CHUG GUARD") : gfx_drawstr("LR4 DYN");
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = b3_x + badge_w - 10; gfx_y = badge_y + 8;
  gfx_drawstr(">");

  // Module 4: Imager
  b4_x = chain_x + badge_w * 3;
  gfx_r = 0.08; gfx_g = 0.11; gfx_b = 0.16;
  gfx_rect(b4_x, badge_y, badge_w - 12, badge_h);
  gfx_r = 0.20; gfx_g = 0.26; gfx_b = 0.36;
  gfx_rect(b4_x, badge_y, badge_w - 12, badge_h, 0);
  gfx_r = 0.10; gfx_g = 0.95; gfx_b = 0.50;
  gfx_circle(b4_x + 8, badge_y + 14, 3.0, 1);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 12, 'b');
  gfx_x = b4_x + 16; gfx_y = badge_y + 8;
  gfx_printf("WIDTH %d%%", floor(slider7 * 100));
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = b4_x + badge_w - 10; gfx_y = badge_y + 8;
  gfx_drawstr(">");

  // Module 5: Maximizer / Clipper
  b5_x = chain_x + badge_w * 4;
  gfx_r = 0.08; gfx_g = 0.11; gfx_b = 0.16;
  gfx_rect(b5_x, badge_y, badge_w - 12, badge_h);
  gfx_r = 0.20; gfx_g = 0.26; gfx_b = 0.36;
  gfx_rect(b5_x, badge_y, badge_w - 12, badge_h, 0);
  gfx_r = 0.10; gfx_g = 0.95; gfx_b = 0.50;
  gfx_circle(b5_x + 8, badge_y + 14, 3.0, 1);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 12, 'b');
  gfx_x = b5_x + 16; gfx_y = badge_y + 8;
  gfx_printf("MAX %+.1fdB", slider9);

  // W-Y Tactical Console Stamp in Rack Bar (Completely Clear of Spectrum Corridor)
  stamp_w = 190;
  stamp_x = disp_x + disp_w - stamp_w - 10;
  gfx_r = 0.07; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(stamp_x, badge_y, stamp_w, badge_h);
  gfx_r = 0.18; gfx_g = 0.24; gfx_b = 0.32;
  gfx_rect(stamp_x, badge_y, stamp_w, badge_h, 0);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = stamp_x + 8; gfx_y = badge_y + 4;
  gfx_drawstr("W-Y // 2179 TACTICAL");
  gfx_r = 0.45; gfx_g = 0.55; gfx_b = 0.70;
  gfx_setfont(1, "Consolas", 10);
  gfx_x = stamp_x + 8; gfx_y = badge_y + 17;
  gfx_drawstr("AES TD1004 / -1.0dBTP");

  // Frequency Grid Boundaries (below the rack bar with clear separation)
  graph_top = disp_y + rack_h + 8;
  graph_bot = disp_y + disp_h - 38;
  graph_h   = graph_bot - graph_top;

  // Real-Time Translation Audition Diagnostic Banner (Clear Alert when Auditioning)
  slider49 > 0 ? (
    aud_h = 24;
    aud_y = graph_top + 4;
    aud_w = disp_w - 40;
    aud_x = disp_x + 20;
    gfx_r = 0.22; gfx_g = 0.14; gfx_b = 0.04;
    gfx_rect(aud_x, aud_y, aud_w, aud_h);
    gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.12;
    gfx_rect(aud_x, aud_y, aud_w, aud_h, 0);
    gfx_setfont(1, "Bahnschrift", 12, 'b');
    gfx_x = aud_x + 12; gfx_y = aud_y + 4;
    slider49 == 1 ? (
      gfx_drawstr("★ TRANSLATION AUDITION: 🚗 CAR TEST ACTIVE — Inspect 52Hz Cabin Boom & 3.8kHz Glass Harshness (Non-Destructive)");
    ) : slider49 == 2 ? (
      gfx_drawstr("★ TRANSLATION AUDITION: 📱 PHONE TEST ACTIVE — Mono Speaker (220Hz-11.5kHz). Verify vocal cut & mono phase");
    ) : slider49 == 3 ? (
      gfx_drawstr("★ TRANSLATION AUDITION: 🔊 CLUB SUB ACTIVE — 95Hz Mono Sub Check. Verify sub weight & kick punch separation");
    );
  );

  // Background Sci-Fi Grid lines
  freq_pts = 0;
  loop(5,
    f = (freq_pts == 0 ? 50 : (freq_pts == 1 ? 200 : (freq_pts == 2 ? 1000 : (freq_pts == 3 ? 5000 : 15000))));
    norm_fx = (log(f / 20.0) / log(1000.0)) * disp_w;
    gfx_r = 0.07; gfx_g = 0.09; gfx_b = 0.13;
    gfx_line(disp_x + norm_fx, graph_top, disp_x + norm_fx, graph_bot);
    gfx_r = 0.40; gfx_g = 0.46; gfx_b = 0.55;
    gfx_setfont(1, "Consolas", 14, 'b');
    gfx_x = disp_x + norm_fx + 4; gfx_y = graph_bot - 18;
    f >= 1000 ? gfx_printf("%dk", f/1000) : gfx_printf("%d", f);
    freq_pts += 1;
  );

  // Horizontal dB grid lines (-12dB, -24dB, -36dB, -48dB)
  db_line = 1;
  loop(3,
    grid_y = graph_top + (db_line / 4.0) * graph_h;
    gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.11;
    gfx_line(disp_x, grid_y, disp_x + disp_w, grid_y);
    gfx_r = 0.30; gfx_g = 0.35; gfx_b = 0.44;
    gfx_setfont(1, "Consolas", 14, 'b');
    gfx_x = disp_x + 6; gfx_y = grid_y - 14;
    gfx_printf("-%d dB", db_line * 12);
    db_line += 1;
  );

  // 1. Shaded Target Genre Corridor (Green Phosphor Glow)
  b = 0;
  loop(DISP_BINS - 1,
    bx1 = disp_x + (b / (DISP_BINS - 1)) * disp_w;
    bx2 = disp_x + ((b + 1) / (DISP_BINS - 1)) * disp_w;
    low_y1  = graph_top + (1.0 - (corridor_low[b] + 48.0) / 54.0) * graph_h;
    high_y1 = graph_top + (1.0 - (corridor_high[b] + 48.0) / 54.0) * graph_h;
    low_y2  = graph_top + (1.0 - (corridor_low[b+1] + 48.0) / 54.0) * graph_h;
    high_y2 = graph_top + (1.0 - (corridor_high[b+1] + 48.0) / 54.0) * graph_h;

    gfx_r = 0.12; gfx_g = 0.65; gfx_b = 0.35; gfx_a = 0.20;
    gfx_triangle(bx1, low_y1, bx2, low_y2, bx2, high_y2);
    gfx_triangle(bx1, low_y1, bx2, high_y2, bx1, high_y1);

    gfx_r = 0.20; gfx_g = 0.85; gfx_b = 0.45; gfx_a = 0.40;
    gfx_line(bx1, low_y1, bx2, low_y2);
    gfx_line(bx1, high_y1, bx2, high_y2);
    b += 1;
  );
  gfx_a = 1.0;

  // 2. Real-Time FFT Spectrum (Electric Cyan with Peak Hold)
  b = 0;
  loop(DISP_BINS - 1,
    bx1 = disp_x + (b / (DISP_BINS - 1)) * disp_w;
    bx2 = disp_x + ((b + 1) / (DISP_BINS - 1)) * disp_w;
    sy1 = graph_top + (1.0 - min(1.0, max(0.0, (cur_spectrum[b] + 48.0) / 54.0))) * graph_h;
    sy2 = graph_top + (1.0 - min(1.0, max(0.0, (cur_spectrum[b+1] + 48.0) / 54.0))) * graph_h;

    // Translucent Under-Spectrum Glow
    gfx_r = 0.00; gfx_g = 0.75; gfx_b = 0.90; gfx_a = 0.06;
    gfx_triangle(bx1, sy1, bx2, sy2, bx2, graph_bot);
    gfx_triangle(bx1, sy1, bx2, graph_bot, bx1, graph_bot);

    // Peak-Hold line
    py1 = graph_top + (1.0 - min(1.0, max(0.0, (peak_spectrum[b] + 48.0) / 54.0))) * graph_h;
    py2 = graph_top + (1.0 - min(1.0, max(0.0, (peak_spectrum[b+1] + 48.0) / 54.0))) * graph_h;
    gfx_r = 0.45; gfx_g = 0.90; gfx_b = 1.00; gfx_a = 0.35;
    gfx_line(bx1, py1, bx2, py2);

    // Main Live Spectrum line
    gfx_r = 0.00; gfx_g = 0.92; gfx_b = 1.00; gfx_a = 0.95;
    gfx_line(bx1, sy1, bx2, sy2);
    b += 1;
  );
  gfx_a = 1.0;

  // 3. Composite Master EQ Curve (Amber Gold)
  y0_eq = graph_top + graph_h * 0.48;
  b = 0;
  loop(DISP_BINS - 1,
    bx1 = disp_x + (b / (DISP_BINS - 1)) * disp_w;
    bx2 = disp_x + ((b + 1) / (DISP_BINS - 1)) * disp_w;
    ey1 = y0_eq - (eq_curve_buf[b] / 12.0) * (graph_h * 0.35);
    ey2 = y0_eq - (eq_curve_buf[b+1] / 12.0) * (graph_h * 0.35);
    gfx_r = 1.0; gfx_g = 0.75; gfx_b = 0.15; gfx_a = 0.85;
    gfx_line(bx1, ey1, bx2, ey2);
    b += 1;
  );
  gfx_a = 1.0;

  // (Terminal badge moved cleanly to Header Rack above graph — Zero overlap with corridor!)

  // Interactive Frequency Crosshair & HUD Readout
  is_hovering_graph = (mouse_x >= disp_x && mouse_x <= disp_x + disp_w && mouse_y >= graph_top && mouse_y <= graph_bot);
  is_hovering_graph ? (
    gfx_r = 0.45; gfx_g = 0.55; gfx_b = 0.70; gfx_a = 0.45;
    gfx_line(mouse_x, graph_top, mouse_x, graph_bot);

    hover_norm = (mouse_x - disp_x) / disp_w;
    hover_f = 20.0 * exp(log(1000.0) * hover_norm);
    hover_b = max(0, min(DISP_BINS - 1, floor(hover_norm * (DISP_BINS - 1))));

    h_cur_db = cur_spectrum[hover_b];
    h_low_db = corridor_low[hover_b];
    h_hi_db  = corridor_high[hover_b];
    h_in_corridor = (h_cur_db >= h_low_db && h_cur_db <= h_hi_db);

    hud_w = 340; hud_h = 28;
    hud_x = disp_x + disp_w - hud_w - 12;
    hud_y = graph_top + 8;
    gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; gfx_a = 0.88;
    gfx_rect(hud_x, hud_y, hud_w, hud_h);
    gfx_r = 0.20; gfx_g = 0.24; gfx_b = 0.32; gfx_a = 1.0;
    gfx_rect(hud_x, hud_y, hud_w, hud_h, 0);

    gfx_setfont(1, "Consolas", 14, 'b');
    gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
    gfx_x = hud_x + 8; gfx_y = hud_y + 5;
    hover_f >= 1000 ? gfx_printf("%.2fkHz | %.1fdB", hover_f/1000.0, h_cur_db) : gfx_printf("%dHz | %.1fdB", hover_f, h_cur_db);

    gfx_x = hud_x + 130; gfx_y = hud_y + 5;
    h_in_corridor ? (
      gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
      gfx_drawstr("| Target: OK [Balanced]");
    ) : h_cur_db > h_hi_db ? (
      gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;
      gfx_printf("| Over Target (+%.1fdB)", h_cur_db - h_hi_db);
    ) : (
      gfx_r = 0.30; gfx_g = 0.75; gfx_b = 1.00;
      gfx_printf("| Under Target (%.1fdB)", h_cur_db - h_low_db);
    );
  );

  // ── Bottom Tonal Balance Control Quick Strip with Dynamic Balance Gauges ──
  tbc_strip_y = disp_y + disp_h - 38;
  gfx_r = 0.05; gfx_g = 0.07; gfx_b = 0.10;
  gfx_rect(disp_x, tbc_strip_y, disp_w, 38);
  gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
  gfx_line(disp_x, tbc_strip_y, disp_x + disp_w, tbc_strip_y);

  b_w = disp_w / 4;
  meter_y = tbc_strip_y + 19;

  get_tbc_benchmarks();

  // Band 1: Low End
  d_low = tbc_low - bench_low;
  meter_cx = disp_x + b_w - 32;
  gfx_r = 0.12; gfx_g = 0.14; gfx_b = 0.18;
  gfx_rect(meter_cx - 20, meter_y - 2, 40, 4);
  gfx_r = 0.25; gfx_g = 0.30; gfx_b = 0.40;
  gfx_line(meter_cx, meter_y - 4, meter_cx, meter_y + 4);
  dot_ox = max(-18, min(18, d_low * 5.0));
  abs(d_low) <= 3.5 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_low > 3.5 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_circle(meter_cx + dot_ox, meter_y, 3, 1);
  gfx_r = 0.55; gfx_g = 0.65; gfx_b = 0.75;
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_x = disp_x + 10; gfx_y = tbc_strip_y + 4;
  gfx_drawstr("LOW (20-250Hz)");
  abs(d_low) <= 3.5 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_low > 3.5 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = disp_x + 10; gfx_y = tbc_strip_y + 18;
  gfx_printf("%s (%+.1fdB)", abs(d_low)<=3.5?"BALANCED":(d_low>0?"HEAVY":"LIGHT"), d_low);

  // Band 2: Lo-Mid
  d_lomid = tbc_lomid - bench_lomid;
  meter_cx2 = disp_x + b_w + b_w - 32;
  gfx_r = 0.12; gfx_g = 0.14; gfx_b = 0.18;
  gfx_rect(meter_cx2 - 20, meter_y - 2, 40, 4);
  gfx_r = 0.25; gfx_g = 0.30; gfx_b = 0.40;
  gfx_line(meter_cx2, meter_y - 4, meter_cx2, meter_y + 4);
  dot_ox2 = max(-18, min(18, d_lomid * 5.0));
  abs(d_lomid) <= 2.8 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_lomid > 2.8 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_circle(meter_cx2 + dot_ox2, meter_y, 3, 1);
  gfx_r = 0.55; gfx_g = 0.65; gfx_b = 0.75;
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_x = disp_x + b_w + 10; gfx_y = tbc_strip_y + 4;
  gfx_drawstr("LO-MID (250-2k)");
  abs(d_lomid) <= 2.8 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_lomid > 2.8 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = disp_x + b_w + 10; gfx_y = tbc_strip_y + 18;
  gfx_printf("%s (%+.1fdB)", abs(d_lomid)<=2.8?"BALANCED":(d_lomid>0?"BOX MUD":"LIGHT"), d_lomid);

  // Band 3: Hi-Mid
  d_himid = tbc_himid - bench_himid;
  meter_cx3 = disp_x + b_w * 2 + b_w - 32;
  gfx_r = 0.12; gfx_g = 0.14; gfx_b = 0.18;
  gfx_rect(meter_cx3 - 20, meter_y - 2, 40, 4);
  gfx_r = 0.25; gfx_g = 0.30; gfx_b = 0.40;
  gfx_line(meter_cx3, meter_y - 4, meter_cx3, meter_y + 4);
  dot_ox3 = max(-18, min(18, d_himid * 5.0));
  abs(d_himid) <= 2.8 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_himid > 2.8 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_circle(meter_cx3 + dot_ox3, meter_y, 3, 1);
  gfx_r = 0.55; gfx_g = 0.65; gfx_b = 0.75;
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_x = disp_x + b_w * 2 + 10; gfx_y = tbc_strip_y + 4;
  gfx_drawstr("HI-MID (2k-8k)");
  abs(d_himid) <= 2.8 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_himid > 2.8 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = disp_x + b_w * 2 + 10; gfx_y = tbc_strip_y + 18;
  gfx_printf("%s (%+.1fdB)", abs(d_himid)<=2.8?"BALANCED":(d_himid>0?"HARSH":"DULL"), d_himid);

  // Band 4: High
  d_high = tbc_high - bench_high;
  meter_cx4 = disp_x + b_w * 3 + b_w - 32;
  gfx_r = 0.12; gfx_g = 0.14; gfx_b = 0.18;
  gfx_rect(meter_cx4 - 20, meter_y - 2, 40, 4);
  gfx_r = 0.25; gfx_g = 0.30; gfx_b = 0.40;
  gfx_line(meter_cx4, meter_y - 4, meter_cx4, meter_y + 4);
  dot_ox4 = max(-18, min(18, d_high * 5.0));
  abs(d_high) <= 2.5 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_high > 2.5 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_circle(meter_cx4 + dot_ox4, meter_y, 3, 1);
  gfx_r = 0.55; gfx_g = 0.65; gfx_b = 0.75;
  gfx_setfont(1, "Consolas", 13, 'b');
  gfx_x = disp_x + b_w * 3 + 10; gfx_y = tbc_strip_y + 4;
  gfx_drawstr("AIR (8k-20k)");
  abs(d_high) <= 2.5 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) : d_high > 2.5 ? (gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.20;) : (gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;);
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = disp_x + b_w * 3 + 10; gfx_y = tbc_strip_y + 18;
  gfx_printf("%s (%+.1fdB)", abs(d_high)<=2.5?"BALANCED":(d_high>0?"BRIGHT":"DARK"), d_high);
) :
// TAB 1: TONAL BALANCE CONTROL — 4-Band Macro Corridor Workstation
// ═════════════════════════════════════════════════════════════════════════════
slider2 == 1 ? (
  gfx_r = 0.40; gfx_g = 0.45; gfx_b = 0.55;
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 12; gfx_y = disp_y + 8;
  gfx_drawstr("TONAL BALANCE CONTROL // CD TARGET (-8.5 LUFS)");

  // Top-Right Auto-Match Button
  am_h_x = disp_x + disp_w - 240; am_h_y = disp_y + 6; am_h_w = 230; am_h_h = 24;
  am_h_hover = (mouse_x >= am_h_x && mouse_x <= am_h_x + am_h_w && mouse_y >= am_h_y && mouse_y <= am_h_y + am_h_h);
  gfx_r = am_h_hover ? 0.00 : 0.08; gfx_g = am_h_hover ? 0.85 : 0.65; gfx_b = am_h_hover ? 0.50 : 0.40;
  gfx_rect(am_h_x, am_h_y, am_h_w, am_h_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  am_htxt = "★ AUTO-MATCH TONAL CORRIDOR";
  gfx_measurestr(am_htxt, amhw, amhh);
  gfx_x = am_h_x + (am_h_w - amhw) * 0.5; gfx_y = am_h_y + (am_h_h - amhh) * 0.5;
  gfx_drawstr(am_htxt);
  mouse_clicked && am_h_hover ? (
    get_tbc_benchmarks();
    d_low   = tbc_low   - bench_low;
    d_lomid = tbc_lomid - bench_lomid;
    d_himid = tbc_himid - bench_himid;
    d_high  = tbc_high  - bench_high;
    // Calibrated auto-match: offsets trims directly so all 4 bands pull dead center into target corridor
    tbc_trim_low   = max(-6.0, min(6.0, tbc_trim_low   - d_low   * 0.85));
    slider35       = tbc_trim_low;
    tbc_trim_lomid = max(-6.0, min(6.0, tbc_trim_lomid - d_lomid * 0.85));
    slider36       = tbc_trim_lomid;
    tbc_trim_himid = max(-6.0, min(6.0, tbc_trim_himid - d_himid * 0.85));
    slider37       = tbc_trim_himid;
    tbc_trim_high  = max(-6.0, min(6.0, tbc_trim_high  - d_high  * 0.85));
    slider38       = tbc_trim_high;
    slider_automate(17179869184 | 34359738368 | 68719476736 | 137438953472);
    update_filters();
  );

  tbc_col_w = (disp_w - 24) / 4;
  tbc_inner_h = disp_h - 40;
  tbc_mid_y = disp_y + 36 + tbc_inner_h * 0.5;

  ci = 0;
  loop(4,
    cx = disp_x + 6 + ci * (tbc_col_w + 4);
    cy = disp_y + 34;

    // Background Lane Card
    gfx_r = 0.06; gfx_g = 0.07; gfx_b = 0.10;
    gfx_rect(cx, cy, tbc_col_w, tbc_inner_h);
    gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
    gfx_rect(cx, cy, tbc_col_w, tbc_inner_h, 0);

    b_title = (ci==0 ? "LOW END" : (ci==1 ? "LOW-MID" : (ci==2 ? "HIGH-MID" : "HIGH END")));
    b_range = (ci==0 ? "20 - 250 Hz" : (ci==1 ? "250 - 2k Hz" : (ci==2 ? "2k - 8k Hz" : "8k - 20k Hz")));
    b_desc  = (ci==0 ? "Sub & Bass Body" : (ci==1 ? "Warmth / Boxiness" : (ci==2 ? "Vocal Presence & Clarity" : "Air Sheen & Brilliance")));

    get_tbc_benchmarks();
    delta = (ci==0 ? (tbc_low - bench_low) : (ci==1 ? (tbc_lomid - bench_lomid) : (ci==2 ? (tbc_himid - bench_himid) : (tbc_high - bench_high))));
    tol = (ci==0 ? 3.5 : (ci==1 ? 2.8 : (ci==2 ? 2.8 : 4.0)));

    // Target Corridor Box (Shaded Green/Cyan Window)
    corr_half = (tol / 8.0) * (tbc_inner_h * 0.38);
    gfx_r = 0.04; gfx_g = 0.18; gfx_b = 0.14;
    gfx_rect(cx + 10, tbc_mid_y - corr_half, tbc_col_w - 20, corr_half * 2);
    gfx_r = 0.00; gfx_g = 0.70; gfx_b = 0.50; gfx_a = 0.60;
    gfx_line(cx + 10, tbc_mid_y - corr_half, cx + tbc_col_w - 10, tbc_mid_y - corr_half);
    gfx_line(cx + 10, tbc_mid_y + corr_half, cx + tbc_col_w - 10, tbc_mid_y + corr_half);
    gfx_a = 1.0;

    // Center Benchmark Line
    gfx_r = 0.20; gfx_g = 0.30; gfx_b = 0.40;
    gfx_line(cx + 14, tbc_mid_y, cx + tbc_col_w - 14, tbc_mid_y);

    // Dynamic Live Energy Bar & Needle
    needle_y = tbc_mid_y - (delta / 8.0) * (tbc_inner_h * 0.38);
    needle_y = max(cy + 42, min(cy + tbc_inner_h - 32, needle_y));

    in_target = abs(delta) <= tol;
    in_target ? (
      gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
    ) : delta > tol ? (
      gfx_r = 0.95; gfx_g = 0.70; gfx_b = 0.15;
    ) : (
      gfx_r = 0.00; gfx_g = 0.80; gfx_b = 1.00;
    );

    // Glowing Needle Marker
    gfx_rect(cx + 12, needle_y - 3, tbc_col_w - 24, 7);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    gfx_rect(cx + 16, needle_y - 1, tbc_col_w - 32, 3);

    // Header Text
    gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
    gfx_setfont(1, "Orbitron", 17, 'b');
    gfx_x = cx + 12; gfx_y = cy + 8;
    gfx_drawstr(b_title);

    gfx_r = 0.55; gfx_g = 0.60; gfx_b = 0.70;
    gfx_setfont(1, "Bahnschrift", 14);
    gfx_x = cx + 12; gfx_y = cy + 26;
    gfx_drawstr(b_range);

    // Status Badge at bottom of lane
    in_target ? (
      gfx_r = 0.08; gfx_g = 0.25; gfx_b = 0.15;
      gfx_rect(cx + 10, cy + tbc_inner_h - 26, tbc_col_w - 20, 20);
      gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
      gfx_setfont(1, "Bahnschrift", 14, 'b');
      st_txt = "★ BALANCED";
    ) : delta > tol ? (
      gfx_r = 0.25; gfx_g = 0.18; gfx_b = 0.05;
      gfx_rect(cx + 10, cy + tbc_inner_h - 26, tbc_col_w - 20, 20);
      gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
      gfx_setfont(1, "Bahnschrift", 14, 'b');
      st_txt = "▲ HEAVY";
    ) : (
      gfx_r = 0.06; gfx_g = 0.16; gfx_b = 0.25;
      gfx_rect(cx + 10, cy + tbc_inner_h - 26, tbc_col_w - 20, 20);
      gfx_r = 0.20; gfx_g = 0.85; gfx_b = 1.00;
      gfx_setfont(1, "Bahnschrift", 14, 'b');
      st_txt = "▼ LIGHT";
    );
    gfx_measurestr(st_txt, sw, sh);
    gfx_x = cx + (tbc_col_w - sw) * 0.5; gfx_y = cy + tbc_inner_h - 23;
    gfx_drawstr(st_txt);

    // Delta Value Label
    gfx_r = 0.80; gfx_g = 0.85; gfx_b = 0.95;
    gfx_setfont(1, "Consolas", 15, 'b');
    d_str = sprintf(#, "%+.1f dB", delta);
    gfx_measurestr(d_str, dw, dh);
    gfx_x = cx + tbc_col_w - dw - 12; gfx_y = cy + 8;
    gfx_drawstr(d_str);

    ci += 1;
  );
) :

// ═════════════════════════════════════════════════════════════════════════════
// TAB 2: MASTER EQ — Parametric Biquad Curve + Draggable Nodes + Live RTA
// ═════════════════════════════════════════════════════════════════════════════
slider2 == 2 ? (
  gfx_r = 0.40; gfx_g = 0.45; gfx_b = 0.55;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = disp_x + 12; gfx_y = disp_y + 8;
  gfx_drawstr("5-BAND MASTERING EQUALIZER (DRAG NODES TO SHAPE ORGANIC BALANCE)");

  // Frequency Grid
  freq_pts = 0;
  loop(5,
    f = (freq_pts == 0 ? 50 : (freq_pts == 1 ? 200 : (freq_pts == 2 ? 1000 : (freq_pts == 3 ? 5000 : 15000))));
    norm_fx = (log(f / 20.0) / log(1000.0)) * disp_w;
    gfx_r = 0.09; gfx_g = 0.11; gfx_b = 0.15;
    gfx_line(disp_x + norm_fx, disp_y, disp_x + norm_fx, disp_y + disp_h);
    gfx_r = 0.45; gfx_g = 0.50; gfx_b = 0.60;
    gfx_setfont(1, "Consolas", 14, 'b');
    gfx_x = disp_x + norm_fx + 4; gfx_y = disp_y + disp_h - 18;
    f >= 1000 ? gfx_printf("%dk", f/1000) : gfx_printf("%d", f);
    freq_pts += 1;
  );

  // 0 dB Baseline & +/-6 dB Grids
  y0_eq = disp_y + disp_h * 0.5;
  gfx_r = 0.18; gfx_g = 0.20; gfx_b = 0.28;
  gfx_line(disp_x, y0_eq, disp_x + disp_w, y0_eq);
  gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14;
  gfx_line(disp_x, y0_eq - (disp_h * 0.42 * 0.5), disp_x + disp_w, y0_eq - (disp_h * 0.42 * 0.5));
  gfx_line(disp_x, y0_eq + (disp_h * 0.42 * 0.5), disp_x + disp_w, y0_eq + (disp_h * 0.42 * 0.5));

  // Live FFT Spectrum Behind EQ Curve
  b = 0;
  loop(DISP_BINS - 1,
    bx1 = disp_x + (b / (DISP_BINS - 1)) * disp_w;
    bx2 = disp_x + ((b + 1) / (DISP_BINS - 1)) * disp_w;
    sy1 = disp_y + (1.0 - min(1.0, max(0.0, (cur_spectrum[b] + 54.0) / 66.0))) * disp_h;
    sy2 = disp_y + (1.0 - min(1.0, max(0.0, (cur_spectrum[b+1] + 54.0) / 66.0))) * disp_h;
    gfx_r = 0.00; gfx_g = 0.45; gfx_b = 0.65; gfx_a = 0.45;
    gfx_line(bx1, sy1, bx2, sy2);
    b += 1;
  );
  gfx_a = 1.0;

  // Composite EQ Response Curve
  b = 0;
  loop(DISP_BINS - 1,
    bx1 = disp_x + (b / (DISP_BINS - 1)) * disp_w;
    bx2 = disp_x + ((b + 1) / (DISP_BINS - 1)) * disp_w;
    ey1 = y0_eq - (eq_curve_buf[b] / 12.0) * (disp_h * 0.42);
    ey2 = y0_eq - (eq_curve_buf[b+1] / 12.0) * (disp_h * 0.42);
    gfx_r = 1.0; gfx_g = 0.75; gfx_b = 0.15;
    gfx_line(bx1, ey1, bx2, ey2);
    b += 1;
  );

  // EQ Draggable Nodes
  n1_x = disp_x + (log(eq_hp_f / 20.0) / log(1000.0)) * disp_w;
  n1_y = y0_eq - (-3.0 / 12.0) * (disp_h * 0.42);

  n2_x = disp_x + (log(eq_b2_f / 20.0) / log(1000.0)) * disp_w;
  n2_y = y0_eq - (eq_b2_g / 12.0) * (disp_h * 0.42);

  n3_x = disp_x + (log(eq_b3_f / 20.0) / log(1000.0)) * disp_w;
  n3_y = y0_eq - (eq_b3_g / 12.0) * (disp_h * 0.42);

  n4_x = disp_x + (log(eq_b4_f / 20.0) / log(1000.0)) * disp_w;
  n4_y = y0_eq - (eq_b4_g / 12.0) * (disp_h * 0.42);

  mouse_down && eq_drag == 0 ? (
    sqrt((mouse_x - n1_x)^2 + (mouse_y - n1_y)^2) < 26 ? eq_drag = 1 :
    sqrt((mouse_x - n2_x)^2 + (mouse_y - n2_y)^2) < 26 ? eq_drag = 2 :
    sqrt((mouse_x - n3_x)^2 + (mouse_y - n3_y)^2) < 26 ? eq_drag = 3 :
    sqrt((mouse_x - n4_x)^2 + (mouse_y - n4_y)^2) < 26 ? eq_drag = 4 :
    0;
  );
  !mouse_down ? eq_drag = 0;

  eq_drag > 0 ? (
    mf = 20.0 * exp(log(1000.0) * max(0.0, min(1.0, (mouse_x - disp_x) / disp_w)));
    mg = -(mouse_y - y0_eq) / (disp_h * 0.42) * 12.0;
    mg = max(-12.0, min(12.0, mg));

    eq_drag == 1 ? (
      eq_hp_f = max(20.0, min(100.0, mf));
      update_filters();
    ) : eq_drag == 2 ? (
      eq_b2_f = max(80.0, min(1200.0, mf));
      eq_b2_g = mg;
      update_filters();
    ) : eq_drag == 3 ? (
      eq_b3_f = max(1200.0, min(8000.0, mf));
      eq_b3_g = mg;
      update_filters();
    ) : eq_drag == 4 ? (
      eq_b4_f = max(6000.0, min(18000.0, mf));
      eq_b4_g = mg;
      update_filters();
    );
  );

  // Node 1: HPF
  gfx_r = 1.0; gfx_g = 0.50; gfx_b = 0.10;
  gfx_circle(n1_x, n1_y, 9, 1);
  gfx_circle(n1_x, n1_y, 14, 0);
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = n1_x - 28; gfx_y = n1_y - 24;
  gfx_printf("HPF %.0fHz", eq_hp_f);

  // Node 2: Low-Mid Scoop
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_circle(n2_x, n2_y, 10, 1);
  gfx_circle(n2_x, n2_y, 15, 0);
  gfx_x = n2_x - 30; gfx_y = n2_y - 24;
  gfx_printf("%.0fHz %+.1fdB", eq_b2_f, eq_b2_g);

  // Node 3: Organic Vocal Presence
  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
  gfx_circle(n3_x, n3_y, 10, 1);
  gfx_circle(n3_x, n3_y, 15, 0);
  gfx_x = n3_x - 30; gfx_y = n3_y - 24;
  gfx_printf("%.1fkHz %+.1fdB", eq_b3_f/1000, eq_b3_g);

  // Node 4: High Air Sheen
  gfx_r = 0.85; gfx_g = 0.40; gfx_b = 1.00;
  gfx_circle(n4_x, n4_y, 10, 1);
  gfx_circle(n4_x, n4_y, 15, 0);
  gfx_x = n4_x - 30; gfx_y = n4_y - 24;
  gfx_printf("%.1fkHz %+.1fdB", eq_b4_f/1000, eq_b4_g);
) :

// ═════════════════════════════════════════════════════════════════════════════
// TAB 3: DYNAMICS — BUSTERse / H4K SSL 4000 VCA Glue Bus Compressor & Multiband Station
// ═════════════════════════════════════════════════════════════════════════════
slider2 == 3 ? (
  gfx_r = 0.40; gfx_g = 0.45; gfx_b = 0.55;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 12; gfx_y = disp_y + 8;
  gfx_setfont(1, "Orbitron", 16, 'b');
  gfx_drawstr("SSL 4000 G-BUS COMPRESSOR & 4-BAND MULTIBAND DYNAMICS");

  vu_w = (disp_w - 24) * 0.54;
  mb_w = (disp_w - 24) * 0.46;
  inner_h = disp_h - 40;

  // ── LEFT: VINTAGE ANALOG CONSOLE VU GAIN REDUCTION METER ──
  vu_x = disp_x + 6;
  vu_y = disp_y + 34;

  // Outer Console Chassis Frame (Brushed Obsidian & Double Bevel)
  gfx_r = 0.040; gfx_g = 0.048; gfx_b = 0.062;
  gfx_rect(vu_x, vu_y, vu_w, inner_h);
  gfx_r = 0.14; gfx_g = 0.17; gfx_b = 0.22;
  gfx_rect(vu_x, vu_y, vu_w, inner_h, 0);

  // Meter Window (Warm Console Amber / Cream Face)
  // Dedicated 36px bottom margin for digital telemetry bezel (STRICTLY CONFINED)
  mw_x = vu_x + 10; mw_y = vu_y + 10;
  mw_w = vu_w - 20; mw_h = inner_h - 44;
  gfx_r = 0.025; gfx_g = 0.030; gfx_b = 0.040;
  gfx_rect(mw_x, mw_y, mw_w, mw_h);
  gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.28;
  gfx_rect(mw_x, mw_y, mw_w, mw_h, 0);

  // Inner warm amber-parchment dial face
  gfx_r = 0.085; gfx_g = 0.080; gfx_b = 0.065;
  gfx_rect(mw_x + 3, mw_y + 3, mw_w - 6, mw_h - 6);
  gfx_r = 0.14; gfx_g = 0.12; gfx_b = 0.09;
  gfx_rect(mw_x + 3, mw_y + 3, mw_w - 6, mw_h - 6, 0);

  // Header Console Plate
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = mw_x + 12; gfx_y = mw_y + 8;
  gfx_drawstr("SSL 4000 G-BUS COMPRESSOR");

  gfx_r = 0.70; gfx_g = 0.65; gfx_b = 0.50;
  gfx_setfont(1, "Consolas", 11, 'b');
  gfx_x = mw_x + 12; gfx_y = mw_y + 24;
  gfx_drawstr("HQ-RNET H4K / BUSTERse VCA MODEL");

  // Center Arc Title: GAIN REDUCTION dB
  gfx_setfont(1, "Consolas", 12, 'b');
  gfx_r = 0.80; gfx_g = 0.75; gfx_b = 0.60;
  lbl_gr = "GAIN REDUCTION dB";
  gfx_measurestr(lbl_gr, gr_w, gr_h);
  pivot_x = mw_x + mw_w * 0.5;
  gfx_x = pivot_x - gr_w * 0.5; gfx_y = mw_y + 38;
  gfx_drawstr(lbl_gr);

  // Arched Meter Scale: Pivot strictly enclosed inside dial plate (20px above bottom edge)
  pivot_y = mw_y + mw_h - 20;
  arc_r = floor(mw_h * 0.60);
  ang_min = -0.58;
  ang_max = 0.58;
  ang_4db = ang_min + (4.0 / 20.0) * (ang_max - ang_min);

  // Arc Scale & Ticks for Gain Reduction: 0dB to 20dB
  a_step = 0.015;
  a_curr = ang_min;
  // Arc 1: 0..4 dB Compression (Cream Gold)
  gfx_r = 0.85; gfx_g = 0.82; gfx_b = 0.70; gfx_a = 0.90;
  loop(floor((ang_4db - ang_min) / a_step),
    x1 = pivot_x + sin(a_curr) * arc_r;
    y1 = pivot_y - cos(a_curr) * arc_r;
    x2 = pivot_x + sin(a_curr + a_step) * arc_r;
    y2 = pivot_y - cos(a_curr + a_step) * arc_r;
    gfx_line(x1, y1, x2, y2);
    gfx_line(x1, y1 - 1, x2, y2 - 1);
    a_curr += a_step;
  );
  // Arc 2: 4..20 dB Warning Sector (Crimson Red)
  gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.20; gfx_a = 1.00;
  loop(floor((ang_max - a_curr) / a_step) + 1,
    x1 = pivot_x + sin(a_curr) * arc_r;
    y1 = pivot_y - cos(a_curr) * arc_r;
    x2 = pivot_x + sin(min(ang_max, a_curr + a_step)) * arc_r;
    y2 = pivot_y - cos(min(ang_max, a_curr + a_step)) * arc_r;
    gfx_line(x1, y1, x2, y2);
    gfx_line(x1, y1 - 1, x2, y2 - 1);
    a_curr += a_step;
  );
  gfx_a = 1.0;

  // Radial Major Ticks & Labels: 0, 1, 2, 3, 4, 6, 8, 10, 15, 20
  gfx_setfont(1, "Consolas", 12, 'b');
  tick_i = 0;
  loop(10,
    tk_db = (tick_i==0?0:(tick_i==1?1:(tick_i==2?2:(tick_i==3?3:(tick_i==4?4:(tick_i==5?6:(tick_i==6?8:(tick_i==7?10:(tick_i==8?15:20)))))))));
    ang = ang_min + (tk_db / 20.0) * (ang_max - ang_min);
    tk_db >= 4.0 ? (gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.20;) : (gfx_r = 0.85; gfx_g = 0.82; gfx_b = 0.70;);
    tx1 = pivot_x + sin(ang) * (arc_r - 10);
    ty1 = pivot_y - cos(ang) * (arc_r - 10);
    tx2 = pivot_x + sin(ang) * (arc_r + 4);
    ty2 = pivot_y - cos(ang) * (arc_r + 4);
    gfx_line(tx1, ty1, tx2, ty2);
    gfx_line(tx1 + 1, ty1, tx2 + 1, ty2);

    lbl = sprintf(#, "%d", tk_db);
    gfx_measurestr(lbl, lw, lh);
    lx = pivot_x + sin(ang) * (arc_r - 18) - lw * 0.5;
    ly = pivot_y - cos(ang) * (arc_r - 18) - lh * 0.5;
    gfx_x = lx; gfx_y = ly;
    gfx_drawstr(lbl);
    tick_i += 1;
  );

  // Animated Pointer Needle for Live Gain Reduction
  clamped_needle = min(20.0, max(0.0, comp_gr_needle));
  needle_ang = ang_min + (clamped_needle / 20.0) * (ang_max - ang_min);
  nx = pivot_x + sin(needle_ang) * (arc_r + 5);
  ny = pivot_y - cos(needle_ang) * (arc_r + 5);

  // Drop shadow
  gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; gfx_a = 0.45;
  gfx_line(pivot_x + 2, pivot_y + 1, nx + 2, ny + 1);

  // Red/Orange Moving-Coil Pointer Needle
  gfx_r = 1.00; gfx_g = 0.20; gfx_b = 0.15; gfx_a = 1.0;
  gfx_line(pivot_x, pivot_y, nx, ny);
  gfx_line(pivot_x - 1, pivot_y, nx - 1, ny);
  gfx_line(pivot_x + 1, pivot_y, nx + 1, ny);

  // Luminous Pointer Tip
  gfx_r = 1.00; gfx_g = 0.70; gfx_b = 0.20;
  gfx_circle(nx, ny, 2, 1);

  // Mechanical Pivot Screw Hub (radius 10 at pivot_y, 100% inside dial window)
  gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07;
  gfx_circle(pivot_x, pivot_y, 10, 1);
  gfx_r = 0.35; gfx_g = 0.40; gfx_b = 0.48;
  gfx_circle(pivot_x, pivot_y, 10, 0);
  gfx_r = 0.60; gfx_g = 0.65; gfx_b = 0.75;
  gfx_circle(pivot_x, pivot_y, 5, 1);
  gfx_r = 0.10; gfx_g = 0.12; gfx_b = 0.15;
  gfx_line(pivot_x - 4, pivot_y, pivot_x + 4, pivot_y); // Screw slot

  // Digital Readout Plate at bottom chassis bezel (Completely separated from dial)
  telem_y = vu_y + inner_h - 30;
  gfx_r = 0.045; gfx_g = 0.055; gfx_b = 0.075;
  gfx_rect(vu_x + 10, telem_y, vu_w - 20, 24);
  gfx_r = 0.15; gfx_g = 0.20; gfx_b = 0.28;
  gfx_rect(vu_x + 10, telem_y, vu_w - 20, 24, 0);

  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gr_str = sprintf(#, "GR: -%.2f dB", comp_gr_disp);
  gfx_measurestr(gr_str, gw, gh);
  gfx_x = vu_x + 18; gfx_y = telem_y + 4;
  gfx_drawstr(gr_str);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Consolas", 12, 'b');
  t_info = sprintf(#, "HPF %dHz | ATT %.0fms | %s", sc_hpf_f, comp_attack, comp_release<=0?"AUTO":"FIXED");
  gfx_measurestr(t_info, tiw, tih);
  gfx_x = vu_x + vu_w - tiw - 18; gfx_y = telem_y + 5;
  gfx_drawstr(t_info);
  // ── RIGHT: 4-BAND MULTIBAND DYNAMICS MONITOR & METERS ──
  mb_x = vu_x + vu_w + 8;
  col_w = (mb_w - 24) / 4;
  bi = 0;
  loop(4,
    bx = mb_x + bi * (col_w + 6);
    by = vu_y;
    bw = col_w;
    bh = inner_h;

    gfx_r = 0.06; gfx_g = 0.07; gfx_b = 0.10;
    gfx_rect(bx, by, bw, bh);
    gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
    gfx_rect(bx, by, bw, bh, 0);

    b_name = (bi==0 ? "SUB" : (bi==1 ? "LO-MID" : (bi==2 ? "HI-MID" : "HIGH")));
    gr_val = (bi==0 ? mb_gr1 : (bi==1 ? mb_gr2 : (bi==2 ? mb_gr3 : mb_gr4)));
    th_val = (bi==0 ? mb_th1 : (bi==1 ? mb_th2 : (bi==2 ? mb_th3 : mb_th4)));
    in_db  = (bi==0 ? in1_db : (bi==1 ? in2_db : (bi==2 ? in3_db : in4_db)));

    // Header Band Name & Threshold
    gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
    gfx_setfont(1, "Bahnschrift", 15, 'b');
    gfx_x = bx + 6; gfx_y = by + 8;
    gfx_drawstr(b_name);

    gfx_r = 0.55; gfx_g = 0.60; gfx_b = 0.70;
    gfx_setfont(1, "Consolas", 14, 'b');
    gfx_x = bx + 6; gfx_y = by + 26;
    gfx_printf("Th: %.0fdB", th_val);

    // Dual Meter Frame: Left = Input Level (Cyan), Right = Gain Reduction (Amber Drop)
    m_h = bh - 86;
    m_y = by + 44;
    mw = (bw - 16) * 0.46;

    // Background meter troughs
    gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06;
    gfx_rect(bx + 6, m_y, mw, m_h);
    gfx_rect(bx + 10 + mw, m_y, mw, m_h);

    // 1. Live Input Energy Bar (bouncing up from bottom)
    in_pct = min(1.0, max(0.0, (in_db + 45.0) / 45.0));
    bar_h = m_h * in_pct;
    in_pct > 0.01 ? (
      gfx_r = 0.00; gfx_g = 0.80; gfx_b = 0.95;
      gfx_rect(bx + 6, m_y + m_h - bar_h, mw, bar_h);
    );

    // 2. Live Gain Reduction Bar (dropping down from top)
    gr_pct = min(1.0, max(0.0, gr_val / 3.0));
    gr_h = m_h * gr_pct;
    gr_pct > 0.01 ? (
      gfx_r = 1.00; gfx_g = 0.60; gfx_b = 0.15;
      gfx_rect(bx + 10 + mw, m_y, mw, gr_h);
    );

    // 3. Horizontal Threshold Marker
    th_pct = min(1.0, max(0.0, (th_val + 45.0) / 45.0));
    th_y = m_y + m_h - (m_h * th_pct);
    gfx_r = 0.95; gfx_g = 0.35; gfx_b = 0.30;
    gfx_line(bx + 4, th_y, bx + 8 + mw, th_y);

    // Readout values
    gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
    gfx_setfont(1, "Consolas", 14, 'b');
    gfx_x = bx + 6; gfx_y = by + bh - 46;
    gfx_printf("-%.1fdB", gr_val);

    // Solo Button
    solo_active = (bi==0 ? mb_solo1 : (bi==1 ? mb_solo2 : (bi==2 ? mb_solo3 : mb_solo4)));
    solo_btn_y = by + bh - 26;
    solo_hover = (mouse_x >= bx + 6 && mouse_x <= bx + bw - 6 && mouse_y >= solo_btn_y && mouse_y <= solo_btn_y + 20);
    gfx_r = solo_active ? 0.95 : (solo_hover ? 0.22 : 0.12);
    gfx_g = solo_active ? 0.70 : (solo_hover ? 0.26 : 0.14);
    gfx_b = solo_active ? 0.20 : (solo_hover ? 0.35 : 0.18);
    gfx_rect(bx + 6, solo_btn_y, bw - 12, 20);
    gfx_r = solo_active ? 0.05 : 0.85; gfx_g = solo_active ? 0.05 : 0.90; gfx_b = solo_active ? 0.05 : 0.95;
    gfx_setfont(1, "Bahnschrift", 14, 'b');
    gfx_x = bx + 12; gfx_y = solo_btn_y + 4;
    gfx_drawstr("SOLO");

    mouse_clicked && solo_hover ? (
      bi==0 ? mb_solo1 = !mb_solo1 :
      bi==1 ? mb_solo2 = !mb_solo2 :
      bi==2 ? mb_solo3 = !mb_solo3 :
              mb_solo4 = !mb_solo4;
    );
    bi += 1;
  );
) :

// ═════════════════════════════════════════════════════════════════════════════
// TAB 4: STEREO IMAGER — PROFESSIONAL VECTOR GONIOMETER & PHASE CORRELATION
// ═════════════════════════════════════════════════════════════════════════════
slider2 == 4 ? (
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = disp_x + 14; gfx_y = disp_y + 8;
  gfx_drawstr("STEREO IMAGER // MULTIBAND VECTOR GONIOMETER & PHASE CORRELATION");

  sc_cx = disp_x + disp_w * 0.36;
  sc_cy = disp_y + floor(disp_h * 0.55);
  sc_r  = min(sc_cx - disp_x - 32, floor(disp_h * 0.36));

  // 1. Clean Professional Circular Scope Chassis (Dark Obsidian with Precision Bevel)
  gfx_r = 0.030; gfx_g = 0.038; gfx_b = 0.050;
  gfx_circle(sc_cx, sc_cy, sc_r + 6, 1);
  gfx_r = 0.14; gfx_g = 0.18; gfx_b = 0.24;
  gfx_circle(sc_cx, sc_cy, sc_r + 6, 0);

  // Subtle Outer Calibrated Grid Ring
  gfx_r = 0.10; gfx_g = 0.13; gfx_b = 0.18;
  gfx_circle(sc_cx, sc_cy, sc_r, 0);
  gfx_circle(sc_cx, sc_cy, sc_r * 0.66, 0);
  gfx_circle(sc_cx, sc_cy, sc_r * 0.33, 0);

  // 2. Clean Standard Mastering Axes: M (Mid/Mono), S (Side/Stereo), L (+45°), R (-45°)
  d_diag = sc_r * 0.7071;
  gfx_r = 0.12; gfx_g = 0.16; gfx_b = 0.22;
  gfx_line(sc_cx - d_diag, sc_cy - d_diag, sc_cx + d_diag, sc_cy + d_diag);
  gfx_line(sc_cx - d_diag, sc_cy + d_diag, sc_cx + d_diag, sc_cy - d_diag);

  // Vertical (M / Mono) and Horizontal (S / Side) Axes
  gfx_r = 0.16; gfx_g = 0.22; gfx_b = 0.30;
  gfx_line(sc_cx, sc_cy - sc_r, sc_cx, sc_cy + sc_r);
  gfx_line(sc_cx - sc_r, sc_cy, sc_cx + sc_r, sc_cy);

  // High-Legibility Axis Markers (SAFE MARGIN: sc_cy - sc_r - 12 leaves >16px clearance below header)
  gfx_setfont(1, "Orbitron", 12, 'b');
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_x = sc_cx - 6; gfx_y = sc_cy - sc_r - 12;
  gfx_drawstr("M"); // Mid / Mono at top

  gfx_r = 0.85; gfx_g = 0.70; gfx_b = 0.20;
  gfx_x = sc_cx - d_diag - 14; gfx_y = sc_cy - d_diag - 12;
  gfx_drawstr("L"); // Left

  gfx_x = sc_cx + d_diag + 6; gfx_y = sc_cy - d_diag - 12;
  gfx_drawstr("R"); // Right

  gfx_r = 0.50; gfx_g = 0.60; gfx_b = 0.75;
  gfx_setfont(1, "Consolas", 11, 'b');
  gfx_x = sc_cx + sc_r + 6; gfx_y = sc_cy - 6;
  gfx_drawstr("+S");
  gfx_x = sc_cx - sc_r - 22; gfx_y = sc_cy - 6;
  gfx_drawstr("-S");

  // 3. Smooth Continuous Chronological Vectorscope Trace (Zero-Glitch Phosphor Stream)
  has_audio = (abs(out_l) > 0.0001 || abs(out_r) > 0.0001);
  has_audio ? (
    si = 0;
    loop(63,
      // Chronological sequence starting from scope_idx (never connects across ring boundary)
      idx1 = (scope_idx + si) % 64;
      idx2 = (scope_idx + si + 1) % 64;
      l1 = scope_buf_l[idx1]; r1 = scope_buf_r[idx1];
      l2 = scope_buf_l[idx2]; r2 = scope_buf_r[idx2];

      // M/S rotation: Mid is vertical (y), Side is horizontal (x) with width scaling
      sx1 = sc_cx + (r1 - l1) * (sc_r * 0.90 * imager_wid);
      sy1 = sc_cy - (l1 + r1) * (sc_r * 0.90);
      sx2 = sc_cx + (r2 - l2) * (sc_r * 0.90 * imager_wid);
      sy2 = sc_cy - (l2 + r2) * (sc_r * 0.90);

      // Smooth circular boundary clamping
      d1 = sqrt(sqr(sx1 - sc_cx) + sqr(sy1 - sc_cy));
      d1 > sc_r ? (
        sx1 = sc_cx + (sx1 - sc_cx) * (sc_r / d1);
        sy1 = sc_cy + (sy1 - sc_cy) * (sc_r / d1);
      );
      d2 = sqrt(sqr(sx2 - sc_cx) + sqr(sy2 - sc_cy));
      d2 > sc_r ? (
        sx2 = sc_cx + (sx2 - sc_cx) * (sc_r / d2);
        sy2 = sc_cy + (sy2 - sc_cy) * (sc_r / d2);
      );

      // Phosphor persistence decay: recent samples glow, older samples gently fade
      alpha = 0.20 + 0.80 * (si / 63.0);

      // Draw continuous chronological vector trace
      gfx_r = 0.00; gfx_g = 0.88; gfx_b = 1.00; gfx_a = alpha * 0.80;
      gfx_line(sx1, sy1, sx2, sy2);
      gfx_r = 0.35; gfx_g = 0.95; gfx_b = 0.70; gfx_a = alpha * 0.45;
      gfx_line(sx1 + 1, sy1, sx2 + 1, sy2);

      // Phosphor transient beads at head of trace
      (si >= 58) ? (
        gfx_r = 0.80; gfx_g = 1.00; gfx_b = 0.90; gfx_a = alpha;
        gfx_circle(sx2, sy2, 1.6, 1);
      );
      si += 1;
    );
    gfx_a = 1.0;
  );

  // Center Reticle Point
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_circle(sc_cx, sc_cy, 2, 1);

  // 4. Right Side: Clean Professional Mastering Telemetry Bay
  cm_x = disp_x + disp_w * 0.65;
  cm_y = disp_y + 36;
  cm_w = disp_w * 0.32;
  cm_h = disp_h - 48;

  gfx_r = 0.055; gfx_g = 0.065; gfx_b = 0.090;
  gfx_rect(cm_x, cm_y, cm_w, cm_h);
  gfx_r = 0.16; gfx_g = 0.20; gfx_b = 0.28;
  gfx_rect(cm_x, cm_y, cm_w, cm_h, 0);

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = cm_x + 16; gfx_y = cm_y + 14;
  gfx_drawstr("PHASE CORRELATION");

  // Big Bold Numerical Value
  cur_corr > 0.6 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) :
  cur_corr > 0.0 ? (gfx_r = 0.95; gfx_g = 0.75; gfx_b = 0.20;) : (gfx_r = 0.95; gfx_g = 0.30; gfx_b = 0.30;);
  gfx_setfont(1, "Orbitron", 26, 'b');
  gfx_x = cm_x + 16; gfx_y = cm_y + 36;
  gfx_printf("%+.2f", cur_corr);

  // Clean Horizontal Phase Correlation Gauge (-1.0 to +1.0)
  pbar_x = cm_x + 16; pbar_y = cm_y + 72; pbar_w = cm_w - 32; pbar_h = 10;
  gfx_r = 0.12; gfx_g = 0.14; gfx_b = 0.20;
  gfx_rect(pbar_x, pbar_y, pbar_w, pbar_h);
  // Red zone (-1 to 0)
  gfx_r = 0.60; gfx_g = 0.15; gfx_b = 0.15;
  gfx_rect(pbar_x, pbar_y, pbar_w * 0.5, pbar_h);
  // Yellow zone (0 to +0.5)
  gfx_r = 0.65; gfx_g = 0.55; gfx_b = 0.15;
  gfx_rect(pbar_x + pbar_w * 0.5, pbar_y, pbar_w * 0.25, pbar_h);
  // Green zone (+0.5 to +1.0)
  gfx_r = 0.15; gfx_g = 0.65; gfx_b = 0.30;
  gfx_rect(pbar_x + pbar_w * 0.75, pbar_y, pbar_w * 0.25, pbar_h);
  // Floating cursor line
  needle_x = pbar_x + ((cur_corr + 1.0) * 0.5) * pbar_w;
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_rect(needle_x - 1, pbar_y - 2, 3, pbar_h + 4);

  // Meter Labels (-1.0, 0.0, +1.0)
  gfx_r = 0.50; gfx_g = 0.55; gfx_b = 0.65;
  gfx_setfont(1, "Consolas", 11);
  gfx_x = pbar_x; gfx_y = pbar_y + 14; gfx_drawstr("-1.0");
  gfx_x = pbar_x + pbar_w * 0.5 - 8; gfx_y = pbar_y + 14; gfx_drawstr("0.0");
  gfx_measurestr("+1.0", ptw, pth);
  gfx_x = pbar_x + pbar_w - ptw; gfx_y = pbar_y + 14; gfx_drawstr("+1.0");

  // Readouts: Width & Mono Cutoff
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Bahnschrift", 13, 'b');
  gfx_x = cm_x + 16; gfx_y = cm_y + 104;
  gfx_printf("Stereo Width Mult: %.2fx", imager_wid);
  gfx_x = cm_x + 16; gfx_y = cm_y + 126;
  gfx_printf("Sub-Bass Mono: %.0f Hz", imager_mono);

  // Mono Compatibility Pill Badge (Safely Measured & Contained)
  badge_y = cm_y + cm_h - 34;
  badge_w = cm_w - 32;
  cur_corr > 0.5 ? (
    gfx_r = 0.08; gfx_g = 0.28; gfx_b = 0.16;
    gfx_rect(cm_x + 16, badge_y, badge_w, 24);
    gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;
    gfx_rect(cm_x + 16, badge_y, badge_w, 24, 0);
    gfx_setfont(1, "Orbitron", 11, 'b');
    b_txt = "★ MONO SAFE (PHASE OK)";
  ) : (
    gfx_r = 0.28; gfx_g = 0.18; gfx_b = 0.05;
    gfx_rect(cm_x + 16, badge_y, badge_w, 24);
    gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
    gfx_rect(cm_x + 16, badge_y, badge_w, 24, 0);
    gfx_setfont(1, "Orbitron", 11, 'b');
    b_txt = "▲ WIDE FIELD (CHECK MONO)";
  );
  gfx_measurestr(b_txt, btw, bth);
  gfx_x = cm_x + 16 + (badge_w - btw) * 0.5; gfx_y = badge_y + 5;
  gfx_drawstr(b_txt);
) : slider2 == 5 ?
// TAB 5: MAXIMIZER & KCLIP 3 / KCLIP ZERO HYBRID TRANSIENT CLIPPER
// ═════════════════════════════════════════════════════════════════════════════
(
  half_sec_h = (disp_h - 16) * 0.5;

  // ─── STAGE 1 (TOP): KCLIP 3 / KCLIP ZERO TRANSIENT CLIPPER ───
  k_card_y = disp_y + 6;
  gfx_r = 0.06; gfx_g = 0.07; gfx_b = 0.10;
  gfx_rect(disp_x + 8, k_card_y, disp_w - 16, half_sec_h);
  gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
  gfx_rect(disp_x + 8, k_card_y, disp_w - 16, half_sec_h, 0);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 18; gfx_y = k_card_y + 8;
  gfx_drawstr("KCLIP 3 / KCLIP ZERO HYBRID TRANSIENT CLIPPER");

  // Mode Selection Pills: Smooth, Crisp, Tape, Tube, Flatline 2
  km_x = disp_x + 18; km_y = k_card_y + 28; km_w = 82; km_h = 26;
  kmi = 0;
  loop(5,
    kx = km_x + kmi * (km_w + 5);
    ksel = (kclip_mode == kmi);
    gfx_r = ksel ? 0.00 : 0.10; gfx_g = ksel ? 0.55 : 0.12; gfx_b = ksel ? 0.85 : 0.16;
    gfx_rect(kx, km_y, km_w, km_h);
    gfx_r = ksel ? 1.0 : 0.65; gfx_g = ksel ? 1.0 : 0.70; gfx_b = ksel ? 1.0 : 0.80;
    gfx_setfont(1, "Bahnschrift", 13, ksel ? 'b' : 0);
    klbl = (kmi==0 ? "Smooth" : (kmi==1 ? "Crisp" : (kmi==2 ? "Tape" : (kmi==3 ? "Tube" : "Flatline 2"))));
    gfx_measurestr(klbl, klw, klh);
    gfx_x = kx + (km_w - klw) * 0.5; gfx_y = km_y + (km_h - klh) * 0.5;
    gfx_drawstr(klbl);
    mouse_clicked && (mouse_x >= kx && mouse_x <= kx + km_w && mouse_y >= km_y && mouse_y <= km_y + km_h) ? (
      kclip_mode = kmi; slider21 = kmi; slider_automate(1048576);
    );
    kmi += 1;
  );

  // Delta Audition Button
  delta_btn_x = km_x + 5 * (km_w + 5) + 10;
  delta_btn_w = 100;
  gfx_r = kclip_delta ? 0.95 : 0.12; gfx_g = kclip_delta ? 0.45 : 0.15; gfx_b = kclip_delta ? 0.15 : 0.20;
  gfx_rect(delta_btn_x, km_y, delta_btn_w, km_h);
  gfx_r = kclip_delta ? 1.0 : 0.80; gfx_g = kclip_delta ? 1.0 : 0.85; gfx_b = kclip_delta ? 1.0 : 0.90;
  gfx_setfont(1, "Bahnschrift", 13, 'b');
  d_txt = kclip_delta ? "★ DELTA ON" : "LISTEN DELTA";
  gfx_measurestr(d_txt, dtw, dth);
  gfx_x = delta_btn_x + (delta_btn_w - dtw) * 0.5; gfx_y = km_y + (km_h - dth) * 0.5;
  gfx_drawstr(d_txt);
  mouse_clicked && (mouse_x >= delta_btn_x && mouse_x <= delta_btn_x + delta_btn_w && mouse_y >= km_y && mouse_y <= km_y + km_h) ? (
    kclip_delta = !kclip_delta; slider24 = kclip_delta; slider_automate(8388608);
  );

  // Parameters Row
  param_y = k_card_y + 58;
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 12, 'b');
  gfx_x = disp_x + 18; gfx_y = param_y;
  dith_str = (dither_mode==0 ? "Off" : (dither_mode==1 ? "24-bit" : "16-bit"));
  gfx_printf("Drive: +%.1fdB  |  Knee: %.0f%%  |  M/S: %.0f%%  |  Shape: %.0f%%  |  Dither: %s  |  Guard: %s", clip_drive, kclip_knee * 100, kclip_ms_bias * 100, fl_shape * 100, dith_str, (chug_guard_on ? "ON" : "OFF"));

  // Real-Time Shaved Transients Meter
  meter_y = k_card_y + 78;
  meter_w = disp_w - 36;
  meter_h = 14;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(disp_x + 18, meter_y, meter_w, meter_h);
  gr_pct = min(1.0, clip_gr_meter / 6.0);
  gfx_r = 0.95; gfx_g = 0.50; gfx_b = 0.15;
  gfx_rect(disp_x + 18, meter_y, meter_w * gr_pct, meter_h);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Consolas", 12, 'b');
  gfx_x = disp_x + 22; gfx_y = meter_y + 1;
  gfx_printf("Transients Shaved: -%.2f dB", clip_gr_meter);

  // ─── STAGE 2 (BOTTOM): BRICKWALL LIMITER & AUTO-NORMALIZATION ───
  lim_card_y = k_card_y + half_sec_h + 4;
  lim_card_h = half_sec_h - 4;
  gfx_r = 0.06; gfx_g = 0.07; gfx_b = 0.10;
  gfx_rect(disp_x + 8, lim_card_y, disp_w - 16, lim_card_h);
  gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
  gfx_rect(disp_x + 8, lim_card_y, disp_w - 16, lim_card_h, 0);

  // Stage 2 Title on Left
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = disp_x + 18; gfx_y = lim_card_y + 8;
  gfx_drawstr("IRC-5 BRICKWALL LIMITER");

  // Dynamic ISP Status Badge on Right (Measured, Safe Margin)
  isp_badge_txt = slider46 ? "4x POLYPHASE ISP: ACTIVE" : "ISP GUARD: 2x HQ";
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_measurestr(isp_badge_txt, ibw, ibh);
  b_w = ibw + 16;
  b_x = disp_x + disp_w - b_w - 18;
  gfx_r = 0.08; gfx_g = 0.22; gfx_b = 0.15;
  gfx_rect(b_x, lim_card_y + 6, b_w, 20);
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_rect(b_x, lim_card_y + 6, b_w, 20, 0);
  gfx_x = b_x + 8; gfx_y = lim_card_y + 9;
  gfx_drawstr(isp_badge_txt);

  // Telemetry Strip (Above Meter Bar)
  out_pk_db = 20.0 * log10(max(peak_hold, 0.000001));
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 12, 'b');
  gfx_x = disp_x + 18; gfx_y = lim_card_y + 30;
  peak_hold > 0.000001 ? (
    gfx_printf("Output True-Peak: %.2f dBTP   |   Limiter Ceiling: %.1f dBTP   |   EBU Standard: -1.0 dBTP", out_pk_db, lim_ceil);
  ) : (
    gfx_drawstr("Output True-Peak: IDLE (-inf dBTP)   |   Limiter Ceiling: -1.0 dBTP");
  );

  // Horizontal True-Peak Level Bar (Clean, NO text drawn over meter)
  tp_y = lim_card_y + 48;
  tp_h = 14;
  tp_w = disp_w - 36;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(disp_x + 18, tp_y, tp_w, tp_h);

  bar_pct = max(0.0, min(1.0, (out_pk_db + 24.0) / 24.0));
  out_pk_db >= lim_ceil ? (gfx_r = 0.20; gfx_g = 0.90; gfx_b = 0.50;) : (gfx_r = 0.00; gfx_g = 0.70; gfx_b = 0.95;);
  gfx_rect(disp_x + 18, tp_y, tp_w * bar_pct, tp_h);

  // Red ceiling mark
  ceil_x = disp_x + 18 + ((lim_ceil + 24.0) / 24.0) * tp_w;
  gfx_r = 1.0; gfx_g = 0.2; gfx_b = 0.2;
  gfx_rect(ceil_x - 1, tp_y - 2, 3, tp_h + 4);

  // Status & Gain Readings (Below Meter Bar)
  gfx_r = 0.75; gfx_g = 0.82; gfx_b = 0.90;
  gfx_setfont(1, "Bahnschrift", 13);
  gfx_x = disp_x + 18; gfx_y = lim_card_y + 68;
  auto_norm ? (
    gfx_printf("Auto-Normalize Active: Driving +%.1f dB to hit ceiling  |  Target: -8.5 LUFS-I CD  |  Live: %.1f LUFS", auto_drive, cur_lufs);
  ) : (
    gfx_printf("Maximizer Drive: +%.1f dB  |  Limiter GR: -%.2f dB  |  Target: -8.5 LUFS-I CD  |  Live: %.1f LUFS", max_drive, (lim_gr < 1.0 ? -20*log10(lim_gr) : 0.0), cur_lufs);
  );
) :
// ═════════════════════════════════════════════════════════════════════════════
// TAB 6: MASTERING ENGINEERS PLAYBOOK & SECRET WEAPONS
// ═════════════════════════════════════════════════════════════════════════════
(
  // ── SUB-HEADER: Active Legend Selector & Quick Chain Load ──
  sh_h = 36;
  gfx_r = 0.055; gfx_g = 0.068; gfx_b = 0.095;
  gfx_rect(disp_x, disp_y, disp_w, sh_h);
  gfx_r = 0.16; gfx_g = 0.22; gfx_b = 0.32;
  gfx_line(disp_x, disp_y + sh_h, disp_x + disp_w, disp_y + sh_h);

  // Sigil / Label
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = disp_x + 14; gfx_y = disp_y + 10;
  gfx_drawstr("PLAYBOOK LEGEND:");

  // Left arrow button '<'
  pb_btn_w = 26;
  pb_l_x = disp_x + 160;
  pb_l_hov = (mouse_x >= pb_l_x && mouse_x <= pb_l_x + pb_btn_w && mouse_y >= disp_y + 5 && mouse_y <= disp_y + 31);
  gfx_r = pb_l_hov ? 0.22 : 0.11; gfx_g = pb_l_hov ? 0.28 : 0.15; gfx_b = pb_l_hov ? 0.40 : 0.22;
  gfx_rect(pb_l_x, disp_y + 5, pb_btn_w, 26);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = pb_l_x + 8; gfx_y = disp_y + 9;
  gfx_drawstr("<");
  mouse_clicked && pb_l_hov ? (
    playbook_eng_idx = (playbook_eng_idx - 1 + 14) % 14;
  );

  // Center Legend Name & Studio Display Box
  pb_name_w = min(420, max(260, disp_w - 480));
  pb_name_x = pb_l_x + pb_btn_w + 6;
  gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.15;
  gfx_rect(pb_name_x, disp_y + 5, pb_name_w, 26);
  gfx_r = 0.18; gfx_g = 0.24; gfx_b = 0.34;
  gfx_rect(pb_name_x, disp_y + 5, pb_name_w, 26, 0);

  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 13, 'b');
  pb_title_str = get_playbook_name(playbook_eng_idx);
  gfx_measurestr(pb_title_str, ptw, pth);
  gfx_x = pb_name_x + (pb_name_w - ptw) * 0.5; gfx_y = disp_y + 10;
  gfx_drawstr(pb_title_str);

  // Right arrow button '>'
  pb_r_x = pb_name_x + pb_name_w + 6;
  pb_r_hov = (mouse_x >= pb_r_x && mouse_x <= pb_r_x + pb_btn_w && mouse_y >= disp_y + 5 && mouse_y <= disp_y + 31);
  gfx_r = pb_r_hov ? 0.22 : 0.11; gfx_g = pb_r_hov ? 0.28 : 0.15; gfx_b = pb_r_hov ? 0.40 : 0.22;
  gfx_rect(pb_r_x, disp_y + 5, pb_btn_w, 26);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = pb_r_x + 9; gfx_y = disp_y + 9;
  gfx_drawstr(">");
  mouse_clicked && pb_r_hov ? (
    playbook_eng_idx = (playbook_eng_idx + 1) % 14;
  );

  // [ ONE-CLICK LOAD SIGNATURE CHAIN ] Button
  load_btn_x = pb_r_x + pb_btn_w + 14;
  load_btn_w = min(220, disp_x + disp_w - 14 - load_btn_x);
  is_active_chain = (slider33 == playbook_eng_idx);
  load_hov = (mouse_x >= load_btn_x && mouse_x <= load_btn_x + load_btn_w && mouse_y >= disp_y + 5 && mouse_y <= disp_y + 31);
  is_active_chain ? (
    gfx_r = 0.08; gfx_g = 0.28; gfx_b = 0.18;
  ) : (
    gfx_r = load_hov ? 0.18 : 0.10; gfx_g = load_hov ? 0.28 : 0.16; gfx_b = load_hov ? 0.42 : 0.26;
  );
  gfx_rect(load_btn_x, disp_y + 5, load_btn_w, 26);
  gfx_r = is_active_chain ? 0.25 : (load_hov ? 0.00 : 0.20);
  gfx_g = is_active_chain ? 0.95 : (load_hov ? 0.85 : 0.35);
  gfx_b = is_active_chain ? 0.45 : (load_hov ? 1.00 : 0.55);
  gfx_rect(load_btn_x, disp_y + 5, load_btn_w, 26, 0);

  gfx_setfont(1, "Orbitron", 11, 'b');
  load_txt = is_active_chain ? "CHAIN ENGAGED" : "LOAD SIGNATURE CHAIN";
  gfx_measurestr(load_txt, ltw, lth);
  gfx_x = load_btn_x + (load_btn_w - ltw) * 0.5; gfx_y = disp_y + 11;
  gfx_drawstr(load_txt);

  mouse_clicked && load_hov && !is_active_chain ? (
    slider33 = playbook_eng_idx;
    apply_producer_master_preset(slider33);
    slider50 = side_air_shelf_g;
    slider_automate(2 | 8 | 16 | 32 | 64 | 256 | 512 | 1048576);
  );

  // ── 2-COLUMN MAIN BODY: LEFT (4 TACTICAL CARDS) vs RIGHT (TELEMETRY BAY) ──
  body_y = disp_y + sh_h + 8;
  body_h = disp_h - sh_h - 16;
  col_left_w = floor(disp_w * 0.62);
  col_right_x = disp_x + col_left_w + 12;
  col_right_w = disp_w - col_left_w - 20;

  // ── LEFT COLUMN: 4 TACTICAL HEURISTIC CARDS ──
  card_h = floor((body_h - 18) / 4);
  ci = 0;
  loop(4,
    c_y = body_y + ci * (card_h + 6);
    gfx_r = 0.045; gfx_g = 0.058; gfx_b = 0.080;
    gfx_rect(disp_x + 8, c_y, col_left_w - 8, card_h);
    gfx_r = 0.14; gfx_g = 0.18; gfx_b = 0.26;
    gfx_rect(disp_x + 8, c_y, col_left_w - 8, card_h, 0);

    // Left accent vertical bar
    ci == 0 ? (gfx_r = 0.95; gfx_g = 0.65; gfx_b = 0.15;) : // Transient (Orange/Gold)
    ci == 1 ? (gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;) : // M/S Air (Cyan)
    ci == 2 ? (gfx_r = 0.85; gfx_g = 0.25; gfx_b = 0.85;) : // Sub-Bass (Magenta)
              (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;);  // Glue (Green)
    gfx_rect(disp_x + 8, c_y, 4, card_h);

    // Header Label
    gfx_setfont(1, "Orbitron", 12, 'b');
    gfx_x = disp_x + 20; gfx_y = c_y + 8;
    ci == 0 ? gfx_drawstr("1. TRANSIENT CONTROL & CREST HEADROOM") :
    ci == 1 ? gfx_drawstr("2. MID / SIDE SPATIAL & PULTEC AIR SHEEN") :
    ci == 2 ? gfx_drawstr("3. SUB-BASS & LOW-END ARCHITECTURE") :
              gfx_drawstr("4. ANALOG BUS GLUE & DYNAMIC BREATHING");

    // Tactical Rule Text
    gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.96;
    gfx_setfont(1, "Bahnschrift", 13);
    gfx_x = disp_x + 20; gfx_y = c_y + 28;
    c_desc = (ci == 0 ? get_playbook_transient(playbook_eng_idx) :
             (ci == 1 ? get_playbook_ms_air(playbook_eng_idx) :
             (ci == 2 ? get_playbook_sub_bass(playbook_eng_idx) :
                        get_playbook_glue(playbook_eng_idx))));
    gfx_drawstr(c_desc);
    ci += 1;
  );

  // ── RIGHT COLUMN: SECRET WEAPONS LIVE TELEMETRY & CONTROLS ──
  gfx_r = 0.040; gfx_g = 0.052; gfx_b = 0.072;
  gfx_rect(col_right_x, body_y, col_right_w, body_h);
  gfx_r = 0.14; gfx_g = 0.18; gfx_b = 0.26;
  gfx_rect(col_right_x, body_y, col_right_w, body_h, 0);

  // Right Header
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = col_right_x + 14; gfx_y = body_y + 10;
  gfx_drawstr("SECRET WEAPONS TELEMETRY");

  // Box 1: Dynamic Crest Factor (PLR)
  b1_y = body_y + 36;
  b1_h = floor((body_h - 48) / 3);
  gfx_r = 0.06; gfx_g = 0.075; gfx_b = 0.105;
  gfx_rect(col_right_x + 10, b1_y, col_right_w - 20, b1_h);
  gfx_r = 0.16; gfx_g = 0.20; gfx_b = 0.28;
  gfx_rect(col_right_x + 10, b1_y, col_right_w - 20, b1_h, 0);

  gfx_r = 0.70; gfx_g = 0.78; gfx_b = 0.88;
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = col_right_x + 18; gfx_y = b1_y + 8;
  gfx_drawstr("DYNAMIC CREST FACTOR (PLR)");

  cur_plr = (cur_peak > 0.0001 && cur_rms > 0.0001) ? (20.0 * log10(cur_peak) - (20.0 * log10(cur_rms) - 0.69)) : 9.2;
  cur_plr > 8.0 ? (gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;) :
  cur_plr > 6.5 ? (gfx_r = 0.95; gfx_g = 0.80; gfx_b = 0.20;) : (gfx_r = 0.95; gfx_g = 0.30; gfx_b = 0.30;);
  gfx_setfont(1, "Orbitron", 22, 'b');
  gfx_x = col_right_x + 18; gfx_y = b1_y + 26;
  gfx_printf("%.1f dB PLR", cur_plr);

  gfx_r = 0.75; gfx_g = 0.82; gfx_b = 0.90;
  gfx_setfont(1, "Bahnschrift", 12);
  gfx_x = col_right_x + 18; gfx_y = b1_y + 54;
  cur_plr > 8.0 ? gfx_drawstr("Breathing naturally. Full transient punch.") :
  cur_plr > 6.5 ? gfx_drawstr("Moderate compression. Streaming standard.") :
                  gfx_drawstr("Squashed master. Reduce limiter/clipper drive.");

  // Box 2: Secret Weapon: Side-Only Silk Air Sheen
  b2_y = b1_y + b1_h + 6;
  b2_h = b1_h;
  gfx_r = 0.06; gfx_g = 0.075; gfx_b = 0.105;
  gfx_rect(col_right_x + 10, b2_y, col_right_w - 20, b2_h);
  gfx_r = 0.16; gfx_g = 0.20; gfx_b = 0.28;
  gfx_rect(col_right_x + 10, b2_y, col_right_w - 20, b2_h, 0);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = col_right_x + 18; gfx_y = b2_y + 8;
  gfx_drawstr("M/S SIDE-ONLY AIR SHEEN (11 kHz)");

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 22, 'b');
  gfx_x = col_right_x + 18; gfx_y = b2_y + 26;
  gfx_printf("%+.1f dB", side_air_shelf_g);

  // Steppers [-] and [+] on the side air shelf
  st_w = 26;
  st_m_x = col_right_x + col_right_w - 74;
  st_p_x = col_right_x + col_right_w - 42;
  st_y = b2_y + 26;
  bm_hov = (mouse_x >= st_m_x && mouse_x <= st_m_x + st_w && mouse_y >= st_y && mouse_y <= st_y + 24);
  bp_hov = (mouse_x >= st_p_x && mouse_x <= st_p_x + st_w && mouse_y >= st_y && mouse_y <= st_y + 24);

  gfx_r = bm_hov ? 0.22 : 0.12; gfx_g = bm_hov ? 0.28 : 0.15; gfx_b = bm_hov ? 0.40 : 0.22;
  gfx_rect(st_m_x, st_y, st_w, 24);
  gfx_r = bp_hov ? 0.22 : 0.12; gfx_g = bp_hov ? 0.28 : 0.15; gfx_b = bp_hov ? 0.40 : 0.22;
  gfx_rect(st_p_x, st_y, st_w, 24);

  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 14, 'b');
  gfx_x = st_m_x + 9; gfx_y = st_y + 4; gfx_drawstr("-");
  gfx_x = st_p_x + 8; gfx_y = st_y + 4; gfx_drawstr("+");

  mouse_clicked && bm_hov ? (
    side_air_shelf_g = max(0.0, side_air_shelf_g - 0.1);
    slider50 = side_air_shelf_g;
    update_filters();
    slider_automate(1);
  );
  mouse_clicked && bp_hov ? (
    side_air_shelf_g = min(3.0, side_air_shelf_g + 0.1);
    slider50 = side_air_shelf_g;
    update_filters();
    slider_automate(1);
  );

  gfx_r = 0.75; gfx_g = 0.82; gfx_b = 0.90;
  gfx_setfont(1, "Bahnschrift", 12);
  gfx_x = col_right_x + 18; gfx_y = b2_y + 54;
  gfx_drawstr("Robin Schmidt halo: Side-only Pultec boost.");

  // Box 3: Transient Protection & True Peak Guard
  b3_y = b2_y + b2_h + 6;
  b3_h = b1_h;
  gfx_r = 0.06; gfx_g = 0.075; gfx_b = 0.105;
  gfx_rect(col_right_x + 10, b3_y, col_right_w - 20, b3_h);
  gfx_r = 0.16; gfx_g = 0.20; gfx_b = 0.28;
  gfx_rect(col_right_x + 10, b3_y, col_right_w - 20, b3_h, 0);

  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;
  gfx_setfont(1, "Orbitron", 11, 'b');
  gfx_x = col_right_x + 18; gfx_y = b3_y + 8;
  gfx_drawstr("TRUE PEAK & CLIPPER PROTECTION");

  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;
  gfx_setfont(1, "Orbitron", 22, 'b');
  gfx_x = col_right_x + 18; gfx_y = b3_y + 26;
  gfx_printf("%.1f dBTP SAFE", lim_ceil);

  gfx_r = 0.75; gfx_g = 0.82; gfx_b = 0.90;
  gfx_setfont(1, "Bahnschrift", 12);
  gfx_x = col_right_x + 18; gfx_y = b3_y + 54;
  gfx_printf("Clipper Drive: %.1f dB | Kick unclipped | 0 Overs", clip_drive);
);

// Apply Weyland-Yutani Phosphor CRT Raster & Reticles over Viewport

// Apply Weyland-Yutani Phosphor CRT Raster & Reticles over Viewport
draw_crt_raster(disp_x, disp_y, disp_w, disp_h);

// ─── 5. BOTTOM PARAMETER DOCK ───
gfx_r = 0.06; gfx_g = 0.07; gfx_b = 0.10;
gfx_rect(dock_x, dock_y, dock_w, dock_h);
gfx_r = 0.14; gfx_g = 0.16; gfx_b = 0.22;
gfx_line(dock_x, dock_y, dock_x + dock_w, dock_y);

card_btn_y = dock_y + dock_h - 42;

// ─── DOCK: TAB 0 (OVERVIEW) ───
slider2 == 0 ? (
  half_w = (dock_w - 20) * 0.5;

  // Box 1 (Left): GENRE REFERENCE TARGET & MASTERING SECRET
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(dock_x + 6, dock_y + 8, half_w, dock_h - 16);
