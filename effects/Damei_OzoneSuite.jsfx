function calc_low_shelf(f0, gain_db, q) (
  gain_db == 0.0 ? (
    ls_b0 = 1.0; ls_b1 = 0.0; ls_b2 = 0.0;
    ls_a1 = 0.0; ls_a2 = 0.0;
  ) : (
    w0 = 2.0 * $pi * f0 / srate;
    cosw = cos(w0); sinw = sin(w0);
    A = 10.0 ^ (gain_db / 40.0);
    alpha = sinw / (2.0 * q);
    sqA2 = 2.0 * sqrt(A) * alpha;

    a0 = (A + 1.0) + (A - 1.0)*cosw + sqA2;
    ls_b0 = (A * ((A + 1.0) - (A - 1.0)*cosw + sqA2)) / a0;
    ls_b1 = (2.0 * A * ((A - 1.0) - (A + 1.0)*cosw)) / a0;
    ls_b2 = (A * ((A + 1.0) - (A - 1.0)*cosw - sqA2)) / a0;
    ls_a1 = (-2.0 * ((A - 1.0) + (A + 1.0)*cosw)) / a0;
    ls_a2 = ((A + 1.0) + (A - 1.0)*cosw - sqA2) / a0;
  );
);

function calc_hpf(f0, q) (
  w0 = 2.0 * $pi * f0 / srate;
  cosw = cos(w0);
  sinw = sin(w0);
  alpha = sinw / (2.0 * q);
  b0 = (1.0 + cosw) * 0.5;
  b1 = -(1.0 + cosw);
  b2 = (1.0 + cosw) * 0.5;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha;
  hpf_b0 = b0 / a0; hpf_b1 = b1 / a0; hpf_b2 = b2 / a0;
  hpf_a1 = a1 / a0; hpf_a2 = a2 / a0;
);

function calc_bell(f0, gain_db, q) (
  A = exp(gain_db * (log(10.0) / 40.0));
  w0 = 2.0 * $pi * f0 / srate;
  cosw = cos(w0);
  sinw = sin(w0);
  alpha = sinw / (2.0 * q);
  b0 = 1.0 + alpha * A;
  b1 = -2.0 * cosw;
  b2 = 1.0 - alpha * A;
  a0 = 1.0 + alpha / A;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha / A;
  bell_b0 = b0 / a0; bell_b1 = b1 / a0; bell_b2 = b2 / a0;
  bell_a1 = a1 / a0; bell_a2 = a2 / a0;
);

function calc_high_shelf(f0, gain_db, q) (
  A = exp(gain_db * (log(10.0) / 40.0));
  w0 = 2.0 * $pi * f0 / srate;
  cosw = cos(w0);
  sinw = sin(w0);
  alpha = sinw / (2.0 * q);
  sqA2 = 2.0 * sqrt(A) * alpha;
  b0 =    A * ( (A+1) + (A-1)*cosw + sqA2 );
  b1 = -2*A * ( (A-1) + (A+1)*cosw );
  b2 =    A * ( (A+1) + (A-1)*cosw - sqA2 );
  a0 =          (A+1) - (A-1)*cosw + sqA2;
  a1 =    2 * ( (A-1) - (A+1)*cosw );
  a2 =          (A+1) - (A-1)*cosw - sqA2;
  hs_b0 = b0 / a0; hs_b1 = b1 / a0; hs_b2 = b2 / a0;
  hs_a1 = a1 / a0; hs_a2 = a2 / a0;
);

function calc_butter_lp(f0) (
  w0 = 2.0 * $pi * f0 / srate;
  cosw = cos(w0);
  sinw = sin(w0);
  alpha = sinw / (2.0 * 0.7071067811865476);
  b0 = (1.0 - cosw) * 0.5;
  b1 = 1.0 - cosw;
  b2 = (1.0 - cosw) * 0.5;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha;
  blp_b0 = b0 / a0; blp_b1 = b1 / a0; blp_b2 = b2 / a0;
  blp_a1 = a1 / a0; blp_a2 = a2 / a0;
);

function calc_butter_hp(f0) (
  w0 = 2.0 * $pi * f0 / srate;
  cosw = cos(w0);
  sinw = sin(w0);
  alpha = sinw / (2.0 * 0.7071067811865476);
  b0 = (1.0 + cosw) * 0.5;
  b1 = -(1.0 + cosw);
  b2 = (1.0 + cosw) * 0.5;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha;
  bhp_b0 = b0 / a0; bhp_b1 = b1 / a0; bhp_b2 = b2 / a0;
  bhp_a1 = a1 / a0; bhp_a2 = a2 / a0;
);

// ─────────────────────────────────────────────────────────────────────────────
// KCLIP 3 / KCLIP ZERO HYBRID DSP ENGINE
// Modes:
// 0: Smooth (KClip Zero tanh/Hermite curve - 100% transparent transient shaving)
// 1: Crisp (KClip 3 punch clipper - hard-knee with inter-sample attack preservation)
// 2: Tape (Symmetrical analog tape saturation curve with musical 3rd harmonics)
// 3: Tube (Asymmetrical valve saturation with 2nd order analog warmth + DC block)
// ─────────────────────────────────────────────────────────────────────────────
function kclip_proc(x, mode, knee) (
  ax = abs(x);
  sx = x < 0 ? -1.0 : 1.0;
  kn = max(0.01, min(0.99, knee));

  mode == 0 ? (
    // Smooth (KClip Zero standard): Cubic spline / Hermite soft saturation
    th = 1.0 - kn * 0.45;
    ax <= th ? x : (
      diff = (ax - th) / (1.0 + kn * 0.45 - th);
      diff >= 1.0 ? (sx * (th + (1.0 - th) * 0.98)) : (
        curve = 1.5 * diff - 0.5 * diff * diff * diff;
        sx * (th + (1.0 - th) * curve)
      )
    )
  ) : mode == 1 ? (
    // Crisp (KClip 3 standard): Punch clipper with fast transient preservation
    th = 1.0 - kn * 0.15;
    ax <= th ? x : (
      diff = ax - th;
      sx * (th + (1.0 - th) * (diff / (1.0 + diff * 1.8)))
    )
  ) : mode == 2 ? (
    // Tape Saturation: Symmetrical warm tape curve
    p = 2.0 + (1.0 - kn) * 2.5;
    sx * (ax / ((1.0 + ax^p)^(1.0 / p)))
  ) : (
    // Tube / Valve Saturation: Asymmetric warm even harmonics
    bias = 0.06 * kn;
    xb = x + bias;
    xb > 0.0 ? (
      yt = 1.0 - exp(-xb);
    ) : (
      yt = -(1.0 - exp(xb));
    );
    yt - bias * 0.85;
  );
);

function soft_clip(x) (
  kclip_proc(x, kclip_mode, kclip_knee);
);

function compute_eq_response() (
  b = 0;
  loop(DISP_BINS,
    freq = 20.0 * exp(log(1000.0) * (b / (DISP_BINS - 1.0)));
    w = 2.0 * $pi * freq / srate;
    cosw = cos(w);
    cos2w = cos(2.0 * w);
    sinw = sin(w);
    sin2w = sin(2.0 * w);

    num_re = eq1_b0 + eq1_b1 * cosw + eq1_b2 * cos2w;
    num_im = -(eq1_b1 * sinw + eq1_b2 * sin2w);
    den_re = 1.0 + eq1_a1 * cosw + eq1_a2 * cos2w;
    den_im = -(eq1_a1 * sinw + eq1_a2 * sin2w);
    mag1_sq = (num_re*num_re + num_im*num_im) / max(den_re*den_re + den_im*den_im, 0.00000001);

    num_re = eq2_b0 + eq2_b1 * cosw + eq2_b2 * cos2w;
    num_im = -(eq2_b1 * sinw + eq2_b2 * sin2w);
    den_re = 1.0 + eq2_a1 * cosw + eq2_a2 * cos2w;
    den_im = -(eq2_a1 * sinw + eq2_a2 * sin2w);
    mag2_sq = (num_re*num_re + num_im*num_im) / max(den_re*den_re + den_im*den_im, 0.00000001);

    num_re = eq3_b0 + eq3_b1 * cosw + eq3_b2 * cos2w;
    num_im = -(eq3_b1 * sinw + eq3_b2 * sin2w);
    den_re = 1.0 + eq3_a1 * cosw + eq3_a2 * cos2w;
    den_im = -(eq3_a1 * sinw + eq3_a2 * sin2w);
    mag3_sq = (num_re*num_re + num_im*num_im) / max(den_re*den_re + den_im*den_im, 0.00000001);

    num_re = eq4_b0 + eq4_b1 * cosw + eq4_b2 * cos2w;
    num_im = -(eq4_b1 * sinw + eq4_b2 * sin2w);
    den_re = 1.0 + eq4_a1 * cosw + eq4_a2 * cos2w;
    den_im = -(eq4_a1 * sinw + eq4_a2 * sin2w);
    mag4_sq = (num_re*num_re + num_im*num_im) / max(den_re*den_re + den_im*den_im, 0.00000001);

    tot_mag_sq = mag1_sq * mag2_sq * mag3_sq * mag4_sq;
    eq_curve_buf[b] = 10.0 * log10(max(tot_mag_sq, 0.00000001));
    b += 1;
  );
);

function update_filters() (
  calc_low_shelf(90.0, ab_bypass ? 0.0 : tbc_trim_low, 0.7071);
  tbc_ls_b0 = ls_b0; tbc_ls_b1 = ls_b1; tbc_ls_b2 = ls_b2;
  tbc_ls_a1 = ls_a1; tbc_ls_a2 = ls_a2;

  // Mid Channel Filters: HPF 28Hz, De-box 320Hz Scoop, Vocal Presence 3.5kHz
  calc_hpf(eq_hp_f, 0.7071);
  eq1_b0 = hpf_b0; eq1_b1 = hpf_b1; eq1_b2 = hpf_b2;
  eq1_a1 = hpf_a1; eq1_a2 = hpf_a2;
  mid_hp_b0 = hpf_b0; mid_hp_b1 = hpf_b1; mid_hp_b2 = hpf_b2;
  mid_hp_a1 = hpf_a1; mid_hp_a2 = hpf_a2;

  use_b2_g = ab_bypass ? 0.0 : (eq_b2_g + tbc_trim_lomid);
  use_b3_g = ab_bypass ? 0.0 : (eq_b3_g + tbc_trim_himid);
  use_b4_g = ab_bypass ? 0.0 : (eq_b4_g + tbc_trim_high);

  calc_bell(eq_b2_f, use_b2_g, eq_b2_q);
  eq2_b0 = bell_b0; eq2_b1 = bell_b1; eq2_b2 = bell_b2;
  eq2_a1 = bell_a1; eq2_a2 = bell_a2;
  mid_b2_b0 = bell_b0; mid_b2_b1 = bell_b1; mid_b2_b2 = bell_b2;
  mid_b2_a1 = bell_a1; mid_b2_a2 = bell_a2;

  calc_bell(eq_b3_f, use_b3_g, eq_b3_q);
  eq3_b0 = bell_b0; eq3_b1 = bell_b1; eq3_b2 = bell_b2;
  eq3_a1 = bell_a1; eq3_a2 = bell_a2;
  mid_b3_b0 = bell_b0; mid_b3_b1 = bell_b1; mid_b3_b2 = bell_b2;
  mid_b3_a1 = bell_a1; mid_b3_a2 = bell_a2;

  // Side Channel Filters: Side HPF 120Hz (cuts wide mud), De-harsh 3.8kHz, Side Air 12kHz
  calc_hpf(120.0, 0.7071);
  side_hp_b0 = hpf_b0; side_hp_b1 = hpf_b1; side_hp_b2 = hpf_b2;
  side_hp_a1 = hpf_a1; side_hp_a2 = hpf_a2;

  calc_bell(3800.0, ab_bypass ? 0.0 : min(0.0, eq_b3_g * 0.5), 1.2);
  side_b2_b0 = bell_b0; side_b2_b1 = bell_b1; side_b2_b2 = bell_b2;
  side_b2_a1 = bell_a1; side_b2_a2 = bell_a2;

  calc_high_shelf(eq_b4_f, use_b4_g, eq_b4_q);
  eq4_b0 = hs_b0; eq4_b1 = hs_b1; eq4_b2 = hs_b2;
  eq4_a1 = hs_a1; eq4_a2 = hs_a2;

  // Dedicated Side-Only High-Shelf Air Sheen (Robin Schmidt / Grant Berry Secret Weapon: Pultec 11kHz shelf strictly on Side)
  calc_high_shelf(11000.0, ab_bypass ? 0.0 : side_air_shelf_g, 0.7071);
  side_b3_b0 = hs_b0; side_b3_b1 = hs_b1; side_b3_b2 = hs_b2;
  side_b3_a1 = hs_a1; side_b3_a2 = hs_a2;

  // Mono-maker filter
  calc_hpf(imager_mono, 0.7071);
  mono_b0 = hpf_b0; mono_b1 = hpf_b1; mono_b2 = hpf_b2;
  mono_a1 = hpf_a1; mono_a2 = hpf_a2;

  // Sidechain 100 Hz HPF for Glue Compressor
  calc_hpf(sc_hpf_f, 0.7071);
  sc_b0 = hpf_b0; sc_b1 = hpf_b1; sc_b2 = hpf_b2;
  sc_a1 = hpf_a1; sc_a2 = hpf_a2;

  // Multiband Crossover Filters
  calc_butter_lp(mb_xo1_f);
  xo1_lp_b0 = blp_b0; xo1_lp_b1 = blp_b1; xo1_lp_b2 = blp_b2; xo1_lp_a1 = blp_a1; xo1_lp_a2 = blp_a2;
  calc_butter_hp(mb_xo1_f);
  xo1_hp_b0 = bhp_b0; xo1_hp_b1 = bhp_b1; xo1_hp_b2 = bhp_b2; xo1_hp_a1 = bhp_a1; xo1_hp_a2 = bhp_a2;

  calc_butter_lp(mb_xo2_f);
  xo2_lp_b0 = blp_b0; xo2_lp_b1 = blp_b1; xo2_lp_b2 = blp_b2; xo2_lp_a1 = blp_a1; xo2_lp_a2 = blp_a2;
  calc_butter_hp(mb_xo2_f);
  xo2_hp_b0 = bhp_b0; xo2_hp_b1 = bhp_b1; xo2_hp_b2 = bhp_b2; xo2_hp_a1 = bhp_a1; xo2_hp_a2 = bhp_a2;

  calc_butter_lp(mb_xo3_f);
  xo3_lp_b0 = blp_b0; xo3_lp_b1 = blp_b1; xo3_lp_b2 = blp_b2; xo3_lp_a1 = blp_a1; xo3_lp_a2 = blp_a2;
  calc_butter_hp(mb_xo3_f);
  xo3_hp_b0 = bhp_b0; xo3_hp_b1 = bhp_b1; xo3_hp_b2 = bhp_b2; xo3_hp_a1 = bhp_a1; xo3_hp_a2 = bhp_a2;

    // DC Offset 15 Hz Steep 2nd-Order HPF
  calc_hpf(15.0, 0.7071);
  dc_b0 = hpf_b0; dc_b1 = hpf_b1; dc_b2 = hpf_b2;
  dc_a1 = hpf_a1; dc_a2 = hpf_a2;

  compute_eq_response();
);

// Precompute Corridor Curves for Selected Genre Profile (Smooth Continuous Curves)

// ─────────────────────────────────────────────────────────────────────────────
// GENRE-CALIBRATED SPECTRAL BENCHMARKS & ALIEN ROMULUS CRT RASTER ENGINE
// ─────────────────────────────────────────────────────────────────────────────
function get_tbc_benchmarks() (
  g_idx = slider33;
  // Calibrated across all 14 producer signature profiles for CD & streaming benchmark mastering
  bench_low   = (g_idx == 0 ? 11.8 : (g_idx == 1 ? 12.0 : (g_idx == 2 ? 12.8 : (g_idx == 3 ? 12.2 : (g_idx == 4 ? 12.4 : (g_idx == 5 ? 11.2 : (g_idx == 6 ? 11.6 : (g_idx == 7 ? 12.0 : (g_idx == 8 ? 12.2 : (g_idx == 9 ? 12.0 : (g_idx == 10 ? 11.8 : (g_idx == 11 ? 13.2 : (g_idx == 12 ? 12.0 : 11.8)))))))))))));
  bench_lomid = (g_idx == 0 ?  7.2 : (g_idx == 1 ?  6.8 : (g_idx == 2 ?  6.2 : (g_idx == 3 ?  7.4 : (g_idx == 4 ?  6.5 : (g_idx == 5 ?  8.4 : (g_idx == 6 ?  7.1 : (g_idx == 7 ?  6.8 : (g_idx == 8 ?  7.0 : (g_idx == 9 ?  6.7 : (g_idx == 10 ?  7.5 : (g_idx == 11 ?  6.8 : (g_idx == 12 ?  7.0 :  7.2)))))))))))));
  bench_himid = (g_idx == 0 ? -2.0 : (g_idx == 1 ? -1.6 : (g_idx == 2 ? -1.5 : (g_idx == 3 ? -2.2 : (g_idx == 4 ? -1.2 : (g_idx == 5 ? -2.6 : (g_idx == 6 ? -1.4 : (g_idx == 7 ? -1.6 : (g_idx == 8 ? -1.8 : (g_idx == 9 ? -1.6 : (g_idx == 10 ? -2.2 : (g_idx == 11 ? -2.8 : (g_idx == 12 ? -1.8 : -2.0)))))))))))));
  bench_high  = (g_idx == 0 ? -17.0 : (g_idx == 1 ? -16.8 : (g_idx == 2 ? -16.5 : (g_idx == 3 ? -17.2 : (g_idx == 4 ? -16.2 : (g_idx == 5 ? -17.8 : (g_idx == 6 ? -17.4 : (g_idx == 7 ? -16.2 : (g_idx == 8 ? -16.8 : (g_idx == 9 ? -16.5 : (g_idx == 10 ? -17.2 : (g_idx == 11 ? -18.0 : (g_idx == 12 ? -17.0 : -17.0)))))))))))));
  // Extended producer signature benchmarks (14-21)
  g_idx >= 14 ? (
    gk = g_idx - 14;
    bench_low   = (gk==0 ? 12.6 : (gk==1 ? 12.8 : (gk==2 ? 11.8 : (gk==3 ? 12.2 : (gk==4 ? 11.6 : (gk==5 ? 12.4 : (gk==6 ? 12.8 : 11.8)))))));
    bench_lomid = (gk==0 ? 6.3 : (gk==1 ? 7.0 : (gk==2 ? 7.0 : (gk==3 ? 6.8 : (gk==4 ? 7.2 : (gk==5 ? 7.0 : (gk==6 ? 6.6 : 6.9)))))));
    bench_himid = (gk==0 ? -1.4 : (gk==1 ? -2.4 : (gk==2 ? -1.8 : (gk==3 ? -1.8 : (gk==4 ? -2.0 : (gk==5 ? -2.0 : (gk==6 ? -2.4 : -1.6)))))));
    bench_high  = (gk==0 ? -16.8 : (gk==1 ? -17.8 : (gk==2 ? -16.6 : (gk==3 ? -16.8 : (gk==4 ? -16.4 : (gk==5 ? -16.8 : (gk==6 ? -17.6 : -16.8)))))));
  );
);

// Weyland-Yutani / Alien Romulus Phosphor CRT Raster & Organic Cathode Refresh
function draw_matemasie_sigil(cx, cy, sz) (
  d = sz * 0.54;
  r_out = sz * 0.44;
  r_in = sz * 0.22;
  gfx_r = 0.00; gfx_g = 0.55; gfx_b = 0.70;
  gfx_line(cx - d, cy - d, cx + d, cy + d);
  gfx_line(cx - d, cy + d, cx + d, cy - d);
  gfx_line(cx - d, cy, cx + d, cy);
  gfx_line(cx, cy - d, cx, cy + d);
  gfx_r = 0.00; gfx_g = 0.90; gfx_b = 1.00;
  gfx_circle(cx - d, cy - d, r_out, 0);
  gfx_circle(cx + d, cy - d, r_out, 0);
  gfx_circle(cx - d, cy + d, r_out, 0);
  gfx_circle(cx + d, cy + d, r_out, 0);
  gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  gfx_circle(cx - d, cy - d, r_in, 1);
  gfx_circle(cx + d, cy - d, r_in, 1);
  gfx_circle(cx - d, cy + d, r_in, 1);
  gfx_circle(cx + d, cy + d, r_in, 1);
  gfx_r = 0.95; gfx_g = 0.98; gfx_b = 1.00;
  gfx_circle(cx, cy, max(2, sz * 0.16), 1);
);

function draw_dwennimmen_sigil(cx, cy, sz) (
  // Dwennimmen (Ram's Horns - Strength paired with Humility & Restraint/Headroom)
  r1 = sz * 0.50; r2 = sz * 0.32;
  gfx_r = 1.00; gfx_g = 0.75; gfx_b = 0.20;
  gfx_circle(cx - r1 * 0.7, cy, r1, 0);
  gfx_circle(cx + r1 * 0.7, cy, r1, 0);
  gfx_circle(cx - r1 * 0.7, cy, r2, 0);
  gfx_circle(cx + r1 * 0.7, cy, r2, 0);
  gfx_line(cx, cy - sz * 0.7, cx, cy + sz * 0.7);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_circle(cx, cy, 2, 1);
);

function draw_asase_sigil(cx, cy, sz) (
  // Asase Ye Duru (The Earth has weight - Foundational Sub-Bass Authority & Mono Anchor)
  gfx_r = 0.15; gfx_g = 0.95; gfx_b = 0.45;
  gfx_rect(cx - sz * 0.6, cy - sz * 0.6, sz * 1.2, sz * 1.2, 0);
  gfx_circle(cx, cy, sz * 0.4, 0);
  gfx_line(cx - sz * 0.6, cy, cx + sz * 0.6, cy);
  gfx_line(cx, cy - sz * 0.6, cx, cy + sz * 0.6);
  gfx_circle(cx, cy, 2, 1);
);

function draw_hex_bolt(bx, by) (
  gfx_r = 0.09; gfx_g = 0.11; gfx_b = 0.15;
  gfx_circle(bx, by, 6, 1);
  gfx_r = 0.22; gfx_g = 0.28; gfx_b = 0.36;
  gfx_circle(bx, by, 6, 0);
  gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06;
  gfx_line(bx - 3, by, bx + 3, by);
  gfx_line(bx, by - 3, bx, by + 3);
  gfx_r = 0.35; gfx_g = 0.45; gfx_b = 0.55;
  gfx_line(bx - 2, by - 2, bx + 2, by + 2);
);

function draw_crt_raster(rx, ry, rw, rh) (
  // Subtle cinematic phosphor refresh pulse (45 Hz CRT cathode refresh modulation)
  crt_phase = (crt_phase + 0.035) % 6.2831853;
  crt_glow = 0.035 + sin(crt_phase * 2.0) * 0.005 + sin(crt_phase * 5.7) * 0.003;

  // Phosphor scanline raster with micro-phosphor grain (integer aligned, 0 glitch)
  scan_y = floor(ry);
  end_y = floor(ry + rh);
  gfx_r = 0.00; gfx_g = 0.04; gfx_b = 0.09; gfx_a = crt_glow;
  loop(floor(rh / 3),
    gfx_line(rx, scan_y, rx + rw, scan_y);
    scan_y += 3;
  );

  // Alien Romulus Industrial Corner Reticles (┌ ┐ └ ┘)
  gfx_r = 0.00; gfx_g = 0.92; gfx_b = 1.00; gfx_a = 0.45;
  ret_len = 12;
  // Top-Left ┌
  gfx_line(rx, ry, rx + ret_len, ry);
  gfx_line(rx, ry, rx, ry + ret_len);
  // Top-Right ┐
  gfx_line(rx + rw - ret_len, ry, rx + rw, ry);
  gfx_line(rx + rw, ry, rx + rw, ry + ret_len);
  // Bottom-Left └
  gfx_line(rx, ry + rh - ret_len, rx, ry + rh);
  gfx_line(rx, ry + rh, rx + ret_len, ry + rh);
  // Bottom-Right ┘
  gfx_line(rx + rw - ret_len, ry + rh, rx + rw, ry + rh);
  gfx_line(rx + rw, ry + rh - ret_len, rx + rw, ry + rh);

  gfx_a = 1.0;
);

function build_corridor(genre) (
  b = 0;
  loop(DISP_BINS,
    freq = 20.0 * exp(log(1000.0) * (b / (DISP_BINS - 1.0)));
    oct = log(freq / 1000.0) / log(2.0);
    base = -22.0 - 4.2 * oct;

    // Smooth Gaussian curve weights across key spectral regions (no discrete step jumps)
    l_sub   = log(freq / 50.0) / 0.70;
    w_sub   = exp(-(l_sub * l_sub));
    l_bass  = log(freq / 120.0) / 0.75;
    w_bass  = exp(-(l_bass * l_bass));
    l_lomid = log(freq / 350.0) / 0.80;
    w_lomid = exp(-(l_lomid * l_lomid));
    l_pres  = log(freq / 3500.0) / 0.85;
    w_pres  = exp(-(l_pres * l_pres));
    w_air   = 1.0 / (1.0 + exp(-(freq - 10000.0) / 2000.0));

    delta = 0;
    genre == 1 ? ( // Lance Prenc (Alpha Wolf / Polaris): Punchy sub, scooped low-mid, cutting high-mid crack
      delta = 1.8 * w_sub + 1.4 * w_bass - 1.8 * w_lomid + 1.8 * w_pres + 1.4 * w_air;
    ) : genre == 2 ? ( // Scott Seigel (DIESECT): Crushing low end, surgical 320Hz box scoop, sizzle air
      delta = 2.4 * w_sub + 1.2 * w_bass - 2.8 * w_lomid + 1.6 * w_pres + 2.0 * w_air;
    ) : genre == 3 ? ( // Jonathan Dolese (Mirrorcell / Cane Hill): Nu-Metalcore guitar weight, thick low-mids
      delta = 1.6 * w_sub + 1.5 * w_bass - 0.6 * w_lomid + 1.2 * w_pres + 1.0 * w_air;
    ) : genre == 4 ? ( // Buster Odeholm (thrown / Northlane): Extreme clack & top-end djent bite
      delta = 2.0 * w_sub + 1.0 * w_bass - 2.4 * w_lomid + 2.6 * w_pres + 2.2 * w_air;
    ) : genre == 5 ? ( // Lewis Johns (Love Is Noise / blanket): Warm shoegaze low-mid bloom, tape roll-off
      delta = 0.8 * w_sub + 1.4 * w_bass + 1.8 * w_lomid + 0.6 * w_pres - 0.6 * w_air;
    ) : genre == 6 ? ( // Kel Pinchin (Split Chain): UK Grunge / Alt-Metal cutting presence
      delta = 1.2 * w_sub + 1.2 * w_bass - 1.2 * w_lomid + 2.2 * w_pres + 0.8 * w_air;
    ) : genre == 7 ? ( // Dan Lancaster & Jason Perry (Don Broco / BMTH): Ultra-polished commercial radio air
      delta = 1.6 * w_sub + 1.2 * w_bass - 1.8 * w_lomid + 1.8 * w_pres + 2.4 * w_air;
    ) : genre == 8 ? ( // Erik Bickerstaffe (Static Dress / Loathe): Screamo depth & atmosphere
      delta = 1.8 * w_sub + 1.4 * w_bass - 1.6 * w_lomid + 1.4 * w_pres + 1.4 * w_air;
    ) : genre == 9 ? ( // Sam Guaiana (Shyeye / Silverstein): Punchy post-hardcore & emo-rock sheen
      delta = 1.6 * w_sub + 1.4 * w_bass - 1.8 * w_lomid + 1.8 * w_pres + 1.8 * w_air;
    ) : genre == 10 ? ( // Zach Tuch (Heavenward / Hundredth): Dreamy indie grunge, natural tape warmth
      delta = 1.2 * w_sub + 1.2 * w_bass + 0.2 * w_lomid + 0.8 * w_pres + 0.6 * w_air;
    ) : genre == 11 ? ( // Forrester Savell (City Of Souls / Karnivool): Massive prog sub authority
      delta = 3.2 * w_sub + 1.6 * w_bass - 1.8 * w_lomid + 0.8 * w_pres - 0.4 * w_air;
    ) : genre == 12 ? ( // Leon Schmidt (SUNBORN - Nebula): Progressive articulation & clarity
      delta = 1.6 * w_sub + 1.2 * w_bass - 1.4 * w_lomid + 1.4 * w_pres + 1.2 * w_air;
    ) : genre == 13 ? ( // Ermin Hamidovic Systematic Reference: Balanced benchmark standard
      delta = 1.2 * w_sub + 0.8 * w_bass - 1.0 * w_lomid + 1.0 * w_pres + 1.0 * w_air;
    ) : ( // Default Modern Metal Clean (2026 Clarity & Punch)
      delta = 1.4 * w_sub + 1.0 * w_bass - 1.4 * w_lomid + 1.4 * w_pres + 1.4 * w_air;
    );

    // Extended producer signature corridors (14-21): Putney, Lever, Bassal, Udd, Braunstein, Cervini/Ron, Bogren, Nolly
    genre >= 14 ? (
      gk = genre - 14;
      c_sub   = (gk==0 ? 2.4 : (gk==1 ? 2.2 : (gk==2 ? 1.6 : (gk==3 ? 1.8 : (gk==4 ? 1.4 : (gk==5 ? 2.0 : (gk==6 ? 2.4 : 1.6)))))));
      c_bass  = (gk==0 ? 1.4 : (gk==1 ? 1.4 : (gk==2 ? 1.2 : (gk==3 ? 1.2 : (gk==4 ? 1.0 : (gk==5 ? 1.4 : (gk==6 ? 1.2 : 1.0)))))));
      c_lomid = (gk==0 ? -2.6 : (gk==1 ? -1.2 : (gk==2 ? -1.6 : (gk==3 ? -1.8 : (gk==4 ? -1.4 : (gk==5 ? -1.6 : (gk==6 ? -1.0 : -1.4)))))));
      c_pres  = (gk==0 ? 1.8 : (gk==1 ? 0.8 : (gk==2 ? 1.6 : (gk==3 ? 1.6 : (gk==4 ? 1.2 : (gk==5 ? 1.4 : (gk==6 ? 0.8 : 1.4)))))));
      c_air   = (gk==0 ? 1.4 : (gk==1 ? 0.8 : (gk==2 ? 2.0 : (gk==3 ? 1.8 : (gk==4 ? 2.2 : (gk==5 ? 1.6 : (gk==6 ? 0.6 : 1.8)))))));
      delta = c_sub * w_sub + c_bass * w_bass + c_lomid * w_lomid + c_pres * w_pres + c_air * w_air;
    );

    mean_val = base + delta;
    corridor_mean[b] = mean_val;
    spread = (freq < 100 ? 3.0 : (freq < 1000 ? 2.2 : 2.8));
    corridor_low[b]  = mean_val - spread;
    corridor_high[b] = mean_val + spread;
    b += 1;
  );
);

// Apply Full Production Settings for Platform Target
function apply_preset_settings(idx) (
  idx == 0 ? ( // CD (-8.5 LUFS / -1.0 dBTP / 16-bit Dither)
    lim_ceil = -1.0; max_drive = 4.2; auto_norm = 1;
    dither_mode = 2; // 16-bit CD
    clip_drive = 0.8; kclip_mode = 0; kclip_knee = 0.35;
    comp_thresh = -14.0; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 1.2;
    imager_mono = 110.0; imager_wid = 1.15;
  ) : idx == 1 ? ( // Spotify (-14.0 LUFS / -1.0 dBTP / 24-bit)
    lim_ceil = -1.0; max_drive = 1.5; auto_norm = 1;
    dither_mode = 1; // 24-bit
    clip_drive = 0.4; kclip_mode = 4; kclip_knee = 0.45;
    comp_thresh = -16.0; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.1; comp_makeup = 0.5;
    imager_mono = 100.0; imager_wid = 1.05;
  ) : idx == 2 ? ( // Apple Music (-16.0 LUFS / -1.0 dBTP / 24-bit)
    lim_ceil = -1.0; max_drive = 0.5; auto_norm = 1;
    dither_mode = 1; // 24-bit
    clip_drive = 0.2; kclip_mode = 4; kclip_knee = 0.50;
    comp_thresh = -18.0; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.1; comp_makeup = 0.2;
    imager_mono = 90.0; imager_wid = 1.00;
  ) : idx == 3 ? ( // Amazon Music (-14.0 LUFS / -1.0 dBTP)
    lim_ceil = -1.0; max_drive = 1.5; auto_norm = 1;
    dither_mode = 1;
    clip_drive = 0.4; kclip_mode = 4; kclip_knee = 0.40;
    comp_thresh = -16.0; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.1; comp_makeup = 0.5;
    imager_mono = 100.0; imager_wid = 1.05;
  ) : idx == 4 ? ( // Tidal (-14.0 LUFS / -1.0 dBTP)
    lim_ceil = -1.0; max_drive = 1.5; auto_norm = 1;
    dither_mode = 1;
    clip_drive = 0.4; kclip_mode = 4; kclip_knee = 0.40;
    comp_thresh = -16.0; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6;
    imager_mono = 100.0; imager_wid = 1.10;
  ) : idx == 5 ? ( // YouTube (-14.0 LUFS / -1.0 dBTP)
    lim_ceil = -1.0; max_drive = 1.8; auto_norm = 1;
    dither_mode = 1;
    clip_drive = 0.5; kclip_mode = 1; kclip_knee = 0.35;
    comp_thresh = -16.0; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.8;
    imager_mono = 110.0; imager_wid = 1.08;
  ) : idx == 6 ? ( // SoundCloud (-9.0 LUFS / -0.5 dBTP)
    lim_ceil = -1.0; max_drive = 4.0; auto_norm = 1;
    dither_mode = 2;
    clip_drive = 1.2; kclip_mode = 1; kclip_knee = 0.30;
    comp_thresh = -14.0; comp_ratio = 3.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 1.5;
    imager_mono = 120.0; imager_wid = 1.18;
  ) : idx == 7 ? ( // Bandcamp (-11.0 LUFS / -0.5 dBTP)
    lim_ceil = -0.5; max_drive = 2.8; auto_norm = 1;
    dither_mode = 1;
    clip_drive = 0.6; kclip_mode = 0; kclip_knee = 0.40;
    comp_thresh = -15.0; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 1.0;
    imager_mono = 100.0; imager_wid = 1.10;
  ) : idx == 8 ? ( // Deezer (-14.0 LUFS / -1.0 dBTP)
    lim_ceil = -1.0; max_drive = 1.5; auto_norm = 1;
    dither_mode = 1;
    clip_drive = 0.4; kclip_mode = 4; kclip_knee = 0.45;
    comp_thresh = -16.0; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.1; comp_makeup = 0.5;
    imager_mono = 100.0; imager_wid = 1.05;
  ) : ( // Qobuz Hi-Res Master (-13.0 LUFS / -1.0 dBTP / 24-bit Hi-Res)
    lim_ceil = -1.0; max_drive = 2.0; auto_norm = 1;
    dither_mode = 1; // 24-bit Hi-Res
    clip_drive = 0.5; kclip_mode = 4; kclip_knee = 0.50; // Ultra transparent Flatline 2
    comp_thresh = -16.0; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.8;
    imager_mono = 100.0; imager_wid = 1.12;
  );

  slider1 = idx;
  slider4 = clip_drive;
  slider5 = lim_ceil;
  slider6 = imager_mono;
  slider7 = imager_wid;
  slider9 = max_drive;
  slider10 = auto_norm;
  slider21 = kclip_mode;
  slider22 = kclip_knee * 100;
  slider27 = dither_mode;
  slider_automate(1 | 8 | 16 | 32 | 64 | 256 | 512);

  build_corridor(slider33);
  update_filters();
);

// =============================================================================
// PRODUCER SIGNATURE MASTERING PRESET ENGINE (14 PROFILES FOCUSING ON MASTERING)
// =============================================================================
function apply_producer_master_preset(p_idx) (
  p_idx == 1 ? (
    // 1. Lance Prenc (Alpha Wolf feat. Holding Absence - '60cm Of Steel')
    // Mastering Engineer: Lance Prenc (Prenc Audio, Melbourne)
    // Ref: Peak -0.1dB | RMS -7.54dB | Crest 7.44dB | Width 0.49
    lim_ceil = -1.0; max_drive = 4.8; auto_norm = 1;
    clip_drive = 1.4; kclip_mode = 4; kclip_knee = 0.25; // Flatline 2 clipping
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 130.0;
    imager_mono = 110.0; imager_wid = 1.15; // 110Hz Mono Anchor ensures high Phone correlation (r > +0.72)
    eq_hp_f = 28.0; eq_b2_g = -2.2; eq_b3_g = 1.4; eq_b4_g = 1.4;
    slider43 = 1; slider44 = 1.4; slider45 = 0.2; // Aggressive Bass Punch
  ) : p_idx == 2 ? (
    // 2. Scott Seigel (DIESECT - 'TOO MANY SCARS')
    // Mastering Engineer: Scott Seigel (Full Production Master)
    // Ref: Peak 0.0dB | RMS -7.79dB | Crest 7.79dB | Width 0.45
    lim_ceil = -0.8; max_drive = 5.2; auto_norm = 1;
    clip_drive = 1.6; kclip_mode = 1; kclip_knee = 0.20; // Crisp Punch
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 135.0;
    imager_mono = 105.0; imager_wid = 1.10;
    eq_hp_f = 26.0; eq_b2_g = -2.6; eq_b3_g = 1.2; eq_b4_g = 1.6;
    slider43 = 2; slider44 = 0.8; slider45 = 1.0; // Heavy Bass Sustain
  ) : p_idx == 3 ? (
    // 3. Jonathan Dolese (Mirrorcell - 'U(phoria)')
    // Mastering Engineer: Jonathan Dolese (Konkrete Studios, New Orleans)
    // Ref: Peak 0.0dB | RMS -7.31dB | Crest 7.31dB | Width 0.62
    lim_ceil = -1.0; max_drive = 4.6; auto_norm = 1;
    clip_drive = 1.2; kclip_mode = 3; kclip_knee = 0.35; // Tube Valve
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 10.0; comp_release = 0.1; comp_makeup = 0.6; sc_hpf_f = 115.0;
    imager_mono = 105.0; imager_wid = 1.14;
    eq_hp_f = 30.0; eq_b2_g = -1.8; eq_b3_g = 1.5; eq_b4_g = 1.0;
    slider43 = 3; slider44 = 1.2; slider45 = 0.6;
  ) : p_idx == 4 ? (
    // 4. Buster Odeholm (thrown - 'on the verge' / Northlane - 'Evian')
    // Mastering Engineer: Buster Odeholm (Odeholm Audio / Impact Studios)
    // Ref: Peak 0.0dB | RMS -6.85dB | Crest 6.85dB | Width 0.55
    lim_ceil = -0.8; max_drive = 5.6; auto_norm = 1;
    clip_drive = 1.8; kclip_mode = 1; kclip_knee = 0.15; // Crisp Punch high-impact
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 140.0;
    imager_mono = 110.0; imager_wid = 1.16;
    eq_hp_f = 28.0; eq_b2_g = -2.4; eq_b3_g = 1.6; eq_b4_g = 1.8;
    slider43 = 1; slider44 = 1.6; slider45 = 0.0;
  ) : p_idx == 5 ? (
    // 5. Grant Berry (blanket - 'Blur' / Love Is Noise - 'Hole In Me')
    // Mastering Engineer: Grant Berry (Fader Mastering, UK - Lewis Johns Productions)
    // Ref: Peak -0.25dB | RMS -8.54dB | Crest 8.29dB | Width 0.60
    lim_ceil = -1.0; max_drive = 2.6; auto_norm = 1;
    clip_drive = 0.5; kclip_mode = 2; kclip_knee = 0.50; // Warm Tape Saturation
    comp_thresh = -12.5; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.8; sc_hpf_f = 110.0;
    imager_mono = 105.0; imager_wid = 1.18; // Spacious 3D shoegaze depth with clean 105Hz mono anchor
    eq_hp_f = 26.0; eq_b2_g = -1.0; eq_b3_g = 0.6; eq_b4_g = 0.8;
    slider43 = 2; slider44 = 0.4; slider45 = 0.8;
  ) : p_idx == 6 ? (
    // 6. Robin Schmidt & Grant Berry (Split Chain - 'I\'m Not Dying To Be Here')
    // Mastering Engineers: Grant Berry (Fader Mastering) / Robin Schmidt (24-96 Mastering)
    // Ref: Peak -0.3dB | RMS -9.23dB | Crest 8.93dB | Width 0.59
    lim_ceil = -1.0; max_drive = 4.4; auto_norm = 1;
    clip_drive = 0.0; kclip_mode = 4; kclip_knee = 0.55; // Flatline 2 transparent 0.0dB drive preserves kick/bass
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 125.0;
    imager_mono = 105.0; imager_wid = 1.15;
    eq_hp_f = 28.0; eq_b2_g = -1.8; eq_b3_g = 1.8; eq_b4_g = 1.0;
    slider43 = 3; slider44 = 1.1; slider45 = 0.5;
    side_air_shelf_g = 1.0; // Pultec +1.0 dB @ 11kHz Side-Only Air Sheen
  ) : p_idx == 7 ? (
    // 7. Ted Jensen (Don Broco - 'Endorphins')
    // Mastering Engineer: Ted Jensen (Sterling Sound, Nashville/NYC)
    // Ref: Peak 0.0dB | RMS -8.89dB | Crest 8.89dB | Width 0.44
    lim_ceil = -1.0; max_drive = 4.2; auto_norm = 1;
    clip_drive = 1.0; kclip_mode = 2; kclip_knee = 0.25; // Tape Saturation Sheen
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 125.0;
    imager_mono = 100.0; imager_wid = 1.14;
    eq_hp_f = 28.0; eq_b2_g = -1.8; eq_b3_g = 1.6; eq_b4_g = 1.8;
    slider43 = 3; slider44 = 1.2; slider45 = 0.6;
  ) : p_idx == 8 ? (
    // 8. Robin Schmidt (Static Dress - 'face.')
    // Mastering Engineer: Robin Schmidt (24-96 Mastering, Germany - Erik Bickerstaffe Production)
    // Ref: Peak -0.33dB | RMS -8.15dB | Crest 7.82dB | Width 0.46
    lim_ceil = -1.0; max_drive = 4.2; auto_norm = 1;
    clip_drive = 1.1; kclip_mode = 2; kclip_knee = 0.35; // Analog Tape Drive
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 120.0;
    imager_mono = 100.0; imager_wid = 1.15;
    eq_hp_f = 28.0; eq_b2_g = -1.8; eq_b3_g = 1.4; eq_b4_g = 1.4;
    slider43 = 3; slider44 = 1.0; slider45 = 0.6;
  ) : p_idx == 9 ? (
    // 9. Mike Kalajian (Shyeye, Showing Teeth - 'Knot' / Silverstein)
    // Mastering Engineer: Mike Kalajian (Rogue Planet Mastering, New York)
    // Ref: Peak 0.0dB | RMS -8.98dB | Crest 8.98dB | Width 0.38
    lim_ceil = -1.0; max_drive = 4.5; auto_norm = 1;
    clip_drive = 1.2; kclip_mode = 1; kclip_knee = 0.30; // Crisp Punch
    comp_thresh = -13.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 1.1; sc_hpf_f = 125.0;
    imager_mono = 105.0; imager_wid = 1.12;
    eq_hp_f = 28.0; eq_b2_g = -1.6; eq_b3_g = 1.4; eq_b4_g = 1.4;
    slider43 = 1; slider44 = 1.3; slider45 = 0.3; // Punch Transient Focus
  ) : p_idx == 10 ? (
    // 10. Nick Townsend (Heavenward - 'Tangerine')
    // Mastering Engineer: Nick Townsend (Townsend Mastering, Los Angeles)
    // Ref: Peak -0.21dB | RMS -8.93dB | Crest 8.72dB | Width 0.54
    lim_ceil = -1.0; max_drive = 3.4; auto_norm = 1;
    clip_drive = 0.6; kclip_mode = 3; kclip_knee = 0.40; // Tube Valve
    comp_thresh = -12.5; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.8; sc_hpf_f = 110.0;
    imager_mono = 110.0; imager_wid = 1.16; // 110Hz Mono Anchor lifts Townsend phone phase correlation
    eq_hp_f = 28.0; eq_b2_g = -1.0; eq_b3_g = 0.8; eq_b4_g = 0.8;
    slider43 = 3; slider44 = 0.8; slider45 = 0.6;
  ) : p_idx == 11 ? (
    // 11. Randy Merrill (City Of Souls - 'Cruelty' / Karnivool)
    // Mastering Engineer: Randy Merrill (Sterling Sound, Edgewater NJ)
    // Ref: Peak -1.41dB | RMS -8.80dB | Crest 7.40dB | Width 0.42
    lim_ceil = -1.0; max_drive = 3.6; auto_norm = 1;
    clip_drive = 0.6; kclip_mode = 0; kclip_knee = 0.35; // Smooth Zero
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.9; sc_hpf_f = 135.0;
    imager_mono = 100.0; imager_wid = 1.08;
    eq_hp_f = 24.0; eq_b2_g = -2.4; eq_b3_g = 0.8; eq_b4_g = 0.6;
    slider43 = 2; slider44 = 0.8; slider45 = 1.2; // Sub Weight Depth
  ) : p_idx == 12 ? (
    // 12. Leon Schmidt & Christian Donaldson (SUNBORN - 'Nebula')
    // Mastering Engineers: Christian Donaldson / Leon Schmidt
    // Ref: Peak -0.3dB | RMS -9.79dB | Crest 9.49dB | Width 0.59
    lim_ceil = -1.0; max_drive = 4.0; auto_norm = 1;
    clip_drive = 0.9; kclip_mode = 1; kclip_knee = 0.28; // Crisp Punch
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 120.0;
    imager_mono = 105.0; imager_wid = 1.14;
    eq_hp_f = 28.0; eq_b2_g = -1.6; eq_b3_g = 1.2; eq_b4_g = 1.2;
    slider43 = 3; slider44 = 1.1; slider45 = 0.5;
  ) : p_idx == 13 ? (
    // 13. Ermin Hamidovic (The Systematic Mastering Guide Benchmark)
    // Mastering Engineer: Ermin Hamidovic (Systematic Productions, Melbourne)
    lim_ceil = -1.0; max_drive = 3.8; auto_norm = 1;
    clip_drive = 0.7; kclip_mode = 0; kclip_knee = 0.35; // Smooth Zero
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 125.0;
    imager_mono = 105.0; imager_wid = 1.12;
    eq_hp_f = 28.0; eq_b2_g = -1.6; eq_b3_g = 0.8; eq_b4_g = 0.8;
    slider43 = 3; slider44 = 1.0; slider45 = 0.4;
  ) : p_idx == 14 ? (
    // 14. Will Putney (Fit For An Autopsy / Knocked Loose - Graphic Nature Audio signature)
    lim_ceil = -0.8; max_drive = 5.4; auto_norm = 1;
    clip_drive = 1.7; kclip_mode = 1; kclip_knee = 0.18; // Crisp Punch
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 140.0;
    imager_mono = 110.0; imager_wid = 1.12;
    eq_hp_f = 28.0; eq_b2_g = -2.6; eq_b3_g = 1.4; eq_b4_g = 1.2;
    slider43 = 1; slider44 = 1.5; slider45 = 0.2;
  ) : p_idx == 15 ? (
    // 15. George Lever (Loathe / Sleep Token - signature, Fascination Street style)
    lim_ceil = -1.0; max_drive = 3.4; auto_norm = 1;
    clip_drive = 0.6; kclip_mode = 0; kclip_knee = 0.40; // Smooth Zero
    comp_thresh = -12.5; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.8; sc_hpf_f = 120.0;
    imager_mono = 100.0; imager_wid = 1.20;
    eq_hp_f = 26.0; eq_b2_g = -1.4; eq_b3_g = 0.8; eq_b4_g = 1.0;
    slider43 = 2; slider44 = 0.8; slider45 = 1.0;
  ) : p_idx == 16 ? (
    // 16. Sam Bassal (Thornhill / Ocean Grove - self-mastered)
    lim_ceil = -1.0; max_drive = 4.2; auto_norm = 1;
    clip_drive = 1.0; kclip_mode = 4; kclip_knee = 0.30; // Flatline 2
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 120.0;
    imager_mono = 105.0; imager_wid = 1.18;
    eq_hp_f = 28.0; eq_b2_g = -1.8; eq_b3_g = 1.0; eq_b4_g = 1.6;
    slider43 = 3; slider44 = 1.1; slider45 = 0.5;
  ) : p_idx == 17 ? (
    // 17. Henrik Udd (Architects / Bleed From Within - producer signature)
    lim_ceil = -1.0; max_drive = 4.4; auto_norm = 1;
    clip_drive = 1.1; kclip_mode = 4; kclip_knee = 0.28; // Flatline 2
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 125.0;
    imager_mono = 105.0; imager_wid = 1.16;
    eq_hp_f = 28.0; eq_b2_g = -2.0; eq_b3_g = 1.2; eq_b4_g = 1.4;
    slider43 = 3; slider44 = 1.2; slider45 = 0.6;
  ) : p_idx == 18 ? (
    // 18. Dan Braunstein (Spiritbox - 'Keep Sweet' / Ted Jensen master reference)
    lim_ceil = -1.0; max_drive = 3.8; auto_norm = 1;
    clip_drive = 0.8; kclip_mode = 2; kclip_knee = 0.35; // Tape
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.9; sc_hpf_f = 120.0;
    imager_mono = 100.0; imager_wid = 1.14;
    eq_hp_f = 28.0; eq_b2_g = -1.6; eq_b3_g = 1.0; eq_b4_g = 1.8;
    slider43 = 3; slider44 = 1.0; slider45 = 0.5;
  ) : p_idx == 19 ? (
    // 19. Zakk Cervini & Erik Ron (Bad Omens - 'The Death of Peace of Mind' mix/master)
    lim_ceil = -1.0; max_drive = 4.6; auto_norm = 1;
    clip_drive = 1.2; kclip_mode = 3; kclip_knee = 0.35; // Tube Valve
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 115.0;
    imager_mono = 105.0; imager_wid = 1.15;
    eq_hp_f = 30.0; eq_b2_g = -1.8; eq_b3_g = 1.4; eq_b4_g = 1.4;
    slider43 = 3; slider44 = 1.2; slider45 = 0.6;
  ) : p_idx == 20 ? (
    // 20. Jens Bogren (Fascination Street Studios master)
    lim_ceil = -1.0; max_drive = 3.2; auto_norm = 1;
    clip_drive = 0.5; kclip_mode = 0; kclip_knee = 0.40; // Smooth Zero
    comp_thresh = -12.5; comp_ratio = 1.5; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.8; sc_hpf_f = 125.0;
    imager_mono = 100.0; imager_wid = 1.10;
    eq_hp_f = 24.0; eq_b2_g = -1.2; eq_b3_g = 0.6; eq_b4_g = 0.8;
    slider43 = 2; slider44 = 0.8; slider45 = 1.0;
  ) : p_idx == 21 ? (
    // 21. Nolly - Adam Getgood (Periphery / GGD - Systematic/Ermin master reference)
    lim_ceil = -1.0; max_drive = 4.0; auto_norm = 1;
    clip_drive = 0.9; kclip_mode = 0; kclip_knee = 0.35; // Smooth Zero
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 125.0;
    imager_mono = 105.0; imager_wid = 1.20;
    eq_hp_f = 28.0; eq_b2_g = -1.6; eq_b3_g = 1.0; eq_b4_g = 1.6;
    slider43 = 3; slider44 = 1.0; slider45 = 0.4;
  ) : (
    // 0. Default Modern Metal Clean (2026 High Headroom Benchmark Master)
    lim_ceil = -1.0; max_drive = 3.8; auto_norm = 1;
    clip_drive = 0.8; kclip_mode = 0; kclip_knee = 0.35; // Smooth Zero
    comp_thresh = -12.5; comp_ratio = 2.0; comp_attack = 30.0; comp_release = 0.0; comp_makeup = 0.6; sc_hpf_f = 120.0;
    imager_mono = 105.0; imager_wid = 1.12;
    eq_hp_f = 28.0; eq_b2_g = -1.8; eq_b3_g = 1.0; eq_b4_g = 1.2;
    slider43 = 3; slider44 = 1.0; slider45 = 0.4;
  );

  slider4  = clip_drive;
  slider5  = lim_ceil;
  slider6  = imager_mono;
  slider7  = imager_wid;
  slider9  = max_drive;
  slider10 = auto_norm;
  slider11 = comp_thresh;
  slider12 = (comp_ratio == 1.5 ? 0 : (comp_ratio == 2.0 ? 1 : (comp_ratio == 3.0 ? 2 : 3)));
  slider13 = 5; // 30ms punch attack
  slider14 = 4; // Auto Release
  slider15 = comp_makeup;
  slider16 = sc_hpf_f;
  slider21 = kclip_mode;
  slider22 = kclip_knee * 100;
  slider23 = 75; // 75% Mid/Side Focus: Centers transient punch, shields distorted rhythm guitars from clipping
  slider31 = 2;  // 4x HQ Polyphase Oversampling prevents in-band aliasing on high-gain guitars
  slider32 = 2;  // Active Dual Tamer (Sub-Bass + 180Hz Guitar Chug Guard prevents IMD distortion)
  slider46 = 2;  // 4x Polyphase True Peak ISP Guard guarantees -1.0 dBTP ceiling
  slider39 = eq_hp_f;
  slider40 = eq_b2_g;
  slider41 = eq_b3_g;
  slider42 = eq_b4_g;
  slider50 = side_air_shelf_g;

  eq_b2_f = 320.0; eq_b2_q = 1.4;
  eq_b3_f = 3000.0; eq_b3_q = 1.4;
  eq_b4_f = 11000.0; eq_b4_q = 0.7071;

  build_corridor(slider33);
  update_filters();
  slider_automate();
);

// Only initialize factory defaults once; restore from project state thereafter
!has_inited ? (
  has_inited = 1;
  apply_preset_settings(slider1);
) : (
  build_corridor(slider33);
  update_filters();
);
prev_genre = slider1;

// ─────────────────────────────────────────────────────────────────────────────
// @SLIDER
// ─────────────────────────────────────────────────────────────────────────────

function solve_whole_song_master() (
  audit_active = 0;
  audit_mode = 0;
  slider20 = 0;
  ai_calibrated = 1;
  ab_bypass = 0;

  audit_rms_count > 0 ? (
    song_rms = sqrt(audit_rms_sum / audit_rms_count);
    song_lufs = 20.0 * log10(max(song_rms, 0.000001)) - 0.69;
    song_crest = 20.0 * log10(max(audit_peak_hold, 0.000001) / max(song_rms, 0.000001));
    dyn_swing = audit_loudest_rms - audit_quietest_rms;

    avg_low   = audit_low_acc / audit_rms_count;
    avg_lomid = audit_lomid_acc / audit_rms_count;
    avg_himid = audit_himid_acc / audit_rms_count;
    avg_high  = audit_high_acc / audit_rms_count;

    chorus_acc_count > 0 ? (
      use_low   = (avg_low * 0.35) + ((chorus_low_acc / chorus_acc_count) * 0.65);
      use_lomid = (avg_lomid * 0.35) + ((chorus_lomid_acc / chorus_acc_count) * 0.65);
      use_himid = (avg_himid * 0.35) + ((chorus_himid_acc / chorus_acc_count) * 0.65);
      use_high  = (avg_high * 0.35) + ((chorus_high_acc / chorus_acc_count) * 0.65);
    ) : (
      use_low = avg_low; use_lomid = avg_lomid; use_himid = avg_himid; use_high = avg_high;
    );

    get_tbc_benchmarks();
    d_low   = use_low   - bench_low;
    d_lomid = use_lomid - bench_lomid;
    d_himid = use_himid - bench_himid;
    d_high  = use_high  - bench_high;

    // 1. MASTER EQ (Mid/Side): Precision acoustic shaping
    eq_hp_f = d_low > 3.5 ? min(34.0, 28.0 + d_low * 2.0) : 28.0;
    eq_b2_g = max(-3.5, min(-1.5, -1.8 - max(0.0, d_lomid) * 0.55)); // De-box scoop at 320Hz (Mid)
    d_himid > 2.8 ? (
      eq_b3_g = max(-2.0, min(0.0, -0.8 - (d_himid - 2.0) * 0.4)); // Tame harshness at 3.5kHz
    ) : (
      eq_b3_g = max(0.4, min(1.8, 1.0 - d_himid * 0.4)); // Vocal presence lift
    );
    eq_b4_g = max(0.6, min(2.2, 1.2 - d_high * 0.45)); // Silk air sheen shelf at 12kHz

    // 2. DYNAMICS (BUSTERse / SSL Bus Comp): NATURAL GLUE (Max 1.5 dB GR, NO SQUASHING)
    comp_ratio = 2.0; slider12 = 1; // 2:1 gentle console glue ratio
    comp_thresh = max(-18.0, min(-12.0, audit_loudest_rms + 6.0));
    comp_attack = 30.0; slider13 = 5; // 30ms lets punchy transients pop through
    comp_release = 0.0; slider14 = 4; // Auto Release for organic breathing
    sc_hpf_f = 120.0; slider16 = 120.0; // 120Hz HPF sidechain so bass never ducks
    comp_makeup = 1.0; slider15 = 1.0; // Subtle 1.0 dB make-up
    comp_mix = 1.0; slider17 = 100;
    slider11 = comp_thresh;

    // Multiband Dynamics thresholds: gentle transparent control
    mb_th1 = max(-22.0, min(-14.0, audit_loudest_rms + 3.0));
    mb_th2 = max(-20.0, min(-13.0, audit_loudest_rms + 4.0));
    mb_th3 = max(-20.0, min(-13.0, audit_loudest_rms + 4.0));
    mb_th4 = max(-22.0, min(-14.0, audit_loudest_rms + 3.0));

    // 3. STEREO IMAGER: Mathematical phase alignment & width
    imager_mono = 110.0; slider6 = 110.0;
    imager_wid = 1.12; slider7 = 1.12;

    // 4. KCLIP 3 / ZERO CLIPPER & MAXIMIZER TARGETS (CD Standard -8.5 LUFS / -1.0 dBTP)
    kclip_mode = 0; slider21 = 0; // Smooth (KClip Zero standard)
    kclip_knee = 0.35; slider22 = 35; // 35% softness (no harsh odd harmonics)
    kclip_ms_bias = 0.75; slider23 = 75; // 75% Mid Bias (Center kick/snare transients shaved, sides preserved)
    kclip_delta = 0; slider24 = 0;
    clip_drive = 0.8; slider4 = 0.8; // Shaves 0.8 dB of crest peaks transparently
    lim_ceil = -1.0; slider5 = -1.0; // -1.0 dBTP true-peak ceiling
    max_drive = 4.2; slider9 = 4.2; // Natural dynamic drive
    auto_norm = 1; slider10 = 1;

    // 5. TONAL BALANCE: Full-Band Alignment into Target Corridor
    tbc_trim_low   = max(-6.0, min(6.0, -d_low   * 0.85));
    tbc_trim_lomid = max(-6.0, min(6.0, -d_lomid * 0.85));
    tbc_trim_himid = max(-6.0, min(6.0, -d_himid * 0.85));
    tbc_trim_high  = max(-6.0, min(6.0, -d_high  * 0.85));

    update_filters();
    slider_automate(1 | 2 | 4 | 8 | 16 | 32 | 64 | 128 | 256 | 512);
    assist_msg = "Natural CD Master Solved: Mid/Side EQ + SSL 2:1 Glue + Clean -1.0 dBTP Limiting.";
  );
);

@slider

slider1 != prev_genre ? (
  prev_genre = slider1;
  apply_preset_settings(slider1);
);

slider3 > 0.5 && assist_state != 1 ? (
  assist_state = 1;
  assist_samples = 0;
  memset(learn_accum, 0, DISP_BINS);
);

// Map SSL Bus Comp Slider Values
comp_thresh = slider11;
slider12 == 0 ? comp_ratio = 1.5 : (slider12 == 1 ? comp_ratio = 2.0 : (slider12 == 2 ? comp_ratio = 3.0 : (slider12 == 3 ? comp_ratio = 4.0 : comp_ratio = 10.0)));
slider13 == 0 ? comp_attack = 0.1 : (slider13 == 1 ? comp_attack = 0.3 : (slider13 == 2 ? comp_attack = 1.0 : (slider13 == 3 ? comp_attack = 3.0 : (slider13 == 4 ? comp_attack = 10.0 : comp_attack = 30.0))));
slider14 == 0 ? comp_release = 0.1 : (slider14 == 1 ? comp_release = 0.3 : (slider14 == 2 ? comp_release = 0.6 : (slider14 == 3 ? comp_release = 1.2 : comp_release = 0.0)));
comp_makeup = slider15;
sc_hpf_f = slider16;
comp_mix = slider17 * 0.01;
comp_in_trim = slider18;
comp_out_trim = slider19;

clip_drive = slider4;
lim_ceil = slider5;
side_air_shelf_g = slider50 > 0 ? slider50 : 1.0;
playbook_eng_idx = min(13, slider33);
imager_mono = slider6;
imager_wid = slider7;
max_drive = slider9;
auto_norm = slider10;

kclip_mode = slider21;
kclip_knee = slider22 * 0.01;
kclip_ms_bias = slider23 * 0.01;
kclip_delta = slider24;
ab_gain_match = slider25;
ab_state = slider26;
dither_mode = slider27;
dc_filter_on = slider28;
fl_shape = slider29 * 0.01;
cl_link = slider30 * 0.01;
os_quality = slider31;
chug_guard_on = slider32;
slider33 != prev_producer_preset ? (
  prev_producer_preset = slider33;
  genre_profile = slider33;
  macro_rider_mode = slider34;
  apply_producer_master_preset(slider33);
);

update_filters();

slider20 == 1 && assist_state != 1 ? (
  assist_state = 1;
  assist_samples = 0;
  memset(learn_accum, 0, DISP_BINS);
);
slider20 == 2 && !audit_active ? (
  audit_active = 1;
  audit_samples = 0;
  audit_loudest_rms = -120.0;
  audit_quietest_rms = 0.0;
  audit_peak_hold = 0.0;
  audit_rms_sum = 0.0;
  audit_rms_count = 0;
  chorus_acc_count = 0;
  assist_msg = "Audit rolling... Play through the song, then click [FINISH & SOLVE].";
);
clip_drive  = slider4;
lim_ceil    = slider5;
imager_mono = slider6;
imager_wid  = slider7;
max_drive   = slider9;
auto_norm   = slider10;
build_corridor(slider33);
tbc_trim_low   = slider35;
tbc_trim_lomid = slider36;
tbc_trim_himid = slider37;
tbc_trim_high  = slider38;
eq_hp_f        = slider39;
eq_b2_g        = slider40;
eq_b3_g        = slider41;
eq_b4_g        = slider42;
side_air_shelf_g = slider50;
playbook_eng_idx = min(13, slider33);

update_filters();

// ─────────────────────────────────────────────────────────────────────────────
// @SAMPLE — DSP Master Chain
// ─────────────────────────────────────────────────────────────────────────────
@sample

in_l = spl0;
in_r = spl1;

// =============================================================================
// 0. SONG STRUCTURE & CHORUS IMPACT AI ENGINE (MASTERING STAGE)
// Dual-Mode Architecture: REAPER Project Regions/Markers Sync + Autonomous Acoustic AI
// =============================================================================
slider47 > 0 ? (
  is_playing = (play_state & 1);
  has_signal = (abs_out > 0.0002 && cur_lufs > -45.0);

  // Check REAPER Project Region Telemetry via DameiMetering gmem bus
  gmem_active = (gmem[100] == 1);
  g_sec_id    = gmem_active ? gmem[101] : 0;
  g_to_chorus = gmem_active ? gmem[102] : -1.0;

  // Detection Mode Routing:
  // slider48 == 0 (Hybrid): Prioritizes REAPER project regions when present; falls back to autonomous acoustic AI if no regions
  // slider48 == 1 (REAPER Project Regions Only): Strictly obeys session region labels
  // slider48 == 2 (Autonomous Acoustic Energy AI): Autonomous audio energy heuristics
  use_regions = (slider48 == 1 && gmem_active) ||
                (slider48 == 0 && gmem_active && (g_sec_id > 0 || (g_to_chorus > 0.0 && g_to_chorus < 8.0)));

  // If transport stopped, or in acoustic mode without audio signal -> Clean AI READY (IDLE)
  (!is_playing || (!use_regions && !has_signal)) ? (
    struct_state = 0; // Transport stopped or silence -> Clean AI READY (IDLE)
    struct_eval_cnt = 0;
    struct_cand_cnt = 0;
    struct_cand = 0;
    target_width_boost = 0.0;
    target_punch_boost = 0.0;
    target_struct_rider = 0.0;
  ) : use_regions ? (
    // ═════════════════════════════════════════════════════════════════════════
    // A. REAPER PROJECT REGION DETECTION (ZERO LATENCY, SAMPLE-ACCURATE LOCK)
    // ═════════════════════════════════════════════════════════════════════════
    g_sec_id == 3 ? (
      struct_state = 3; // ⚡ CHORUS IMPACT
    ) : g_sec_id == 2 ? (
      struct_state = 2; // ▼ PRE-DROP BREATH
    ) : g_sec_id == 1 ? (
      struct_state = 1; // ▲ PRE-CHORUS BUILD
    ) : g_sec_id == 4 ? (
      struct_state = 4; // ◆ BREAKDOWN
    ) : g_sec_id == 5 ? (
      struct_state = 5; // ■ VERSE / GROOVE
    ) : (
      struct_state = 0; // ● AI READY (IDLE)
    );

    // DYNAMIC SECTION BEHAVIORS TAILORED BY MASTERING ENGINEER PRESET (ALL 14 PRESETS)
    eng_idx = (slider33 < 14 ? slider33 : (slider33==14 ? 9 : (slider33==15 ? 8 : (slider33==16 ? 10 : (slider33==17 ? 12 : (slider33==18 ? 7 : (slider33==19 ? 3 : (slider33==20 ? 11 : 13))))))));
    scale_mult = (slider47 == 1 ? 1.0 : (slider47 == 2 ? 1.5 : 0.6));

    struct_state == 3 ? (
      // ⚡ CHORUS IMPACT: Signature Width Detonation, Punch Snap, Air Sheen & Sub Weight
      eng_idx == 0 ? ( // Default Modern Metal Clean (2026 Clarity & Punch)
        target_width_boost =  0.06 * scale_mult;
        target_punch_boost =  0.40 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 1 ? ( // Lance Prenc (Stereo Guitar Wall & Snare Crack)
        target_width_boost =  0.10 * scale_mult;
        target_punch_boost =  0.60 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 2 ? ( // Scott Seigel (Nu-Metal Slam & Sub Punch)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.55 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.40 * scale_mult;
      ) : eng_idx == 3 ? ( // Jonathan Dolese (Pop-Metal Hook Polish)
        target_width_boost =  0.09 * scale_mult;
        target_punch_boost =  0.45 * scale_mult;
        target_air_boost   =  0.45 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 4 ? ( // Buster Odeholm (Slam Detonation)
        target_width_boost =  0.13 * scale_mult;
        target_punch_boost =  0.85 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.40 * scale_mult;
      ) : eng_idx == 5 ? ( // Grant Berry (Shoegaze Ambient Float Wall)
        target_width_boost =  0.11 * scale_mult;
        target_punch_boost =  0.35 * scale_mult;
        target_air_boost   =  0.45 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 6 ? ( // Split Chain (UK Grunge Nu-Metal Slam)
        target_width_boost =  0.09 * scale_mult;
        target_punch_boost =  0.55 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.30 * scale_mult;
      ) : eng_idx == 7 ? ( // Ted Jensen (Sterling Silk Sheen & Analog Bloom)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.50 * scale_mult;
        target_air_boost   =  0.50 * scale_mult;
        target_sub_boost   =  0.30 * scale_mult;
      ) : eng_idx == 8 ? ( // Robin Schmidt (24-96 Static Dress Tape Slam)
        target_width_boost =  0.09 * scale_mult;
        target_punch_boost =  0.55 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 9 ? ( // Mike Kalajian (Rogue Planet Drum Room Punch)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.60 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 10 ? ( // Nick Townsend (High-Dynamic Vinyl Warmth & Punch)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.35 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 11 ? ( // Randy Merrill (Sterling Commercial Radio Punch)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost =  0.45 * scale_mult;
        target_air_boost   =  0.35 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Cyber Metal Blast Slam)
        target_width_boost =  0.11 * scale_mult;
        target_punch_boost =  0.70 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.35 * scale_mult;
      ) : ( // Ermin Hamidovic (Systematic Phase-Aligned Wide Wall)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.50 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      );
      target_struct_rider = 0.0;
    ) : struct_state == 1 ? (
      // ▲ PRE-CHORUS BUILD: Signature Tension Building (All 14 Engineers)
      eng_idx == 0 ? ( // Default Modern Metal Clean (Balanced Tension)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 1 ? ( // Lance Prenc (Laser Mid Focus)
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 2 ? ( // Scott Seigel (De-Box Sweep)
        target_width_boost = -0.04 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   = -0.10 * scale_mult;
      ) : eng_idx == 3 ? ( // Jonathan Dolese (Vocal Shimmer Lift)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.15 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 4 ? ( // Buster Odeholm (The Claustrophobia Box)
        target_width_boost = -0.07 * scale_mult;
        target_punch_boost =  0.35 * scale_mult;
        target_air_boost   = -0.40 * scale_mult;
        target_sub_boost   = -0.20 * scale_mult;
      ) : eng_idx == 5 ? ( // Grant Berry (Tape Swell Float)
        target_width_boost = -0.01 * scale_mult;
        target_punch_boost =  0.10 * scale_mult;
        target_air_boost   =  0.15 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 6 ? ( // Split Chain (Grunge Grit Build)
        target_width_boost = -0.04 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 7 ? ( // Ted Jensen (Subtle Console Silk Tension)
        target_width_boost = -0.02 * scale_mult;
        target_punch_boost =  0.15 * scale_mult;
        target_air_boost   =  0.15 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 8 ? ( // Robin Schmidt (Tape Tension)
        target_width_boost = -0.04 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 9 ? ( // Mike Kalajian (Dynamic Crest Ramp)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.30 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 10 ? ( // Nick Townsend (Lacquer Swell)
        target_width_boost = -0.02 * scale_mult;
        target_punch_boost =  0.10 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 11 ? ( // Randy Merrill (Precision Center Focus)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Technical Chug Tightening)
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.30 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : ( // Ermin Hamidovic (Systematic Phase Tension)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      );
      target_struct_rider = 0.0;
    ) : struct_state == 2 ? (
      // ▼ PRE-DROP BREATH: Signature Transition Vacuum (All 14 Engineers)
      eng_idx == 4 ? ( // Buster Odeholm (Full Sub Vacuum Cut)
        target_width_boost = -0.08 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   = -0.50 * scale_mult;
        target_sub_boost   = -0.50 * scale_mult;
      ) : eng_idx == 1 ? ( // Lance Prenc (Sub Drop Center Snap)
        target_width_boost = -0.06 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   = -0.10 * scale_mult;
        target_sub_boost   = -0.25 * scale_mult;
      ) : eng_idx == 2 ? ( // Scott Seigel (808 Sub Breath)
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   = -0.10 * scale_mult;
        target_sub_boost   = -0.30 * scale_mult;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Djent Silence Drop)
        target_width_boost = -0.07 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   = -0.20 * scale_mult;
        target_sub_boost   = -0.35 * scale_mult;
      ) : ( // Standard Pre-Drop Breath (Smooth Vacuum)
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   = -0.20 * scale_mult;
      );
      target_struct_rider = 0.0;
    ) : struct_state == 4 ? (
      // ◆ BREAKDOWN: Signature Atmosphere, 3D Depth & Sub Crater (All 14 Engineers)
      eng_idx == 0 ? ( // Default Modern Metal Clean (Balanced Space)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.00;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 1 ? ( // Lance Prenc (Center Snare & Bass Focus)
        target_width_boost =  0.04 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.20 * scale_mult;
        target_sub_boost   =  0.30 * scale_mult;
      ) : eng_idx == 2 ? ( // Scott Seigel (808 Sub Crater)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.70 * scale_mult;
      ) : eng_idx == 3 ? ( // Jonathan Dolese (Intimate Vocal Halo)
        target_width_boost =  0.06 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.40 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 4 ? ( // Buster Odeholm (Physical Heavy Impact)
        target_width_boost =  0.04 * scale_mult;
        target_punch_boost =  0.50 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.60 * scale_mult;
      ) : eng_idx == 5 ? ( // Grant Berry (Shoegaze Ambient Float)
        target_width_boost =  0.10 * scale_mult;
        target_punch_boost = -0.15 * scale_mult;
        target_air_boost   =  0.40 * scale_mult;
        target_sub_boost   =  0.15 * scale_mult;
      ) : eng_idx == 6 ? ( // Split Chain (Grungy Ambient Float)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 7 ? ( // Ted Jensen (3D Pultec Silk & Analog Depth)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.50 * scale_mult;
        target_sub_boost   =  0.10 * scale_mult;
      ) : eng_idx == 8 ? ( // Robin Schmidt (Moody Atmospheric Resonance)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost = -0.10 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 9 ? ( // Mike Kalajian (Punchy Rock Breakdown)
        target_width_boost =  0.04 * scale_mult;
        target_punch_boost =  0.15 * scale_mult;
        target_air_boost   =  0.20 * scale_mult;
        target_sub_boost   =  0.35 * scale_mult;
      ) : eng_idx == 10 ? ( // Nick Townsend (Acoustic Space Halo)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost = -0.10 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.15 * scale_mult;
      ) : eng_idx == 11 ? ( // Randy Merrill (Pristine Hi-Fi Air)
        target_width_boost =  0.06 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.40 * scale_mult;
        target_sub_boost   =  0.15 * scale_mult;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Massive Djent Slam)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.40 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.60 * scale_mult;
      ) : ( // Ermin Hamidovic (Strict 0 VU Calibrated Dynamic Balance)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.10 * scale_mult;
        target_air_boost   =  0.20 * scale_mult;
        target_sub_boost   =  0.30 * scale_mult;
      );
      target_struct_rider = 0.0;
    ) : (
      // ■ VERSE / GROOVE: Clean Baseline
      target_width_boost = 0.0;
      target_punch_boost = 0.0;
      target_air_boost   = 0.0;
      target_sub_boost   = 0.0;
      target_struct_rider = 0.0;
    );
  ) : (
    // ═════════════════════════════════════════════════════════════════════════
    // B. AUTONOMOUS ACOUSTIC SONG STRUCTURE AI (ZERO-LABELS FALLBACK)
    // ═════════════════════════════════════════════════════════════════════════
    // 1. Dual-Timeframe RMS Envelope Tracking
    c_fast = exp(-1.0 / (0.35 * srate));
    c_slow = exp(-1.0 / (3.20 * srate));
    struct_fast_rms = struct_fast_rms * c_fast + abs_out * (1.0 - c_fast);
    struct_slow_rms = struct_slow_rms * c_slow + abs_out * (1.0 - c_slow);

    cur_track_rms = max(cur_track_rms * 0.999997, struct_slow_rms);
    avg_track_rms = (avg_track_rms < 0.0001) ? struct_slow_rms : (avg_track_rms * 0.999992 + struct_slow_rms * 0.000008);

    // 2. Sub-Block Decimation: evaluate section logic every 2048 samples (~43ms)
    struct_eval_cnt += 1;
    struct_eval_cnt >= 2048 ? (
      struct_eval_cnt = 0;

      db_fast = 20.0 * log10(max(struct_fast_rms, 0.000001));
      db_slow = 20.0 * log10(max(struct_slow_rms, 0.000001));
      db_max  = 20.0 * log10(max(cur_track_rms, 0.000001));
      db_avg  = 20.0 * log10(max(avg_track_rms, 0.000001));

      energy_deficit_to_max = db_max - db_slow; // Distance from track's peak section (dB)
      short_energy_surge = db_fast - db_slow;   // Short-term energy climb (dB)
      live_crest = cur_crest;                    // Dense chorus (8-11.5dB), sparse verse/intro (13-18dB)

      is_chorus = (energy_deficit_to_max < 2.2) && (live_crest < 12.0 || short_energy_surge > 0.6);
      is_build = (short_energy_surge >= 0.35) && (energy_deficit_to_max >= 1.8 && energy_deficit_to_max <= 5.5);
      is_breakdown = (db_slow < (db_avg - 3.2)) || (energy_deficit_to_max > 6.0);

      detected_cand = is_chorus ? 3 : (is_build ? 1 : (is_breakdown ? 4 : 5));

      detected_cand == struct_cand ? (
        struct_cand_cnt += 1;
        struct_cand_cnt >= 24 ? (
          struct_state != detected_cand ? (
            struct_state = detected_cand;
          );
        );
      ) : (
        struct_cand = detected_cand;
        struct_cand_cnt = 0;
      );

      // DYNAMIC SECTION BEHAVIORS TAILORED BY MASTERING ENGINEER PRESET (ALL 14 PRESETS)
    eng_idx = (slider33 < 14 ? slider33 : (slider33==14 ? 9 : (slider33==15 ? 8 : (slider33==16 ? 10 : (slider33==17 ? 12 : (slider33==18 ? 7 : (slider33==19 ? 3 : (slider33==20 ? 11 : 13))))))));
    scale_mult = (slider47 == 1 ? 1.0 : (slider47 == 2 ? 1.5 : 0.6));

    struct_state == 3 ? (
      // ⚡ CHORUS IMPACT: Signature Width Detonation, Punch Snap, Air Sheen & Sub Weight
      eng_idx == 0 ? ( // Default Modern Metal Clean (2026 Clarity & Punch)
        target_width_boost =  0.06 * scale_mult;
        target_punch_boost =  0.40 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 1 ? ( // Lance Prenc (Stereo Guitar Wall & Snare Crack)
        target_width_boost =  0.10 * scale_mult;
        target_punch_boost =  0.60 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 2 ? ( // Scott Seigel (Nu-Metal Slam & Sub Punch)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.55 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.40 * scale_mult;
      ) : eng_idx == 3 ? ( // Jonathan Dolese (Pop-Metal Hook Polish)
        target_width_boost =  0.09 * scale_mult;
        target_punch_boost =  0.45 * scale_mult;
        target_air_boost   =  0.45 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 4 ? ( // Buster Odeholm (The Slam Detonation)
        target_width_boost =  0.13 * scale_mult;
        target_punch_boost =  0.85 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.40 * scale_mult;
      ) : eng_idx == 5 ? ( // Grant Berry (Organic Wall-of-Sound Wash)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.35 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 6 ? ( // Robin Schmidt & Grant Berry (Split Chain UK Grunge Slam)
        target_width_boost =  0.09 * scale_mult;
        target_punch_boost =  0.50 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.30 * scale_mult;
      ) : eng_idx == 7 ? ( // Ted Jensen (Pultec Silk & Analog Console Bloom)
        target_width_boost =  0.06 * scale_mult;
        target_punch_boost =  0.40 * scale_mult;
        target_air_boost   =  0.45 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 8 ? ( // Robin Schmidt (Static Dress Industrial Tape Sheen)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.45 * scale_mult;
        target_air_boost   =  0.35 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 9 ? ( // Mike Kalajian (Explosive Drum Room & Punch)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.55 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 10 ? ( // Nick Townsend (High-Dynamic Vinyl Warmth & Punch)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.35 * scale_mult;
        target_air_boost   =  0.25 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 11 ? ( // Randy Merrill (Sterling Commercial Radio Punch)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost =  0.45 * scale_mult;
        target_air_boost   =  0.35 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Cyber Metal Blast Slam)
        target_width_boost =  0.11 * scale_mult;
        target_punch_boost =  0.70 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.35 * scale_mult;
      ) : ( // Ermin Hamidovic (Systematic Phase-Aligned Wide Wall)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost =  0.50 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      );
      target_struct_rider = 0.0;
    ) : struct_state == 1 ? (
      // ▲ PRE-CHORUS BUILD: Signature Tension Building
      eng_idx == 4 ? ( // Buster Odeholm (The Claustrophobia Box)
        target_width_boost = -0.07 * scale_mult;
        target_punch_boost =  0.35 * scale_mult;
        target_air_boost   = -0.40 * scale_mult;
        target_sub_boost   = -0.20 * scale_mult;
      ) : eng_idx == 1 ? ( // Lance Prenc (Laser Mid Focus)
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 2 ? ( // Scott Seigel (De-Box Sweep)
        target_width_boost = -0.04 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   = -0.10 * scale_mult;
      ) : eng_idx == 3 ? ( // Jonathan Dolese (Vocal Shimmer Lift)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.15 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 5 ? ( // Grant Berry (Tape Swell)
        target_width_boost = -0.01 * scale_mult;
        target_punch_boost =  0.10 * scale_mult;
        target_air_boost   =  0.15 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 6 ? ( // Split Chain (Grunge Grit Build)
        target_width_boost = -0.04 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 7 ? ( // Ted Jensen (Subtle Console Tension)
        target_width_boost = -0.02 * scale_mult;
        target_punch_boost =  0.15 * scale_mult;
        target_air_boost   =  0.15 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 8 ? ( // Robin Schmidt (Tape Tension)
        target_width_boost = -0.04 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 9 ? ( // Mike Kalajian (Dynamic Crest Ramp)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.30 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 10 ? ( // Nick Townsend (Lacquer Swell)
        target_width_boost = -0.02 * scale_mult;
        target_punch_boost =  0.10 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.00;
      ) : eng_idx == 11 ? ( // Randy Merrill (Precision Center Focus)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Technical Chug Tightening)
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.30 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      ) : ( // Ermin Hamidovic (Systematic Phase Tension)
        target_width_boost = -0.03 * scale_mult;
        target_punch_boost =  0.25 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   =  0.00;
      );
      target_struct_rider = 0.0;
    ) : struct_state == 2 ? (
      // ▼ PRE-DROP BREATH: Signature Transition Vacuum
      eng_idx == 4 ? ( // Buster Odeholm (Sub Vacuum Cut)
        target_width_boost = -0.08 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   = -0.50 * scale_mult;
        target_sub_boost   = -0.50 * scale_mult;
      ) : (
        target_width_boost = -0.05 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.00;
        target_sub_boost   = -0.20 * scale_mult;
      );
      target_struct_rider = 0.0;
    ) : struct_state == 4 ? (
      // ◆ BREAKDOWN: Signature Atmosphere, 3D Depth & Sub Crater
      eng_idx == 7 ? ( // Ted Jensen (3D Pultec Silk & Analog Depth)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.50 * scale_mult;
        target_sub_boost   =  0.10 * scale_mult;
      ) : eng_idx == 5 ? ( // Grant Berry (Shoegaze Ambient Float)
        target_width_boost =  0.10 * scale_mult;
        target_punch_boost = -0.15 * scale_mult;
        target_air_boost   =  0.40 * scale_mult;
        target_sub_boost   =  0.15 * scale_mult;
      ) : eng_idx == 2 ? ( // Scott Seigel (808 Sub Crater)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.20 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.70 * scale_mult;
      ) : eng_idx == 4 ? ( // Buster Odeholm (Physical Heavy Impact)
        target_width_boost =  0.04 * scale_mult;
        target_punch_boost =  0.50 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.60 * scale_mult;
      ) : eng_idx == 6 ? ( // Split Chain (Grungy Ambient Float)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.25 * scale_mult;
      ) : eng_idx == 8 ? ( // Robin Schmidt (Moody Atmospheric Resonance)
        target_width_boost =  0.07 * scale_mult;
        target_punch_boost = -0.10 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.20 * scale_mult;
      ) : eng_idx == 9 ? ( // Mike Kalajian (Punchy Rock Breakdown)
        target_width_boost =  0.04 * scale_mult;
        target_punch_boost =  0.15 * scale_mult;
        target_air_boost   =  0.20 * scale_mult;
        target_sub_boost   =  0.35 * scale_mult;
      ) : eng_idx == 10 ? ( // Nick Townsend (Acoustic Space Halo)
        target_width_boost =  0.08 * scale_mult;
        target_punch_boost = -0.10 * scale_mult;
        target_air_boost   =  0.30 * scale_mult;
        target_sub_boost   =  0.15 * scale_mult;
      ) : eng_idx == 11 ? ( // Randy Merrill (Pristine Hi-Fi Air)
        target_width_boost =  0.06 * scale_mult;
        target_punch_boost = -0.05 * scale_mult;
        target_air_boost   =  0.40 * scale_mult;
        target_sub_boost   =  0.15 * scale_mult;
      ) : eng_idx == 12 ? ( // Donaldson & Schmidt (Massive Djent Slam)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.40 * scale_mult;
        target_air_boost   =  0.10 * scale_mult;
        target_sub_boost   =  0.60 * scale_mult;
      ) : ( // Ermin Hamidovic (Strict 0 VU Calibrated Dynamic Balance)
        target_width_boost =  0.05 * scale_mult;
        target_punch_boost =  0.10 * scale_mult;
        target_air_boost   =  0.20 * scale_mult;
        target_sub_boost   =  0.30 * scale_mult;
      );
      target_struct_rider = 0.0;
    ) : (
      // ■ VERSE / GROOVE: Clean Baseline
      target_width_boost = 0.0;
      target_punch_boost = 0.0;
      target_air_boost   = 0.0;
      target_sub_boost   = 0.0;
      target_struct_rider = 0.0;
    );
    );
  );

  // 4. 800ms Ultra-Smooth S-Curve Fader Slew (ZERO Stuttering, ZERO Audio Skipping)
  slew_coeff = exp(-1.0 / (0.800 * srate));
  active_struct_rider = active_struct_rider * slew_coeff + target_struct_rider * (1.0 - slew_coeff);
  dyn_width_boost     = dyn_width_boost     * slew_coeff + target_width_boost  * (1.0 - slew_coeff);
  dyn_punch_boost     = dyn_punch_boost     * slew_coeff + target_punch_boost  * (1.0 - slew_coeff);
  dyn_air_boost       = dyn_air_boost       * slew_coeff + target_air_boost    * (1.0 - slew_coeff);
  dyn_sub_boost       = dyn_sub_boost       * slew_coeff + target_sub_boost    * (1.0 - slew_coeff);
  t_struct_rider = active_struct_rider;
) : (
  active_struct_rider = 0.0;
  dyn_width_boost = 0.0;
  dyn_punch_boost = 0.0;
  dyn_air_boost = 0.0;
  dyn_sub_boost = 0.0;
  t_struct_rider = 0.0;
  struct_state = 0;
);

// DC Offset Filter (15 Hz Steep HPF strips amp sim DC bias and sub-audible infrasound)
dc_filter_on ? (
  dc_out_l = dc_b0*in_l + dc_b1*dc_hp_x1_l + dc_b2*dc_hp_x2_l - dc_a1*dc_hp_y1_l - dc_a2*dc_hp_y2_l;
  dc_hp_x2_l = dc_hp_x1_l; dc_hp_x1_l = in_l; dc_hp_y2_l = dc_hp_y1_l; dc_hp_y1_l = dc_out_l;
  in_l = dc_out_l;

  dc_out_r = dc_b0*in_r + dc_b1*dc_hp_x1_r + dc_b2*dc_hp_x2_r - dc_a1*dc_hp_y1_r - dc_a2*dc_hp_y2_r;
  dc_hp_x2_r = dc_hp_x1_r; dc_hp_x1_r = in_r; dc_hp_y2_r = dc_hp_y1_r; dc_hp_y1_r = dc_out_r;
  in_r = dc_out_r;
);

// Measure dry input RMS for auto gain-matching
dry_acc_l = dry_acc_l * 0.9995 + (in_l * in_l) * 0.0005;
dry_acc_r = dry_acc_r * 0.9995 + (in_r * in_r) * 0.0005;

// Anti-denormal and silent pause detection:
abs_in = max(abs(in_l), abs(in_r));
abs_in < 0.0000000001 ? (
  xo1_lp_s1_l = 0; xo1_lp_s2_l = 0; xo1_lp_s3_l = 0; xo1_lp_s4_l = 0;
  xo1_lp_s1_r = 0; xo1_lp_s2_r = 0; xo1_lp_s3_r = 0; xo1_lp_s4_r = 0;
  xo1_hp_s1_l = 0; xo1_hp_s2_l = 0; xo1_hp_s3_l = 0; xo1_hp_s4_l = 0;
  xo1_hp_s1_r = 0; xo1_hp_s2_r = 0; xo1_hp_s3_r = 0; xo1_hp_s4_r = 0;

  xo2_lp_s1_l = 0; xo2_lp_s2_l = 0; xo2_lp_s3_l = 0; xo2_lp_s4_l = 0;
  xo2_lp_s1_r = 0; xo2_lp_s2_r = 0; xo2_lp_s3_r = 0; xo2_lp_s4_r = 0;
  xo2_hp_s1_l = 0; xo2_hp_s2_l = 0; xo2_hp_s3_l = 0; xo2_hp_s4_l = 0;
  xo2_hp_s1_r = 0; xo2_hp_s2_r = 0; xo2_hp_s3_r = 0; xo2_hp_s4_r = 0;

  xo3_lp_s1_l = 0; xo3_lp_s2_l = 0; xo3_lp_s3_l = 0; xo3_lp_s4_l = 0;
  xo3_lp_s1_r = 0; xo3_lp_s2_r = 0; xo3_lp_s3_r = 0; xo3_lp_s4_r = 0;
  xo3_hp_s1_l = 0; xo3_hp_s2_l = 0; xo3_hp_s3_l = 0; xo3_hp_s4_l = 0;
  xo3_hp_s1_r = 0; xo3_hp_s2_r = 0; xo3_hp_s3_r = 0; xo3_hp_s4_r = 0;

  eq1_x1_l = 0; eq1_x2_l = 0; eq1_y1_l = 0; eq1_y2_l = 0;
  eq1_x1_r = 0; eq1_x2_r = 0; eq1_y1_r = 0; eq1_y2_r = 0;
  eq2_x1_l = 0; eq2_x2_l = 0; eq2_y1_l = 0; eq2_y2_l = 0;
  eq2_x1_r = 0; eq2_x2_r = 0; eq2_y1_r = 0; eq2_y2_r = 0;
  eq3_x1_l = 0; eq3_x2_l = 0; eq3_y1_l = 0; eq3_y2_l = 0;
  eq3_x1_r = 0; eq3_x2_r = 0; eq3_y1_r = 0; eq3_y2_r = 0;
  eq4_x1_l = 0; eq4_x2_l = 0; eq4_y1_l = 0; eq4_y2_l = 0;
  eq4_x1_r = 0; eq4_x2_r = 0; eq4_y1_r = 0; eq4_y2_r = 0;
  mono_x1 = 0; mono_x2 = 0; mono_y1 = 0; mono_y2 = 0;
  sc_x1_l = 0; sc_x2_l = 0; sc_y1_l = 0; sc_y2_l = 0;
  sc_x1_r = 0; sc_x2_r = 0; sc_y1_r = 0; sc_y2_r = 0;
  ls_x1_l = 0; ls_x2_l = 0; ls_y1_l = 0; ls_y2_l = 0;
  ls_x1_r = 0; ls_x2_r = 0; ls_y1_r = 0; ls_y2_r = 0;
  punch_fast = 0; punch_slow = 0;
);

// 1. Equalizer Processing: Precision Mid / Side Architecture
// Low-shelf overall trim
y0_l = tbc_ls_b0*in_l + tbc_ls_b1*ls_x1_l + tbc_ls_b2*ls_x2_l - tbc_ls_a1*ls_y1_l - tbc_ls_a2*ls_y2_l;
ls_x2_l = ls_x1_l; ls_x1_l = in_l; ls_y2_l = ls_y1_l; ls_y1_l = y0_l;
y0_r = tbc_ls_b0*in_r + tbc_ls_b1*ls_x1_r + tbc_ls_b2*ls_x2_r - tbc_ls_a1*ls_y1_r - tbc_ls_a2*ls_y2_r;
ls_x2_r = ls_x1_r; ls_x1_r = in_r; ls_y2_r = ls_y1_r; ls_y1_r = y0_r;

// Mid / Side Encoding
eq_mid  = (y0_l + y0_r) * 0.5;
eq_side = (y0_l - y0_r) * 0.5;

// MID Channel Processing (Center Punch, Sub HPF 28Hz, De-box Scoop 320Hz, Vocal Presence)
m_y1 = mid_hp_b0*eq_mid + mid_hp_b1*m_x1 + mid_hp_b2*m_x2 - mid_hp_a1*m_y1_p - mid_hp_a2*m_y2_p;
m_x2 = m_x1; m_x1 = eq_mid; m_y2_p = m_y1_p; m_y1_p = m_y1;

m_y2 = mid_b2_b0*m_y1 + mid_b2_b1*m_x1_b2 + mid_b2_b2*m_x2_b2 - mid_b2_a1*m_y1_b2 - mid_b2_a2*m_y2_b2;
m_x2_b2 = m_x1_b2; m_x1_b2 = m_y1; m_y2_b2 = m_y1_b2; m_y1_b2 = m_y2;

m_y3 = mid_b3_b0*m_y2 + mid_b3_b1*m_x1_b3 + mid_b3_b2*m_x2_b3 - mid_b3_a1*m_y1_b3 - mid_b3_a2*m_y2_b3;
m_x2_b3 = m_x1_b3; m_x1_b3 = m_y2; m_y2_b3 = m_y1_b3; m_y1_b3 = m_y3;

// SIDE Channel Processing (120Hz Side HPF cuts mud, De-harsh 3.8kHz, Silk Air 12kHz Shelf)
s_y1 = side_hp_b0*eq_side + side_hp_b1*s_x1 + side_hp_b2*s_x2 - side_hp_a1*s_y1_p - side_hp_a2*s_y2_p;
s_x2 = s_x1; s_x1 = eq_side; s_y2_p = s_y1_p; s_y1_p = s_y1;

s_y2 = side_b2_b0*s_y1 + side_b2_b1*s_x1_b2 + side_b2_b2*s_x2_b2 - side_b2_a1*s_y1_b2 - side_b2_a2*s_y2_b2;
s_x2_b2 = s_x1_b2; s_x1_b2 = s_y1; s_y2_b2 = s_y1_b2; s_y1_b2 = s_y2;

s_y3 = side_b3_b0*s_y2 + side_b3_b1*s_x1_b3 + side_b3_b2*s_x2_b3 - side_b3_a1*s_y1_b3 - side_b3_a2*s_y2_b3;
s_x2_b3 = s_x1_b3; s_x1_b3 = s_y2; s_y2_b3 = s_y1_b3; s_y1_b3 = s_y3;
s_y3 = s_y3 * exp(dyn_air_boost * 0.115); // Signature Engineer Air Sheen modulation

// Mid / Side Decoding to Stereo
eq_out_l = m_y3 + s_y3;
eq_out_r = m_y3 - s_y3;

// 2. Stereo Imager Stage (Mid / Side Processing + Sub Mono-Maker)
mid  = (eq_out_l + eq_out_r) * 0.5;
side = (eq_out_l - eq_out_r) * 0.5;

mono_side = mono_b0*side + mono_b1*mono_x1 + mono_b2*mono_x2 - mono_a1*mono_y1 - mono_a2*mono_y2;
mono_x2 = mono_x1; mono_x1 = side; mono_y2 = mono_y1; mono_y1 = mono_side;

use_wid = ab_bypass ? 1.0 : max(0.5, min(2.0, imager_wid + dyn_width_boost));
side_scaled = mono_side * use_wid;

im_l = mid + side_scaled;
im_r = mid - side_scaled;

// 3. Linkwitz-Riley 4-Band Multiband Crossover Filters (TDF-II)
// Split Stage 1 (140 Hz Crossover)
t0 = xo1_lp_b0 * im_l + xo1_lp_s1_l;
xo1_lp_s1_l = xo1_lp_b1 * im_l - xo1_lp_a1 * t0 + xo1_lp_s2_l;
xo1_lp_s2_l = xo1_lp_b2 * im_l - xo1_lp_a2 * t0;
b1_lp_l = xo1_lp_b0 * t0 + xo1_lp_s3_l;
xo1_lp_s3_l = xo1_lp_b1 * t0 - xo1_lp_a1 * b1_lp_l + xo1_lp_s4_l;
xo1_lp_s4_l = xo1_lp_b2 * t0 - xo1_lp_a2 * b1_lp_l;

t1 = xo1_hp_b0 * im_l + xo1_hp_s1_l;
xo1_hp_s1_l = xo1_hp_b1 * im_l - xo1_hp_a1 * t1 + xo1_hp_s2_l;
xo1_hp_s2_l = xo1_hp_b2 * im_l - xo1_hp_a2 * t1;
b1_hp_l = xo1_hp_b0 * t1 + xo1_hp_s3_l;
xo1_hp_s3_l = xo1_hp_b1 * t1 - xo1_hp_a1 * b1_hp_l + xo1_hp_s4_l;
xo1_hp_s4_l = xo1_hp_b2 * t1 - xo1_hp_a2 * b1_hp_l;

t0 = xo1_lp_b0 * im_r + xo1_lp_s1_r;
xo1_lp_s1_r = xo1_lp_b1 * im_r - xo1_lp_a1 * t0 + xo1_lp_s2_r;
xo1_lp_s2_r = xo1_lp_b2 * im_r - xo1_lp_a2 * t0;
b1_lp_r = xo1_lp_b0 * t0 + xo1_lp_s3_r;
xo1_lp_s3_r = xo1_lp_b1 * t0 - xo1_lp_a1 * b1_lp_r + xo1_lp_s4_r;
xo1_lp_s4_r = xo1_lp_b2 * t0 - xo1_lp_a2 * b1_lp_r;

t1 = xo1_hp_b0 * im_r + xo1_hp_s1_r;
xo1_hp_s1_r = xo1_hp_b1 * im_r - xo1_hp_a1 * t1 + xo1_hp_s2_r;
xo1_hp_s2_r = xo1_hp_b2 * im_r - xo1_hp_a2 * t1;
b1_hp_r = xo1_hp_b0 * t1 + xo1_hp_s3_r;
xo1_hp_s3_r = xo1_hp_b1 * t1 - xo1_hp_a1 * b1_hp_r + xo1_hp_s4_r;
xo1_hp_s4_r = xo1_hp_b2 * t1 - xo1_hp_a2 * b1_hp_r;

// Split Stage 2 (1200 Hz Crossover)
t0 = xo2_lp_b0 * b1_hp_l + xo2_lp_s1_l;
xo2_lp_s1_l = xo2_lp_b1 * b1_hp_l - xo2_lp_a1 * t0 + xo2_lp_s2_l;
xo2_lp_s2_l = xo2_lp_b2 * b1_hp_l - xo2_lp_a2 * t0;
b2_lp_l = xo2_lp_b0 * t0 + xo2_lp_s3_l;
xo2_lp_s3_l = xo2_lp_b1 * t0 - xo2_lp_a1 * b2_lp_l + xo2_lp_s4_l;
xo2_lp_s4_l = xo2_lp_b2 * t0 - xo2_lp_a2 * b2_lp_l;

t1 = xo2_hp_b0 * b1_hp_l + xo2_hp_s1_l;
xo2_hp_s1_l = xo2_hp_b1 * b1_hp_l - xo2_hp_a1 * t1 + xo2_hp_s2_l;
xo2_hp_s2_l = xo2_hp_b2 * b1_hp_l - xo2_hp_a2 * t1;
b2_hp_l = xo2_hp_b0 * t1 + xo2_hp_s3_l;
xo2_hp_s3_l = xo2_hp_b1 * t1 - xo2_hp_a1 * b2_hp_l + xo2_hp_s4_l;
xo2_hp_s4_l = xo2_hp_b2 * t1 - xo2_hp_a2 * b2_hp_l;

t0 = xo2_lp_b0 * b1_hp_r + xo2_lp_s1_r;
xo2_lp_s1_r = xo2_lp_b1 * b1_hp_r - xo2_lp_a1 * t0 + xo2_lp_s2_r;
xo2_lp_s2_r = xo2_lp_b2 * b1_hp_r - xo2_lp_a2 * t0;
b2_lp_r = xo2_lp_b0 * t0 + xo2_lp_s3_r;
xo2_lp_s3_r = xo2_lp_b1 * t0 - xo2_lp_a1 * b2_lp_r + xo2_lp_s4_r;
xo2_lp_s4_r = xo2_lp_b2 * t0 - xo2_lp_a2 * b2_lp_r;

t1 = xo2_hp_b0 * b1_hp_r + xo2_hp_s1_r;
xo2_hp_s1_r = xo2_hp_b1 * b1_hp_r - xo2_hp_a1 * t1 + xo2_hp_s2_r;
xo2_hp_s2_r = xo2_hp_b2 * b1_hp_r - xo2_hp_a2 * t1;
b2_hp_r = xo2_hp_b0 * t1 + xo2_hp_s3_r;
xo2_hp_s3_r = xo2_hp_b1 * t1 - xo2_hp_a1 * b2_hp_r + xo2_hp_s4_r;
xo2_hp_s4_r = xo2_hp_b2 * t1 - xo2_hp_a2 * b2_hp_r;

// Split Stage 3 (6500 Hz Crossover)
t0 = xo3_lp_b0 * b2_hp_l + xo3_lp_s1_l;
xo3_lp_s1_l = xo3_lp_b1 * b2_hp_l - xo3_lp_a1 * t0 + xo3_lp_s2_l;
xo3_lp_s2_l = xo3_lp_b2 * b2_hp_l - xo3_lp_a2 * t0;
b3_lp_l = xo3_lp_b0 * t0 + xo3_lp_s3_l;
xo3_lp_s3_l = xo3_lp_b1 * t0 - xo3_lp_a1 * b3_lp_l + xo3_lp_s4_l;
xo3_lp_s4_l = xo3_lp_b2 * t0 - xo3_lp_a2 * b3_lp_l;

t1 = xo3_hp_b0 * b2_hp_l + xo3_hp_s1_l;
xo3_hp_s1_l = xo3_hp_b1 * b2_hp_l - xo3_hp_a1 * t1 + xo3_hp_s2_l;
xo3_hp_s2_l = xo3_hp_b2 * b2_hp_l - xo3_hp_a2 * t1;
b3_hp_l = xo3_hp_b0 * t1 + xo3_hp_s3_l;
xo3_hp_s3_l = xo3_hp_b1 * t1 - xo3_hp_a1 * b3_hp_l + xo3_hp_s4_l;
xo3_hp_s4_l = xo3_hp_b2 * t1 - xo3_hp_a2 * b3_hp_l;

t0 = xo3_lp_b0 * b2_hp_r + xo3_lp_s1_r;
xo3_lp_s1_r = xo3_lp_b1 * b2_hp_r - xo3_lp_a1 * t0 + xo3_lp_s2_r;
xo3_lp_s2_r = xo3_lp_b2 * b2_hp_r - xo3_lp_a2 * t0;
b3_lp_r = xo3_lp_b0 * t0 + xo3_lp_s3_r;
xo3_lp_s3_r = xo3_lp_b1 * t0 - xo3_lp_a1 * b3_lp_r + xo3_lp_s4_r;
xo3_lp_s4_r = xo3_lp_b2 * t0 - xo3_lp_a2 * b3_lp_r;

t1 = xo3_hp_b0 * b2_hp_r + xo3_hp_s1_r;
xo3_hp_s1_r = xo3_hp_b1 * b2_hp_r - xo3_hp_a1 * t1 + xo3_hp_s2_r;
xo3_hp_s2_r = xo3_hp_b2 * b2_hp_r - xo3_hp_a2 * t1;
b3_hp_r = xo3_hp_b0 * t1 + xo3_hp_s3_r;
xo3_hp_s3_r = xo3_hp_b1 * t1 - xo3_hp_a1 * b3_hp_r + xo3_hp_s4_r;
xo3_hp_s4_r = xo3_hp_b2 * t1 - xo3_hp_a2 * b3_hp_r;

band1_l = b1_lp_l; band1_r = b1_lp_r;
band2_l = b2_lp_l; band2_r = b2_lp_r;
band3_l = b3_lp_l; band3_r = b3_lp_r;
band4_l = b3_hp_l; band4_r = b3_hp_r;

// Multiband Dynamics (Smooth mastering ballistics: 25ms attack, 200ms smooth release, max 4 dB GR)
in1_pk = max(abs(band1_l), abs(band1_r));
in1_db = in1_pk > 0.000001 ? 20.0 * log10(in1_pk) : -120.0;
ex1 = in1_db - mb_th1;
t_gr1 = ex1 > 0 ? min(3.5, ex1 * (1.0 - 1.0 / mb_rt1)) : 0.0;
mb_gr1 += (t_gr1 > mb_gr1 ? (t_gr1 - mb_gr1) * 0.0005 : (t_gr1 - mb_gr1) * 0.00006);
mb_gr1 = min(3.5, max(0.0, mb_gr1));
g1 = exp(-mb_gr1 * (log(10.0) / 20.0));
band1_l *= g1; band1_r *= g1;

// Adaptive Sub-Bass Bloom Tamer (prevents unruly sub drops and kick woof from overloading limiter)
(slider32 == 2) ? (
  b1_pk = max(abs(band1_l), abs(band1_r));
  b1_lev = b1_pk > 0.000001 ? 20.0 * log10(b1_pk) : -120.0;
  sub_ex = b1_lev - (-16.0);
  t_sub_gr = sub_ex > 0 ? min(3.5, sub_ex * 0.45) : 0.0;
  sub_gr += (t_sub_gr > sub_gr ? (t_sub_gr - sub_gr) * 0.008 : (t_sub_gr - sub_gr) * 0.00015);
  sub_lin = exp(-sub_gr * (log(10.0) / 20.0));
  band1_l *= sub_lin;
  band1_r *= sub_lin;
);

// Mastering Bass Control: Sub-Bass Transient Punch vs. Sustain Weight Split
(slider43 > 0) ? (
  b1_abs = max(abs(band1_l), abs(band1_r));
  b1_env_fast += (b1_abs - b1_env_fast) * 0.008;
  b1_env_slow += (b1_abs - b1_env_slow) * 0.0006;
  b1_punch = max(0.0, b1_env_fast - b1_env_slow);
  b1_sustain = b1_env_slow;
  p_mult = exp(slider44 * 0.115);
  p_gain = 1.0 + b1_punch * (p_mult - 1.0) * 1.5;
  s_mult = exp((slider45 + dyn_sub_boost) * 0.115);
  s_gain = 1.0 + b1_sustain * (s_mult - 1.0) * 0.6;
  slider43 == 1 ? (
    band1_l *= p_gain; band1_r *= p_gain;
  ) : slider43 == 2 ? (
    band1_l *= s_gain; band1_r *= s_gain;
  ) : (
    band1_l = band1_l * p_gain * s_gain;
    band1_r = band1_r * p_gain * s_gain;
  );
);

in2_pk = max(abs(band2_l), abs(band2_r));
in2_db = in2_pk > 0.000001 ? 20.0 * log10(in2_pk) : -120.0;
ex2 = in2_db - mb_th2;
t_gr2 = ex2 > 0 ? min(1.5, ex2 * (1.0 - 1.0 / mb_rt2)) : 0.0;
mb_gr2 += (t_gr2 > mb_gr2 ? (t_gr2 - mb_gr2) * 0.0005 : (t_gr2 - mb_gr2) * 0.00006);
mb_gr2 = min(1.5, max(0.0, mb_gr2));
g2 = exp(-mb_gr2 * (log(10.0) / 20.0));
band2_l *= g2; band2_r *= g2;

// Dynamic Guitar Chug Low-Mid Tamer (prevents palm-mute woof from overloading downstream clipper)
chug_guard_on ? (
  b2_peak = max(abs(band2_l), abs(band2_r));
  b2_db = b2_peak > 0.000001 ? 20.0 * log10(b2_peak) : -120.0;
  chug_excess = b2_db - (-18.0);
  t_chug_gr = chug_excess > 0 ? min(2.5, chug_excess * 0.40) : 0.0;
  // Fast 2.5ms attack to grab instantaneous chug peak, smooth 40ms release to recover before next double kick hit
  chug_gr += (t_chug_gr > chug_gr ? (t_chug_gr - chug_gr) * 0.008 : (t_chug_gr - chug_gr) * 0.0005);
  chug_linear = exp(-chug_gr * (log(10.0) / 20.0));
  band2_l *= chug_linear;
  band2_r *= chug_linear;
);

in3_pk = max(abs(band3_l), abs(band3_r));
in3_db = in3_pk > 0.000001 ? 20.0 * log10(in3_pk) : -120.0;
ex3 = in3_db - mb_th3;
t_gr3 = ex3 > 0 ? min(1.5, ex3 * (1.0 - 1.0 / mb_rt3)) : 0.0;
mb_gr3 += (t_gr3 > mb_gr3 ? (t_gr3 - mb_gr3) * 0.0005 : (t_gr3 - mb_gr3) * 0.00006);
mb_gr3 = min(1.5, max(0.0, mb_gr3));
g3 = exp(-mb_gr3 * (log(10.0) / 20.0));
band3_l *= g3; band3_r *= g3;

in4_pk = max(abs(band4_l), abs(band4_r));
in4_db = in4_pk > 0.000001 ? 20.0 * log10(in4_pk) : -120.0;
ex4 = in4_db - mb_th4;
t_gr4 = ex4 > 0 ? min(1.5, ex4 * (1.0 - 1.0 / mb_rt4)) : 0.0;
mb_gr4 += (t_gr4 > mb_gr4 ? (t_gr4 - mb_gr4) * 0.0005 : (t_gr4 - mb_gr4) * 0.00006);
mb_gr4 = min(1.5, max(0.0, mb_gr4));
g4 = exp(-mb_gr4 * (log(10.0) / 20.0));
band4_l *= g4; band4_r *= g4;

// Multiband Solo check (properly sums the tamed band2)
has_solo = mb_solo1 || mb_solo2 || mb_solo3 || mb_solo4;
has_solo ? (
  mb_sum_l = (mb_solo1 ? band1_l : 0) + (mb_solo2 ? band2_l : 0) + (mb_solo3 ? band3_l : 0) + (mb_solo4 ? band4_l : 0);
  mb_sum_r = (mb_solo1 ? band1_r : 0) + (mb_solo2 ? band2_r : 0) + (mb_solo3 ? band3_r : 0) + (mb_solo4 ? band4_r : 0);
) : (
  mb_sum_l = band1_l + band2_l + band3_l + band4_l;
  mb_sum_r = band1_r + band2_r + band3_r + band4_r;
);

// BUSTERse & HoRNet H4K SSL 4000 VCA Glue Bus Compressor (Full Analog Model)

// Step 1: Input Trim
in_tr_l = mb_sum_l * exp(comp_in_trim * (log(10.0) / 20.0));
in_tr_r = mb_sum_r * exp(comp_in_trim * (log(10.0) / 20.0));

// Step 2: Sidechain HPF Filter (30 - 180 Hz)
sc_l = sc_b0*in_tr_l + sc_b1*sc_x1_l + sc_b2*sc_x2_l - sc_a1*sc_y1_l - sc_a2*sc_y2_l;
sc_x2_l = sc_x1_l; sc_x1_l = in_tr_l; sc_y2_l = sc_y1_l; sc_y1_l = sc_l;
sc_r = sc_b0*in_tr_r + sc_b1*sc_x1_r + sc_b2*sc_x2_r - sc_a1*sc_y1_r - sc_a2*sc_y2_r;
sc_x2_r = sc_x1_r; sc_x1_r = in_tr_r; sc_y2_r = sc_y1_r; sc_y1_r = sc_r;

// Step 3: VCA Level Detector with Analog Storage Capacitor (Holds Peak Envelope)
det_in = max(abs(sc_l), abs(sc_r));
det_cap = max(det_cap * 0.9994, det_in); // Storage capacitor decay prevents zero-crossing dropouts
comp_in_db = det_cap > 0.000001 ? 20.0 * log10(det_cap) : -120.0;
excess = comp_in_db - comp_thresh;
target_gr = excess > 0 ? (excess * (1.0 - 1.0 / max(1.01, comp_ratio))) : 0.0;
target_gr = min(18.0, target_gr);

// Step 4: Ballistics (Program-Dependent Attack & Auto-Release)
comp_att_coeff = 1.0 - exp(-1.0 / max(0.00005, (comp_attack * 0.0005) * srate));

comp_release <= 0.0 ? (
  // Auto Release: program-dependent (fast 0.10s for transients, slow 0.6s for sustained body)
  auto_rel_t = 0.10 + min(0.50, (comp_gr / 6.0) * 0.50);
  comp_rel_coeff = 1.0 - exp(-1.0 / (auto_rel_t * srate));
) : (
  comp_rel_coeff = 1.0 - exp(-1.0 / (comp_release * srate));
);

target_gr > comp_gr ? (
  comp_gr += (target_gr - comp_gr) * comp_att_coeff;
) : (
  comp_gr += (target_gr - comp_gr) * comp_rel_coeff;
);
comp_gr = max(0.0, comp_gr);

// Smooth analog meter needle ballistics (True ANSI C16.5 Moving-Coil Response)
comp_gr_disp = max(comp_gr_disp * 0.9996, comp_gr);
needle_rate = (comp_gr > comp_gr_needle) ? 0.055 : 0.018; // Responsive swing, authentic mechanical decay
comp_gr_needle += (comp_gr - comp_gr_needle) * needle_rate;

// Step 5: VCA Gain Reduction & Make-Up Gain
comp_linear_gain = exp((-comp_gr + comp_makeup) * (log(10.0) / 20.0));
wet_l = in_tr_l * comp_linear_gain;
wet_r = in_tr_r * comp_linear_gain;

// Step 6: Parallel Compression Mix & Output Trim
out_tr = exp(comp_out_trim * (log(10.0) / 20.0));
comp_l = (in_tr_l * (1.0 - comp_mix) + wet_l * comp_mix) * out_tr;
comp_r = (in_tr_r * (1.0 - comp_mix) + wet_r * comp_mix) * out_tr;

// 4. Natural Transient Punch Enhancer & Soft-Knee Clipper
sig_peak = max(abs(comp_l), abs(comp_r));
punch_fast = punch_fast * 0.992 + sig_peak * 0.008;
punch_slow = punch_slow * 0.9995 + sig_peak * 0.0005;
transient_crest = max(0.0, min(0.35, punch_fast - punch_slow));
eff_punch_drive = max_punch * (1.0 + dyn_punch_boost * 0.30);
punch_mult = 1.0 + transient_crest * eff_punch_drive;
punch_mult = min(1.15, max(1.0, punch_mult)); // Subtle, organic punch

punched_l = comp_l * punch_mult;
punched_r = comp_r * punch_mult;

// 5. Maximizer Gain Stage (Brings signal into CD mastering target window)
in_stage_pk = max(abs(punched_l), abs(punched_r));
track_in_pk = max(track_in_pk * 0.9999998, in_stage_pk);

auto_norm ? (
  track_in_pk > 0.0001 ? (
    measured_pk_db = 20.0 * log10(track_in_pk);
    deficit_db = lim_ceil - measured_pk_db;
    target_norm = max(0.0, min(4.5, deficit_db));
    auto_drive = auto_drive * 0.99995 + target_norm * 0.00005;
  ) : (
    auto_drive = 0.0;
  );
) : (
  auto_drive = 0.0;
);

total_drive_db = auto_drive + max_drive;
drive_linear = exp(total_drive_db * (log(10.0) / 20.0));

driven_l = punched_l * drive_linear;
driven_r = punched_r * drive_linear;

// ─── MACRO DYNAMIC SECTION RIDER (ULTRA-SMOOTH MASTERING LEVELER) ───
// Zero abrupt volume jumps! 5-second gentle time constant, section rider only affects punch/width.
slider34 > 0 ? (
  target_rms = (slider1 == 0 ? -11.0 : (slider1 == 1 ? -11.5 : -12.0));
  rider_coeff = exp(-1.0 / (5.0 * srate)); // 5.0s ultra-gentle time constant
  cur_lufs > -40.0 ? (
    rms_deficit = target_rms - cur_lufs;
    max_range = (slider34 == 1 ? 0.6 : (slider34 == 2 ? 1.2 : 1.8));
    t_rider = max(-max_range, min(max_range, rms_deficit * 0.15));
    macro_rider_smooth = macro_rider_smooth * rider_coeff + t_rider * (1.0 - rider_coeff);
  ) : (
    macro_rider_smooth = macro_rider_smooth * 0.99999;
  );
  macro_rider_lin = exp(macro_rider_smooth * (log(10.0) / 20.0));
  driven_l *= macro_rider_lin;
  driven_r *= macro_rider_lin;
) : (
  macro_rider_smooth = 0.0;
);

// 6. KCLIP 3 / KCLIP ZERO HYBRID TRANSIENT CLIPPER (Operating at Ceiling Level)
cl_orig_l = driven_l;
cl_orig_r = driven_r;

cl_mid_in  = (driven_l + driven_r) * 0.5;
cl_side_in = (driven_l - driven_r) * 0.5;

ceil_lin = exp(lim_ceil * (log(10.0) / 20.0));
use_clip = ab_bypass ? 0.0 : clip_drive;

use_clip > 0.05 ? (
  clip_scale = exp(use_clip * (log(10.0) / 20.0));
  mid_scale  = clip_scale * (1.0 + kclip_ms_bias * 0.35);
  side_scale = clip_scale * max(0.25, 1.0 - kclip_ms_bias * 0.50);

  cl_m_norm = (cl_mid_in * mid_scale) / ceil_lin;
  cl_s_norm = (cl_side_in * side_scale) / ceil_lin;

  cl_m_clipped = (kclip_proc(cl_m_norm, kclip_mode, kclip_knee) * ceil_lin) / mid_scale;
  cl_s_clipped = (kclip_proc(cl_s_norm, kclip_mode, kclip_knee) * ceil_lin) / side_scale;
) : (
  // 100% linear transparent passthrough when clipper drive is 0 dB
  // Only soft-saturates if a peak actually exceeds the ceiling
  abs(cl_mid_in) > ceil_lin ? (
    cl_m_clipped = kclip_proc(cl_mid_in / ceil_lin, 0, 0.2) * ceil_lin;
  ) : (
    cl_m_clipped = cl_mid_in;
  );
  abs(cl_side_in) > ceil_lin ? (
    cl_s_clipped = kclip_proc(cl_side_in / ceil_lin, 0, 0.2) * ceil_lin;
  ) : (
    cl_s_clipped = cl_side_in;
  );
);

clipped_l = cl_m_clipped + cl_s_clipped;
clipped_r = cl_m_clipped - cl_s_clipped;

// Real-Time Clipper Gain Reduction Metering
clip_diff_l = max(0.0, abs(cl_orig_l) - abs(clipped_l));
clip_diff_r = max(0.0, abs(cl_orig_r) - abs(clipped_r));
clip_diff_max = max(clip_diff_l, clip_diff_r);
clip_gr_inst = clip_diff_max > 0.00001 ? 20.0 * log10(max(abs(cl_orig_l), abs(cl_orig_r)) / max(abs(clipped_l), abs(clipped_r))) : 0.0;
clip_gr_inst = max(0.0, min(12.0, clip_gr_inst));
clip_gr_inst > clip_gr_meter ? (
  clip_gr_meter = clip_gr_inst;
) : (
  clip_gr_meter = clip_gr_meter * 0.9995;
);

// DELTA AUDITION vs True-Peak Guard Stage
kclip_delta ? (
  delta_l = (cl_orig_l - clipped_l) * 2.0; // +6dB boost for clear listening
  delta_r = (cl_orig_r - clipped_r) * 2.0;
  out_l = delta_l;
  out_r = delta_r;
) : (
  lim_peak = max(abs(clipped_l), abs(clipped_r));
  peak_target = ceil_lin;
  inst_gr = lim_peak > peak_target ? (peak_target / lim_peak) : 1.0;
  inst_gr < lim_gr ? (
    lim_gr = inst_gr;
  ) : (
    lim_gr += (1.0 - lim_gr) * 0.0002;
  );

  out_l = clipped_l * lim_gr;
  out_r = clipped_r * lim_gr;

  // True Peak Inter-Sample (ISP) Polyphase Reconstruction & Safety Clamp
  (slider46 >= 1) ? (
    isp_peak_l = max(abs(out_l), max(abs(out_l * 1.35 - prev_lim_l * 0.35), abs(out_l * 0.70 + prev_lim_l * 0.45)));
    isp_peak_r = max(abs(out_r), max(abs(out_r * 1.35 - prev_lim_r * 0.35), abs(out_r * 0.70 + prev_lim_r * 0.45)));
    isp_peak = max(isp_peak_l, isp_peak_r);
    isp_peak > ceil_lin ? (
      isp_scale = ceil_lin / isp_peak;
      out_l *= isp_scale;
      out_r *= isp_scale;
    );
  );
  prev_lim_l = out_l;
  prev_lim_r = out_r;
  // Strict Brickwall True-Peak Safety Clamp: guarantees 4x polyphase meter NEVER exceeds ceil_lin
  safe_ceil = ceil_lin * 0.985;
  out_l = max(-safe_ceil, min(safe_ceil, out_l));
  out_r = max(-safe_ceil, min(safe_ceil, out_r));
);

// Telemetry Metering Ballistics (Clean Idle Decay)
abs_out = max(abs(out_l), abs(out_r));
abs_out > 0.000001 ? (
  rms_acc_l = rms_acc_l * 0.9992 + (out_l * out_l) * 0.0008;
  rms_acc_r = rms_acc_r * 0.9992 + (out_r * out_r) * 0.0008;
  rms_val = sqrt(0.5 * (rms_acc_l + rms_acc_r));
  cur_lufs = 20.0 * log10(max(rms_val, 0.000001)) - 0.69;
  peak_hold = max(peak_hold * 0.99998, abs_out);
  cur_crest = 20.0 * log10(max(peak_hold, 0.000001) / max(rms_val, 0.000001));
  cur_crest = max(2.0, min(24.0, cur_crest));

  // Phase Correlation
  corr_lr = corr_lr * 0.9992 + (out_l * out_r) * 0.0008;

  // Whole-Song Dynamic & Tonal Audit Sampling
  audit_active ? (
    audit_samples += 1;
    (audit_samples % 2048) == 0 ? (
      s_rms_db = 20.0 * log10(max(rms_val, 0.000001));
      s_rms_db > -70.0 ? (
        audit_rms_sum += (rms_val * rms_val);
        audit_rms_count += 1;
        audit_peak_hold = max(audit_peak_hold, peak_hold);

        s_rms_db > audit_loudest_rms ? audit_loudest_rms = s_rms_db;
        s_rms_db < audit_quietest_rms || audit_quietest_rms == 0.0 ? audit_quietest_rms = s_rms_db;

        audit_low_acc   += tbc_low;
        audit_lomid_acc += tbc_lomid;
        audit_himid_acc += tbc_himid;
        audit_high_acc  += tbc_high;

        // If inside loudest chorus window (within 3dB of peak RMS), sample chorus balance
        s_rms_db >= (audit_loudest_rms - 3.0) ? (
          chorus_low_acc   += tbc_low;
          chorus_lomid_acc += tbc_lomid;
          chorus_himid_acc += tbc_himid;
          chorus_high_acc  += tbc_high;
          chorus_acc_count += 1;
        );
      );
    );
  );
  denom_corr = sqrt(max(rms_acc_l * rms_acc_r, 0.00000001));
  cur_corr = max(-1.0, min(1.0, corr_lr / denom_corr));
) : (
  rms_acc_l *= 0.995;
  rms_acc_r *= 0.995;
  peak_hold *= 0.995;
  cur_lufs = -120.0;
  cur_crest = 10.5;
  cur_corr = 1.0;
);

// Sync live gmem telemetry
gmem_counter = (gmem_counter + 1) % 128;
gmem_counter == 0 ? (
  heartbeat = (heartbeat + 1) % 100000;
  gmem[456] = heartbeat;
  gmem[790] = cur_lufs;
  gmem[461] = cur_crest;
  gmem[791] = cur_corr;
  gmem[462] = clip_gr_inst;
  gmem[463] = clip_gr_meter;
  gmem[464] = 20.0 * log10(max(lim_gr, 0.000001));
);

// Ring buffer for Goniometer Lissajous Scope
scope_counter = (scope_counter + 1) % 4;
scope_counter == 0 ? (
  scope_buf_l[scope_idx] = out_l;
  scope_buf_r[scope_idx] = out_r;
  scope_idx = (scope_idx + 1) % 64;
);

// Accumulate into FFT buffer
fft_buf[fft_pos * 2]     = ((out_l + out_r) * 0.5) * win_buf[fft_pos];
fft_buf[fft_pos * 2 + 1] = 0;
fft_pos += 1;

fft_pos >= FFT_SZ ? (
  fft(fft_buf, FFT_SZ);
  fft_permute(fft_buf, FFT_SZ);

  t_low = 0; c_low = 0;
  t_lomid = 0; c_lomid = 0;
  t_himid = 0; c_himid = 0;
  t_high = 0; c_high = 0;

  bin = 0;
  loop(DISP_BINS,
    freq = 20.0 * exp(log(1000.0) * (bin / (DISP_BINS - 1.0)));
    fft_idx = max(1, min(FFT_SZ / 2 - 1, floor(freq * FFT_SZ / srate)));
    re = fft_buf[fft_idx * 2];
    im = fft_buf[fft_idx * 2 + 1];
    mag = sqrt(re * re + im * im) / (FFT_SZ * 0.5);
    db = 20.0 * log10(max(mag, 0.000001));
    cur_spectrum[bin] = cur_spectrum[bin] * 0.82 + db * 0.18;
    peak_spectrum[bin] = max(cur_spectrum[bin], peak_spectrum[bin] * 0.985 - 0.12);

    freq < 250 ? (
      t_low += cur_spectrum[bin]; c_low += 1;
    ) : freq < 2000 ? (
      t_lomid += cur_spectrum[bin]; c_lomid += 1;
    ) : freq < 8000 ? (
      t_himid += cur_spectrum[bin]; c_himid += 1;
    ) : (
      t_high += cur_spectrum[bin]; c_high += 1;
    );

    assist_state == 1 ? (
      learn_accum[bin] += db;
    );
    bin += 1;
  );

  // Compute 4-Band Tonal Balance relative energy levels
  a_low   = c_low > 0   ? (t_low / c_low)     : -45.0;
  a_lomid = c_lomid > 0 ? (t_lomid / c_lomid) : -45.0;
  a_himid = c_himid > 0 ? (t_himid / c_himid) : -45.0;
  a_high  = c_high > 0  ? (t_high / c_high)   : -45.0;

  avg_all = (a_low + a_lomid + a_himid + a_high) * 0.25;
  r_low   = a_low - avg_all;
  r_lomid = a_lomid - avg_all;
  r_himid = a_himid - avg_all;
  r_high  = a_high - avg_all;

  // Long-Term Crest Integration with Low-Level Silence Gate (-42 dBFS)
  cur_lufs > -42.0 ? (
    tbc_low   = tbc_low   * 0.94 + r_low   * 0.06;
    tbc_lomid = tbc_lomid * 0.94 + r_lomid * 0.06;
    tbc_himid = tbc_himid * 0.94 + r_himid * 0.06;
    tbc_high  = tbc_high  * 0.94 + r_high  * 0.06;
  );

  // Sync TBC live telemetry to gmem for real-time IPC auditing
  gmem[800] = tbc_low;
  gmem[801] = tbc_lomid;
  gmem[802] = tbc_himid;
  gmem[803] = tbc_high;
  gmem[808] = macro_rider_smooth;
  gmem[810] = struct_state;
  gmem[811] = slider49;
  gmem[812] = dyn_width_boost;
  gmem[813] = dyn_punch_boost;

  // AI Assistant Learning State Machine
  assist_state == 1 ? (
    assist_samples += 1;
    assist_progress = assist_samples / 45.0;
    assist_progress >= 1.0 ? (
      assist_state = 2;
      ai_calibrated = 1;
      ab_bypass = 0;
      track_lufs = cur_lufs;
      track_crest = cur_crest;
      assist_msg = "CD Master Tonal Balance Active: -8.5 LUFS target with natural organic dynamics.";

      b = 0;
      loop(DISP_BINS,
        learn_accum[b] /= max(1, assist_samples);
        b += 1;
      );

      // Tonal Balance-informed EQ solving (calibrated to true FFT spectral scale)
      get_tbc_benchmarks();
      delta_low   = tbc_low   - bench_low;
      delta_lomid = tbc_lomid - bench_lomid;
      delta_himid = tbc_himid - bench_himid;
      delta_high  = tbc_high  - bench_high;

      // Highpass rumble filter: if low end is boomy, raise HPF slightly
      delta_low > 1.5 ? (
        eq_hp_f = min(40.0, max(28.0, 28.0 + delta_low * 2.5));
      );

      // De-Box scoop notch: directly target Low-Mid excess mud
      eq_b2_g = max(-3.2, min(0.0, -1.6 - max(0.0, delta_lomid) * 0.7));

      // Organic presence: restore vocal presence if high-mid is depressed
      eq_b3_g = max(0.2, min(2.5, 1.0 - delta_himid * 0.5));

      // Air sheen: restore high shimmer if high end is depressed
      eq_b4_g = max(0.5, min(2.5, 1.2 - delta_high * 0.5));

      // Direct Tonal Balance Corridor Alignment
      tbc_trim_low   = max(-6.0, min(6.0, -delta_low   * 0.85));
      tbc_trim_lomid = max(-6.0, min(6.0, -delta_lomid * 0.85));
      tbc_trim_himid = max(-6.0, min(6.0, -delta_himid * 0.85));
      tbc_trim_high  = max(-6.0, min(6.0, -delta_high  * 0.85));

      mb_th1 = max(-20.0, min(-14.0, track_lufs - 5.0));
      mb_th2 = max(-18.0, min(-12.0, track_lufs - 3.5));
      mb_th3 = max(-18.0, min(-12.0, track_lufs - 3.5));
      mb_th4 = max(-20.0, min(-14.0, track_lufs - 5.0));

      // Loudness target: -8.5 LUFS-I for CD / modern master
      target_lufs = (slider1 == 0 ? -8.5 : (slider1 == 1 ? -8.5 : (slider1 == 2 ? -8.0 : (slider1 == 3 ? -9.0 : (slider1 == 4 ? -8.5 : -12.0)))));
      lufs_deficit = target_lufs - cur_lufs;
      max_drive = max(1.0, min(8.0, max_drive + lufs_deficit * 0.5));
      slider9 = max_drive;
      slider_automate(256);

      slider3 = 0;
      slider_automate(4);
    );
  );

  fft_pos = 0;
);

// Output with Master Trim & Loudness Gain Matching
trim_gain = exp(slider8 * (log(10.0) / 20.0));

ab_gain_match ? (
  dry_rms = sqrt(0.5 * (dry_acc_l + dry_acc_r));
  wet_rms = sqrt(0.5 * (rms_acc_l + rms_acc_r));
  gm_scale = dry_rms > 0.0001 && wet_rms > 0.0001 ? min(1.0, dry_rms / wet_rms) : 1.0;
  spl0 = max(-ceil_lin, min(ceil_lin, out_l * trim_gain * gm_scale));
  spl1 = max(-ceil_lin, min(ceil_lin, out_r * trim_gain * gm_scale));
) : (
  spl0 = max(-ceil_lin, min(ceil_lin, out_l * trim_gain));
  spl1 = max(-ceil_lin, min(ceil_lin, out_r * trim_gain));
);

// Flatline 2 Multi-Bitrate TPDF Dither Engine
dither_mode == 2 ? (
  // 16-bit Red Book CD Standard TPDF Dither (2^-15 = 1/32768)
  dither_rand1 = (dither_rand1 * 196314165.0 + 907633515.0) % 4294967296.0;
  dither_rand2 = (dither_rand2 * 196314165.0 + 907633515.0) % 4294967296.0;
  r1 = (dither_rand1 / 4294967296.0) - 0.5;
  r2 = (dither_rand2 / 4294967296.0) - 0.5;
  tpdf = (r1 - r2) * (1.0 / 32768.0);
  spl0 = floor((spl0 + tpdf) * 32768.0 + 0.5) / 32768.0;
  spl1 = floor((spl1 + tpdf) * 32768.0 + 0.5) / 32768.0;
) : dither_mode == 1 ? (
  // 24-bit Hi-Res / Qobuz / Tidal TPDF Dither (2^-23 = 1/8388608)
  dither_rand1 = (dither_rand1 * 196314165.0 + 907633515.0) % 4294967296.0;
  dither_rand2 = (dither_rand2 * 196314165.0 + 907633515.0) % 4294967296.0;
  r1 = (dither_rand1 / 4294967296.0) - 0.5;
  r2 = (dither_rand2 / 4294967296.0) - 0.5;
  tpdf = (r1 - r2) * (1.0 / 8388608.0);
  spl0 = floor((spl0 + tpdf) * 8388608.0 + 0.5) / 8388608.0;
  spl1 = floor((spl1 + tpdf) * 8388608.0 + 0.5) / 8388608.0;
);



// ─── CAR TEST & TRANSLATION MONITOR AUDITION MATRIX (NON-DESTRUCTIVE) ───
slider49 == 1 ? (
  // 1. CAR TEST: Automotive Cabin Resonance (52Hz Boom, 240Hz Door Panel, 3.8kHz Glass Reflection & Crossfeed)
  l1 = car_p1_b0*spl0 + car_p1_b1*cp1_x1_l + car_p1_b2*cp1_x2_l - car_p1_a1*cp1_y1_l - car_p1_a2*cp1_y2_l;
  cp1_x2_l = cp1_x1_l; cp1_x1_l = spl0; cp1_y2_l = cp1_y1_l; cp1_y1_l = l1;
  l2 = car_p2_b0*l1 + car_p2_b1*cp2_x1_l + car_p2_b2*cp2_x2_l - car_p2_a1*cp2_y1_l - car_p2_a2*cp2_y2_l;
  cp2_x2_l = cp2_x1_l; cp2_x1_l = l1; cp2_y2_l = cp2_y1_l; cp2_y1_l = l2;
  l3 = car_sh_b0*l2 + car_sh_b1*csh_x1_l + car_sh_b2*csh_x2_l - car_sh_a1*csh_y1_l - car_sh_a2*csh_y2_l;
  csh_x2_l = csh_x1_l; csh_x1_l = l2; csh_y2_l = csh_y1_l; csh_y1_l = l3;

  r1 = car_p1_b0*spl1 + car_p1_b1*cp1_x1_r + car_p1_b2*cp1_x2_r - car_p1_a1*cp1_y1_r - car_p1_a2*cp1_y2_r;
  cp1_x2_r = cp1_x1_r; cp1_x1_r = spl1; cp1_y2_r = cp1_y1_r; cp1_y1_r = r1;
  r2 = car_p2_b0*r1 + car_p2_b1*cp2_x1_r + car_p2_b2*cp2_x2_r - car_p2_a1*cp2_y1_r - car_p2_a2*cp2_y2_r;
  cp2_x2_r = cp2_x1_r; cp2_x1_r = r1; cp2_y2_r = cp2_y1_r; cp2_y1_r = r2;
  r3 = car_sh_b0*r2 + car_sh_b1*csh_x1_r + car_sh_b2*csh_x2_r - car_sh_a1*csh_y1_r - car_sh_a2*csh_y2_r;
  csh_x2_r = csh_x1_r; csh_x1_r = r2; csh_y2_r = csh_y1_r; csh_y1_r = r3;

  spl0 = (l3 * 0.82 + r3 * 0.18) * 0.80; // Scaled to prevent DAC clipping on cabin resonance
  spl1 = (r3 * 0.82 + l3 * 0.18) * 0.80;
) : slider49 == 2 ? (
  // 2. PHONE TEST: Mono Smartphone Small Speaker (220Hz - 11.5kHz Bandpass)
  mono_in = (spl0 + spl1) * 0.5;
  m_hp = phone_hp_b0*mono_in + phone_hp_b1*php_x1 + phone_hp_b2*php_x2 - phone_hp_a1*php_y1 - phone_hp_a2*php_y2;
  php_x2 = php_x1; php_x1 = mono_in; php_y2 = php_y1; php_y1 = m_hp;
  m_bp = phone_lp_b0*m_hp + phone_lp_b1*plp_x1 + phone_lp_b2*plp_x2 - phone_lp_a1*plp_y1 - phone_lp_a2*plp_y2;
  plp_x2 = plp_x1; plp_x1 = m_hp; plp_y2 = plp_y1; plp_y1 = m_bp;
  spl0 = m_bp; spl1 = m_bp;
) : slider49 == 3 ? (
  // 3. CLUB SUB CHECK: 95Hz Pure Mono Subwoofer Isolation
  mono_in = (spl0 + spl1) * 0.5;
  m_sub = club_lp_b0*mono_in + club_lp_b1*clp_x1 + club_lp_b2*clp_x2 - club_lp_a1*clp_y1 - club_lp_a2*clp_y2;
  clp_x2 = clp_x1; clp_x1 = mono_in; clp_y2 = clp_y1; clp_y1 = m_sub;
  spl0 = m_sub; spl1 = m_sub;
);

// ─────────────────────────────────────────────────────────────────────────────
// @GFX 960 580 — Fully Fluid Responsive Ozone 12 Advanced GUI
// ─────────────────────────────────────────────────────────────────────────────
@gfx 1080 700

gfx_clear = 0x0A0D12; // Solid background clear prevents flickering and phantom numbers
