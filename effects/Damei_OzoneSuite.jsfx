file_var(0, prev_producer_preset);
file_var(0, slider47);
file_var(0, slider48);

eq_hp_f <= 0 ? eq_hp_f = 28.0;
eq_b2_f <= 0 ? (eq_b2_f = 320.0; eq_b2_q = 1.4;);
eq_b3_f <= 0 ? (eq_b3_f = 3000.0; eq_b3_q = 1.4;);
eq_b4_f <= 0 ? (eq_b4_f = 11000.0; eq_b4_q = 0.7071;);
file_var(0, slider50);

@init
ext_noinit = 1;
is_user_customized = 0;
b1_env_fast = 0;
b1_env_slow = 0;
prev_lim_l = 0;
prev_lim_r = 0; // Preserve user moves, AI decisions & filter state across window focus and transport events

FFT_SZ    = 4096;
DISP_BINS = 256;

// Memory layout
fft_buf       = 0;
win_buf       = FFT_SZ * 2;
corridor_mean = win_buf + FFT_SZ;
corridor_low  = corridor_mean + DISP_BINS;
corridor_high = corridor_low + DISP_BINS;
cur_spectrum  = corridor_high + DISP_BINS;
peak_spectrum = cur_spectrum + DISP_BINS;
learn_accum   = peak_spectrum + DISP_BINS;
eq_curve_buf  = learn_accum + DISP_BINS;
scope_buf_l   = eq_curve_buf + DISP_BINS;
scope_buf_r   = scope_buf_l + 128;

fft_pos       = 0;
heartbeat     = 0;
scope_idx     = 0;

// Master EQ default calibrated frequencies
eq_hp_f = 28.0;
eq_b2_f = 320.0; eq_b2_g = -1.8; eq_b2_q = 1.4;
eq_b3_f = 3000.0; eq_b3_g = 1.0; eq_b3_q = 1.4;
eq_b4_f = 11000.0; eq_b4_g = 1.2; eq_b4_q = 0.7071;
scope_counter = 0;
eq_drag       = 0;
prev_mouse_down = 0;

b = 0;
loop(DISP_BINS,
  cur_spectrum[b] = -60.0;
  peak_spectrum[b] = -60.0;
  b += 1;
);

// Precompute Hann window
i = 0;
loop(FFT_SZ,
  win_buf[i] = 0.5 * (1.0 - cos(2.0 * $pi * i / (FFT_SZ - 1)));
  i += 1;
);

// BUSTERse & HoRNet H4K SSL 4000 VCA Bus Compressor Variables
comp_thresh  = -16.0;
comp_ratio   = 3.0;
comp_attack  = 30.0;
comp_release = 0.0; // 0.0 = Auto Release
comp_makeup  = 2.0;
sc_hpf_f     = 120.0;
comp_mix     = 1.0;
comp_in_trim = 0.0;
comp_out_trim= 0.0;
comp_gr_needle = 0.0;

// Whole Song Dynamic & Tonal Audit Engine
audit_active          = 0;
audit_mode            = 0;
audit_samples         = 0;
audit_loudest_rms     = -120.0;
audit_quietest_rms    = 0.0;
audit_peak_hold       = 0.0;
audit_rms_sum         = 0.0;
audit_rms_count       = 0;
audit_low_acc         = 0;
audit_lomid_acc       = 0;
audit_himid_acc       = 0;
audit_high_acc        = 0;
chorus_low_acc        = 0;
chorus_lomid_acc      = 0;
chorus_himid_acc      = 0;
chorus_high_acc       = 0;
chorus_acc_count      = 0;

// Ballistics & metering variables
rms_acc_l = 0;
rms_acc_r = 0;
corr_lr   = 0;
peak_hold = 0;
cur_lufs  = -120;
cur_crest = 10.5;
cur_corr  = 1.0;
track_in_pk = 0.0;
auto_drive = 0.0;

// Tonal Balance Control variables & target benchmarks (-8.5 LUFS CD Master)
tbc_low = 11.5;
tbc_lomid = 7.8;
tbc_himid = -2.2;
tbc_high = -17.2;
!is_initialized ? (
  is_initialized = 1;
  tbc_trim_low   = slider35;
  tbc_trim_lomid = slider36;
  tbc_trim_himid = slider37;
  tbc_trim_high  = slider38;
  eq_hp_f        = slider39 > 0 ? slider39 : 28.0;
  eq_b2_g        = slider40 != 0 ? slider40 : -1.8;
  eq_b3_g        = slider41 != 0 ? slider41 : 1.2;
  eq_b4_g        = slider42 != 0 ? slider42 : 1.4;
);

// Flatline 2 & Mastering Suite Engine Variables
dither_mode   = 2; // 0=Off, 1=24-bit, 2=16-bit TPDF
dc_filter_on  = 1; // 15 Hz steep DC offset filter
fl_shape      = 0.50; // 50% Flatline 2 asymptotic shape
cl_link       = 1.0; // 100% stereo linked
os_quality    = 1;   // 2x online oversampling
chug_guard_on = 1;   // Guitar chug low-mid resonance tamer
sub_guard_on   = 1;   // Adaptive sub-bass bloom tamer
sub_gr         = 0.0;
genre_profile = 1;   // 0=Pop, 1=Rock, 2=Metal, 3=EDM, 4=Hip-Hop, 5=Jazz, 6=Balanced
chug_gr       = 0.0;
macro_rider_gain = 0.0;
macro_rider_smooth = 0.0;
prev_producer_preset = -1;
struct_slow_rms = -18.0;
struct_fast_rms = -18.0;
struct_hi_nrg = 2.0;
struct_state = 0;
chorus_hold_timer = 0;
dyn_width_boost = 0.0;
dyn_punch_boost = 0.0;
dyn_air_boost = 0.0;
dyn_sub_boost = 0.0;
t_struct_rider = 0.0;
crt_phase     = 0.0;
dither_rand1  = 0.12345;
dither_rand2  = 0.67890;

// DC Offset 15 Hz Biquad Filters (Left & Right)
dc_hp_x1_l = 0; dc_hp_x2_l = 0; dc_hp_y1_l = 0; dc_hp_y2_l = 0;
dc_hp_x1_r = 0; dc_hp_x2_r = 0; dc_hp_y1_r = 0; dc_hp_y2_r = 0;

// KClip 3 / KClip Zero Hybrid Engine
kclip_mode    = 0; // 0=Smooth (Zero), 1=Crisp, 2=Tape, 3=Tube
kclip_knee    = 0.35; // 35% softness
kclip_ms_bias = 0.75; // 75% Mid Bias (Center Transient Shaving)
kclip_delta   = 0;    // Delta solo off
clip_gr_meter = 0.0;
ab_gain_match = 0;
ab_state      = 0;
dry_acc_l     = 0.0;
dry_acc_r     = 0.0;

// Sidechain 120 Hz HPF for Master Glue Compressor (Anti-Ducking)
sc_hpf_f = 120.0;
sc_x1_l = 0; sc_x2_l = 0; sc_y1_l = 0; sc_y2_l = 0;
sc_x1_r = 0; sc_x2_r = 0; sc_y1_r = 0; sc_y2_r = 0;

// TBC Low-Shelf Trim Variables
ls_x1_l = 0; ls_x2_l = 0; ls_y1_l = 0; ls_y2_l = 0;
ls_x1_r = 0; ls_x2_r = 0; ls_y1_r = 0; ls_y2_r = 0;

// AI Assistant state machine
assist_state = 0; // 0=idle, 1=listening, 2=done
assist_timer = 0;
assist_samples = 0;
assist_progress = 0.0;
assist_msg = "CD Master Target (-8.5 LUFS / -1.0 dBTP). Press RUN AI ASSISTANT during audio playback.";
ab_bypass     = 0;

// Crossover Frequencies
mb_xo1_f = 140.0;
mb_xo2_f = 1200.0;
mb_xo3_f = 6500.0;

// Biquad coefficient calculation helpers

// ─────────────────────────────────────────────────────────────────────────────
// TRANSLATION & MONITORING FILTERS
// ─────────────────────────────────────────────────────────────────────────────
function init_translation_filters() (
  // 1. Car Cabin Standing Wave Resonance: Peak EQ at 52 Hz, +5.0 dB, Q = 1.6
  f0_c = 52.0; gain_c = 5.0; q_c = 1.6;
  a_c = exp(gain_c * (log(10.0) / 40.0));
  w0_c = 2.0 * $pi * f0_c / srate;
  cos_c = cos(w0_c); sin_c = sin(w0_c);
  alpha_c = sin_c / (2.0 * q_c);
  b0_c = 1.0 + alpha_c * a_c; b1_c = -2.0 * cos_c; b2_c = 1.0 - alpha_c * a_c;
  a0_c = 1.0 + alpha_c / a_c; a1_c = -2.0 * cos_c; a2_c = 1.0 - alpha_c / a_c;
  car_p1_b0 = b0_c/a0_c; car_p1_b1 = b1_c/a0_c; car_p1_b2 = b2_c/a0_c;
  car_p1_a1 = a1_c/a0_c; car_p1_a2 = a2_c/a0_c;

  // 2. Door Panel Cavity Resonance: Peak EQ at 240 Hz, +2.2 dB, Q = 2.0
  f0_d = 240.0; gain_d = 2.2; q_d = 2.0;
  a_d = exp(gain_d * (log(10.0) / 40.0));
  w0_d = 2.0 * $pi * f0_d / srate;
  cos_d = cos(w0_d); sin_d = sin(w0_d);
  alpha_d = sin_d / (2.0 * q_d);
  b0_d = 1.0 + alpha_d * a_d; b1_d = -2.0 * cos_d; b2_d = 1.0 - alpha_d * a_d;
  a0_d = 1.0 + alpha_d / a_d; a1_d = -2.0 * cos_d; a2_d = 1.0 - alpha_d / a_d;
  car_p2_b0 = b0_d/a0_d; car_p2_b1 = b1_d/a0_d; car_p2_b2 = b2_d/a0_d;
  car_p2_a1 = a1_d/a0_d; car_p2_a2 = a2_d/a0_d;

  // 3. Windshield Glass Reflection Tilt: High-Shelf at 3.8 kHz, +2.5 dB, Q = 0.8
  f0_g = 3800.0; gain_g = 2.5; q_g = 0.8;
  a_g = exp(gain_g * (log(10.0) / 40.0));
  w0_g = 2.0 * $pi * f0_g / srate;
  cos_g = cos(w0_g); sin_g = sin(w0_g);
  alpha_g = sin_g / (2.0 * q_g);
  two_sqrt_a_alpha = 2.0 * sqrt(a_g) * alpha_g;
  b0_g = a_g * ((a_g + 1.0) + (a_g - 1.0)*cos_g + two_sqrt_a_alpha);
  b1_g = -2.0 * a_g * ((a_g - 1.0) + (a_g + 1.0)*cos_g);
  b2_g = a_g * ((a_g + 1.0) + (a_g - 1.0)*cos_g - two_sqrt_a_alpha);
  a0_g = (a_g + 1.0) - (a_g - 1.0)*cos_g + two_sqrt_a_alpha;
  a1_g = 2.0 * ((a_g - 1.0) - (a_g + 1.0)*cos_g);
  a2_g = (a_g + 1.0) - (a_g - 1.0)*cos_g - two_sqrt_a_alpha;
  car_sh_b0 = b0_g/a0_g; car_sh_b1 = b1_g/a0_g; car_sh_b2 = b2_g/a0_g;
  car_sh_a1 = a1_g/a0_g; car_sh_a2 = a2_g/a0_g;

  // 4. Phone Speaker Bandpass: 220Hz HPF & 11.5kHz LPF
  w0_php = 2.0 * $pi * 220.0 / srate;
  cos_php = cos(w0_php); alpha_php = sin(w0_php) / (2.0 * 0.7071);
  php_a0 = 1.0 + alpha_php;
  phone_hp_b0 = ((1.0 + cos_php)*0.5) / php_a0;
  phone_hp_b1 = (-(1.0 + cos_php)) / php_a0;
  phone_hp_b2 = ((1.0 + cos_php)*0.5) / php_a0;
  phone_hp_a1 = (-2.0 * cos_php) / php_a0;
  phone_hp_a2 = (1.0 - alpha_php) / php_a0;

  w0_plp = 2.0 * $pi * 11500.0 / srate;
  cos_plp = cos(w0_plp); alpha_plp = sin(w0_plp) / (2.0 * 0.7071);
  plp_a0 = 1.0 + alpha_plp;
  phone_lp_b0 = ((1.0 - cos_plp)*0.5) / plp_a0;
  phone_lp_b1 = (1.0 - cos_plp) / plp_a0;
  phone_lp_b2 = ((1.0 - cos_plp)*0.5) / plp_a0;
  phone_lp_a1 = (-2.0 * cos_plp) / plp_a0;
  phone_lp_a2 = (1.0 - alpha_plp) / plp_a0;

  // 5. Club Subwoofer Check: 95Hz LPF (Butterworth)
  w0_clp = 2.0 * $pi * 95.0 / srate;
  cos_clp = cos(w0_clp); alpha_clp = sin(w0_clp) / (2.0 * 0.7071);
  clp_a0 = 1.0 + alpha_clp;
  club_lp_b0 = ((1.0 - cos_clp)*0.5) / clp_a0;
  club_lp_b1 = (1.0 - cos_clp) / clp_a0;
  club_lp_b2 = ((1.0 - cos_clp)*0.5) / clp_a0;
  club_lp_a1 = (-2.0 * cos_clp) / clp_a0;
  club_lp_a2 = (1.0 - alpha_clp) / clp_a0;
);
init_translation_filters();

// ═════════════════════════════════════════════════════════════════════════════
// MASTERING ENGINEERS PLAYBOOK & TACTICAL HEURISTICS
// ═════════════════════════════════════════════════════════════════════════════
function get_playbook_name(idx) (
  idx == 0  ? "Default Modern Metal Clean (2026 Reference)" :
  idx == 1  ? "Lance Prenc (Prenc Audio Melbourne)" :
  idx == 2  ? "Scott Seigel (DIESECT Production)" :
  idx == 3  ? "Jonathan Dolese (Konkrete Studios)" :
  idx == 4  ? "Buster Odeholm (Odeholm Audio / Impact)" :
  idx == 5  ? "Grant Berry (Fader Mastering UK)" :
  idx == 6  ? "Robin Schmidt & Grant Berry (Split Chain)" :
  idx == 7  ? "Ted Jensen (Sterling Sound Nashville)" :
  idx == 8  ? "Robin Schmidt (24-96 Mastering Germany)" :
