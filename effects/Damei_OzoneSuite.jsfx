b_l_hov = (mouse_x >= btn_l_x && mouse_x <= btn_l_x + btn_w && mouse_y >= 25 && mouse_y <= 55);
gfx_r = b_l_hov ? 0.20 : 0.10; gfx_g = b_l_hov ? 0.28 : 0.15; gfx_b = b_l_hov ? 0.38 : 0.22;
gfx_rect(btn_l_x, 25, btn_w, 30);
gfx_r = 0.24; gfx_g = 0.34; gfx_b = 0.46;
gfx_rect(btn_l_x, 25, btn_w, 30, 0);
gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
