  b2_minus = (mouse_x >= c2_x + 10 && mouse_x <= c2_x + 54 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  b2_plus  = (mouse_x >= c2_x + 62 && mouse_x <= c2_x + 106 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = b2_minus ? 0.22 : 0.12; gfx_g = b2_minus ? 0.26 : 0.14; gfx_b = b2_minus ? 0.35 : 0.18;
  gfx_rect(c2_x + 10, card_btn_y, 48, 30);
  gfx_r = b2_plus ? 0.22 : 0.12; gfx_g = b2_plus ? 0.26 : 0.14; gfx_b = b2_plus ? 0.35 : 0.18;
  gfx_rect(c2_x + 66, card_btn_y, 48, 30);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_setfont(1, "Consolas", 18, 'b');
  gfx_x = c2_x + 28; gfx_y = card_btn_y + 5; gfx_drawstr("-");
  gfx_setfont(1, "Consolas", 18, 'b');
  gfx_x = c2_x + 84; gfx_y = card_btn_y + 5; gfx_drawstr("+");
  mouse_clicked && b2_minus ? (is_user_customized = 1; eq_b2_g = max(-12.0, eq_b2_g - 0.2); update_filters(););
  mouse_clicked && b2_plus  ? (is_user_customized = 1; eq_b2_g = min(12.0, eq_b2_g + 0.2); update_filters(););

  // Card 3: Vocal Presence
  c3_x = dock_x + 18 + eq_c_w * 2;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c3_x, dock_y + 8, eq_c_w, dock_h - 16);
  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c3_x + 10; gfx_y = dock_y + 14;
  gfx_setfont(1, "Bahnschrift", 15, 'b');
  gfx_drawstr("BAND 3: ORGANIC PRESENCE");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Orbitron", 18, 'b');
  gfx_x = c3_x + 10; gfx_y = dock_y + 38;
  gfx_printf("%.0f Hz  %+.1f dB", eq_b3_f, eq_b3_g);

  b3_minus = (mouse_x >= c3_x + 10 && mouse_x <= c3_x + 54 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  b3_plus  = (mouse_x >= c3_x + 62 && mouse_x <= c3_x + 106 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = b3_minus ? 0.22 : 0.12; gfx_g = b3_minus ? 0.26 : 0.14; gfx_b = b3_minus ? 0.35 : 0.18;
  gfx_rect(c3_x + 10, card_btn_y, 48, 30);
  gfx_r = b3_plus ? 0.22 : 0.12; gfx_g = b3_plus ? 0.26 : 0.14; gfx_b = b3_plus ? 0.35 : 0.18;
  gfx_rect(c3_x + 66, card_btn_y, 48, 30);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_setfont(1, "Consolas", 18, 'b');
  gfx_x = c3_x + 28; gfx_y = card_btn_y + 5; gfx_drawstr("-");
  gfx_setfont(1, "Consolas", 18, 'b');
  gfx_x = c3_x + 84; gfx_y = card_btn_y + 5; gfx_drawstr("+");
  mouse_clicked && b3_minus ? (is_user_customized = 1; eq_b3_g = max(-12.0, eq_b3_g - 0.2); update_filters(););
  mouse_clicked && b3_plus  ? (is_user_customized = 1; eq_b3_g = min(12.0, eq_b3_g + 0.2); update_filters(););

  // Card 4: Air Sheen
  c4_x = dock_x + 24 + eq_c_w * 3;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c4_x, dock_y + 8, eq_c_w, dock_h - 16);
  gfx_r = 0.85; gfx_g = 0.40; gfx_b = 1.00;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c4_x + 10; gfx_y = dock_y + 14;
  gfx_setfont(1, "Bahnschrift", 15, 'b');
  gfx_drawstr("BAND 4: AIR SHEEN");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Orbitron", 18, 'b');
  gfx_x = c4_x + 10; gfx_y = dock_y + 38;
  gfx_printf("%.1f kHz  %+.1f dB", eq_b4_f/1000, eq_b4_g);

  b4_minus = (mouse_x >= c4_x + 10 && mouse_x <= c4_x + 54 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  b4_plus  = (mouse_x >= c4_x + 62 && mouse_x <= c4_x + 106 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = b4_minus ? 0.22 : 0.12; gfx_g = b4_minus ? 0.26 : 0.14; gfx_b = b4_minus ? 0.35 : 0.18;
  gfx_rect(c4_x + 10, card_btn_y, 48, 30);
  gfx_r = b4_plus ? 0.22 : 0.12; gfx_g = b4_plus ? 0.26 : 0.14; gfx_b = b4_plus ? 0.35 : 0.18;
  gfx_rect(c4_x + 66, card_btn_y, 48, 30);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_setfont(1, "Consolas", 18, 'b');
  gfx_x = c4_x + 28; gfx_y = card_btn_y + 5; gfx_drawstr("-");
  gfx_setfont(1, "Consolas", 18, 'b');
  gfx_x = c4_x + 84; gfx_y = card_btn_y + 5; gfx_drawstr("+");
  mouse_clicked && b4_minus ? (is_user_customized = 1; eq_b4_g = max(-12.0, eq_b4_g - 0.2); update_filters(););
  mouse_clicked && b4_plus  ? (is_user_customized = 1; eq_b4_g = min(12.0, eq_b4_g + 0.2); update_filters(););
) :

// ─── DOCK: TAB 3 (BUSTERse / H4K SSL BUS COMPRESSOR CONTROLS) ───
slider2 == 3 ? (
  d_c_w = (dock_w - 30) / 4;

  // Card 1: THRESHOLD & RATIO
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(dock_x + 6, dock_y + 8, d_c_w, dock_h - 16);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = dock_x + 16; gfx_y = dock_y + 14;
  gfx_drawstr("THRESHOLD & RATIO");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 16, 'b');
  gfx_x = dock_x + 16; gfx_y = dock_y + 38;
  gfx_printf("%.1f dB  |  %.1f:1", comp_thresh, comp_ratio);

  // Steppers for Threshold
  t_m = (mouse_x >= dock_x + 16 && mouse_x <= dock_x + 52 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  t_p = (mouse_x >= dock_x + 58 && mouse_x <= dock_x + 94 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = t_m ? 0.22 : 0.12; gfx_g = t_m ? 0.26 : 0.14; gfx_b = t_m ? 0.35 : 0.18;
  gfx_rect(dock_x + 16, card_btn_y, 36, 26);
  gfx_r = t_p ? 0.22 : 0.12; gfx_g = t_p ? 0.26 : 0.14; gfx_b = t_p ? 0.35 : 0.18;
  gfx_rect(dock_x + 58, card_btn_y, 36, 26);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = dock_x + 30; gfx_y = card_btn_y + 5; gfx_drawstr("-");
  gfx_x = dock_x + 72; gfx_y = card_btn_y + 5; gfx_drawstr("+");
  mouse_clicked && t_m ? (is_user_customized = 1; comp_thresh = max(-36.0, comp_thresh - 0.5); slider11 = comp_thresh; slider_automate(1024););
  mouse_clicked && t_p ? (is_user_customized = 1; comp_thresh = min(0.0, comp_thresh + 0.5); slider11 = comp_thresh; slider_automate(1024););

  // Quick Ratio Selector Pills: 1.5, 2, 3, 4, 10
  rp_i = 0;
  loop(5,
    rv = (rp_i==0?1.5:(rp_i==1?2.0:(rp_i==2?3.0:(rp_i==3?4.0:10.0))));
    rx = dock_x + 100 + rp_i * 26;
    sel_r = (abs(comp_ratio - rv) < 0.1);
    gfx_r = sel_r ? 0.00 : 0.11; gfx_g = sel_r ? 0.55 : 0.13; gfx_b = sel_r ? 0.85 : 0.18;
    gfx_rect(rx, card_btn_y, 24, 26);
    gfx_r = sel_r ? 1.0 : 0.70; gfx_g = sel_r ? 1.0 : 0.75; gfx_b = sel_r ? 1.0 : 0.85;
    gfx_setfont(1, "Bahnschrift", 14, sel_r ? 'b' : 0);
    rtxt = (rp_i==0?"1.5":(rp_i==1?"2":(rp_i==2?"3":(rp_i==3?"4":"10"))));
    gfx_measurestr(rtxt, rtw, rth);
    gfx_x = rx + (24 - rtw) * 0.5; gfx_y = card_btn_y + 6;
    gfx_drawstr(rtxt);
    mouse_clicked && (mouse_x >= rx && mouse_x <= rx + 24 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26) ? (
      comp_ratio = rv; slider12 = rp_i; slider_automate(2048);
    );
    rp_i += 1;
  );

  // Card 2: ATTACK & RELEASE
  c2_x = dock_x + 12 + d_c_w;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c2_x, dock_y + 8, d_c_w, dock_h - 16);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = c2_x + 10; gfx_y = dock_y + 14;
  gfx_drawstr("ATTACK & RELEASE");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 16, 'b');
  gfx_x = c2_x + 10; gfx_y = dock_y + 38;
  gfx_printf("%.1f ms  |  %s", comp_attack, comp_release<=0?"AUTO":sprintf(#, "%.1fs", comp_release));

  // Attack Quick Selectors (6 pills dynamically sized to d_c_w)
  ap_w = floor((d_c_w - 24) / 6);
  ap_i = 0;
  loop(6,
    av = (ap_i==0?0.1:(ap_i==1?0.3:(ap_i==2?1.0:(ap_i==3?3.0:(ap_i==4?10.0:30.0)))));
    ax = c2_x + 10 + ap_i * ap_w;
    sel_a = (abs(comp_attack - av) < 0.05);
    gfx_r = sel_a ? 0.00 : 0.11; gfx_g = sel_a ? 0.55 : 0.13; gfx_b = sel_a ? 0.85 : 0.18;
    gfx_rect(ax, card_btn_y, ap_w - 2, 26);
    gfx_r = sel_a ? 1.0 : 0.70; gfx_g = sel_a ? 1.0 : 0.75; gfx_b = sel_a ? 1.0 : 0.85;
    gfx_setfont(1, "Bahnschrift", 13, sel_a ? 'b' : 0);
    atxt = (ap_i==0?".1":(ap_i==1?".3":(ap_i==2?"1":(ap_i==3?"3":(ap_i==4?"10":"30")))));
    gfx_measurestr(atxt, atw, ath);
    gfx_x = ax + (ap_w - 2 - atw) * 0.5; gfx_y = card_btn_y + 6;
    gfx_drawstr(atxt);
    mouse_clicked && (mouse_x >= ax && mouse_x <= ax + ap_w - 2 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26) ? (
      comp_attack = av; slider13 = ap_i; slider_automate(4096);
    );
    ap_i += 1;
  );

  // Card 3: SIDECHAIN HPF & MAKEUP
  c3_x = dock_x + 18 + d_c_w * 2;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c3_x, dock_y + 8, d_c_w, dock_h - 16);
  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.50;
  gfx_setfont(1, "Orbitron", 15, 'b');
  gfx_x = c3_x + 10; gfx_y = dock_y + 14;
  gfx_drawstr("SC HPF & MAKEUP");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 16, 'b');
  gfx_x = c3_x + 10; gfx_y = dock_y + 38;
  gfx_printf("%d Hz HPF  |  +%.1f dB", sc_hpf_f, comp_makeup);

  // HPF Filter Selectors (5 pills dynamically sized to leave room for Makeup steppers)
  hp_w = floor((d_c_w - 74) / 5);
  hp_i = 0;
  loop(5,
    hv = (hp_i==0?30:(hp_i==1?60:(hp_i==2?90:(hp_i==3?120:180))));
    hx = c3_x + 8 + hp_i * hp_w;
    sel_h = (abs(sc_hpf_f - hv) < 5);
    gfx_r = sel_h ? 0.20 : 0.11; gfx_g = sel_h ? 0.75 : 0.13; gfx_b = sel_h ? 0.40 : 0.18;
    gfx_rect(hx, card_btn_y, hp_w - 2, 26);
    gfx_r = sel_h ? 1.0 : 0.70; gfx_g = sel_h ? 1.0 : 0.75; gfx_b = sel_h ? 1.0 : 0.85;
    gfx_setfont(1, "Bahnschrift", 13, sel_h ? 'b' : 0);
    htxt = sprintf(#, "%d", hv);
    gfx_measurestr(htxt, htw, hth);
    gfx_x = hx + (hp_w - 2 - htw) * 0.5; gfx_y = card_btn_y + 6;
    gfx_drawstr(htxt);
    mouse_clicked && (mouse_x >= hx && mouse_x <= hx + hp_w - 2 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26) ? (
      sc_hpf_f = hv; slider16 = hv; slider_automate(32768); update_filters();
    );
    hp_i += 1;
  );

  // Makeup Gain Steppers [-] [+] safely placed inside right edge of Card 3
  mk_x1 = c3_x + 8 + 5 * hp_w + 4;
  mk_m = (mouse_x >= mk_x1 && mouse_x <= mk_x1 + 24 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  mk_p = (mouse_x >= mk_x1 + 28 && mouse_x <= mk_x1 + 52 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = mk_m ? 0.22 : 0.12; gfx_g = mk_m ? 0.26 : 0.14; gfx_b = mk_m ? 0.35 : 0.18;
  gfx_rect(mk_x1, card_btn_y, 24, 26);
  gfx_r = mk_p ? 0.22 : 0.12; gfx_g = mk_p ? 0.26 : 0.14; gfx_b = mk_p ? 0.35 : 0.18;
  gfx_rect(mk_x1 + 28, card_btn_y, 24, 26);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Consolas", 16, 'b');
  gfx_x = mk_x1 + 8; gfx_y = card_btn_y + 5; gfx_drawstr("-");
  gfx_x = mk_x1 + 36; gfx_y = card_btn_y + 5; gfx_drawstr("+");
  mouse_clicked && mk_m ? (is_user_customized = 1; comp_makeup = max(0.0, comp_makeup - 0.5); slider15 = comp_makeup; slider_automate(16384););
  mouse_clicked && mk_p ? (is_user_customized = 1; comp_makeup = min(15.0, comp_makeup + 0.5); slider15 = comp_makeup; slider_automate(16384););

  // Card 4: MASTERING BASS CONTROL & AUTO-SOLVE DYNAMICS (CLEAN & BALANCED)
  c4_x = dock_x + 24 + d_c_w * 3;
  gfx_r = 0.045; gfx_g = 0.058; gfx_b = 0.078;
  gfx_rect(c4_x, dock_y + 8, d_c_w, dock_h - 16);
  gfx_r = 1.00; gfx_g = 0.72; gfx_b = 0.15;
  gfx_setfont(1, "Orbitron", 13, 'b');
  gfx_x = c4_x + 10; gfx_y = dock_y + 14;
  gfx_drawstr("BASS CONTROL");

  // Top right crest factor badge (clean pill, no overlap)
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Consolas", 12, 'b');
  mc_str = sprintf(#, "Cr: %.1fdB", cur_crest);
  gfx_measurestr(mc_str, mcw, mch);
  gfx_x = c4_x + d_c_w - mcw - 10; gfx_y = dock_y + 14;
  gfx_drawstr(mc_str);

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 14, 'b');
  gfx_x = c4_x + 10; gfx_y = dock_y + 38;
  gfx_printf("Punch: %+.1fdB | Sust: %+.1fdB", slider44, slider45);

  // Steppers for Bass Punch (Left Side)
  bp_m = (mouse_x >= c4_x + 10 && mouse_x <= c4_x + 36 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  bp_p = (mouse_x >= c4_x + 40 && mouse_x <= c4_x + 66 && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = bp_m ? 0.25 : 0.12; gfx_g = 0.16; gfx_b = 0.22;
  gfx_rect(c4_x + 10, card_btn_y, 26, 26);
  gfx_rect(c4_x + 40, card_btn_y, 26, 26);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Consolas", 16, 'b');
  gfx_x = c4_x + 18; gfx_y = card_btn_y + 5; gfx_drawstr("-");
  gfx_x = c4_x + 48; gfx_y = card_btn_y + 5; gfx_drawstr("+");
  mouse_clicked && bp_m ? (is_user_customized = 1; slider44 = max(-6.0, slider44 - 0.5); slider_automate(17592186044416););
  mouse_clicked && bp_p ? (is_user_customized = 1; slider44 = min(6.0, slider44 + 0.5); slider_automate(17592186044416););

  // Auto-Solve Dynamics Button (Right Side, No Overlap!)
  as_w = d_c_w - 78;
  as_x = c4_x + 72;
  as_hover = (mouse_x >= as_x && mouse_x <= as_x + as_w && mouse_y >= card_btn_y && mouse_y <= card_btn_y + 26);
  gfx_r = as_hover ? 0.00 : 0.08; gfx_g = as_hover ? 0.85 : 0.65; gfx_b = as_hover ? 0.50 : 0.40;
  gfx_rect(as_x, card_btn_y, as_w, 26);
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Bahnschrift", 13, 'b');
  as_txt = "★ AUTO-SOLVE";
  gfx_measurestr(as_txt, as_tw, as_th);
  gfx_x = as_x + (as_w - as_tw) * 0.5; gfx_y = card_btn_y + 6;
  gfx_drawstr(as_txt);

  mouse_clicked && as_hover ? (
    cur_crest > 13.0 ? (
      comp_ratio = 3.0; slider12 = 2;
      comp_thresh = max(-24.0, min(-14.0, cur_lufs + 5.0));
      comp_attack = 30.0; slider13 = 5;
      comp_release = 0.0; slider14 = 4;
      sc_hpf_f = 120.0; slider16 = 120.0;
      comp_makeup = 2.0; slider15 = 2.0;
      comp_mix = 1.0; slider17 = 100;
    ) : cur_crest > 10.5 ? (
      comp_ratio = 2.0; slider12 = 1;
      comp_thresh = max(-22.0, min(-12.0, cur_lufs + 4.0));
      comp_attack = 30.0; slider13 = 5;
      comp_release = 0.3; slider14 = 1;
      sc_hpf_f = 90.0; slider16 = 90.0;
      comp_makeup = 1.2; slider15 = 1.2;
      comp_mix = 1.0; slider17 = 100;
    ) : (
      comp_ratio = 1.5; slider12 = 0;
      comp_thresh = max(-18.0, min(-10.0, cur_lufs + 3.0));
      comp_attack = 30.0; slider13 = 5;
      comp_release = 0.1; slider14 = 0;
      sc_hpf_f = 60.0; slider16 = 60.0;
      comp_makeup = 0.5; slider15 = 0.5;
      comp_mix = 1.0; slider17 = 100;
    );
    slider11 = comp_thresh;
    update_filters();
    slider_automate(1024 | 2048 | 4096 | 8192 | 16384 | 32768 | 65536);
  );
) :

// ─── DOCK: TAB 4 (IMAGER CONTROLS) ───
slider2 == 4 ? (
  im_c_w = (dock_w - 30) / 4;

  // Card 1: Mono Cutoff Presets
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(dock_x + 6, dock_y + 8, im_c_w, dock_h - 16);
  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Bahnschrift", 15, 'b');
  gfx_x = dock_x + 16; gfx_y = dock_y + 14;
  gfx_drawstr("SUB MONO CUTOFF");
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Orbitron", 18, 'b');
  gfx_x = dock_x + 16; gfx_y = dock_y + 38;
  gfx_printf("%.0f Hz", imager_mono);

  pw_m = floor((im_c_w - 24) / 6.2);
  p_m = 0;
  loop(4,
    mv = (p_m==0 ? 80.0 : (p_m==1 ? 100.0 : (p_m==2 ? 110.0 : 130.0)));
    mx = dock_x + 10 + p_m * (pw_m + 3);
    sel_m = (abs(imager_mono - mv) < 2.0);
    gfx_r = sel_m ? 0.00 : 0.12; gfx_g = sel_m ? 0.55 : 0.14; gfx_b = sel_m ? 0.85 : 0.18;
    gfx_rect(mx, card_btn_y, pw_m, 26);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Bahnschrift", 13, sel_m ? 'b' : 0);
