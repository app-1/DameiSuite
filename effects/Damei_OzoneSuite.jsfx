gfx_rect(ab_btn_x, 25, ab_w, 30);
gfx_r = ab_state ? 1.00 : 0.24; gfx_g = ab_state ? 0.85 : 0.34; gfx_b = ab_state ? 0.30 : 0.46;
gfx_rect(ab_btn_x, 25, ab_w, 30, 0);
gfx_r = ab_state ? 1.0 : 0.85; gfx_g = ab_state ? 1.0 : 0.90; gfx_b = ab_state ? 1.0 : 0.95;
