  mouse_x >= bar_x && mouse_x <= bar_x + bar_w ? (
    menu_gen = gfx_showmenu("Default Modern Metal Clean (2026 Clarity & Punch)|Lance Prenc (Alpha Wolf / Prenc Audio Master)|Scott Seigel (DIESECT Full Production Master)|Jonathan Dolese (Mirrorcell / Konkrete Studios Master)|Buster Odeholm (thrown / Odeholm Audio Master)|Grant Berry (blanket / Love Is Noise / Fader Mastering)|Robin Schmidt & Grant Berry (Split Chain / UK Grunge Master)|Ted Jensen (Don Broco / Sterling Sound Master)|Robin Schmidt (Static Dress / 24-96 Mastering)|Mike Kalajian (Silverstein / Shyeye / Rogue Planet Master)|Nick Townsend (Heavenward / Townsend Mastering)|Randy Merrill (City Of Souls / Sterling Sound Master)|Leon Schmidt & Christian Donaldson (SUNBORN Master)|Ermin Hamidovic (Systematic Mastering Guide Benchmark)|Will Putney (Fit For An Autopsy / Knocked Loose signature)|George Lever (Loathe / Sleep Token signature)|Sam Bassal (Thornhill / Ocean Grove)|Henrik Udd (Architects / Bleed From Within signature)|Dan Braunstein (Spiritbox / Keep Sweet)|Zakk Cervini & Erik Ron (Bad Omens)|Jens Bogren (Fascination Street Master)|Nolly (Periphery / GGD Systematic)");
    menu_gen > 0 ? (
