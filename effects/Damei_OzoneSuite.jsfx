// Central Mastering Engineer Preset Selector Bar (< [ PRESET TITLE ] >)
// Dynamically centers and sizes to guarantee ZERO WARP and ZERO OVERLAP across all window widths
right_zone_w = 460; // ab_w(48) + gm_w(78) + car_w(84) + plat_w(88) + pill_w(144) + paddings(18)
right_start_x = w - 24 - right_zone_w;
title_end_x = 310;
