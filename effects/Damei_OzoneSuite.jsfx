// Center Dropdown Title Box
bar_x = btn_l_x + btn_w + 3;
bar_hov = (mouse_x >= bar_x && mouse_x <= bar_x + bar_w && mouse_y >= 25 && mouse_y <= 55);
gfx_r = bar_hov ? 0.12 : 0.08; gfx_g = bar_hov ? 0.18 : 0.12; gfx_b = bar_hov ? 0.26 : 0.18;
gfx_rect(bar_x, 25, bar_w, 30);
gfx_r = 0.20; gfx_g = 0.28; gfx_b = 0.38;
