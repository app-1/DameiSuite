  gfx_x = c1_x + 12; gfx_y = dock_y + 60;
  gfx_drawstr("One-click loads 14 signature chains.");

  // Prev / Next and Load buttons (Symmetrically spaced & centered)
  b_gap = 5;
  b_w = floor((pb_c_w - 24 - b_gap * 2) / 3);
  b1_x = c1_x + 12;
  b2_x = b1_x + b_w + b_gap;
  b3_x = b2_x + b_w + b_gap;
  b3_w = pb_c_w - 24 - b_w * 2 - b_gap * 2;

  p_btn_pr = (mouse_x >= b1_x && mouse_x <= b1_x + b_w && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);
  p_btn_nx = (mouse_x >= b2_x && mouse_x <= b2_x + b_w && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);
  p_btn_ld = (mouse_x >= b3_x && mouse_x <= b3_x + b3_w && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);

  gfx_r = p_btn_pr ? 0.20 : 0.10; gfx_g = p_btn_pr ? 0.25 : 0.13; gfx_b = p_btn_pr ? 0.35 : 0.18;
  gfx_rect(b1_x, dock_btn_y, b_w, btn_h);
  gfx_r = p_btn_nx ? 0.20 : 0.10; gfx_g = p_btn_nx ? 0.25 : 0.13; gfx_b = p_btn_nx ? 0.35 : 0.18;
  gfx_rect(b2_x, dock_btn_y, b_w, btn_h);
  gfx_r = p_btn_ld ? 0.15 : 0.08; gfx_g = p_btn_ld ? 0.45 : 0.26; gfx_b = p_btn_ld ? 0.25 : 0.14;
  gfx_rect(b3_x, dock_btn_y, b3_w, btn_h);

  gfx_r = 0.24; gfx_g = 0.30; gfx_b = 0.40;
  gfx_rect(b1_x, dock_btn_y, b_w, btn_h, 0);
  gfx_rect(b2_x, dock_btn_y, b_w, btn_h, 0);
  gfx_r = 0.20; gfx_g = 0.85; gfx_b = 0.40;
  gfx_rect(b3_x, dock_btn_y, b3_w, btn_h, 0);

  gfx_r = 0.90; gfx_g = 0.95; gfx_b = 1.00;
  gfx_setfont(1, "Bahnschrift", 12, 'b');
  gfx_measurestr("< PREV", tw1, th1);
  gfx_x = b1_x + (b_w - tw1) * 0.5; gfx_y = dock_btn_y + (btn_h - th1) * 0.5; gfx_drawstr("< PREV");
  gfx_measurestr("NEXT >", tw2, th2);
  gfx_x = b2_x + (b_w - tw2) * 0.5; gfx_y = dock_btn_y + (btn_h - th2) * 0.5; gfx_drawstr("NEXT >");
  gfx_r = 0.20; gfx_g = 0.95; gfx_b = 0.45;
  gfx_measurestr("LOAD", tw3, th3);
  gfx_x = b3_x + (b3_w - tw3) * 0.5; gfx_y = dock_btn_y + (btn_h - th3) * 0.5; gfx_drawstr("LOAD");

  mouse_clicked && p_btn_pr ? (playbook_eng_idx = (playbook_eng_idx - 1 + 14) % 14;);
  mouse_clicked && p_btn_nx ? (playbook_eng_idx = (playbook_eng_idx + 1) % 14;);
  mouse_clicked && p_btn_ld ? (
    slider33 = playbook_eng_idx;
    apply_producer_master_preset(slider33);
    slider50 = side_air_shelf_g;
    slider_automate(2 | 8 | 16 | 32 | 64 | 256 | 512 | 1048576);
  );

  // ─── Card 2: Secret Weapon: Side-Only Air Sheen ───
  c2_x = c1_x + pb_c_w + card_gap;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c2_x, dock_y + 8, pb_c_w, dock_h - 16);
  gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.30;
  gfx_rect(c2_x, dock_y + 8, pb_c_w, dock_h - 16, 0);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c2_x + 12; gfx_y = dock_y + 14;
  gfx_drawstr("SIDE AIR SHEEN (11k)");

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Orbitron", 17, 'b');
  gfx_x = c2_x + 12; gfx_y = dock_y + 36;
  gfx_printf("%+.1f dB Side-Only", side_air_shelf_g);

  gfx_r = 0.60; gfx_g = 0.68; gfx_b = 0.78;
  gfx_setfont(1, "Bahnschrift", 11);
  gfx_x = c2_x + 12; gfx_y = dock_y + 60;
  gfx_drawstr("Pultec 11k shelf; no center harshness.");

  // Quick preset pills: 0dB, +0.8dB, +1.0dB, +1.5dB
  pill_gap = 4;
  pw_a = floor((pb_c_w - 24 - pill_gap * 3) / 4);
  pi_a = 0;
  loop(4,
    ax = c2_x + 12 + pi_a * (pw_a + pill_gap);
    av = (pi_a == 0 ? 0.0 : (pi_a == 1 ? 0.8 : (pi_a == 2 ? 1.0 : 1.5)));
    sel_a = (abs(side_air_shelf_g - av) < 0.05);
    a_hov = (mouse_x >= ax && mouse_x <= ax + pw_a && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);
    sel_a ? (gfx_r = 0.00; gfx_g = 0.45; gfx_b = 0.55;) : (gfx_r = a_hov ? 0.18 : 0.10; gfx_g = a_hov ? 0.22 : 0.12; gfx_b = a_hov ? 0.30 : 0.16;);
    gfx_rect(ax, dock_btn_y, pw_a, btn_h);
    gfx_r = sel_a ? 0.00 : 0.22; gfx_g = sel_a ? 0.85 : 0.28; gfx_b = sel_a ? 1.00 : 0.38;
    gfx_rect(ax, dock_btn_y, pw_a, btn_h, 0);
    sel_a ? (gfx_r = 1.00; gfx_g = 1.00; gfx_b = 1.00;) : (gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85;);
    gfx_setfont(1, "Bahnschrift", 12, sel_a ? 'b' : 0);
    atxt = (pi_a == 0 ? "0 dB" : (pi_a == 1 ? "+0.8" : (pi_a == 2 ? "+1.0" : "+1.5")));
    gfx_measurestr(atxt, atw, ath);
    gfx_x = ax + (pw_a - atw) * 0.5; gfx_y = dock_btn_y + (btn_h - ath) * 0.5;
    gfx_drawstr(atxt);
    mouse_clicked && a_hov ? (
      side_air_shelf_g = av;
      slider50 = side_air_shelf_g;
      update_filters();
      slider_automate(1);
    );
    pi_a += 1;
  );

  // ─── Card 3: Clipper Transient Focus & Delta ───
  c3_x = c2_x + pb_c_w + card_gap;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c3_x, dock_y + 8, pb_c_w, dock_h - 16);
  gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.30;
  gfx_rect(c3_x, dock_y + 8, pb_c_w, dock_h - 16, 0);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c3_x + 12; gfx_y = dock_y + 14;
  gfx_drawstr("CLIPPER HEADROOM");

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c3_x + 12; gfx_y = dock_y + 36;
  gfx_printf("Drive: %.1f dB | Knee: %.0f%%", clip_drive, kclip_knee * 100);

  gfx_r = 0.60; gfx_g = 0.68; gfx_b = 0.78;
  gfx_setfont(1, "Bahnschrift", 11);
  gfx_x = c3_x + 12; gfx_y = dock_y + 60;
  gfx_drawstr("KClip center kick transient shield.");

  // Quick Clipper presets: 0 dB, 0.8 dB, 1.4 dB, DELTA
  pw_cl = floor((pb_c_w - 24 - pill_gap * 3) / 4);
  pi_cl = 0;
  loop(4,
    cx = c3_x + 12 + pi_cl * (pw_cl + pill_gap);
    pi_cl == 3 ? (
      dt_hov = (mouse_x >= cx && mouse_x <= cx + pw_cl && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);
      kclip_delta ? (gfx_r = 0.95; gfx_g = 0.40; gfx_b = 0.15;) : (gfx_r = dt_hov ? 0.18 : 0.10; gfx_g = dt_hov ? 0.22 : 0.12; gfx_b = dt_hov ? 0.30 : 0.16;);
      gfx_rect(cx, dock_btn_y, pw_cl, btn_h);
      gfx_r = kclip_delta ? 1.0 : 0.22; gfx_g = kclip_delta ? 0.5 : 0.28; gfx_b = kclip_delta ? 0.2 : 0.38;
      gfx_rect(cx, dock_btn_y, pw_cl, btn_h, 0);
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_setfont(1, "Bahnschrift", 11, 'b');
      dtxt = kclip_delta ? "DELTA" : "AUDIT";
      gfx_measurestr(dtxt, dtw, dth);
      gfx_x = cx + (pw_cl - dtw) * 0.5; gfx_y = dock_btn_y + (btn_h - dth) * 0.5;
      gfx_drawstr(dtxt);
      mouse_clicked && dt_hov ? (
        kclip_delta = !kclip_delta;
        slider24 = kclip_delta;
        slider_automate(8388608);
      );
    ) : (
      cv = (pi_cl == 0 ? 0.0 : (pi_cl == 1 ? 0.8 : 1.4));
      sel_c = (abs(clip_drive - cv) < 0.05);
      c_hov = (mouse_x >= cx && mouse_x <= cx + pw_cl && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);
      sel_c ? (gfx_r = 0.00; gfx_g = 0.45; gfx_b = 0.55;) : (gfx_r = c_hov ? 0.18 : 0.10; gfx_g = c_hov ? 0.22 : 0.12; gfx_b = c_hov ? 0.30 : 0.16;);
      gfx_rect(cx, dock_btn_y, pw_cl, btn_h);
      gfx_r = sel_c ? 0.00 : 0.22; gfx_g = sel_c ? 0.85 : 0.28; gfx_b = sel_c ? 1.00 : 0.38;
      gfx_rect(cx, dock_btn_y, pw_cl, btn_h, 0);
      sel_c ? (gfx_r = 1.00; gfx_g = 1.00; gfx_b = 1.00;) : (gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85;);
      gfx_setfont(1, "Bahnschrift", 12, sel_c ? 'b' : 0);
      ctxt = (pi_cl == 0 ? "0 dB" : (pi_cl == 1 ? "0.8" : "1.4"));
      gfx_measurestr(ctxt, ctw, cth);
      gfx_x = cx + (pw_cl - ctw) * 0.5; gfx_y = dock_btn_y + (btn_h - cth) * 0.5;
      gfx_drawstr(ctxt);
      mouse_clicked && c_hov ? (
        clip_drive = cv;
        slider4 = clip_drive;
        slider_automate(8);
      );
    );
    pi_cl += 1;
  );

  // ─── Card 4: Sub-Bass Anchor & -1.0 dBTP Lock ───
  c4_x = c3_x + pb_c_w + card_gap;
  gfx_r = 0.08; gfx_g = 0.09; gfx_b = 0.13;
  gfx_rect(c4_x, dock_y + 8, pb_c_w, dock_h - 16);
  gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.30;
  gfx_rect(c4_x, dock_y + 8, pb_c_w, dock_h - 16, 0);

  gfx_r = 0.00; gfx_g = 0.85; gfx_b = 1.00;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c4_x + 12; gfx_y = dock_y + 14;
  gfx_drawstr("SUB ANCHOR & TRUE PEAK");

  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  gfx_setfont(1, "Bahnschrift", 14, 'b');
  gfx_x = c4_x + 12; gfx_y = dock_y + 36;
  gfx_printf("Mono: %.0f Hz | Ceiling: %.1f dBTP", imager_mono, lim_ceil);

  gfx_r = 0.60; gfx_g = 0.68; gfx_b = 0.78;
  gfx_setfont(1, "Bahnschrift", 11);
  gfx_x = c4_x + 12; gfx_y = dock_y + 60;
  gfx_drawstr("Phase-safe 4x polyphase ceiling lock.");

  // Quick Mono Presets: 90Hz, 105Hz, 110Hz, 125Hz
  pw_m4 = floor((pb_c_w - 24 - pill_gap * 3) / 4);
  pi_m4 = 0;
  loop(4,
    mx = c4_x + 12 + pi_m4 * (pw_m4 + pill_gap);
    mv = (pi_m4 == 0 ? 90.0 : (pi_m4 == 1 ? 105.0 : (pi_m4 == 2 ? 110.0 : 125.0)));
    sel_m4 = (abs(imager_mono - mv) < 2.0);
    m4_hov = (mouse_x >= mx && mouse_x <= mx + pw_m4 && mouse_y >= dock_btn_y && mouse_y <= dock_btn_y + btn_h);
    sel_m4 ? (gfx_r = 0.00; gfx_g = 0.45; gfx_b = 0.55;) : (gfx_r = m4_hov ? 0.18 : 0.10; gfx_g = m4_hov ? 0.22 : 0.12; gfx_b = m4_hov ? 0.30 : 0.16;);
    gfx_rect(mx, dock_btn_y, pw_m4, btn_h);
    gfx_r = sel_m4 ? 0.00 : 0.22; gfx_g = sel_m4 ? 0.85 : 0.28; gfx_b = sel_m4 ? 1.00 : 0.38;
    gfx_rect(mx, dock_btn_y, pw_m4, btn_h, 0);
    sel_m4 ? (gfx_r = 1.00; gfx_g = 1.00; gfx_b = 1.00;) : (gfx_r = 0.70; gfx_g = 0.75; gfx_b = 0.85;);
    gfx_setfont(1, "Bahnschrift", 12, sel_m4 ? 'b' : 0);
    mtxt = (pi_m4 == 0 ? "90Hz" : (pi_m4 == 1 ? "105Hz" : (pi_m4 == 2 ? "110Hz" : "125Hz")));
    gfx_measurestr(mtxt, mtw, mth);
    gfx_x = mx + (pw_m4 - mtw) * 0.5; gfx_y = dock_btn_y + (btn_h - mth) * 0.5;
    gfx_drawstr(mtxt);
    mouse_clicked && m4_hov ? (
      imager_mono = mv;
      slider6 = mv;
      update_filters();
      slider_automate(32);
    );
    pi_m4 += 1;
  );
);

prev_mouse_down = mouse_down;
