  gfx_a = 1.0;
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_setfont(1, "Orbitron", 12, 'b');
  ai_label = "ANALYZING 4-BAND SPECTRUM...";
  gfx_measurestr(ai_label, alw, alh);
  gfx_x = btn_x + (btn_w - alw) * 0.5; gfx_y = btn_y + 12;
  gfx_drawstr(ai_label);
  gfx_r = 0.80; gfx_g = 0.95; gfx_b = 0.95;
  gfx_setfont(1, "Consolas", 12);
  sub_lbl = "Target: -8.5 LUFS-I CD Standard";
  gfx_measurestr(sub_lbl, slw, slh);
  gfx_x = btn_x + (btn_w - slw) * 0.5; gfx_y = btn_y + 36;
  gfx_drawstr(sub_lbl);
) : ai_calibrated == 1 ? (
  // Calibrated State: Sleek Dual Cybernetic Controls
  gfx_r = 1.00; gfx_g = 0.78; gfx_b = 0.20;
