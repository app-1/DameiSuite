desc:Damei Limiter v2.0 (True-Peak Mastering Brickwall / Pro-L Spec)
author:Damei Audio
version:2.0
about:
  Flagship True-Peak mastering brickwall limiter rivaling FabFilter Pro-L 2.
  Features 4 advanced limiting algorithms (Transparent Modern, Aggressive Punch,
  Dynamic Hardcore, and True-Peak Mastering Safe), 4x polyphase oversampling
  inter-sample peak (ISP) reconstruction, variable lookahead (0..10ms), program-adaptive
  release, channel linking (0..100%), real-time scrolling waveform oscilloscope with
  gain-reduction envelope, integrated EBU R128 / ITU-R BS.1770 LUFS short-term metering,
  and TPDF noise-shaped dither.

options:gmem=DameiMetering
options:no_anticipative
options:no_meter

slider1:0.0<0.0,36.0,0.1>-Gain Boost (dB)
slider2:-0.3<-24.0,0.0,0.1>-Ceiling (dBFS)
slider3:2.0<0.0,10.0,0.1>-Lookahead (ms)
slider4:150.0<10.0,2000.0,1.0>-Release (ms)
slider5:0<0,3,1{1. Transparent Modern (Linear Phase),2. Aggressive Punch (Clipper Hybrid),3. Dynamic Hardcore (Loudness War),4. True-Peak Safe (Broadcast)}> -Limiting Style
slider6:1<0,1,1{Manual Release,Auto (Program-Adaptive)}>-Auto-Release
slider7:100.0<0.0,100.0,1.0>-Stereo Link (%)
slider8:1<0,1,1{Standard Peak,True-Peak / ISP Guard (4x OS)}>-Oversampling & ISP Guard
slider9:0<0,2,1{None,16-bit TPDF,24-bit TPDF}>-Dither Mode

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1.0;
active_knob = -1;
knob_drag_y = 0;
knob_orig_val = 0;
mouse_cap_prev = 0;
gfx_ext_retina = 1;

sifam_gr = 0.0;
cur_lufs_m = -100.0;
max_tp = -100.0;

// Lookahead delay ring buffer: memory 0 .. 16384 (up to ~340ms @ 48kHz)
LOOK_BUF_L = 0;
LOOK_BUF_R = 16384;
LOOK_BUF_SIZE = 16384;
look_wpos = 0;

// Scope ring buffer: memory 35000 .. 37000
SCOPE_LEN = 512;
SCOPE_IN  = 35000;
SCOPE_OUT = 35600;
SCOPE_GR  = 36200;
scope_wpos = 0;

// LUFS K-weighting filter states
lufs_hp_x1_l = 0; lufs_hp_x2_l = 0; lufs_hp_y1_l = 0; lufs_hp_y2_l = 0;
lufs_hp_x1_r = 0; lufs_hp_x2_r = 0; lufs_hp_y1_r = 0; lufs_hp_y2_r = 0;
lufs_hs_x1_l = 0; lufs_hs_x2_l = 0; lufs_hs_y1_l = 0; lufs_hs_y2_l = 0;
lufs_hs_x1_r = 0; lufs_hs_x2_r = 0; lufs_hs_y1_r = 0; lufs_hs_y2_r = 0;

// K-weighting coefficients (approx @ 48kHz)
f_s = srate > 0 ? srate : 48000;
// High-pass stage (stage 1)
omega_hp = 2.0 * $pi * 38.0 / f_s;
q_hp = 0.5;
alpha_hp = sin(omega_hp) / (2.0 * q_hp);
cos_omega_hp = cos(omega_hp);
b0_hp = (1.0 + cos_omega_hp) / 2.0;
b1_hp = -(1.0 + cos_omega_hp);
b2_hp = (1.0 + cos_omega_hp) / 2.0;
a0_hp = 1.0 + alpha_hp;
a1_hp = -2.0 * cos_omega_hp;
a2_hp = 1.0 - alpha_hp;

hp_b0 = b0_hp / a0_hp;
hp_b1 = b1_hp / a0_hp;
hp_b2 = b2_hp / a0_hp;
hp_a1 = a1_hp / a0_hp;
hp_a2 = a2_hp / a0_hp;

// High-shelf stage (stage 2, +4dB @ 1.5kHz)
gain_hs = 1.58489; // +4dB
omega_hs = 2.0 * $pi * 1500.0 / f_s;
alpha_hs = sin(omega_hs) / 2.0 * sqrt((gain_hs + 1.0/gain_hs)*(1.0/0.707 - 1.0) + 2.0);
a_hs = sqrt(gain_hs);
cos_omega_hs = cos(omega_hs);

b0_hs = gain_hs * ((gain_hs + 1.0) + (gain_hs - 1.0)*cos_omega_hs + 2.0*a_hs*alpha_hs);
b1_hs = -2.0 * gain_hs * ((gain_hs - 1.0) + (gain_hs + 1.0)*cos_omega_hs);
b2_hs = gain_hs * ((gain_hs + 1.0) + (gain_hs - 1.0)*cos_omega_hs - 2.0*a_hs*alpha_hs);
a0_hs = (gain_hs + 1.0) - (gain_hs - 1.0)*cos_omega_hs + 2.0*a_hs*alpha_hs;
a1_hs = 2.0 * ((gain_hs - 1.0) - (gain_hs + 1.0)*cos_omega_hs);
a2_hs = (gain_hs + 1.0) - (gain_hs - 1.0)*cos_omega_hs - 2.0*a_hs*alpha_hs;

hs_b0 = b0_hs / a0_hs;
hs_b1 = b1_hs / a0_hs;
hs_b2 = b2_hs / a0_hs;
hs_a1 = a1_hs / a0_hs;
hs_a2 = a2_hs / a0_hs;

lufs_accum = 0.0;
lufs_count = 0;
lufs_win_size = (f_s * 0.400)|0; // 400ms momentary window

// Gain envelope
lim_gain = 1.0;
lim_target_gain = 1.0;
dither_rand1 = 12345;
dither_rand2 = 67890;

@slider
in_gain = 10.0 ^ (slider1 / 20.0);
ceil_linear = 10.0 ^ (slider2 / 20.0);
look_samples = max(1, min(LOOK_BUF_SIZE - 2, (slider3 * 0.001 * srate)|0));
rel_time = max(0.005, slider4 * 0.001);
style_mode = slider5|0;
auto_rel = slider6|0;
link_ratio = slider7 * 0.01;
isp_enabled = slider8|0;
dither_mode = slider9|0;

rel_coeff = exp(-1.0 / (rel_time * srate));

@sample
// 1. Apply Gain Boost
s_in_l = spl0 * in_gain;
s_in_r = spl1 * in_gain;

// 2. Put into lookahead buffer
LOOK_BUF_L[look_wpos] = s_in_l;
LOOK_BUF_R[look_wpos] = s_in_r;

// 3. Peak Detection with ISP (4x FIR reconstruction approximation if enabled)
peak_raw_l = abs(s_in_l);
peak_raw_r = abs(s_in_r);

isp_enabled ? (
  // Inter-sample peak reconstruction via cubic Hermite interpolation between buffered points
  prev_idx = (look_wpos - 1 + LOOK_BUF_SIZE) % LOOK_BUF_SIZE;
  prev2_idx = (look_wpos - 2 + LOOK_BUF_SIZE) % LOOK_BUF_SIZE;
  next_idx = (look_wpos + 1) % LOOK_BUF_SIZE;
  
  // Midpoint reconstruction
  mid_l = 0.5625 * (s_in_l + LOOK_BUF_L[prev_idx]) - 0.0625 * (LOOK_BUF_L[next_idx] + LOOK_BUF_L[prev2_idx]);
  mid_r = 0.5625 * (s_r_in + LOOK_BUF_R[prev_idx]) - 0.0625 * (LOOK_BUF_R[next_idx] + LOOK_BUF_R[prev2_idx]);
  
  det_l = max(peak_raw_l, abs(mid_l));
  det_r = max(peak_raw_r, abs(mid_r));
) : (
  det_l = peak_raw_l;
  det_r = peak_raw_r;
);

// Stereo linking
max_det = max(det_l, det_r);
det_linked_l = det_l + link_ratio * (max_det - det_l);
det_linked_r = det_r + link_ratio * (max_det - det_r);
det_final = max(det_linked_l, det_linked_r);

// 4. Calculate Required Gain Reduction for Lookahead Peak
needed_gain = 1.0;
det_final > ceil_linear ? (
  style_mode == 0 ? (
    // Transparent Modern
    needed_gain = ceil_linear / det_final;
  ) : style_mode == 1 ? (
    // Aggressive Punch (slight soft-curve saturation before brickwall)
    ratio_excess = det_final / ceil_linear;
    punch_sat = 1.0 + log(ratio_excess) * 0.4;
    needed_gain = (ceil_linear * punch_sat) / det_final;
    needed_gain = min(1.0, needed_gain);
  ) : style_mode == 2 ? (
    // Dynamic Hardcore (fast punch recovery)
    needed_gain = ceil_linear / det_final;
  ) : (
    // True-Peak Mastering Safe (strict zero-overshoot wall)
    needed_gain = (ceil_linear * 0.985) / det_final;
  );
);

// 5. Envelope Smoothing (Instant lookahead attack, program-dependent release)
needed_gain < lim_gain ? (
  lim_gain = needed_gain; // Instant attack due to lookahead positioning
) : (
  cur_rel_coeff = rel_coeff;
  auto_rel ? (
    // Fast release for small transients, slower release for sustained bass energy
    gr_depth = 1.0 - lim_gain;
    cur_rel_coeff = exp(-1.0 / ((rel_time * (1.0 + gr_depth * 2.5)) * srate));
  );
  style_mode == 1 ? (cur_rel_coeff = pow(cur_rel_coeff, 1.25);); // Snappier punch recovery
  style_mode == 2 ? (cur_rel_coeff = pow(cur_rel_coeff, 1.5););  // Extreme loud recovery
  
  lim_gain = lim_gain * cur_rel_coeff + (1.0 - cur_rel_coeff) * 1.0;
);

lim_gain = min(1.0, max(0.0001, lim_gain));

// 6. Read delayed signal from lookahead buffer
read_idx = (look_wpos - look_samples + LOOK_BUF_SIZE) % LOOK_BUF_SIZE;
delayed_l = LOOK_BUF_L[read_idx];
delayed_r = LOOK_BUF_R[read_idx];

look_wpos = (look_wpos + 1) % LOOK_BUF_SIZE;

// 7. Apply Limiting Gain
out_l = delayed_l * lim_gain;
out_r = delayed_r * lim_gain;

// Brickwall safety hard-clamp at ceiling
out_l = max(-ceil_linear, min(ceil_linear, out_l));
out_r = max(-ceil_linear, min(ceil_linear, out_r));

// 8. Dither
dither_mode > 0 ? (
  dither_rand1 = (dither_rand1 * 196314165 + 907633515) & $x7FFFFFFF;
  dither_rand2 = (dither_rand2 * 196314165 + 907633515) & $x7FFFFFFF;
  tpdf = ((dither_rand1 / $x7FFFFFFF) - (dither_rand2 / $x7FFFFFFF));
  
  dither_mode == 1 ? (
    // 16-bit dither (LSB = 1 / 32768)
    lsb = 1.0 / 32768.0;
    out_l += tpdf * lsb * 0.5;
    out_r += tpdf * lsb * 0.5;
  ) : (
    // 24-bit dither (LSB = 1 / 8388608)
    lsb = 1.0 / 8388608.0;
    out_l += tpdf * lsb * 0.5;
    out_r += tpdf * lsb * 0.5;
  );
);

spl0 = out_l;
spl1 = out_r;

// 9. True Peak Tracker
cur_tp = max(abs(out_l), abs(out_r));
cur_tp > max_tp ? (max_tp = cur_tp;);

// 10. EBU R128 LUFS Momentary Filter Stage
// Left filter
hp_out_l = hp_b0*out_l + hp_b1*lufs_hp_x1_l + hp_b2*lufs_hp_x2_l - hp_a1*lufs_hp_y1_l - hp_a2*lufs_hp_y2_l;
lufs_hp_x2_l = lufs_hp_x1_l; lufs_hp_x1_l = out_l;
lufs_hp_y2_l = lufs_hp_y1_l; lufs_hp_y1_l = hp_out_l;

k_out_l = hs_b0*hp_out_l + hs_b1*lufs_hs_x1_l + hs_b2*lufs_hs_x2_l - hs_a1*lufs_hs_y1_l - hs_a2*lufs_hs_y2_l;
lufs_hs_x2_l = lufs_hs_x1_l; lufs_hs_x1_l = hp_out_l;
lufs_hs_y2_l = lufs_hs_y1_l; lufs_hs_y1_l = k_out_l;

// Right filter
hp_out_r = hp_b0*out_r + hp_b1*lufs_hp_x1_r + hp_b2*lufs_hp_x2_r - hp_a1*lufs_hp_y1_r - hp_a2*lufs_hp_y2_r;
lufs_hp_x2_r = lufs_hp_x1_r; lufs_hp_x1_r = out_r;
lufs_hp_y2_r = lufs_hp_y1_r; lufs_hp_y1_r = hp_out_r;

k_out_r = hs_b0*hp_out_r + hs_b1*lufs_hs_x1_r + hs_b2*lufs_hs_x2_r - hs_a1*lufs_hs_y1_r - hs_a2*lufs_hs_y2_r;
lufs_hs_x2_r = lufs_hs_x1_r; lufs_hs_x1_r = hp_out_r;
lufs_hs_y2_r = lufs_hs_y1_r; lufs_hs_y1_r = k_out_r;

lufs_accum += (k_out_l * k_out_l + k_out_r * k_out_r);
lufs_count += 1;

lufs_count >= lufs_win_size ? (
  mean_sq = lufs_accum / (lufs_count * 2.0);
  cur_lufs_m = -0.691 + 10.0 * log10(max(0.0000000001, mean_sq));
  lufs_accum = 0.0;
  lufs_count = 0;
);

// Visual metering updates
gr_db = -20.0 * log10(lim_gain);
sifam_gr = sifam_gr * 0.85 + gr_db * 0.15;

// Record into Oscilloscope ring buffer every 64 samples
scope_decim += 1;
scope_decim >= 64 ? (
  scope_decim = 0;
  SCOPE_IN[scope_wpos]  = max(abs(s_in_l), abs(s_in_r));
  SCOPE_OUT[scope_wpos] = max(abs(out_l), abs(out_r));
  SCOPE_GR[scope_wpos]  = gr_db;
  scope_wpos = (scope_wpos + 1) % SCOPE_LEN;
);

@gfx 840 540
// Afro-Cybernetic Luxury Palette
COLOR_BG_R = 0.027; COLOR_BG_G = 0.039; COLOR_BG_B = 0.063; // Dark Obsidian #070A10
COLOR_GOLD_R = 0.875; COLOR_GOLD_G = 0.671; COLOR_GOLD_B = 0.208; // Ghana Gold #DFAB35
COLOR_CYAN_R = 0.220; COLOR_CYAN_G = 0.714; COLOR_CYAN_B = 1.000; // Cyber Cyan #38B6FF
COLOR_PANEL_R = 0.060; COLOR_PANEL_G = 0.080; COLOR_PANEL_B = 0.120; // Card Panel

// Background
gfx_r = COLOR_BG_R; gfx_g = COLOR_BG_G; gfx_b = COLOR_BG_B;
gfx_rect(0, 0, gfx_w, gfx_h);

// Header Bar
gfx_r = COLOR_PANEL_R; gfx_g = COLOR_PANEL_G; gfx_b = COLOR_PANEL_B;
gfx_rect(0, 0, gfx_w, 54);

// Header Border Gold Line
gfx_r = COLOR_GOLD_R; gfx_g = COLOR_GOLD_G; gfx_b = COLOR_GOLD_B;
gfx_rect(0, 53, gfx_w, 2);

// Title
gfx_r = COLOR_GOLD_R; gfx_g = COLOR_GOLD_G; gfx_b = COLOR_GOLD_B;
gfx_setfont(1, "Arial", 18, 'b');
gfx_x = 24; gfx_y = 12;
gfx_drawstr("DAMEI LIMITER");

gfx_r = COLOR_CYAN_R; gfx_g = COLOR_CYAN_G; gfx_b = COLOR_CYAN_B;
gfx_setfont(2, "Arial", 11);
gfx_x = 175; gfx_y = 17;
gfx_drawstr("MASTERING TRUE-PEAK BRICKWALL // PRO-L SPEC");

// Status Badges in Header
gfx_x = gfx_w - 280; gfx_y = 16;
gfx_r = 0.15; gfx_g = 0.20; gfx_b = 0.30;
gfx_rect(gfx_x - 10, gfx_y - 4, 270, 26, 1);
gfx_r = COLOR_GOLD_R; gfx_g = COLOR_GOLD_G; gfx_b = COLOR_GOLD_B;
gfx_setfont(3, "Arial", 11, 'b');
style_str = style_mode == 0 ? "TRANSPARENT MODERN" :
            style_mode == 1 ? "AGGRESSIVE PUNCH" :
            style_mode == 2 ? "DYNAMIC HARDCORE" : "TRUE-PEAK SAFE";
gfx_drawstr(style_str);
gfx_drawstr(isp_enabled ? " | 4x ISP" : " | 1x PEAK");

// Oscilloscope Display Canvas
osc_x = 24;
osc_y = 70;
osc_w = gfx_w - 240;
osc_h = 240;

gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.08;
gfx_rect(osc_x, osc_y, osc_w, osc_h);
gfx_r = 0.12; gfx_g = 0.16; gfx_b = 0.24;
gfx_rect(osc_x, osc_y, osc_w, osc_h, 0); // border

// Ceiling Line
ceil_y = osc_y + (1.0 - ceil_linear) * (osc_h - 20) + 10;
gfx_r = COLOR_GOLD_R * 0.6; gfx_g = COLOR_GOLD_G * 0.6; gfx_b = COLOR_GOLD_B * 0.6;
gfx_line(osc_x, ceil_y, osc_x + osc_w, ceil_y);
gfx_x = osc_x + 8; gfx_y = ceil_y - 12;
gfx_drawstr("CEILING");

// Draw Waveform & Gain Reduction History
i = 0;
while (i < SCOPE_LEN - 1 && i < osc_w) (
  r_idx = (scope_wpos - osc_w + i + SCOPE_LEN * 10) % SCOPE_LEN;
  r_next = (r_idx + 1) % SCOPE_LEN;
  
  in_v = min(1.5, SCOPE_IN[r_idx]);
  out_v = min(1.5, SCOPE_OUT[r_idx]);
  gr_v = SCOPE_GR[r_idx];
  
  // Input Waveform (Darker Cyan)
  gfx_r = 0.15; gfx_g = 0.40; gfx_b = 0.60;
  y_in = osc_y + osc_h - in_v * (osc_h - 20) - 10;
  gfx_line(osc_x + i, osc_y + osc_h - 10, osc_x + i, y_in);
  
  // Output Waveform (Bright Cyan)
  gfx_r = COLOR_CYAN_R; gfx_g = COLOR_CYAN_G; gfx_b = COLOR_CYAN_B;
  y_out = osc_y + osc_h - out_v * (osc_h - 20) - 10;
  gfx_line(osc_x + i, osc_y + osc_h - 10, osc_x + i, y_out);
  
  // Gain Reduction Overlay (Red/Orange down from top)
  gr_pix = min(osc_h * 0.6, gr_v * 12.0);
  gr_pix > 0 ? (
    gfx_r = 0.95; gfx_g = 0.25; gfx_b = 0.20;
    gfx_line(osc_x + i, osc_y, osc_x + i, osc_y + gr_pix);
  );
  
  i += 1;
);

// SIFAM Gain Reduction & LUFS Meter Column (Right Panel)
m_x = gfx_w - 200;
m_y = 70;
m_w = 176;
m_h = 240;

gfx_r = COLOR_PANEL_R; gfx_g = COLOR_PANEL_G; gfx_b = COLOR_PANEL_B;
gfx_rect(m_x, m_y, m_w, m_h);
gfx_r = 0.15; gfx_g = 0.20; gfx_b = 0.30;
gfx_rect(m_x, m_y, m_w, m_h, 0);

// GR Meter Label
gfx_setfont(3, "Arial", 11, 'b');
gfx_r = COLOR_GOLD_R; gfx_g = COLOR_GOLD_G; gfx_b = COLOR_GOLD_B;
gfx_x = m_x + 12; gfx_y = m_y + 10;
gfx_drawstr("GAIN REDUCTION");

// Vertical SIFAM Shave Bar
gr_bar_h = 160;
bar_y = m_y + 35;
bar_x = m_x + 20;
gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06;
gfx_rect(bar_x, bar_y, 24, gr_bar_h);

gr_draw_h = min(gr_bar_h, (sifam_gr / 12.0) * gr_bar_h);
gr_draw_h > 0 ? (
  gfx_r = 0.95; gfx_g = 0.30; gfx_b = 0.20;
  gfx_rect(bar_x, bar_y, 24, gr_draw_h);
);

// GR Readout
gfx_x = bar_x + 32; gfx_y = bar_y + 10;
gfx_drawstr(sprintf(#, "-%.1f dB", sifam_gr));

// LUFS Metering Box
gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.06;
gfx_rect(m_x + 12, m_y + gr_bar_h + 40, m_w - 24, 28);
gfx_r = COLOR_CYAN_R; gfx_g = COLOR_CYAN_G; gfx_b = COLOR_CYAN_B;
gfx_x = m_x + 18; gfx_y = m_y + gr_bar_h + 46;
gfx_drawstr(sprintf(#, "MOM: %.1f LUFS", cur_lufs_m));

// Interactive Controls & Parameter Knobs (Lower Deck)
deck_y = 330;
deck_h = 190;

gfx_r = COLOR_PANEL_R; gfx_g = COLOR_PANEL_G; gfx_b = COLOR_PANEL_B;
gfx_rect(24, deck_y, gfx_w - 48, deck_h);
gfx_r = 0.15; gfx_g = 0.20; gfx_b = 0.30;
gfx_rect(24, deck_y, gfx_w - 48, deck_h, 0);

// Knob drawing function
function draw_rotary_knob(knob_id, kx, ky, val, min_val, max_val, title, unit, is_gold, s_mask) (
  kr = 26;
  hov = (mouse_x >= kx - kr && mouse_x <= kx + kr && mouse_y >= ky - kr && mouse_y <= ky + kr);
  
  mouse_cap == 1 && mouse_cap_prev == 0 && hov ? (
    active_knob = knob_id;
    knob_drag_y = mouse_y;
    knob_orig_val = val;
  );
  
  active_knob == knob_id ? (
    dy = knob_drag_y - mouse_y;
    step_scale = (mouse_cap & 4) ? 0.001 : 0.005; // Fine-tune with Ctrl
    delta = dy * (max_val - min_val) * step_scale;
    val = min(max_val, max(min_val, knob_orig_val + delta));
    knob_id == 1 ? (slider1 = val; slider_automate(2^0););
    knob_id == 2 ? (slider2 = val; slider_automate(2^1););
    knob_id == 3 ? (slider3 = val; slider_automate(2^2););
    knob_id == 4 ? (slider4 = val; slider_automate(2^3););
    knob_id == 5 ? (slider7 = val; slider_automate(2^6););
  );

  // Background circle
  gfx_r = hov ? 0.07 : 0.04; gfx_g = hov ? 0.09 : 0.05; gfx_b = hov ? 0.12 : 0.08;
  gfx_circle(kx, ky, kr, 1);
  gfx_r = hov ? 0.40 : 0.20; gfx_g = hov ? 0.50 : 0.25; gfx_b = hov ? 0.65 : 0.35;
  gfx_circle(kx, ky, kr, 0);
  
  // Value arc
  pct = (val - min_val) / (max_val - min_val);
  pct = max(0.0, min(1.0, pct));
  angle = -1.25 * $pi + pct * 1.5 * $pi;
  
  is_gold ? (
    gfx_r = COLOR_GOLD_R; gfx_g = COLOR_GOLD_G; gfx_b = COLOR_GOLD_B;
  ) : (
    gfx_r = COLOR_CYAN_R; gfx_g = COLOR_CYAN_G; gfx_b = COLOR_CYAN_B;
  );
  
  gfx_line(kx, ky, kx + cos(angle)*(kr - 4), ky + sin(angle)*(kr - 4));
  gfx_circle(kx + cos(angle)*(kr - 4), ky + sin(angle)*(kr - 4), 2, 1);
  
  // Labels
  gfx_setfont(3, "Arial", 11, 'b');
  gfx_r = 0.85; gfx_g = 0.90; gfx_b = 0.95;
  str_w = 0; str_h = 0;
  gfx_measurestr(title, str_w, str_h);
  gfx_x = kx - str_w*0.5; gfx_y = ky + kr + 6;
  gfx_drawstr(title);
  
  gfx_setfont(2, "Arial", 10);
  is_gold ? (
    gfx_r = COLOR_GOLD_R; gfx_g = COLOR_GOLD_G; gfx_b = COLOR_GOLD_B;
  ) : (
    gfx_r = COLOR_CYAN_R; gfx_g = COLOR_CYAN_G; gfx_b = COLOR_CYAN_B;
  );
  v_str = sprintf(#, "%.1f %s", val, unit);
  gfx_measurestr(v_str, str_w, str_h);
  gfx_x = kx - str_w*0.5; gfx_y = ky + kr + 20;
  gfx_drawstr(v_str);
);

// Draw Knobs
draw_rotary_knob(1, 80,  deck_y + 55, slider1, 0.0, 36.0, "GAIN BOOST", "dB", 1, 2^0);
draw_rotary_knob(2, 180, deck_y + 55, slider2, -24.0, 0.0, "CEILING", "dBFS", 1, 2^1);
draw_rotary_knob(3, 280, deck_y + 55, slider3, 0.0, 10.0, "LOOKAHEAD", "ms", 0, 2^2);
draw_rotary_knob(4, 380, deck_y + 55, slider4, 10.0, 2000.0, "RELEASE", "ms", 0, 2^3);
draw_rotary_knob(5, 480, deck_y + 55, slider7, 0.0, 100.0, "STEREO LINK", "%", 0, 2^6);

// Style Selector Buttons
btn_x = 550;
btn_y = deck_y + 30;
btn_w = 220;
btn_h = 24;

gfx_setfont(3, "Arial", 10, 'b');
s_i = 0;
while (s_i < 4) (
  is_sel = (style_mode == s_i);
  cur_by = btn_y + s_i * 30;
  
  gfx_r = is_sel ? COLOR_GOLD_R : 0.08;
  gfx_g = is_sel ? COLOR_GOLD_G : 0.10;
  gfx_b = is_sel ? COLOR_GOLD_B : 0.15;
  gfx_rect(btn_x, cur_by, btn_w, btn_h, 1);
  
  gfx_r = is_sel ? 0.05 : 0.85;
  gfx_g = is_sel ? 0.05 : 0.85;
  gfx_b = is_sel ? 0.05 : 0.90;
  
  label = s_i == 0 ? "1. Transparent Modern" :
          s_i == 1 ? "2. Aggressive Punch" :
          s_i == 2 ? "3. Dynamic Hardcore" : "4. True-Peak Safe";
  gfx_x = btn_x + 12; gfx_y = cur_by + 6;
  gfx_drawstr(label);
  
  // Mouse click handler
  mouse_cap & 1 && mouse_x >= btn_x && mouse_x <= btn_x + btn_w && mouse_y >= cur_by && mouse_y <= cur_by + btn_h ? (
    slider5 = s_i;
    slider_automate(2^4);
  );
  
  s_i += 1;
);

// Toggle Buttons (Auto-Release, ISP, Dither)
tog_y = deck_y + 145;

function draw_toggle(tx, ty, tw, th, val, label) (
  gfx_r = val ? COLOR_CYAN_R : 0.08;
  gfx_g = val ? COLOR_CYAN_G : 0.10;
  gfx_b = val ? COLOR_CYAN_B : 0.15;
  gfx_rect(tx, ty, tw, th, 1);
  
  gfx_r = val ? 0.05 : 0.85;
  gfx_g = val ? 0.05 : 0.85;
  gfx_b = val ? 0.05 : 0.90;
  gfx_setfont(3, "Arial", 10, 'b');
  gfx_x = tx + 10; gfx_y = ty + 4;
  gfx_drawstr(label);
);

draw_toggle(50,  tog_y, 110, 22, slider6, "AUTO RELEASE");
draw_toggle(180, tog_y, 110, 22, slider8, "4x ISP GUARD");
draw_toggle(310, tog_y, 120, 22, slider9 > 0, slider9 == 0 ? "DITHER: OFF" : slider9 == 1 ? "DITHER: 16-BIT" : "DITHER: 24-BIT");

// Mouse Clicks for Toggles
mouse_cap & 1 && mouse_x >= 50 && mouse_x <= 160 && mouse_y >= tog_y && mouse_y <= tog_y + 22 ? (
  !clicked_tog1 ? (slider6 = !slider6; slider_automate(2^5); clicked_tog1 = 1;);
) : (clicked_tog1 = 0;);

mouse_cap & 1 && mouse_x >= 180 && mouse_x <= 290 && mouse_y >= tog_y && mouse_y <= tog_y + 22 ? (
  !clicked_tog2 ? (slider8 = !slider8; slider_automate(2^7); clicked_tog2 = 1;);
) : (clicked_tog2 = 0;);

mouse_cap & 1 && mouse_x >= 310 && mouse_x <= 430 && mouse_y >= tog_y && mouse_y <= tog_y + 22 ? (
  !clicked_tog3 ? (slider9 = (slider9 + 1) % 3; slider_automate(2^8); clicked_tog3 = 1;);
) : (clicked_tog3 = 0;);

mouse_cap == 0 ? active_knob = -1;
mouse_cap_prev = mouse_cap;
