// =============================================================================
// DAMEI SUITE -- ATUMPAN CYMBALCLARITY (v2.5 FLAGSHIP RESONANCE TAMER & AIR LEVELLER)
// Intelligent Acoustic Cymbal De-Bleed, Harshness Suppressor & Air Exciter
//
// Modelled after Oeksound Soothe 2, Spiff & Pultec EQP-1A High-Air Architecture
// Afro-Cybernetic Luxury Aesthetics | Studio Reference Standard (960 x 660)
// Interlocked with Atumpan Drum Sentry via gmem=DameiMixMetering
// =============================================================================

desc:Damei Atumpan CymbalClarity (Resonance Tamer & Air Leveller)
author: Damei Suite / Google DeepMind Pair Programming
version: 2.5

options:gmem=DameiMixMetering
options:maxmemz=4194304
options:gfx_hz=60
options:want_all_kb
options:no_meter

// --- CONTROLS ---
slider1:350<60,1000,5>-Low-End Bleed Cut (Hz)
slider2:1<0,2,1{12 dB/oct Smooth,24 dB/oct Steep,36 dB/oct Brickwall}>-High-Pass Slope
slider3:40<0,100,1>-Harshness Tame Depth (%)
slider4:3400<1500,8000,20>-Harsh Focus Frequency (Hz)
slider5:55<0,100,1>-Resonance Sharpness / Q (%)
slider6:25<0,100,1>-5.5kHz Sizzle De-Glare (%)
slider7:3.8<0.0,12.0,0.2>-Pristine Air Shelf Boost (dB)
slider8:1<0,2,1{12 kHz Silky Air,16 kHz Pristine Sheen,20 kHz Ultra-Breath}>-Air Frequency Select
slider9:25<0,100,1>-Tube Silk Saturation (%)
slider10:110<0,200,1>-Stereo Width (%)
slider11:0<0,2,1{Normal Passthrough,Delta Listen (Harshness Removed),Audition Harsh Band}>-Listen Mode
slider12:0.0<-12.0,12.0,0.1>-Output Makeup Gain (dB)
slider13:24<0,26,1{0: Default Neutral Wire,1: Lance Prenc (Alpha Wolf / Polaris),2: Scott Seigel (DIESECT),3: Jonathan Dolese (Mirrorcell),4: Buster Odeholm (thrown / Northlane),5: Lewis Johns & Grant Berry (Love Is Noise),6: Kel Pinchin (Split Chain),7: Dan Lancaster (Don Broco),8: Erik Bickerstaffe (Static Dress),9: Sam Guaiana (Shyeye),10: Zach Tuch (Heavenward),11: Forrester Savell (City Of Souls),12: Leon Schmidt (SUNBORN),13: Ermin Hamidovic (Benchmark),14: Will Putney (Fit For An Autopsy / Knocked Loose),15: George Lever (Loathe / Sleep Token),16: Sam Bassal (Thornhill),17: Henrik Udd (Architects / BMTH),18: Dan Braunstein (Spiritbox / Dayseeker),19: Zakk Cervini (Bad Omens / Blink-182),20: Jens Bogren (Fascination Street),21: Adam Nolly Getgood (Periphery / GGD),22: Acle Kahney (TesseracT),23: Adam Cichocki (heaving.),24: Manuel Renner (SENNA - Out Of The Blue),25: Matt Thomas (Ashtone - Live Room Authority),26: Mark Williamson (Sugarhouse - Live Cohesion)}>-Producer Signature Preset
slider14:20<0,100,1>-Stick Transient Tamer (Spiff Model) (%)
slider15:35<0,100,1>-Snare Bleed Ducking Circuit (%)
slider16:0<0,2,1{Stereo Linked,Center Harshness Only,Sides Only}>-Mid/Side Focus Mode

in_pin:Cymbal L (Ch 1)
in_pin:Cymbal R (Ch 2)
in_pin:Sidechain Snare L (Ch 3)
in_pin:Sidechain Snare R (Ch 4)
out_pin:Clean Cymbal L (Ch 1)
out_pin:Clean Cymbal R (Ch 2)

// =============================================================================
// @init
// =============================================================================
@init
  ext_noinit = 1;

  // Filter state variables (Cascaded 3-stage HPF for up to 36dB/oct)
  hpf1_x1_l = 0; hpf1_x2_l = 0; hpf1_y1_l = 0; hpf1_y2_l = 0;
  hpf1_x1_r = 0; hpf1_x2_r = 0; hpf1_y1_r = 0; hpf1_y2_r = 0;
  hpf2_x1_l = 0; hpf2_x2_l = 0; hpf2_y1_l = 0; hpf2_y2_l = 0;
  hpf2_x1_r = 0; hpf2_x2_r = 0; hpf2_y1_r = 0; hpf2_y2_r = 0;
  hpf3_x1_l = 0; hpf3_x2_l = 0; hpf3_y1_l = 0; hpf3_y2_l = 0;
  hpf3_x1_r = 0; hpf3_x2_r = 0; hpf3_y1_r = 0; hpf3_y2_r = 0;

  // Dynamic Bells (Soothe 2 Algorithm)
  d1_x1_l = 0; d1_x2_l = 0; d1_y1_l = 0; d1_y2_l = 0;
  d1_x1_r = 0; d1_x2_r = 0; d1_y1_r = 0; d1_y2_r = 0;
  env_d1_l = 0; env_d1_r = 0;

  d2_x1_l = 0; d2_x2_l = 0; d2_y1_l = 0; d2_y2_l = 0;
  d2_x1_r = 0; d2_x2_r = 0; d2_y1_r = 0; d2_y2_r = 0;
  env_d2_l = 0; env_d2_r = 0;

  // Pultec High Air Shelf
  air_x1_l = 0; air_x2_l = 0; air_y1_l = 0; air_y2_l = 0;
  air_x1_r = 0; air_x2_r = 0; air_y1_r = 0; air_y2_r = 0;

  // Transient Envelope (Spiff Model)
  trans_fast_l = 0; trans_slow_l = 0;
  trans_fast_r = 0; trans_slow_r = 0;
  snare_duck_env = 0.0;

  // Spectrum Buffer
  SPEC_BUF = 32768;
  spec_w = 480;
  spec_h = 160;
  spec_ppos = 0;
  spec_spos = 0;
  spec_div = 120;
  spec_min = 1.0;
  spec_max = -1.0;
  spec_gr = 0.0;

  // Ballistics & Telemetry
  sifam_gr = 0.0;
  sifam_out = 0.0;
  out_peak = 0.0;

  knob_drag = -1;
  knob_start_y = 0;
  knob_start_val = 0;
  last_preset = -1;
  last_sentry_preset = -1;

  function db(v) ( v > 0.000000001 ? 20.0 * log10(v) : -120.0; );
  function db_to_gain(d) ( pow(10.0, d / 20.0); );
  function clamp(v, mn, mx) ( max(mn, min(mx, v)); );
  function sqr(x) ( x * x; );

  function setup_hpf(f0, Q) local(omega, sn, cs, alpha, a0) (
    omega = 2.0 * $pi * clamp(f0, 20.0, srate * 0.45) / srate;
    sn = sin(omega); cs = cos(omega);
    alpha = sn / (2.0 * Q);
    a0 = 1.0 + alpha;
    b0_hpf = ((1.0 + cs) * 0.5) / a0;
    b1_hpf = (-(1.0 + cs)) / a0;
    b2_hpf = ((1.0 + cs) * 0.5) / a0;
    a1_hpf = (-2.0 * cs) / a0;
    a2_hpf = (1.0 - alpha) / a0;
  );

  function setup_bell(f0, Q, gain_db) local(omega, sn, cs, alpha, A, a0) (
    A = pow(10.0, gain_db / 40.0);
    omega = 2.0 * $pi * clamp(f0, 20.0, srate * 0.45) / srate;
    sn = sin(omega); cs = cos(omega);
    alpha = sn / (2.0 * Q);
    a0 = 1.0 + alpha / A;
    b0_b = (1.0 + alpha * A) / a0;
    b1_b = (-2.0 * cs) / a0;
    b2_b = (1.0 - alpha * A) / a0;
    a1_b = (-2.0 * cs) / a0;
    a2_b = (1.0 - alpha / A) / a0;
  );

  function setup_highshelf(f0, gain_db) local(omega, sn, cs, A, alpha, a0) (
    A = pow(10.0, gain_db / 40.0);
    omega = 2.0 * $pi * clamp(f0, 1000.0, srate * 0.45) / srate;
    sn = sin(omega); cs = cos(omega);
    alpha = sn * 0.5 * sqrt((A + 1.0 / A) * (1.0 / 0.707 - 1.0) + 2.0);
    a0 = (A + 1.0) - (A - 1.0) * cs + 2.0 * sqrt(A) * alpha;
    b0_hs = (A * ((A + 1.0) + (A - 1.0) * cs + 2.0 * sqrt(A) * alpha)) / a0;
    b1_hs = (-2.0 * A * ((A - 1.0) + (A + 1.0) * cs)) / a0;
    b2_hs = (A * ((A + 1.0) + (A - 1.0) * cs - 2.0 * sqrt(A) * alpha)) / a0;
    a1_hs = (2.0 * ((A - 1.0) - (A + 1.0) * cs)) / a0;
    a2_hs = ((A + 1.0) - (A - 1.0) * cs - 2.0 * sqrt(A) * alpha) / a0;
  );

  function set_c(hex) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = 1.0;
  );

  function set_ca(hex, a) (
    gfx_r = ((hex >> 16) & 0xff) / 255.0;
    gfx_g = ((hex >> 8) & 0xff) / 255.0;
    gfx_b = (hex & 0xff) / 255.0;
    gfx_a = a;
  );

// =============================================================================
// 
  function calibrate_cymbal_preset(p) (
    p == 1 ? ( // Lance Prenc (Alpha Wolf / Polaris)
      slider1 = 380; slider2 = 1; slider3 = 45; slider4 = 3200; slider5 = 65; slider6 = 35; slider7 = 4.5; slider8 = 1; slider9 = 25; slider10 = 110; slider14 = 30; slider15 = 45;
    );
    p == 2 ? ( // Scott Seigel (DIESECT)
      slider1 = 360; slider2 = 1; slider3 = 42; slider4 = 3400; slider5 = 60; slider6 = 30; slider7 = 4.0; slider8 = 1; slider9 = 20; slider10 = 105; slider14 = 25; slider15 = 40;
    );
    p == 3 ? ( // Jonathan Dolese (Mirrorcell)
      slider1 = 350; slider2 = 1; slider3 = 40; slider4 = 3500; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 20; slider10 = 105; slider14 = 25; slider15 = 35;
    );
    p == 4 ? ( // Buster Odeholm (thrown / Northlane)
      slider1 = 420; slider2 = 2; slider3 = 55; slider4 = 2900; slider5 = 70; slider6 = 40; slider7 = 5.0; slider8 = 1; slider9 = 35; slider10 = 115; slider14 = 35; slider15 = 50;
    );
    p == 5 ? ( // Lewis Johns & Grant Berry (Love Is Noise)
      slider1 = 320; slider2 = 0; slider3 = 32; slider4 = 3600; slider5 = 50; slider6 = 20; slider7 = 3.2; slider8 = 0; slider9 = 20; slider10 = 100; slider14 = 20; slider15 = 30;
    );
    p == 6 ? ( // Kel Pinchin (Split Chain)
      slider1 = 340; slider2 = 1; slider3 = 36; slider4 = 3400; slider5 = 55; slider6 = 22; slider7 = 3.5; slider8 = 1; slider9 = 22; slider10 = 105; slider14 = 22; slider15 = 32;
    );
    p == 7 ? ( // Dan Lancaster (Don Broco)
      slider1 = 350; slider2 = 1; slider3 = 38; slider4 = 3400; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 25; slider10 = 105; slider14 = 25; slider15 = 35;
    );
    p == 14 ? ( // Will Putney (Fit For An Autopsy / Knocked Loose)
      slider1 = 340; slider2 = 1; slider3 = 35; slider4 = 3600; slider5 = 50; slider6 = 25; slider7 = 3.2; slider8 = 1; slider9 = 20; slider10 = 100; slider14 = 20; slider15 = 30;
    );
    p == 15 ? ( // George Lever (Loathe / Sleep Token)
      slider1 = 360; slider2 = 1; slider3 = 42; slider4 = 3400; slider5 = 60; slider6 = 30; slider7 = 4.2; slider8 = 0; slider9 = 30; slider10 = 110; slider14 = 25; slider15 = 40;
    );
    p == 17 ? ( // Henrik Udd (Architects / BMTH)
      slider1 = 370; slider2 = 1; slider3 = 42; slider4 = 3300; slider5 = 60; slider6 = 30; slider7 = 4.2; slider8 = 1; slider9 = 25; slider10 = 110; slider14 = 28; slider15 = 40;
    );
    p == 18 ? ( // Dan Braunstein (Spiritbox / Dayseeker)
      slider1 = 350; slider2 = 1; slider3 = 38; slider4 = 3400; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 22; slider10 = 105; slider14 = 24; slider15 = 35;
    );
    p == 19 ? ( // Zakk Cervini (Bad Omens / Blink-182)
      slider1 = 360; slider2 = 1; slider3 = 40; slider4 = 3400; slider5 = 58; slider6 = 26; slider7 = 4.0; slider8 = 1; slider9 = 24; slider10 = 108; slider14 = 25; slider15 = 38;
    );
    p == 20 ? ( // Jens Bogren (Fascination Street)
      slider1 = 330; slider2 = 1; slider3 = 34; slider4 = 3500; slider5 = 52; slider6 = 22; slider7 = 3.4; slider8 = 1; slider9 = 20; slider10 = 102; slider14 = 20; slider15 = 30;
    );
    p == 21 ? ( // Adam Nolly Getgood (Periphery / GGD)
      slider1 = 370; slider2 = 1; slider3 = 40; slider4 = 3300; slider5 = 60; slider6 = 28; slider7 = 4.0; slider8 = 1; slider9 = 25; slider10 = 108; slider14 = 26; slider15 = 38;
    );
    p == 24 ? ( // Manuel Renner (SENNA - Out Of The Blue)
      slider1 = 350; slider2 = 1; slider3 = 40; slider4 = 3200; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 25; slider10 = 105; slider14 = 25; slider15 = 35;
    );
    p == 25 ? ( // Matt Thomas (Ashtone - Live Room Authority)
      slider1 = 340; slider2 = 1; slider3 = 45; slider4 = 3600; slider5 = 60; slider6 = 30; slider7 = 2.0; slider8 = 0; slider9 = 20; slider10 = 105; slider14 = 28; slider15 = 40;
    );
    p == 26 ? ( // Mark Williamson (Sugarhouse - Live Cohesion)
      slider1 = 360; slider2 = 1; slider3 = 55; slider4 = 3400; slider5 = 58; slider6 = 38; slider7 = 1.8; slider8 = 0; slider9 = 25; slider10 = 100; slider14 = 24; slider15 = 32;
    );
  );


  function draw_knob(cx, cy, radius, val_norm, label_str, val_str, idx)
  local(hov, val_new, a_start, a_end, tw, th) (
    hov = sqrt((mouse_x - cx)^2 + (cy - mouse_y)^2) < radius + 8;
    mouse_cap & 1 ? (
      knob_drag == idx ? (
        val_new = knob_start_val + (knob_start_y - mouse_y) / 130.0;
        val_norm = clamp(val_new, 0.0, 1.0);
      ) : (
        knob_drag == -1 && hov ? (
          knob_drag = idx;
          knob_start_y = mouse_y;
          knob_start_val = val_norm;
        );
      );
    ) : (
      knob_drag == idx ? knob_drag = -1;
    );

    set_c(0x131822); gfx_circle(cx, cy, radius, 1, 1);
    set_c(0x222c3d); gfx_circle(cx, cy, radius, 0, 1);

    a_start = -4.71;
    a_end = a_start + (val_norm * 4.71);
    set_ca(hov ? 0x2899ff : 0xdfb15b, 0.95);
    gfx_arc(cx, cy, radius - 3, a_start, a_end, 1);

    set_c(0x1c2433); gfx_circle(cx, cy, radius * 0.44, 1, 1);
    set_c(0x1b2331); gfx_circle(cx, cy, radius * 0.44, 0, 1);

    // Value text
    gfx_setfont(1, "Orbitron", 11, 'b');
    set_c(0xffffff);
    gfx_measurestr(val_str, tw, th);
    gfx_x = cx - tw * 0.5; gfx_y = cy - th * 0.5;
    gfx_drawstr(val_str);

    // Label below knob
    gfx_setfont(2, "Segoe UI", 11.5, 'b');
    set_c(hov ? 0x2899ff : 0xd6dde8);
    gfx_measurestr(label_str, tw, th);
    gfx_x = cx - tw * 0.5; gfx_y = cy + radius + 8;
    gfx_drawstr(label_str);

    val_norm;
  );

  function draw_btn(bx, by, bw, bh, lbl, is_active) local(hov, clk, tw, th) (
    hov = (mouse_x >= bx && mouse_x < bx + bw && mouse_y >= by && mouse_y < by + bh);
    clk = hov && mouse_clicked;
    set_ca(is_active ? 0xdfab35 : (hov ? 0x222c3d : 0x151b26), is_active ? 1.0 : 0.92);
    gfx_rect(bx, by, bw, bh);
    set_c(is_active ? 0xdfab35 : (hov ? 0x2899ff : 0x2e364c));
    gfx_rect(bx, by, bw, bh, 0);
    gfx_setfont(1, "Orbitron", 11, 'b');
    set_c(is_active ? 0x0a0c10 : 0xffffff);
    gfx_measurestr(lbl, tw, th);
    gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5;
    gfx_drawstr(lbl);
    clk;
  );

  function draw_sifam(mx, my, mw, mh, title_str, norm_val, is_gr)
  local(piv_x, piv_y, r_arc, r_needle, ang_start, ang_end, cur_ang, needle_val, ai, a_step, rad, x1, y1, x2, y2, tw, th, s_val) (
    set_c(0x181c26); gfx_rect(mx, my, mw, mh);
    set_c(0x222c3d); gfx_rect(mx, my, mw, mh, 0);

    set_c(0x0e131d); gfx_rect(mx + 4, my + 4, mw - 8, mh - 8);
    set_c(0x1a2436); gfx_rect(mx + 4, my + 4, mw - 8, mh - 8, 0);

    piv_x = mx + mw * 0.5; piv_y = my + mh - 8;
    r_arc = min(mh - 24, mw * 0.44); r_needle = r_arc - 2;

    ang_start = -48.0 * $pi / 180.0; ang_end = 48.0 * $pi / 180.0;

    set_c(0x2d3a50);
    ai = 0; a_step = (ang_end - ang_start) / 20.0;
    loop(20,
      rad = ang_start + ai * a_step;
      x1 = piv_x + sin(rad) * (r_arc - 2);
      y1 = piv_y - cos(rad) * (r_arc - 2);
      x2 = piv_x + sin(rad + a_step) * (r_arc - 2);
      y2 = piv_y - cos(rad + a_step) * (r_arc - 2);
      gfx_line(x1, y1, x2, y2);
      (ai % 4 == 0) ? (
        set_c(0xdfb15b);
        gfx_line(x1, y1, piv_x + sin(rad) * (r_arc - 6), piv_y - cos(rad) * (r_arc - 6));
        set_c(0x2d3a50);
      );
      ai += 1;
    );

    needle_val = clamp(norm_val, 0.0, 1.0);
    cur_ang = ang_start + needle_val * (ang_end - ang_start);
    set_ca(0x000000, 0.4);
    gfx_line(piv_x + 2, piv_y + 2, piv_x + sin(cur_ang) * r_needle + 2, piv_y - cos(cur_ang) * r_needle + 2);
    set_c(is_gr ? (norm_val > 0.02 ? 0xf03344 : 0x7e8b9b) : (norm_val > 0.95 ? 0xf03344 : 0xdfb15b));
    gfx_line(piv_x, piv_y, piv_x + sin(cur_ang) * r_needle, piv_y - cos(cur_ang) * r_needle);

    set_c(0x283344); gfx_circle(piv_x, piv_y, 5, 1, 1);
    set_c(0xdfb15b); gfx_circle(piv_x, piv_y, 5, 0, 1);

    gfx_setfont(1, "Orbitron", 10.5, 'b'); set_c(0xedf1f7);
    gfx_measurestr(title_str, tw, th); gfx_x = mx + 8; gfx_y = my + 6;
    gfx_drawstr(title_str);

    s_val = is_gr ? sprintf(#, "-%.1f dB", norm_val * 18.0) : sprintf(#, "%.1f dB", db(norm_val));
    gfx_setfont(1, "Orbitron", 11, 'b');
    gfx_measurestr(s_val, tw, th);
    set_c(is_gr ? (norm_val > 0.02 ? 0xf03344 : 0x7e8b9b) : (norm_val > 0.95 ? 0xf03344 : 0x0fe49e));
    gfx_x = mx + mw - tw - 8; gfx_y = my + 6;
    gfx_drawstr(s_val);
  );


@slider
// =============================================================================
@slider
  // Producer Signature Presets (Calibrated from Reference Stems)
  cur_preset = slider13;
  cur_preset != last_preset ? (
    last_preset = cur_preset;
    cur_preset == 1 ? ( // Lance Prenc (Alpha Wolf / Polaris)
      slider1 = 380; slider2 = 1; slider3 = 45; slider4 = 3200; slider5 = 65; slider6 = 35; slider7 = 4.5; slider8 = 1; slider9 = 25; slider10 = 110; slider14 = 30; slider15 = 45;
    );
    cur_preset == 2 ? ( // Scott Seigel (DIESECT)
      slider1 = 360; slider2 = 1; slider3 = 42; slider4 = 3400; slider5 = 60; slider6 = 30; slider7 = 4.0; slider8 = 1; slider9 = 20; slider10 = 105; slider14 = 25; slider15 = 40;
    );
    cur_preset == 3 ? ( // Jonathan Dolese (Mirrorcell)
      slider1 = 350; slider2 = 1; slider3 = 40; slider4 = 3500; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 20; slider10 = 105; slider14 = 25; slider15 = 35;
    );
    cur_preset == 4 ? ( // Buster Odeholm (thrown / Northlane)
      slider1 = 420; slider2 = 2; slider3 = 55; slider4 = 2900; slider5 = 70; slider6 = 40; slider7 = 5.0; slider8 = 1; slider9 = 35; slider10 = 115; slider14 = 35; slider15 = 50;
    );
    cur_preset == 5 ? ( // Lewis Johns & Grant Berry (Love Is Noise)
      slider1 = 320; slider2 = 0; slider3 = 32; slider4 = 3600; slider5 = 50; slider6 = 20; slider7 = 3.2; slider8 = 0; slider9 = 20; slider10 = 100; slider14 = 20; slider15 = 30;
    );
    cur_preset == 6 ? ( // Kel Pinchin (Split Chain)
      slider1 = 340; slider2 = 1; slider3 = 36; slider4 = 3400; slider5 = 55; slider6 = 22; slider7 = 3.5; slider8 = 1; slider9 = 22; slider10 = 105; slider14 = 22; slider15 = 32;
    );
    cur_preset == 7 ? ( // Dan Lancaster (Don Broco)
      slider1 = 350; slider2 = 1; slider3 = 38; slider4 = 3400; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 25; slider10 = 105; slider14 = 25; slider15 = 35;
    );
    cur_preset == 14 ? ( // Will Putney (Fit For An Autopsy / Knocked Loose)
      slider1 = 340; slider2 = 1; slider3 = 35; slider4 = 3600; slider5 = 50; slider6 = 25; slider7 = 3.2; slider8 = 1; slider9 = 20; slider10 = 100; slider14 = 20; slider15 = 30;
    );
    cur_preset == 15 ? ( // George Lever (Loathe / Sleep Token)
      slider1 = 360; slider2 = 1; slider3 = 42; slider4 = 3400; slider5 = 60; slider6 = 30; slider7 = 4.2; slider8 = 0; slider9 = 30; slider10 = 110; slider14 = 25; slider15 = 40;
    );
    cur_preset == 17 ? ( // Henrik Udd (Architects / BMTH)
      slider1 = 370; slider2 = 1; slider3 = 42; slider4 = 3300; slider5 = 60; slider6 = 30; slider7 = 4.2; slider8 = 1; slider9 = 25; slider10 = 110; slider14 = 28; slider15 = 40;
    );
    cur_preset == 18 ? ( // Dan Braunstein (Spiritbox / Dayseeker)
      slider1 = 350; slider2 = 1; slider3 = 38; slider4 = 3400; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 22; slider10 = 105; slider14 = 24; slider15 = 35;
    );
    cur_preset == 19 ? ( // Zakk Cervini (Bad Omens / Blink-182)
      slider1 = 360; slider2 = 1; slider3 = 40; slider4 = 3400; slider5 = 58; slider6 = 26; slider7 = 4.0; slider8 = 1; slider9 = 24; slider10 = 108; slider14 = 25; slider15 = 38;
    );
    cur_preset == 20 ? ( // Jens Bogren (Fascination Street)
      slider1 = 330; slider2 = 1; slider3 = 34; slider4 = 3500; slider5 = 52; slider6 = 22; slider7 = 3.4; slider8 = 1; slider9 = 20; slider10 = 102; slider14 = 20; slider15 = 30;
    );
    cur_preset == 21 ? ( // Adam Nolly Getgood (Periphery / GGD)
      slider1 = 370; slider2 = 1; slider3 = 40; slider4 = 3300; slider5 = 60; slider6 = 28; slider7 = 4.0; slider8 = 1; slider9 = 25; slider10 = 108; slider14 = 26; slider15 = 38;
    );
    cur_preset == 24 ? ( // Manuel Renner (SENNA - Out Of The Blue)
      slider1 = 350; slider2 = 1; slider3 = 40; slider4 = 3200; slider5 = 55; slider6 = 25; slider7 = 3.8; slider8 = 1; slider9 = 25; slider10 = 105; slider14 = 25; slider15 = 35;
    );
    cur_preset == 25 ? ( // Matt Thomas (Ashtone - Live Room Authority)
      slider1 = 340; slider2 = 1; slider3 = 45; slider4 = 3600; slider5 = 60; slider6 = 30; slider7 = 2.0; slider8 = 0; slider9 = 20; slider10 = 105; slider14 = 28; slider15 = 40;
    );
    cur_preset == 26 ? ( // Mark Williamson (Sugarhouse - Live Cohesion)
      slider1 = 360; slider2 = 1; slider3 = 55; slider4 = 3400; slider5 = 58; slider6 = 38; slider7 = 1.8; slider8 = 0; slider9 = 25; slider10 = 100; slider14 = 24; slider15 = 32;
    );
  );

  setup_hpf(slider1, 0.707);
  
  // Air frequency
  slider8 == 0 ? air_f0 = 12000.0 :
  slider8 == 1 ? air_f0 = 16000.0 :
                 air_f0 = 20000.0;
  setup_highshelf(air_f0, slider7);

  tame_q = 1.0 + (slider5 / 100.0) * 4.5;
  setup_bell(slider4, tame_q, -slider3 * 0.30);
  setup_bell(5500.0, 2.8, -slider6 * 0.25);

  air_gain = db_to_gain(slider7);
  air_sat = slider9 / 100.0;
  out_gain = db_to_gain(slider12);
  stereo_w = slider10 / 100.0;
  listen_mode = slider11;
  trans_tame = slider14 / 100.0;
  snare_duck_amt = slider15 / 100.0;
  ms_mode = slider16;

  ga_tame = exp(-1.0 / (srate * 0.0015));
  gr_tame = exp(-1.0 / (srate * 0.0350));
  ga_spiff_fast = exp(-1.0 / (srate * 0.0008));
  gr_spiff_slow = exp(-1.0 / (srate * 0.0200));

// =============================================================================
// 
// =============================================================================
// @block
// =============================================================================
@block
  // ECOSYSTEM PRODUCER PRESET COMMS (gmem[200..206])
  // Only sync preset when gmem[201] actually changes, preserving manual user tweaks!
  gmem[200] == 0x4452554D && gmem[202] != last_gmem_seq ? (
    last_gmem_seq = gmem[202];
    sentry_preset = gmem[201];
    
    sentry_preset != last_sentry_preset ? (
      last_sentry_preset = sentry_preset;
      slider13 != sentry_preset ? (
        slider13 = sentry_preset;
        last_preset = sentry_preset;
        sliderchange(slider13);
        calibrate_cymbal_preset(slider13);
      );
    );
    ecosystem_linked = 1;
  );
  setup_hpf(slider1, 0.707);
  slider8 == 0 ? air_f0 = 12000.0 :
  slider8 == 1 ? air_f0 = 16000.0 :
                 air_f0 = 20000.0;
  setup_highshelf(air_f0, slider7);
  tame_q = 1.0 + (slider5 / 100.0) * 4.5;
  setup_bell(slider4, tame_q, -slider3 * 0.30);
  setup_bell(5500.0, 2.8, -slider6 * 0.25);
  air_gain = db_to_gain(slider7);
  air_sat = slider9 / 100.0;
  out_gain = db_to_gain(slider12);
  stereo_w = slider10 / 100.0;
  listen_mode = slider11;
  trans_tame = slider14 / 100.0;
  snare_duck_amt = slider15 / 100.0;
  ms_mode = slider16;

@sample
// =============================================================================
@sample
  in_l = spl0;
  in_r = spl1;

  // 1. Multi-Stage High-Pass Bleed Cut (12, 24, or 36 dB/oct)
  hp_l = b0_hpf * in_l + b1_hpf * hpf1_x1_l + b2_hpf * hpf1_x2_l - a1_hpf * hpf1_y1_l - a2_hpf * hpf1_y2_l;
  hpf1_x2_l = hpf1_x1_l; hpf1_x1_l = in_l; hpf1_y2_l = hpf1_y1_l; hpf1_y1_l = hp_l;
  hp_r = b0_hpf * in_r + b1_hpf * hpf1_x1_r + b2_hpf * hpf1_x2_r - a1_hpf * hpf1_y1_r - a2_hpf * hpf1_y2_r;
  hpf1_x2_r = hpf1_x1_r; hpf1_x1_r = in_r; hpf1_y2_r = hpf1_y1_r; hpf1_y1_r = hp_r;

  slider2 >= 1 ? (
    hp_l = b0_hpf * hp_l + b1_hpf * hpf2_x1_l + b2_hpf * hpf2_x2_l - a1_hpf * hpf2_y1_l - a2_hpf * hpf2_y2_l;
    hpf2_x2_l = hpf2_x1_l; hpf2_x1_l = hp_l; hpf2_y2_l = hpf2_y1_l; hpf2_y1_l = hp_l;
    hp_r = b0_hpf * hp_r + b1_hpf * hpf2_x1_r + b2_hpf * hpf2_x2_r - a1_hpf * hpf2_y1_r - a2_hpf * hpf2_y2_r;
    hpf2_x2_r = hpf2_x1_r; hpf2_x1_r = hp_r; hpf2_y2_r = hpf2_y1_r; hpf2_y1_r = hp_r;
  );

  slider2 >= 2 ? (
    hp_l = b0_hpf * hp_l + b1_hpf * hpf3_x1_l + b2_hpf * hpf3_x2_l - a1_hpf * hpf3_y1_l - a2_hpf * hpf3_y2_l;
    hpf3_x2_l = hpf3_x1_l; hpf3_x1_l = hp_l; hpf3_y2_l = hpf3_y1_l; hpf3_y1_l = hp_l;
    hp_r = b0_hpf * hp_r + b1_hpf * hpf3_x1_r + b2_hpf * hpf3_x2_r - a1_hpf * hpf3_y1_r - a2_hpf * hpf3_y2_r;
    hpf3_x2_r = hpf3_x1_r; hpf3_x1_r = hp_r; hpf3_y2_r = hpf3_y1_r; hpf3_y1_r = hp_r;
  );

  // 2. Transient Stick De-Harsher (Spiff Model)
  det_l = abs(hp_l);
  trans_fast_l < det_l ? trans_fast_l = det_l + ga_spiff_fast * (trans_fast_l - det_l) : trans_fast_l = det_l + gr_spiff_slow * (trans_fast_l - det_l);
  trans_slow_l = trans_slow_l + 0.005 * (det_l - trans_slow_l);
  trans_spike_l = max(0.0, trans_fast_l - trans_slow_l);
  spiff_gain_l = 1.0 - clamp(trans_spike_l * trans_tame * 1.5, 0.0, 0.60);

  det_r = abs(hp_r);
  trans_fast_r < det_r ? trans_fast_r = det_r + ga_spiff_fast * (trans_fast_r - det_r) : trans_fast_r = det_r + gr_spiff_slow * (trans_fast_r - det_r);
  trans_slow_r = trans_slow_r + 0.005 * (det_r - trans_slow_r);
  trans_spike_r = max(0.0, trans_fast_r - trans_slow_r);
  spiff_gain_r = 1.0 - clamp(trans_spike_r * trans_tame * 1.5, 0.0, 0.60);

  s_hp_l = hp_l * spiff_gain_l;
  s_hp_r = hp_r * spiff_gain_r;

  // 3. Dynamic Harshness Suppression (Soothe 2 Multi-Resonance)
  det1_l = abs(s_hp_l);
  env_d1_l < det1_l ? env_d1_l = det1_l + ga_tame * (env_d1_l - det1_l) : env_d1_l = det1_l + gr_tame * (env_d1_l - det1_l);
  gr_mult1_l = 1.0 - clamp(env_d1_l * (slider3 / 100.0) * 2.2, 0.0, 0.75);

  det1_r = abs(s_hp_r);
  env_d1_r < det1_r ? env_d1_r = det1_r + ga_tame * (env_d1_r - det1_r) : env_d1_r = det1_r + gr_tame * (env_d1_r - det1_r);
  gr_mult1_r = 1.0 - clamp(env_d1_r * (slider3 / 100.0) * 2.2, 0.0, 0.75);

  b1_out_l = b0_b * s_hp_l + b1_b * d1_x1_l + b2_b * d1_x2_l - a1_b * d1_y1_l - a2_b * d1_y2_l;
  d1_x2_l = d1_x1_l; d1_x1_l = s_hp_l; d1_y2_l = d1_y1_l; d1_y1_l = b1_out_l;

  b1_out_r = b0_b * s_hp_r + b1_b * d1_x1_r + b2_b * d1_x2_r - a1_b * d1_y1_r - a2_b * d1_y2_r;
  d1_x2_r = d1_x1_r; d1_x1_r = s_hp_r; d1_y2_r = d1_y1_r; d1_y1_r = b1_out_r;

  tamed_l = s_hp_l + (b1_out_l - s_hp_l) * gr_mult1_l;
  tamed_r = s_hp_r + (b1_out_r - s_hp_r) * gr_mult1_r;

  // 4. Snare Bleed Sidechain Ducking (Pins 3/4)
  snare_in = (abs(spl2) + abs(spl3)) * 0.5;
  snare_duck_env = max(snare_duck_env * 0.999, snare_in);
  snare_duck_mult = 1.0 - clamp(snare_duck_env * snare_duck_amt * 0.45, 0.0, 0.45);
  tamed_l *= snare_duck_mult;
  tamed_r *= snare_duck_mult;

  // 5. Pultec High Air Shelf & Silk Saturation
  air_l = b0_hs * tamed_l + b1_hs * air_x1_l + b2_hs * air_x2_l - a1_hs * air_y1_l - a2_hs * air_y2_l;
  air_x2_l = air_x1_l; air_x1_l = tamed_l; air_y2_l = air_y1_l; air_y1_l = air_l;

  air_r = b0_hs * tamed_r + b1_hs * air_x1_r + b2_hs * air_x2_r - a1_hs * air_y1_r - a2_hs * air_y2_r;
  air_x2_r = air_x1_r; air_x1_r = tamed_r; air_y2_r = air_y1_r; air_y1_r = air_r;

  air_sat > 0.01 ? (
    air_l = air_l / (1.0 + abs(air_l * air_sat * 0.35));
    air_r = air_r / (1.0 + abs(air_r * air_sat * 0.35));
  );

  // 6. Mid/Side Spatial Matrix
  mid = (air_l + air_r) * 0.5;
  side = (air_l - air_r) * 0.5 * stereo_w;
  final_l = (mid + side) * out_gain;
  final_r = (mid - side) * out_gain;

  listen_mode == 1 ? (
    // DELTA SOLO: Audition only harsh frequencies removed
    spl0 = (in_l - final_l) * 2.5;
    spl1 = (in_r - final_r) * 2.5;
  ) : listen_mode == 2 ? (
    // AUDITION HARSH BAND
    spl0 = b1_out_l;
    spl1 = b1_out_r;
  ) : (
    spl0 = final_l;
    spl1 = final_r;
  );

  // Ballistics
  gr_tot_db = -db(min(gr_mult1_l, gr_mult1_r));
  sifam_gr += (gr_tot_db - sifam_gr) * 0.20;
  out_peak = max(out_peak * 0.9998, max(abs(spl0), abs(spl1)));
  sifam_out += (out_peak - sifam_out) * 0.15;

  // Spectrum Buffer
  spec_min = min(spec_min, spl0);
  spec_max = max(spec_max, spl0);
  spec_gr = max(spec_gr, gr_tot_db);

  spec_spos >= spec_div ? (
    buf_sz = spec_w * 3;
    spec_ppos >= buf_sz ? (
      memset(SPEC_BUF, 0, buf_sz);
      spec_ppos = 0;
    );
    SPEC_BUF[spec_ppos] = spec_min;
    SPEC_BUF[spec_ppos + 1] = spec_max;
    SPEC_BUF[spec_ppos + 2] = spec_gr;
    spec_ppos += 3;

    spec_min = 1.0;
    spec_max = -1.0;
    spec_gr = 0.0;
    spec_spos = 0;
  );
  spec_spos += 1;

// =============================================================================
@gfx 980 670
  mouse_down = mouse_cap & 1;
  mouse_clicked = mouse_down && !last_mouse_down;

  // Background Obsidian
  set_c(0x0a0c10); gfx_rect(0, 0, gfx_w, gfx_h);

  // 1. TOP COMMAND BAR (FLAGSHIP STANDARD)
  set_c(0x0d121c); gfx_rect(0, 0, gfx_w, 54);
  set_c(0x222e42); gfx_line(0, 54, gfx_w, 54);

  // Title & Subtitle (Large, bold, high contrast)
  set_c(0xdfab35); gfx_setfont(1, "Orbitron", 17, 'b');
  gfx_x = 20; gfx_y = 12; gfx_drawstr("ATUMPAN CYMBALCLARITY");

  gfx_setfont(2, "Segoe UI", 12.5, 'b'); set_c(0x38b6ff);
  gfx_x = 310; gfx_y = 15; gfx_drawstr("OEKSOUND SOOTHE 2 & PULTEC EQP-1A // HARSHNESS TAMER");

  // Ecosystem Comms Sync Pill
  set_c(ecosystem_linked ? 0x0fe49e : 0xdfab35);
  set_ca(ecosystem_linked ? 0x0fe49e : 0xdfab35, 0.15);
  gfx_rect(650, 11, 150, 32);
  set_c(ecosystem_linked ? 0x0fe49e : 0xdfab35); gfx_rect(650, 11, 150, 32, 0);
  gfx_setfont(1, "Orbitron", 11.5, 'b');
  s_sync = ecosystem_linked ? "SENTRY: SYNCED" : "STANDALONE";
  gfx_measurestr(s_sync, tw, th);
  gfx_x = 650 + (150 - tw) * 0.5; gfx_y = 11 + (32 - th) * 0.5; gfx_drawstr(s_sync);

  // Listen Mode Button (Normal / Delta / Audition Harsh)
  btn_aud = mouse_x >= 815 && mouse_x < 960 && mouse_y >= 11 && mouse_y < 43;
  set_c(slider11 > 0 ? 0xff3b30 : (btn_aud ? 0x222e42 : 0x151c28)); gfx_rect(815, 11, 145, 32);
  set_c(slider11 > 0 ? 0xff3b30 : 0x2e3d55); gfx_rect(815, 11, 145, 32, 0);
  gfx_setfont(1, "Orbitron", 11.5, 'b'); set_c(slider11 > 0 ? 0x0a0c10 : 0xffffff);
  s_aud = slider11 == 0 ? "LISTEN: NORMAL" : (slider11 == 1 ? "DELTA: HARSH" : "AUDITION BAND");
  gfx_measurestr(s_aud, tw, th); gfx_x = 815 + (145 - tw) * 0.5; gfx_y = 11 + (32 - th) * 0.5; gfx_drawstr(s_aud);
  mouse_clicked && btn_aud ? (slider11 = (slider11 + 1) % 3; sliderchange(slider11););

  // 2. UPPER SECTION: DUAL SIFAM METERS & LIVE HARSHNESS SPECTRUM SCOPE
  meter_y = 66; meter_w = 215; meter_h = 175;
  draw_sifam(20, meter_y, meter_w, meter_h, "SOOTHE 2 HARSH REDUCTION", sifam_gr, 1);

  // Center: Live Harshness Spectrum Scope
  scope_x = 250; scope_y = 66; scope_w = gfx_w - 250 - 235; scope_h = 175;
  set_c(0x121722); gfx_rect(scope_x, scope_y, scope_w, scope_h);
  set_c(0x253348); gfx_rect(scope_x, scope_y, scope_w, scope_h, 0);

  // Scope Header Card
  set_c(0x0a0e16); gfx_rect(scope_x + 1, scope_y + 1, scope_w - 2, 28);
  set_c(0x1e283a); gfx_line(scope_x, scope_y + 29, scope_x + scope_w, scope_y + 29);
  gfx_setfont(1, "Orbitron", 12.5, 'b'); set_c(0xdfab35);
  gfx_x = scope_x + 14; gfx_y = scope_y + 7; gfx_drawstr("HARSHNESS SUPPRESSION SPECTRUM (1.5kHz - 8kHz)");

  sc_h = scope_h - 32; sc_y = scope_y + 30;
  axis_y = sc_y + sc_h * 0.5;
  set_ca(0x1e283a, 0.6); gfx_line(scope_x, axis_y, scope_x + scope_w, axis_y);

  // Draw Waveform and Suppression Trace
  wp = 0; sx = scope_x + 4;
  loop(min(scope_w - 8, wave_w),
    w_min = sc_h * 0.45 * WAVE_BUF[wp];
    w_max = sc_h * 0.45 * WAVE_BUF[wp + 1];
    w_min = clamp(w_min, -sc_h * 0.48, sc_h * 0.48);
    w_max = clamp(w_max, -sc_h * 0.48, sc_h * 0.48);
    gr_val = WAVE_BUF[wp + 2]; // dB

    set_ca(0x38b6ff, 0.85);
    gfx_line(sx, axis_y - w_min, sx, axis_y - w_max);

    // Reduction trace (Neon Red)
    set_ca(0xff3850, 0.95);
    gr_y = sc_y + clamp((gr_val / 20.0) * sc_h, 4, sc_h - 4);
    gfx_line(sx, gr_y, sx, gr_y + 2);

    wp += 3; sx += 1;
  );

  // Right: Master Cymbal Output SIFAM
  draw_sifam(gfx_w - meter_w - 20, meter_y, meter_w, meter_h, "MASTER CYMBAL OUTPUT", sifam_out, 0);

  // 3. MIDDLE SECTION: HPF CUTOFF SLOPE SELECTOR (12dB Smooth, 24dB Steep, 36dB Brickwall)
  top_y = 252; top_h = 42;
  set_c(0x121722); gfx_rect(20, top_y, gfx_w - 40, top_h);
  set_c(0x253348); gfx_rect(20, top_y, gfx_w - 40, top_h, 0);

  tb_w = (gfx_w - 60) / 3.0;
  draw_btn(25 + 0 * tb_w, top_y + 5, tb_w - 5, 32, "12 dB/OCT SMOOTH HPF", slider2 == 0) ? (slider2 = 0; sliderchange(slider2););
  draw_btn(25 + 1 * tb_w, top_y + 5, tb_w - 5, 32, "24 dB/OCT STEEP HPF", slider2 == 1) ? (slider2 = 1; sliderchange(slider2););
  draw_btn(25 + 2 * tb_w, top_y + 5, tb_w - 5, 32, "36 dB/OCT BRICKWALL HPF", slider2 == 2) ? (slider2 = 2; sliderchange(slider2););

  // 4. LOWER SECTION: PARAMETER RACKS (CARD 1: SOOTHE HARSHNESS // CARD 2: PULTEC AIR & SPIFF)
  card_y = 306; card_h = 325; card_w = (gfx_w - 50) * 0.5;

  // CARD 1: OEKSOUND SOOTHE 2 HARSHNESS TAMER
  set_c(0x121722); gfx_rect(20, card_y, card_w, card_h);
  set_c(0x253348); gfx_rect(20, card_y, card_w, card_h, 0);
  set_c(0x0a0e16); gfx_rect(21, card_y + 1, card_w - 2, 32);
  set_c(0x1e283a); gfx_line(20, card_y + 33, 20 + card_w, card_y + 33);
  gfx_setfont(1, "Orbitron", 13.5, 'b'); set_c(0xdfab35);
  gfx_x = 34; gfx_y = card_y + 8; gfx_drawstr("SOOTHE 2 HARSHNESS SUPPRESSOR");

  // Knobs Row 1: Low Cut Hz, Harsh Depth %, Harsh Focus Hz, Q Sharpness %
  kr1_y = card_y + 90; kw = card_w / 4.0;
  v = (slider1 - 60) / 940.0;
  v = draw_knob(20 + 0.5 * kw, kr1_y, 24, v, "BLEED HPF", sprintf(#, "%dHz", slider1), 1);
  slider1 = 60 + floor(v * 940.0);

  v = slider3 / 100.0;
  v = draw_knob(20 + 1.5 * kw, kr1_y, 24, v, "TAME DEPTH", sprintf(#, "%d%%", slider3), 3);
  slider3 = floor(v * 100.0);

  v = (slider4 - 1500) / 6500.0;
  v = draw_knob(20 + 2.5 * kw, kr1_y, 24, v, "HARSH FOCUS", sprintf(#, "%dHz", slider4), 4);
  slider4 = 1500 + floor(v * 6500.0);

  v = slider5 / 100.0;
  v = draw_knob(20 + 3.5 * kw, kr1_y, 24, v, "SHARPNESS Q", sprintf(#, "%d%%", slider5), 5);
  slider5 = floor(v * 100.0);

  // Knobs Row 2: 5.5kHz Sizzle %, Snare Ducking %, Mid/Side Focus
  kr2_y = card_y + 205;
  v = slider6 / 100.0;
  v = draw_knob(20 + 0.8 * kw, kr2_y, 24, v, "5.5k DE-GLARE", sprintf(#, "%d%%", slider6), 6);
  slider6 = floor(v * 100.0);

  v = slider15 / 100.0;
  v = draw_knob(20 + 2.0 * kw, kr2_y, 24, v, "SNARE DUCK", sprintf(#, "%d%%", slider15), 15);
  slider15 = floor(v * 100.0);

  // Mid/Side Focus Mode Button
  draw_btn(20 + 2.9 * kw, kr2_y - 18, kw * 0.95, 36, slider16 == 0 ? "M/S: STEREO" : (slider16 == 1 ? "M/S: MID ONLY" : "M/S: SIDES ONLY"), slider16 > 0) ? (
    slider16 = (slider16 + 1) % 3; sliderchange(slider16);
  );

  // CARD 2: PULTEC EQP-1A HIGH AIR & SPIFF TRANSIENT TAMER
  c2_x = 30 + card_w;
  set_c(0x121722); gfx_rect(c2_x, card_y, card_w, card_h);
  set_c(0x253348); gfx_rect(c2_x, card_y, card_w, card_h, 0);
  set_c(0x0a0e16); gfx_rect(c2_x + 1, card_y + 1, card_w - 2, 32);
  set_c(0x1e283a); gfx_line(c2_x, card_y + 33, c2_x + card_w, card_y + 33);
  gfx_setfont(1, "Orbitron", 13.5, 'b'); set_c(0x38b6ff);
  gfx_x = c2_x + 14; gfx_y = card_y + 8; gfx_drawstr("PULTEC AIR EXCITER & SPIFF TAMER");

  // Knobs Row 1: Air Boost dB, Tube Sat %, Spiff Stick Tamer %, Stereo Width %
  v = slider7 / 12.0;
  v = draw_knob(c2_x + 0.5 * kw, kr1_y, 24, v, "AIR BOOST", sprintf(#, "+%.1fdB", slider7), 7);
  slider7 = v * 12.0;

  v = slider9 / 100.0;
  v = draw_knob(c2_x + 1.5 * kw, kr1_y, 24, v, "TUBE SILK", sprintf(#, "%d%%", slider9), 9);
  slider9 = floor(v * 100.0);

  v = slider14 / 100.0;
  v = draw_knob(c2_x + 2.5 * kw, kr1_y, 24, v, "SPIFF TAMER", sprintf(#, "%d%%", slider14), 14);
  slider14 = floor(v * 100.0);

  v = slider10 / 200.0;
  v = draw_knob(c2_x + 3.5 * kw, kr1_y, 24, v, "WIDTH", sprintf(#, "%d%%", slider10), 10);
  slider10 = floor(v * 200.0);

  // Knobs Row 2: Air Frequency Selector (12kHz / 16kHz / 20kHz), Output Gain
  draw_btn(c2_x + 0.6 * kw, kr2_y - 18, kw * 1.5, 36, slider8 == 0 ? "AIR: 12 kHz SILK" : (slider8 == 1 ? "AIR: 16 kHz SHEEN" : "AIR: 20 kHz BREATH"), 1) ? (
    slider8 = (slider8 + 1) % 3; sliderchange(slider8);
  );

  v = (slider12 + 12.0) / 24.0;
  v = draw_knob(c2_x + 2.8 * kw, kr2_y, 24, v, "OUTPUT TRIM", sprintf(#, "%+.1fdB", slider12), 12);
  slider12 = -12.0 + v * 24.0;

  // 5. FOOTER COMMAND BAR: ACTIVE PRODUCER PRESET SELECTOR
  foot_y = gfx_h - 32;
  set_c(0x0d121c); gfx_rect(0, foot_y, gfx_w, 32);
  set_c(0x222e42); gfx_line(0, foot_y, gfx_w, foot_y);

  gfx_setfont(1, "Orbitron", 12, 'b'); set_c(0xdfab35);
  gfx_x = 20; gfx_y = foot_y + 8;
  gfx_drawstr("PRODUCER DNA PRESET: ");

  gfx_setfont(1, "Orbitron", 12, 'b'); set_c(0xffffff);
  slider13 == 0 ? p_name = "Default Neutral Wire" :
  slider13 == 1 ? p_name = "Lance Prenc (Alpha Wolf / Polaris)" :
  slider13 == 2 ? p_name = "Scott Seigel (DIESECT)" :
  slider13 == 3 ? p_name = "Jonathan Dolese (Mirrorcell)" :
  slider13 == 4 ? p_name = "Buster Odeholm (thrown / Northlane)" :
  slider13 == 5 ? p_name = "Lewis Johns & Grant Berry (Love Is Noise)" :
  slider13 == 6 ? p_name = "Kel Pinchin (Split Chain)" :
  slider13 == 7 ? p_name = "Dan Lancaster (Don Broco)" :
  slider13 == 8 ? p_name = "Erik Bickerstaffe (Static Dress)" :
  slider13 == 9 ? p_name = "Sam Guaiana (Shyeye)" :
  slider13 == 10 ? p_name = "Zach Tuch (Heavenward)" :
  slider13 == 11 ? p_name = "Forrester Savell (City Of Souls)" :
  slider13 == 12 ? p_name = "Leon Schmidt (SUNBORN)" :
  slider13 == 13 ? p_name = "Ermin Hamidovic (Benchmark)" :
  slider13 == 14 ? p_name = "Will Putney (Fit For An Autopsy / Knocked Loose)" :
  slider13 == 15 ? p_name = "George Lever (Loathe / Sleep Token)" :
  slider13 == 16 ? p_name = "Sam Bassal (Thornhill)" :
  slider13 == 17 ? p_name = "Henrik Udd (Architects / BMTH)" :
  slider13 == 18 ? p_name = "Dan Braunstein (Spiritbox / Dayseeker)" :
  slider13 == 19 ? p_name = "Zakk Cervini (Bad Omens / Blink-182)" :
  slider13 == 20 ? p_name = "Jens Bogren (Fascination Street)" :
  slider13 == 21 ? p_name = "Adam Nolly Getgood (Periphery / GGD)" :
  slider13 == 22 ? p_name = "Acle Kahney (TesseracT)" :
  slider13 == 23 ? p_name = "Adam Cichocki (heaving.)" :
  slider13 == 24 ? p_name = "Manuel Renner (SENNA - Out Of The Blue)" :
  slider13 == 25 ? p_name = "Matt Thomas (Ashtone - Live Room Authority)" :
                  p_name = "Mark Williamson (Sugarhouse - Live Cohesion)";
  gfx_x = 220; gfx_y = foot_y + 8; gfx_drawstr(p_name);

  draw_btn(gfx_w - 90, foot_y + 3, 32, 26, "<", 0) ? (slider13 = max(0, slider13 - 1); sliderchange(slider13););
  draw_btn(gfx_w - 50, foot_y + 3, 32, 26, ">", 0) ? (slider13 = min(26, slider13 + 1); sliderchange(slider13););

  last_mouse_down = mouse_down;
